# built programs
neon-caster.run
neon-caster-mac
neon-caster.exe
*.exe
# your settings and saved games, and the code terminals' scratch files
neon-caster/saves/
# Python's caches (the level kit)
__pycache__/
# build output
pkg/
qb64pe/
compilelog.txt
# the arranger's sources (music/arrange.py --sources): dev-only, made from the originals
neon-caster/music/edit/*.log

# Editor backups, and programs built in the old place (now saves/programs)
neon-caster/levels/**/*.bak
neon-caster/programs/*.run

# test builds anywhere, and your own HUD layout (the game's is hud-defaults.txt)
*.run
neon-caster/hud.txt
