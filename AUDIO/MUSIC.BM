''
' NEON-CASTER - AUDIO/MUSIC.BM
' =============================================================================
' Music: loading it, playing it, and how loud.
'

' A music track from neon-caster/music/ (0 if it's missing: no music)
FUNCTION LoadMusic&(file$)
    path$ = AssetPath$("music/" + file$)
    ' "stream": played straight from the file a little at a time, not
    ' unpacked into memory first (a 3-minute track would be 60 MB). And
    ' everything else is loaded "noasync" - unpacked there and then, not
    ' in the background: QB64PE 4.7 can crash if a sound is still being
    ' unpacked in the background while another one opens.
    IF _FILEEXISTS(path$) THEN LoadMusic& = _SNDOPEN(path$, "stream, noasync")
END FUNCTION

' Play a music track on a loop (_SNDLOOP), at the MUSIC VOLUME setting,
' stopping the one before. Asking for the track already playing changes
' nothing, so it doesn't restart.
SUB PlayMusic(snd&)
    IF snd& = nowPlaying& THEN EXIT SUB
    MusicStop
    nowPlaying& = snd&
    IF snd& > 0 THEN _SNDVOL snd&, MusicVol! : _SNDLOOP snd&
END SUB

' The same, starting with an intro (NAME-intro.ogg, from an arrangement
' with a | in it - music/README.md): it plays once, and MusicFrame hands
' over to the loop where the intro ends.
SUB PlayMusicIntro(snd&, intro&)
    IF snd& = nowPlaying& THEN EXIT SUB
    IF intro& <= 0 OR snd& <= 0 THEN PlayMusic snd& : EXIT SUB
    MusicStop
    nowPlaying& = snd& : musIntro& = intro&
    _SNDVOL intro&, MusicVol! : _SNDPLAY intro&
END SUB

' Stop the music (its intro too)
SUB MusicStop
    IF musIntro& > 0 THEN _SNDSTOP musIntro& : musIntro& = 0
    IF nowPlaying& > 0 THEN _SNDSTOP nowPlaying& : nowPlaying& = 0
END SUB

' Every frame (ShowFrame): an intro hands over to its loop. The intro file
' runs on INTRO_TAIL seconds into the loop, so the loop starts as far in as
' the intro has got past its end - the same music, whenever the frame
' comes. (An intro that already stopped - a loop of its own that didn't
' show frames - starts the loop from the top.)
SUB MusicFrame
    DIM p#, core# ' (its own)
    IF musIntro& <= 0 THEN EXIT SUB
    p# = _SNDGETPOS(musIntro&)
    core# = _SNDLEN(musIntro&) - INTRO_TAIL
    IF _SNDPLAYING(musIntro&) AND p# < core# THEN EXIT SUB
    _SNDVOL nowPlaying&, MusicVol! : _SNDLOOP nowPlaying&
    IF _SNDPLAYING(musIntro&) THEN _SNDSETPOS nowPlaying&, p# - core#
    _SNDSTOP musIntro& : musIntro& = 0
END SUB

' How loud the music plays: the MUSIC VOLUME setting - halved while the
' game's paused under the menu (musicDuck!)
' OpenGL's animation clock (ripples, flicker, shimmer, beams): the time -
' or, while the game's paused under the menu, the time it paused at
FUNCTION glClock#
    IF glFrozen THEN glClock# = glFrozenAt# ELSE glClock# = TIMER(0.001)
END FUNCTION

FUNCTION MusicVol!
    MusicVol! = setting(SET_MUSIC) / 100 * musicDuck!
END FUNCTION

' The music's volume, as it should be now (after a change of setting, or
' of musicDuck!)
SUB SetMusicVol
    IF nowPlaying& > 0 THEN _SNDVOL nowPlaying&, MusicVol!
    IF musIntro& > 0 THEN _SNDVOL musIntro&, MusicVol!
END SUB
