''
' NEON-CASTER - DEMO/BOT.BM
' =============================================================================
' The autopilot: what it goes for, the way there, and playing like a person.
'

' --- THE AUTOPILOT (bot on): it plays the sector - and recording, a demo
' of it. Each frame it decides this frame's keys (inBits) and turn
' (botTurn), as you would:
'   - a monster it can see, near: turn to it and fire (backing off one
'     that's on top of it)
'   - else a goal - the exit, if there's a way to it; else a keycard it
'     hasn't got; low on health, a medkit; else somewhere it hasn't been -
'     and the way there, the next cell along it (BotField: every cell's
'     steps to the nearest goal, out from the goals)
'   - a closed door in the way: face it and press Space; at the exit, the same
'   - stuck (not getting anywhere): that cell's out for a while, and a new way
' Dead: recording a demo, the demo ends there; otherwise it clicks to start again.
SUB BotThink STATIC
    BotThinkRaw
    BotHumanize
END SUB

' --- As fast as a person, and no faster. A hand doesn't change its keys
' every frame: each of the moving keys and the trigger, once pressed or
' let go, stays so a while - botKeyOn / botKeyOff, measured from a person
' playing, at bot human 60. Except to stop at an edge: a key whose next
' step would be a pit, a ledge or a wall is let go at once, as you would.
' And a mouse hand flicks - fast, up to about 15 degrees a frame - but
' speeds up into it and slows out of it: the turn may change by only so
' much a frame.
SUB BotHumanize STATIC
    bhs = botHuman / 60 ' (60: as measured - more, slower; 0, a machine)
    bcx = INT(playerX) : bcy = INT(playerY)
    FOR bk = 0 TO 5
        bv = 2 ^ bk : bnow = (inBits AND bv) <> 0
        IF botKeyState(bk) THEN bm = INT(botKeyOn(bk) * bhs) ELSE bm = INT(botKeyOff(bk) * bhs) ' (held at least this long - or let go at least this long - before it changes)
        IF bnow <> botKeyState(bk) AND lvFrame - botKeyAt(bk) >= bm THEN botKeyState(bk) = bnow : botKeyAt(bk) = lvFrame
        IF botKeyState(bk) AND NOT bnow AND bk <= 3 THEN ' (held on, though it wants to let go: not if that step's unsafe)
            bmx = dirX * ((bk = 0) - (bk = 1)) * -1 + (-dirY) * ((bk = 3) - (bk = 2)) * -1 : bmy = dirY * ((bk = 0) - (bk = 1)) * -1 + dirX * ((bk = 3) - (bk = 2)) * -1
            bx = INT(playerX + bmx * 0.6) : by = INT(playerY + bmy * 0.6)
            IF NOT (bx = bcx AND by = bcy) THEN IF NOT BotStep(bcx, bcy, bx, by, 0) THEN botKeyState(bk) = 0 : botKeyAt(bk) = lvFrame
        END IF
        IF botKeyState(bk) THEN inBits = inBits OR bv ELSE inBits = inBits AND NOT bv
    NEXT
    ' A turn, once started, is carried through a few frames - a hand doesn't
    ' nudge the mouse for one frame and stop - and past where it meant to
    ' stop, now and then: it eases off rather than stopping dead
    IF bhs > 0 THEN
        IF botTurnPrev = 0 AND botTurn <> 0 THEN botTurnLeft = INT((3 + RND * 5) * bhs) : botTurnSgn = SGN(botTurn)
        IF botTurnLeft > 0 THEN
            botTurnLeft = botTurnLeft - 1
            IF SGN(botTurn) <> botTurnSgn OR ABS(botTurn) < 0.006 THEN botTurn = botTurnSgn * MaxOf(0.006, ABS(botTurnPrev) * 0.6)
        END IF
    END IF
    bacc = 0.05 / MaxOf(0.5, bhs) ' (how much the turn may change in a frame: about 3 degrees - a person's flicks, measured)
    botTurn = botTurnPrev + MaxOf(-bacc, MinOf(bacc, botTurn - botTurnPrev)) : botTurnPrev = botTurn
END SUB

SUB BotThinkRaw STATIC
    inBits = 0 : inWheel = 0 : botTurn = 0 : botPitch = 0
    IF lvFrame < botFrameWas THEN ' (the sector started again - its clock back to 0: what it had ruled out, and when, is from before - forgotten)
        FOR by = 0 TO mapN - 1 : FOR bx = 0 TO mapN - 1 : botBlock(bx, by) = 0 : botSeen(bx, by) = 0 : NEXT : NEXT
        FOR bi = 1 TO MAX_MON : botIgnore(bi) = 0 : botSawAt(bi) = 0 : NEXT
        botNX = 0 : botStuck = 0 : botCheckAt = 0 : botStallAt = 0 : botStallN = 0 : botAmmoAt = 0 : botBest = BOT_FAR : botBestAt = 0 : botNowhereAt = 0
        FOR bk = 0 TO 5 : botKeyAt(bk) = 0 : botKeyState(bk) = 0 : NEXT
        botTurnLeft = 0 : botLookAmp = 0 : botTurnPrev = 0 : botTarget = 0 : botTargetSeen = 0 : botBackOn = 0 : botStrafeAt = 0 : botBurstAt = 0 : botPauseUntil = 0 : botReactAt = 0
    END IF
    botFrameWas = lvFrame
    IF dead THEN ' Dead: recording, that's the end of the demo - two seconds on, so it's seen (as DOOM's often ended) - else it clicks to start again
        IF NOT botWasDead THEN botDeaths = botDeaths + 1 : botWasDead = -1
        IF demoRec AND deadTicks >= 120 THEN
            ConPrint "bot: died - the demo ends here"
            DemoStop
            IF demoRecQuit THEN SYSTEM 0
            EXIT SUB
        END IF
        IF NOT demoRec AND deadTicks > 80 AND (lvFrame MOD 20) = 0 THEN inBits = DB_FIRE ' (start again)
        EXIT SUB
    END IF
    IF botWasDead THEN botWasDead = 0
    bcx = INT(playerX) : bcy = INT(playerY)
    bh = botHuman / 100 ' How human (bot human): turns slower and eased, aim that drifts, a beat before it fires at what it's just seen, bursts not a held trigger, now and then a pause
    botTurnMax = 0.27 : botTurnK = 0.35 ' (a flick: up to 15 degrees a frame - the human filter eases it in and out)
    botAimErr = botAimErr * 0.96 + (RND - 0.5) * 0.012 * bh : botAimErr = MaxOf(-0.07 * bh, MinOf(0.07 * bh, botAimErr))
    IF lvFrame >= botBurstAt THEN ' (the trigger tapped, as a person does: held 6-11 frames, let go 3-6)
        botBurstOn = NOT botBurstOn
        IF botBurstOn THEN botBurstAt = lvFrame + 6 + INT(RND * 6) ELSE botBurstAt = lvFrame + 3 + INT(RND * 4)
        IF botBurstOn THEN botTrig = 0.9 + RND * 2.2 * bh ' (how near the crosshair must be, this tap: sometimes it's patient, sometimes not)
    END IF
    IF lvFrame >= botStrafeAt THEN ' (a dodge: a short strafe, either way - 10 to 35 frames - then a while without: as measured)
        IF botStrafeOK THEN
            botStrafeOK = 0 : botStrafeAt = lvFrame + 15 + INT(RND * 50)
        ELSE
            botStrafeOK = -1 : botStrafeDir = SGN(RND - 0.5) : IF botStrafeDir = 0 THEN botStrafeDir = 1
            botStrafeAt = lvFrame + 10 + INT(RND * 26)
        END IF
    END IF
    IF lvFrame >= botStallAt THEN ' Not moved in two seconds, whatever it's doing - three times running, and something's wrong: what it's shooting at is left alone a while, the way ahead's out
        IF (playerX - botStallX) ^ 2 + (playerY - botStallY) ^ 2 < 0.01 AND liftCell(bcx, bcy) = 0 THEN botStallN = botStallN + 1 ELSE botStallN = 0
        IF botStallN >= 3 THEN
            IF botTarget THEN botIgnore(botTarget) = lvFrame + 600
            IF botNX THEN botBlock(botNX, botNY) = lvFrame + 600
            botNX = 0 : botStallN = 0 : botStuck = 2
        END IF
        botStallX = playerX : botStallY = playerY : botStallAt = lvFrame + 120
    END IF
    FOR by = bcy - 2 TO bcy + 2 : FOR bx = bcx - 2 TO bcx + 2 ' (where it's been)
        IF bx > 0 AND by > 0 AND bx < mapN AND by < mapN THEN botSeen(bx, by) = -1
    NEXT : NEXT
    ' The gun: the best one it has with something to fire
    bg = 1
    IF hasGun(2) AND ammoCount(AM_SHELLS) > 0 THEN bg = 2
    IF hasGun(3) AND ammoCount(AM_CELLS) > 10 THEN bg = 3
    IF bg <> currentGun AND swapTimer = 0 THEN inBits = inBits + bg * DB_GUN
    ' A monster to fight? (With nothing to fire, only one on top of it - kicked)
    bAmmo = (ammoCount(AM_CELLS) > 0) OR (bg = 2 AND ammoCount(AM_SHELLS) > 0)
    bt = 0 : bbd = 7 : IF NOT bAmmo THEN bbd = 1.3
    IF botTarget THEN ' The one it's on: kept while it's alive and near - for half a second after it's out of sight, as a corner flickers it in and out
        IF monsterState(botTarget) < 2 AND botIgnore(botTarget) <= lvFrame THEN
            bd = SQR((monsterX(botTarget) - playerX) ^ 2 + (monsterY(botTarget) - playerY) ^ 2)
            IF bd < bbd + 1.5 THEN
                IF CanSee(playerX, playerY, monsterX(botTarget), monsterY(botTarget)) THEN botTargetSeen = lvFrame
                IF lvFrame - botTargetSeen < 30 THEN bt = botTarget : bbd = bd
            END IF
        END IF
    END IF
    IF bt = 0 THEN
    FOR bi = 1 TO numMonsters
        IF monsterState(bi) < 2 AND (cyberOn = 0 OR monsterType(bi) = MT_ICE) THEN
            bd = SQR((monsterX(bi) - playerX) ^ 2 + (monsterY(bi) - playerY) ^ 2)
            IF bd < bbd AND botIgnore(bi) <= lvFrame THEN
                ba = _ATAN2(monsterY(bi) - playerY, monsterX(bi) - playerX) - _ATAN2(dirY, dirX) ' (in front of it - within its view - or close, or it's just been hurt: no eyes in the back of its head)
                DO WHILE ba > 3.14159265 : ba = ba - 6.2831853 : LOOP
                DO WHILE ba < -3.14159265 : ba = ba + 6.2831853 : LOOP
                IF ABS(ba) < 0.85 OR bd < 2 OR hurtFlash > 0 THEN IF CanSee(playerX, playerY, monsterX(bi), monsterY(bi)) THEN bt = bi : bbd = bd : botTargetSeen = lvFrame
            END IF
        END IF
    NEXT
    END IF
    botTarget = bt
    IF bt AND health < 35 AND NOT godMode AND botMode = 3 THEN ' Badly hurt, and a medkit to go to: no standing to trade shots - it goes on its way, firing only at what's in line
        ba = BotTurnTo(monsterX(bt), monsterY(bt), playerX, playerY, dirX, dirY) : IF ABS(ba) < 0.08 AND bAmmo THEN inBits = inBits OR DB_FIRE ' (its turn: the way it goes overrides it, below)
        bt = 0
    END IF
    IF bt <> botLastTarget THEN ' A new one: a moment to react (0.2 to 0.5 seconds at bot human 60) - and the flick to it will land off, overshoot and settle
        botLastTarget = bt : botReactAt = lvFrame + INT(botHuman / 60 * (12 + RND * 18))
        botAimE0 = SGN(RND - 0.5) * (0.06 + RND * 0.16) * botHuman / 60
        botAimV0 = SGN(RND - 0.5) * (0.04 + RND * 0.12) * botHuman / 60
    END IF
    IF bt THEN botSawAt(bt) = lvFrame
    IF bt AND lvFrame < botReactAt THEN bt = 0 ' (seen - not reacted to yet: it carries on as it was, a moment, before it turns)
    IF bt THEN
        ' Where it aims: at the monster as it is (no leading a moving one), off
        ' by the flick's error - overshooting one way then the other as it
        ' settles (a fading swing), a third of a second or so - and a hand's
        ' tremor (botAimErr) on top
        bat = lvFrame - botReactAt
        bae = botAimE0 * COS(bat * 0.22) * EXP(-bat / 24) + botAimErr
        bmx = monsterX(bt) - playerX : bmy = monsterY(bt) - playerY
        ba = BotTurnTo(playerX + bmx * COS(bae) - bmy * SIN(bae), playerY + bmx * SIN(bae) + bmy * COS(bae), playerX, playerY, dirX, dirY)
        ' ...and up or down (LOOK UP / DOWN, with OpenGL): at its middle, from
        ' your eye - the first look high or low, swinging and settling as across
        bmz = MonFoot(bt) + mtypeScale(monsterType(bt)) * 0.5
        botPitch = ATN((bmz - eyeZ) / MaxOf(0.5, bbd)) + botAimV0 * COS(bat * 0.19 + 0.6) * EXP(-bat / 30)
        IF bAmmo AND bbd > 2.5 THEN inBits = inBits OR DB_AIM ' (down the sights, to be sure of the shot)
        IF ABS(ba - bae) < ATN(0.3 / MaxOf(0.5, bbd)) * botTrig AND lvFrame >= botReactAt THEN ' (fires when its crosshair's near enough - near enough varies, so it shoots too soon now and then, and misses)
            IF bAmmo AND (botBurstOn OR bh = 0) THEN inBits = inBits OR DB_FIRE
            IF bbd < 1.3 AND kickTimer = 0 THEN inBits = inBits OR DB_KICK
        END IF
        IF bbd < 2.2 THEN botBackOn = -1 ELSE IF bbd > 3 THEN botBackOn = 0 ' (out of reach of its claws - backing off till well clear, not to and fro on the line)
        IF botBackOn AND bAmmo THEN inBits = inBits OR DB_BACK
        IF bAmmo AND NOT botBackOn AND botStrafeOK THEN ' (side to side as it shoots - harder to hit - but only onto floor it could step to: no pit, ledge or fire; once it can't, no more this time)
            bsd = botStrafeDir
            bx = INT(playerX - dirY * bsd * 0.7) : by = INT(playerY + dirX * bsd * 0.7)
            IF (bx = bcx AND by = bcy) OR BotStep(bcx, bcy, bx, by, 0) THEN
                IF bsd = 1 THEN inBits = inBits OR DB_RIGHT ELSE inBits = inBits OR DB_LEFT
            ELSE
                botStrafeOK = 0
            END IF
        END IF
        botCheckAt = lvFrame + 60 : botBestAt = lvFrame ' (fighting isn't being stuck - nor getting nowhere)
        EXIT SUB
    END IF
    ' Where to? Every 15 frames (or when there's no way), the field again
    IF lvFrame MOD 15 = 0 OR botNX = 0 THEN BotPlan
    IF botMode = 0 THEN ' Nowhere to go: look round - and after three seconds of it, forget what it ruled out, and where it's been: it explores afresh
        botTurn = 0.03
        IF botNowhereAt = 0 THEN botNowhereAt = lvFrame
        IF lvFrame - botNowhereAt > 180 THEN
            FOR by = 0 TO mapN - 1 : FOR bx = 0 TO mapN - 1 : botBlock(bx, by) = 0 : botSeen(bx, by) = 0 : NEXT : NEXT
            botNowhereAt = 0 : botNX = 0
        END IF
        EXIT SUB
    END IF
    botNowhereAt = 0
    ' At the goal: the exit's beside it - face it and press Space
    IF botDist(bcx, bcy) = 0 AND botMode = 1 THEN
        ba = BotTurnTo(botEX + 0.5, botEY + 0.5, playerX, playerY, dirX, dirY)
        IF ABS(ba) < 0.25 AND (lvFrame MOD 16) < 2 THEN inBits = inBits OR DB_USE
        EXIT SUB
    END IF
    IF botDist(bcx, bcy) = 0 AND botMode = 6 THEN ' Beside a data station: face it and jack in
        FOR bk = 0 TO 3
            bx = bcx + (bk = 1) - (bk = 0) : by = bcy + (bk = 3) - (bk = 2)
            IF worldMap(bx, by) = 8 THEN ba = BotTurnTo(bx + 0.5, by + 0.5, playerX, playerY, dirX, dirY) : IF ABS(ba) < 0.25 AND (lvFrame MOD 16) < 2 THEN inBits = inBits OR DB_USE
        NEXT
        botCheckAt = lvFrame + 60
        EXIT SUB
    END IF
    ' The next cell: a closed door? Face it and open it. Else, walk to its middle
    IF worldMap(botNX, botNY) = 2 AND doorOpen(botNX, botNY) < 0.8 THEN
        ba = BotTurnTo(botNX + 0.5, botNY + 0.5, playerX, playerY, dirX, dirY)
        IF doorOpen(botNX, botNY) = 0 AND doorMove(botNX, botNY) <> 1 AND ABS(ba) < 0.3 AND (lvFrame MOD 16) < 2 THEN inBits = inBits OR DB_USE
        botCheckAt = lvFrame + 60
        EXIT SUB
    END IF
    ' Where to head: the furthest cell of the way ahead it can walk to in a
    ' straight line (BotLineClear) - so it goes across a room, or down a
    ' diagonal, as a line, not cell by cell in steps
    btx = botNX + 0.5 : bty = botNY + 0.5
    IF botNX = 0 THEN ' (on the goal's own cell: to its middle - or right onto the pickup lying in it, as you must be within 0.45 of one to take it)
        btx = bcx + 0.5 : bty = bcy + 0.5
        FOR bi = 1 TO numItems
            IF itemOn(bi) AND INT(itemX(bi)) = bcx AND INT(itemY(bi)) = bcy THEN btx = itemX(bi) : bty = itemY(bi)
        NEXT
    END IF
    FOR bk = botPathN TO 2 STEP -1
        IF BotLineClear(playerX, playerY, botPathX(bk) + 0.5, botPathY(bk) + 0.5, bpass) THEN btx = botPathX(bk) + 0.5 : bty = botPathY(bk) + 0.5 : EXIT FOR
    NEXT
    ba = BotTurnTo(btx, bty, playerX, playerY, dirX, dirY)
    IF bh > 0 AND lvFrame >= botPauseUntil AND RND < 0.008 * bh AND botDist(bcx, bcy) > 3 THEN botPauseUntil = lvFrame + 3 + INT(RND * 13) : botLookAmp = 0 ' (often, a moment's pause - 3 to 15 frames, as a person's)
    IF bh > 0 AND lvFrame >= botPauseUntil AND RND < 0.003 * bh AND botMode = 4 THEN ' (now and then, exploring, a stop to look round: a sweep one way and back - 30 to 80 frames)
        botLookAt = lvFrame : botPauseUntil = lvFrame + 30 + INT(RND * 51) : botLookAmp = 0.03 + RND * 0.05 : botLookDir = SGN(RND - 0.5) : IF botLookDir = 0 THEN botLookDir = 1
    END IF
    IF lvFrame < botPauseUntil THEN
        botTurn = 0.025 * SIN(lvFrame / 9) : botCheckAt = lvFrame + 60 : botStallAt = lvFrame + 120
        IF botLookAmp > 0 THEN botTurn = botLookDir * botLookAmp * SIN((lvFrame - botLookAt) / (botPauseUntil - botLookAt) * 6.2831853)
    ELSE
        IF ABS(ba) < 0.7 THEN inBits = inBits OR DB_FWD
        IF lvFrame >= botRunAt THEN botRunOn = (RND < 0.35 OR bh = 0) : botRunAt = lvFrame + 22 + INT(RND * 100) ' (running now and then - a person runs about a sixth of the time)
        IF botRunOn AND ABS(ba) < 0.3 AND botDist(bcx, bcy) > 6 THEN inBits = inBits OR DB_RUN
        IF bh > 0 AND lvFrame >= botDriftUntil AND RND < 0.01 * bh THEN botDriftDir = SGN(RND - 0.5) : botDriftUntil = lvFrame + 10 + INT(RND * 41) ' (now and then, a strafe as it walks - a person's diagonals)
        IF lvFrame < botDriftUntil AND ABS(ba) < 0.5 THEN IF botDriftDir > 0 THEN inBits = inBits OR DB_RIGHT ELSE inBits = inBits OR DB_LEFT
    END IF
    IF INT(playerX) = botNX AND INT(playerY) = botNY THEN BotPlan ' (there: the next one)
    ' Stuck? Every second: not a quarter of a cell further (and not riding a lift)
    IF lvFrame >= botCheckAt THEN
        IF (playerX - botLastX) ^ 2 + (playerY - botLastY) ^ 2 < 0.06 AND liftCell(bcx, bcy) = 0 THEN
            botStuck = botStuck + 1 : botBlock(botNX, botNY) = lvFrame + 600 : botNX = 0 ' (that cell's out for ten seconds: another way)
        ELSE
            botStuck = 0
        END IF
        botLastX = playerX : botLastY = playerY : botCheckAt = lvFrame + 60
    END IF
    IF botStuck >= 2 THEN inBits = inBits OR DB_RIGHT : IF (lvFrame MOD 30) < 2 THEN inBits = inBits OR DB_USE
END SUB

' --- The autopilot's plan: a goal (botMode 1 the exit, 2 a keycard, 3 a
' medkit, 4 somewhere it hasn't been - 0 none), its field (BotField), and
' the next cell along the way (botNX, botNY)
SUB BotPlan STATIC
    botMode = 0 : botNX = 0
    bcx = INT(playerX) : bcy = INT(playerY)
    FOR bpass = 0 TO 1 ' (first keeping out of fire and harmful liquids - then, if there's no other way, not)
        ' It knows only what it's seen (cellSeen - the map's own fog): a pickup,
        ' a keycard, the exit, a station once it's been in sight - and it plans
        ' only through cells it's seen. In the network it's in a hurry: all of it.
        IF cyberOn THEN ' In the network: the data cores (enough of them, and it lets you out - jacked out, its station hacked)
            BotClear
            FOR bi = cyberItemStart + 1 TO numItems
                IF itemOn(bi) AND itemKind(bi) = IT_CORE THEN BotGoal INT(itemX(bi)), INT(itemY(bi))
            NEXT
            BotField bpass
            IF botDist(bcx, bcy) < BOT_FAR THEN botMode = 7 : EXIT FOR
        ELSE
            IF health < 60 THEN ' Hurt: a medkit it's seen - further, the more it's hurt
                BotClear
                FOR bi = 1 TO numItems
                    IF itemOn(bi) AND (itemKind(bi) = IT_HEALTH OR itemKind(bi) = IT_BIGMED) THEN IF cellSeen(INT(itemX(bi)), INT(itemY(bi))) THEN BotGoal INT(itemX(bi)), INT(itemY(bi))
                NEXT
                BotField bpass
                IF botDist(bcx, bcy) < 15 + (60 - MaxOf(0, health)) THEN botMode = 3 : EXIT FOR
            END IF
            bNone = (ammoCount(AM_CELLS) = 0) AND NOT (hasGun(2) AND ammoCount(AM_SHELLS) > 0) ' (nothing at all to fire)
            IF ammoCount(AM_CELLS) < 10 AND ammoCount(AM_SHELLS) < 4 THEN ' Low on ammo: some it's seen - near, or anywhere with nothing to fire
                BotClear
                FOR bi = 1 TO numItems
                    IF itemOn(bi) AND (itemKind(bi) = IT_CELLS OR itemKind(bi) = IT_SHELLS OR itemKind(bi) = IT_REPEATER OR itemKind(bi) = IT_SCATTER) THEN IF cellSeen(INT(itemX(bi)), INT(itemY(bi))) THEN BotGoal INT(itemX(bi)), INT(itemY(bi))
                NEXT
                BotField bpass
                IF botDist(bcx, bcy) < 30 OR (botDist(bcx, bcy) < BOT_FAR AND bNone) THEN botMode = 5 : EXIT FOR
            END IF
            BotClear ' Anything worth having it's seen, close by - as you'd pick a room clean
            FOR bi = 1 TO numItems
                IF itemOn(bi) THEN IF cellSeen(INT(itemX(bi)), INT(itemY(bi))) THEN IF BotWants(bi, health, armor) THEN BotGoal INT(itemX(bi)), INT(itemY(bi))
            NEXT
            BotField bpass
            IF botDist(bcx, bcy) <= 8 THEN botMode = 8 : EXIT FOR
            BotClear ' A keycard it's seen and hasn't got
            FOR bi = 1 TO numItems
                IF itemOn(bi) AND itemKind(bi) >= 1 AND itemKind(bi) <= 3 THEN IF NOT hasCard(itemKind(bi)) AND cellSeen(INT(itemX(bi)), INT(itemY(bi))) THEN BotGoal INT(itemX(bi)), INT(itemY(bi))
            NEXT
            BotField bpass
            IF botDist(bcx, bcy) < BOT_FAR THEN botMode = 2 : EXIT FOR
            IF NOT bNone THEN ' A monster it saw lately, near: after it - a room cleared before moving on
                BotClear
                FOR bi = 1 TO numMonsters
                    IF monsterState(bi) < 2 AND botSawAt(bi) > 0 AND lvFrame - botSawAt(bi) < 600 AND botIgnore(bi) <= lvFrame THEN BotGoal INT(monsterX(bi)), INT(monsterY(bi))
                NEXT
                BotField bpass
                IF botDist(bcx, bcy) <= 14 THEN botMode = 9 : EXIT FOR
            END IF
            BotClear ' How far's the nearest edge of what it's seen? (a frontier: a seen cell beside one it hasn't)
            FOR by = 1 TO mapN - 2 : FOR bx = 1 TO mapN - 2
                IF BotFrontier(bx, by) THEN BotGoal bx, by
            NEXT : NEXT
            BotField bpass
            bFront = botDist(bcx, bcy)
            BotClear ' The exit, once it's seen it - when there's nothing new close by left to look at
            FOR by = 1 TO mapN - 2 : FOR bx = 1 TO mapN - 2
                IF worldMap(bx, by) = 2 THEN
                    IF doorType(bx, by) = DOOR_EXIT AND cellSeen(bx, by) THEN
                        botEX = bx : botEY = by
                        IF worldMap(bx + 1, by) <= 0 THEN BotGoal bx + 1, by
                        IF worldMap(bx - 1, by) <= 0 THEN BotGoal bx - 1, by
                        IF worldMap(bx, by + 1) <= 0 THEN BotGoal bx, by + 1
                        IF worldMap(bx, by - 1) <= 0 THEN BotGoal bx, by - 1
                    END IF
                END IF
            NEXT : NEXT
            BotField bpass
            IF botDist(bcx, bcy) < BOT_FAR AND bFront > 12 THEN botMode = 1 : EXIT FOR
        END IF
        BotClear ' Exploring: the nearest edge of what it's seen
        FOR by = 1 TO mapN - 2 : FOR bx = 1 TO mapN - 2
            IF BotFrontier(bx, by) THEN BotGoal bx, by
        NEXT : NEXT
        BotField bpass
        IF botDist(bcx, bcy) < BOT_FAR THEN botMode = 4 : EXIT FOR
        BotClear ' Nothing new to see: a data station it's seen, not hacked (it opens the sealed doors) - beside it
        FOR bi = 1 TO numStations
            IF NOT stationDone(bi) AND cellSeen(stationX(bi), stationY(bi)) THEN
                bx = stationX(bi) : by = stationY(bi)
                IF worldMap(bx + 1, by) <= 0 THEN BotGoal bx + 1, by
                IF worldMap(bx - 1, by) <= 0 THEN BotGoal bx - 1, by
                IF worldMap(bx, by + 1) <= 0 THEN BotGoal bx, by + 1
                IF worldMap(bx, by - 1) <= 0 THEN BotGoal bx, by - 1
            END IF
        NEXT
        BotField bpass
        IF botDist(bcx, bcy) < BOT_FAR THEN botMode = 6 : EXIT FOR
    NEXT
    ' (Getting no nearer the goal in fifteen seconds - it can't really get there, whatever the plan says: that goal's out for a minute)
    IF botMode <> botWas OR botDist(bcx, bcy) < botBest THEN botBest = botDist(bcx, bcy) : botBestAt = lvFrame
    IF botMode > 0 AND lvFrame - botBestAt > 900 THEN
        FOR by = 1 TO mapN - 2 : FOR bx = 1 TO mapN - 2
            IF botDist(bx, by) = 0 THEN botBlock(bx, by) = lvFrame + 3600
        NEXT : NEXT
        ConPrint "bot: can't get to that (" + ListItem$(BOT_MODES, botMode + 1) + ") - trying something else"
        botBest = BOT_FAR : botBestAt = lvFrame : botMode = 0 : botNX = 0 : EXIT SUB
    END IF
    IF botMode <> botWas THEN ConPrint "bot: " + ListItem$(BOT_MODES, botMode + 1) + " (" + LTRIM$(STR$(botDist(bcx, bcy))) + " steps, frame" + STR$(lvFrame) + ")" : botWas = botMode
    IF botMode = 0 THEN EXIT SUB
    ' The next cell: the neighbour it can step to that's nearest the goal
    bb = botDist(bcx, bcy) : IF BotPadAt(bcx, bcy) THEN bb = BOT_FAR ' (on a pad, just arrived: its own distance is for stepping onto it - off it, the nearest way)
    FOR bk = 0 TO 3
        bx = bcx + (bk = 1) - (bk = 0) : by = bcy + (bk = 3) - (bk = 2)
        IF botDist(bx, by) < bb THEN IF BotStep(bcx, bcy, bx, by, bpass) THEN bb = botDist(bx, by) : botNX = bx : botNY = by
    NEXT
    IF botNX = 0 AND botDist(bcx, bcy) > 0 THEN botMode = 0
    ' The way ahead (botPath): downhill through the field from here, up to 12
    ' cells - stopping at a door, a pad, a lift or the goal (those it walks to
    ' squarely)
    botPathN = 0 : bpx = bcx : bpy = bcy
    DO WHILE botPathN < 12 AND botMode > 0
        bb = botDist(bpx, bpy) : bqx = 0
        FOR bk = 0 TO 3
            bx = bpx + (bk = 1) - (bk = 0) : by = bpy + (bk = 3) - (bk = 2)
            IF botDist(bx, by) < bb THEN IF BotStep(bpx, bpy, bx, by, bpass) THEN bb = botDist(bx, by) : bqx = bx : bqy = by
        NEXT
        IF bqx = 0 THEN EXIT DO
        botPathN = botPathN + 1 : botPathX(botPathN) = bqx : botPathY(botPathN) = bqy
        IF worldMap(bqx, bqy) = 2 OR BotPadAt(bqx, bqy) OR liftCell(bqx, bqy) OR botDist(bqx, bqy) = 0 THEN EXIT DO
        bpx = bqx : bpy = bqy
    LOOP
END SUB

SUB BotClear STATIC ' (every cell far, the queue empty - before the goals go in)
    FOR by = 0 TO mapN - 1 : FOR bx = 0 TO mapN - 1 : botDist(bx, by) = BOT_FAR : NEXT : NEXT
    botQT = 0
END SUB

' The autopilot's goal: cell (x, y), 0 steps from itself - into the queue
SUB BotGoal(x, y)
    IF x < 1 OR y < 1 OR x > mapN - 2 OR y > mapN - 2 THEN EXIT SUB
    IF botDist(x, y) = 0 THEN EXIT SUB
    botDist(x, y) = 0 : botQT = botQT + 1 : botQ(botQT) = y * mapN + x
END SUB

' The autopilot's field: out from the goals (BotGoal), how many steps each
' cell is from the nearest - a "breadth-first search", as the thieves'
' way home (chapter 19), but backwards: from cell c, who could step onto
' it? A neighbour whose step is allowed (BotStep). A teleporter pad is two
' things: stood on (just arrived from its partner) you walk off it as off
' any floor - so its partner, stepped onto, is one more step away; and a
' pad's own distance is that: for stepping onto it. haz: fire and harmful
' liquids are allowed too.
SUB BotField(haz)
    DIM cx, cy, d, k, nx, ny ' (its own: the main program shares these names)
    h& = 1
    DO WHILE h& <= botQT
        c& = botQ(h&) : h& = h& + 1
        cx = c& MOD mapN : cy = c& \ mapN : d = botDist(cx, cy) + 1
        FOR k = 0 TO 3
            nx = cx + (k = 1) - (k = 0) : ny = cy + (k = 3) - (k = 2)
            IF nx > 0 AND ny > 0 AND nx < mapN - 1 AND ny < mapN - 1 THEN
                IF BotStep(nx, ny, cx, cy, haz) THEN
                    pk = BotPadAt(nx, ny)
                    IF pk = 0 THEN
                        IF botDist(nx, ny) > d THEN botDist(nx, ny) = d : botQT = botQT + 1 : botQ(botQT) = ny * mapN + nx
                    ELSE ' A pad: standing on it (just arrived from its partner) you can step here - so its partner, stepped onto, is d + 1 away (not while a lockdown has them dead)
                        o = pk + 1 : IF pk MOD 2 = 0 THEN o = pk - 1
                        IF o >= 1 AND o <= numPads AND NOT PadLockedDown(pk) AND NOT PadLockedDown(o) THEN
                            IF botDist(padX(o), padY(o)) > d + 1 THEN botDist(padX(o), padY(o)) = d + 1 : botQT = botQT + 1 : botQ(botQT) = padY(o) * mapN + padX(o)
                        END IF
                    END IF
                END IF
            END IF
        NEXT
    LOOP
END SUB

' A frontier: a cell it's seen, that it could stand in or go through,
' with one beside it it hasn't seen - the edge of what it knows
FUNCTION BotFrontier(x, y)
    IF NOT cellSeen(x, y) THEN EXIT FUNCTION
    IF worldMap(x, y) > 0 AND worldMap(x, y) <> 2 THEN EXIT FUNCTION
    IF NOT cellSeen(x + 1, y) OR NOT cellSeen(x - 1, y) OR NOT cellSeen(x, y + 1) OR NOT cellSeen(x, y - 1) THEN BotFrontier = -1
END FUNCTION

' Is pickup i worth going out of the way for, as you would, with health hp and armour ar? (Not a keycard:
' those are a goal of their own)
FUNCTION BotWants(i, hp, ar)
    SELECT CASE itemKind(i)
        CASE IT_HEALTH, IT_BIGMED : BotWants = hp < MAX_HP
        CASE IT_ARMOR : BotWants = ar < MAX_ARMOR
        CASE IT_CELLS : BotWants = ammoCount(AM_CELLS) < ammoMax(AM_CELLS)
        CASE IT_SHELLS : BotWants = ammoCount(AM_SHELLS) < ammoMax(AM_SHELLS)
        CASE IT_SCATTER : BotWants = NOT hasGun(2) OR ammoCount(AM_SHELLS) < ammoMax(AM_SHELLS)
        CASE IT_REPEATER : BotWants = NOT hasGun(3) OR ammoCount(AM_CELLS) < ammoMax(AM_CELLS)
        CASE IT_RAIL : BotWants = NOT hasGun(4)
        CASE IT_GOGGLES : BotWants = NOT nvHave ' (one you have stays on the floor)
        CASE IT_SUIT : BotWants = suitLeft < SUIT_MAX
        CASE IT_MAP, IT_OVERCHARGE, IT_AMP : BotWants = -1
    END SELECT
END FUNCTION

' Is there a teleporter pad in cell (x, y)? (Its number, or 0)
FUNCTION BotPadAt(x, y)
    DIM k ' (its own: the main program shares these names)
    FOR k = 1 TO numPads
        IF padX(k) = x AND padY(k) = y THEN BotPadAt = k : EXIT FUNCTION
    NEXT
END FUNCTION

' Can you step from cell (ax, ay) to the next one, (bx, by)? As Walkable%
' and MoveBody have it, for a whole cell: no wall (a door you can open is
' fine - not the exit, nor one locked, nor one wanting a card you haven't
' got), no diagonal, block, glass or decoration, not too high a step up nor
' too low a ceiling, no pit - and unless haz, no fire or harmful liquid.
' (A lift: any height - it carries you. A cell the autopilot found itself
' stuck at: not for a while.)
FUNCTION BotStep(ax, ay, bx, by, haz)
    DIM d, w ' (its own: the main program shares these names)
    IF bx < 1 OR by < 1 OR bx > mapN - 2 OR by > mapN - 2 THEN EXIT FUNCTION
    IF botBlock(bx, by) > lvFrame THEN EXIT FUNCTION
    IF NOT cellSeen(bx, by) AND NOT cyberOn THEN EXIT FUNCTION ' (somewhere it hasn't seen: it doesn't know it's there)
    w = worldMap(bx, by)
    IF w > 0 THEN
        IF w <> 2 THEN EXIT FUNCTION
        IF doorOpen(bx, by) < 0.8 THEN
            IF doorType(bx, by) = DOOR_EXIT OR doorLock(bx, by) <> 0 THEN EXIT FUNCTION
            IF doorKey(bx, by) THEN IF NOT hasCard(doorKey(bx, by)) THEN EXIT FUNCTION
        END IF
    END IF
    IF diagCorner(bx, by) OR boxOn(bx, by) OR glassHP(bx, by) > 0 THEN EXIT FUNCTION
    d = decoCell(bx, by) : IF cyberOn THEN d = 0 ' (the network has no decorations)
    IF d THEN IF decoOn(d) AND decoKind(d) <> DK_BODY THEN EXIT FUNCTION
    IF NOT levelFlat THEN
        IF floorH(bx, by) <= PIT_DEPTH THEN EXIT FUNCTION
        IF liftCell(ax, ay) = 0 AND liftCell(bx, by) = 0 THEN IF floorH(bx, by) > floorH(ax, ay) + STEP_UP THEN EXIT FUNCTION
        IF ceilH(bx, by) - MaxOf(floorH(bx, by), floorH(ax, ay)) < BODY_H THEN EXIT FUNCTION
    END IF
    IF NOT haz THEN
        IF FloorHazard(bx, by) = HAZ_BURN THEN EXIT FUNCTION
        IF liqAny THEN IF liqKind(bx, by) THEN IF lqHurt(liqKind(bx, by)) > 0 THEN EXIT FUNCTION
    END IF
    BotStep = -1
END FUNCTION

' Can the autopilot walk from (x0, y0) to (x1, y1) in a straight line? Along
' it - and along two lines either side, a body's width apart, so it
' doesn't clip a corner - each cell it crosses into must be a step it may
' take (BotStep: a wall, a ledge too high, a pit, fire...)
FUNCTION BotLineClear(x0, y0, x1, y1, haz)
    DIM cx, cy, d, i, n, sx, sy ' (its own: the main program shares these names)
    dx = x1 - x0 : dy = y1 - y0 : d = SQR(dx * dx + dy * dy)
    IF d < 0.05 THEN BotLineClear = -1 : EXIT FUNCTION
    ox = -dy / d * 0.34 : oy = dx / d * 0.34 : n = INT(d / 0.1) + 1
    FOR side = -1 TO 1
        cx = INT(x0 + ox * side) : cy = INT(y0 + oy * side)
        FOR i = 1 TO n
            sx = x0 + ox * side + dx * i / n : sy = y0 + oy * side + dy * i / n
            IF INT(sx) <> cx OR INT(sy) <> cy THEN
                IF NOT BotStep(cx, cy, INT(sx), INT(sy), haz) THEN EXIT FUNCTION
                cx = INT(sx) : cy = INT(sy)
            END IF
        NEXT
    NEXT
    BotLineClear = -1
END FUNCTION

' The autopilot, at (px, py) facing (dx, dy), turns towards point (x, y):
' botTurn - half the way there (botTurnK), at most botTurnMax a frame
' (0.12: about 7 degrees) - and how far off it still is, in radians (- left)
FUNCTION BotTurnTo(x, y, px, py, dx, dy)
    DIM a ' (its own: the main program shares these names)
    a = _ATAN2(y - py, x - px) - _ATAN2(dy, dx)
    DO WHILE a > 3.14159265 : a = a - 6.2831853 : LOOP
    DO WHILE a < -3.14159265 : a = a + 6.2831853 : LOOP
    IF ABS(a) < 0.02 * botTurnK / 0.35 + 0.004 THEN botTurn = 0 ELSE botTurn = MaxOf(-botTurnMax, MinOf(botTurnMax, a * botTurnK)) ' (near enough: still - a hand doesn't correct the last degree every frame)
    BotTurnTo = a
END FUNCTION
