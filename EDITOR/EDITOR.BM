''
' NEON-CASTER - EDITOR/EDITOR.BM
' =============================================================================
' The level editor: the map from above and the 3D view, the toolbar,
' the picker, the panes, and saving.
'

' --- A shot (or blast) hits decoration number targetDeco for hitDamage. A
' barrel's fuse is lit (it blows up next frame); anything else loses that
' much from decoHP, and at 0 it breaks: it stops blocking the way at once,
' collapses into the floor over DECO_BREAK_FRAMES (drawn in chapter 16),
' lamps and terminals go in a small puff of sparks - and it may leave loot
' (DecoLoot: a crate's ammo, a locker's armor). hitKick: your boot did it.
' --- THE LEVEL EDITOR (chapter 21) ----------------------------------------
' F2 in the game. Two views of the same level: the map from above
' (RunEditor - a loop of its own, like the menu: paint the map's
' characters with the mouse) and walking round inside it (the game, with
' everything frozen: EditFP - build and knock down where you aim, and
' change the pictures, live). Tab switches; F2 goes back to playing the
' level as it is now; Ctrl+S saves it to its file. Every change goes into
' lvlRow$() and the rest - the level as its file says it - and the level
' is built again from that (EditApply), keeping you where you are.
SUB EditEnter STATIC
    IF demoRec OR demoPlay THEN DemoStop
    achCheat = -1 ' (in the editor you can put anything anywhere: achievements wait for a new game - but the editor's own)
    WorldLoopsOff ' (the world stops: so do its sounds)
    EditReset
    edStateBack = 0
    IF editFresh OR level <> levelWas THEN editDirty = 0 : editUndoN = 0 : editRedoN = 0 : edStateBack = EditStateLoad : IF NOT edStateBack THEN EditFitMap ' (a new sector: as you left it when you saved it (EditStateLoad) - or its map fitted to the view) ' (back in after F2 to try it: the changes not saved yet, and their undo, still there)
    editFresh = 0
    IF edStateBack THEN editMode = -1 : mapOpen = 0 ELSE editMode = -1 : editView = 0 : editLights = 0 : mapOpen = 0 ' (its saved state: in the view and with the tool it had)
    IF edFullBright THEN litAll = 3 ' (FULL BRIGHT on from last time: every cell lit so)
    levelWas = level
    IF editGlyph$ = "" THEN editGlyph$ = "#"
    FOR i = 1 TO MAX_BOLTS : boltOn(i) = 0 : NEXT
    EditNote "EDITOR: " + levelName$
    EditRecentNote ' (the sectors edited last: EDIT's RESUME LAST EDIT - EDITOR/SESSION.BM)
END SUB

SUB EditLeave STATIC
    EditRecentNote ' (where you were, and the view, for RESUME LAST EDIT)
    editMode = 0 : editView = 0 : EditReset
    IF edFullBright THEN litAll = 3 ' (out of FULL BRIGHT: the sector's own light again, every cell)
    IF NOT Walkable(playerX, playerY) THEN ' (left inside something: step out to the nearest open cell)
        FOR r = 1 TO 8
            FOR a = 0 TO 15
                tx = INT(playerX + COS(a * 0.3927) * r) + 0.5 : ty = INT(playerY + SIN(a * 0.3927) * r) + 0.5
                IF tx > 0 AND ty > 0 AND tx < mapN AND ty < mapN THEN IF Walkable(tx, ty) THEN playerX = tx : playerY = ty : r = 99 : EXIT FOR
            NEXT
        NEXT
    END IF
    IF NOT levelFlat THEN playerZ = floorH(INT(playerX), INT(playerY)) : playerVZ = 0 ELSE playerZ = 0 ' (down to the floor)
    _MOUSEHIDE _DISABLE : WHILE _MOUSEINPUT : WEND : mouseSettle = 8
    IF editDirty THEN ShowMsg "Left the editor - not saved yet (F2, then Ctrl+S)" ELSE ShowMsg "Left the editor"
END SUB

' What the editor was in the middle of, forgotten: in and out of it, and
' on to another sector (the selection's cells would be another level's)
SUB EditReset STATIC
    edSelN = 0 : edHovKind = 0 : edLinkPad = 0 : edSlotPick = 0 : edTyping = 0 : edDragOn = 0 : edTbDrag = 0 : edClickL = 0 : edClickR = 0 : edTrigPane = 0 : edEvPane = 0 : edCellLtPane = 0
END SUB

' Remember the level as it is, for Ctrl+Z
SUB EditPushUndo STATIC
    IF editUndoN = EDIT_UNDO THEN
        FOR undoK = 1 TO EDIT_UNDO - 1 : editUndo$(undoK) = editUndo$(undoK + 1) : NEXT ' (its own counter: callers loop on k)
    ELSE
        editUndoN = editUndoN + 1
    END IF
    editUndo$(editUndoN) = EditSnapshot$
    editRedoN = 0 ' (a new change: what was undone can't come back over it)
END SUB

' Ctrl+Z: the level as it was before the last change - and what it was,
' kept for Ctrl+Y (redo)
SUB EditUndoStep STATIC
    IF editUndoN = 0 THEN EditNote "Nothing to undo" : EXIT SUB
    EditRedoPush EditSnapshot$
    EditRestore editUndo$(editUndoN) : editUndoN = editUndoN - 1
    sectorName$(level) = lvlName$
    EditApply : EditNote "Undone (Ctrl+Y: redo)"
END SUB

' Ctrl+Y (or Ctrl+Shift+Z): the change undone last, made again
SUB EditRedoStep STATIC
    IF editRedoN = 0 THEN EditNote "Nothing to redo" : EXIT SUB
    keepRedo = editRedoN : EditPushUndo : editRedoN = keepRedo ' (onto the undo list as any change, without losing the rest of the redo)
    EditRestore editRedo$(editRedoN) : editRedoN = editRedoN - 1
    sectorName$(level) = lvlName$
    EditApply : EditNote "Redone"
END SUB

SUB EditRedoPush(snap$)
    IF editRedoN = EDIT_UNDO THEN
        FOR redoK = 1 TO EDIT_UNDO - 1 : editRedo$(redoK) = editRedo$(redoK + 1) : NEXT ' (its own counter)
    ELSE
        editRedoN = editRedoN + 1
    END IF
    editRedo$(editRedoN) = snap$
END SUB

' A toolbar button pressed: tbHit (a TB_ number), in either view (the map
' from above's own loop sees edDone set: Tab's way out to 3D)
SUB EditTBClick STATIC
    SELECT CASE tbHit
        CASE TB_SELECT : edTool = ET_SELECT : EditNote EditTBTip$(tbHit)
        CASE TB_PLACE : edTool = ET_PLACE : EditNote EditTBTip$(tbHit)
        CASE TB_LIGHT : edTool = ET_LIGHT : EditNote EditTBTip$(tbHit)
        CASE TB_HEIGHT : edTool = ET_HEIGHT : EditNote EditTBTip$(tbHit)
        CASE TB_DELETE
            IF edSelN THEN EditPushUndo : EditDeleteSel : EditApply ELSE EditNote "Select something to delete first"
        CASE TB_UNDO : EditUndoStep
        CASE TB_REDO : EditRedoStep
        CASE TB_SAVE : EditSave level
        CASE TB_GRID : EditGridKey 0
        CASE TB_ALPHA : edTbDrag = -1 ' (dragged from here, while the button's held)
        CASE TB_VIEW : IF editView = 1 THEN editView = 0 ELSE edDone = 1
        CASE TB_HELP : edHelp = NOT edHelp
        CASE TB_PAINT : edTool = ET_PAINT : EditNote EditTBTip$(tbHit)
        CASE TB_PICK : EditPickMode
        CASE TB_PREV : EditOtherLevel_Prev
        CASE TB_NEXT : EditOtherLevel_Next
        CASE TB_KINDS : RunMonsterEditor : _MOUSESHOW
        CASE TB_SECTOR : edSectorPane = NOT edSectorPane : edTyping = 0 : edSlotPick = 0 : edVerPane = 0
        CASE TB_VERSIONS : edVerPane = NOT edVerPane : edSectorPane = 0 : edTyping = 0 : edSlotPick = 0 : edVerTop = 0 : IF edVerPane THEN EditVerList ' (EDITOR/SESSION.BM)
    END SELECT
    editLights = (edTool = ET_LIGHT) : editHeights = (edTool = ET_HEIGHT) ' (the map from above's own names for two of the tools)
END SUB

' A picker entry clicked (pkIdx): it's the brush now, and the tool that
' uses it - and with faces selected, a picture is painted on each
' (PAINT, EditPaintSel). A map character is only PLACE's brush: nothing
' is put in for you
SUB EditPkClick STATIC
    SELECT CASE edPkKind(pkIdx)
        CASE PK_GLYPH
            edSlotPick = 0 ' (a sector picture being chosen: not any more)
            pkWallK = INSTR("#NCKPG", edPkVal$(pkIdx))
            IF edTool = ET_PAINT AND pkWallK > 0 AND LEN(edPkVal$(pkIdx)) = 1 THEN ' PAINT on: a kind of wall is its picture - the brush, still painting (not PLACE: that built a wall where you clicked next)
                edBrushTex$ = lvlWall$(pkWallK) : edBrushKind = PK_TEX
                IF edBrushImg& < -1 THEN _FREEIMAGE edBrushImg&
                edBrushImg& = EditFileThumb&(edBrushTex$)
                IF edSelN THEN EditPaintSel ELSE EditNote "PAINT " + edBrushTex$ + " (" + GlyphName$(edPkVal$(pkIdx)) + "'s picture): click a face"
                EXIT SUB
            END IF
            pkDoorK = INSTR("DHX!ERBY", edPkVal$(pkIdx))
            IF edTool = ET_PAINT AND pkDoorK > 0 AND LEN(edPkVal$(pkIdx)) = 1 THEN ' PAINT on: a door is its picture too - the brush, still painting (it built a door in front of the face selected)
                SELECT CASE pkDoorK
                    CASE 2 : edBrushTex$ = "door-shutter.png"
                    CASE 3 : edBrushTex$ = "door-split.png"
                    CASE 5 : edBrushTex$ = "exit.png"
                    CASE ELSE : edBrushTex$ = "door.png"
                END SELECT
                edBrushKind = PK_TEX
                IF edBrushImg& < -1 THEN _FREEIMAGE edBrushImg&
                edBrushImg& = EditFileThumb&(edBrushTex$)
                IF edSelN THEN
                    EditPaintSel
                ELSE
                    t$ = "" : IF pkDoorK >= 6 THEN t$ = " - a key door's own colour: Shift+click it, or USUAL PICTURE"
                    EditNote "PAINT " + edBrushTex$ + " (" + GlyphName$(edPkVal$(pkIdx)) + "'s picture): click a face" + t$
                END IF
                EXIT SUB
            END IF
            editGlyph$ = edPkVal$(pkIdx) ' (PLACE's brush - the tool stays as it is: never switched for you, and nothing put in for you either - not even where something's selected: Rick's rule)
            IF edTool = ET_PLACE THEN
                EditNote "PLACE " + GlyphName$(editGlyph$) + ": click where it goes"
            ELSE
                EditNote "PLACE's brush: " + GlyphName$(editGlyph$) + " (choose PLACE to put it)"
            END IF
        CASE PK_TEX
            IF edSlotPick THEN ' (the SECTOR pane's: one of the sector's own pictures - every wall of that kind, that floor, that ceiling)
                EditPushUndo
                SELECT CASE edSlotPick
                    CASE 1 TO 6 : lvlWall$(edSlotPick) = edPkVal$(pkIdx)
                    CASE 7 TO 10 : lvlFloor$(edSlotPick - 6) = edPkVal$(pkIdx)
                    CASE ELSE : lvlCeil$(edSlotPick - 10) = edPkVal$(pkIdx)
                END SELECT
                edSlotPick = 0 : EditApply : EditNote "The sector's picture changed: " + edPkVal$(pkIdx)
                EXIT SUB
            END IF
            edBrushTex$ = edPkVal$(pkIdx) : edBrushKind = PK_TEX ' (PAINT's brush - the tool stays as it is)
            IF edBrushImg& < -1 THEN _FREEIMAGE edBrushImg&
            edBrushImg& = EditFileThumb&(edBrushTex$)
            IF edSelN THEN
                EditPaintSel
            ELSEIF edTool = ET_PAINT THEN
                EditNote "PAINT " + edBrushTex$ + ": click a face"
            ELSE
                EditNote "PAINT's picture: " + edBrushTex$ + " (choose PAINT to paint it)"
            END IF
        CASE PK_LIQUID ' A liquid (or draining one) for PAINT - and poured into the floors selected, if any
            edSlotPick = 0 : edBrushLiq$ = edPkVal$(pkIdx) : edBrushKind = PK_LIQUID ' (PAINT's brush - the tool stays as it is)
            IF edSelN THEN
                EditPaintSel
            ELSEIF edTool = ET_PAINT THEN
                EditNote "PAINT " + LiquidBrushName$(edBrushLiq$) + ": click a floor (Ctrl+click: all of it; Shift: drain)"
            ELSE
                EditNote "PAINT's brush: " + LiquidBrushName$(edBrushLiq$) + " (choose PAINT to pour it)"
            END IF
        CASE PK_LIGHT ' An effect or a colour for the light brush - and the lights on the faces selected
            edSlotPick = 0
            v = VAL(MID$(edPkVal$(pkIdx), 2)) ' (LIGHT's brush - the tool stays as it is)
            IF LEFT$(edPkVal$(pkIdx), 1) = "F" THEN
                edLFx = v
            ELSE
                c~& = EditPaletteRGB~&(v) : edLR = _RED32(c~&) : edLG = _GREEN32(c~&) : edLB = _BLUE32(c~&)
            END IF
            n = 0
            FOR k = 1 TO edSelN
                lt = EditFaceLight(edSelKind(k), edSelX(k), edSelY(k), edSelSide(k))
                IF lt THEN
                    IF n = 0 THEN EditPushUndo
                    n = n + 1
                    IF LEFT$(edPkVal$(pkIdx), 1) = "F" THEN lvlLight(lt, 8) = edLFx ELSE lvlLight(lt, 5) = edLR : lvlLight(lt, 6) = edLG : lvlLight(lt, 7) = edLB
                END IF
            NEXT
            IF n THEN
                EditApply : EditNote LTRIM$(STR$(n)) + " light(s) changed"
            ELSEIF edTool = ET_LIGHT THEN
                EditNote "LIGHT: click a face to light it - " + LCASE$(EditFxName$(edLFx))
            ELSE
                EditNote "LIGHT's brush: " + LCASE$(EditFxName$(edLFx)) + " (choose LIGHT to light a face)"
            END IF
    END SELECT
    editLights = (edTool = ET_LIGHT) : editHeights = (edTool = ET_HEIGHT)
END SUB

' PAINT's brush: the picture on the face under the pointer (its piece's, if
' it's divided) - or, with none of its own, the usual one there. Alt+click
' with PAINT, or E.
SUB EditPickPicture
    DIM bi, fc, k, w ' (its own: the main program shares these names)
    IF edHovKind = 0 THEN EditNote "Point at a face to pick its picture up" : EXIT SUB
    pic$ = EditFacePic$(edHovKind, edHovX, edHovY, edHovSide, edHovPart)
    IF pic$ = "" THEN EditNote "No picture of its own there to pick up (the exit's sign, a door's)" : EXIT SUB
    edBrushTex$ = pic$ : edBrushKind = PK_TEX
    IF edBrushImg& < -1 THEN _FREEIMAGE edBrushImg&
    edBrushImg& = EditFileThumb&(edBrushTex$) : EditNote "Picked up " + pic$
END SUB

' The picture face (kind, side) of cell (x, y) shows - its piece part if
' it's divided (0: the first) - by name: its own, or the usual one there
' ("" for one with none: the exit's sign, a door's)
FUNCTION EditFacePic$(kind, x, y, side, part)
    DIM j, p$ ' (its own: the main program shares these names)
    EditTreeGet x, y, EditFaceCode(kind, side)
    j = part : IF j < 1 OR j > ptN THEN j = 1
    p$ = ptPic$(j) : IF p$ = "" THEN p$ = EditUsualPic$(kind, x, y, side)
    EditFacePic$ = p$
END FUNCTION

' The usual picture on face (kind, side) of cell (x, y): the level's own
' for it, by name
FUNCTION EditUsualPic$(kind, x, y, side)
    DIM bi, w, p$ ' (its own: the main program shares these names)
    p$ = ""
    SELECT CASE kind
        CASE ED_FLOOR : p$ = texFile$(floorTex(x, y))
        CASE ED_CEIL : p$ = texFile$(ceilTex(x, y))
        CASE ED_WALL, ED_DIAG
            w = INSTR("#NCKPG", MID$(lvlRow$(y), x + 1, 1)) : IF w THEN p$ = lvlWall$(w)
            IF diagCorner(x, y) THEN w = wallTexSlot(worldMap(x, y)) : IF w >= 1 AND w <= 6 THEN p$ = lvlWall$(w) ' (a diagonal: the wall it took after)
            IF EditDoorIn(x, y) THEN ' (a door's own picture, if it's a file - a keycard door's is made, so none by name)
                w = PcDoorUsual(x, y, MID$(lvlRow$(y), x + 1, 1))
                IF w = T_DOOR OR w = T_SHUTTER OR w = T_SPLIT OR w = T_STRONG OR w = T_KEYPAD THEN p$ = texName$(w)
            END IF
        CASE ED_BOX : bi = EditBoxIndex(x, y) : p$ = lvlWall$(1) : IF bi THEN IF lvlBox(bi, 7) >= 1 AND lvlBox(bi, 7) <= 6 THEN p$ = lvlWall$(lvlBox(bi, 7))
        CASE ED_STEP : p$ = lvlWall$(1) : IF liftCell(x, y) THEN p$ = "" ' (a lift's side: made, so none by name)
        CASE ED_DEDGE ' (a door's edges: the door's own picture, if it's a file)
            w = PcDoorUsual(x, y, MID$(lvlRow$(y), x + 1, 1))
            IF w = T_DOOR OR w = T_SHUTTER OR w = T_SPLIT OR w = T_STRONG OR w = T_KEYPAD THEN p$ = texName$(w)
        CASE ED_TRACK : p$ = texName$(T_SHUTTER)
        CASE ELSE : p$ = lvlWall$(1)
    END SELECT
    EditUsualPic$ = p$
END FUNCTION

' PAINT's COPY: face (kind, side) of cell (x, y)'s look into the clipboard -
' piece part's (its picture by name, slid, stretched, turned, tinted), or
' with part 0 the whole face, every piece it's divided into. The clipboard
' is a tree: edClipP1$ its shape ("." one piece's look), edClipP2$ its
' pieces (PcLeafText$, joined by |).
SUB EditClipCopy(kind, x, y, side, part)
    DIM fc, j, u$ ' (its own: the main program shares these names)
    fc = EditFaceCode(kind, side) : IF fc < 1 OR fc > FACE_MAX THEN EditNote "Point at a face to copy its picture" : EXIT SUB
    u$ = EditUsualPic$(kind, x, y, side)
    EditTreeGet x, y, fc
    FOR j = 1 TO ptN : IF ptPic$(j) = "" THEN ptPic$(j) = u$ ' (the usual one here, by name: it's this picture wherever it's pasted)
    NEXT
    IF part >= 1 AND part <= ptN THEN
        IF ptN > 1 AND ptA(part) = 0 THEN EditPcStartHere kind, x, y, side, part ' (its picture from its own corner, slid to show just what it shows here: pasted on another piece, it looks the same)
        edClipP1$ = "." : edClipP2$ = PcLeafText$(part)
    ELSE
        edClipP1$ = ptShape$ : edClipP2$ = ""
        FOR j = 1 TO ptN : edClipP2$ = edClipP2$ + MID$("|", 1, -(j > 1)) + PcLeafText$(j) : NEXT
    END IF
    edClipOn = -1
    EditNote "Copied: " + EditClipName$ + " - Ctrl+V (or PASTE) puts it on a face"
END SUB

' What's copied, in words
FUNCTION EditClipName$
    DIM n, t$ ' (its own: the main program shares these names)
    IF NOT edClipOn THEN EditClipName$ = "nothing" : EXIT FUNCTION
    IF edClipP1$ = "." THEN
        PcLeafRead edClipP2$, 0 ' (piece 0: the trees' spare, for words)
        t$ = ptPic$(0) : IF t$ = "" THEN t$ = "the usual picture"
        IF LEN(EditLookName$(0)) THEN t$ = t$ + ", " + EditLookName$(0)
    ELSE
        n = PcRects(edClipP1$)
        IF edClipP1$ = "H.." THEN t$ = "left | right halves" ELSE IF edClipP1$ = "V.." THEN t$ = "top | bottom halves" ELSE t$ = "a face in" + STR$(n) + " pieces"
    END IF
    EditClipName$ = t$
END FUNCTION

' PAINT's PASTE: the clipboard's look on the face under the pointer - or on
' every selected face, when that's one of them (or nothing's under it, or
' fromPane). One undo.
SUB EditClipPaste(fromPane)
    DIM fc, j, jj, j0, j1, n, kd, fx, fy, sd, pt, useSel, done ' (its own: the main program shares these names)
    IF NOT edClipOn THEN EditNote "Nothing copied yet: Ctrl+C on a face (or COPY) first" : EXIT SUB
    useSel = fromPane
    IF NOT useSel THEN
        IF edHovKind = 0 OR edHovThing THEN
            IF edSelN = 0 THEN EditNote "Point at a face (or select some) to paste onto" : EXIT SUB
            useSel = -1
        ELSE
            FOR j = 1 TO edSelN
                IF edSelKind(j) = edHovKind AND edSelX(j) = edHovX AND edSelY(j) = edHovY AND edSelSide(j) = edHovSide THEN IF edSelPart(j) = edHovPart OR edSelPart(j) = 0 THEN useSel = -1 ' (that piece selected - or its whole face)
            NEXT
        END IF
    END IF
    EditPushUndo
    IF useSel THEN n = edSelN ELSE n = 1
    done = 0
    FOR j = 1 TO n
        IF useSel THEN kd = edSelKind(j) : fx = edSelX(j) : fy = edSelY(j) : sd = edSelSide(j) : pt = edSelPart(j) ELSE kd = edHovKind : fx = edHovX : fy = edHovY : sd = edHovSide : pt = edHovPart
        fc = EditFaceCode(kd, sd) : IF fc < 1 OR fc > FACE_MAX THEN _CONTINUE
        IF edClipP1$ = "." THEN ' (a look: on that piece - or the face, every piece of it)
            EditTreeGet fx, fy, fc : EditPcRange pt, j0, j1
            FOR jj = j0 TO j1 : PcLeafRead edClipP2$, jj : NEXT
        ELSE ' (a face's pieces: the face is divided as that one was)
            PcTreeRead 3, edClipP1$, edClipP2$, 0, 0
        END IF
        EditTreePut fx, fy, fc
        done = done + 1
    NEXT
    EditApply
    EditNote "Pasted " + EditClipName$ + " on" + STR$(done) + " face" + MID$("s", 1, -(done <> 1))
END SUB

'' The map from above: the cell (x, y) under the mouse, in the panel - what
' it is, and its pictures (a wall's, or its floor's and ceiling's): what E
' picks up
SUB EditInspect(x, y)
    DIM c$, w, yy ' (its own: the main program shares these names)
    c$ = MID$(lvlRow$(y), x + 1, 1)
    yy = TinyWrap(ED_PALX, 478, 800 - ED_PALX - 6, "CELL" + STR$(x) + "," + LTRIM$(STR$(y)) + ": " + GlyphName$(CellGlyph$(x, y)), _RGB32(255, 90, 200), 10) ' (small print, wrapped: all of it, not cut short)
    w = INSTR("#NCKPG", c$)
    IF w THEN
        yy = TinyWrap(ED_PALX, yy + 2, 800 - ED_PALX - 6, "WALL: " + EditCellPic$(x, y, 1), _RGB32(190, 180, 230), 10)
    ELSEIF worldMap(x, y) <= 0 OR worldMap(x, y) = 2 THEN
        yy = TinyWrap(ED_PALX, yy + 2, 800 - ED_PALX - 6, "FLOOR: " + EditCellPic$(x, y, 9) + "  (" + LTRIM$(STR$(CINT(floorH(x, y) * 8))) + " EIGHTHS)", _RGB32(190, 180, 230), 10)
        yy = TinyWrap(ED_PALX, yy, 800 - ED_PALX - 6, "CEILING: " + EditCellPic$(x, y, 10) + "  (" + LTRIM$(STR$(CINT(ceilH(x, y) * 8))) + " EIGHTHS)", _RGB32(190, 180, 230), 10)
    END IF
END SUB

' The picture on face f of cell (x, y) - its own (the first half's, if it's
' divided), else the usual one there
FUNCTION EditCellPic$(x, y, f)
    DIM k, w ' (its own: the main program shares these names)
    EditTreeGet x, y, f : p$ = ptPic$(1)
    IF p$ = "" THEN
        SELECT CASE f
            CASE 9 : p$ = texFile$(floorTex(x, y))
            CASE 10 : p$ = texFile$(ceilTex(x, y))
            CASE ELSE : w = INSTR("#NCKPG", MID$(lvlRow$(y), x + 1, 1)) : IF w THEN p$ = lvlWall$(w)
        END SELECT
    END IF
    EditCellPic$ = p$
END FUNCTION

' E on the map from above: cell (x, y) as the brush of the tool in use -
' PAINT: its floor's picture (ceil: its ceiling's; a wall: its own); any
' other tool: what's in it
SUB EditPickCell(x, y, ceil)
    DIM f ' (its own: the main program shares these names)
    IF edTool = ET_PAINT THEN
        f = 9 : IF ceil THEN f = 10
        IF INSTR("#NCKPG", MID$(lvlRow$(y), x + 1, 1)) THEN f = 1
        p$ = EditCellPic$(x, y, f)
        IF p$ = "" THEN EditNote "No picture there to pick up" : EXIT SUB
        edBrushTex$ = p$ : edBrushKind = PK_TEX
        IF edBrushImg& < -1 THEN _FREEIMAGE edBrushImg&
        edBrushImg& = EditFileThumb&(edBrushTex$) : EditNote "Picked up " + p$
    ELSE
        editGlyph$ = CellGlyph$(x, y) : EditNote "Picked up " + GlyphName$(editGlyph$) + " - PLACE's brush"
    END IF
END SUB

' The brush's picture on every face selected
SUB EditPaintSel STATIC
    EditPushUndo
    IF edBrushKind = PK_LIQUID THEN ' A liquid: into the cell of every floor (or step, or thing on the floor) selected
        n = 0
        FOR k = 1 TO edSelN
            IF edSelKind(k) = ED_FLOOR OR edSelKind(k) = ED_STEP THEN EditBrushLiquid edSelX(k), edSelY(k), 0 : n = n + 1
        NEXT
        EditApply : EditNote LiquidBrushName$(edBrushLiq$) + ":" + STR$(n) + " cells"
        EXIT SUB
    END IF
    FOR k = 1 TO edSelN
        IF edSelKind(k) = ED_FLOOR AND NOT EditCellOpen(edSelX(k), edSelY(k)) THEN ' (a wall cell selected from above: its four sides)
            EditPaintCell edSelX(k), edSelY(k), edBrushTex$, 0
        ELSE ' (the face selected - from above, a cell's floor)
            EditPaintFace edSelX(k), edSelY(k), EditFaceCode(edSelKind(k), edSelSide(k)), edSelPart(k), edBrushTex$
        END IF
    NEXT
    EditApply : EditNote edBrushTex$ + " on" + STR$(edSelN) + " faces"
END SUB

' Typing the sector's name: a key (k&) - Enter keeps it, Esc doesn't
SUB EditTypeKey STATIC
    SELECT CASE k&
        CASE 13 : EditTypeDone
        CASE 27 : edTyping = 0 : IF edTypeFor = 2 THEN EditNote "Commands unchanged" ELSE IF edTypeFor >= 3 THEN EditNote "Unchanged" ELSE EditNote "Name unchanged"
        CASE 8 : IF LEN(edTypeBuf$) THEN edTypeBuf$ = LEFT$(edTypeBuf$, LEN(edTypeBuf$) - 1)
        CASE 32 TO 126
            IF edTypeFresh THEN edTypeBuf$ = "" ' (the first letter typed starts it afresh - Backspace first to change the old one)
            IF edTypeFor = 2 THEN
                IF LEN(edTypeBuf$) < 120 THEN edTypeBuf$ = edTypeBuf$ + CHR$(k&) ' (commands: as typed)
            ELSEIF edTypeFor = 3 THEN
                IF LEN(edTypeBuf$) < 8 AND (INSTR("0123456789", CHR$(k&)) OR (CHR$(k&) = "?" AND edTypeBuf$ = "")) THEN edTypeBuf$ = edTypeBuf$ + CHR$(k&) ' (a code: digits - or ?, one made up each time)
            ELSEIF edTypeFor = 7 OR edTypeFor = 8 THEN
                IF LEN(edTypeBuf$) < 6 AND INSTR("0123456789ABCDEF", UCASE$(CHR$(k&))) > 0 THEN edTypeBuf$ = edTypeBuf$ + UCASE$(CHR$(k&)) ' (a colour: hex digits)
            ELSEIF edTypeFor >= 4 THEN
                IF LEN(edTypeBuf$) < 240 THEN edTypeBuf$ = edTypeBuf$ + CHR$(k&) ' (a thing's own, a note: as typed)
            ELSE
                IF LEN(edTypeBuf$) < 30 THEN edTypeBuf$ = edTypeBuf$ + UCASE$(CHR$(k&))
            END IF
    END SELECT
    edTypeFresh = 0
END SUB
SUB EditTypeDone STATIC
    edTyping = 0
    IF edTypeFor = 2 THEN edTrigCmd$ = LTRIM$(RTRIM$(edTypeBuf$)) : EditNote "Now ADD IT" : EXIT SUB ' (a trigger's commands: kept for ADD IT)
    IF edTypeFor = 7 THEN ' (a picture's tint colour: on the selection)
        IF LEN(edTypeBuf$) THEN EditTexOp 7, PcHex~&(RIGHT$("000000" + edTypeBuf$, 6)), 0, 0, -1
        EXIT SUB
    END IF
    IF edTypeFor = 8 THEN ' (a thing's look's colour: on the selection)
        IF LEN(edTypeBuf$) THEN EditLookOp 3, PcHex~&(RIGHT$("000000" + edTypeBuf$, 6))
        EXIT SUB
    END IF
    IF edTypeFor >= 3 THEN EditTypeXtra : EXIT SUB ' (a door's code, a thing's own, a note)
    IF LEN(LTRIM$(edTypeBuf$)) THEN
        EditPushUndo
        c = INSTR(lvlName$, ": ") : IF c THEN pre$ = LEFT$(lvlName$, c + 1) ELSE pre$ = "SECTOR" + STR$(level) + ": "
        lvlName$ = pre$ + LTRIM$(edTypeBuf$) : levelName$ = lvlName$ : sectorName$(level) = lvlName$ : editDirty = -1
        EditNote "Now it's " + lvlName$ + " (save to keep it)"
    END IF
END SUB

' What was typed for cell edTypeX, edTypeY: a door's code (3), a thing's
' own (4: a safe's code, what a computer opens - x y - or a camera's name),
' a note's words (5) or its picture (6)
SUB EditTypeXtra
    DIM t$, x, y, k ' (its own: the main program shares these names)
    t$ = LTRIM$(RTRIM$(edTypeBuf$)) : x = edTypeX : y = edTypeY
    EditPushUndo
    SELECT CASE edTypeFor
        CASE 3 : EditDoorSet x, y, VAL(EditXtra$("doors", x, y, 3)), t$ : EditNote "Its code: " + MID$("none", 1, -4 * (t$ = "")) + t$
        CASE 4
            k = XtraFind("things", x, y, 0)
            IF k THEN XtraSet "things", x, y, XtraField$(k, 3) + MID$(", ", 1, -2 * (t$ <> "")) + t$ : EditNote "Set: " + t$
        CASE 5 : EditNoteSet x, y, EditXtra$("notes", x, y, 3), t$ : EditNote "The note says: " + LEFT$(t$, 40)
        CASE 6 : EditNoteSet x, y, t$, EditNoteWords$(x, y) : EditNote "Its picture: " + MID$("none", 1, -4 * (t$ = "")) + t$
    END SELECT
    EditApply
END SUB

' Field n of cell x, y's line of section sec$ ("" none)
FUNCTION EditXtra$(sec$, x, y, n)
    DIM k ' (its own: the main program shares these names)
    k = XtraFind(sec$, x, y, 0) : IF k THEN EditXtra$ = XtraField$(k, n)
END FUNCTION

' A note's words at cell x, y ("" none)
FUNCTION EditNoteWords$(x, y)
    DIM k ' (its own: the main program shares these names)
    k = XtraFind("notes", x, y, 0) : IF k THEN EditNoteWords$ = XtraRest$(k, 4)
END FUNCTION

' A door's [doors] line: kicks to break it, its code - neither, no line
SUB EditDoorSet(x, y, kicks, code$)
    IF kicks <= 0 AND code$ = "" THEN XtraSet "doors", x, y, "" ELSE XtraSet "doors", x, y, LTRIM$(STR$(MaxOf(0, kicks))) + ", " + code$
END SUB

' A note's [notes] line: its picture (- none), its words - neither, no line
SUB EditNoteSet(x, y, pic$, words$)
    DIM p$ ' (its own: the main program shares these names)
    p$ = pic$ : IF p$ = "" THEN p$ = "-"
    IF p$ = "-" AND words$ = "" THEN XtraSet "notes", x, y, "" ELSE XtraSet "notes", x, y, p$ + ", " + words$
END SUB

' A properties pane button pressed (pnHit)
SUB EditPaneClick STATIC
    DIM x, y ' (its own: the main program shares these names)
    IF pnHit >= 400 AND pnHit < 500 THEN EditVerClick : EXIT SUB ' (the VERSIONS pane's: EDITOR/SESSION.BM)
    SELECT CASE pnHit
        CASE 1 TO 8 ' A door's kind: every door selected
            EditPushUndo : g$ = MID$("DHX!RBYE", pnHit, 1)
            FOR k = 1 TO edSelN
                IF (edSelKind(k) = ED_WALL OR editView = 0) AND INSTR("DHXRBY!E", MID$(lvlRow$(edSelY(k)), edSelX(k) + 1, 1)) THEN EditPut edSelX(k), edSelY(k), g$
            NEXT
            EditApply : EditNote "Now a " + GlyphName$(g$)
        CASE 20 ' A lift of the floor selected: its box, from its floor up a wall
            IF lvlNumLifts >= MAX_LIFTS THEN
                EditNote "Too many lifts already"
            ELSE
                x0 = mapN : y0 = mapN : x1 = 0 : y1 = 0 : fz = 0
                FOR k = 1 TO edSelN
                    IF edSelKind(k) = ED_FLOOR AND EditCellOpen(edSelX(k), edSelY(k)) THEN
                        x0 = MinOf(x0, edSelX(k)) : y0 = MinOf(y0, edSelY(k)) : x1 = MaxOf(x1, edSelX(k)) : y1 = MaxOf(y1, edSelY(k)) : fz = floorH(edSelX(k), edSelY(k))
                    END IF
                NEXT
                EditPushUndo
                lvlNumLifts = lvlNumLifts + 1 : k = lvlNumLifts
                lvlLift(k, 1) = x0 : lvlLift(k, 2) = y0 : lvlLift(k, 3) = x1 : lvlLift(k, 4) = y1
                lvlLift(k, 5) = INT(fz * 8 + 0.5) : lvlLift(k, 6) = lvlLift(k, 5) + 8 : lvlLift(k, 7) = 1 : lvlLift(k, 8) = 6
                EditApply : EditNote "A lift: up and down a wall - set it in the pane"
            END IF
        CASE 21 TO 26 ' A lift's low, high, speed: down or up an eighth
            lf = edPnLift : j = 5 + (pnHit - 21) \ 2 : IF j = 7 THEN j = 8
            d = 1 : IF (pnHit - 21) MOD 2 = 0 THEN d = -1
            IF lf THEN
                EditPushUndo
                lvlLift(lf, j) = lvlLift(lf, j) + d
                IF lvlLift(lf, 5) < -8 THEN lvlLift(lf, 5) = -8
                IF lvlLift(lf, 6) > H_MAX THEN lvlLift(lf, 6) = H_MAX
                IF lvlLift(lf, 6) <= lvlLift(lf, 5) THEN IF j = 5 THEN lvlLift(lf, 5) = lvlLift(lf, 6) - 1 ELSE lvlLift(lf, 6) = lvlLift(lf, 5) + 1
                IF lvlLift(lf, 8) < 1 THEN lvlLift(lf, 8) = 1
                IF lvlLift(lf, 8) > 32 THEN lvlLift(lf, 8) = 32
                EditApply
            END IF
        CASE 27 ' Up and down by itself, or an elevator (stand on it)
            lf = edPnLift
            IF lf THEN ' (up and down, an elevator, on a trigger, a crusher, a smasher - round again)
                EditPushUndo : lvlLift(lf, 7) = (lvlLift(lf, 7) MOD 5) + 1
                IF lvlLift(lf, 7) = LIFT_CRUSHER THEN ' A crusher: its ceiling, from where it is down to an eighth off the floor
                    x = lvlLift(lf, 1) : y = lvlLift(lf, 2)
                    lvlLift(lf, 5) = INT(floorH(x, y) * 8 + 0.5) + 1 : lvlLift(lf, 6) = INT(ceilH(x, y) * 8 + 0.5) : IF lvlLift(lf, 8) < 3 THEN lvlLift(lf, 8) = 3
                    IF lvlLift(lf, 6) <= lvlLift(lf, 5) THEN lvlLift(lf, 6) = lvlLift(lf, 5) + 6
                END IF
                IF lvlLift(lf, 7) = 1 THEN ' (back to a lift: from the floor up a wall)
                    x = lvlLift(lf, 1) : y = lvlLift(lf, 2) : lvlLift(lf, 5) = INT(floorH(x, y) * 8 + 0.5) : lvlLift(lf, 6) = lvlLift(lf, 5) + 8
                END IF
                EditApply : IF lvlLift(lf, 7) >= LIFT_CRUSHER THEN EditNote "Its ceiling comes down to DOWN TO - mind your head"
            END IF
        CASE 28 ' No lift here any more
            lf = edPnLift
            IF lf THEN
                EditPushUndo
                FOR k = lf TO lvlNumLifts - 1 : FOR j = 1 TO 8 : lvlLift(k, j) = lvlLift(k + 1, j) : NEXT : NEXT
                lvlNumLifts = lvlNumLifts - 1 : EditApply : EditNote "Lift taken away"
            END IF
        CASE 40 ' A light on each face selected that hasn't one, as the light brush is
            EditPushUndo : n = 0
            FOR k = 1 TO edSelN
                IF edSelKind(k) = ED_FLOOR AND NOT EditCellOpen(edSelX(k), edSelY(k)) THEN _CONTINUE ' (not inside a wall)
                IF EditFaceLight(edSelKind(k), edSelX(k), edSelY(k), edSelSide(k)) = 0 THEN EditFaceAnchor edSelKind(k), edSelX(k), edSelY(k), edSelSide(k), ax, ay : nl = lvlNumLights : EditAddLight ax, ay : IF lvlNumLights > nl THEN n = n + 1
            NEXT
            EditApply
            IF n = 0 AND lvlNumLights >= MAX_LIGHTS THEN EditNote "Too many lights (" + LTRIM$(STR$(MAX_LIGHTS)) + ")" ELSE EditNote LTRIM$(STR$(n)) + " light(s) added - set them in the pane"
        CASE 41 TO 52, 60 TO 65, 70 TO 73, 75 ' A light's colour, effect, reach, brightness: every selected face's light (and the brush, for the next)
            EditPushUndo : lmp = 0
            FOR k = 1 TO edSelN
                lt = EditFaceLight(edSelKind(k), edSelX(k), edSelY(k), edSelSide(k))
                IF lt THEN
                    SELECT CASE pnHit
                        CASE 41 TO 52 : c~& = EditPaletteRGB~&(pnHit - 40) : lvlLight(lt, 5) = _RED32(c~&) : lvlLight(lt, 6) = _GREEN32(c~&) : lvlLight(lt, 7) = _BLUE32(c~&)
                        CASE 60 TO 65 : lvlLight(lt, 8) = pnHit - 60
                        CASE 70 : lvlLight(lt, 3) = MaxOf(1, lvlLight(lt, 3) - 0.5)
                        CASE 71 : lvlLight(lt, 3) = MinOf(12, lvlLight(lt, 3) + 0.5)
                        CASE 72 : lvlLight(lt, 4) = MaxOf(20, lvlLight(lt, 4) - 10)
                        CASE 73 : lvlLight(lt, 4) = MinOf(255, lvlLight(lt, 4) + 10)
                        CASE 75 : IF k = 1 OR lmp = 0 THEN lmp = 1 - (lvlLight(lt, 9) = 0) ' (all as the first one goes: 2 none, 1 a lamp)
                            lvlLight(lt, 9) = -(lmp = 2)
                    END SELECT
                    edLR = lvlLight(lt, 5) : edLG = lvlLight(lt, 6) : edLB = lvlLight(lt, 7) : edLFx = lvlLight(lt, 8) : edLRad = lvlLight(lt, 3) : edLBri = lvlLight(lt, 4) : edLNoLamp = lvlLight(lt, 9)
                END IF
            NEXT
            EditApply
        CASE 330 TO 333 ' The selected faces' pictures slid: a pixel (Shift: 4)
            st = 1 : IF _KEYDOWN(100304) OR _KEYDOWN(100303) THEN st = 4
            EditTexOp 0, VAL(MID$("19200197121843220480", (pnHit - 330) * 5 + 1, 5)), 0, st, -1 ' (the arrow keys' codes: left, right, up, down)
        CASE 334 TO 337 ' ...stretched across or up: to the next step (Shift: a percent)
            st = 0 : IF _KEYDOWN(100304) OR _KEYDOWN(100303) THEN st = 1
            EditTexOp 1 - (pnHit >= 336), 0, 2 * (pnHit AND 1) - 1, st, -1 ' (334, 336 the - buttons)
        CASE 500 TO 505 ' A preset: on everything selected (and chosen, for REPLACE and DELETE)
            j = PrNth(edPrKey$, edPrScroll * 3 + pnHit - 499, prCount) : IF j THEN PrOp 4, j
        CASE 506 : edPrScroll = MaxOf(0, edPrScroll - 1) ' (the shelf scrolled)
        CASE 507 : edPrScroll = edPrScroll + 1
        CASE 508 TO 510 ' SAVE, REPLACE, DELETE
            PrOp pnHit - 507, 0
        CASE 511 ' Held open, up or down - in the editor only (O; Shift+click: as in play)
            EditHoldToggle edPnCX, edPnCY, (_KEYDOWN(100304) OR _KEYDOWN(100303))
        CASE 376 TO 379 ' ITS LOOK: tinted - none, TINT, WASH, GLOW
            EditLookOp 1, pnHit - 376
        CASE 380, 381 ' ...how much (10 - Shift: 1)
            st = 10 : IF _KEYDOWN(100304) OR _KEYDOWN(100303) THEN st = 1
            IF pnHit = 380 THEN st = -st
            EditLookOp 2, st
        CASE 382, 383 ' ...its size (10% - Shift: 1)
            st = 10 : IF _KEYDOWN(100304) OR _KEYDOWN(100303) THEN st = 1
            IF pnHit = 382 THEN st = -st
            EditLookOp 4, st
        CASE 384 TO 395 ' ...its colour, one of the quick ones
            EditLookOp 3, EditPaletteRGB~&(pnHit - 383) AND &HFFFFFF
        CASE 396, 397 ' ...its colour typed (RRGGBB)
            IF edTyping AND edTypeFor = 8 THEN
                EditTypeDone
            ELSE
                edTyping = -1 : edTypeFor = 8 : edTypeFresh = -1 : edTypeBuf$ = ""
                EditNote "Type its colour - RRGGBB, six hex digits (FF8800 orange) - Enter keeps it"
            END IF
        CASE 338 ' ...and put back as made
            EditTexOp 3, 0, 0, 0, -1
        CASE 375 ' ...its usual picture again (a door's, a wall's - the look kept: slid, stretched, tinted as it was)
            EditPushUndo : n = 0
            FOR k = 1 TO edSelN
                fc = EditFaceCode(edSelKind(k), edSelSide(k))
                IF fc >= 1 AND fc <= FACE_MAX THEN EditPaintFace edSelX(k), edSelY(k), fc, edSelPart(k), "" : n = n + 1
            NEXT
            EditApply : EditNote "The usual picture again on" + STR$(n) + " faces"
        CASE 339 ' COPY: the first selected face's look (picture, slid, stretched)
            FOR k = 1 TO edSelN
                fc = EditFaceCode(edSelKind(k), edSelSide(k))
                IF fc >= 1 AND fc <= FACE_MAX THEN EditClipCopy edSelKind(k), edSelX(k), edSelY(k), edSelSide(k), edSelPart(k) : EXIT FOR
            NEXT
        CASE 340 ' PASTE: it on every selected face
            EditClipPaste -1
        CASE 398, 399 ' ...flipped: left for right, upside down
            EditTexOp 10 + pnHit - 398, 0, 0, 0, -1
        CASE 341, 342 ' ...turned a quarter (342 clockwise)
            EditTexOp 4, 0, -1 - 2 * (pnHit = 342), 0, -1
        CASE 343 TO 346 ' ...tinted: none, TINT, WASH, GLOW
            EditTexOp 5, 0, 0, pnHit - 343, -1
        CASE 347, 348 ' ...its tint's amount (10 - Shift: 1)
            st = 10 : IF _KEYDOWN(100304) OR _KEYDOWN(100303) THEN st = 1
            EditTexOp 6, 0, -1 - 2 * (pnHit = 348), st, -1
        CASE 349 TO 354 ' ...its colour's red, green, blue (16 - Shift: 1)
            st = 16 : IF _KEYDOWN(100304) OR _KEYDOWN(100303) THEN st = 1
            EditTexOp 8, (pnHit - 349) \ 2, -1 - 2 * ((pnHit AND 1) = 0), st, -1
        CASE 360 TO 371 ' ...its colour, one of the quick ones
            EditTexOp 7, EditPaletteRGB~&(pnHit - 359) AND &HFFFFFF, 0, 0, -1
        CASE 355, 359 ' ...its colour typed (RRGGBB)
            IF edTyping AND edTypeFor = 7 THEN
                EditTypeDone
            ELSE
                edTyping = -1 : edTypeFor = 7 : edTypeFresh = -1 : edTypeBuf$ = ""
                EditNote "Type its colour - RRGGBB, six hex digits (FF8800 orange) - Enter keeps it"
            END IF
        CASE 356, 357 ' ...divided: H left | right, V top / bottom
            IF pnHit = 356 THEN EditDivideSel "H" ELSE EditDivideSel "V"
        CASE 358 ' ...joined again
            EditJoinSel
        CASE 372 TO 374 ' ...its picture starting at the face's grid, the piece's own corner, or fitted to the piece
            EditTexOp 9, 0, 0, pnHit - 372, -1
        CASE 74 ' The selected faces' lights, gone
            EditPushUndo
            FOR k = 1 TO edSelN
                lt = EditFaceLight(edSelKind(k), edSelX(k), edSelY(k), edSelSide(k))
                IF lt THEN
                    FOR i = lt TO lvlNumLights - 1 : FOR j = 1 TO 9 : lvlLight(i, j) = lvlLight(i + 1, j) : NEXT : NEXT
                    lvlNumLights = lvlNumLights - 1
                END IF
            NEXT
            EditApply : EditNote "Light taken away"
        CASE 200, 201 ' Every box side selected, pushed in (or pulled out) an eighth
            EditPushUndo : blkN = 0
            FOR k = 1 TO edSelN
                IF edSelKind(k) = ED_BOX THEN IF EditBoxMove(edSelX(k), edSelY(k), edSelSide(k), 1 + 2 * (pnHit = 201)) THEN blkN = blkN + 1
            NEXT
            EditApply
            IF blkN THEN EditNote "Moved" + STR$(blkN) + " side(s) an eighth" ELSE EditNote "Can't: a block is an eighth thick at least, and stays in its cell"
        CASE 202 ' The selected sides' boxes, gone
            EditPushUndo : blkN = 0
            FOR k = 1 TO edSelN
                IF edSelKind(k) = ED_BOX THEN IF EditBoxIndex(edSelX(k), edSelY(k)) THEN EditRemoveBox edSelX(k), edSelY(k) : blkN = blkN + 1
            NEXT
            edSelN = 0 : EditApply : EditNote "Removed" + STR$(blkN) + " block(s)"
        CASE 203 ' Each wall selected, a box filling its cell - the side clicked now the box's
            EditPushUndo : blkN = 0
            FOR k = 1 TO edSelN
                IF edSelKind(k) = ED_WALL THEN
                    IF EditWallToBox(edSelX(k), edSelY(k), edSelSide(k)) THEN edSelKind(k) = ED_BOX : blkN = blkN + 1
                END IF
            NEXT
            EditApply : EditNote LTRIM$(STR$(blkN)) + " wall(s) made blocks - PUSH IN shapes the side selected"
        CASE 204 ' A pillar on each floor selected: a quarter of a cell square, in its middle
            EditPushUndo : blkN = 0
            FOR k = 1 TO edSelN
                IF edSelKind(k) = ED_FLOOR THEN
                    IF MID$(lvlRow$(edSelY(k)), edSelX(k) + 1, 1) = "." AND EditBoxIndex(edSelX(k), edSelY(k)) = 0 THEN
                        IF EditAddBox(edSelX(k), edSelY(k), 3, 3, 5, 5, 1) THEN blkN = blkN + 1
                    END IF
                END IF
            NEXT
            EditApply
            IF blkN THEN EditNote LTRIM$(STR$(blkN)) + " pillar(s) - click a side of one to shape it" ELSE EditNote "A pillar needs an empty floor"
        CASE 310 TO 313 ' IN DIFFICULTY: one difficulty on or off, for everything placed in the selection (as the first one's was, turned round)
            skS = pnHit - 310 : skK = EditSkillCell
            IF skK THEN
                EditPushUndo
                skM = SkillMask(edSelX(skK), edSelY(skK)) : IF skM < 0 THEN skM = 15
                skOn = (skM AND SkillBit(skS)) = 0 : skN = 0
                FOR k = 1 TO edSelN
                    IF EditPlaced(edSelX(k), edSelY(k)) THEN
                        skM = SkillMask(edSelX(k), edSelY(k)) : IF skM < 0 THEN skM = 15
                        IF skOn THEN skM = skM OR SkillBit(skS) ELSE skM = skM AND (15 - SkillBit(skS))
                        XtraSet "difficulty", edSelX(k), edSelY(k), SkillWords$(skM) : skN = skN + 1
                    END IF
                NEXT
                EditApply
                t$ = SkillWords$(skM) : IF t$ = "" THEN t$ = "every difficulty" ELSE IF t$ = "none" THEN t$ = "no difficulty - it's never there" ELSE t$ = UCASE$(t$) + " only"
                IF skN > 1 THEN EditNote LTRIM$(STR$(skN)) + " things: " + t$ ELSE EditNote "In " + t$
            END IF
        CASE 254, 255 ' A door's kicks: a stronghold door (0: an ordinary one)
            EditPushUndo : n = VAL(EditXtra$("doors", edPnCX, edPnCY, 3)) : IF pnHit = 255 THEN n = MinOf(99, n + 1) ELSE n = MaxOf(0, n - 1)
            EditDoorSet edPnCX, edPnCY, n, EditXtra$("doors", edPnCX, edPnCY, 4) : EditApply
            IF n THEN EditNote "A stronghold door: " + LTRIM$(STR$(n)) + " kicks break it down" ELSE EditNote "An ordinary door (no kicking it down)"
        CASE 256 ' A door's code: type it
            IF edTyping AND edTypeFor = 3 THEN EditTypeDone ELSE edTyping = -1 : edTypeFor = 3 : edTypeFresh = -1 : edTypeX = edPnCX : edTypeY = edPnCY : edTypeBuf$ = EditXtra$("doors", edPnCX, edPnCY, 4) : EditNote "Type its code (digits, or ? for one made up each time) - Enter keeps it"
        CASE 257, 258 ' ...one made up each time; none
            EditPushUndo : IF pnHit = 257 THEN c$ = "?" ELSE c$ = ""
            EditDoorSet edPnCX, edPnCY, VAL(EditXtra$("doors", edPnCX, edPnCY, 3)), c$ : EditApply
            IF pnHit = 257 THEN EditNote "A keypad door: its code made up each time (a note can tell it - {code x y})" ELSE EditNote "No keypad"
        CASE 259, 260 ' A thing: the one before, after (in ThingList$)
            EditPushUndo
            FOR k = 1 TO edSelN
                IF MID$(lvlRow$(edSelY(k)), edSelX(k) + 1, 1) = CHR$(34) THEN
                    t$ = ThingName$(ThingAt(edSelX(k), edSelY(k))) : n = 1 : j = 0
                    DO : IF ListItem$(ThingList$, n) = "" THEN EXIT DO
                        IF ListItem$(ThingList$, n) = t$ THEN j = n
                        n = n + 1
                    LOOP
                    n = n - 1 : IF pnHit = 259 THEN j = j - 1 ELSE j = j + 1
                    IF j < 1 THEN j = n
                    IF j > n THEN j = 1
                    XtraSet "things", edSelX(k), edSelY(k), ListItem$(ThingList$, j) : t$ = ListItem$(ThingList$, j)
                END IF
            NEXT
            EditApply : EditNote ThingTitle$(t$)
        CASE 261 ' A thing's own: type it
            IF edTyping AND edTypeFor = 4 THEN EditTypeDone ELSE edTyping = -1 : edTypeFor = 4 : edTypeFresh = -1 : edTypeX = edPnCX : edTypeY = edPnCY : k = XtraFind("things", edPnCX, edPnCY, 0) : edTypeBuf$ = "" : IF k THEN edTypeBuf$ = XtraRest$(k, 4)
            IF edTyping AND edTypeFor = 4 THEN EditNote "A safe: its code (or ?); a computer: x, y it opens; a camera: its name - Enter keeps it"
        CASE 262 ' A note's words
            IF edTyping AND edTypeFor = 5 THEN EditTypeDone ELSE edTyping = -1 : edTypeFor = 5 : edTypeFresh = 0 : edTypeX = edPnCX : edTypeY = edPnCY : edTypeBuf$ = EditNoteWords$(edPnCX, edPnCY)
            IF edTyping AND edTypeFor = 5 THEN EditNote "Type its words (| a new line, {code x y} that door's or safe's code) - Enter keeps them"
        CASE 263 ' A note's picture
            IF edTyping AND edTypeFor = 6 THEN EditTypeDone ELSE edTyping = -1 : edTypeFor = 6 : edTypeFresh = -1 : edTypeX = edPnCX : edTypeY = edPnCY : edTypeBuf$ = EditXtra$("notes", edPnCX, edPnCY, 3) : IF edTypeBuf$ = "-" THEN edTypeBuf$ = ""
            IF edTyping AND edTypeFor = 6 THEN EditNote "Type a picture's file (in neon-caster/, e.g. achievements/NC_BESTIARY.png) - Enter keeps it"
        CASE 294 TO 299 ' A jump pad: DIR 45 degrees round, ANGLE 5 up or down, POWER 5 more or less
            EditPushUndo : EditPadGet edPnCX, edPnCY, jd, ja, jp
            SELECT CASE pnHit
                CASE 294 : jd = (jd + 315) MOD 360
                CASE 295 : jd = (jd + 45) MOD 360
                CASE 296 : ja = MaxOf(5, ja - 5)
                CASE 297 : ja = MinOf(90, ja + 5)
                CASE 298 : jp = MaxOf(5, jp - 5)
                CASE 299 : jp = MinOf(100, jp + 5)
            END SELECT
            XtraSet "things", edPnCX, edPnCY, "jumppad, " + LTRIM$(STR$(jd)) + ", " + LTRIM$(STR$(ja)) + ", " + LTRIM$(STR$(jp)) : EditApply
            IF lvlGravity = 100 THEN grf! = 1 ELSE grf! = lvlGravity / 100
            EditNote "Jump pad: DIR" + STR$(jd) + "  ANGLE" + STR$(ja) + "  POWER" + STR$(jp) + " - about" + STR$(INT(jp * jp * SIN(2 * ja * 0.0174533) / (100 * grf!) + 0.5)) + " cells, on the level"
        CASE 268 ' An alarm switch: on at first, or off
            EditPushUndo
            IF LCASE$(EditXtra$("things", edPnCX, edPnCY, 4)) = "off" THEN XtraSet "things", edPnCX, edPnCY, "alarm" : EditNote "On at first: a guard can run to it" ELSE XtraSet "things", edPnCX, edPnCY, "alarm, off" : EditNote "Off at first: a console (or alarm on) switches it on"
            EditApply
        CASE 264 ' No note
            EditPushUndo : XtraSet "notes", edPnCX, edPnCY, "" : EditApply : EditNote "No note"
        CASE 266, 267 ' A jetpack's or fuel can's fuel: 5 less, 5 more (as made: no line)
            EditPushUndo : n = EditFuel(edPnCX, edPnCY)
            IF pnHit = 267 THEN n = MinOf(JET_MAX, n + 5) ELSE n = MaxOf(5, n - 5)
            dfl = JET_CAN : IF MID$(lvlRow$(edPnCY), edPnCX + 1, 1) = "`" THEN dfl = JET_MAX
            IF n = dfl THEN XtraSet "fuel", edPnCX, edPnCY, "" ELSE XtraSet "fuel", edPnCX, edPnCY, LTRIM$(STR$(n))
            EditApply : EditNote "Fuel:" + STR$(n) + " (a full tank is" + STR$(JET_MAX) + " - about 8 seconds aloft)"
        CASE 290 TO 293 ' The selected barrels: their liquid round (a : one's), how many stand on each other
            EditPushUndo
            FOR k = 1 TO edSelN
                bc$ = MID$(lvlRow$(edSelY(k)), edSelX(k) + 1, 1)
                IF edSelKind(k) = ED_FLOOR AND (bc$ = "o" OR bc$ = ":") THEN
                    EditBarrelGet edSelX(k), edSelY(k), blq, bst
                    IF bc$ = ":" AND pnHit = 290 THEN blq = (blq + LQ_KINDS - 2) MOD LQ_KINDS + 1
                    IF bc$ = ":" AND pnHit = 291 THEN blq = blq MOD LQ_KINDS + 1
                    IF pnHit = 292 THEN bst = MaxOf(1, bst - 1)
                    IF pnHit = 293 THEN bk = 1 : IF bc$ = ":" THEN bk = DK_LQBARREL + MaxOf(1, blq)
                    IF pnHit = 293 THEN bst = StackFits(bk, edSelX(k), edSelY(k), bst + 1) ' (as many as fit under its ceiling)
                    EditBarrelSet edSelX(k), edSelY(k), blq, bst
                END IF
            NEXT
            EditApply : EditNote "Barrels:" + STR$(bst) + " high" + MID$(" of " + lqName$(MaxOf(1, blq)), 1, -99 * (blq > 0))
        CASE 205 TO 209 ' The selected decorations moved about their cells (or turned: 209)
            EditPushUndo
            FOR k = 1 TO edSelN
                IF edSelKind(k) = ED_FLOOR AND INSTR(DecoChars$, MID$(lvlRow$(edSelY(k)), edSelX(k) + 1, 1)) THEN
                    EditNudgeGet edSelX(k), edSelY(k), ndx, ndy, nfc
                    SELECT CASE pnHit
                        CASE 209 : nfc = (nfc + 1) MOD 6 ' (as built - furniture with its back to its wall - then flat facing east, south, west, north, then turning to face you)
                        CASE 205 : ndx = MaxOf(-3, ndx - 1)
                        CASE 206 : ndx = MinOf(3, ndx + 1)
                        CASE 207 : ndy = MaxOf(-3, ndy - 1)
                        CASE 208 : ndy = MinOf(3, ndy + 1)
                    END SELECT
                    EditNudgeSet edSelX(k), edSelY(k), ndx, ndy, nfc
                END IF
            NEXT
            EditApply
        CASE 210 TO 215 ' The wall the selected boxes look like
            EditPushUndo
            FOR k = 1 TO edSelN
                IF edSelKind(k) = ED_BOX THEN bi = EditBoxIndex(edSelX(k), edSelY(k)) : IF bi THEN lvlBox(bi, 7) = pnHit - 209
            NEXT
            EditApply
        CASE 80 TO 98, 242 TO 244 ' A monster's own settings: every monster selected
            EditPushUndo
            FOR k = 1 TO edSelN
                mx = edSelX(k) : my = edSelY(k)
                IF MonOfChar(MID$(lvlRow$(my), mx + 1, 1)) THEN
                    EditMonGet mx, my, ms, mh, mhp, msp, mw, mwp, mtr, mej, mst
                    SELECT CASE pnHit
                        CASE 80 : ms = MaxOf(1, ms - 1)
                        CASE 81 : ms = MinOf(40, ms + 1)
                        CASE 82 : mh = MaxOf(0, mh - 1)
                        CASE 83 : mh = MinOf(40, mh + 1)
                        CASE 84 : mhp = MaxOf(25, mhp - 25)
                        CASE 85 : mhp = MinOf(500, mhp + 25)
                        CASE 86 : msp = MaxOf(25, msp - 10)
                        CASE 87 : msp = MinOf(300, msp + 10)
                        CASE 90 TO 93 : mw = pnHit - 90
                        CASE 94 : ms = MON_SIGHT : mh = 0 : mhp = 100 : msp = 100 : mw = WAKE_SEE : mwp = TW_PLASMA : mtr = 0 : mej = 0 : mst = 0
                        CASE 95 : mwp = (mwp + TURRET_WEAPONS) MOD (TURRET_WEAPONS + 1) ' (a turret's weapon, round them)
                        CASE 96 : mwp = (mwp + 1) MOD (TURRET_WEAPONS + 1)
                        CASE 97, 98 ' (how fast a turret turns: 10 to 360 degrees a second, 0 - as made - is TURRET_TRACK)
                            IF mtr = 0 THEN mtr = TURRET_TRACK
                            mtr = MaxOf(10, MinOf(360, mtr + 10 * (2 * pnHit - 195))) : IF mtr = TURRET_TRACK THEN mtr = 0
                        CASE 242, 243 ' (how many frames a turret takes to come out and go in: 6 to 240, 0 - as made - is TURRET_EJECT)
                            IF mej = 0 THEN mej = TURRET_EJECT
                            mej = MaxOf(6, MinOf(240, mej + 6 * (2 * pnHit - 485))) : IF mej = TURRET_EJECT THEN mej = 0
                        CASE 244 : mst = (mst + 1) MOD 3 ' (how it starts: out when it wakes, folded away till it's told, out)
                    END SELECT
                    EditMonPut mx, my, ms, mh, mhp, msp, mw, mwp, mtr, mej, mst
                    FOR j = 1 TO numMonsters ' (and the monster that started there, as it is now: at once)
                        IF INT(monStartX(j)) = mx AND INT(monStartY(j)) = my AND monsterState(j) < 2 THEN MonOwn j, mx, my
                    NEXT
                END IF
            NEXT
            editDirty = -1 ' (nothing to build again: the monsters there have it already, and the game reads them when the level starts)
        CASE 100 ' The name: start typing it - or done
            IF edTyping THEN EditTypeDone ELSE edTyping = -1 : edTypeFor = 1 : edTypeFresh = -1 : edTypeBuf$ = SectorShort$ : EditNote "Type the sector's name - Enter keeps it, Esc doesn't"
        CASE 284, 285 ' The selected liquid cells: how see-through - a tenth more solid, less (0 as made, 10 solid)
            EditPushUndo : n = 0
            FOR k = 1 TO edSelN
                x = edSelX(k) : y = edSelY(k)
                IF INSTR(LQ_CHARS$, MID$(lvlLiqRow$(y), x + 1, 1)) THEN
                    n = MaxOf(0, MinOf(10, LiquidOpOf(MID$(lvlLiqORow$(y), x + 1, 1)) + 2 * pnHit - 569))
                    MID$(lvlLiqORow$(y), x + 1, 1) = LiquidOpChar$(n)
                END IF
            NEXT
            EditApply : IF n >= 10 THEN EditNote "Solid: you can't see the bottom (OpenGL)" ELSE EditNote "See-through: " + LTRIM$(STR$(n * 10)) + "% more solid than " + "as made (OpenGL)"
        CASE 300, 301 ' The sector's wetness: auto (each floor as its picture is), then 0 dry - 9 soaked
            lvlWet = MaxOf(-1, MinOf(9, lvlWet + 2 * pnHit - 601)) : glMeshVersion = glMeshVersion + 1 : editDirty = -1
            IF lvlWet < 0 THEN EditNote "Wetness: auto - each floor as its picture is (OpenGL's WET FLOORS)" ELSE EditNote "Wetness:" + STR$(lvlWet) + " of 9 (0 dry - 9 soaked; OpenGL's WET FLOORS)"
        CASE 302, 303 ' The selected floors' own wetness: . the sector's, 0 dry - 9 soaked
            EditPushUndo : n = -1
            FOR k = 1 TO edSelN
                x = edSelX(k) : y = edSelY(k)
                IF INSTR("#NCKPG", MID$(lvlRow$(y), x + 1, 1)) = 0 THEN
                    n = MaxOf(-1, MinOf(9, WetOf(MID$(lvlWetRow$(y), x + 1, 1)) + 2 * pnHit - 605))
                    MID$(lvlWetRow$(y), x + 1, 1) = WetChar$(n) : wetCell(x, y) = n
                END IF
            NEXT
            glMeshVersion = glMeshVersion + 1 : editDirty = -1
            IF n < 0 THEN EditNote "Wet: the sector's" ELSE EditNote "Wet:" + STR$(n) + " of 9 (0 dry - 9 soaked; OpenGL's WET FLOORS)"
        CASE 286, 287 ' The sector's gravity: 10% less, more (10-300 - 100 as made: falls, jumps, the jetpack's lift)
            gs = 10 : IF lvlGravity < 10 OR (lvlGravity = 10 AND pnHit = 286) THEN gs = 1 ' (under 10%: a percent a step - near zero-g)
            lvlGravity = MaxOf(1, MinOf(300, lvlGravity + gs * (2 * pnHit - 573))) : editDirty = -1
            EditNote "Gravity:" + STR$(lvlGravity) + "% (100 as made: lower, you fall slower and jump higher)"
        CASE 270, 271 ' The sector's droids: fewer, more (0 to MAX_DROIDS)
            n = lvlDroids : IF n < 0 THEN n = 3
            lvlDroids = MaxOf(0, MinOf(MAX_DROIDS, n + 2 * pnHit - 541)) : PlaceDroids level : editDirty = -1 : EditNote "Droids:" + STR$(lvlDroids)
        CASE 272 TO 275 ' Every floor (or ceiling) in the sector, down or up an eighth (Shift: a whole wall)
            EditPushUndo
            d = H_STEP * (2 * (pnHit MOD 2) - 1) : IF _KEYDOWN(100303) OR _KEYDOWN(100304) THEN d = d * 8
            FOR y = 1 TO mapN - 2 : FOR x = 1 TO mapN - 2
                IF worldMap(x, y) <= 0 OR worldMap(x, y) = 2 THEN EditRaise x, y, d, (pnHit >= 274)
            NEXT : NEXT
            EditApply : IF pnHit >= 274 THEN EditNote "Every ceiling moved" ELSE EditNote "Every floor moved"
        CASE 276, 277 ' The loot preset: none, little, as made, plenty, lots - for every breakable
            edLootSet = (edLootSet + 2 * pnHit - 553 + 5) MOD 5 : LootPreset edLootSet : editDirty = -1 : EditNote "Loot: " + LootSetName$(edLootSet)
        CASE 278, 279 ' The room's size: wider (Shift: deeper)
            IF _KEYDOWN(100303) OR _KEYDOWN(100304) THEN edRoomH = MaxOf(3, MinOf(mapN - 2, edRoomH + 2 * pnHit - 557)) ELSE edRoomW = MaxOf(3, MinOf(mapN - 2, edRoomW + 2 * pnHit - 557))
        CASE 281, 282 ' The map's size wanted: 8 cells smaller or bigger, 16 past 128 (16 to MAP_SIZE)
            edMapWant = MaxOf(16, MinOf(MAP_SIZE, edMapWant + (8 - 8 * (edMapWant + (pnHit = 281) * 8 >= 128)) * (2 * pnHit - 563)))
        CASE 283 ' ...made so: grown (new wall all round) or cut down (what's past it gone)
            EditResizeMap edMapWant : EditNote "The map:" + STR$(mapN) + " x" + STR$(mapN) + " - savelevel (Ctrl+S) to keep it"
        CASE 280 ' Make the map that room: everything else wall again (Ctrl+Z gets it back)
            EditPushUndo : EditMakeRoom edRoomW, edRoomH : EditApply : EditYouToStart : EditNote "The map: one room," + STR$(edRoomW) + " x" + STR$(edRoomH) + " - Ctrl+Z to undo"
        CASE 101, 102 ' Its light, brighter or darker
            EditPushUndo
            IF pnHit = 102 THEN lvlAmb(1) = lvlAmb(1) + 10 ELSE lvlAmb(1) = lvlAmb(1) - 10
            IF lvlAmb(1) < 0 THEN lvlAmb(1) = 0
            IF lvlAmb(1) > 256 THEN lvlAmb(1) = 256
            EditApply
        CASE 110 TO 121 ' Its light's colour
            EditPushUndo : c~& = EditPaletteRGB~&(pnHit - 109) : lvlAmb(2) = _RED32(c~&) : lvlAmb(3) = _GREEN32(c~&) : lvlAmb(4) = _BLUE32(c~&) : EditApply
        CASE 130 TO 141 ' One of its pictures: the picker shows the kind, and the next picture clicked goes there
            edSlotPick = pnHit - 129
            IF edSlotPick <= 6 THEN edPickTab = 1 ELSE IF edSlotPick <= 10 THEN edPickTab = 2 ELSE edPickTab = 3
            edPickScroll = 0 : IF edPickOn = 0 THEN edPickOn = 1
            edPickOpen = -1 : EditNote "Now click a picture in the picker - every one of these changes"
        CASE 150 TO 149 + EV_KINDS ' An event's kind - with numbers that make sense for it
            ev = edPnEvent
            IF ev THEN
                EditPushUndo : kd = pnHit - 149 : lvlEvent(ev, 1) = kd
                lvlEvent(ev, 6) = VAL(MID$("4  30 60 20 1  0  0  45 75 18020 60 ", kd * 3 - 2, 3)) : lvlEvent(ev, 7) = VAL(MID$("0  1201200  2400  0  30090 0  4  120", kd * 3 - 2, 3)) ' (each kind's own: its first number, then its second)
                IF kd > 4 THEN lvlEvent(ev, 8) = 0
                EditApply : EditNote "Now " + EvKindName$(kd)
            END IF
        CASE 250 TO 253 ' Its two numbers, down and up (not 160s: the kinds' buttons run to 149 + EV_KINDS)
            ev = edPnEvent
            IF ev THEN
                w = (pnHit - 250) \ 2 + 1 : EvField lvlEvent(ev, 1), w, lab$, unit, stp, mn, mx
                v = lvlEvent(ev, 5 + w) + stp * (2 * ((pnHit - 250) MOD 2) - 1)
                IF unit = 3 AND v = MT_ICE THEN v = v + stp * (2 * ((pnHit - 250) MOD 2) - 1) ' (the network's own: never in a room)
                IF v < mn THEN v = mn
                IF v > mx THEN v = mx
                EditPushUndo : lvlEvent(ev, 5 + w) = v : EditApply
            END IF
        CASE 166, 167 ' Its prize
            ev = edPnEvent
            IF ev THEN
                EditPushUndo
                IF pnHit = 166 THEN r = lvlEvent(ev, 8) - 1 ELSE r = lvlEvent(ev, 8) + 1
                IF r < 0 THEN r = 14
                IF r > 14 THEN r = 0
                lvlEvent(ev, 8) = r : EditApply
            END IF
        CASE 168 ' No event here any more
            ev = edPnEvent
            IF ev THEN
                EditPushUndo
                FOR k = ev TO lvlNumEvents - 1 : FOR j = 1 TO 8 : lvlEvent(k, j) = lvlEvent(k + 1, j) : NEXT : NEXT
                lvlNumEvents = lvlNumEvents - 1 : EditApply : EditNote "Event taken away" : edEvPane = 0
            END IF
        CASE 169 ' An event room of the floor selected: an ambush to start with (or, in one already, its pane)
            x0 = mapN : y0 = mapN : x1 = 0 : y1 = 0 : inEv = 0
            FOR k = 1 TO edSelN : IF inEv = 0 THEN inEv = EditEventAt(edSelX(k), edSelY(k))
            NEXT
            IF inEv THEN
                edEvPane = -1 ' (just its pane)
            ELSE
                FOR k = 1 TO edSelN
                    IF edSelKind(k) = ED_FLOOR AND EditCellOpen(edSelX(k), edSelY(k)) THEN x0 = MinOf(x0, edSelX(k)) : y0 = MinOf(y0, edSelY(k)) : x1 = MaxOf(x1, edSelX(k)) : y1 = MaxOf(y1, edSelY(k))
                NEXT
            END IF
            IF x1 >= x0 AND lvlNumEvents < MAX_EVENTS THEN
                EditPushUndo
                lvlNumEvents = lvlNumEvents + 1 : k = lvlNumEvents
                lvlEvent(k, 1) = EV_AMBUSH : lvlEvent(k, 2) = x0 : lvlEvent(k, 3) = y0 : lvlEvent(k, 4) = x1 : lvlEvent(k, 5) = y1
                lvlEvent(k, 6) = 4 : lvlEvent(k, 7) = 0 : lvlEvent(k, 8) = 4
                EditApply : EditNote "An event room: an ambush - choose its kind in the pane" : edEvPane = -1
            END IF
        CASE 170 : edTrigPane = NOT edTrigPane ' TRIGGERS...: the selection's
        CASE 220 : edCellLtPane = -1 ' CELL LIGHT...: the selection's cells' own ambient light
        CASE 221 : EditPushUndo : EditCellLight 0, 0 : EditApply : EditNote "The sector's light again" ' SECTOR'S LIGHT
        CASE 222, 223 : EditPushUndo : EditCellLight 1, 16 * (2 * pnHit - 445) : EditApply ' - / +: brighter, darker
        CASE 224 : EditPushUndo : EditCellLight 3, 0 : EditApply ' Its effect: the next one
        CASE 225 : edCellLtPane = 0 ' BACK
        CASE 230 TO 241 : EditPushUndo : EditCellLight 2, pnHit - 229 : EditApply ' A colour
        CASE 190 : edTrigPane = 0 : edTyping = 0
        CASE 189 : edEvPane = 0 ' (the event pane's BACK)
        CASE 191 TO 199 ' An action onto its commands
            IF edTyping AND edTypeFor = 2 THEN EditTypeDone
            a$ = TrigAction$(pnHit - 190, -1)
            IF LEN(edTrigCmd$) THEN edTrigCmd$ = edTrigCmd$ + " ; " + a$ ELSE edTrigCmd$ = a$
            EditNote "Commands: " + LEFT$(edTrigCmd$, 80) + "  (ADD IT when it's ready)"
        CASE 171 TO 174 : edTrigWhen = pnHit - 170
        CASE 265 : edTrigWhen = 5 ' (a computer at the cell, hacked)
        CASE 269 : edTrigWhen = 6 ' (the alarm switch at the cell set off)
        CASE 175 : edTrigRepeat = NOT edTrigRepeat
        CASE 178 : edTrigTime = MaxOf(1, edTrigTime - 5)
        CASE 179 : edTrigTime = MinOf(900, edTrigTime + 5)
        CASE 176 ' Its commands: start typing them - or done
            IF edTyping AND edTypeFor = 2 THEN
                EditTypeDone
            ELSE
                edTyping = -1 : edTypeFor = 2 : edTypeFresh = 0 : edTypeBuf$ = edTrigCmd$
                EditNote "Type its commands, as in the console (; between them) - Enter keeps them"
            END IF
        CASE 177 ' The trigger made: when, where, again?, what
            IF edTyping AND edTypeFor = 2 THEN EditTypeDone
            IF LEN(LTRIM$(edTrigCmd$)) = 0 THEN
                EditNote "Type its commands first (TYPE) - message HELLO ; sound alarm, say"
            ELSEIF lvlNumTrigs >= MAX_TRIGS THEN
                EditNote "Too many triggers already"
            ELSE
                EditTrigPlace tx0, ty0, tx1, ty1, ux, uy
                SELECT CASE edTrigWhen
                    CASE 1 : w$ = "enter" + STR$(tx0) + STR$(ty0) + STR$(tx1) + STR$(ty1)
                    CASE 2 : w$ = "use" + STR$(ux) + STR$(uy)
                    CASE 3 : w$ = "clear" + STR$(tx0) + STR$(ty0) + STR$(tx1) + STR$(ty1)
                    CASE 5 : w$ = "hack" + STR$(ux) + STR$(uy)
                    CASE 6 : w$ = "alarm" + STR$(ux) + STR$(uy)
                    CASE ELSE : w$ = "time" + STR$(edTrigTime)
                END SELECT
                IF edTrigRepeat AND edTrigWhen <= 2 THEN w$ = w$ + " repeat" ' (not time or clear: once true, they stay true)
                EditPushUndo
                lvlNumTrigs = lvlNumTrigs + 1 : lvlTrig$(lvlNumTrigs) = w$ + " : " + LTRIM$(edTrigCmd$)
                EditApply : EditNote "Trigger: " + LEFT$(lvlTrig$(lvlNumTrigs), 80)
            END IF
        CASE 180 TO 185 ' One of them, gone
            t = edTrigIdx(pnHit - 179)
            IF t >= 1 AND t <= lvlNumTrigs THEN
                EditPushUndo
                FOR k = t TO lvlNumTrigs - 1 : lvlTrig$(k) = lvlTrig$(k + 1) : NEXT
                lvlNumTrigs = lvlNumTrigs - 1 : EditApply : EditNote "Trigger taken away"
            END IF
        CASE 30 ' LINK: the next pad clicked is where this one goes
            edLinkPad = NOT edLinkPad : edLinkX = edPnCX : edLinkY = edPnCY
            IF edLinkPad THEN EditNote "Click the pad this one goes to (LINK again: never mind)"
        CASE 31 ' UNLINK: back to pairing in reading order
            EditPushUndo : EditUnpair edPnCX, edPnCY : EditApply : EditNote "Unlinked - pads pair up in reading order"
    END SELECT
END SUB

' The picker: tucked away (opening when the pointer comes down to it) ->
' always open -> off -> tucked away
SUB EditPickMode STATIC
    SELECT CASE edPickOn
        CASE 1 : edPickOn = -1 : EditNote "Picker: always open (P)"
        CASE -1 : edPickOn = 0 : EditNote "Picker: off (P)"
        CASE ELSE : edPickOn = 1 : EditNote "Picker: tucked away - move the pointer to the bottom to open it (P)"
    END SELECT
END SUB

' The grid slider, dragged: how strong, from where the pointer is along it
SUB EditTBSlide STATIC
    EditTBLayout editView
    slX = tbMX : IF editView = 1 THEN slX = tbMX + edWX ' (FULL WIDE: the toolbar's at the window's left edge)
    FOR k = 1 TO edTbN
        IF edTbId(k) = TB_ALPHA THEN
            a = (slX - edTbX(k) - 2) * 255 / (edTbW(k) - 4)
            IF a < 16 THEN a = 16
            IF a > 255 THEN a = 255
            edGridAlpha = a : edGrid = -1
        END IF
    NEXT
END SUB

' Build the level again from lvlRow$() and the rest, keeping you where you
' are (and pointing where you were)
SUB EditApply STATIC
    keepX = playerX : keepY = playerY : keepDX = dirX : keepDY = dirY
    ' What you'd done in the sector, kept through the rebuild: the monsters
    ' you'd killed stay dead where they fell (found again by where they
    ' started), the pickups you'd taken stay taken, and your kills count - or
    ' leaving the editor would bring them all back, round you
    keepKills = kills : nKeepM = 0 : nKeepI = 0
    FOR j = 1 TO monStartN
        IF monsterState(j) = 2 OR monsterState(j) = 3 THEN nKeepM = nKeepM + 1 : keepMX(nKeepM) = monStartX(j) : keepMY(nKeepM) = monStartY(j) : keepMDX(nKeepM) = monsterX(j) : keepMDY(nKeepM) = monsterY(j)
    NEXT
    FOR j = 1 TO numItems
        IF NOT itemOn(j) AND nKeepI < MAX_ITEMS THEN nKeepI = nKeepI + 1 : keepIX(nKeepI) = itemX(j) : keepIY(nKeepI) = itemY(j) : keepIK(nKeepI) = itemKind(j)
    NEXT
    kc1 = hasCard(1) : kc2 = hasCard(2) : kc3 = hasCard(3) : km = hasMap ' (and the keycards and map you'd picked up: their pickups stay taken)
    editRebuild = -1 : BuildLevel : editRebuild = 0
    hasCard(1) = kc1 : hasCard(2) = kc2 : hasCard(3) = kc3 : hasMap = km
    FOR k = 1 TO nKeepM
        FOR j = 1 TO numMonsters
            IF monsterState(j) < 2 AND ABS(monsterX(j) - keepMX(k)) < 0.01 AND ABS(monsterY(j) - keepMY(k)) < 0.01 THEN monsterState(j) = 3 : monsterX(j) = keepMDX(k) : monsterY(j) = keepMDY(k) : EXIT FOR
        NEXT
    NEXT
    FOR k = 1 TO nKeepI
        FOR j = 1 TO numItems
            IF itemOn(j) AND itemKind(j) = keepIK(k) AND ABS(itemX(j) - keepIX(k)) < 0.01 AND ABS(itemY(j) - keepIY(k)) < 0.01 THEN itemOn(j) = 0 : EXIT FOR
        NEXT
    NEXT
    kills = keepKills
    playerX = keepX : playerY = keepY : dirX = keepDX : dirY = keepDY
    planeX = -dirY * fovPlane : planeY = dirX * fovPlane ' (in the editor you fly through walls, so building over where you are is fine)
    editDirty = -1 : editFresh = 0
END SUB

' The map from above: draw it, read the mouse and keys, until Tab (walk
' round inside it) or F2 / Esc (back to the game)
SUB RunEditor STATIC
    WorldLoopsOff ' (the map from above: the world's hums stop)
    _MOUSESHOW : _KEYCLEAR
    edDone = 0 : edDown = 0 : edRect = 0 : edTbDown = -1 : edB1 = -1 ' (a button still held from the other view isn't a click here)
    DO
        _LIMIT 60
        mx = edMX : my = edMY : wheel = 0 : b1Any = 0 : b2Any = 0
        IF edForce1 THEN b1 = 0 : edForce1 = 0 ' (last frame's click, let go now)
        IF edForce2 THEN b2 = 0 : edForce2 = 0
        WHILE _MOUSEINPUT
            mx = WideMouseX(_MOUSEX) : my = _MOUSEY : wheel = wheel + _MOUSEWHEEL
            IF _MOUSEBUTTON(1) THEN b1 = -1 : b1Any = -1 ELSE b1 = 0
            IF _MOUSEBUTTON(2) THEN b2 = -1 : b2Any = -1 ELSE b2 = 0
            IF _MOUSEBUTTON(3) THEN b3Any = -1
        WEND
        IF b1Any AND NOT b1 AND NOT edB1 THEN b1 = -1 : edForce1 = -1 ' (pressed and let go between two frames: a click all the same - let go the next)
        IF b2Any AND NOT b2 AND NOT edB2 THEN b2 = -1 : edForce2 = -1
        edMX = mx : edMY = my
        ' Space held: the map pans with the mouse, and the wheel zooms it in
        ' and out round where the mouse is - and no clicks get through
        IF _KEYDOWN(32) AND NOT edTyping THEN
            IF edPanWas THEN edMapX = edMapX + mx - edPanMX : edMapY = edMapY + my - edPanMY
            edPanMX = mx : edPanMY = my : edPanWas = -1
            IF wheel THEN
                zc = MaxOf(2, MinOf(48, edCell - SGN(wheel) * MaxOf(1, edCell \ 4)))
                edMapX = mx - (mx - edMapX) * zc \ edCell : edMapY = my - (my - edMapY) * zc \ edCell : edCell = zc : wheel = 0
            END IF
            b1 = 0 : b2 = 0 : edForce1 = 0 : edForce2 = 0
        ELSE
            edPanWas = 0
        END IF
        cx = INT((mx - edMapX) / edCell) : cy = INT((my - edMapY) / edCell)
        onMap = (mx < ED_VIEWW AND my < ED_VIEWH AND cx >= 0 AND cy >= 0 AND cx < mapN AND cy < mapN)
        shiftOn = _KEYDOWN(100304) OR _KEYDOWN(100303)
        ' The wheel: over the picker, it scrolls; over the map with something
        ' selected, its floors up and down an eighth (Ctrl: its ceilings) - one
        ' undo a run; else the brush, the character before or after
        IF wheel THEN
            EditPkHit mx, my, pkWhat, pkIdx
            EditPkGeom pgx, pgy, pcols, prows, psz
            IF pkWhat OR (mx >= ED_PALX AND my >= 40 AND my < pgy + prows * (psz + 4)) THEN
                EditPkScroll SGN(wheel)
            ELSEIF edPnTitle$ <> "" AND mx >= edPnX0 - 6 AND mx <= edPnX0 + PN_W + 6 AND my <= edPnBot + 6 THEN
                ' (over the pane: nothing under it moves)
            ELSEIF onMap AND edSelN THEN
                IF ABS(TIMER - edWheelT!) > 0.5 THEN EditPushUndo
                edWheelT! = TIMER : wc = _KEYDOWN(100305) OR _KEYDOWN(100306)
                FOR k = 1 TO edSelN ' (not a plain wall's: unseen there)
                    IF INSTR("#NCKPG", MID$(lvlRow$(edSelY(k)), edSelX(k) + 1, 1)) = 0 THEN EditRaise edSelX(k), edSelY(k), -SGN(wheel) * H_STEP, wc
                NEXT
                edApply = -1
                IF wc THEN EditNote "Ceiling" + STR$(ceilH(edSelX(1), edSelY(1)) * 8 - SGN(wheel)) + " eighths" ELSE EditNote "Floor" + STR$(floorH(edSelX(1), edSelY(1)) * 8 - SGN(wheel)) + " eighths"
            ELSE
                EditCycleGlyph SGN(wheel)
            END IF
        END IF
        ' The toolbar (and the help: a click anywhere puts it away) - a press
        ' there is the toolbar's till it's let go, never paint
        tbHit = EditTBAt(mx, my, 0)
        IF b1 AND NOT edB1 THEN
            IF edHelp THEN
                edHelp = 0 : edTbDown = -1
            ELSEIF tbHit THEN
                EditTBClick : edTbDown = -1
            END IF
        END IF
        IF b1 AND edTbDrag THEN tbMX = mx : EditTBSlide
        IF NOT b1 THEN edTbDrag = 0 : edTbDown = 0
        fresh = b1 AND NOT edB1 : edB1 = b1
        ' The properties pane (over the map's right), and the picker (in the
        ' panel) - a press on them is theirs till it's let go
        IF fresh AND NOT edTbDown AND NOT edHelp AND NOT edDown THEN
            pnHit = EditPaneAt(mx, my)
            IF pnHit THEN
                EditPaneClick : edTbDown = -1
            ELSE
                EditPkHit mx, my, pkWhat, pkIdx
                SELECT CASE pkWhat
                    CASE 1 : edPickTab = pkIdx : edPickScroll = 0
                    CASE 2 : EditPkClick
                    CASE 3 : EditPkScroll -1
                    CASE 4 : EditPkScroll 1
                END SELECT
                IF pkWhat THEN edTbDown = -1
            END IF
        END IF
        EditPaneBuild : IF edPnTitle$ <> "" AND mx >= edPnX0 - 6 AND mx <= edPnX0 + PN_W + 6 AND my <= edPnBot + 6 THEN onMap = 0 ' (under the pane)
        IF edLinkPad AND fresh AND onMap THEN ' LINK: this is the pad it goes to
            IF MID$(lvlRow$(cy), cx + 1, 1) = "&" AND (cx <> edLinkX OR cy <> edLinkY) THEN
                EditPushUndo
                EditUnpair edLinkX, edLinkY : EditUnpair cx, cy
                IF lvlNumPairs < MAX_PAIRS THEN
                    lvlNumPairs = lvlNumPairs + 1 : lvlPair(lvlNumPairs, 1) = edLinkX : lvlPair(lvlNumPairs, 2) = edLinkY : lvlPair(lvlNumPairs, 3) = cx : lvlPair(lvlNumPairs, 4) = cy
                    EditNote "Linked: pad" + STR$(edLinkX) + "," + LTRIM$(STR$(edLinkY)) + " <->" + STR$(cx) + "," + LTRIM$(STR$(cy))
                ELSE
                    EditNote "Sixteen links already: unlink one first"
                END IF
                edApply = -1
            ELSE
                EditNote "That's not another pad"
            END IF
            edLinkPad = 0 : edTbDown = -1
        END IF
        IF edTbDown OR edHelp THEN onMap = 0
        editLights = (edTool = ET_LIGHT) : editHeights = (edTool = ET_HEIGHT)
        ' Painting: press, drag, let go (one undo for the whole stroke); with
        ' Shift, a rectangle from where you pressed to where you let go
        IF onMap AND editHeights THEN ' The heights: click raises the floor an eighth, right-click lowers it (Shift: the ceiling) - not a plain wall's (unseen there)
            IF INSTR("#NCKPG", MID$(lvlRow$(cy), cx + 1, 1)) THEN
                IF (b1 AND NOT edDown) OR (b2 AND NOT edB2) THEN EditNote "That's wall - heights are for open cells" : edDown = b1
            ELSE
                IF b1 AND NOT edDown THEN EditPushUndo : EditRaise cx, cy, H_STEP, shiftOn : edDown = -1 : edApply = -1
                IF b2 AND NOT edB2 THEN EditPushUndo : EditRaise cx, cy, -H_STEP, shiftOn : edApply = -1
            END IF
        END IF
        ' Middle click (or Alt+click) on the map: you, there - to walk round from (Tab)
        edAltNow = _KEYDOWN(100307) OR _KEYDOWN(100308)
        IF onMap AND (b3Any OR (b1 AND NOT edB1 AND edAltNow)) THEN
            IF worldMap(cx, cy) <= 0 OR worldMap(cx, cy) = 2 THEN
                playerX = cx + 0.5 : playerY = cy + 0.5 : playerZ = floorH(cx, cy) : eyeZ = playerZ + EYE_H : EditNote "You:" + STR$(cx) + "," + STR$(cy) + " - Tab to walk round from here"
            ELSE
                EditNote "That's wall - pick open floor"
            END IF
            b1 = 0 : edForce1 = 0
        END IF
        b3Any = 0
        IF onMap AND edTool = ET_SELECT THEN ' Selecting: press, drag a box, let go (Shift adds to what's selected) - or press on what's selected and drag: it moves with the pointer (EditDragMove; one undo)
            IF b1 AND NOT edDown THEN
                edDown = -1 : edX0 = cx : edY0 = cy : edSelAdd = shiftOn : edMoving = 0 : edMvDX = 0 : edMvDY = 0
                IF NOT shiftOn AND EditSelOnCell(cx, cy) THEN edMoving = 1 ELSE edRect = -1
            END IF
            IF b1 AND edDown AND edMoving > 0 THEN
                IF cx - edX0 <> edMvDX OR cy - edY0 <> edMvDY THEN EditDragMove cx - edX0, cy - edY0 : edApply = -1
            END IF
        END IF
        IF onMap AND edTool = ET_PAINT AND edBrushKind = PK_LIQUID THEN ' Pouring a liquid: on each floor cell dragged over (Shift: drain it)
            IF b1 AND (NOT edDown OR cx <> edX0 OR cy <> edY0) THEN
                IF NOT edDown THEN EditPushUndo
                EditBrushLiquid cx, cy, shiftOn : edApply = -1
                edDown = -1 : edX0 = cx : edY0 = cy
            END IF
        ELSEIF onMap AND edTool = ET_PAINT THEN ' Painting pictures: a floor (Ctrl: its ceiling), or a wall's four sides; Shift: the usual again - drag on across cells
            IF b1 AND (NOT edDown OR cx <> edX0 OR cy <> edY0) THEN
                IF edBrushTex$ = "" AND NOT shiftOn THEN
                    EditNote "Pick a picture first (the picker: WALLS, FLOORS, CEILINGS)"
                ELSE
                    pic$ = edBrushTex$ : IF shiftOn THEN pic$ = ""
                    lp$ = LCASE$(pic$)
                    IF INSTR("#NCKPG%?@$;", MID$(lvlRow$(cy), cx + 1, 1)) AND (LEFT$(lp$, 5) = "floor" OR LEFT$(lp$, 7) = "ceiling" OR LEFT$(lp$, 4) = "sky-") THEN
                        EditNote "That's wall: PAINT only colours it. For floor there: PLACE open floor (FLOORS tab, first)"
                    ELSE
                        IF NOT edDown THEN EditPushUndo
                        EditPaintCell cx, cy, pic$, _KEYDOWN(100305) OR _KEYDOWN(100306)
                        edApply = -1
                    END IF
                END IF
                edDown = -1 : edX0 = cx : edY0 = cy
            END IF
        END IF
        IF onMap AND edTool = ET_PLACE THEN
            IF b1 AND NOT edDown THEN EditPushUndo : edDown = -1 : edRect = shiftOn : edX0 = cx : edY0 = cy
            IF b1 AND edDown AND NOT edRect THEN EditPut cx, cy, editGlyph$
            IF b2 THEN c$ = CellGlyph$(cx, cy) : IF c$ <> editGlyph$ THEN editGlyph$ = c$ : EditNote "Picked " + GlyphName$(c$)
        END IF
        IF onMap AND editLights THEN ' The lights: click to add one, right-click to take the nearest away
            IF b1 AND NOT edDown THEN EditPushUndo : EditAddLight cx + 0.5, cy + 0.5 : edDown = -1 : edApply = -1
            IF b2 AND NOT edB2 THEN EditPushUndo : EditRemoveLight cx + 0.5, cy + 0.5 : edApply = -1
        END IF
        edB2 = b2
        IF NOT b1 AND edDown THEN ' Let go: the rectangle, then build it (or select it) - let go off the map, to its edge
            IF NOT onMap THEN cx = MaxOf(0, MinOf(mapN - 1, cx)) : cy = MaxOf(0, MinOf(mapN - 1, cy))
            IF edRect AND edTool = ET_SELECT THEN
                IF NOT edSelAdd THEN edSelN = 0
                IF edSelAdd AND edX0 = cx AND edY0 = cy THEN
                    EditSelToggle ED_FLOOR, cx, cy, 0, 0 ' (Shift+click one cell: in or out)
                ELSE
                    fresh = (edSelN = 0) ' (nothing selected before: no cell can be in twice - no looking, a 256 map's worth is quick)
                    FOR y = MinOf(edY0, cy) TO MaxOf(edY0, cy) : FOR x = MinOf(edX0, cx) TO MaxOf(edX0, cx)
                        IF fresh THEN EditSelAdd ED_FLOOR, x, y, 0, 0 ELSE IF EditSelIndex(ED_FLOOR, x, y, 0, 0) = 0 THEN EditSelToggle ED_FLOOR, x, y, 0, 0
                    NEXT : NEXT
                END IF
                EditNote LTRIM$(STR$(edSelN)) + " selected" + MID$(" - as many as there can be (" + LTRIM$(STR$(ED_MAXSEL)) + ")", 1, -999 * (edSelN >= ED_MAXSEL))
            ELSEIF edRect AND edTool = ET_PLACE THEN
                FOR y = MinOf(edY0, cy) TO MaxOf(edY0, cy) : FOR x = MinOf(edX0, cx) TO MaxOf(edX0, cx) : EditPut x, y, editGlyph$ : NEXT : NEXT
            END IF
            IF edTool = ET_PLACE THEN edApply = -1 ' (the others built as they went)
            IF edMoving = 2 THEN EditNote "Moved " + LTRIM$(STR$(edSelN)) + MID$(" cells", 1, 6 + (edSelN = 1)) + " - Ctrl+Z puts them back"
            edDown = 0 : edRect = 0 : edMoving = 0
        END IF
        IF edApply THEN edApply = 0 : EditApply
        ' Keys
        ' (Ctrl as the keys come, not as it is now: a quick Ctrl+D is often
        ' all read after Ctrl's gone up, and _KEYDOWN would call it plain D)
        mapCtrl = _KEYDOWN(100305) OR _KEYDOWN(100306)
        k& = _KEYHIT
        DO WHILE k&
            IF edTyping THEN ' (typing the sector's name: the keys are its)
                IF k& > 0 THEN EditTypeKey
                k& = _KEYHIT : _CONTINUE
            END IF
            IF EditFullBrightKey(k&) THEN k& = 0 ' (Alt+L: full bright)
            IF ABS(k&) = 100305 OR ABS(k&) = 100306 THEN mapCtrl = (k& > 0)
            IF mapCtrl THEN ' (Ctrl held: Ctrl+S, Ctrl+Z, Ctrl+D - however the key arrives)
                IF k& = 115 OR k& = 83 THEN k& = 19
                IF k& = 122 OR k& = 90 THEN k& = 26
                IF k& = 100 OR k& = 68 THEN k& = 4
            END IF
            SELECT CASE k&
                CASE 4 : edSelN = 0 : EditNote "Selection cleared" ' Ctrl+D
                CASE 21248 ' Del: delete what's selected
                    IF edSelN THEN EditPushUndo : EditDeleteSel : EditApply ELSE EditNote "Select something to delete first"
                CASE 15104 : edHelp = NOT edHelp ' F1: the help
                CASE 18432, 20480, 19200, 19712 ' The arrows: move the selection a cell (up the screen is north)
                    IF edSelN THEN
                        ndx = 0 : ndy = 0
                        SELECT CASE k&
                            CASE 18432 : ndy = -1
                            CASE 20480 : ndy = 1
                            CASE 19200 : ndx = -1
                            CASE ELSE : ndx = 1
                        END SELECT
                        EditPushUndo : EditNudge ndx, ndy : EditApply
                    ELSE
                        EditNote "Select something first: the arrows move it a cell"
                    END IF
                CASE 9 : edDone = 1 ' Tab: walk round inside it
                CASE 27, 15360 : edDone = 2 ' Esc, F2: back to the game
                CASE 19 : EditSave level ' Ctrl+S
                CASE 26 : IF shiftOn THEN EditRedoStep ELSE EditUndoStep ' Ctrl+Z (Ctrl+Shift+Z: redo)
                CASE 25 : EditRedoStep ' Ctrl+Y
                CASE 108, 76 ' L: the light tool (again: back to placing)
                    IF edTool = ET_LIGHT THEN edTool = ET_PLACE ELSE edTool = ET_LIGHT
                    IF edTool = ET_LIGHT THEN EditNote "LIGHTS: click adds, right-click takes away (the picker's LIGHTS: the colour)" ELSE EditNote "PLACE: paint with the mouse"
                CASE 104, 72 ' H: the height tool
                    IF edTool = ET_HEIGHT THEN edTool = ET_PLACE ELSE edTool = ET_HEIGHT
                    IF edTool = ET_HEIGHT THEN EditNote "HEIGHTS: click raises the floor, right-click lowers it (Shift: the ceiling)" ELSE EditNote "PLACE: paint with the mouse"
                CASE 49 TO 56 : EditNumKey k& - 48 ' 1-8: SELECT, PLACE, PAINT, LIGHT, HEIGHT, SECTOR, VERSIONS, the picker open
                CASE 101, 69 ' E: pick up the cell under the mouse as the brush of the tool in use - PAINT: its floor's picture (Ctrl: its ceiling's; a wall: its own); any other: what's in it. The tool stays as it is.
                    IF onMap THEN EditPickCell cx, cy, _KEYDOWN(100305) OR _KEYDOWN(100306) ELSE EditNote "Point at a cell to pick it up"
                CASE 116, 84 ' T: teleport you to the cell under the mouse
                    IF onMap THEN playerX = cx + 0.5 : playerY = cy + 0.5 : EditNote "You're at" + STR$(cx) + STR$(cy) + " (Tab to look)"
                CASE 18688 : EditOtherLevel_Prev ' PgUp: the sector before
                CASE 20736 : EditOtherLevel_Next ' PgDn: the one after
                CASE 91 : EditCycleGlyph -1 ' [ ]: the glyph before, after
                CASE 93 : EditCycleGlyph 1
                CASE 109, 77 : RunMonsterEditor : _MOUSESHOW ' M: the monster editor
                CASE 103, 71 : EditGridKey shiftOn ' G: the grid on / off (Shift+G: how strong)
                CASE 117, 85 : edDone = 1 : hudAfter = -1 ' U: the HUD layout editor (over the game: walking view)
            END SELECT
            k& = _KEYHIT
        LOOP
        IF edDone THEN EXIT DO
        DrawEditor cx, cy, onMap, edRect AND edDown, edX0, edY0, playerX, playerY, dirX, dirY, level, levelName$
        EditDrawPicker mx, my
        EditDrawPane mx, my
        EditDrawTB 0, mx, my
        IF edHelp THEN EditDrawHelp 0
        IF GLShows THEN GLCapture
        GLScreenLayer GLShows
        ShowFrame
    LOOP
    _KEYCLEAR
    IF edDone = 1 THEN editView = 1 : edMouseFix = -1 : fpLWas = -1 : edClickL = 0 : edClickR = 0 : EditNote "3D: point at a face - hold the right button to look round - F1 for help"
    IF hudAfter THEN hudAfter = 0 : HudEditEnter
    IF edDone = 2 THEN EditLeave
    WHILE _MOUSEINPUT : WEND
    escWas = -1 : fireWait = 10
END SUB

SUB EditOtherLevel_Prev STATIC ' (the one before - past any of yours not made)
    FOR n = level - 1 TO 1 STEP -1
        IF SectorExists(n) THEN level = n : EditGoLevel : EXIT SUB
    NEXT
END SUB
SUB EditOtherLevel_Next STATIC
    FOR n = level + 1 TO NUM_LEVELS + MAX_CUSTOM
        IF SectorExists(n) THEN level = n : EditGoLevel : EXIT SUB
    NEXT
END SUB
SUB EditGoLevel STATIC
    IF editDirty AND ABS(TIMER - editAskT!) > 3 THEN ' (not saved: say so - the same key again goes anyway)
        EditNote "Not saved: Ctrl+S keeps it - press it again to go without saving" : editAskT! = TIMER : level = levelWas : EXIT SUB
    END IF
    editAskT! = -99
    LoadLevel : EditFreshLevel
    EditNote "EDITOR: " + levelName$
    EditRecentNote
END SUB

' Another sector in the editor (PgUp/PgDn, or map N / restart typed in it):
' nothing of the last one's - its undo, its selection, its SECTOR pane's
' sizes and loot, its view of the map
SUB EditFreshLevel
    editUndoN = 0 : editRedoN = 0 : editDirty = 0 : levelWas = level : EditReset
    IF edVerPane THEN edVerTop = 0 : EditVerList ' (this sector's versions now)
    edMapWant = mapN : edRoomW = 0 : edRoomH = 0 : edLootSet = 0 : EditFitMap
END SUB

' --- THE WHEEL in the 3D editor: on the selection, and only the
' selection - never the face that just happens to be under the pointer
' (nothing selected: it says so, and changes nothing). Up raises, down
' lowers, an eighth of a wall a turn (Ctrl: a whole wall):
'   a floor, a step's face        its floor (the step's top)
'   a ceiling, a lintel's face    its ceiling (the lintel's bottom)
'   a wall's side                 nothing on its own - with a key held:
'     Shift          pull it out a cell towards you (the wheel turned towards
'                    you, down) / push it back (turned away, up) - it goes
'                    the way the wheel's top goes
'     Alt            the other way round: push it back (down) / pull it out (up)
'     Ctrl+Shift     make it a block standing on the floor, and set its top
'     Alt+Shift      make it a block hanging from the ceiling, and set its bottom
' The selection follows a face that moves, so turning on keeps going. One
' undo for a run of turns (a pause of half a second starts a new one).
SUB EditWheel STATIC
    ticks = -SGN(edWheel) * MinOf(ABS(edWheel), 8) : IF ticks = 0 THEN EXIT SUB
    wShift = _KEYDOWN(100304) OR _KEYDOWN(100303) : wCtrl = _KEYDOWN(100305) OR _KEYDOWN(100306) : wAlt = _KEYDOWN(100307) OR _KEYDOWN(100308)
    IF edSelN = 0 THEN EditNote "Select a face first (click it) - the wheel only changes what's selected" : EXIT SUB
    IF ABS(TIMER - edWheelT!) > 0.5 THEN EditPushUndo
    edWheelT! = TIMER
    dz = ticks * H_STEP : IF wCtrl AND NOT wShift THEN dz = ticks * 1
    wCount = 0
    FOR wk = 1 TO edSelN
        wx = edSelX(wk) : wy = edSelY(wk) : ws = edSelSide(wk)
        SELECT CASE edSelKind(wk)
            CASE ED_FLOOR, ED_STEP : IF EditCellOpen(wx, wy) THEN EditRaise wx, wy, dz, 0 : wCount = wCount + 1 ' (not a wall cell a box from above took in)
            CASE ED_CEIL, ED_LINTEL : IF EditCellOpen(wx, wy) THEN EditRaise wx, wy, dz, -1 : wCount = wCount + 1
            CASE ED_WALL
              FOR wt = 1 TO ABS(ticks) ' (a cell a turn)
                wx = edSelX(wk) : wy = edSelY(wk) : IF edSelKind(wk) <> ED_WALL THEN EXIT FOR
                EditFaceFront wx, wy, ws, fx, fy ' (the open cell the face looks into)
                wDir = 0
                IF wShift AND NOT wCtrl AND NOT wAlt THEN wDir = -SGN(ticks) ' (+1 pull, -1 push: the wheel towards you pulls)
                IF wAlt AND NOT wShift THEN wDir = SGN(ticks)
                IF wDir > 0 AND fx > 0 AND fy > 0 AND fx < mapN - 1 AND fy < mapN - 1 THEN ' Pull: the cell in front becomes this wall
                    EditPut fx, fy, MID$(lvlRow$(wy), wx + 1, 1) : edSelX(wk) = fx : edSelY(wk) = fy : wCount = wCount + 1
                ELSEIF wDir < 0 AND wx > 0 AND wy > 0 AND wx < mapN - 1 AND wy < mapN - 1 THEN ' Push: this wall's cell opens, like the one in front
                    EditPut wx, wy, "."
                    MID$(lvlFloorRow$(wy), wx + 1, 1) = MID$(lvlFloorRow$(fy), fx + 1, 1) : MID$(lvlCeilRow$(wy), wx + 1, 1) = MID$(lvlCeilRow$(fy), fx + 1, 1)
                    bx = wx + (wx - fx) : by = wy + (wy - fy) : edSelX(wk) = bx : edSelY(wk) = by : wCount = wCount + 1 ' (the face is now the cell behind's - if it's a wall)
                ELSEIF wCtrl AND wShift AND wx > 0 AND wy > 0 AND wx < mapN - 1 AND wy < mapN - 1 THEN ' A block on the floor: open, its floor just under the ceiling
                    EditPut wx, wy, "."
                    MID$(lvlCeilRow$(wy), wx + 1, 1) = MID$(lvlCeilRow$(fy), fx + 1, 1)
                    MID$(lvlFloorRow$(wy), wx + 1, 1) = HeightChar$(ceilH(fx, fy) - 0.25 + MinOf(0, dz), 0)
                    edSelKind(wk) = ED_STEP : wCount = wCount + 1
                ELSEIF wAlt AND wShift AND wx > 0 AND wy > 0 AND wx < mapN - 1 AND wy < mapN - 1 THEN ' A block from the ceiling: open, its ceiling just over the floor
                    EditPut wx, wy, "."
                    MID$(lvlFloorRow$(wy), wx + 1, 1) = MID$(lvlFloorRow$(fy), fx + 1, 1)
                    MID$(lvlCeilRow$(wy), wx + 1, 1) = HeightChar$(floorH(fx, fy) + 0.25 + MaxOf(0, dz), 1)
                    edSelKind(wk) = ED_LINTEL : wCount = wCount + 1
                END IF
                IF wCtrl OR (wAlt AND wShift) THEN EXIT FOR ' (a block's made once; turning on moves its top or bottom)
              NEXT
        END SELECT
    NEXT
    ' (a pushed face whose new cell isn't a wall is no face at all: drop it)
    FOR wk = edSelN TO 1 STEP -1
        IF edSelKind(wk) = ED_WALL THEN
            IF worldMap(edSelX(wk), edSelY(wk)) <= 0 AND MID$(lvlRow$(edSelY(wk)), edSelX(wk) + 1, 1) = "." THEN EditSelToggle ED_WALL, edSelX(wk), edSelY(wk), edSelSide(wk), edSelPart(wk)
        END IF
    NEXT
    EditApply
    IF wCount = 0 THEN
        EditNote "Walls: Shift+wheel pulls out / pushes back a cell, Alt pushes, Ctrl+Shift a block's top, Alt+Shift a block's bottom"
    ELSEIF edSelN = 1 THEN
        SELECT CASE edSelKind(1)
            CASE ED_FLOOR, ED_STEP : EditNote "Floor" + STR$(floorH(edSelX(1), edSelY(1)) * 8) + " eighths"
            CASE ED_CEIL, ED_LINTEL : EditNote "Ceiling" + STR$(ceilH(edSelX(1), edSelY(1)) * 8) + " eighths"
            CASE ELSE : EditNote "Wall at" + STR$(edSelX(1)) + STR$(edSelY(1))
        END SELECT
    ELSE
        EditNote LTRIM$(STR$(wCount)) + " faces changed"
    END IF
END SUB

' Walking round inside the level: the keys and the mouse buttons, each
' frame (the game loop draws it; EditOverlay shows what you're aiming at)
SUB EditFP STATIC
    IF hudEdit THEN EXIT SUB ' (the HUD layout editor has the mouse and keys)
    levelWas = level
    edCamPX = playerX : edCamPY = playerY : edCamDX = dirX : edCamDY = dirY : edCamPlane = fovPlane / zoom : edCamZoom = zoom
    IF edLooking THEN EditPick 400, 300 : EditPickThing 400, 300 ELSE EditPick edCurX, edCurY : EditPickThing edCurX, edCurY ' (looking round: the crosshair picks)
    ' The picker, tucked away, opens when the pointer comes to the bottom of
    ' the screen and tucks itself away again when it goes back up to the world
    IF edPickOn = -1 THEN edPickOpen = -1
    IF edPickOn = 0 THEN edPickOpen = 0
    IF edSlotPick > 0 AND edPickOn <> 0 THEN edPickOpen = -1 ' (choosing one of the sector's pictures: it stays open till one's chosen)
    IF edPickOn = 1 AND NOT edLooking AND edSlotPick = 0 THEN
        IF edPickOpen THEN
            IF edCurY < PK_Y - 40 THEN edPickOpen = 0
        ELSE
            IF edCurY >= PK_TUCK THEN edPickOpen = -1
        END IF
    END IF
    IF NOT edLooking AND EditOverUI(edCurX, edCurY) THEN edHovKind = 0 ' (over the toolbar or picker: no face)
    EditAim playerX, playerY, dirX, dirY, aimX, aimY, frontX, frontY
    fpL = _MOUSEBUTTON(1) OR edClickL : fpR = _MOUSEBUTTON(2) OR edClickR ' (a click between two frames counts too)
    IF edClickL AND fpLWas THEN fpLWas = 0 ' (a fresh click, even if the button looked held)
    IF edClickR AND fpRWas THEN fpRWas = 0
    edClickL = 0 : edClickR = 0
    ' A click selects the face under the pointer - it never builds anything.
    ' Shift+click adds it to the selection (or takes it out); Ctrl+click takes
    ' the whole floor (or ceiling) it's part of - every cell joined to it at
    ' the same height; clicking nothing clears the selection.
    ' With another tool, a click does that tool's thing to the face instead;
    ' on the toolbar, it's the toolbar's.
    tbHit = 0 : IF NOT edLooking THEN tbHit = EditTBAt(edCurX, edCurY, 1)
    IF fpL AND NOT fpLWas AND NOT edLooking AND edHelp THEN
        edHelp = 0 : fpLWas = -1 ' (the help was up: the click puts it away)
    ELSEIF fpL AND NOT fpLWas AND tbHit THEN
        EditTBClick : fpLWas = -1 ' (the toolbar's - never the world's too, even when it changed the view)
    ELSEIF fpL AND NOT fpLWas AND NOT edLooking AND EditPaneAt(edCurX, edCurY) THEN
        pnHit = EditPaneAt(edCurX, edCurY) : EditPaneClick : fpLWas = -1
    ELSEIF fpL AND NOT fpLWas AND NOT edLooking AND edLinkPad AND NOT EditOverUI(edCurX, edCurY) THEN ' LINK: this is the pad it goes to
        IF edHovKind = ED_FLOOR AND MID$(lvlRow$(edHovY), edHovX + 1, 1) = "&" AND (edHovX <> edLinkX OR edHovY <> edLinkY) THEN
            EditPushUndo
            EditUnpair edLinkX, edLinkY : EditUnpair edHovX, edHovY
            IF lvlNumPairs < MAX_PAIRS THEN
                lvlNumPairs = lvlNumPairs + 1 : lvlPair(lvlNumPairs, 1) = edLinkX : lvlPair(lvlNumPairs, 2) = edLinkY : lvlPair(lvlNumPairs, 3) = edHovX : lvlPair(lvlNumPairs, 4) = edHovY
                EditApply : EditNote "Linked: pad" + STR$(edLinkX) + "," + LTRIM$(STR$(edLinkY)) + " <->" + STR$(edHovX) + "," + LTRIM$(STR$(edHovY))
            ELSE
                EditApply : EditNote "Sixteen links already: unlink one first"
            END IF
            edLinkPad = 0
        ELSE
            EditNote "That's not another pad - click one (LINK again: never mind)"
        END IF
        fpLWas = -1
    ELSEIF fpL AND NOT fpLWas AND NOT edLooking AND edPickOpen THEN
        EditPkHit edCurX, edCurY, pkWhat, pkIdx
        SELECT CASE pkWhat
            CASE 1 : edPickTab = pkIdx : edPickScroll = 0
            CASE 2 : EditPkClick
            CASE 3 : EditPkScroll -1
            CASE 4 : EditPkScroll 1
        END SELECT
    END IF
    IF fpL AND edTbDrag THEN tbMX = edCurX : EditTBSlide
    IF NOT fpL THEN edTbDrag = 0
    IF fpL AND NOT fpLWas AND NOT edLooking AND NOT EditOverUI(edCurX, edCurY) AND edTool <> ET_SELECT THEN
        edShift = _KEYDOWN(100304) OR _KEYDOWN(100303)
        IF edHovKind = 0 THEN
            EditNote "Point at a face"
        ELSE
            EditFaceCell edHovKind, edHovX, edHovY, edHovSide, tx, ty
            edAlt = _KEYDOWN(100307) OR _KEYDOWN(100308)
            SELECT CASE edTool
                CASE ET_PLACE ' (Shift+click: take away what's there; Alt+click: pick it up as the brush; held: on along the floor)
                    IF tx < 1 OR ty < 1 OR tx > mapN - 2 OR ty > mapN - 2 THEN
                        EditNote "Not in the border"
                    ELSEIF edAlt THEN
                        editGlyph$ = CellGlyph$(tx, ty) : EditNote "Picked up " + GlyphName$(editGlyph$)
                    ELSEIF edShift THEN
                        c$ = MID$(lvlRow$(ty), tx + 1, 1)
                        IF c$ = "." OR INSTR("<>^v", c$) THEN
                            EditNote "Nothing to take away there"
                        ELSE
                            EditPushUndo : EditPut tx, ty, "." : EditApply : EditNote GlyphName$(c$) + " taken away"
                        END IF
                    ELSE
                        EditPushUndo : EditPut tx, ty, editGlyph$ : EditApply
                        EditNote GlyphName$(editGlyph$) + " at" + STR$(tx) + STR$(ty) + EditPlaceInfo$(tx, ty)
                        edDragX = tx : edDragY = ty : edDragOn = -1
                    END IF
                CASE ET_LIGHT ' A light on the face (just in front of it); Shift: the face's light taken away
                    lt = EditFaceLight(edHovKind, edHovX, edHovY, edHovSide)
                    IF edShift THEN
                        IF lt THEN
                            EditPushUndo
                            FOR k = lt TO lvlNumLights - 1 : FOR j = 1 TO 9 : lvlLight(k, j) = lvlLight(k + 1, j) : NEXT : NEXT
                            lvlNumLights = lvlNumLights - 1 : EditApply : EditNote "Light taken away"
                        ELSE
                            EditNote "No light on that face"
                        END IF
                    ELSEIF lt THEN
                        edSelN = 0 : EditSelToggle edHovKind, edHovX, edHovY, edHovSide, 0 : EditNote "That face has a light - its pane is on the right"
                    ELSE
                        EditFaceAnchor edHovKind, edHovX, edHovY, edHovSide, ax, ay
                        EditPushUndo : EditAddLight ax, ay : EditApply
                    END IF
                CASE ET_PAINT ' The brush's picture on the face (Shift: back to the usual; Ctrl: the whole floor, ceiling or wall side it's part of; Alt: pick its picture up)
                    fc = EditFaceCode(edHovKind, edHovSide)
                    IF edBrushKind = PK_LIQUID THEN ' A liquid: poured on the floor (Ctrl: all of it, as far as it's level; Shift: drained)
                        IF edHovKind <> ED_FLOOR AND edHovKind <> ED_STEP THEN
                            EditNote "A liquid lies on a floor - point at one"
                        ELSEIF (_KEYDOWN(100305) OR _KEYDOWN(100306)) AND edHovKind = ED_FLOOR THEN
                            EditSelKeep 0 : EditSelFlood ED_FLOOR, edHovX, edHovY : EditPaintSel : EditSelKeep -1
                        ELSE
                            EditPushUndo : EditBrushLiquid edHovX, edHovY, edShift : EditApply
                            IF edShift THEN EditNote "Drained" ELSE EditNote LiquidBrushName$(edBrushLiq$) + " at" + STR$(edHovX) + STR$(edHovY)
                        END IF
                    ELSEIF edAlt THEN
                        EditPickPicture ' (the face's picture, as PAINT's brush)
                    ELSEIF _KEYDOWN(100305) OR _KEYDOWN(100306) THEN ' Ctrl+click: the face (or piece) selected - never painted; Ctrl+Shift: added to the selection, or taken out
                        IF edHovThing THEN
                            EditNote "That's a thing, not a face - SELECT selects it"
                        ELSEIF edShift THEN
                            EditSelToggle edHovKind, edHovX, edHovY, edHovSide, edHovPart : EditNote STR$(edSelN) + " selected"
                        ELSE
                            edSelN = 0 : EditSelAdd edHovKind, edHovX, edHovY, edHovSide, edHovPart : EditNote "Selected - its look is in the PICTURE pane"
                        END IF
                    ELSEIF edShift THEN
                        EditPushUndo : EditPaintFace edHovX, edHovY, fc, edHovPart, "" : EditApply : EditNote "The usual picture again"
                        IF NOT edHovThing THEN edSelN = 0 : EditSelAdd edHovKind, edHovX, edHovY, edHovSide, edHovPart ' (and it's the selection: the PICTURE pane shows it)
                    ELSEIF edBrushTex$ = "" THEN
                        IF edHovThing THEN
                            EditNote "Pick a picture first (the picker: WALLS, FLOORS, CEILINGS)"
                        ELSE ' (no picture to paint: the click selects it - slide, turn, tint it in the PICTURE pane)
                            edSelN = 0 : EditSelAdd edHovKind, edHovX, edHovY, edHovSide, edHovPart : EditNote "Selected - its look is in the PICTURE pane (pick a picture to paint)"
                        END IF
                    ELSE
                        EditPushUndo : EditPaintFace edHovX, edHovY, fc, edHovPart, edBrushTex$ : EditApply
                        EditNote edBrushTex$ + " on " + FaceName$(fc) + " of" + STR$(edHovX) + STR$(edHovY)
                        IF NOT edHovThing THEN edSelN = 0 : EditSelAdd edHovKind, edHovX, edHovY, edHovSide, edHovPart ' (and it's the selection: the PICTURE pane shows it)
                    END IF
                CASE ET_HEIGHT
                    d = H_STEP : IF edShift THEN d = -H_STEP
                    SELECT CASE edHovKind
                        CASE ED_FLOOR, ED_STEP : EditPushUndo : EditRaise edHovX, edHovY, d, 0 : EditApply : EditNote "Floor" + STR$(floorH(edHovX, edHovY) * 8) + " eighths"
                        CASE ED_CEIL, ED_LINTEL : EditPushUndo : EditRaise edHovX, edHovY, d, -1 : EditApply : EditNote "Ceiling" + STR$(ceilH(edHovX, edHovY) * 8) + " eighths"
                        CASE ELSE : EditNote "Height: point at a floor or ceiling (walls: the wheel, with Shift)"
                    END SELECT
            END SELECT
        END IF
        fpLWas = -1
    END IF
    ' PLACE, the button held: on into each new floor cell the pointer crosses
    IF NOT fpL THEN edDragOn = 0
    IF fpL AND edDragOn AND edTool = ET_PLACE AND edHovKind = ED_FLOOR AND NOT edLooking THEN
        IF (edHovX <> edDragX OR edHovY <> edDragY) AND CellGlyph$(edHovX, edHovY) <> editGlyph$ THEN
            IF edHovX > 0 AND edHovY > 0 AND edHovX < mapN - 1 AND edHovY < mapN - 1 THEN EditPut edHovX, edHovY, editGlyph$ : EditApply
            edDragX = edHovX : edDragY = edHovY
        END IF
    END IF
    IF fpL AND NOT fpLWas AND NOT edLooking AND NOT EditOverUI(edCurX, edCurY) THEN
        edShift = _KEYDOWN(100304) OR _KEYDOWN(100303) : edCtrl = _KEYDOWN(100305) OR _KEYDOWN(100306)
        IF edHovKind THEN
            IF edShift THEN
                EditSelToggle edHovKind, edHovX, edHovY, edHovSide, edHovPart
            ELSEIF edCtrl AND (edHovKind = ED_FLOOR OR edHovKind = ED_CEIL) THEN
                EditSelFlood edHovKind, edHovX, edHovY
            ELSEIF edCtrl AND edHovKind = ED_WALL THEN ' (a wall's side: all of it - every face along it in the same plane, open floor in front, as far as it goes)
                EditSelWallFlood edHovX, edHovY, edHovSide
            ELSE
                edSelN = 0 : EditSelToggle edHovKind, edHovX, edHovY, edHovSide, edHovPart
            END IF
            EditNote LTRIM$(STR$(edSelN)) + " selected"
        ELSEIF NOT edShift THEN
            edSelN = 0
        END IF
    END IF
    fpLWas = fpL : fpRWas = fpR
    IF edWheel <> 0 AND edPickOpen AND edCurY >= PK_Y - 4 AND NOT edLooking THEN ' (over the picker: the wheel scrolls it)
        EditPkScroll SGN(edWheel) : edWheel = 0 ' (down the wheel: down the list)
    END IF
    IF edWheel <> 0 AND NOT EditOverUI(edCurX, edCurY) THEN EditWheel
    edWheel = 0
    FOR kc = 97 TO 122 ' (a letter let go in another loop - the map from above, the menu - is let go here too)
        IF edKeyHeld(kc) THEN IF NOT _KEYDOWN(kc) AND NOT _KEYDOWN(kc - 32) THEN edKeyHeld(kc) = 0
    NEXT
    edCtrl = _KEYDOWN(100305) OR _KEYDOWN(100306)
    k& = _KEYHIT
    DO WHILE k&
        IF edTyping THEN ' (typing the sector's name: the keys are its)
            IF k& > 0 THEN EditTypeKey
            k& = _KEYHIT : _CONTINUE
        END IF
        shiftOn = _KEYDOWN(100304) OR _KEYDOWN(100303)
        IF EditFullBrightKey(k&) THEN k& = 0 ' (Alt+L: full bright)
        IF ABS(k&) = 100305 OR ABS(k&) = 100306 THEN edCtrl = (k& > 0)
        kc = 0 : IF ABS(k&) >= 65 AND ABS(k&) <= 122 THEN kc = ABS(k&) OR 32 ' (a letter, as its small letter)
        IF kc < 97 OR kc > 122 THEN kc = 0
        IF kc THEN ' Down (a fresh press, or its auto-repeat) or up
            IF k& < 0 THEN
                edKeyHeld(kc) = 0
            ELSEIF NOT edKeyHeld(kc) THEN
                edKeyHeld(kc) = -1 : edKeyCtrl(kc) = edCtrl
            END IF
        END IF
        IF edCtrl OR edKeyCtrl(kc) THEN ' (Ctrl held: Ctrl+S, Ctrl+Z, Ctrl+Y, Ctrl+D - however the key arrives)
            IF kc = 115 OR kc = 122 OR kc = 121 OR kc = 100 OR kc = 99 OR kc = 118 THEN
                IF k& < 0 OR NOT edKeyCtrl(kc) THEN
                    k& = 0 ' (a walking key's repeat - pressed before Ctrl - is no shortcut)
                ELSEIF kc = 115 THEN
                    k& = 19
                ELSEIF kc = 122 THEN
                    k& = 26
                ELSEIF kc = 121 THEN
                    k& = 25
                ELSEIF kc = 99 THEN
                    k& = 3
                ELSEIF kc = 118 THEN
                    k& = 22
                ELSE
                    k& = 4
                END IF
            END IF
        END IF
        SELECT CASE k&
            CASE 4 : edSelN = 0 : EditNote "Selection cleared" ' Ctrl+D
            CASE 103, 71 : EditGridKey shiftOn ' G: the grid on / off (Shift+G: how strong)
            CASE 21248 ' Del: delete what's selected
                IF edSelN THEN EditPushUndo : EditDeleteSel : EditApply ELSE EditNote "Select something to delete first"
            CASE 15104 : edHelp = NOT edHelp ' F1: the help
            CASE 3 ' Ctrl+C (PAINT): copy the look of the face under the pointer (or the first selected)
                IF edTool = ET_PAINT THEN
                    IF edHovKind AND NOT edHovThing THEN
                        EditClipCopy edHovKind, edHovX, edHovY, edHovSide, edHovPart
                    ELSEIF edSelN THEN
                        EditClipCopy edSelKind(1), edSelX(1), edSelY(1), edSelSide(1), edSelPart(1)
                    END IF
                END IF
            CASE 22 : IF edTool = ET_PAINT THEN EditClipPaste 0 ' Ctrl+V (PAINT): paste it on the face under the pointer (or the selection, if that's in it)
            CASE 123, 125, 95, 43 ' PAINT + Shift+[ ] (narrower, wider), Shift+- = (shorter, taller): stretch the picture
                IF edTool = ET_PAINT THEN EditOffsetKey k&
            CASE 112, 80 : EditPickMode ' P: the picker - tucked away, always open, off
            CASE 18432, 20480, 19200, 19712, 18176 ' The arrows: nudge the selection a cell - away, back, left, right of the way you face (PAINT + Shift: slide the picture)
                IF edTool = ET_PAINT AND shiftOn THEN
                    EditOffsetKey k&
                ELSEIF k& = 18176 THEN
                    ' (Home: only PAINT's Shift+Home)
                ELSEIF edSelN THEN
                    fwX = 0 : fwY = 0 : IF ABS(edCamDX) >= ABS(edCamDY) THEN fwX = SGN(edCamDX) ELSE fwY = SGN(edCamDY)
                    SELECT CASE k&
                        CASE 18432 : ndx = fwX : ndy = fwY
                        CASE 20480 : ndx = -fwX : ndy = -fwY
                        CASE 19200 : ndx = fwY : ndy = -fwX ' (left of facing (fwX, fwY) on the map is (fwY, -fwX))
                        CASE ELSE : ndx = -fwY : ndy = fwX
                    END SELECT
                    EditPushUndo : EditNudge ndx, ndy : EditApply
                    EditNote "Moved the selection a cell " + RTRIM$(MID$("east  west  south north ", 1 + 6 * (-(ndx < 0) - 2 * (ndy > 0) - 3 * (ndy < 0)), 6))
                ELSE
                    EditNote "Select something first: the arrows move it a cell"
                END IF
            CASE 9 : editView = 0 ' Tab: the map from above
            CASE 19 : EditSave level
            CASE 26 : IF shiftOn THEN EditRedoStep ELSE EditUndoStep ' (Ctrl+Shift+Z: redo)
            CASE 25 : EditRedoStep ' Ctrl+Y
            CASE 91 : EditCycleGlyph -1
            CASE 93 : EditCycleGlyph 1
            CASE 101, 69 ' E: pick up what's under the pointer (the crosshair, looking round) as the brush of the tool in use - PAINT: the face's picture; any other: what's in that cell (a monster, a pickup, the wall...). The tool stays as it is.
                IF edTool = ET_PAINT THEN
                    EditPickPicture
                ELSEIF edHovKind = 0 THEN
                    EditNote "Point at something to pick it up"
                ELSE
                    pc$ = CellGlyph$(edHovX, edHovY) ' (the cell the face is of: a wall's own, a floor's, the thing standing there)
                    IF edHovKind = ED_BOX THEN pc$ = "" ' (a block isn't a map character)
                    IF LEN(pc$) THEN editGlyph$ = pc$ : EditNote "Picked up " + GlyphName$(editGlyph$) + " - PLACE's brush" ELSE EditNote "Nothing there to pick up (PAINT + E picks up a picture)"
                END IF
            CASE 116, 84 ' T: the picture on that kind of wall - every one of them - the next one
                IF aimX >= 0 THEN
                    w = INSTR("#NCKPG", MID$(lvlRow$(aimY), aimX + 1, 1))
                    IF w THEN EditPushUndo : lvlWall$(w) = EditNextPicture$("wall", lvlWall$(w), 1 + 2 * shiftOn) : EditApply : EditNote "Walls " + MID$("#NCKPG", w, 1) + ": " + lvlWall$(w)
                END IF
            CASE 102, 70 ' F: the floor's picture (that floor number, everywhere)
                IF frontX >= 0 THEN n = FloorNumberAt(frontX, frontY) : EditPushUndo : lvlFloor$(n) = EditNextPicture$("floor", lvlFloor$(n), 1 + 2 * shiftOn) : EditApply : EditNote "Floor" + STR$(n) + ": " + lvlFloor$(n)
            CASE 104, 72, 118, 86 ' H: divide the selected faces (or pieces) left | right, V: top | bottom - the selection's (never just the one under the pointer)
                IF k& = 118 OR k& = 86 THEN EditDivideSel "V" ELSE EditDivideSel "H"
            CASE 106, 74 ' J: the selected pieces joined again (with what each was divided from)
                EditJoinSel
            CASE 114, 82 ' R: the picture turned a quarter clockwise (Shift+R: back) - on the face or piece under the pointer, or the selection
                IF edTool = ET_PAINT THEN EditTexOp 4, 0, 1 + 2 * shiftOn, 0, 0 ELSE EditNote "PAINT turns pictures: R a quarter clockwise, Shift+R back"
            CASE 111, 79 : EditHoldKey shiftOn ' O: the door under the pointer opened (or shut), a lift or crusher held up or down - in the editor only; Shift+O: as in play
            CASE 109, 77 ' M: the picture flipped left for right (Shift+M: upside down) - as R turns it
                IF edTool = ET_PAINT THEN EditTexOp 10 - shiftOn, 0, 0, 0, 0 ELSE EditNote "PAINT flips pictures: M left for right, Shift+M upside down"
            CASE 122, 90 ' Z: that cell's floor - the next of the level's four (a zone one cell big)
                IF frontX >= 0 THEN
                    n = FloorNumberAt(frontX, frontY) MOD 4 + 1
                    EditPushUndo : EditAddZone frontX, frontY, frontX, frontY, n, 0 : EditApply
                    IF lvlNumZones THEN IF lvlZone(lvlNumZones, 1) = frontX AND lvlZone(lvlNumZones, 2) = frontY AND lvlZone(lvlNumZones, 5) = n THEN EditNote "Floor" + STR$(n) + " here" ELSE EditNote "Too many floor zones (" + LTRIM$(STR$(MAX_ZONES)) + ")"
                END IF
            CASE 108, 76 ' L: a light over the cell in front; K: take away the nearest
                IF frontX >= 0 THEN EditPushUndo : EditAddLight frontX + 0.5, frontY + 0.5 : EditApply
            CASE 107, 75
                EditPushUndo : EditRemoveLight playerX, playerY : EditApply
            CASE 49 TO 56 : EditNumKey k& - 48 ' 1-8: SELECT, PLACE, PAINT, LIGHT, HEIGHT, SECTOR, VERSIONS, the picker open
            CASE 18688, 20736 ' PgUp / PgDn: the floor in front up or down an eighth (with Shift, its ceiling)
                IF frontX >= 0 THEN
                    d = H_STEP : IF k& = 20736 THEN d = -H_STEP
                    EditPushUndo : EditRaise frontX, frontY, d, shiftOn : EditApply
                    EditNote "Floor" + STR$(floorH(frontX, frontY)) + "   ceiling" + STR$(ceilH(frontX, frontY))
                END IF
            CASE 117, 85 ' U: the HUD layout editor
                HudEditEnter : EXIT DO
        END SELECT
        k& = _KEYHIT
    LOOP
END SUB

' Face f of cell (x, y): its picture p1$ (and, divided - d 1 or 2 - the
' second half's, p2$). No picture at all: back to the usual (taken out of
' [faces])
SUB EditSetFace(x, y, f, d, p1$, p2$)
    DIM j, k ' (its own: the main program shares these names)
    k = 0
    FOR j = 1 TO lvlNumFaces
        IF lvlFaceX(j) = x AND lvlFaceY(j) = y AND lvlFaceS(j) = f THEN k = j : EXIT FOR
    NEXT
    IF p1$ = "" AND p2$ = "" AND d = 0 THEN ' (taken away - unless its picture's slid: then it keeps that)
        IF k THEN
            IF lvlFaceO(k) OR lvlFaceK(k) THEN lvlFaceD(k) = 0 : lvlFaceP1$(k) = "" : lvlFaceP2$(k) = "" : EXIT SUB
            FOR j = k TO lvlNumFaces - 1
                lvlFaceX(j) = lvlFaceX(j + 1) : lvlFaceY(j) = lvlFaceY(j + 1) : lvlFaceS(j) = lvlFaceS(j + 1) : lvlFaceD(j) = lvlFaceD(j + 1)
                lvlFaceP1$(j) = lvlFaceP1$(j + 1) : lvlFaceP2$(j) = lvlFaceP2$(j + 1) : lvlFaceO(j) = lvlFaceO(j + 1) : lvlFaceK(j) = lvlFaceK(j + 1)
            NEXT
            lvlNumFaces = lvlNumFaces - 1
        END IF
        EXIT SUB
    END IF
    IF k = 0 THEN
        IF lvlNumFaces >= MAX_FACES THEN EditNote "That's" + STR$(MAX_FACES) + " faces with pictures of their own - no more" : EXIT SUB
        lvlNumFaces = lvlNumFaces + 1 : k = lvlNumFaces : lvlFaceO(k) = 0 : lvlFaceK(k) = 0
    END IF
    lvlFaceX(k) = x : lvlFaceY(k) = y : lvlFaceS(k) = f : lvlFaceD(k) = d : lvlFaceP1$(k) = p1$ : lvlFaceP2$(k) = p2$
END SUB

' Face f of cell (x, y): its picture slid ou 64ths along it and ov up it
' (0-63 each - a pixel of a 64 picture - wrapping round) and stretched ku
' percent across, kv up (100 as it is) - kept in its [faces] line, made for
' it if it has none (the usual picture, slid or stretched)
SUB EditSetFaceTex(x, y, f, ou, ov, ku, kv)
    DIM k, o, kk&, u, v ' (its own: the main program shares these names)
    o = (ou AND 63) + 64 * (ov AND 63)
    u = ku : v = kv : IF u = 100 THEN u = 0
    IF v = 100 THEN v = 0
    IF u THEN u = MaxOf(TEX_K_MIN, MinOf(TEX_K_MAX, u))
    IF v THEN v = MaxOf(TEX_K_MIN, MinOf(TEX_K_MAX, v))
    kk& = u + 2048& * v
    k = FaceIndex(x, y, f)
    IF k = 0 THEN
        IF o = 0 AND kk& = 0 THEN EXIT SUB
        IF lvlNumFaces >= MAX_FACES THEN EditNote "That's" + STR$(MAX_FACES) + " faces with pictures of their own - no more" : EXIT SUB
        lvlNumFaces = lvlNumFaces + 1 : k = lvlNumFaces
        lvlFaceX(k) = x : lvlFaceY(k) = y : lvlFaceS(k) = f : lvlFaceD(k) = 0 : lvlFaceP1$(k) = "" : lvlFaceP2$(k) = ""
    END IF
    lvlFaceO(k) = o : lvlFaceK(k) = kk&
    IF o = 0 AND kk& = 0 AND lvlFaceD(k) = 0 AND lvlFaceP1$(k) = "" AND lvlFaceP2$(k) = "" THEN EditSetFace x, y, f, 0, "", "" ' (nothing of its own left: out of [faces])
END SUB

' A face's offset (64ths: ou along, ov up) and stretch (percent: ku across,
' kv up) - 0, 0, 100, 100 if it has none
SUB EditGetFaceTex(x, y, f, ou, ov, ku, kv)
    DIM k ' (its own: the main program shares these names)
    ou = 0 : ov = 0 : ku = 100 : kv = 100 : k = FaceIndex(x, y, f)
    IF k THEN
        ou = lvlFaceO(k) AND 63 : ov = (lvlFaceO(k) \ 64) AND 63
        ku = lvlFaceK(k) AND 2047 : kv = lvlFaceK(k) \ 2048
        IF ku = 0 THEN ku = 100
        IF kv = 0 THEN kv = 100
    END IF
END SUB

' FACES IN PIECES (LEVEL/PIECES.BI): every change to a face's pictures
' reads its tree of pieces (EditTreeGet), changes them, and writes it back
' (EditTreePut). A selection's part is a piece of its face (0: the whole).

' Face f of cell (x, y)'s pieces into the tree being worked on (ptShape$,
' ptN, ptPic$...) - one piece, the usual picture, if it has no [faces] line
SUB EditTreeGet(x, y, f)
    DIM k ' (its own: the main program shares these names)
    k = FaceIndex(x, y, f)
    IF k THEN PcTreeRead lvlFaceD(k), lvlFaceP1$(k), lvlFaceP2$(k), lvlFaceO(k), lvlFaceK(k) ELSE PcTreeRead 0, "", "", 0, 0
END SUB

' ...and the tree back as face f's [faces] line (the old kind of line where
' it can be: PcTreeForm) - taken out, when nothing's left of its own
SUB EditTreePut(x, y, f)
    DIM d, k, o, kk&, p1$, p2$ ' (its own: the main program shares these names)
    PcTreeForm d, p1$, p2$, o, kk&
    k = FaceIndex(x, y, f)
    IF d = 0 AND p1$ = "" AND o = 0 AND kk& = 0 THEN
        IF k THEN lvlFaceO(k) = 0 : lvlFaceK(k) = 0 : EditSetFace x, y, f, 0, "", ""
        EXIT SUB
    END IF
    IF k = 0 THEN
        IF lvlNumFaces >= MAX_FACES THEN EditNote "That's" + STR$(MAX_FACES) + " faces with pictures of their own - no more" : EXIT SUB
        lvlNumFaces = lvlNumFaces + 1 : k = lvlNumFaces
    END IF
    lvlFaceX(k) = x : lvlFaceY(k) = y : lvlFaceS(k) = f : lvlFaceD(k) = d
    lvlFaceP1$(k) = p1$ : lvlFaceP2$(k) = p2$ : lvlFaceO(k) = o : lvlFaceK(k) = kk&
END SUB

' The pieces part stands for, j0 to j1: that piece - or (0, or one the face
' hasn't) every one
SUB EditPcRange(part, j0, j1)
    IF part >= 1 AND part <= ptN THEN j0 = part : j1 = part ELSE j0 = 1 : j1 = ptN
END SUB

' Piece j's slide (64ths: ou along, ov up) and stretch (percent: ku across,
' kv up - 100 as made)...
SUB EditPcTexGet(j, ou, ov, ku, kv)
    ou = ptO(j) AND 63 : ov = (ptO(j) \ 64) AND 63
    ku = ptK(j) AND 2047 : kv = ptK(j) \ 2048
    IF ku = 0 THEN ku = 100
    IF kv = 0 THEN kv = 100
END SUB
' ...and set
SUB EditPcTexSet(j, ou, ov, ku, kv)
    DIM u, v ' (its own: the main program shares these names)
    u = ku : v = kv : IF u = 100 THEN u = 0
    IF v = 100 THEN v = 0
    IF u THEN u = MaxOf(TEX_K_MIN, MinOf(TEX_K_MAX, u))
    IF v THEN v = MaxOf(TEX_K_MIN, MinOf(TEX_K_MAX, v))
    ptO(j) = (ou AND 63) + 64 * (ov AND 63) : ptK(j) = u + 2048& * v
END SUB

' Piece j of face (kind, side) of cell (x, y) - the tree being worked on -
' made to start its picture at its own corner (ptA 1), slid so it shows
' just what it showed from the face's grid: its picture's place at its top
' left corner, worked out as the renderers do (across: the map's own
' coordinate along the face, the way the picture reads; down: a wall high
' a picture, from 1 - the height; a floor's, the map's x and y), less the
' whole pictures
SUB EditPcStartHere(kind, x, y, side, j)
    DIM ax, ay, bx, by, dr, ok, ou, ov, kku, kkv, px, py, uu, vv, w, z0, z1, zt ' (its own: the main program shares these names)
    IF PcRects(ptShape$) < j OR j < 1 THEN EXIT SUB
    EditPcTexGet j, ou, ov, kku, kkv
    IF kind = ED_FLOOR OR kind = ED_CEIL THEN
        uu = 100 / kku * (x + pcRU0(j)) : vv = 100 / kkv * (y + pcRV0(j))
    ELSEIF (kind = ED_WALL AND EditDoorIn(x, y)) OR kind = ED_DEDGE OR kind = ED_TRACK THEN ' (a door's face: its picture runs across it, and down it, once - its edges and track too)
        uu = 100 / kku * pcRU0(j) : vv = 100 / kkv * pcRV0(j)
    ELSEIF kind = ED_DIAG THEN ' (a diagonal's: x across from the map's grid, the way the picture runs - as GLFaceTex has it)
        EditFaceRect kind, x, y, side, ax, ay, bx, by, z0, z1, ok : IF NOT ok THEN EXIT SUB
        w = x : IF diagCorner(x, y) > 2 THEN w = -(x + 1)
        zt = z1 - pcRV0(j) * (z1 - z0)
        uu = 100 / kku * (pcRU0(j) + w) : vv = 100 / kkv * (1 - zt)
    ELSE
        EditFaceRect kind, x, y, side, ax, ay, bx, by, z0, z1, ok : IF NOT ok THEN EXIT SUB
        IF side = 1 OR side = 4 THEN ' (east and north faces: the picture reads from b back to a)
            px = bx + pcRU0(j) * (ax - bx) : py = by + pcRU0(j) * (ay - by) : dr = -1
        ELSE
            px = ax + pcRU0(j) * (bx - ax) : py = ay + pcRU0(j) * (by - ay) : dr = 1
        END IF
        IF ABS(ay - by) < 0.0001 THEN w = px ELSE w = py
        zt = z1 - pcRV0(j) * (z1 - z0)
        uu = 100 / kku * dr * w : vv = 100 / kkv * (1 - zt)
        IF kind = ED_STEP AND liftCell(x, y) THEN vv = 100 / kkv * (z1 - zt) ' (a lift's side: from its top)
    END IF
    ou = (ou + INT((uu - INT(uu)) * 64 + 0.5)) AND 63 : ov = (ov + INT((vv - INT(vv)) * 64 + 0.5)) AND 63
    EditPcTexSet j, ou, ov, kku, kkv : ptA(j) = 1
END SUB

' How far piece j of a face reaches across (w) and down (h), in what its
' picture is measured by from the piece's corner (START AT PIECE): a cell
' along a wall or floor, a wall's height up it - a door's face, its own
' width and height, once; FIT: the piece is 1 each way
SUB EditPcSpan(kind, x, y, side, j, w, h)
    DIM ax, ay, bx, by, ok, z0, z1 ' (its own: the main program shares these names)
    w = 1 : h = 1
    IF PcRects(ptShape$) < j OR j < 1 THEN EXIT SUB
    IF ptA(j) = 2 THEN EXIT SUB
    w = pcRU1(j) - pcRU0(j) : h = pcRV1(j) - pcRV0(j)
    IF kind = ED_FLOOR OR kind = ED_CEIL THEN EXIT SUB
    IF (kind = ED_WALL AND EditDoorIn(x, y)) OR kind = ED_DEDGE OR kind = ED_TRACK THEN EXIT SUB
    EditFaceRect kind, x, y, side, ax, ay, bx, by, z0, z1, ok : IF NOT ok THEN EXIT SUB
    h = h * (z1 - z0)
    IF kind <> ED_DIAG THEN w = w * SQR((bx - ax) ^ 2 + (by - ay) ^ 2)
END SUB

' Piece j's look in words - slid, stretched, turned, tinted ("" as made)
FUNCTION EditLookName$(j)
    DIM ou, ov, ku, kv, t$ ' (its own: the main program shares these names)
    EditPcTexGet j, ou, ov, ku, kv
    IF ou OR ov THEN t$ = t$ + "  slid" + STR$(((ou + 32) AND 63) - 32) + "," + LTRIM$(STR$(((ov + 32) AND 63) - 32))
    IF ku <> 100 OR kv <> 100 THEN t$ = t$ + "  stretched" + STR$(ku) + "% x" + STR$(kv) + "%"
    IF ptRot(j) AND 3 THEN t$ = t$ + "  turned" + STR$((ptRot(j) AND 3) * 90)
    IF ptRot(j) AND 4 THEN t$ = t$ + "  flipped"
    IF ptTM(j) THEN t$ = t$ + "  " + EditTintName$(ptTM(j)) + STR$(ptTA(j)) + "% " + RIGHT$("00000" + HEX$(ptTC(j) AND &HFFFFFF), 6)
    IF ptA(j) = 1 THEN t$ = t$ + "  from its corner"
    IF ptA(j) = 2 THEN t$ = t$ + "  fitted"
    EditLookName$ = LTRIM$(t$)
END FUNCTION

' A tint's kind in words: 0 none, 1 TINT (the picture times the colour), 2
' WASH (mixed with it), 3 GLOW (it added)
FUNCTION EditTintName$(m)
    EditTintName$ = RTRIM$(MID$("NONETINTWASHGLOW", m * 4 + 1, 4))
END FUNCTION

' H / V: the selected faces divided - dir$ "H" left | right, "V" top |
' bottom, up to PC_DEPTH times. A piece selected: that piece, in two (both
' halves selected after, with its look). A whole face: in two - halved that
' way already, whole again; halved the other way, turned that way; in more
' pieces than two, every piece in two. One undo.
SUB EditDivideSel(dir$)
    DIM fc, i, j, k, m, n, nf, nSplit, nJoin, nFine, whole, ok, t$ ' (its own: the main program shares these names)
    DIM fK(ED_MAXSEL), fX(ED_MAXSEL), fY(ED_MAXSEL), fS(ED_MAXSEL), fP(ED_MAXSEL), mk(PC_LEAF + 1)
    IF edSelN = 0 THEN EditNote "Select a face first (click it) to divide it" : EXIT SUB
    EditPushUndo
    nf = edSelN
    FOR k = 1 TO nf : fK(k) = edSelKind(k) : fX(k) = edSelX(k) : fY(k) = edSelY(k) : fS(k) = edSelSide(k) : fP(k) = edSelPart(k) : NEXT
    edSelN = 0
    FOR k = 1 TO nf
        fc = EditFaceCode(fK(k), fS(k))
        IF fK(k) = -1 THEN _CONTINUE ' (done with its face already)
        IF fc < 1 OR fc > FACE_DIAG THEN EditSelAdd fK(k), fX(k), fY(k), fS(k), fP(k) : _CONTINUE ' (a door's edges and track stay whole)
        EditTreeGet fX(k), fY(k), fc
        whole = 0 : FOR j = 1 TO PC_LEAF + 1 : mk(j) = 0 : NEXT
        FOR i = k TO nf ' (every part of this face that's selected)
            IF fK(i) = fK(k) AND fX(i) = fX(k) AND fY(i) = fY(k) AND fS(i) = fS(k) THEN
                IF fP(i) >= 1 AND fP(i) <= ptN THEN mk(fP(i)) = -1 ELSE whole = -1
                IF i > k THEN fK(i) = -1
            END IF
        NEXT
        IF whole THEN
            IF ptN = 1 THEN
                IF PcSplit(1, dir$) THEN nSplit = nSplit + 1
            ELSEIF ptShape$ = dir$ + ".." THEN
                ptShape$ = "." : ptN = 1 : nJoin = nJoin + 1 ' (whole again: its first half's look)
            ELSEIF ptN = 2 THEN
                ptShape$ = dir$ + ".." : nSplit = nSplit + 1
            ELSE
                FOR j = 1 TO ptN : mk(j) = -1 : NEXT
            END IF
        END IF
        m = ptN
        FOR j = m TO 1 STEP -1 ' (from the last: a piece divided moves the ones after it up one, never those before)
            IF mk(j) THEN
                IF PcSplit(j, dir$) THEN
                    FOR i = ptN TO j + 2 STEP -1 : mk(i) = mk(i - 1) : NEXT
                    mk(j + 1) = -1 : nSplit = nSplit + 1
                ELSE
                    nFine = nFine + 1
                END IF
            END IF
        NEXT
        EditTreePut fX(k), fY(k), fc
        IF whole THEN
            EditSelAdd fK(k), fX(k), fY(k), fS(k), 0
        ELSE
            FOR j = 1 TO ptN : IF mk(j) THEN EditSelAdd fK(k), fX(k), fY(k), fS(k), j
            NEXT
        END IF
    NEXT
    EditApply
    IF nSplit = 0 AND nJoin = 0 THEN
        EditNote "As fine as it goes:" + STR$(PC_DEPTH) + " divisions (J joins pieces again)"
    ELSEIF nSplit = 0 THEN
        EditNote "Whole again"
    ELSE
        IF dir$ = "H" THEN t$ = "Left | right" ELSE t$ = "Top | bottom"
        IF nFine THEN t$ = t$ + " (" + LTRIM$(STR$(nFine)) + " as fine as they go)"
        EditNote t$ + " - click a piece to select it: PAINT it, H / V divide it again, J join it"
    END IF
END SUB

' J: each selected piece joined with what it was divided from - one
' division undone, the piece's look on all of it; a whole face selected:
' whole again (its first piece's look). One undo.
SUB EditJoinSel
    DIM fc, i, j, k, l1, m, n, nf, nJoin, whole, tg ' (its own: the main program shares these names)
    DIM fK(ED_MAXSEL), fX(ED_MAXSEL), fY(ED_MAXSEL), fS(ED_MAXSEL), fP(ED_MAXSEL), mk(PC_LEAF + 1), mk2(PC_LEAF + 1)
    IF edSelN = 0 THEN EditNote "Select a piece of a divided face first (click it) to join it" : EXIT SUB
    EditPushUndo
    nf = edSelN
    FOR k = 1 TO nf : fK(k) = edSelKind(k) : fX(k) = edSelX(k) : fY(k) = edSelY(k) : fS(k) = edSelSide(k) : fP(k) = edSelPart(k) : NEXT
    edSelN = 0
    FOR k = 1 TO nf
        fc = EditFaceCode(fK(k), fS(k))
        IF fK(k) = -1 THEN _CONTINUE
        IF fc < 1 OR fc > FACE_MAX THEN EditSelAdd fK(k), fX(k), fY(k), fS(k), fP(k) : _CONTINUE
        EditTreeGet fX(k), fY(k), fc
        whole = 0 : FOR j = 1 TO PC_LEAF + 1 : mk(j) = 0 : NEXT
        FOR i = k TO nf
            IF fK(i) = fK(k) AND fX(i) = fX(k) AND fY(i) = fY(k) AND fS(i) = fS(k) THEN
                IF fP(i) >= 1 AND fP(i) <= ptN THEN mk(fP(i)) = 1 ELSE whole = -1
                IF i > k THEN fK(i) = -1
            END IF
        NEXT
        IF ptN > 1 THEN
            IF whole THEN
                ptShape$ = "." : ptN = 1 : nJoin = nJoin + 1
                FOR j = 1 TO PC_LEAF + 1 : mk(j) = 0 : NEXT
            ELSE
                FOR j = ptN TO 1 STEP -1 ' (from the last: a join moves only the pieces after it down)
                    IF j <= ptN THEN
                        IF mk(j) = 1 THEN
                            m = ptN : l1 = PcJoin(j)
                            IF l1 THEN
                                n = m - ptN : nJoin = nJoin + 1
                                FOR i = 1 TO PC_LEAF + 1 : mk2(i) = 0 : NEXT
                                FOR i = 1 TO m ' (each piece's mark to its number now: those joined are piece l1)
                                    IF i < l1 THEN tg = i ELSE IF i <= l1 + n THEN tg = l1 ELSE tg = i - n
                                    IF mk(i) > mk2(tg) THEN mk2(tg) = mk(i)
                                NEXT
                                mk2(l1) = 2 ' (joined: not joined again this time)
                                FOR i = 1 TO PC_LEAF + 1 : mk(i) = mk2(i) : NEXT
                            END IF
                        END IF
                    END IF
                NEXT
            END IF
            EditTreePut fX(k), fY(k), fc
        END IF
        IF whole OR ptN = 1 THEN
            EditSelAdd fK(k), fX(k), fY(k), fS(k), 0
        ELSE
            FOR j = 1 TO ptN : IF mk(j) THEN EditSelAdd fK(k), fX(k), fY(k), fS(k), j
            NEXT
        END IF
    NEXT
    EditApply
    IF nJoin = 0 THEN EditNote "Nothing divided there to join" ELSE EditNote "Joined" + STR$(nJoin) + " - J again joins it to the next piece up"
END SUB

' PAINT: the picture on the face (or piece) under the pointer - or on every
' selected one, when that's one of them (or nothing's under it) - slid,
' stretched, turned, tinted or put back. A whole face that's divided: each
' of its pieces. op: 0 slid (k& an arrow key: walls left, right, up, down
' as you face them; floors and ceilings, the way you face is up) by st
' pixels (64ths); 1 stretched across, 2 up - dir +1 wider/taller, -1
' narrower/shorter, by st percent (0: to the next of TEX_K_STEPS$); 3 put
' back as made (not slid, stretched, turned or tinted); 4 turned dir
' quarters clockwise; 5 tinted the way st says (0 none, 1 TINT, 2 WASH, 3
' GLOW); 6 its tint's amount dir * st percent more; 7 its tint's colour
' k& (RRGGBB); 8 its colour's red (k& 0), green (1) or blue (2) dir * st
' more; 9 where its picture starts (st: 0 the face's, 1 the piece's
' corner, 2 fitted to the piece). A colour or amount on a picture not tinted tints it (TINT). One
' undo for a run of presses. fromPane: the selection, always.
SUB EditTexOp(op, k&, dir, st, fromPane) STATIC
    DIM fc, fwX, fwY, i, j, j0, j1, n, ou, ov, ku, kv, useSel, mx, my, kd, fx, fy, sd, pt, w, kn, sv, cr, cg, cb, lastJ, t$, spW, spH ' (its own: the main program shares these names)
    useSel = fromPane
    IF NOT useSel THEN
        IF edHovKind = 0 OR edHovThing THEN
            IF edSelN = 0 THEN EditNote "Point at a face (or select some) to change its picture" : EXIT SUB
            useSel = -1
        ELSE
            FOR j = 1 TO edSelN
                IF edSelKind(j) = edHovKind AND edSelX(j) = edHovX AND edSelY(j) = edHovY AND edSelSide(j) = edHovSide THEN IF edSelPart(j) = edHovPart OR edSelPart(j) = 0 THEN useSel = -1 ' (that piece selected - or its whole face)
            NEXT
        END IF
    END IF
    IF ABS(TIMER - texOpT!) > 0.5 THEN EditPushUndo
    texOpT! = TIMER
    fwX = 0 : fwY = 0 : IF ABS(edCamDX) >= ABS(edCamDY) THEN fwX = SGN(edCamDX) ELSE fwY = SGN(edCamDY)
    IF useSel THEN n = edSelN ELSE n = 1
    lastJ = 0
    FOR i = 1 TO n
        IF useSel THEN kd = edSelKind(i) : fx = edSelX(i) : fy = edSelY(i) : sd = edSelSide(i) : pt = edSelPart(i) ELSE kd = edHovKind : fx = edHovX : fy = edHovY : sd = edHovSide : pt = edHovPart
        fc = EditFaceCode(kd, sd) : IF fc < 1 OR fc > FACE_MAX THEN _CONTINUE
        EditTreeGet fx, fy, fc : EditPcRange pt, j0, j1
        FOR j = j0 TO j1
            EditPcTexGet j, ou, ov, ku, kv
            SELECT CASE op
                CASE 3 : ou = 0 : ov = 0 : ku = 100 : kv = 100 : ptRot(j) = 0 : ptTM(j) = 0 : ptA(j) = 0
                CASE 9 : ptA(j) = st
                CASE 1, 2
                    IF op = 1 THEN w = ku ELSE w = kv
                    IF st THEN
                        w = w + dir * st
                    ELSE ' (the next of the steps up, or down)
                        sv = w
                        FOR kn = 1 TO LEN(TEX_K_STEPS$) \ 5
                            IF dir > 0 AND VAL(MID$(TEX_K_STEPS$, kn * 5 - 4, 5)) > sv THEN w = VAL(MID$(TEX_K_STEPS$, kn * 5 - 4, 5)) : EXIT FOR
                            IF dir < 0 AND VAL(MID$(TEX_K_STEPS$, kn * 5 - 4, 5)) < sv THEN w = VAL(MID$(TEX_K_STEPS$, kn * 5 - 4, 5))
                        NEXT
                    END IF
                    w = MaxOf(TEX_K_MIN, MinOf(TEX_K_MAX, w))
                    IF op = 1 THEN ku = w ELSE kv = w
                CASE 4 : ptRot(j) = (ptRot(j) AND 4) OR ((ptRot(j) + dir + 4) AND 3) ' (turned as you see it: flipped stays flipped)
                CASE 10, 11 ' Flipped: what the piece shows, mirrored where it is (not the whole picture: a piece is a window onto it)
                    IF ptA(j) = 0 THEN EditPcStartHere kd, fx, fy, sd, j : EditPcTexGet j, ou, ov, ku, kv ' (from its own corner first, showing the same)
                    EditPcSpan kd, fx, fy, sd, j, spW, spH
                    IF op = 10 THEN
                        ptRot(j) = (4 - (ptRot(j) AND 4)) OR ((4 - (ptRot(j) AND 3)) AND 3) ' (the picture left for right, as you see it - after its turn: its turn the other way round)
                        ou = (64 - ou - INT(6400 / ku * spW + 0.5)) AND 63 ' (slid so the piece's far edge is where its near one was: s' = 1 - s - stretch x width)
                    ELSE
                        ptRot(j) = (4 - (ptRot(j) AND 4)) OR ((6 - (ptRot(j) AND 3)) AND 3) ' (upside down: left for right, then half a turn)
                        ov = (64 - ov - INT(6400 / kv * spH + 0.5)) AND 63
                    END IF
                CASE 5 : ptTM(j) = st
                CASE 6 : ptTA(j) = MaxOf(0, MinOf(100, ptTA(j) + dir * st)) : IF ptTM(j) = 0 THEN ptTM(j) = 1
                CASE 7 : ptTC(j) = k& AND &HFFFFFF : IF ptTM(j) = 0 THEN ptTM(j) = 1
                CASE 8
                    cr = (ptTC(j) \ 65536) AND 255 : cg = (ptTC(j) \ 256) AND 255 : cb = ptTC(j) AND 255
                    IF k& = 0 THEN cr = MaxOf(0, MinOf(255, cr + dir * st))
                    IF k& = 1 THEN cg = MaxOf(0, MinOf(255, cg + dir * st))
                    IF k& = 2 THEN cb = MaxOf(0, MinOf(255, cb + dir * st))
                    ptTC(j) = cr * 65536 + cg * 256 + cb : IF ptTM(j) = 0 THEN ptTM(j) = 1
                CASE ELSE
                    IF kd = ED_FLOOR OR kd = ED_CEIL THEN ' (the picture moved on the map: mx, my - u runs east, v south)
                        SELECT CASE k&
                            CASE 18432 : mx = fwX : my = fwY
                            CASE 20480 : mx = -fwX : my = -fwY
                            CASE 19200 : mx = fwY : my = -fwX
                            CASE ELSE : mx = -fwY : my = fwX
                        END SELECT
                        ou = ou - mx * st : ov = ov - my * st
                    ELSE ' (a wall: u runs left to right as you face it, v down)
                        SELECT CASE k&
                            CASE 18432 : ov = ov + st
                            CASE 20480 : ov = ov - st
                            CASE 19200 : ou = ou + st
                            CASE ELSE : ou = ou - st
                        END SELECT
                    END IF
                    ou = (ou + 64) AND 63 : ov = (ov + 64) AND 63
            END SELECT
            EditPcTexSet j, ou, ov, ku, kv
        NEXT
        EditTreePut fx, fy, fc : lastJ = j0
    NEXT
    EditApply
    IF lastJ = 0 THEN EditNote "No picture there to change" : EXIT SUB
    IF op = 3 THEN
        EditNote "Picture" + MID$("s", 1, -(n > 1)) + " back as made"
    ELSE
        t$ = EditLookName$(lastJ) : IF t$ = "" THEN t$ = "as made"
        EditNote "Picture: " + t$ + MID$(" (" + LTRIM$(STR$(n)) + " selected)", 1, 99 * -(n > 1))
    END IF
END SUB

' PAINT + Shift+arrows (Ctrl: a pixel), Shift+[ ] and Shift+- = (stretch),
' Shift+Home (back as made): EditTexOp for the key
SUB EditOffsetKey(k&)
    DIM st ' (its own: the main program shares these names)
    SELECT CASE k&
        CASE 18176 : EditTexOp 3, k&, 0, 0, 0
        CASE 123 : EditTexOp 1, k&, -1, 0, 0 ' { (Shift+[): narrower
        CASE 125 : EditTexOp 1, k&, 1, 0, 0 ' } (Shift+]): wider
        CASE 95 : EditTexOp 2, k&, -1, 0, 0 ' _ (Shift+-): shorter
        CASE 43 : EditTexOp 2, k&, 1, 0, 0 ' + (Shift+=): taller
        CASE ELSE
            st = 4 : IF _KEYDOWN(100305) OR _KEYDOWN(100306) THEN st = 1 ' (a 16th of the picture - Ctrl: a pixel)
            EditTexOp 0, k&, 0, st, 0
    END SELECT
END SUB

' Put glyph c$ at cell (x, y) of the level (not on its border)
SUB EditPut(x, y, c0$)
    DIM c, j, k, c$, nm$ ' (its own: the main program shares these names)
    c$ = LEFT$(c0$, 1) : nm$ = MID$(c0$, 2) ' (a thing: " and its name - LEVEL/THINGS.BM)
    IF x < 1 OR y < 1 OR x > mapN - 2 OR y > mapN - 2 THEN EXIT SUB
    IF INSTR(".#NCKPG%?@$;/\DHXRBY!E=", c$) = 0 AND EditBoxIndex(x, y) > 0 THEN ' (a thing can't stand inside a block: take the block away first)
        EditNote "A block stands there - remove it first (DELETE on its side)" : EXIT SUB
    END IF
    IF MID$(lvlRow$(y), x + 1, 1) <> c$ THEN ' (something else there now: the old one's own settings go with it - a monster's, a pad's link)
        FOR k = lvlMonN TO 1 STEP -1
            IF lvlMon(k, 1) = x AND lvlMon(k, 2) = y THEN
                FOR j = k TO lvlMonN - 1 : FOR c = 1 TO MON_COLS : lvlMon(j, c) = lvlMon(j + 1, c) : NEXT : NEXT
                lvlMonN = lvlMonN - 1
            END IF
        NEXT
        IF c$ <> "&" THEN EditUnpair x, y
        IF INSTR("#NCKPG%?@$;/\DHXRBY!E=", c$) THEN EditRemoveBox x, y ' (a box only stands on open floor)
        EditNudgeSet x, y, 0, 0, 0 ' (a decoration's nudge goes with it)
        EditBarrelSet x, y, -1, 1 ' (and a barrel's liquid and stack)
        IF c$ <> CHR$(34) THEN XtraSet "things", x, y, "" ' (a thing's line)
        IF INSTR("DHXRBY!", c$) = 0 THEN XtraSet "doors", x, y, "" ' (a door's kicks and code)
        IF INSTR("'d" + CHR$(34), c$) = 0 THEN XtraSet "notes", x, y, "" ' (a note, or one in a desk or bookshelf or safe)
        IF INSTR("`,", c$) = 0 THEN XtraSet "fuel", x, y, "" ' (a jetpack's or fuel can's own fuel)
        XtraSet "difficulty", x, y, "" ' (the difficulties it was in: a new one's in every one)
        IF INSTR("#NCKPG", MID$(lvlRow$(y), x + 1, 1)) > 0 AND INSTR("#NCKPG", c$) = 0 THEN ' (a plain wall opened: its floor and ceiling the usual - whatever it kept, unseen in a wall, isn't carved in with it)
            MID$(lvlFloorRow$(y), x + 1, 1) = "." : MID$(lvlCeilRow$(y), x + 1, 1) = "."
        END IF
    END IF
    IF c$ = CHR$(34) AND LEN(nm$) THEN ' (a thing: its kind)
        k = XtraFind("things", x, y, 0)
        IF k = 0 THEN XtraSet "things", x, y, nm$ ELSE IF LCASE$(XtraField$(k, 3)) <> LCASE$(nm$) THEN XtraSet "things", x, y, nm$
    END IF
    IF INSTR("<>^v", c$) THEN ' (only one start: the old one becomes floor)
        FOR yy = 0 TO mapN - 1 : FOR xx = 0 TO mapN - 1
            IF INSTR("<>^v", MID$(lvlRow$(yy), xx + 1, 1)) THEN MID$(lvlRow$(yy), xx + 1, 1) = "."
        NEXT : NEXT
    END IF
    MID$(lvlRow$(y), x + 1, 1) = c$
END SUB

' The level (map, zones, lights) as one string - and back - for undo
FUNCTION EditSnapshot$
    DIM j, k, y ' (its own: the main program shares these names)
    s$ = ""
    FOR y = 0 TO mapN - 1 : s$ = s$ + lvlRow$(y) : NEXT
    FOR y = 0 TO mapN - 1 : s$ = s$ + lvlFloorRow$(y) : NEXT
    FOR y = 0 TO mapN - 1 : s$ = s$ + lvlCeilRow$(y) : NEXT
    s$ = s$ + CHR$(1) + LTRIM$(STR$(lvlNumZones))
    FOR k = 1 TO lvlNumZones : FOR j = 1 TO 7 : s$ = s$ + "," + LTRIM$(STR$(lvlZone(k, j))) : NEXT : NEXT
    s$ = s$ + CHR$(1) + LTRIM$(STR$(lvlNumLights))
    FOR k = 1 TO lvlNumLights : FOR j = 1 TO 9 : s$ = s$ + "," + LTRIM$(STR$(lvlLight(k, j))) : NEXT : NEXT
    s$ = s$ + CHR$(1)
    FOR k = 1 TO 6 : s$ = s$ + lvlWall$(k) + "|" : NEXT
    FOR k = 1 TO 4 : s$ = s$ + lvlFloor$(k) + "|" : NEXT
    FOR k = 1 TO 2 : s$ = s$ + lvlCeil$(k) + "|" : NEXT
    s$ = s$ + CHR$(2) ' (the faces' own pictures)
    FOR k = 1 TO lvlNumFaces
        s$ = s$ + LTRIM$(STR$(lvlFaceX(k))) + "," + LTRIM$(STR$(lvlFaceY(k))) + "," + FaceName$(lvlFaceS(k)) + "," + LTRIM$(STR$(lvlFaceD(k))) + "," + lvlFaceP1$(k) + "," + lvlFaceP2$(k) + FaceTexText$(k, ",") + CHR$(3)
    NEXT
    s$ = s$ + CHR$(4) ' (the lifts, and the pads paired by hand)
    FOR k = 1 TO lvlNumLifts : FOR j = 1 TO 8 : s$ = s$ + LTRIM$(STR$(lvlLift(k, j))) + "," : NEXT : s$ = s$ + CHR$(3) : NEXT
    s$ = s$ + CHR$(5)
    FOR k = 1 TO lvlNumPairs : FOR j = 1 TO 4 : s$ = s$ + LTRIM$(STR$(lvlPair(k, j))) + "," : NEXT : s$ = s$ + CHR$(3) : NEXT
    s$ = s$ + CHR$(6) ' (the monsters' own settings)
    FOR k = 1 TO lvlMonN : FOR j = 1 TO MON_COLS : s$ = s$ + LTRIM$(STR$(lvlMon(k, j))) + "," : NEXT : s$ = s$ + CHR$(3) : NEXT
    s$ = s$ + CHR$(7) + lvlName$ + CHR$(3) ' (its name and its light)
    FOR j = 1 TO 4 : s$ = s$ + LTRIM$(STR$(lvlAmb(j))) + "," : NEXT
    s$ = s$ + CHR$(8) ' (the event rooms)
    FOR k = 1 TO lvlNumEvents : FOR j = 1 TO 8 : s$ = s$ + LTRIM$(STR$(lvlEvent(k, j))) + "," : NEXT : s$ = s$ + CHR$(3) : NEXT
    s$ = s$ + CHR$(9) ' (the triggers)
    FOR k = 1 TO lvlNumTrigs : s$ = s$ + lvlTrig$(k) + CHR$(3) : NEXT
    s$ = s$ + CHR$(11) ' (the liquids: their map, then their depths)
    FOR y = 0 TO mapN - 1 : s$ = s$ + lvlLiqRow$(y) : NEXT
    FOR y = 0 TO mapN - 1 : s$ = s$ + lvlLiqDRow$(y) : NEXT
    FOR y = 0 TO mapN - 1 : s$ = s$ + lvlLiqORow$(y) : NEXT ' (and how see-through)
    FOR y = 0 TO mapN - 1 : s$ = s$ + lvlWetRow$(y) : NEXT ' (and how wet the floors look)
    s$ = s$ + CHR$(12) ' (the boxes, then the decorations' nudges)
    FOR k = 1 TO lvlNumBoxes : FOR j = 1 TO 7 : s$ = s$ + LTRIM$(STR$(lvlBox(k, j))) + "," : NEXT : s$ = s$ + CHR$(3) : NEXT
    s$ = s$ + CHR$(14)
    FOR k = 1 TO lvlNumNudges : FOR j = 1 TO 5 : s$ = s$ + LTRIM$(STR$(lvlNudge(k, j))) + "," : NEXT : s$ = s$ + CHR$(3) : NEXT
    s$ = s$ + CHR$(16) ' (the barrels' own: liquid, stack)
    FOR k = 1 TO lvlNumBarrels : FOR j = 1 TO 4 : s$ = s$ + LTRIM$(STR$(lvlBarrel(k, j))) + "," : NEXT : s$ = s$ + CHR$(3) : NEXT
    s$ = s$ + CHR$(15) + CellLightBoxes$(CHR$(3)) ' (the cell lights, last: as the file has them)
    s$ = s$ + CHR$(17) ' (and after them, the [doors], [things], [notes], [smears] lines)
    FOR k = 1 TO lvlNumXtra : s$ = s$ + lvlXSec$(k) + CHR$(18) + lvlXtra$(k) + CHR$(3) : NEXT
    EditSnapshot$ = s$
END FUNCTION

SUB EditRestore(s1$)
    DIM c, j, k, l$, p, q$, t$, y, xx, yy ' (its own: the main program shares these names)
    s0$ = s1$ : lvlNumBoxes = 0 : lvlNumNudges = 0
    rw& = mapN * mapN * 3 : r0$ = LEFT$(s0$, rw&) : s0$ = MID$(s0$, rw& + 1) ' (the map and its heights first, by length: a height past z can be any of the marks below)
    c17 = INSTR(s0$, CHR$(17)) ' (the [doors], [things], [notes], [smears] lines: the very end)
    IF c17 THEN
        b$ = MID$(s0$, c17 + 1) : s0$ = LEFT$(s0$, c17 - 1) : lvlNumXtra = 0
        DO WHILE LEN(b$)
            c3 = INSTR(b$, CHR$(3)) : IF c3 = 0 THEN EXIT DO
            t$ = LEFT$(b$, c3 - 1) : c = INSTR(t$, CHR$(18)) : IF c THEN XtraTake LEFT$(t$, c - 1), MID$(t$, c + 1)
            b$ = MID$(b$, c3 + 1)
        LOOP
    END IF
    c15 = INSTR(s0$, CHR$(15)) ' (the cell lights, last of all: off the end first)
    IF c15 THEN
        b$ = MID$(s0$, c15 + 1) : s0$ = LEFT$(s0$, c15 - 1) : CellLightsClear
        DIM lv(9) AS SINGLE
        DO WHILE LEN(b$)
            c3 = INSTR(b$, CHR$(3)) : IF c3 = 0 THEN EXIT DO
            lv(9) = 0
            IF SplitNums(LEFT$(b$, c3 - 1), lv()) >= 8 THEN
                FOR yy = lv(2) TO lv(4) : FOR xx = lv(1) TO lv(3)
                    lvlCLBright(xx, yy) = lv(5) : lvlCLCol(xx, yy) = _RGB32(lv(6), lv(7), lv(8)) : lvlCLFx(xx, yy) = lv(9)
                NEXT : NEXT
            END IF
            b$ = MID$(b$, c3 + 1)
        LOOP
    END IF
    c12 = INSTR(s0$, CHR$(12)) ' (the boxes and nudges, last of all: off the end first)
    IF c12 THEN
        b$ = MID$(s0$, c12 + 1) : s0$ = LEFT$(s0$, c12 - 1) : n$ = ""
        c14 = INSTR(b$, CHR$(14)) : IF c14 THEN n$ = MID$(b$, c14 + 1) : b$ = LEFT$(b$, c14 - 1)
        c16 = INSTR(n$, CHR$(16)) : br$ = "" : IF c16 THEN br$ = MID$(n$, c16 + 1) : n$ = LEFT$(n$, c16 - 1)
        DIM bv(8) AS SINGLE
        lvlNumBarrels = 0
        DO WHILE LEN(br$)
            c3 = INSTR(br$, CHR$(3)) : IF c3 = 0 THEN EXIT DO
            IF SplitNums(LEFT$(br$, c3 - 1), bv()) >= 4 AND lvlNumBarrels < MAX_BARRELS THEN lvlNumBarrels = lvlNumBarrels + 1 : FOR j = 1 TO 4 : lvlBarrel(lvlNumBarrels, j) = bv(j) : NEXT
            br$ = MID$(br$, c3 + 1)
        LOOP
        DO WHILE LEN(b$)
            c3 = INSTR(b$, CHR$(3)) : IF c3 = 0 THEN EXIT DO
            IF SplitNums(LEFT$(b$, c3 - 1), bv()) >= 7 AND lvlNumBoxes < MAX_BOXES THEN lvlNumBoxes = lvlNumBoxes + 1 : FOR j = 1 TO 7 : lvlBox(lvlNumBoxes, j) = bv(j) : NEXT
            b$ = MID$(b$, c3 + 1)
        LOOP
        DO WHILE LEN(n$)
            c3 = INSTR(n$, CHR$(3)) : IF c3 = 0 THEN EXIT DO
            bv(5) = 0
            IF SplitNums(LEFT$(n$, c3 - 1), bv()) >= 4 AND lvlNumNudges < MAX_NUDGES THEN lvlNumNudges = lvlNumNudges + 1 : FOR j = 1 TO 5 : lvlNudge(lvlNumNudges, j) = bv(j) : NEXT
            n$ = MID$(n$, c3 + 1)
        LOOP
    END IF
    c11 = INSTR(s0$, CHR$(11)) ' (the liquids, last but one: off the end next)
    IF c11 THEN
        q$ = MID$(s0$, c11 + 1) : s0$ = LEFT$(s0$, c11 - 1)
        FOR y = 0 TO mapN - 1
            lvlLiqRow$(y) = MID$(q$, y * mapN + 1, mapN) : lvlLiqDRow$(y) = MID$(q$, (mapN + y) * mapN + 1, mapN)
            lvlLiqORow$(y) = LEFT$(MID$(q$, (2 * mapN + y) * mapN + 1, mapN) + STRING$(mapN, "."), mapN)
            lvlWetRow$(y) = LEFT$(MID$(q$, (3 * mapN + y) * mapN + 1, mapN) + STRING$(mapN, "."), mapN)
        NEXT
    END IF
    c2 = INSTR(s0$, CHR$(2)) : s$ = s0$ : f$ = "" : l$ = "" : p$ = ""
    IF c2 THEN s$ = LEFT$(s0$, c2 - 1) : f$ = MID$(s0$, c2 + 1)
    s$ = r0$ + s$
    c4 = INSTR(f$, CHR$(4)) : IF c4 THEN l$ = MID$(f$, c4 + 1) : f$ = LEFT$(f$, c4 - 1)
    c5 = INSTR(l$, CHR$(5)) : IF c5 THEN p$ = MID$(l$, c5 + 1) : l$ = LEFT$(l$, c5 - 1)
    m$ = "" : c6 = INSTR(p$, CHR$(6)) : IF c6 THEN m$ = MID$(p$, c6 + 1) : p$ = LEFT$(p$, c6 - 1)
    a$ = "" : c7 = INSTR(m$, CHR$(7)) : IF c7 THEN a$ = MID$(m$, c7 + 1) : m$ = LEFT$(m$, c7 - 1)
    e$ = "" : c8 = INSTR(a$, CHR$(8)) : IF c8 THEN e$ = MID$(a$, c8 + 1) : a$ = LEFT$(a$, c8 - 1)
    t$ = "" : c9 = INSTR(e$, CHR$(9)) : IF c9 THEN t$ = MID$(e$, c9 + 1) : e$ = LEFT$(e$, c9 - 1)
    IF c9 THEN ' (the triggers)
        lvlNumTrigs = 0
        DO WHILE LEN(t$)
            c3 = INSTR(t$, CHR$(3)) : IF c3 = 0 THEN EXIT DO
            IF lvlNumTrigs < MAX_TRIGS THEN lvlNumTrigs = lvlNumTrigs + 1 : lvlTrig$(lvlNumTrigs) = LEFT$(t$, c3 - 1)
            t$ = MID$(t$, c3 + 1)
        LOOP
    END IF
    IF c8 THEN ' (the event rooms)
        lvlNumEvents = 0
        DIM ev(8) AS SINGLE
        DO WHILE LEN(e$)
            c3 = INSTR(e$, CHR$(3)) : IF c3 = 0 THEN EXIT DO
            IF SplitNums(LEFT$(e$, c3 - 1), ev()) >= 8 THEN lvlNumEvents = lvlNumEvents + 1 : FOR j = 1 TO 8 : lvlEvent(lvlNumEvents, j) = ev(j) : NEXT
            e$ = MID$(e$, c3 + 1)
        LOOP
    END IF
    c3 = INSTR(a$, CHR$(3))
    IF c3 THEN ' (its name and its light)
        lvlName$ = LEFT$(a$, c3 - 1)
        DIM av(4) AS SINGLE
        IF SplitNums(MID$(a$, c3 + 1), av()) >= 4 THEN FOR j = 1 TO 4 : lvlAmb(j) = av(j) : NEXT
    END IF
    DIM v(MON_COLS) AS SINGLE
    lvlMonN = 0
    DO WHILE LEN(m$)
        c3 = INSTR(m$, CHR$(3)) : IF c3 = 0 THEN EXIT DO
        IF SplitNums(LEFT$(m$, c3 - 1), v()) >= 7 THEN lvlMonN = lvlMonN + 1 : FOR j = 1 TO MON_COLS : lvlMon(lvlMonN, j) = v(j) : NEXT
        m$ = MID$(m$, c3 + 1)
    LOOP
    lvlNumLifts = 0
    DO WHILE LEN(l$)
        c3 = INSTR(l$, CHR$(3)) : IF c3 = 0 THEN EXIT DO
        IF SplitNums(LEFT$(l$, c3 - 1), v()) >= 8 THEN lvlNumLifts = lvlNumLifts + 1 : FOR j = 1 TO 8 : lvlLift(lvlNumLifts, j) = v(j) : NEXT
        l$ = MID$(l$, c3 + 1)
    LOOP
    lvlNumPairs = 0
    DO WHILE LEN(p$)
        c3 = INSTR(p$, CHR$(3)) : IF c3 = 0 THEN EXIT DO
        IF SplitNums(LEFT$(p$, c3 - 1), v()) >= 4 AND lvlNumPairs < MAX_PAIRS THEN lvlNumPairs = lvlNumPairs + 1 : FOR j = 1 TO 4 : lvlPair(lvlNumPairs, j) = v(j) : NEXT
        p$ = MID$(p$, c3 + 1)
    LOOP
    lvlNumFaces = 0
    DO WHILE LEN(f$)
        c3 = INSTR(f$, CHR$(3)) : IF c3 = 0 THEN EXIT DO
        TakeFace LEFT$(f$, c3 - 1) : f$ = MID$(f$, c3 + 1)
    LOOP
    FOR y = 0 TO mapN - 1 : lvlRow$(y) = MID$(s$, y * mapN + 1, mapN) : NEXT
    FOR y = 0 TO mapN - 1 : lvlFloorRow$(y) = MID$(s$, (mapN + y) * mapN + 1, mapN) : NEXT
    FOR y = 0 TO mapN - 1 : lvlCeilRow$(y) = MID$(s$, (mapN * 2 + y) * mapN + 1, mapN) : NEXT
    p = mapN * mapN * 3 + 2
    q = INSTR(p, s$, CHR$(1)) : z$ = MID$(s$, p, q - p) + ","
    lvlNumZones = VAL(z$) : z$ = MID$(z$, INSTR(z$, ",") + 1)
    FOR k = 1 TO lvlNumZones : FOR j = 1 TO 7
        c = INSTR(z$, ",") : lvlZone(k, j) = VAL(LEFT$(z$, c - 1)) : z$ = MID$(z$, c + 1)
    NEXT : NEXT
    p = q + 1 : q = INSTR(p, s$, CHR$(1)) : z$ = MID$(s$, p, q - p) + ","
    lvlNumLights = VAL(z$) : z$ = MID$(z$, INSTR(z$, ",") + 1)
    FOR k = 1 TO lvlNumLights : FOR j = 1 TO 9
        c = INSTR(z$, ",") : lvlLight(k, j) = VAL(LEFT$(z$, c - 1)) : z$ = MID$(z$, c + 1)
    NEXT : NEXT
    z$ = MID$(s$, q + 1)
    FOR k = 1 TO 6 : c = INSTR(z$, "|") : lvlWall$(k) = LEFT$(z$, c - 1) : z$ = MID$(z$, c + 1) : NEXT
    FOR k = 1 TO 4 : c = INSTR(z$, "|") : lvlFloor$(k) = LEFT$(z$, c - 1) : z$ = MID$(z$, c + 1) : NEXT
    FOR k = 1 TO 2 : c = INSTR(z$, "|") : lvlCeil$(k) = LEFT$(z$, c - 1) : z$ = MID$(z$, c + 1) : NEXT
END SUB

' Save the level to its file (the old one kept as .bak) - after checking
' it has a start, an exit, and walls all round
SUB EditSave(lev)
    DIM c$, x, y ' (its own: the main program shares these names)
    starts = 0 : exits = 0 : border = -1
    FOR y = 0 TO mapN - 1 : FOR x = 0 TO mapN - 1
        c$ = MID$(lvlRow$(y), x + 1, 1)
        IF INSTR("<>^v", c$) THEN starts = starts + 1
        IF c$ = "E" THEN exits = exits + 1
        IF x = 0 OR y = 0 OR x = mapN - 1 OR y = mapN - 1 THEN IF INSTR("#NCKPG", c$) = 0 THEN border = 0
    NEXT : NEXT
    warn$ = ""
    IF starts <> 1 THEN warn$ = warn$ + "  (no start!)"
    IF exits <> 1 THEN warn$ = warn$ + "  (no exit!)"
    IF NOT border THEN warn$ = warn$ + "  (gaps in the border!)"
    f$ = LevelFile$(lev)
    IF _FILEEXISTS(f$) THEN
        IF _FILEEXISTS(f$ + ".bak") THEN KILL f$ + ".bak"
        NAME f$ AS f$ + ".bak"
    END IF
    WriteLevelFile f$
    Achieve "NC_ARCHITECT", -1
    editDirty = 0
    EditStateSave ' (the editor as it is - view, tools, grid, undo and redo - kept with it: EDITOR/SESSION.BM)
    IF edVerPane THEN EditVerList ' (its .bak is the save before this one now)
    EditNote "Saved " + f$ + warn$
END SUB

' Liquid kind k (0: none) d eighths deep into cell (x, y) of the level as
' its file says it - not into a wall or the border; and none: drained
SUB EditSetLiquid(x, y, k, d)
    IF x < 1 OR y < 1 OR x > mapN - 2 OR y > mapN - 2 THEN EXIT SUB
    IF k THEN
        IF INSTR(EDIT_OPEN$ + CHR$(34), MID$(lvlRow$(y), x + 1, 1)) = 0 THEN EXIT SUB ' (floor, or something standing on it - not a wall or a door)
        MID$(lvlLiqRow$(y), x + 1, 1) = MID$(LQ_CHARS$, k, 1)
        IF d = LQ_DEPTH THEN MID$(lvlLiqDRow$(y), x + 1, 1) = "." ELSE MID$(lvlLiqDRow$(y), x + 1, 1) = LTRIM$(STR$(d))
    ELSE
        MID$(lvlLiqRow$(y), x + 1, 1) = "." : MID$(lvlLiqDRow$(y), x + 1, 1) = "." : MID$(lvlLiqORow$(y), x + 1, 1) = "."
    END IF
END SUB

' The PAINT brush's liquid (edBrushLiq$) into cell (x, y) - or, drain on
' (or the brush is DRAIN), none there
SUB EditBrushLiquid(x, y, drain)
    IF drain OR edBrushLiq$ = "-" OR edBrushLiq$ = "" THEN
        EditSetLiquid x, y, 0, 0
    ELSE
        EditSetLiquid x, y, INSTR(LQ_CHARS$, LEFT$(edBrushLiq$, 1)), VAL(MID$(edBrushLiq$, 2))
    END IF
END SUB

' A liquid brush ("w4", "-") in words
FUNCTION LiquidBrushName$(b$)
    IF b$ = "-" OR b$ = "" THEN LiquidBrushName$ = "drain the liquid" : EXIT FUNCTION
    LiquidBrushName$ = lqName$(INSTR(LQ_CHARS$, LEFT$(b$, 1))) + ", " + MID$(b$, 2) + "/8 deep"
END FUNCTION

' What PAINT puts on: a picture, or a liquid
FUNCTION EditPaintName$
    IF edBrushKind = PK_LIQUID THEN EditPaintName$ = LiquidBrushName$(edBrushLiq$) ELSE EditPaintName$ = edBrushTex$
END FUNCTION

' A message along the editor's bottom, for a few seconds
SUB EditNote(m$)
    editMsg$ = m$ : editMsgUntil! = TIMER + 4
END SUB

' The glyph before or after the one chosen, in EDIT_GLYPHS' order
SUB EditCycleGlyph(d)
    DIM p ' (its own: the main program shares these names)
    p = INSTR(EDIT_GLYPHS, editGlyph$) + d
    IF p < 1 THEN p = LEN(EDIT_GLYPHS)
    IF p > LEN(EDIT_GLYPHS) THEN p = 1
    editGlyph$ = MID$(EDIT_GLYPHS, p, 1) : EditNote GlyphName$(editGlyph$)
END SUB

' What a map character is (chapter 22's list, in a few words)
FUNCTION GlyphName$(c$)
    DIM k ' (its own: the main program shares these names)
    IF LEN(c$) > 1 AND LEFT$(c$, 1) = CHR$(34) THEN GlyphName$ = ThingTitle$(MID$(c$, 2)) : EXIT FUNCTION
    SELECT CASE c$
        CASE "-" : g$ = "bars (a window: see through, can't pass)"
        CASE "'" : g$ = "a NOTE - its words and picture on its pane"
        CASE CHR$(34) : g$ = "a thing (what it is: its pane)"
        CASE "." : g$ = "open floor (PLACE it: a room bigger)"
        CASE "#", "N", "C", "K", "P", "G" : g$ = "wall " + c$ + " (" + lvlWall$(INSTR("#NCKPG", c$)) + ")"
        CASE "/", "\" : g$ = "diagonal wall " + c$
        CASE "D" : g$ = "sliding door"
        CASE "H" : g$ = "shutter door"
        CASE "X" : g$ = "split door"
        CASE "R", "B", "Y" : g$ = MID$("red   blue  yellow", INSTR("RBY", c$) * 6 - 5, 6) : g$ = RTRIM$(g$) + " key door"
        CASE "E" : g$ = "the EXIT"
        CASE "!" : g$ = "sealed door (a data station opens it)"
        CASE "=" : g$ = "glass"
        CASE "@" : g$ = "data station"
        CASE "$" : g$ = "code terminal (a QB64 puzzle)"
        CASE ";" : g$ = "turret control (a hack switches nearby turrets off)"
        CASE "%" : g$ = "closet wall (secret)"
        CASE "?" : g$ = "secret wall (Space finds it)"
        CASE "&" : g$ = "teleporter pad (pairs: 1st-2nd, 3rd-4th...)"
        CASE "r", "b", "y" : g$ = RTRIM$(MID$("red   blue  yellow", INSTR("rby", c$) * 6 - 5, 6)) + " keycard"
        CASE "+" : g$ = "health pack"
        CASE "*" : g$ = "big medkit"
        CASE "u" : g$ = "armour"
        CASE "a" : g$ = "energy cells"
        CASE "e" : g$ = "shells"
        CASE "2" : g$ = "scatter gun"
        CASE "3" : g$ = "repeater"
        CASE "4" : g$ = "railgun"
        CASE "M" : g$ = "the map"
        CASE "q" : g$ = "overcharge"
        CASE "j" : g$ = "damage amp"
        CASE "8" : g$ = "night vision headset (N)"
        CASE "9" : g$ = "hazmat suit (poison, slime, acid)"
        CASE ")" : g$ = "rocket launcher (gun 5)"
        CASE "(" : g$ = "rockets (5)"
        CASE "{" : g$ = "repeater rounds (40)"
        CASE "}" : g$ = "railgun slugs (5)"
        CASE "`" : g$ = "a JETPACK - E flies up, C down, while its fuel lasts"
        CASE "," : g$ = "jet fuel (+40)"
        CASE "m", "g", "h", "c", "s", "k", "w", "z", "T", "1", "5", "6", "7", "0" : g$ = mtypeName$(MonOfChar(c$))
        CASE "~" : g$ = "turret (drops from the ceiling)"
        CASE "_" : g$ = "turret (rises from the floor)"
        CASE "|" : g$ = "turret (slides out of the wall)"
        CASE "<", ">", "^", "v" : g$ = "the START, facing " + c$
        CASE ELSE
            k = INSTR(DecoChars$, c$)
            IF k THEN g$ = RTRIM$(MID$("barrel     lamp       plant      terminal   crate      server rackvending    coolant    spawner    desk       console    screens    specimen   lab bench  generator  cryo pod   hologram   lockers    bench      chair      body       ", k * 11 - 10, 11)) ELSE g$ = "?"
            IF c$ = ":" THEN g$ = "a LIQUID BARREL - its liquid and stack on its pane"
            IF c$ = "[" THEN g$ = "a TREASURE CHEST - Space opens it"
    END SELECT
    GlyphName$ = g$
END FUNCTION

' Its colour on the editor's map
FUNCTION GlyphColor~&(c0$)
    DIM k, c$ ' (its own: the main program shares these names)
    c$ = LEFT$(c0$, 1)
    SELECT CASE c$
        CASE "-" : col~& = _RGB32(150, 140, 130)
        CASE "'" : col~& = _RGB32(240, 240, 220)
        CASE CHR$(34) : col~& = _RGB32(230, 160, 230)
        CASE "." : col~& = _RGB32(28, 30, 48)
        CASE "#", "N", "C", "K", "P", "G"
            k = INSTR("#NCKPG", c$) : IF k = 1 THEN col~& = wallMapColor(1) ELSE col~& = wallMapColor(k + 1)
        CASE "/", "\" : col~& = _RGB32(150, 150, 170)
        CASE "D", "H", "X" : col~& = _RGB32(255, 140, 20)
        CASE "R" : col~& = _RGB32(255, 50, 50)
        CASE "B" : col~& = _RGB32(60, 110, 255)
        CASE "Y" : col~& = _RGB32(255, 230, 40)
        CASE "E" : col~& = _RGB32(60, 255, 120)
        CASE "!" : col~& = _RGB32(255, 200, 40)
        CASE "=" : col~& = _RGB32(130, 220, 255)
        CASE "@" : col~& = _RGB32(60, 240, 255)
        CASE "$" : col~& = _RGB32(90, 255, 120)
        CASE ";" : col~& = _RGB32(255, 120, 40)
        CASE "%" : col~& = _RGB32(120, 90, 60)
        CASE "?" : col~& = _RGB32(150, 120, 200)
        CASE "&" : col~& = _RGB32(190, 110, 255)
        CASE "<", ">", "^", "v" : col~& = _RGB32(255, 255, 255)
        CASE ELSE
            IF INSTR("rby+*uae234Mqj89)({}`,", c$) THEN col~& = _RGB32(80, 230, 120)
            IF MonOfChar(c$) THEN col~& = _RGB32(255, 70, 90)
            IF INSTR(DecoChars$, c$) THEN col~& = _RGB32(230, 200, 90)
    END SELECT
    GlyphColor~& = col~&
END FUNCTION

' Which entry of the palette is at screen point (mx, my) (0: none)
FUNCTION EditPaletteAt(mx, my)
    DIM k ' (its own: the main program shares these names)
    IF mx < ED_PALX OR my < ED_PALY THEN EXIT FUNCTION
    col = (mx - ED_PALX) \ 22 : row = (my - ED_PALY) \ 22
    IF col > 7 THEN EXIT FUNCTION
    k = row * 8 + col + 1
    IF k <= LEN(EDIT_GLYPHS) THEN EditPaletteAt = k
END FUNCTION

' The editor's map from above: every cell its colour, things a dot in
' theirs, the lights (and their reach, on the light layer), the event
' rooms' outlines, you - and the palette, and what's under the mouse
SUB DrawEditor(hx, hy, onMap, rectOn, rx, ry, px, py, fx, fy, lev, lname$)
    DIM ax, ay, B, c, c$, d, k, sx, sy, w, x, y, vx0, vy0, vx1, vy1, ins ' (its own: the main program shares these names)
    LINE (0, 0)-(799, 599), _RGB32(10, 8, 22), BF
    ' (only the cells in view - the map panned and zoomed: Space)
    vx0 = MaxOf(0, -edMapX \ edCell) : vy0 = MaxOf(0, -edMapY \ edCell) : vx1 = MinOf(mapN - 1, (ED_VIEWW - edMapX) \ edCell + 1) : vy1 = MinOf(mapN - 1, (ED_VIEWH - edMapY) \ edCell + 1)
    ins = MaxOf(1, edCell \ 4) ' (a thing's mark: inset in its cell)
    VIEW SCREEN (0, 0)-(ED_VIEWW, ED_VIEWH) ' (the map stays in its part of the screen)
    FOR y = vy0 TO vy1 : FOR x = vx0 TO vx1
        c$ = MID$(lvlRow$(y), x + 1, 1) : sx = edMapX + x * edCell : sy = edMapY + y * edCell
        IF INSTR("rby+*uae234Mqj89)({}`,mghcskwzT15670~_|]oiptxlnfSdAFIJLOQUWZV:['<>^v" + CHR$(34), c$) THEN
            LINE (sx, sy)-STEP(edCell - 1, edCell - 1), GlyphColor~&("."), BF
            LINE (sx + ins, sy + ins)-STEP(MaxOf(0, edCell - 1 - 2 * ins), MaxOf(0, edCell - 1 - 2 * ins)), GlyphColor~&(c$), BF
            IF INSTR("<>^v", c$) THEN LINE (sx + 1, sy + 1)-STEP(edCell - 3, edCell - 3), _RGB32(255, 255, 255), B
        ELSEIF c$ = "/" THEN
            LINE (sx, sy)-STEP(edCell - 1, edCell - 1), GlyphColor~&("."), BF : LINE (sx, sy + edCell - 1)-(sx + edCell - 1, sy), GlyphColor~&(c$)
        ELSEIF c$ = "\" THEN
            LINE (sx, sy)-STEP(edCell - 1, edCell - 1), GlyphColor~&("."), BF : LINE (sx, sy)-(sx + edCell - 1, sy + edCell - 1), GlyphColor~&(c$)
        ELSE
            LINE (sx, sy)-STEP(edCell - 1, edCell - 1), GlyphColor~&(c$), BF
        END IF
    NEXT : NEXT
    FOR k = 1 TO lvlNumBoxes ' The boxes: each where it stands in its cell
        x = lvlBox(k, 1) : y = lvlBox(k, 2) : w = lvlBox(k, 7) : IF w < 1 OR w > 6 THEN w = 1
        IF x >= 0 AND y >= 0 AND x < mapN AND y < mapN THEN
            sx = edMapX + x * edCell : sy = edMapY + y * edCell
            LINE (sx + lvlBox(k, 3) * edCell \ 8, sy + lvlBox(k, 4) * edCell \ 8)-(sx + MaxOf(lvlBox(k, 3) * edCell \ 8, lvlBox(k, 5) * edCell \ 8 - 1), sy + MaxOf(lvlBox(k, 4) * edCell \ 8, lvlBox(k, 6) * edCell \ 8 - 1)), GlyphColor~&(MID$("#NCKPG", w, 1)), BF
        END IF
    NEXT
    FOR y = vy0 TO vy1 : FOR x = vx0 TO vx1 ' The liquids: each cell washed with its colour (deeper, stronger)
        k = INSTR(LQ_CHARS$, MID$(lvlLiqRow$(y), x + 1, 1))
        IF k THEN
            d = VAL(MID$(lvlLiqDRow$(y), x + 1, 1)) : IF d < 1 THEN d = LQ_DEPTH
            LINE (edMapX + x * edCell, edMapY + y * edCell)-STEP(edCell - 1, edCell - 1), _RGBA32(lqR(k), lqG(k), lqB(k), 90 + d * 15), BF
        END IF
    NEXT : NEXT
    IF edGrid THEN ' The grid: every cell's edge, as strong as it's set (G, Shift+G)
        FOR k = 0 TO mapN
            LINE (edMapX + k * edCell, edMapY)-(edMapX + k * edCell, edMapY + mapN * edCell), _RGBA32(90, 230, 255, edGridAlpha \ 2)
            LINE (edMapX, edMapY + k * edCell)-(edMapX + mapN * edCell, edMapY + k * edCell), _RGBA32(90, 230, 255, edGridAlpha \ 2)
        NEXT
    END IF
    ' The heights layer: each floor shaded by its height (and its number in
    ' eighths), a ceiling that isn't the usual a dot in the corner
    IF editHeights THEN
        FOR y = vy0 TO vy1 : FOR x = vx0 TO vx1
            IF INSTR("#NCKPG", MID$(lvlRow$(y), x + 1, 1)) = 0 THEN
                fh = HeightOf(MID$(lvlFloorRow$(y), x + 1, 1), 0) : ch = HeightOf(MID$(lvlCeilRow$(y), x + 1, 1), 1)
                sx = edMapX + x * edCell : sy = edMapY + y * edCell
                IF fh <> 0 THEN
                    k = 120 + fh * 90 : IF k > 255 THEN k = 255
                    IF k < 20 THEN k = 20
                    IF fh > 0 THEN LINE (sx + 1, sy + 1)-STEP(edCell - 3, edCell - 3), _RGB32(k, k * 0.8, 40), BF ELSE LINE (sx + 1, sy + 1)-STEP(edCell - 3, edCell - 3), _RGB32(40, 20, 80 + (1 + fh) * 100), BF
                END IF
                IF ch <> 1 THEN PSET (sx + edCell - 3, sy + 2), _RGB32(120, 220, 255) : PSET (sx + edCell - 4, sy + 2), _RGB32(120, 220, 255)
            END IF
        NEXT : NEXT
        FOR k = 1 TO lvlNumLifts ' (the lifts, outlined)
            LINE (edMapX + MinOf(lvlLift(k, 1), lvlLift(k, 3)) * edCell, edMapY + MinOf(lvlLift(k, 2), lvlLift(k, 4)) * edCell)-(edMapX + (MaxOf(lvlLift(k, 1), lvlLift(k, 3)) + 1) * edCell - 1, edMapY + (MaxOf(lvlLift(k, 2), lvlLift(k, 4)) + 1) * edCell - 1), _RGB32(120, 255, 120), B
        NEXT
    END IF
    ' The triggers' places, outlined in orange (a use: its cell)
    FOR k = 1 TO numTrigs
        LINE (edMapX + trigX0(k) * edCell + 1, edMapY + trigY0(k) * edCell + 1)-(edMapX + (trigX1(k) + 1) * edCell - 2, edMapY + (trigY1(k) + 1) * edCell - 2), _RGBA32(255, 160, 40, 200), B
    NEXT
    ' The event rooms, outlined
    FOR k = 1 TO lvlNumEvents
        LINE (edMapX + lvlEvent(k, 2) * edCell, edMapY + lvlEvent(k, 3) * edCell)-(edMapX + (lvlEvent(k, 4) + 1) * edCell - 1, edMapY + (lvlEvent(k, 5) + 1) * edCell - 1), _RGBA32(255, 80, 200, 150), B
    NEXT
    ' The lights
    FOR k = 1 TO lvlNumLights
        lx = edMapX + lvlLight(k, 1) * edCell : ly = edMapY + lvlLight(k, 2) * edCell
        lc~& = _RGB32(lvlLight(k, 5), lvlLight(k, 6), lvlLight(k, 7))
        IF editLights THEN CIRCLE (lx, ly), lvlLight(k, 3) * edCell, _RGBA32(lvlLight(k, 5), lvlLight(k, 6), lvlLight(k, 7), 90)
        CIRCLE (lx, ly), 3, lc~& : PSET (lx, ly), _RGB32(255, 255, 255)
    NEXT
    ' You
    ax = edMapX + px * edCell : ay = edMapY + py * edCell
    LINE (ax, ay)-(ax + fx * edCell * 1.6, ay + fy * edCell * 1.6), _RGB32(255, 255, 0)
    CIRCLE (ax, ay), edCell \ 3, _RGB32(255, 255, 0)
    ' The cursor (and a rectangle being dragged)
    IF onMap THEN
        IF rectOn THEN
            LINE (edMapX + MinOf(rx, hx) * edCell, edMapY + MinOf(ry, hy) * edCell)-(edMapX + (MaxOf(rx, hx) + 1) * edCell - 1, edMapY + (MaxOf(ry, hy) + 1) * edCell - 1), _RGB32(255, 255, 255), B
        ELSE
            LINE (edMapX + hx * edCell - 1, edMapY + hy * edCell - 1)-STEP(edCell + 1, edCell + 1), _RGB32(255, 255, 255), B
        END IF
    END IF
    VIEW ' (the whole screen again)
    IF mapN > 48 OR edCell <> 12 THEN TinyText ED_PALX, 570, "MAP" + STR$(mapN) + " x" + STR$(mapN) + "  SPACE: PAN/ZOOM", _RGB32(120, 110, 160)
    ' The palette, two-and-a-bit columns of glyphs on the right
    COLOR _RGB32(255, 90, 200) : _PRINTSTRING (ED_PALX, 4), "LEVEL EDITOR"
    shortName$ = lname$ : c = INSTR(lname$, ": ") : IF c THEN shortName$ = MID$(lname$, c + 2) ' ("SECTOR 1: NEON STATION" - just its name)
    COLOR _RGB32(170, 160, 210) : _PRINTSTRING (ED_PALX, 22), LEFT$("Sector" + STR$(lev) + ": " + shortName$, 24)
    ' (the picker's under these: EditDrawPicker, from RunEditor)
    y = 254
    IF editLights THEN TinyText ED_PALX, y + 20, "LIGHT: " + EditFxName$(edLFx) + " (right click: take it away)", _RGB32(edLR, edLG, edLB)
    IF editHeights THEN TinyText ED_PALX, y + 9, "HEIGHTS: click floor up, right click down", _RGB32(255, 220, 120) : TinyText ED_PALX, y + 20, "SHIFT+CLICK ceiling up, SHIFT+RIGHT CLICK down", _RGB32(120, 220, 255)
    IF editHeights THEN ' The heights layer's key, each mark drawn as the map draws it
        y = 524
        LINE (ED_PALX, y)-STEP(7, 7), _RGB32(170, 136, 40), BF : TinyText ED_PALX + 11, y, "FLOOR RAISED (BRIGHTER: HIGHER)", _RGB32(190, 180, 230)
        LINE (ED_PALX, y + 11)-STEP(7, 7), _RGB32(40, 20, 155), BF : TinyText ED_PALX + 11, y + 11, "FLOOR SUNK", _RGB32(190, 180, 230)
        LINE (ED_PALX + 100, y + 11)-STEP(7, 7), _RGB32(120, 255, 120), B : TinyText ED_PALX + 111, y + 11, "LIFT", _RGB32(190, 180, 230)
        LINE (ED_PALX, y + 22)-STEP(7, 7), _RGB32(40, 40, 70), BF : PSET (ED_PALX + 5, y + 24), _RGB32(120, 220, 255) : PSET (ED_PALX + 4, y + 24), _RGB32(120, 220, 255)
        TinyText ED_PALX + 11, y + 22, "CEILING NOT THE USUAL 8 EIGHTHS", _RGB32(120, 220, 255)
    END IF

    TinyText ED_PALX, 558, "HELP / F1: every key", _RGB32(140, 130, 180)
    IF onMap THEN EditInspect hx, hy ' (the cell under the mouse: what it is, its pictures)
    ' Along the bottom: the cell under the mouse, and the latest message
    IF onMap THEN
        c$ = CellGlyph$(hx, hy) ' (a thing: its own name)
        h$ = "" : IF HeightOf(MID$(lvlFloorRow$(hy), hx + 1, 1), 0) <> 0 OR HeightOf(MID$(lvlCeilRow$(hy), hx + 1, 1), 1) <> 1 THEN h$ = "  floor" + STR$(CINT(HeightOf(MID$(lvlFloorRow$(hy), hx + 1, 1), 0) * 8)) + "  ceiling" + STR$(CINT(HeightOf(MID$(lvlCeilRow$(hy), hx + 1, 1), 1) * 8)) + " eighths"
        TinyText 4, 581, LTRIM$(STR$(hx)) + "," + LTRIM$(STR$(hy)) + "  " + GlyphName$(c$) + h$, _RGB32(200, 200, 230) ' (small print, the map's whole width: two lines, this and the message)
    END IF
    IF TIMER < editMsgUntil! THEN TinyText 4, 591, LEFT$(editMsg$, 116), _RGB32(255, 220, 120)
    IF editDirty THEN TinyText ED_PALX, 586, "* NOT SAVED (CTRL+S)", _RGB32(255, 90, 90)
    EditDrawSelMap ' (the selection - the same one the 3D view has)
END SUB

' Walking round in the editor: what's under the crosshair, the glyph you'd
' place, and the latest message
' --- THE 3D EDITOR'S POINTER (chapter 21). A point on the screen is a ray
' into the world: the same sums that put the world on the screen, run
' backwards. Across, the camera plane (chapter 8) - so many cells right
' for each cell ahead; up, half a wall per cell ahead at the top edge
' (chapter 15's viewH); then tilted by how far you look up or down (OpenGL
' only - chapter 24). EditPick follows that ray cell by cell through the
' map, the way the walls are found (chapter 15) but in 3D: in each open
' cell, does it go down through the floor or up through the ceiling before
' it leaves? Leaving, does it hit a wall, the face of a step up, or a
' ceiling stepping down? The first face it meets is edHov...: its kind
' (ED_), the cell it belongs to, which side (1 east, 2 south, 3 west, 4
' north) and the point it was hit.
SUB EditRay(sx, sy, rdx, rdy, rdz)
    DIM c, r ' (its own: the main program shares these names)
    ndcX = sx / 400 - 1 : ndcY = 1 - sy / 300
    ak = 1 ' (FULL WIDE too: the view is wider than our screen, but our screen is its 4:3 middle - which sees just what a 4:3 view does)
    r = ndcX * edCamPlane * ak : u = ndcY / (2 * edCamZoom)
    c = COS(pitch) : sn = SIN(pitch)
    rdx = -r * edCamDY - u * sn * edCamDX + c * edCamDX ' (your right: (-dirY, dirX))
    rdy = r * edCamDX - u * sn * edCamDY + c * edCamDY
    rdz = u * c + sn
END SUB

SUB EditPick(sx, sy)
    DIM bt, f, mx, my, nx, ny, t, dk, dh, dt, du, dsd, dlx, dly, dbk, tLim, dg, dgt, dr, zsb, thx, thy ' (its own: the main program shares these names)
    edHovKind = 0
    EditRay sx, sy, rdx, rdy, rdz
    ex = edCamPX : ey = edCamPY : ez = eyeZ
    mx = INT(ex) : my = INT(ey)
    IF rdx = 0 THEN rdx = 0.00001
    IF rdy = 0 THEN rdy = 0.00001
    ddx = ABS(1 / rdx) : ddy = ABS(1 / rdy)
    IF rdx < 0 THEN stx = -1 : sdx = (ex - mx) * ddx ELSE stx = 1 : sdx = (mx + 1 - ex) * ddx
    IF rdy < 0 THEN sty = -1 : sdy = (ey - my) * ddy ELSE sty = 1 : sdy = (my + 1 - ey) * ddy
    tIn = 0
    FOR stepN = 1 TO 90
        IF mx < 0 OR my < 0 OR mx >= mapN OR my >= mapN THEN EXIT SUB
        IF sdx < sdy THEN tOut = sdx ELSE tOut = sdy
        IF worldMap(mx, my) <= 0 AND boxOn(mx, my) <> 0 THEN ' A box in it: its side, unless the floor or ceiling's in the way first
            bt = BoxRay(mx, my, ex, ey, rdx, rdy, tIn, tOut, bs)
            IF bt >= 0 THEN
                bz = ez + rdz * bt
                IF bz >= floorH(mx, my) AND bz <= ceilH(mx, my) THEN
                    IF bs = 0 THEN
                        IF rdx > 0 THEN bsd = 3 ELSE bsd = 1
                    ELSE
                        IF rdy > 0 THEN bsd = 4 ELSE bsd = 2
                    END IF
                    EditHit ED_BOX, mx, my, bsd, ex + rdx * bt, ey + rdy * bt, bz : EXIT SUB
                END IF
            END IF
        END IF
        dk = EditDoorIn(mx, my) : dg = diagCorner(mx, my)
        IF worldMap(mx, my) <= 0 OR dk OR dg THEN ' An open cell (or a doorway, or a diagonal's open half): through its floor or ceiling, on the way across?
            tLim = tOut : dh = 0
            IF dg THEN ' (a diagonal's open half: up to its slanted face)
                dgt = DiagonalHit(dg, mx, my, ex, ey, rdx, rdy, tIn, tOut)
                IF dgt >= 0 THEN tLim = dgt : dh = 2 : dt = dgt
            END IF
            IF dk THEN ' (a doorway: its floor and ceiling either side of the door, up to the door's slab across its middle)
                dr = DoorRay(mx, my, ex, ey, rdx, rdy, dt, du, dsd, dlx, dly, dbk)
                IF dr THEN
                    IF dt >= tIn - 0.001 AND dt <= tOut THEN
                        IF doorType(mx, my) = DOOR_SHUTTER THEN ' (a shutter's face: from its bottom up - under it, through)
                            IF ez + rdz * dt >= floorH(mx, my) + DoorShown(mx, my) * (ceilH(mx, my) - floorH(mx, my)) THEN tLim = dt : dh = -1
                        ELSE
                            tLim = dt : dh = -1 : IF dr = 2 THEN dh = 3 ' (3: its edge)
                        END IF
                    END IF
                END IF
                IF doorType(mx, my) = DOOR_SHUTTER AND rdz > 0 AND DoorShown(mx, my) > 0 THEN ' (a lifted shutter's underside, from below)
                    zsb = floorH(mx, my) + DoorShown(mx, my) * (ceilH(mx, my) - floorH(mx, my))
                    IF ez < zsb THEN
                        t = (zsb - ez) / rdz
                        IF t >= tIn - 0.001 AND t <= tLim THEN
                            thx = ex + rdx * t : thy = ey + rdy * t
                            IF ABS(EditDoorN(mx, my, thx, thy)) <= DOOR_THICK / 2 THEN EditHit ED_DEDGE, mx, my, 0, thx, thy, zsb : EXIT SUB
                        END IF
                    END IF
                END IF
            END IF
            f = floorH(mx, my) : cz = ceilH(mx, my) : zOut = ez + rdz * tLim
            IF rdz < 0 AND zOut < f THEN
                t = (f - ez) / rdz
                IF t >= tIn - 0.001 THEN
                    thx = ex + rdx * t : thy = ey + rdy * t
                    IF dk THEN IF doorType(mx, my) <> DOOR_EXIT AND ABS(EditDoorN(mx, my, thx, thy)) < TRACK_HALF THEN EditHit ED_TRACK, mx, my, 0, thx, thy, f : EXIT SUB ' (its track)
                    EditHit ED_FLOOR, mx, my, 0, thx, thy, f : EXIT SUB
                END IF
            END IF
            IF rdz > 0 AND zOut > cz THEN
                t = (cz - ez) / rdz
                IF t >= tIn - 0.001 THEN
                    thx = ex + rdx * t : thy = ey + rdy * t
                    IF dk THEN IF doorType(mx, my) <> DOOR_EXIT AND ABS(EditDoorN(mx, my, thx, thy)) < TRACK_HALF THEN EditHit ED_TRACK, mx, my, 0, thx, thy, cz : EXIT SUB
                    EditHit ED_CEIL, mx, my, 0, thx, thy, cz : EXIT SUB
                END IF
            END IF
            IF dh = 2 THEN EditHit ED_DIAG, mx, my, 0, ex + rdx * dt, ey + rdy * dt, ez + rdz * dt : EXIT SUB ' (the diagonal's slanted face)
            IF dh = 3 THEN EditHit ED_DEDGE, mx, my, 0, ex + rdx * dt, ey + rdy * dt, ez + rdz * dt : EXIT SUB ' (the door's edge)
            IF dh THEN ' (the door itself: its face towards you - the side it's painted on)
                IF DoorAcross(mx, my) = 0 THEN
                    dsd = 2 : IF rdy > 0 THEN dsd = 4
                ELSE
                    dsd = 1 : IF rdx > 0 THEN dsd = 3
                END IF
                EditHit ED_WALL, mx, my, dsd, ex + rdx * dt, ey + rdy * dt, ez + rdz * dt : EXIT SUB
            END IF
        END IF
        ' On to the next cell, across its edge
        IF sdx < sdy THEN
            sdx = sdx + ddx : nx = mx + stx : ny = my : IF stx > 0 THEN side = 3 ELSE side = 1 ' (the new cell's side we came in by)
        ELSE
            sdy = sdy + ddy : nx = mx : ny = my + sty : IF sty > 0 THEN side = 4 ELSE side = 2
        END IF
        IF nx < 0 OR ny < 0 OR nx >= mapN OR ny >= mapN THEN EXIT SUB
        zOut = ez + rdz * tOut : hx = ex + rdx * tOut : hy = ey + rdy * tOut
        IF worldMap(mx, my) <= 0 OR EditDoorIn(mx, my) OR diagCorner(mx, my) <> 0 THEN ' (from an open cell or a doorway - a face is only a face seen from the open side)
            dg = 0 : IF diagCorner(nx, ny) THEN IF NOT InDiagonalWall(diagCorner(nx, ny), hx + rdx * 0.0001 - nx, hy + rdy * 0.0001 - ny) THEN dg = -1 ' (into a diagonal's open half: on into it)
            IF worldMap(nx, ny) > 0 AND NOT EditDoorIn(nx, ny) AND NOT dg THEN
                EditHit ED_WALL, nx, ny, side, hx, hy, zOut : EXIT SUB
            ELSEIF zOut < floorH(nx, ny) THEN
                EditHit ED_STEP, nx, ny, side, hx, hy, zOut : EXIT SUB
            ELSEIF zOut > ceilH(nx, ny) THEN
                EditHit ED_LINTEL, nx, ny, side, hx, hy, zOut : EXIT SUB
            END IF
        END IF
        mx = nx : my = ny : tIn = tOut
    NEXT
END SUB

' A drag from above moving the selection: the sector as it was when the drag
' began, and the selection moved (tx, ty) from there in one go - so what it
' passes over on the way is left as it was; only the cells it ends on are
' replaced. (EditNudge, as the arrows - one undo for the whole drag)
SUB EditDragMove(tx, ty)
    DIM k ' (its own: the main program shares these names)
    IF edMoving = 1 THEN EditPushUndo : edMvSnap$ = EditSnapshot$ : edMoving = 2
    EditRestore edMvSnap$
    FOR k = 1 TO edSelN : edSelX(k) = edSelX(k) - edMvDX : edSelY(k) = edSelY(k) - edMvDY : NEXT
    IF tx = 0 AND ty = 0 THEN edMvDX = 0 : edMvDY = 0 : EXIT SUB
    mwx = edSelX(1) : mwy = edSelY(1)
    EditNudge tx, ty
    IF edSelX(1) = mwx AND edSelY(1) = mwy THEN ' (into the border: back where it got to)
        IF edMvDX <> 0 OR edMvDY <> 0 THEN EditNudge edMvDX, edMvDY
    ELSE
        edMvDX = tx : edMvDY = ty
    END IF
END SUB

' Is anything selected in cell (x, y)? (Pressed there from above, a drag moves the selection)
FUNCTION EditSelOnCell(x, y)
    DIM k ' (its own: the main program shares these names)
    FOR k = 1 TO edSelN
        IF edSelX(k) = x AND edSelY(k) = y THEN EditSelOnCell = -1 : EXIT FUNCTION
    NEXT
END FUNCTION

' A doorway the editor's pointer goes into (its floor and ceiling either side
' of the door): any door but the exit, which is flat in its wall
FUNCTION EditDoorIn(x, y)
    IF worldMap(x, y) = 2 THEN EditDoorIn = (doorType(x, y) <> DOOR_EXIT)
END FUNCTION

' Alt+L, in either view: FULL BRIGHT on or off - every cell lit evenly, as its
' pictures are (UpdateLight), to see what's what. Only while editing; the
' key held down toggles it once. True if k& was it (then it's used up)
FUNCTION EditFullBrightKey(k&)
    IF ABS(k&) = 100307 OR ABS(k&) = 100308 THEN edFBAlt = (k& > 0) ' (Alt followed through the key queue too: a quick Alt+L is down and up within a frame)
    IF ABS(k&) <> 108 AND ABS(k&) <> 76 THEN EXIT FUNCTION
    IF k& < 0 THEN edFBDown = 0 : EXIT FUNCTION
    IF NOT (edFBAlt OR _KEYDOWN(100307) OR _KEYDOWN(100308)) THEN EXIT FUNCTION
    EditFullBrightKey = -1
    IF edFBDown THEN EXIT FUNCTION
    edFBDown = -1 : edFullBright = NOT edFullBright : litAll = 3 ' (every cell lit again: both of OpenGL's halves)
    IF edFullBright THEN EditNote "FULL BRIGHT: every cell lit evenly (Alt+L: the sector's own lights)" ELSE EditNote "The sector's own lights (Alt+L: full bright)"
END FUNCTION

' THE SELECTION: faces, by kind, cell, side and part. EditSelToggle puts
' one in (or takes it out, if it's there); EditSelFlood takes every floor
' (or ceiling) cell joined to (x, y) at the same height - a room's floor in
' one click. Nothing needs them in order.
FUNCTION EditSelIndex(kind, x, y, side, part)
    DIM k ' (its own: the main program shares these names)
    FOR k = 1 TO edSelN
        IF edSelKind(k) = kind AND edSelX(k) = x AND edSelY(k) = y AND edSelSide(k) = side AND edSelPart(k) = part THEN EditSelIndex = k : EXIT FUNCTION
    NEXT
END FUNCTION

SUB EditSelToggle(kind, x, y, side, part)
    DIM k ' (its own: the main program shares these names)
    k = EditSelIndex(kind, x, y, side, part)
    IF k THEN ' (there: out it goes - the last one moved into its place)
        edSelKind(k) = edSelKind(edSelN) : edSelX(k) = edSelX(edSelN) : edSelY(k) = edSelY(edSelN)
        edSelSide(k) = edSelSide(edSelN) : edSelPart(k) = edSelPart(edSelN) : edSelN = edSelN - 1
    ELSEIF edSelN < ED_MAXSEL THEN
        edSelN = edSelN + 1 : edSelKind(edSelN) = kind : edSelX(edSelN) = x : edSelY(edSelN) = y
        edSelSide(edSelN) = side : edSelPart(edSelN) = part
    END IF
END SUB

' A face into the selection, not looked for first (the caller knows it isn't
' there yet) - as many as there's room for
SUB EditSelAdd(kind, x, y, side, part)
    IF edSelN >= ED_MAXSEL THEN EXIT SUB
    edSelN = edSelN + 1 : edSelKind(edSelN) = kind : edSelX(edSelN) = x : edSelY(edSelN) = y
    edSelSide(edSelN) = side : edSelPart(edSelN) = part
END SUB

' The selection put by (back 0), and back again (back -1)
SUB EditSelKeep(back)
    DIM k ' (its own: the main program shares these names)
    IF back THEN
        edSelN = edKeepN
        FOR k = 1 TO edKeepN : edSelKind(k) = edKeepKind(k) : edSelX(k) = edKeepX(k) : edSelY(k) = edKeepY(k) : edSelSide(k) = edKeepSide(k) : edSelPart(k) = edKeepPart(k) : NEXT
    ELSE
        edKeepN = edSelN
        FOR k = 1 TO edSelN : edKeepKind(k) = edSelKind(k) : edKeepX(k) = edSelX(k) : edKeepY(k) = edSelY(k) : edKeepSide(k) = edSelSide(k) : edKeepPart(k) = edSelPart(k) : NEXT
    END IF
END SUB

SUB EditSelFlood(kind, x0, y0)
    DIM d, nx, ny, x, y, qn, qi, h ' (its own: the main program shares these names)
    DIM qx(MAP_SIZE * MAP_SIZE) AS INTEGER, qy(MAP_SIZE * MAP_SIZE) AS INTEGER, seen(MAP_SIZE, MAP_SIZE) AS INTEGER
    IF kind = ED_FLOOR THEN h = floorH(x0, y0) ELSE h = ceilH(x0, y0)
    edSelN = 0 : qn = 1 : qx(1) = x0 : qy(1) = y0 : seen(x0, y0) = -1 : qi = 0
    DO WHILE qi < qn AND edSelN < ED_MAXSEL
        qi = qi + 1 : x = qx(qi) : y = qy(qi)
        EditSelAdd kind, x, y, 0, 0 ' (seen() keeps it once each)
        FOR d = 0 TO 3
            nx = x + (d = 0) - (d = 1) : ny = y + (d = 2) - (d = 3)
            IF nx >= 0 AND ny >= 0 AND nx < mapN AND ny < mapN THEN
                IF NOT seen(nx, ny) AND worldMap(nx, ny) <= 0 THEN
                    IF kind = ED_FLOOR THEN hh = floorH(nx, ny) ELSE hh = ceilH(nx, ny)
                    IF ABS(hh - h) < 0.001 THEN seen(nx, ny) = -1 : qn = qn + 1 : qx(qn) = nx : qy(qn) = ny
                END IF
            END IF
        NEXT
    LOOP
END SUB

' Is the screen point (x, y) on the editor's own buttons and panels? (Then
' a click there is for them, not for picking a face - or the wheel.)
FUNCTION EditOverUI(x, y)
    EditOverUI = 0
    IF edHelp THEN EditOverUI = -1 : EXIT FUNCTION ' (the help is up: a click closes it)
    IF EditTBAt(x, y, editView) THEN EditOverUI = -1
    IF editView = 1 AND edPickOpen AND y >= PK_Y - 4 THEN EditOverUI = -1 ' (the picker: the bottom of the screen)
    IF editView = 1 AND x - edWX >= edPnX0 - 6 AND y >= edPnY0 AND y <= edPnBot AND edPnTitle$ <> "" THEN EditOverUI = -1 ' (the properties pane)
    IF editView = 1 AND edPickOn AND NOT edPickOpen AND y >= PK_TUCK THEN EditOverUI = -1 ' (tucked away: its strip)
END FUNCTION

' --- THE TOOLBAR: the editor's buttons, in both views - along the top in
' 3D (v = 1), in the panel on the right of the map from above (v = 0).
' Each button is a TB_ number, a place and a size, worked out here (and
' asked again whenever they're drawn or clicked, so they're never stale).
' The order: the tools, then what you do to the level, then the grid and
' how strong it is (a slider), then the other view and the help. In the
' order string a | is a gap between groups, a / a new row.
SUB EditTBLayout(v)
    DIM c$, k, w, x, x0, y ' (its own: the main program shares these names)
    IF v = 1 THEN o$ = "SPTLH|DUYW|GA|ZRKVQ" : x = 8 : y = 4 ELSE o$ = "SPT/LHD/UYW/GA/V<>/BZ/RQ" : x = ED_PALX : y = 290
    x0 = x : edTbN = 0
    FOR k = 1 TO LEN(o$)
        c$ = MID$(o$, k, 1)
        IF c$ = "|" THEN
            x = x + 8
        ELSEIF c$ = "/" THEN
            x = x0 : y = y + 24
        ELSE
            id = INSTR("SPLHDUWGAVQTK<>BZRY", c$)
            IF v = 1 THEN w = TinyW(EditTBLabel$(id)) + 14 ELSE w = 64 ' (small print: they all fit, even on our 800 screen)
            IF id = TB_ALPHA THEN w = 64 : IF v = 0 THEN w = 132
            IF (id = TB_KINDS OR id = TB_VERSIONS) AND v = 0 THEN w = 132
            edTbN = edTbN + 1 : edTbId(edTbN) = id : edTbX(edTbN) = x : edTbY(edTbN) = y : edTbW(edTbN) = w : edTbH(edTbN) = 20
            x = x + w + 3 : IF v = 0 THEN x = x + 1
        END IF
    NEXT
END SUB

FUNCTION EditTBLabel$(id)
    DIM t$ ' (its own: the main program shares these names)
    SELECT CASE id
        CASE TB_SELECT : t$ = "SELECT"
        CASE TB_PLACE : t$ = "PLACE"
        CASE TB_LIGHT : t$ = "LIGHT"
        CASE TB_HEIGHT : t$ = "HEIGHT"
        CASE TB_DELETE : t$ = "DELETE"
        CASE TB_UNDO : t$ = "UNDO"
        CASE TB_REDO : t$ = "REDO"
        CASE TB_SAVE : t$ = "SAVE"
        CASE TB_GRID : t$ = "GRID"
        CASE TB_VIEW : IF editView = 1 THEN t$ = "2D MAP" ELSE t$ = "3D"
        CASE TB_HELP : t$ = "HELP"
        CASE TB_PAINT : t$ = "PAINT"
        CASE TB_PICK : t$ = "PICKER"
        CASE TB_PREV : t$ = "< SECT"
        CASE TB_NEXT : t$ = "SECT >"
        CASE TB_KINDS : t$ = "MONSTER KINDS"
        CASE TB_SECTOR : t$ = "SECTOR"
        CASE TB_VERSIONS : t$ = "VERSIONS"
    END SELECT
    EditTBLabel$ = t$
END FUNCTION

' What a button does, said when the pointer is over it (with its key)
FUNCTION EditTBTip$(id)
    DIM t$ ' (its own: the main program shares these names)
    SELECT CASE id
        CASE TB_SELECT : IF editView = 1 THEN t$ = "Select: click a face - Shift adds, Ctrl a whole floor" ELSE t$ = "Select: click a cell or drag a box - Shift adds"
        CASE TB_PLACE : IF editView = 1 THEN t$ = "Place: click to put " + GlyphName$(editGlyph$) + " there ([ ] change)" ELSE t$ = "Place: paint " + GlyphName$(editGlyph$) + " - Shift+drag a box"
        CASE TB_LIGHT : t$ = "Light: click a face to light it (LIGHTS tab: colour, effect)"
        CASE TB_HEIGHT : t$ = "Height: click raises a floor/ceiling, Shift+click lowers"
        CASE TB_DELETE : t$ = "Delete the selection: walls opened, things gone (Del)"
        CASE TB_UNDO : t$ = "Undo (Ctrl+Z)"
        CASE TB_REDO : t$ = "Redo what was undone (Ctrl+Y, Ctrl+Shift+Z)"
        CASE TB_SAVE : t$ = "Save the sector to its file (Ctrl+S)"
        CASE TB_GRID : t$ = "The grid over the world on/off (G)"
        CASE TB_ALPHA : t$ = "How strong the grid is: drag (Shift+G)"
        CASE TB_VIEW : IF editView = 1 THEN t$ = "The map from above (Tab)" ELSE t$ = "Walk round inside it (Tab)"
        CASE TB_HELP : t$ = "Every key and click (F1)"
        CASE TB_PAINT : t$ = "Paint: click a face to give it the brush's picture"
        CASE TB_PICK : t$ = "The picker: tucked away / always open / off (P)"
        CASE TB_PREV : t$ = "The sector before (PgUp) - save first"
        CASE TB_NEXT : t$ = "The sector after (PgDn) - save first"
        CASE TB_KINDS : t$ = "Every monster kind's numbers - monsters.txt (M)"
        CASE TB_SECTOR : t$ = "The sector: its name, its light, its pictures"
        CASE TB_VERSIONS : t$ = "Revert to the saved sector, save a version, go back to one"
    END SELECT
    EditTBTip$ = t$
END FUNCTION

' The button at (x, y) in view v - its TB_ number - or 0
FUNCTION EditTBAt(x, y, v)
    DIM k, tbLX ' (its own: the main program shares these names)
    EditTBAt = 0
    EditTBLayout v
    tbLX = x : IF v = 1 THEN tbLX = x + edWX ' (FULL WIDE: the toolbar's at the window's left edge)
    FOR k = 1 TO edTbN
        IF tbLX >= edTbX(k) AND y >= edTbY(k) AND tbLX < edTbX(k) + edTbW(k) AND y < edTbY(k) + edTbH(k) THEN EditTBAt = edTbId(k) : EXIT FUNCTION
    NEXT
END FUNCTION

' Is button id lit - the tool in use, the grid on, the help up?
FUNCTION EditTBOn(id)
    SELECT CASE id
        CASE TB_SELECT : EditTBOn = (edTool = ET_SELECT)
        CASE TB_PLACE : EditTBOn = (edTool = ET_PLACE)
        CASE TB_LIGHT : EditTBOn = (edTool = ET_LIGHT)
        CASE TB_HEIGHT : EditTBOn = (edTool = ET_HEIGHT)
        CASE TB_GRID : EditTBOn = edGrid
        CASE TB_HELP : EditTBOn = edHelp
        CASE TB_PAINT : EditTBOn = (edTool = ET_PAINT)
        CASE TB_PICK : EditTBOn = (edPickOn <> 0)
        CASE TB_SECTOR : EditTBOn = edSectorPane
        CASE TB_VERSIONS : EditTBOn = edVerPane
        CASE ELSE : EditTBOn = 0
    END SELECT
END FUNCTION

' Draw the toolbar for view v, the pointer at (mx, my): lit buttons in
' magenta, the one under the pointer brighter, and what it does under it
SUB EditDrawTB(v, mx, my)
    DIM B, f, k, l$, t$, tc~&, tx, ty, w, x, y, pmx ' (its own: the main program shares these names)
    EditTBLayout v
    IF v = 1 THEN
        HudAt -1 : LINE (0, 0)-(scrW - 1, 27), _RGBA32(6, 2, 18, 190), BF : LINE (0, 28)-(scrW - 1, 28), _RGBA32(255, 60, 200, 120) ' (FULL WIDE: all the way across - from the window's left edge)
    END IF
    pmx = mx : IF v = 1 AND mx <> -1 THEN pmx = mx + edWX ' (the pointer, on the toolbar at the window's left edge - a copy: mx is the caller's)
    hov = 0
    FOR k = 1 TO edTbN
        id = edTbId(k) : x = edTbX(k) : y = edTbY(k) : w = edTbW(k) : h = edTbH(k)
        over = (pmx >= x AND my >= y AND pmx < x + w AND my < y + h) : IF over THEN hov = k
        IF id = TB_ALPHA THEN ' The slider: filled as far as the grid is strong
            LINE (x, y)-STEP(w - 1, h - 1), _RGBA32(14, 6, 30, 230), BF
            f = (w - 4) * edGridAlpha / 255
            IF edGrid THEN fc~& = _RGBA32(90, 230, 255, 170) ELSE fc~& = _RGBA32(90, 120, 160, 110)
            LINE (x + 2, y + 2)-STEP(f, h - 5), fc~&, BF
            LINE (x + 2 + f, y)-STEP(1, h - 1), _RGB32(255, 255, 255), BF
            IF over OR edTbDrag THEN bc~& = _RGB32(150, 240, 255) ELSE bc~& = _RGB32(90, 70, 140)
            LINE (x, y)-STEP(w - 1, h - 1), bc~&, B
            t$ = LTRIM$(STR$(INT(edGridAlpha * 100 / 255 + 0.5))) + "%"
            TinyText x + (w - TinyW(t$)) \ 2, y + 6, t$, _RGB32(255, 255, 255)
        ELSE
            lit = EditTBOn(id)
            IF lit THEN bg~& = _RGBA32(120, 20, 100, 230) ELSE bg~& = _RGBA32(14, 6, 30, 230)
            IF over THEN bg~& = _RGBA32(40, 70, 110, 240)
            LINE (x, y)-STEP(w - 1, h - 1), bg~&, BF
            IF lit THEN bc~& = _RGB32(255, 60, 200) ELSE bc~& = _RGB32(90, 70, 140)
            IF over THEN bc~& = _RGB32(150, 240, 255)
            LINE (x, y)-STEP(w - 1, h - 1), bc~&, B
            t$ = EditTBLabel$(id)
            IF lit OR over THEN tc~& = _RGB32(255, 255, 255) ELSE tc~& = _RGB32(200, 190, 240)
            TinyText x + (w - TinyW(t$)) \ 2, y + 6, t$, tc~&
        END IF
    NEXT
    ' What the one under the pointer does
    IF hov THEN
        t$ = EditTBTip$(edTbId(hov))
        IF v = 1 THEN
            tx = edTbX(hov) : IF tx + TinyW(t$) + 8 > scrW - 4 THEN tx = scrW - 4 - TinyW(t$) - 8
            LINE (tx, 32)-STEP(TinyW(t$) + 8, 13), _RGBA32(0, 0, 0, 220), BF
            TinyText tx + 4, 35, t$, _RGB32(150, 240, 255)
        ELSE
            ty = 466
            DO WHILE LEN(t$) ' (the panel's narrow: in lines of 44, small print)
                l$ = LEFT$(t$, 44)
                IF LEN(t$) > 44 THEN sp = _INSTRREV(l$, " ") : IF sp > 8 THEN l$ = LEFT$(t$, sp - 1)
                TinyText ED_PALX, ty, l$, _RGB32(150, 240, 255) : ty = ty + 11 : t$ = LTRIM$(MID$(t$, LEN(l$) + 1))
            LOOP
        END IF
    END IF
END SUB

' The cheatsheet (HELP, F1): every key, click and turn of the wheel for
' the view you're in, by what it's for - two columns over the view. Each
' line is "#A HEADING" or "KEYS~what they do"; a click anywhere puts it away.
SUB EditDrawHelp(v)
    DIM B, c, l$, n, t$, x, y, y0 ' (its own: the main program shares these names)
    IF v = 1 THEN
        h$ = "#MOVE AND LOOK|walk keys~fly that way - through walls|look up + walk~climb (look down: sink)|Space / C~straight up / down|Shift~faster|hold Right~look round (crosshair picks)|Tab~the map from above|F2~play the level as it is|"
        h$ = h$ + "#POINT AND SELECT|Left click~the tool on the face / thing|SELECT click~select it|Shift+click~add it / take it out|Ctrl+click~the whole floor, ceiling, or wall side|Ctrl+D~select nothing|Del~delete the selection|arrows~move the selection a cell|"
        h$ = h$ + "#THE TOOLS (toolbar)|PLACE~the brush there; drag along|  Shift / E~take away / pick it up|PAINT~the picture on the face|  Ctrl+click~select the face (Shift: add)|  Shift / E~the usual / pick it up|  Shift+arrows~slide its picture (Ctrl: 1 px)|  Shift+[ ] - =~stretch it: wide, tall|  Shift+Home~the picture as made|  Ctrl+C / Ctrl+V~copy / paste a face's look|LIGHT~a light on the face|  Shift~take it away|  its pane~CEILING LAMP on/off, REMOVE|  painted ceiling~stays: the light shines from it|HEIGHT~floor/ceiling up; Shift down|"
        h$ = h$ + "#THE WHEEL (the selection)|floor, ceiling~up / down an eighth|  Ctrl~a whole wall|wall + Shift~pull out / push back|wall + Alt~push back / pull out|wall+Ctrl+Shift~a block on the floor|wall+Alt+Shift~a block from the ceiling|"
        h$ = h$ + "#FACES IN PIECES|H / V~divide: left-right, top-bottom|  on a piece~divide it again (4 deep)|  a halved face~whole again|J~join a piece back up|click a piece~select / paint it alone|R / Shift+R~turn its picture (PAINT)|M / Shift+M~flip it left-right / upside down|O~open a door, hold a lift up / down|  Shift+O~as in play (at nothing: all)|"
        h$ = h$ + "#LIQUIDS (picker tab)|PAINT click~pour it on a floor|  Ctrl / Shift~the whole floor / drain|"
        h$ = h$ + "#PICKER AND PANES|P~picker: tucked / open / off|picker click~the brush - and the|~  selection's, if any|wheel on picker~scroll it|selection~its pane: door, pad, light,|~  monster, event, lift, floor|PAINT + selection~PICTURE pane: slide, stretch,|~  turn, tint (any colour), as made|TRIGGERS...~its triggers (in a pane)|SECTOR~name, light, its pictures|"
        h$ = h$ + "#VIEW AND FILE|1-5~SELECT PLACE PAINT LIGHT HEIGHT|6 / 7 / 8~SECTOR / VERSIONS / picker open|G / Shift+G~grid on-off / stronger|Alt+L~full bright: everything lit evenly|Ctrl+S~save|Ctrl+Z / UNDO~undo|Ctrl+Y / REDO~redo (or Ctrl+Shift+Z)|U~the HUD layout editor|F1~this sheet|"
        h$ = h$ + "#OLDER KEYS (aimed ahead)|[ ]~the brush back / on|T / F~wall kind's / floor's picture|Z~the cell's floor number|L / K~a light here / take nearest|PgUp/PgDn~floor up/down (Shift: ceil)"
        t$ = "EDITOR CHEATSHEET - 3D VIEW"
    ELSE
        h$ = "#THE TOOLS (toolbar)|SELECT~click a cell, drag a box|  Shift~add to the selection|PLACE~paint the brush; drag on|  Shift+drag~a box of it|  Right click~pick up what's there|  FLOORS: open floor~a room bigger|PAINT~picture on a floor, or|~  on a wall's four sides|E~pick up the cell (the tool's)|  Ctrl / Shift~ceiling / the usual|LIGHT~a light; Right: take away|HEIGHT~floor up; Right: down|  Shift~the ceiling|"
        h$ = h$ + "#THE WHEEL|on the picker~scroll it|on the map~selected floors up / down|  Ctrl~their ceilings|elsewhere~the brush back / on|"
        h$ = h$ + "#THE SELECTION|arrows~move it a cell (up is north)|drag it~move it with the mouse|Del~delete it|Ctrl+D~select nothing|its pane~door, pad, light, monster,|~  event, lift, floor, triggers|"
        h$ = h$ + "#LIQUIDS (picker tab)|PAINT drag~pour it on (Shift: drain)|"
        h$ = h$ + "#KEYS|1-5~SELECT PLACE PAINT LIGHT HEIGHT|6 / 7 / 8~SECTOR / VERSIONS / picker open|L / H~the LIGHT / HEIGHT tool|[ ]~the brush back / on|G / Shift+G~grid on-off / stronger|T~put yourself at the mouse|PgUp/PgDn~the sector before / after|M~the monster kinds editor|U~the HUD layout editor|"
        h$ = h$ + "#VIEW AND FILE|Tab~walk round inside it (3D)|Esc / F2~play the level|SECTOR~name, light, its pictures|Alt+L~full bright (in 3D)|Ctrl+S~save|Ctrl+Z / UNDO~undo|Ctrl+Y / REDO~redo (or Ctrl+Shift+Z)|F1~this sheet"
        t$ = "EDITOR CHEATSHEET - THE MAP FROM ABOVE"
    END IF
    y0 = 32 : IF v = 0 THEN y0 = 4
    LINE (8, y0)-(791, 594), _RGBA32(6, 2, 18, 238), BF
    LINE (8, y0)-(791, 594), _RGB32(255, 60, 200), B
    TinyText 400 - TinyW(t$) \ 2, y0 + 8, t$, _RGB32(255, 90, 200) ' (small print: 11 pixels a line)
    x = 18 : y = y0 + 26 : col = 0
    DO WHILE LEN(h$)
        bar = INSTR(h$, "|") : IF bar = 0 THEN bar = LEN(h$) + 1
        l$ = LEFT$(h$, bar - 1) : h$ = MID$(h$, bar + 1)
        IF LEFT$(l$, 1) = "#" AND col = 0 THEN ' (a group that won't fit under it: the next column, so a group stays together)
            n = 0 : r$ = h$ + "|"
            DO WHILE LEN(r$) AND LEFT$(r$, 1) <> "#" : n = n + 1 : r$ = MID$(r$, INSTR(r$, "|") + 1) : LOOP
            IF y + 16 + n * 11 > 574 THEN col = 1 : x = 404 : y = y0 + 26
        END IF
        IF LEFT$(l$, 1) = "#" THEN
            IF y > y0 + 28 THEN y = y + 5
            TinyText x, y, MID$(l$, 2), _RGB32(255, 220, 120) : LINE (x, y + 10)-STEP(370, 0), _RGBA32(255, 220, 120, 90)
            y = y + 14
        ELSE
            c = INSTR(l$, "~")
            TinyText x, y, LEFT$(l$, c - 1), _RGB32(150, 240, 255)
            TinyText x + 110, y, MID$(l$, c + 1), _RGB32(225, 230, 255)
            y = y + 11
        END IF
        IF y > 562 AND col = 0 THEN col = 1 : x = 404 : y = y0 + 26
    LOOP
    TinyText 785 - TinyW("F1 or a click: close"), 582, "F1 or a click: close", _RGB32(140, 130, 180)
END SUB

' --- THE PICKER: along the bottom of the 3D view, a tab for each kind of
' thing (WALLS... LIGHTS), and under it the tab's things as pictures, two
' rows of eight at a time - the wheel (or the arrows beside them) scrolls.
' Click one and it's the brush: PLACE puts a map character, PAINT paints a
' picture, LIGHT lights - and if faces are selected, a picture or light
' is put on them there and then (a map character never is).
FUNCTION EditPkTabName$(t)
    EditPkTabName$ = RTRIM$(MID$("WALLS    FLOORS   CEILINGS DOORS    ITEMS    MONSTERS DECOR    SPECIAL  LIGHTS   LIQUIDS  ", t * 9 - 8, 9))
END FUNCTION

' The tab's entries, and their thumbnails - made again only when the tab,
' the level, its wall pictures or ART have changed. While one of the
' sector's own pictures is being chosen (the SECTOR pane: edSlotPick), only
' the picture files - no map characters (they'd be a PLACE brush), no smears
SUB EditPkBuild
    DIM a, B, d, k ' (its own: the main program shares these names)
    key$ = STR$(edPickTab) + STR$(edSlotPick > 0) + STR$(level) + STR$(artNow) + lvlFloor$(1) + lvlWall$(1) + lvlWall$(2) + lvlWall$(3) + lvlWall$(4) + lvlWall$(5) + lvlWall$(6)
    IF key$ = edPkKey$ THEN EXIT SUB
    edPkKey$ = key$
    FOR k = 1 TO edPkN
        IF edPkImg&(k) < -1 THEN _FREEIMAGE edPkImg&(k)
        edPkImg&(k) = 0
    NEXT
    edPkN = 0
    SELECT CASE edPickTab
        CASE 1 : g$ = "#NCKPG/\%?=" : pre$ = "wall"
        CASE 2 : g$ = "." : pre$ = "floor" ' (open floor first: PLACE it to carve a room bigger)
        CASE 3 : pre$ = "ceiling" : pre2$ = "sky-" ' (and the skies: a ceiling that's open to the sky)
        CASE 4 : g$ = "DHXRBY!E"
        CASE 5 : g$ = "rby+*uae234Mqj89)({}`,"
        CASE 6 : g$ = "mghcskwzT15670~_|]"
        CASE 7 : g$ = DecoChars$
        CASE 8 : g$ = "<>^v&@$;-."
    END SELECT
    IF edSlotPick THEN g$ = "" ' (choosing a sector picture: the files only)
    FOR k = 1 TO LEN(g$)
        edPkN = edPkN + 1 : edPkKind(edPkN) = PK_GLYPH : edPkVal$(edPkN) = MID$(g$, k, 1) : edPkImg&(edPkN) = EditGlyphThumb&(MID$(g$, k, 1))
    NEXT
    IF edPickTab = 7 AND edSlotPick = 0 THEN ' (and the things: a " each, its kind in [things])
        k = 1
        DO
            t$ = ListItem$(ThingList$, k) : IF t$ = "" THEN EXIT DO
            edPkN = edPkN + 1 : edPkKind(edPkN) = PK_GLYPH : edPkVal$(edPkN) = CHR$(34) + t$ : edPkImg&(edPkN) = EditGlyphThumb&(CHR$(34) + t$) : k = k + 1
        LOOP
    END IF
    IF LEN(pre$) THEN ' Every picture called wall*.png (floor*, ceiling* and sky-*), in name order
        dir$ = AssetPath$("x") : dir$ = LEFT$(dir$, LEN(dir$) - 1)
        first = edPkN + 1
        FOR pass = 1 TO 2
            IF pass = 1 THEN pp$ = pre$ ELSE pp$ = pre2$
            IF LEN(pp$) THEN
                f$ = _FILES$(dir$ + pp$ + "*.png")
                DO WHILE LEN(f$) AND edPkN < PK_MAX
                    b$ = f$ : sl = _INSTRREV(b$, "/") : IF sl THEN b$ = MID$(b$, sl + 1)
                    IF b$ <> "wall-jack.png" AND b$ <> "wall-code.png" AND b$ <> "ceiling-lamp.png" THEN edPkN = edPkN + 1 : edPkKind(edPkN) = PK_TEX : edPkVal$(edPkN) = b$
                    f$ = _FILES$
                LOOP
            END IF
        NEXT
        FOR a = first TO edPkN - 1 : FOR b = a + 1 TO edPkN
            IF LCASE$(edPkVal$(b)) < LCASE$(edPkVal$(a)) THEN SWAP edPkVal$(a), edPkVal$(b)
        NEXT : NEXT
        FOR k = first TO edPkN : edPkImg&(k) = EditFileThumb&(edPkVal$(k)) : NEXT
        IF edSlotPick = 0 THEN ' (a sector picture: no smears)
            FOR k = 0 TO SMEAR_KINDS - 1 ' (and blood and oil, to smear on a wall, a floor, a ceiling - [smears])
                edPkN = edPkN + 1 : edPkKind(edPkN) = PK_TEX : edPkVal$(edPkN) = "smear-" + SmearName$(k) + ".png" : edPkImg&(edPkN) = EditFileThumb&(edPkVal$(edPkN))
            NEXT
        END IF
    END IF
    IF edPickTab = 10 THEN ' The liquids: draining one away, then each kind two, four and six eighths deep
        edPkN = edPkN + 1 : edPkKind(edPkN) = PK_LIQUID : edPkVal$(edPkN) = "-" : edPkImg&(edPkN) = 0
        FOR k = 1 TO LQ_KINDS : FOR d = 2 TO 6 STEP 2
            edPkN = edPkN + 1 : edPkKind(edPkN) = PK_LIQUID : edPkVal$(edPkN) = MID$(LQ_CHARS$, k, 1) + LTRIM$(STR$(d)) : edPkImg&(edPkN) = EditSlotThumb&(T_LIQUID + k, 0)
        NEXT : NEXT
    END IF
    IF edPickTab = 9 THEN ' The lights: the six ways one can go (in the brush's colour, moving as they will), then twelve colours
        FOR k = 0 TO 5 : edPkN = edPkN + 1 : edPkKind(edPkN) = PK_LIGHT : edPkVal$(edPkN) = "F" + LTRIM$(STR$(k)) : edPkImg&(edPkN) = 0 : NEXT
        FOR k = 1 TO 12 : edPkN = edPkN + 1 : edPkKind(edPkN) = PK_LIGHT : edPkVal$(edPkN) = "C" + LTRIM$(STR$(k)) : edPkImg&(edPkN) = 0 : NEXT
    END IF
    EditPkScroll 0
END SUB

' A thumbnail (PK_SIZE - 4 square) of a texture slot (spr = 0) or a sprite
' slot (spr = -1), from the pictures the game's already loaded
FUNCTION EditSlotThumb&(slot, spr)
    DIM n, x, y ' (its own: the main program shares these names)
    n = PK_SIZE - 4 : img& = _NEWIMAGE(n, n, 32) : d& = _DEST
    IF spr THEN ts = spriteSize(slot) : IF ts <= 0 THEN ts = sprTex
    IF NOT spr THEN ts = texSize
    _DEST img& : _DONTBLEND img&
    FOR y = 0 TO n - 1 : FOR x = 0 TO n - 1
        IF spr THEN PSET (x, y), spriteTex(x * ts \ n, y * ts \ n, slot) ELSE PSET (x, y), texture(x * ts \ n, y * ts \ n, slot)
    NEXT : NEXT
    _BLEND img& : _DEST d&
    EditSlotThumb& = img&
END FUNCTION

' A thumbnail of a picture file (wall-*.png...): loaded, shrunk
FUNCTION EditFileThumb&(f$)
    DIM n ' (its own: the main program shares these names)
    EditFileThumb& = 0
    src& = _LOADIMAGE(ArtPath$(f$), 32) : IF src& >= -1 THEN EXIT FUNCTION
    n = PK_SIZE - 4 : img& = _NEWIMAGE(n, n, 32)
    _PUTIMAGE (0, 0)-(n - 1, n - 1), src&, img&
    _FREEIMAGE src&
    EditFileThumb& = img&
END FUNCTION

' A map character's thumbnail: the picture it's drawn with in the game
' (a wall's or door's texture, a thing's sprite) - 0 for the start, drawn
' as an arrow instead
FUNCTION EditGlyphThumb&(c$)
    DIM k, t ' (its own: the main program shares these names)
    t = 0 : sp = 0
    IF LEFT$(c$, 1) = CHR$(34) THEN ' (a thing: its picture)
        k = ThingCode(MID$(c$, 2)) : IF k = 0 THEN k = DK_TABLE
        IF k > THING_MON THEN sp = mtypeSprite(k - THING_MON) ELSE IF k > THING_ITEM THEN sp = ItemSprite(k - THING_ITEM) ELSE sp = DecoSlot(k)
        EditGlyphThumb& = EditSlotThumb&(sp, -1) : EXIT FUNCTION
    END IF
    SELECT CASE c$
        CASE "-" : sp = S_BARS
        CASE "#", "N", "C", "K", "P", "G" : t = INSTR("#NCKPG", c$)
        CASE "/", "\", "%", "?" : t = 1
        CASE "D", "!" : t = T_DOOR
        CASE "H" : t = T_SHUTTER
        CASE "X" : t = T_SPLIT
        CASE "R", "B", "Y" : t = T_DOORK + INSTR("RBY", c$)
        CASE "E" : t = T_EXIT
        CASE "@" : t = T_JACK
        CASE "$" : t = T_CODE
        CASE ";" : t = T_TCTRL
        CASE "." : t = T_FLOOR + 1
        CASE "=" : sp = S_GLASS
        CASE "&" : sp = S_PAD
        CASE "r", "b", "y" : sp = INSTR("rby", c$)
        CASE "+" : sp = 4
        CASE "*" : sp = 26
        CASE "u" : sp = 25
        CASE "a" : sp = 5
        CASE "e" : sp = 6
        CASE "2" : sp = 7
        CASE "3" : sp = 8
        CASE "4" : sp = 27
        CASE "M" : sp = 28
        CASE "q" : sp = ItemSprite(IT_OVERCHARGE)
        CASE "j" : sp = ItemSprite(IT_AMP)
        CASE "8" : sp = ItemSprite(IT_GOGGLES)
        CASE "9" : sp = ItemSprite(IT_SUIT)
        CASE ")" : sp = ItemSprite(IT_LAUNCHER)
        CASE "(" : sp = ItemSprite(IT_ROCKETS)
        CASE ELSE
            k = ItemOfChar(c$) : IF k THEN sp = ItemSprite(k) ' (any other pickup: the repeater's rounds, the railgun's slugs...)
            k = MonOfChar(c$) : IF k THEN sp = mtypeSprite(k)
            k = DecoOfChar(c$) : IF k THEN sp = DecoSlot(k)
    END SELECT
    IF t THEN EditGlyphThumb& = EditSlotThumb&(t, 0) ELSE IF sp THEN EditGlyphThumb& = EditSlotThumb&(sp, -1) ELSE EditGlyphThumb& = 0
END FUNCTION

' A light preset's colour (1-8 in the editor: 0-7 here)
FUNCTION EditLightRGB~&(p)
    DIM c~& ' (its own: the main program shares these names)
    SELECT CASE p
        CASE 0 : c~& = _RGB32(230, 235, 255)
        CASE 1 : c~& = _RGB32(60, 220, 255)
        CASE 2 : c~& = _RGB32(255, 60, 220)
        CASE 3 : c~& = _RGB32(255, 160, 60)
        CASE 4 : c~& = _RGB32(90, 255, 120)
        CASE 5 : c~& = _RGB32(255, 40, 40)
        CASE 6 : c~& = _RGB32(220, 230, 255)
        CASE ELSE : c~& = _RGB32(255, 150, 70)
    END SELECT
    EditLightRGB~& = c~&
END FUNCTION

' What's at screen point (x, y) on the picker: what = 1 a tab (idx: which),
' 2 a thumbnail (idx: its entry), 3 scroll up, 4 scroll down; 0 nothing
' Where the picker is, in the view it's in: along the bottom in 3D (the
' tabs in a row, two rows of eight), in the panel on the right of the map
' from above (the tabs in rows, three rows of four, smaller). Tab t's box
' is EditPkTab; the thumbnails' grid is at (gx, gy), cols x rows of cells
' sz across (and a gap of 4).
SUB EditPkGeom(gx, gy, cols, rows, sz)
    DIM tx, ty, w ' (its own: the main program shares these names)
    IF editView = 1 THEN
        gx = PK_X : gy = PK_Y + 22 : cols = PK_COLS + MaxOf(0, EditPkRight - 792) \ (PK_SIZE + 4) : rows = PK_ROWS : sz = PK_SIZE ' (FULL WIDE: more of them across)
    ELSE ' (the map view: under the tabs, however many rows they wrap to - a little smaller if that's four)
        EditPkTab PK_TABS, tx, ty, w
        gx = ED_PALX : gy = MaxOf(100, ty + 24) : cols = 4 : rows = 3 : sz = 43 : IF gy > 100 THEN sz = 39
    END IF
END SUB

' The picker's right edge, in 3D: our screen's (792) - FULL WIDE, the
' window's, or short of the pane if it comes down that far (the pane as it
' was last built)
FUNCTION EditPkRight
    DIM pr ' (its own)
    pr = 792 + 2 * edWX
    IF edWX > 0 AND edPnTitle$ <> "" AND edPnBot >= PK_Y - 4 THEN pr = MinOf(pr, edPnX0 + 2 * edWX - 14)
    EditPkRight = pr
END FUNCTION

SUB EditPkTab(t, tx, ty, w)
    DIM k, x0, y0 ' (its own: the main program shares these names)
    IF editView = 1 THEN x0 = PK_X : y0 = PK_Y : wrap = EditPkRight + 8 : pad = 10 ELSE x0 = ED_PALX : y0 = 40 : wrap = ED_PALX + 202 : pad = 6
    tx = x0 : ty = y0
    FOR k = 1 TO t
        w = TinyW(EditPkTabName$(k)) + pad + 6
        IF tx + w > wrap THEN tx = x0 : ty = ty + 20
        IF k < t THEN tx = tx + w + 3
    NEXT
END SUB

' The picker's thumbnails a row up (d -1) or down (1) - no further than
' its last row shows (0: just that)
SUB EditPkScroll(d)
    DIM gx, gy, mx ' (its own: the main program shares these names)
    EditPkGeom gx, gy, cols, rows, sz
    edPickScroll = edPickScroll + d
    mx = MaxOf(0, (edPkN + cols - 1) \ cols - rows)
    IF edPickScroll > mx THEN edPickScroll = mx
    IF edPickScroll < 0 THEN edPickScroll = 0
END SUB

' Is the picker showing in this view?
FUNCTION EditPkShown
    EditPkShown = (editView = 0) OR edPickOpen
END FUNCTION

SUB EditPkHit(x, y, what, idx)
    DIM gx, gy, k, sx, t, tx, ty, w, px ' (its own: the main program shares these names)
    what = 0 : idx = 0
    IF NOT EditPkShown THEN EXIT SUB
    px = x : IF editView = 1 THEN px = x + edWX ' (FULL WIDE: the picker's all the way across - a copy: x is the caller's)
    FOR t = 1 TO PK_TABS
        EditPkTab t, tx, ty, w
        IF px >= tx AND px < tx + w AND y >= ty AND y < ty + 18 THEN what = 1 : idx = t : EXIT SUB
    NEXT
    EditPkGeom gx, gy, cols, rows, sz
    IF px >= gx AND px < gx + cols * (sz + 4) AND y >= gy AND y < gy + rows * (sz + 4) THEN
        k = edPickScroll * cols + ((y - gy) \ (sz + 4)) * cols + (px - gx) \ (sz + 4) + 1
        IF k <= edPkN THEN what = 2 : idx = k
        EXIT SUB
    END IF
    sx = gx + cols * (sz + 4) : ah = (rows * (sz + 4) - 4) \ 2
    IF px >= sx AND px < sx + 16 AND y >= gy AND y < gy + ah THEN what = 3
    IF px >= sx AND px < sx + 16 AND y >= gy + ah + 4 AND y < gy + 2 * ah + 4 THEN what = 4
END SUB

' Is picker entry k the brush?
FUNCTION EditPkIsBrush(k)
    DIM v ' (its own: the main program shares these names)
    EditPkIsBrush = 0
    SELECT CASE edPkKind(k)
        CASE PK_GLYPH : EditPkIsBrush = (edPkVal$(k) = editGlyph$)
        CASE PK_TEX
            IF edSlotPick THEN ' (choosing a sector picture: the one it has now)
                SELECT CASE edSlotPick
                    CASE 1 TO 6 : EditPkIsBrush = (LCASE$(edPkVal$(k)) = LCASE$(lvlWall$(edSlotPick)))
                    CASE 7 TO 10 : EditPkIsBrush = (LCASE$(edPkVal$(k)) = LCASE$(lvlFloor$(edSlotPick - 6)))
                    CASE ELSE : EditPkIsBrush = (LCASE$(edPkVal$(k)) = LCASE$(lvlCeil$(edSlotPick - 10)))
                END SELECT
            ELSE
                EditPkIsBrush = (edBrushKind <> PK_LIQUID AND edPkVal$(k) = edBrushTex$)
            END IF
        CASE PK_LIQUID : EditPkIsBrush = (edBrushKind = PK_LIQUID AND edPkVal$(k) = edBrushLiq$)
        CASE PK_LIGHT
            v = VAL(MID$(edPkVal$(k), 2))
            IF LEFT$(edPkVal$(k), 1) = "F" THEN EditPkIsBrush = (v = edLFx) ELSE EditPkIsBrush = (EditPaletteRGB~&(v) = _RGB32(edLR, edLG, edLB))
    END SELECT
END FUNCTION

FUNCTION EditPkName$(k)
    SELECT CASE edPkKind(k)
        CASE PK_GLYPH : EditPkName$ = GlyphName$(edPkVal$(k))
        CASE PK_TEX : EditPkName$ = edPkVal$(k)
        CASE PK_LIQUID : EditPkName$ = LiquidBrushName$(edPkVal$(k))
        CASE PK_LIGHT
            IF LEFT$(edPkVal$(k), 1) = "F" THEN EditPkName$ = "light that's " + LCASE$(EditFxName$(VAL(MID$(edPkVal$(k), 2)))) ELSE EditPkName$ = "light colour" + MID$(edPkVal$(k), 2)
    END SELECT
END FUNCTION

' One entry's picture in the box at (x, y), n square: its thumbnail - or a
' light glowing its colour (pulsing, flickering as it will), or the start's
' arrow
SUB EditPkPicture(k, x, y, n)
    DIM a, ax, ay, cx, cy, t$, v ' (its own: the main program shares these names)
    IF edPkKind(k) = PK_LIQUID THEN ' A liquid: its picture and how deep - or DRAIN
        IF edPkImg&(k) < -1 THEN _PUTIMAGE (x, y)-STEP(n - 1, n - 1), edPkImg&(k)
        IF edPkVal$(k) = "-" THEN t$ = "DRAIN" ELSE t$ = MID$(edPkVal$(k), 2) + "/8"
        LINE (x + (n - TinyW(t$)) \ 2 - 2, y + n - 12)-STEP(TinyW(t$) + 3, 11), _RGBA32(0, 0, 0, 170), BF
        TinyText x + (n - TinyW(t$)) \ 2, y + n - 10, t$, _RGB32(255, 255, 255)
        EXIT SUB
    END IF
    IF edPkImg&(k) < -1 THEN _PUTIMAGE (x, y)-STEP(n - 1, n - 1), edPkImg&(k) : EXIT SUB
    cx = x + n \ 2 : cy = y + n \ 2
    IF edPkKind(k) = PK_LIGHT THEN
        v = VAL(MID$(edPkVal$(k), 2))
        IF LEFT$(edPkVal$(k), 1) = "F" THEN ' An effect: the brush's colour, going as it goes, and its name
            EditGlow x, y, n, _RGB32(edLR, edLG, edLB), EditFxNow(v)
            t$ = EditFxName$(v) : TinyText x + (n - TinyW(t$)) \ 2, y + n - 11, t$, _RGB32(255, 255, 255)
        ELSE
            EditGlow x, y, n, EditPaletteRGB~&(v), 1
        END IF
    ELSEIF edPkKind(k) = PK_GLYPH THEN
        a = (INSTR(">v<^", edPkVal$(k)) - 1) * 1.5708 ' (the start: an arrow the way it faces)
        IF a >= 0 THEN
            ax = COS(a) : ay = SIN(a) : h = n * 0.36
            LINE (cx - ax * h, cy - ay * h)-(cx + ax * h, cy + ay * h), _RGB32(255, 255, 255)
            LINE (cx + ax * h, cy + ay * h)-(cx + ax * h * 0.3 - ay * h * 0.5, cy + ay * h * 0.3 + ax * h * 0.5), _RGB32(255, 255, 255)
            LINE (cx + ax * h, cy + ay * h)-(cx + ax * h * 0.3 + ay * h * 0.5, cy + ay * h * 0.3 - ax * h * 0.5), _RGB32(255, 255, 255)
            TinyText cx - TinyW("START") \ 2, y + n - 11, "START", _RGB32(255, 255, 255)
        ELSE
            LINE (x + 4, y + 4)-STEP(n - 9, n - 9), GlyphColor~&(edPkVal$(k)), BF
        END IF
    END IF
END SUB

' The picker, drawn - the pointer at (mx, my)
SUB EditDrawPicker(mx, my)
    DIM ay, B, bh, bx, by, c, c~&, d, gx, gy, j, k, l$, r, sx, t, t$, tx, ty, w, x, y, bk ' (its own: the main program shares these names)
    EditPkBuild
    EditPkGeom gx, gy, cols, rows, sz
    IF editView = 1 THEN LINE (0, PK_Y - 4)-(scrW - 1, 599), _RGBA32(6, 2, 18, 215), BF : LINE (0, PK_Y - 5)-(scrW - 1, PK_Y - 5), _RGBA32(255, 60, 200, 160)
    EditPkHit mx, my, hw, hi
    FOR t = 1 TO PK_TABS ' The tabs
        EditPkTab t, tx, ty, w : t$ = EditPkTabName$(t)
        IF t = edPickTab THEN bg~& = _RGBA32(120, 20, 100, 240) ELSE bg~& = _RGBA32(20, 10, 40, 230)
        IF hw = 1 AND hi = t THEN bg~& = _RGBA32(40, 70, 110, 240)
        LINE (tx, ty)-STEP(w - 1, 17), bg~&, BF
        IF t = edPickTab THEN LINE (tx, ty)-STEP(w - 1, 17), _RGB32(255, 60, 200), B
        IF t = edPickTab THEN c~& = _RGB32(255, 255, 255) ELSE c~& = _RGB32(190, 180, 230)
        TinyText tx + (w - TinyW(t$)) \ 2, ty + 5, t$, c~&
    NEXT
    FOR r = 0 TO rows - 1 : FOR c = 0 TO cols - 1 ' The thumbnails
        k = (edPickScroll + r) * cols + c + 1
        x = gx + c * (sz + 4) : y = gy + r * (sz + 4)
        LINE (x, y)-STEP(sz - 1, sz - 1), _RGBA32(16, 12, 30, 240), BF
        IF k <= edPkN THEN
            EditPkPicture k, x + 2, y + 2, sz - 4
            IF EditPkIsBrush(k) THEN
                LINE (x, y)-STEP(sz - 1, sz - 1), _RGB32(255, 60, 200), B : LINE (x + 1, y + 1)-STEP(sz - 3, sz - 3), _RGB32(255, 60, 200), B
            ELSEIF hw = 2 AND hi = k THEN
                LINE (x, y)-STEP(sz - 1, sz - 1), _RGB32(150, 240, 255), B
            ELSE
                LINE (x, y)-STEP(sz - 1, sz - 1), _RGB32(60, 50, 90), B
            END IF
        ELSE
            LINE (x, y)-STEP(sz - 1, sz - 1), _RGB32(30, 26, 50), B
        END IF
    NEXT : NEXT
    ' The scroll arrows, and how far down the list this is
    sx = gx + cols * (sz + 4) : all = (edPkN + cols - 1) \ cols : ah = (rows * (sz + 4) - 4) \ 2
    FOR b = 0 TO 1
        by = gy + b * (ah + 4)
        IF hw = 3 + b THEN c~& = _RGBA32(40, 70, 110, 240) ELSE c~& = _RGBA32(20, 10, 40, 230)
        LINE (sx, by)-STEP(15, ah - 1), c~&, BF : LINE (sx, by)-STEP(15, ah - 1), _RGB32(90, 70, 140), B
        IF (b = 0 AND edPickScroll > 0) OR (b = 1 AND edPickScroll + rows < all) THEN c~& = _RGB32(255, 255, 255) ELSE c~& = _RGB32(70, 60, 100)
        ay = by + ah \ 2 : d = 1 - 2 * b
        LINE (sx + 3, ay + 3 * d)-(sx + 8, ay - 3 * d), c~& : LINE (sx + 8, ay - 3 * d)-(sx + 13, ay + 3 * d), c~&
    NEXT
    IF all > rows AND editView = 1 THEN ' (a bar: where these rows are in all of them)
        bh = rows * (sz + 4) - 4 : LINE (sx + 18, gy)-STEP(3, bh - 1), _RGBA32(60, 50, 90, 200), BF
        LINE (sx + 18, gy + bh * edPickScroll \ all)-STEP(3, bh * rows \ all - 1), _RGB32(255, 60, 200), BF
    END IF
    ' The brush - in 3D big, on the right; and what the pointer's over. The
    ' tool in use's: PAINT's picture (or liquid), LIGHT's light, else PLACE's
    bk = PK_GLYPH
    IF edTool = ET_PAINT THEN IF edBrushKind = PK_LIQUID THEN bk = PK_LIQUID ELSE bk = PK_TEX
    IF edTool = ET_LIGHT THEN bk = PK_LIGHT
    SELECT CASE bk
        CASE PK_TEX : n$ = edBrushTex$
        CASE PK_LIQUID : n$ = LiquidBrushName$(edBrushLiq$)
        CASE PK_LIGHT : n$ = "light: " + LCASE$(EditFxName$(edLFx)) + ", reach" + STR$(edLRad) + ", bright" + STR$(edLBri)
        CASE ELSE : n$ = GlyphName$(editGlyph$)
    END SELECT
    IF hw = 2 THEN h$ = EditPkName$(hi) ELSE h$ = "Click one: it's the brush" + MID$(" (and the selection's)", 1, -22 * (edSelN > 0))
    IF editView <> 1 THEN ' (the map from above: under the thumbnails, the brush - or what the pointer's over)
        IF hw = 2 THEN t$ = h$ ELSE t$ = n$
        TinyText ED_PALX, gy + rows * (sz + 4) + 6, LEFT$(t$, 48), _RGB32(150, 240, 255)
        EXIT SUB
    END IF
    bx = sx + 30
    TinyText bx, gy + 6, "BRUSH", _RGB32(255, 90, 200)
    LINE (bx, gy + 18)-STEP(67, 67), _RGBA32(16, 12, 30, 240), BF : LINE (bx, gy + 18)-STEP(67, 67), _RGB32(255, 60, 200), B
    SELECT CASE bk
        CASE PK_TEX
            IF edBrushImg& < -1 THEN _PUTIMAGE (bx + 2, gy + 20)-STEP(63, 63), edBrushImg&
        CASE PK_LIQUID
            k = 0 : FOR j = 1 TO edPkN : IF edPkKind(j) = PK_LIQUID AND edPkVal$(j) = edBrushLiq$ THEN k = j
            NEXT
            IF k THEN EditPkPicture k, bx + 2, gy + 20, 64
        CASE PK_LIGHT
            EditGlow bx + 2, gy + 20, 64, _RGB32(edLR, edLG, edLB), EditFxNow(edLFx)
        CASE ELSE ' (a map character: its picture, made again when the brush changes - [ ] or E too)
            STATIC thumbOf$, thumbImg&
            IF thumbOf$ <> editGlyph$ + STR$(artNow) + lvlWall$(1) THEN
                IF thumbImg& < -1 THEN _FREEIMAGE thumbImg&
                thumbImg& = EditGlyphThumb&(editGlyph$) : thumbOf$ = editGlyph$ + STR$(artNow) + lvlWall$(1)
            END IF
            IF thumbImg& < -1 THEN
                _PUTIMAGE (bx + 2, gy + 20)-STEP(63, 63), thumbImg&
            ELSE
                k = 0 : FOR j = 1 TO edPkN : IF edPkKind(j) = PK_GLYPH AND edPkVal$(j) = editGlyph$ THEN k = j
                NEXT
                IF k THEN EditPkPicture k, bx + 2, gy + 20, 64 ELSE LINE (bx + 6, gy + 24)-STEP(55, 55), GlyphColor~&(editGlyph$), BF
            END IF
    END SELECT
    tw = MaxOf(8, (EditPkRight - bx - 76) \ 5) ' (its name beside it, in lines that fit - small print, about 5 pixels a letter)
    ty = gy + 20
    DO WHILE LEN(n$) AND ty < gy + 80
        l$ = LEFT$(n$, tw) : TinyText bx + 76, ty, l$, _RGB32(255, 255, 255) : ty = ty + 10 : n$ = MID$(n$, tw + 1)
    LOOP
    TinyText PK_X, gy + 2 * (PK_SIZE + 4) + 6, LEFT$(h$, 160 + edWX \ 2), _RGB32(150, 240, 255)
END SUB

' --- THE PROPERTIES PANE: down the right of the 3D view, for what's
' selected - a door (what kind, which key), a teleporter's pad (where it
' goes - LINK it to another), a lift (how low, how high, how fast, how it
' goes) - or MAKE A LIFT of the floor selected. Rows of buttons (a TB-like
' list, made again each time it's asked: edPn...); id < 0 is just words.
SUB EditPaneAdd(id, x, y, w, l$, lit)
    IF edPnN >= PN_MAX THEN EXIT SUB
    edPnN = edPnN + 1 : edPnId(edPnN) = id : edPnX(edPnN) = x : edPnY(edPnN) = y : edPnW(edPnN) = w : edPnLab$(edPnN) = l$ : edPnLit(edPnN) = lit : edPnCol(edPnN) = 0 : edPnH(edPnN) = 0 : edPnImg&(edPnN) = 0
    IF y + 20 > edPnBot THEN edPnBot = y + 20
END SUB

' The pane: built (EditPaneLay) on the old 23-pixel rows, then packed for
' the small print - every row PN_SQ as far down, each button PN_BH tall
SUB EditPaneBuild
    DIM k ' (its own: the main program shares these names)
    EditPaneLay
    edPnBot = edPnY0 + 14
    FOR k = 1 TO edPnN
        edPnY(k) = edPnY0 + INT((edPnY(k) - edPnY0) * PN_SQ + 0.5) - 4
        IF edPnY(k) + PN_BH > edPnBot THEN edPnBot = edPnY(k) + PN_BH
        IF edPnY(k) + edPnH(k) > edPnBot THEN edPnBot = edPnY(k) + edPnH(k)
    NEXT
END SUB

SUB EditPaneLay
    DIM bi, c, c$, ev, f, j, k, kd, lt, mx, n, r, t, t$, ux, uy, w, x0, y, cx, cy, clB, clFx ' (its own: the main program shares these names)
    IF editView = 1 THEN edPnX0 = PN_X : edPnY0 = PN_Y ELSE edPnX0 = 380 : edPnY0 = 12
    edPnN = 0 : edPnTitle$ = "" : edPnBot = edPnY0 : edPnLift = 0 : edPnLight = 0 : edPnEvent = 0
    x0 = edPnX0 : y = edPnY0 + 24
    IF edVerPane THEN EditPaneVersions x0, y : EXIT SUB ' (VERSIONS: EDITOR/SESSION.BM)
    IF edSectorPane THEN ' The sector itself: its name, its light, its pictures
        edPnTitle$ = "THE SECTOR"
        IF edTyping THEN n$ = edTypeBuf$ + "_" ELSE n$ = SectorShort$
        EditPaneAdd -1, x0, y + 2, 140, LEFT$(n$, 17), 0
        IF edTyping THEN EditPaneAdd 100, x0 + 146, y, 54, "OK", -1 ELSE EditPaneAdd 100, x0 + 146, y, 54, "NAME", 0
        y = y + 24
        EditPaneAdd -1, x0, y + 2, 140, "LIGHT" + STR$(lvlAmb(1)), 0 : EditPaneAdd 101, x0 + 146, y, 24, "-", 0 : EditPaneAdd 102, x0 + 174, y, 24, "+", 0
        y = y + 24
        FOR c = 1 TO 12
            cl~& = EditPaletteRGB~&(c)
            EditPaneAdd 109 + c, x0 + ((c - 1) MOD 6) * 34, y + ((c - 1) \ 6) * 23, 30, "", (cl~& = _RGB32(lvlAmb(2), lvlAmb(3), lvlAmb(4)))
            edPnCol(edPnN) = cl~&
        NEXT
        y = y + 50
        n = lvlDroids : IF n < 0 THEN n = 3
        EditPaneAdd -1, x0, y + 2, 140, "DROIDS" + STR$(n), 0 : EditPaneAdd 270, x0 + 146, y, 24, "-", 0 : EditPaneAdd 271, x0 + 174, y, 24, "+", 0 : y = y + 24
        EditPaneAdd -1, x0, y + 2, 140, "GRAVITY" + STR$(lvlGravity) + "%", 0 : EditPaneAdd 286, x0 + 146, y, 24, "-", 0 : EditPaneAdd 287, x0 + 174, y, 24, "+", 0 : y = y + 24
        IF lvlWet < 0 THEN t$ = "WETNESS AUTO" ELSE t$ = "WETNESS" + STR$(lvlWet)
        EditPaneAdd -1, x0, y + 2, 140, t$, 0 : EditPaneAdd 300, x0 + 146, y, 24, "-", 0 : EditPaneAdd 301, x0 + 174, y, 24, "+", 0 : y = y + 24
        EditPaneAdd -1, x0, y + 2, 140, "ALL FLOORS", 0 : EditPaneAdd 272, x0 + 146, y, 24, "-", 0 : EditPaneAdd 273, x0 + 174, y, 24, "+", 0 : y = y + 24
        EditPaneAdd -1, x0, y + 2, 140, "ALL CEILINGS", 0 : EditPaneAdd 274, x0 + 146, y, 24, "-", 0 : EditPaneAdd 275, x0 + 174, y, 24, "+", 0 : y = y + 24
        EditPaneAdd -1, x0, y + 2, 140, "LOOT " + LootSetName$(edLootSet), 0 : EditPaneAdd 276, x0 + 146, y, 24, "<", 0 : EditPaneAdd 277, x0 + 174, y, 24, ">", 0 : y = y + 24
        IF edRoomW < 3 THEN edRoomW = 8 : edRoomH = 8
        EditPaneAdd -1, x0, y + 2, 140, "ROOM" + STR$(edRoomW) + " x" + STR$(edRoomH), 0 : EditPaneAdd 278, x0 + 146, y, 24, "-", 0 : EditPaneAdd 279, x0 + 174, y, 24, "+", 0 : y = y + 22
        EditPaneAdd -1, x0, y + 2, 140, "  (wide; Shift: deep)", 0 : y = y + 20
        EditPaneAdd 280, x0, y, PN_W, "MAKE THE MAP THIS ROOM", 0 : y = y + 26
        IF edMapWant < 16 THEN edMapWant = mapN
        EditPaneAdd -1, x0, y + 2, 140, "MAP SIZE" + STR$(edMapWant), 0 : EditPaneAdd 281, x0 + 146, y, 24, "-", 0 : EditPaneAdd 282, x0 + 174, y, 24, "+", 0 : y = y + 22
        IF edMapWant <> mapN THEN EditPaneAdd 283, x0, y, PN_W, "MAKE IT" + STR$(edMapWant) + " x" + STR$(edMapWant), -1 : y = y + 26 ELSE y = y + 6
        EditPaneAdd -1, x0, y, PN_W, "ITS PICTURES: CLICK ONE, THEN THE PICKER", 0
        y = y + 22
        FOR k = 1 TO 12 ' (under a heading each: WALLS, FLOORS, CEILINGS - so a slot says what it's for, whatever picture it has)
            SELECT CASE k
                CASE 1 : EditPaneAdd -1, x0, y, PN_W, "WALLS (# N C K P G)", 0 : y = y + 18
                CASE 7 : EditPaneAdd -1, x0, y, PN_W, "FLOORS", 0 : y = y + 18
                CASE 11 : EditPaneAdd -1, x0, y, PN_W, "CEILINGS", 0 : y = y + 18
            END SELECT
            SELECT CASE k
                CASE 1 TO 6 : t$ = MID$("#NCKPG", k, 1) + " " + EditPicShort$(lvlWall$(k))
                CASE 7 TO 10 : t$ = LTRIM$(STR$(k - 6)) + " " + EditPicShort$(lvlFloor$(k - 6))
                CASE ELSE : t$ = LTRIM$(STR$(k - 10)) + " " + EditPicShort$(lvlCeil$(k - 10))
            END SELECT
            EditPaneAdd 129 + k, x0 + ((k - 1) MOD 2) * 101, y, 99, LEFT$(t$, 24), (edSlotPick = k)
            IF k MOD 2 = 0 THEN y = y + 23
        NEXT
        EXIT SUB
    END IF
    IF edSelN = 0 THEN ' (nothing selected: no pane - nor typing into one that's gone)
        edTrigPane = 0 : edEvPane = 0 : edCellLtPane = 0 : IF edTypeFor = 2 THEN edTyping = 0
        EXIT SUB
    END IF
    IF edCellLtPane THEN ' The selection's cells' own light: an ambient light of their own, not the sector's
        cx = edSelX(1) : cy = edSelY(1) : n = 0
        FOR k = 1 TO edSelN : IF EditCellLightOK(edSelX(k), edSelY(k)) THEN n = n + 1
        NEXT
        edPnTitle$ = "CELL LIGHT (" + LTRIM$(STR$(n)) + " cell" + MID$("s", 1, -(n <> 1)) + ")"
        IF lvlCLBright(cx, cy) < 0 THEN
            EditPaneAdd -1, x0, y + 2, PN_W, "THE SECTOR'S LIGHT", 0 : y = y + 22
            EditPaneAdd -1, x0, y + 2, PN_W, "(- + or a colour: its own)", 0 : y = y + 24
            clB = lvlAmb(1) : cl~& = _RGB32(lvlAmb(2), lvlAmb(3), lvlAmb(4)) : clFx = 0
        ELSE
            clB = lvlCLBright(cx, cy) : cl~& = lvlCLCol(cx, cy) : clFx = lvlCLFx(cx, cy)
            EditPaneAdd 221, x0, y, PN_W, "BACK TO THE SECTOR'S", 0 : y = y + 24
        END IF
        EditPaneAdd -1, x0, y + 2, 140, "LIGHT" + STR$(clB), 0 : EditPaneAdd 222, x0 + 146, y, 24, "-", 0 : EditPaneAdd 223, x0 + 174, y, 24, "+", 0
        y = y + 24
        FOR c = 1 TO 12
            ccl~& = EditPaletteRGB~&(c)
            EditPaneAdd 229 + c, x0 + ((c - 1) MOD 6) * 34, y + ((c - 1) \ 6) * 23, 30, "", (ccl~& = cl~& AND lvlCLBright(cx, cy) >= 0)
            edPnCol(edPnN) = ccl~&
        NEXT
        y = y + 50
        EditPaneAdd 224, x0, y, PN_W, "EFFECT: " + RTRIM$(MID$("STEADY  FLICKER PULSE   STROBE  FIRE    DYING   ", clFx * 8 + 1, 8)), clFx > 0 : y = y + 23
        EditPaneAdd 225, x0, y, PN_W, "BACK", 0
        EXIT SUB
    END IF
    IF edTrigPane THEN ' The selection's triggers - and a new one
        EditTrigPlace tx0, ty0, tx1, ty1, ux, uy
        edPnTitle$ = "TRIGGERS" + STR$(tx0) + "," + LTRIM$(STR$(ty0)) + MID$(" +", 1, -2 * (tx1 > tx0 OR ty1 > ty0))
        n = 0
        FOR k = 1 TO lvlNumTrigs
            IF n < 6 AND EditTrigHere(lvlTrig$(k), tx0, ty0, tx1, ty1, ux, uy) THEN
                n = n + 1 : edTrigIdx(n) = k
                EditPaneAdd -1, x0, y + 2, 172, LEFT$(lvlTrig$(k), 21), 0 : EditPaneAdd 179 + n, x0 + 176, y, 24, "x", 0
                y = y + 22
            END IF
        NEXT
        IF n = 0 THEN EditPaneAdd -1, x0, y + 2, PN_W, "none here yet", 0 : y = y + 22
        y = y + 4
        FOR w = 1 TO 6 ' (HACK: a computer there hacked - GAME/SECURE.BM; ALARM: an alarm switch there - or any - set off, GAME/ALARMS.BM)
            IF w = 5 THEN id = 265 ELSE IF w = 6 THEN id = 269 ELSE id = 170 + w
            EditPaneAdd id, x0 + ((w - 1) MOD 3) * 67, y + ((w - 1) \ 3) * 23, 64, RTRIM$(MID$("ENTERUSE  CLEARTIME HACK ALARM", w * 5 - 4, 5)), (edTrigWhen = w)
        NEXT
        y = y + 23
        y = y + 23
        IF edTrigWhen = 4 THEN
            EditPaneAdd -1, x0, y + 2, 140, "AFTER" + STR$(edTrigTime) + "s", 0 : EditPaneAdd 178, x0 + 146, y, 24, "-", 0 : EditPaneAdd 179, x0 + 174, y, 24, "+", 0
        ELSE
            IF edTrigRepeat THEN t$ = "EVERY TIME" ELSE t$ = "JUST ONCE"
            EditPaneAdd 175, x0, y, PN_W, t$, edTrigRepeat
        END IF
        y = y + 23
        IF edTyping AND edTypeFor = 2 THEN n$ = edTypeBuf$ + "_" ELSE n$ = edTrigCmd$ : IF n$ = "" THEN n$ = "(its commands)"
        EditPaneAdd -1, x0, y + 2, PN_W, LEFT$(RIGHT$(n$, 25), 25), 0 : y = y + 20
        FOR q = 1 TO 9 ' (actions to add to its commands with a click)
            EditPaneAdd 190 + q, x0 + ((q - 1) MOD 3) * 67, y + ((q - 1) \ 3) * 23, 65, TrigAction$(q, 0), 0
        NEXT
        y = y + 70
        IF edTyping AND edTypeFor = 2 THEN t$ = "OK" ELSE t$ = "TYPE"
        EditPaneAdd 176, x0, y, 99, t$, (edTyping AND edTypeFor = 2) : EditPaneAdd 177, x0 + 101, y, 99, "ADD IT", 0
        y = y + 23
        EditPaneAdd 190, x0, y, PN_W, "BACK", 0
        EXIT SUB
    END IF
    IF editView = 1 AND edTool = ET_PAINT AND edSelN > 0 THEN EditPanePicture x0, y : EXIT SUB ' (PAINT: the selected faces' pictures - slid, stretched)
    ' A door: the first selected face that's a door's
    FOR k = 1 TO edSelN
        c$ = MID$(lvlRow$(edSelY(k)), edSelX(k) + 1, 1)
        IF (edSelKind(k) = ED_WALL OR editView = 0) AND INSTR("DHXRBY!E", c$) THEN ' (from above, a cell's selected whole)
            edPnCX = edSelX(k) : edPnCY = edSelY(k)
            edPnTitle$ = "DOOR" + STR$(edPnCX) + "," + LTRIM$(STR$(edPnCY))
            EditPaneAdd -1, x0, y, PN_W, LEFT$(GlyphName$(c$), 25), 0 : y = y + 22
            FOR t = 1 TO 8
                g$ = MID$("DHX!RBYE", t, 1)
                EditPaneAdd t, x0 + ((t - 1) MOD 2) * 101, y + ((t - 1) \ 2) * 23, 99, RTRIM$(MID$("SLIDING SHUTTER SPLIT   SEALED  RED KEY BLUE KEYYELLOW  EXIT    ", t * 8 - 7, 8)), (g$ = c$)
            NEXT
            EditPaneAdd 170, x0, y + 96, PN_W, "TRIGGERS...", 0
            IF c$ <> "E" THEN ' (a door's own: kicked down - a stronghold door - and a keypad's code)
                n = VAL(EditXtra$("doors", edPnCX, edPnCY, 3))
                EditPaneAdd -1, x0, y + 121, 140, "KICKS" + STR$(n) + MID$(" (NONE)", 1, -7 * (n = 0)), 0 : EditPaneAdd 254, x0 + 146, y + 119, 24, "-", 0 : EditPaneAdd 255, x0 + 174, y + 119, 24, "+", 0
                IF edTyping AND edTypeFor = 3 THEN t$ = edTypeBuf$ + "_" ELSE t$ = EditXtra$("doors", edPnCX, edPnCY, 4) : IF t$ = "" THEN t$ = "NONE"
                EditPaneAdd -1, x0, y + 144, PN_W, "KEYPAD CODE: " + t$, 0
                IF edTyping AND edTypeFor = 3 THEN t$ = "OK" ELSE t$ = "TYPE"
                EditPaneAdd 256, x0, y + 165, 64, t$, (edTyping AND edTypeFor = 3) : EditPaneAdd 257, x0 + 67, y + 165, 64, "RANDOM", 0 : EditPaneAdd 258, x0 + 134, y + 165, 64, "NONE", 0
                IF editView = 1 THEN EditPaneAdd 511, x0, y + 190, PN_W, EditHoldLabel$(edPnCX, edPnCY), (edHeld(edPnCX, edPnCY) = 1) ' (open it, to paint its edges and track)
            END IF
            EXIT SUB
        END IF
    NEXT
    ' A teleporter's pad
    FOR k = 1 TO edSelN
        IF MID$(lvlRow$(edSelY(k)), edSelX(k) + 1, 1) = "&" THEN
            edPnCX = edSelX(k) : edPnCY = edSelY(k) : me = 0
            FOR j = 1 TO numPads : IF padX(j) = edPnCX AND padY(j) = edPnCY THEN me = j
            NEXT
            edPnTitle$ = "TELEPORTER" + STR$(edPnCX) + "," + LTRIM$(STR$(edPnCY))
            IF me MOD 2 = 1 THEN other = me + 1 ELSE other = me - 1
            IF me = 0 OR other < 1 OR other > numPads THEN t$ = "goes nowhere yet" ELSE t$ = "goes to" + STR$(padX(other)) + "," + LTRIM$(STR$(padY(other)))
            EditPaneAdd -1, x0, y, PN_W, t$, 0 : y = y + 22
            EditPaneAdd 30, x0, y, 99, "LINK...", edLinkPad
            hand = 0 : FOR j = 1 TO lvlNumPairs
                IF (lvlPair(j, 1) = edPnCX AND lvlPair(j, 2) = edPnCY) OR (lvlPair(j, 3) = edPnCX AND lvlPair(j, 4) = edPnCY) THEN hand = -1
            NEXT
            IF hand THEN EditPaneAdd 31, x0 + 101, y, 99, "UNLINK", 0
            IF edLinkPad THEN EditPaneAdd -1, x0, y + 24, PN_W, "now click the pad it goes to", 0
            EXIT SUB
        END IF
    NEXT
    ' A light: the first selected face with one on it - its colour, how it
    ' goes, how far it reaches, how bright
    FOR k = 1 TO edSelN
        lt = EditFaceLight(edSelKind(k), edSelX(k), edSelY(k), edSelSide(k))
        IF lt THEN
            edPnLight = lt : edPnTitle$ = "LIGHT on " + EditKindName$(edSelKind(k))
            FOR c = 1 TO 12
                cl~& = EditPaletteRGB~&(c)
                EditPaneAdd 40 + c, x0 + ((c - 1) MOD 6) * 34, y + ((c - 1) \ 6) * 23, 30, "", (cl~& = _RGB32(lvlLight(lt, 5), lvlLight(lt, 6), lvlLight(lt, 7)))
                edPnCol(edPnN) = cl~&
            NEXT
            y = y + 50
            FOR f = 0 TO 5
                EditPaneAdd 60 + f, x0 + (f MOD 3) * 67, y + (f \ 3) * 23, 65, EditFxName$(f), (lvlLight(lt, 8) = f)
            NEXT
            y = y + 50
            EditPaneAdd -1, x0, y + 2, 140, "REACH " + LTRIM$(STR$(lvlLight(lt, 3))), 0 : EditPaneAdd 70, x0 + 146, y, 24, "-", 0 : EditPaneAdd 71, x0 + 174, y, 24, "+", 0 : y = y + 23
            EditPaneAdd -1, x0, y + 2, 140, "BRIGHT" + STR$(lvlLight(lt, 4)), 0 : EditPaneAdd 72, x0 + 146, y, 24, "-", 0 : EditPaneAdd 73, x0 + 174, y, 24, "+", 0 : y = y + 23
            IF lvlLight(lt, 9) THEN lmp$ = "CEILING LAMP: OFF" ELSE lmp$ = "CEILING LAMP: ON"
            EditPaneAdd 75, x0, y, PN_W, lmp$, (lvlLight(lt, 9) = 0) : y = y + 23 ' (a lit light hangs a lamp picture on its cell's ceiling - or doesn't)
            EditPaneAdd 74, x0, y, PN_W, "REMOVE THE LIGHT", 0 : y = y + 23
            EditPaneNudge x0, y ' (a decoration under the light: still moved about from here)
            EditPaneFuel x0, y ' (a jetpack or fuel can under it: its fuel, from here too)
            EditPaneLiquid x0, y ' (a pool under it: how see-through)
            EditPaneWet x0, y ' (its floor: how wet it looks)
            EXIT SUB
        END IF
    NEXT
    ' A box: the first selected side of one - pushed in or pulled out an
    ' eighth at a time (every selected box side), the wall it looks like,
    ' or taken away
    FOR k = 1 TO edSelN
        IF edSelKind(k) = ED_BOX THEN
            bi = EditBoxIndex(edSelX(k), edSelY(k))
            IF bi THEN
                edPnTitle$ = "BLOCK" + STR$(edSelX(k)) + "," + LTRIM$(STR$(edSelY(k))) + ", " + MID$("ESWN", edSelSide(k), 1) + " side"
                EditPaneAdd -1, x0, y, PN_W, "x" + STR$(lvlBox(bi, 3)) + "-" + LTRIM$(STR$(lvlBox(bi, 5))) + ", y" + STR$(lvlBox(bi, 4)) + "-" + LTRIM$(STR$(lvlBox(bi, 6))) + " eighths", 0 : y = y + 22
                EditPaneAdd 200, x0, y, 99, "PUSH IN", 0 : EditPaneAdd 201, x0 + 101, y, 99, "PULL OUT", 0 : y = y + 23
                EditPaneAdd -1, x0, y + 2, PN_W, "LOOKS LIKE THE WALL:", 0 : y = y + 20
                FOR w = 1 TO 6
                    EditPaneAdd 209 + w, x0 + (w - 1) * 34, y, 30, MID$("#NCKPG", w, 1), (lvlBox(bi, 7) = w)
                NEXT
                y = y + 23
                EditPaneAdd 202, x0, y, PN_W, "REMOVE THE BLOCK", 0 : y = y + 23
                EditPaneAdd 40, x0, y, PN_W, "ADD A LIGHT TO IT", 0
                EXIT SUB
            END IF
        END IF
    NEXT
    ' A monster: the first selected cell with one in it - how far it sees and
    ' hears, how tough and quick, what wakes it
    FOR k = 1 TO edSelN
        c$ = MID$(lvlRow$(edSelY(k)), edSelX(k) + 1, 1)
        IF MonOfChar(c$) THEN
            edPnCX = edSelX(k) : edPnCY = edSelY(k)
            EditMonGet edPnCX, edPnCY, ms, mh, mhp, msp, mw, mwp, mtr, mej, mst
            edPnTitle$ = UCASE$(GlyphName$(c$)) + STR$(edPnCX) + "," + LTRIM$(STR$(edPnCY))
            FOR r = 0 TO 3
                SELECT CASE r
                    CASE 0 : t$ = "SIGHT  " + LTRIM$(STR$(ms)) + " cells"
                    CASE 1 : IF mh = 0 THEN t$ = "HEARING  deaf" ELSE t$ = "HEARING" + STR$(mh) + " cells"
                    CASE 2 : t$ = "HEALTH " + LTRIM$(STR$(mhp)) + "%"
                    CASE 3 : t$ = "SPEED  " + LTRIM$(STR$(msp)) + "%"
                END SELECT
                EditPaneAdd -1, x0, y + 2, 140, t$, 0 : EditPaneAdd 80 + r * 2, x0 + 146, y, 24, "-", 0 : EditPaneAdd 81 + r * 2, x0 + 174, y, 24, "+", 0
                y = y + 23
            NEXT
            IF MonOfChar(c$) = MT_TURRET THEN ' (a turret: what it fires)
                EditPaneAdd -1, x0, y + 2, 140, "WEAPON  " + TurretWeaponName$(mwp), 0 : EditPaneAdd 95, x0 + 146, y, 24, "<", 0 : EditPaneAdd 96, x0 + 174, y, 24, ">", 0
                y = y + 23
                t$ = "TRACKING" + STR$(TURRET_TRACK) : IF mtr THEN t$ = "TRACKING" + STR$(mtr)
                EditPaneAdd -1, x0, y + 2, 140, t$ + " deg/s", 0 : EditPaneAdd 97, x0 + 146, y, 24, "-", 0 : EditPaneAdd 98, x0 + 174, y, 24, "+", 0
                y = y + 23
                t$ = "EJECT" + STR$(TURRET_EJECT) : IF mej THEN t$ = "EJECT" + STR$(mej)
                EditPaneAdd -1, x0, y + 2, 140, t$ + " frames", 0 : EditPaneAdd 242, x0 + 146, y, 24, "-", 0 : EditPaneAdd 243, x0 + 174, y, 24, "+", 0
                y = y + 23
                EditPaneAdd 244, x0, y, PN_W, "STARTS " + RTRIM$(MID$("OUT WHEN IT WAKESFOLDED AWAY     OUT              ", mst * 17 + 1, 17)), 0
                y = y + 23
            END IF
            EditPaneAdd -1, x0, y + 2, PN_W, "WAKES WHEN:", 0 : y = y + 20
            FOR w = 0 TO 3
                EditPaneAdd 90 + w, x0 + (w MOD 2) * 101, y + (w \ 2) * 23, 99, RTRIM$(MID$("IT SEES YOUYOU'RE NEARIT'S HIT   HUNTING    ", w * 11 + 1, 11)), (mw = w)
            NEXT
            y = y + 48
            EditPaneSkill x0, y
            EditPaneLook x0, y
            EditPaneAdd 94, x0, y, PN_W, "AS ITS KIND IS", 0
            EXIT SUB
        END IF
    NEXT
    ' An event room: the first selected cell inside one - its kind, its two
    ' numbers (as that kind means them), its reward
    FOR k = 1 TO edSelN
        ev = EditEventAt(edSelX(k), edSelY(k))
        IF ev AND edEvPane THEN
            edPnEvent = ev : kd = lvlEvent(ev, 1)
            edPnTitle$ = "EVENT: " + EvKindName$(kd)
            EditPaneAdd -1, x0, y, PN_W, "room" + STR$(lvlEvent(ev, 2)) + "," + LTRIM$(STR$(lvlEvent(ev, 3))) + " to" + STR$(lvlEvent(ev, 4)) + "," + LTRIM$(STR$(lvlEvent(ev, 5))), 0 : y = y + 22
            FOR t = 1 TO EV_KINDS
                EditPaneAdd 149 + t, x0 + ((t - 1) MOD 3) * 67, y + ((t - 1) \ 3) * 23, 65, LEFT$(EvKindName$(t), 8), (t = kd)
            NEXT
            y = y + ((EV_KINDS + 2) \ 3) * 23 + 4
            FOR w = 1 TO 2
                EvField kd, w, lab$, unit, stp, mn, mx
                IF unit >= 0 THEN
                    EditPaneAdd -1, x0, y + 2, 140, LEFT$(lab$ + " " + EvValue$(unit, lvlEvent(ev, 5 + w)), 17), 0
                    EditPaneAdd 248 + w * 2, x0 + 146, y, 24, "-", 0 : EditPaneAdd 249 + w * 2, x0 + 174, y, 24, "+", 0
                    y = y + 23
                END IF
            NEXT
            IF kd <= 4 THEN
                EditPaneAdd -1, x0, y + 2, 140, LEFT$("PRIZE " + RewardName$(lvlEvent(ev, 8)), 17), 0
                EditPaneAdd 166, x0 + 146, y, 24, "-", 0 : EditPaneAdd 167, x0 + 174, y, 24, "+", 0
                y = y + 23
            END IF
            EditPaneAdd 168, x0, y, PN_W, "REMOVE THE EVENT", 0 : y = y + 23
            EditPaneAdd 189, x0, y, PN_W, "BACK", 0
            EXIT SUB
        END IF
    NEXT
    ' A lift: the first selected floor that's on one
    FOR k = 1 TO edSelN
        IF (edSelKind(k) = ED_FLOOR OR edSelKind(k) = ED_STEP) AND liftCell(edSelX(k), edSelY(k)) THEN
            lf = liftCell(edSelX(k), edSelY(k)) : edPnLift = lf
            edPnTitle$ = "LIFT" + STR$(lf)
            EditPaneAdd -1, x0, y, PN_W, LTRIM$(STR$(lvlLift(lf, 1))) + "," + LTRIM$(STR$(lvlLift(lf, 2))) + " to" + STR$(lvlLift(lf, 3)) + "," + LTRIM$(STR$(lvlLift(lf, 4))), 0 : y = y + 24
            FOR r = 0 TO 2
                SELECT CASE r
                    CASE 0 : t$ = "LOW  " + STR$(lvlLift(lf, 5)) + " /8" : IF lvlLift(lf, 7) >= LIFT_CRUSHER THEN t$ = "DOWN TO" + STR$(lvlLift(lf, 5)) + " /8"
                    CASE 1 : t$ = "HIGH " + STR$(lvlLift(lf, 6)) + " /8" : IF lvlLift(lf, 7) >= LIFT_CRUSHER THEN t$ = "UP TO" + STR$(lvlLift(lf, 6)) + " /8"
                    CASE 2 : t$ = "SPEED" + STR$(lvlLift(lf, 8)) + " /8 s"
                END SELECT
                EditPaneAdd -1, x0, y + 2, 140, t$, 0
                EditPaneAdd 21 + r * 2, x0 + 146, y, 24, "-", 0 : EditPaneAdd 22 + r * 2, x0 + 174, y, 24, "+", 0
                y = y + 23
            NEXT
            SELECT CASE lvlLift(lf, 7)
                CASE 2 : t$ = "ELEVATOR"
                CASE 3 : t$ = "ON A TRIGGER"
                CASE LIFT_CRUSHER : t$ = "CRUSHER"
                CASE LIFT_SMASHER : t$ = "SMASHER"
                CASE ELSE : t$ = "UP AND DOWN"
            END SELECT
            EditPaneAdd 27, x0, y, 130, t$, 0 : EditPaneAdd 28, x0 + 134, y, 66, "REMOVE", 0
            edPnCX = edSelX(k) : edPnCY = edSelY(k)
            IF editView = 1 THEN EditPaneAdd 511, x0, y + 25, PN_W, EditHoldLabel$(edPnCX, edPnCY), (edHeld(liftX0(lf), liftY0(lf)) <> 0) ' (held up or down, to paint it there)
            EXIT SUB
        END IF
    NEXT
    ' Floor, not a lift yet
    n = 0
    FOR k = 1 TO edSelN ' (cells: a floor's pieces count once)
        IF edSelKind(k) = ED_FLOOR THEN
            IF EditCellOpen(edSelX(k), edSelY(k)) THEN
                n = n + 1
                FOR j = 1 TO k - 1 : IF edSelKind(j) = ED_FLOOR AND edSelX(j) = edSelX(k) AND edSelY(j) = edSelY(k) THEN n = n - 1 : EXIT FOR
                NEXT
            END IF
        END IF
    NEXT
    IF n THEN
        edPnTitle$ = "FLOOR (" + LTRIM$(STR$(n)) + " cell" + MID$("s", 1, -(n > 1)) + ")"
        EditPaneAdd 20, x0, y, PN_W, "MAKE A LIFT OF IT", 0 : y = y + 23
        inEv = 0 : FOR k = 1 TO edSelN : IF inEv = 0 THEN inEv = EditEventAt(edSelX(k), edSelY(k))
        NEXT
        IF inEv THEN
            EditPaneAdd 169, x0, y, PN_W, LEFT$("EVENT ROOM: " + EvKindName$(lvlEvent(inEv, 1)) + "...", 25), 0 : y = y + 23
        ELSEIF lvlNumEvents < MAX_EVENTS THEN
            EditPaneAdd 169, x0, y, PN_W, "MAKE AN EVENT ROOM", 0 : y = y + 23
        END IF
        EditPaneAdd 204, x0, y, PN_W, "ADD A PILLAR", 0 : y = y + 23
        EditPaneAdd 220, x0, y, PN_W, "CELL LIGHT...", 0 : y = y + 23
        EditPaneNudge x0, y
        EditPaneFuel x0, y
        EditPaneLiquid x0, y
        EditPaneWet x0, y
        EditPaneSkill x0, y
        EditPaneLook x0, y
    ELSE
        edPnTitle$ = EditKindName$(edSelKind(1)) + " (" + LTRIM$(STR$(edSelN)) + ")"
        wb = 0 : FOR k = 1 TO edSelN
            IF edSelKind(k) = ED_WALL THEN IF INSTR("#NCKPG", MID$(lvlRow$(edSelY(k)), edSelX(k) + 1, 1)) THEN wb = -1
        NEXT
        IF wb THEN EditPaneAdd 203, x0, y, PN_W, "MAKE IT A BLOCK", 0 : y = y + 23
        EditPaneLook x0, y ' (a pane of glass or bars)
    END IF
    EditPaneAdd 40, x0, y, PN_W, "ADD A LIGHT TO IT", 0
    EditPaneAdd 170, x0, y + 23, PN_W, "TRIGGERS...", 0
END SUB

' Something placed in a cell selected (a pickup, a monster, a decoration, a
' thing): which DIFFICULTIES it's in - four toggles, its [difficulty] line
' (none: every one). GAME/SKILL.BM plays it.
SUB EditPaneSkill(x0, y)
    DIM m, s, sk ' (its own: the main program shares these names)
    sk = EditSkillCell : IF sk = 0 THEN EXIT SUB
    m = SkillMask(edSelX(sk), edSelY(sk)) : IF m < 0 THEN m = 15
    EditPaneAdd -1, x0, y + 2, PN_W, "IN DIFFICULTY:", 0 : y = y + 20
    FOR s = 0 TO 3
        EditPaneAdd 310 + s, x0 + (s MOD 2) * 92, y + (s \ 2) * 23, 90 + (s MOD 2) * 18, MID$("[ ][x]", 1 - 3 * ((m AND SkillBit(s)) <> 0), 3) + " " + SkillName$(s), (m AND SkillBit(s)) <> 0
    NEXT
    y = y + 48
END SUB

' Something placed in a cell selected, or a pane of glass or bars: ITS
' LOOK - tinted (NONE TINT WASH GLOW, as a face's picture is), how much, its
' colour, and its size - its [looks] line (LEVEL/THINGS.BM)
SUB EditPaneLook(x0, y)
    DIM a, c, k, m, sz, c~&, t$ ' (its own: the main program shares these names)
    k = EditLookCell : IF k = 0 THEN EXIT SUB
    EditLookGet edSelX(k), edSelY(k), m, a, c~&, sz
    EditPaneAdd -1, x0, y + 2, PN_W, "ITS LOOK:", 0 : y = y + 20
    FOR c = 0 TO 3 : EditPaneAdd 376 + c, x0 + c * 50, y, 48, EditTintName$(c), (m = c) : NEXT : y = y + 23
    IF m THEN
        EditPaneAdd -1, x0, y + 2, 140, "AMOUNT" + STR$(a) + "%", 0 : EditPaneAdd 380, x0 + 146, y, 24, "-", 0 : EditPaneAdd 381, x0 + 174, y, 24, "+", 0 : y = y + 23
        FOR c = 1 TO 12 ' (quick colours: the lights' - and any colour, typed)
            EditPaneAdd 383 + c, x0 + ((c - 1) MOD 6) * 34, y + ((c - 1) \ 6) * 23, 30, "", ((EditPaletteRGB~&(c) AND &HFFFFFF) = c~&) : edPnCol(edPnN) = EditPaletteRGB~&(c)
        NEXT
        y = y + 46
        IF edTyping AND edTypeFor = 8 THEN t$ = edTypeBuf$ + "_" ELSE t$ = RIGHT$("00000" + HEX$(c~&), 6)
        EditPaneAdd -1, x0, y + 2, 70, "COLOUR " + t$, 0
        EditPaneAdd 397, x0 + 100, y, 30, "", 0 : edPnCol(edPnN) = _RGB32((c~& \ 65536) AND 255, (c~& \ 256) AND 255, c~& AND 255)
        IF edTyping AND edTypeFor = 8 THEN t$ = "OK" ELSE t$ = "TYPE"
        EditPaneAdd 396, x0 + 134, y, 64, t$, (edTyping AND edTypeFor = 8) : y = y + 23
    END IF
    EditPaneAdd -1, x0, y + 2, 140, "SIZE" + STR$(sz) + "%", 0 : EditPaneAdd 382, x0 + 146, y, 24, "-", 0 : EditPaneAdd 383, x0 + 174, y, 24, "+", 0 : y = y + 23
END SUB

' The first selected cell that can have a look: something placed in it, or
' a pane of glass or bars (0: none)
FUNCTION EditLookCell
    DIM k ' (its own: the main program shares these names)
    FOR k = 1 TO edSelN
        IF EditLookable(edSelX(k), edSelY(k)) THEN EditLookCell = k : EXIT FUNCTION
    NEXT
END FUNCTION

FUNCTION EditLookable(x, y)
    EditLookable = EditPlaced(x, y) OR INSTR("=-", MID$(lvlRow$(y), x + 1, 1)) > 0
END FUNCTION

' Cell x, y's [looks] line: tint, amount, colour, size (none: no tint, 60%,
' cyan, 100%)
SUB EditLookGet(x, y, m, a, c~&, sz)
    DIM k ' (its own: the main program shares these names)
    m = 0 : a = 60 : c~& = &H00FFCC : sz = 100
    k = XtraFind("looks", x, y, 0) : IF k = 0 THEN EXIT SUB
    m = VAL(XtraField$(k, 3)) : a = VAL(XtraField$(k, 4)) : sz = VAL(XtraField$(k, 6)) : IF sz <= 0 THEN sz = 100
    IF LEN(XtraField$(k, 5)) THEN c~& = PcHex~&(RIGHT$("000000" + XtraField$(k, 5), 6)) AND &HFFFFFF
END SUB

SUB EditLookPut(x, y, m, a, c~&, sz)
    IF m = 0 AND sz = 100 THEN XtraSet "looks", x, y, "" : EXIT SUB
    XtraSet "looks", x, y, LTRIM$(STR$(m)) + ", " + LTRIM$(STR$(a)) + ", " + RIGHT$("00000" + HEX$(c~& AND &HFFFFFF), 6) + ", " + LTRIM$(STR$(sz))
END SUB

' ITS LOOK changed on everything selected that can have one: op 1 the tint
' (v), 2 its amount by v, 3 its colour (v), 4 its size by v - choosing an
' amount or colour on something not tinted tints it
SUB EditLookOp(op, v&)
    DIM a, j, k, m, n, sz, x, y, c~&, dup ' (its own: the main program shares these names)
    EditPushUndo : n = 0
    FOR k = 1 TO edSelN
        x = edSelX(k) : y = edSelY(k) : dup = 0
        FOR j = 1 TO k - 1 : IF edSelX(j) = x AND edSelY(j) = y THEN dup = -1
        NEXT
        IF EditLookable(x, y) AND NOT dup THEN
            EditLookGet x, y, m, a, c~&, sz
            SELECT CASE op
                CASE 1 : m = v&
                CASE 2 : a = MinOf(100, MaxOf(0, a + v&)) : IF m = 0 THEN m = 1
                CASE 3 : c~& = v& AND &HFFFFFF : IF m = 0 THEN m = 1
                CASE 4 : sz = MinOf(400, MaxOf(10, sz + v&))
            END SELECT
            EditLookPut x, y, m, a, c~&, sz : n = n + 1
        END IF
    NEXT
    EditApply
    IF n THEN EditNote "Its look:" + STR$(n) + " changed"
END SUB

' The first selected cell with something placed in it (0: none)
FUNCTION EditSkillCell
    DIM k ' (its own: the main program shares these names)
    FOR k = 1 TO edSelN
        IF EditPlaced(edSelX(k), edSelY(k)) THEN EditSkillCell = k : EXIT FUNCTION
    NEXT
END FUNCTION

' Is there something placed in cell x, y - a pickup, a monster, a
' decoration, a thing - that a difficulty could leave out?
FUNCTION EditPlaced(x, y)
    EditPlaced = INSTR(ItemChars$ + DecoChars$ + CHR$(34) + MonChars$, MID$(lvlRow$(y), x + 1, 1)) > 0
END FUNCTION

' A decoration on a floor selected: the pane's row that moves it about its
' cell, an eighth at a time (and y down past it)
SUB EditPaneNudge(x0, y)
    DIM k, ndx, ndy ' (its own: the main program shares these names)
    dk = 0
    FOR k = 1 TO edSelN
        IF edSelKind(k) = ED_FLOOR AND dk = 0 THEN IF INSTR(DecoChars$ + CHR$(34), MID$(lvlRow$(edSelY(k)), edSelX(k) + 1, 1)) THEN dk = k
    NEXT
    IF dk = 0 THEN EXIT SUB
    EditNudgeGet edSelX(dk), edSelY(dk), ndx, ndy, nfc
    EditPaneAdd -1, x0, y + 2, 98, "MOVE IT" + STR$(ndx) + "," + LTRIM$(STR$(ndy)), 0
    EditPaneAdd 205, x0 + 98, y, 24, "<", 0 : EditPaneAdd 206, x0 + 124, y, 24, ">", 0 : EditPaneAdd 207, x0 + 150, y, 24, "^", 0 : EditPaneAdd 208, x0 + 176, y, 24, "v", 0
    y = y + 23
    EditPaneAdd 209, x0, y, PN_W, RTRIM$(MID$("AS BUILT            STANDS, FACING EAST STANDS, FACING SOUTHSTANDS, FACING WEST STANDS, FACING NORTHTURNS TO FACE YOU   ", nfc * 20 + 1, 20)), nfc > 0
    y = y + 23
    bc$ = MID$(lvlRow$(edSelY(dk)), edSelX(dk) + 1, 1)
    IF bc$ = "o" OR bc$ = ":" THEN ' (a barrel: its liquid - a : one - and how many stand on each other)
        EditBarrelGet edSelX(dk), edSelY(dk), blq, bst
        IF bc$ = ":" THEN
            EditPaneAdd -1, x0, y + 2, 140, "LIQUID " + UCASE$(lqName$(blq)), 0 : EditPaneAdd 290, x0 + 146, y, 24, "<", 0 : EditPaneAdd 291, x0 + 174, y, 24, ">", 0
            y = y + 23
        END IF
        EditPaneAdd -1, x0, y + 2, 140, "STACK" + STR$(bst) + " HIGH", 0 : EditPaneAdd 292, x0 + 146, y, 24, "-", 0 : EditPaneAdd 293, x0 + 174, y, 24, "+", 0
        y = y + 23
    END IF
    edPnCX = edSelX(dk) : edPnCY = edSelY(dk) : tn$ = ""
    IF bc$ = CHR$(34) THEN ' (a thing: what it is - and its own: a safe's code, what a computer opens, a camera's name)
        tn$ = ThingName$(ThingAt(edPnCX, edPnCY))
        EditPaneAdd -1, x0, y + 2, 140, UCASE$(LEFT$(tn$, 14)), 0 : EditPaneAdd 259, x0 + 146, y, 24, "<", 0 : EditPaneAdd 260, x0 + 174, y, 24, ">", 0
        y = y + 23
        SELECT CASE tn$
            CASE "safe" : lab$ = "CODE"
            CASE "computer", "brokenpc" : lab$ = "OPENS (X, Y)"
            CASE "camera" : lab$ = "NAME"
            CASE "alarmpc" : lab$ = "ALARM (X, Y)"
            CASE "padpc" : lab$ = "PAD (X, Y)"
            CASE ELSE : lab$ = ""
        END SELECT
        IF tn$ = "jumppad" THEN ' (a jump pad: which way, how steep, how hard)
            EditPadGet edPnCX, edPnCY, jd, ja, jp
            EditPaneAdd -1, x0, y + 2, 140, "DIR" + STR$(jd), 0 : EditPaneAdd 294, x0 + 146, y, 24, "<", 0 : EditPaneAdd 295, x0 + 174, y, 24, ">", 0 : y = y + 23
            EditPaneAdd -1, x0, y + 2, 140, "ANGLE" + STR$(ja), 0 : EditPaneAdd 296, x0 + 146, y, 24, "-", 0 : EditPaneAdd 297, x0 + 174, y, 24, "+", 0 : y = y + 23
            EditPaneAdd -1, x0, y + 2, 140, "POWER" + STR$(jp), 0 : EditPaneAdd 298, x0 + 146, y, 24, "-", 0 : EditPaneAdd 299, x0 + 174, y, 24, "+", 0 : y = y + 23
        END IF
        IF tn$ = "alarm" THEN ' (an alarm switch: on at first, or off till a console - or a trigger - switches it on)
            IF LCASE$(EditXtra$("things", edPnCX, edPnCY, 4)) = "off" THEN t$ = "OFF AT FIRST" ELSE t$ = "ON AT FIRST"
            EditPaneAdd 268, x0, y, PN_W, t$, (t$ = "ON AT FIRST") : y = y + 23
        END IF
        IF LEN(lab$) THEN
            k = XtraFind("things", edPnCX, edPnCY, 0) : t$ = "" : IF k THEN t$ = XtraRest$(k, 4)
            IF edTyping AND edTypeFor = 4 THEN t$ = edTypeBuf$ + "_" ELSE IF t$ = "" THEN t$ = "NONE"
            EditPaneAdd -1, x0, y + 2, 140, LEFT$(lab$ + ": " + t$, 22), 0
            IF edTyping AND edTypeFor = 4 THEN t$ = "OK" ELSE t$ = "TYPE"
            EditPaneAdd 261, x0 + 146, y, 52, t$, (edTyping AND edTypeFor = 4)
            y = y + 23
        END IF
    END IF
    IF bc$ = "'" OR bc$ = "d" OR tn$ = "bookshelf" OR tn$ = "safe" THEN ' (a note - or one found in it: its words, its picture)
        IF edTyping AND edTypeFor = 5 THEN t$ = edTypeBuf$ + "_" ELSE t$ = EditNoteWords$(edPnCX, edPnCY) : IF t$ = "" THEN t$ = "(no note)"
        EditPaneAdd -1, x0, y + 2, PN_W, LEFT$("NOTE: " + t$, 26), 0
        y = y + 21
        EditPaneAdd 262, x0, y, 64, "WORDS", (edTyping AND edTypeFor = 5) : EditPaneAdd 263, x0 + 67, y, 64, "PICTURE", (edTyping AND edTypeFor = 6) : EditPaneAdd 264, x0 + 134, y, 64, "NONE", 0
        y = y + 23
    END IF
END SUB

' A liquid cell's see-through (its [liquid opacity]): SOLID - + (the first
' selected cell with liquid in it says; the buttons set them all)
SUB EditPaneLiquid(x0, y)
    DIM k, n, t$ ' (its own: the main program shares these names)
    FOR k = 1 TO edSelN
        IF INSTR(LQ_CHARS$, MID$(lvlLiqRow$(edSelY(k)), edSelX(k) + 1, 1)) THEN
            n = LiquidOpOf(MID$(lvlLiqORow$(edSelY(k)), edSelX(k) + 1, 1))
            IF n = 0 THEN t$ = "LIQUID AS MADE" ELSE IF n >= 10 THEN t$ = "LIQUID SOLID" ELSE t$ = "LIQUID +" + LTRIM$(STR$(n * 10)) + "% SOLID"
            EditPaneAdd -1, x0, y + 2, 140, t$, 0 : EditPaneAdd 284, x0 + 146, y, 24, "-", 0 : EditPaneAdd 285, x0 + 174, y, 24, "+", 0
            y = y + 23
            EXIT SUB
        END IF
    NEXT
END SUB

' The selected floors' wetness (their [floor wetness]): WET - + (the
' first selected open cell says; the buttons set them all) - . the
' sector's, then 0 dry to 9 soaked
' PAINT with faces selected: their pictures slid a pixel at a time
' (Shift+click: 4), stretched across and up (by TEX_K_STEPS$ - Shift+click:
' a percent), or put back as made. The numbers are the first face's.
SUB EditPanePicture(x0, y)
    DIM c, c~&, fc, k, k1, n, ou, ov, ku, kv, pj, tm, tc&, t$ ' (its own: the main program shares these names)
    n = 0 : k1 = 0
    FOR k = 1 TO edSelN
        fc = EditFaceCode(edSelKind(k), edSelSide(k))
        IF fc >= 1 AND fc <= FACE_MAX THEN n = n + 1 : IF n = 1 THEN k1 = k
    NEXT
    edPnTitle$ = "PICTURE (" + LTRIM$(STR$(n)) + " selected)"
    IF n = 0 THEN EditPaneAdd -1, x0, y + 2, PN_W, "SELECT FACES TO SLIDE THEIR PICTURES", 0 : y = y + 23 : EXIT SUB
    IF EditHoldThing(edSelX(k1), edSelY(k1), c) THEN ' (a door or lift: opened, held up or down - to paint it so)
        edPnCX = edSelX(k1) : edPnCY = edSelY(k1)
        EditPaneAdd 511, x0, y, PN_W, EditHoldLabel$(edPnCX, edPnCY), 0 : y = y + 23
    END IF
    EditTreeGet edSelX(k1), edSelY(k1), EditFaceCode(edSelKind(k1), edSelSide(k1)) ' (the first one's look: its piece's - or its first piece's)
    pj = edSelPart(k1) : IF pj < 1 OR pj > ptN THEN pj = 0
    IF ptN > 1 THEN
        IF pj THEN t$ = "PIECE" + STR$(pj) + " OF" + STR$(ptN) ELSE t$ = "THE WHOLE FACE:" + STR$(ptN) + " PIECES"
        EditPaneAdd -1, x0, y + 2, PN_W, t$, 0 : y = y + 20
    END IF
    IF pj = 0 THEN pj = 1
    EditPcTexGet pj, ou, ov, ku, kv : tm = ptTM(pj) : tc& = ptTC(pj) AND &HFFFFFF
    EditPaneAdd -1, x0, y + 2, PN_W, "SLID" + STR$(((ou + 32) AND 63) - 32) + " ALONG," + STR$(((ov + 32) AND 63) - 32) + " UP (PIXELS)", 0 : y = y + 20 ' (shown -32 to 31: 3 left is -3, not 61)
    EditPaneAdd 330, x0, y, 48, "LEFT", 0 : EditPaneAdd 331, x0 + 50, y, 48, "RIGHT", 0 : EditPaneAdd 332, x0 + 100, y, 48, "UP", 0 : EditPaneAdd 333, x0 + 150, y, 50, "DOWN", 0 : y = y + 23
    EditPaneAdd -1, x0, y + 2, 140, "WIDE" + STR$(ku) + "%", 0 : EditPaneAdd 334, x0 + 146, y, 24, "-", 0 : EditPaneAdd 335, x0 + 174, y, 24, "+", 0 : y = y + 23
    EditPaneAdd -1, x0, y + 2, 140, "TALL" + STR$(kv) + "%", 0 : EditPaneAdd 336, x0 + 146, y, 24, "-", 0 : EditPaneAdd 337, x0 + 174, y, 24, "+", 0 : y = y + 23
    IF ptRot(pj) AND 3 THEN t$ = "TURNED" + STR$((ptRot(pj) AND 3) * 90) ELSE t$ = "NOT TURNED"
    IF ptRot(pj) AND 4 THEN t$ = t$ + ", FLIPPED"
    EditPaneAdd -1, x0, y + 2, 92, t$, 0 : EditPaneAdd 341, x0 + 146, y, 24, "<", 0 : EditPaneAdd 342, x0 + 174, y, 24, ">", 0 : y = y + 23
    EditPaneAdd -1, x0, y + 2, 50, "FLIP (M)", 0 : EditPaneAdd 398, x0 + 52, y, 72, "LEFT-RIGHT", 0 : EditPaneAdd 399, x0 + 126, y, 74, "UPSIDE DOWN", 0 : y = y + 23
    EditPaneAdd -1, x0, y + 2, 50, "START AT", 0
    FOR c = 0 TO 2 : EditPaneAdd 372 + c, x0 + 52 + c * 50, y, 48 + 2 * (c = 2), RTRIM$(MID$("FACE PIECEFIT  ", c * 5 + 1, 5)), (ptA(pj) = c) : NEXT : y = y + 23
    FOR c = 0 TO 3 : EditPaneAdd 343 + c, x0 + c * 50, y, 48, EditTintName$(c), (tm = c) : NEXT : y = y + 23
    IF tm THEN
        EditPaneAdd -1, x0, y + 2, 140, "AMOUNT" + STR$(ptTA(pj)) + "%", 0 : EditPaneAdd 347, x0 + 146, y, 24, "-", 0 : EditPaneAdd 348, x0 + 174, y, 24, "+", 0 : y = y + 23
        FOR c = 0 TO 2
            EditPaneAdd -1, x0, y + 2, 140, MID$("REDGRNBLU", c * 3 + 1, 3) + STR$((tc& \ 256 ^ (2 - c)) AND 255), 0
            EditPaneAdd 349 + 2 * c, x0 + 146, y, 24, "-", 0 : EditPaneAdd 350 + 2 * c, x0 + 174, y, 24, "+", 0 : y = y + 23
        NEXT
        FOR c = 1 TO 12 ' (quick colours: the lights' - and any colour, typed)
            c~& = EditPaletteRGB~&(c)
            EditPaneAdd 359 + c, x0 + ((c - 1) MOD 6) * 34, y + ((c - 1) \ 6) * 23, 30, "", ((c~& AND &HFFFFFF) = tc&) : edPnCol(edPnN) = c~&
        NEXT
        y = y + 46
        IF edTyping AND edTypeFor = 7 THEN t$ = edTypeBuf$ + "_" ELSE t$ = RIGHT$("00000" + HEX$(tc&), 6)
        EditPaneAdd -1, x0, y + 2, 70, "COLOUR " + t$, 0
        EditPaneAdd 359, x0 + 100, y, 30, "", 0 : edPnCol(edPnN) = _RGB32((tc& \ 65536) AND 255, (tc& \ 256) AND 255, tc& AND 255)
        IF edTyping AND edTypeFor = 7 THEN t$ = "OK" ELSE t$ = "TYPE"
        EditPaneAdd 355, x0 + 134, y, 64, t$, (edTyping AND edTypeFor = 7) : y = y + 23
    END IF
    EditPaneAdd -1, x0, y + 2, PN_W, "SHIFT+CLICK: FINER STEPS", 0 : y = y + 20
    EditPaneAdd 338, x0, y, 99, "AS MADE", 0 : EditPaneAdd 375, x0 + 101, y, 99, "USUAL PICTURE", 0 : y = y + 23
    EditPaneAdd 356, x0, y, 64, "H: L-R", 0 : EditPaneAdd 357, x0 + 67, y, 64, "V: T-B", 0 : EditPaneAdd 358, x0 + 134, y, 64, "J: JOIN", 0 : y = y + 23
    EditPaneAdd 339, x0, y, 99, "COPY", 0 : EditPaneAdd 340, x0 + 101, y, 99, "PASTE", 0 : y = y + 23
    IF edClipOn THEN EditPaneAdd -1, x0, y + 2, PN_W, LEFT$("COPIED: " + EditClipName$, 40), 0 : y = y + 20
    EditPanePresets x0, y ' (the shelf of looks kept for this picture: EDITOR/PRESETS.BM)
END SUB

SUB EditPaneWet(x0, y)
    DIM k, n, t$ ' (its own: the main program shares these names)
    FOR k = 1 TO edSelN
        IF INSTR("#NCKPG", MID$(lvlRow$(edSelY(k)), edSelX(k) + 1, 1)) = 0 THEN
            n = WetOf(MID$(lvlWetRow$(edSelY(k)), edSelX(k) + 1, 1))
            IF n < 0 THEN t$ = "WET: SECTOR'S" ELSE t$ = "WET" + STR$(n) + " OF 9"
            EditPaneAdd -1, x0, y + 2, 140, t$, 0 : EditPaneAdd 302, x0 + 146, y, 24, "-", 0 : EditPaneAdd 303, x0 + 174, y, 24, "+", 0
            y = y + 23
            EXIT SUB
        END IF
    NEXT
END SUB

' A jump pad's DIR, ANGLE, POWER (its [things] line - as made 0, 45, 30)
SUB EditPadGet(x, y, jd, ja, jp)
    DIM k, t$ ' (its own: the main program shares these names)
    jd = 0 : ja = 45 : jp = 30 : k = XtraFind("things", x, y, 0)
    IF k THEN
        t$ = XtraField$(k, 4) : IF LEN(t$) THEN jd = VAL(t$)
        t$ = XtraField$(k, 5) : IF LEN(t$) THEN ja = VAL(t$)
        t$ = XtraField$(k, 6) : IF LEN(t$) THEN jp = VAL(t$)
    END IF
END SUB

' A jetpack's or fuel can's own fuel (its [fuel] line): FUEL - +
SUB EditPaneFuel(x0, y)
    DIM k, n ' (its own: the main program shares these names)
    FOR k = 1 TO edSelN
        IF edSelKind(k) = ED_FLOOR AND INSTR("`,", MID$(lvlRow$(edSelY(k)), edSelX(k) + 1, 1)) THEN
            edPnCX = edSelX(k) : edPnCY = edSelY(k) : n = EditFuel(edPnCX, edPnCY)
            EditPaneAdd -1, x0, y + 2, 140, "FUEL" + STR$(n) + " OF" + STR$(JET_MAX), 0 : EditPaneAdd 266, x0 + 146, y, 24, "-", 0 : EditPaneAdd 267, x0 + 174, y, 24, "+", 0
            y = y + 23
            EXIT SUB
        END IF
    NEXT
END SUB

' A jetpack's or fuel can's fuel at cell x, y: its [fuel] line's, or as made
FUNCTION EditFuel(x, y)
    DIM k ' (its own: the main program shares these names)
    k = XtraFind("fuel", x, y, 0)
    IF k THEN EditFuel = VAL(XtraField$(k, 3)) ELSE IF MID$(lvlRow$(y), x + 1, 1) = "`" THEN EditFuel = JET_MAX ELSE EditFuel = JET_CAN
END FUNCTION

' A barrel's own (its [barrels] line): its liquid (a : barrel's - LQ_POISON
' as made) and how many stand on each other there (1 as made)
SUB EditBarrelGet(x, y, liq, stk)
    DIM k ' (its own: the main program shares these names)
    liq = 0 : IF MID$(lvlRow$(y), x + 1, 1) = ":" THEN liq = LQ_POISON
    stk = 1
    FOR k = 1 TO lvlNumBarrels
        IF lvlBarrel(k, 1) = x AND lvlBarrel(k, 2) = y THEN
            IF liq THEN IF lvlBarrel(k, 3) >= 1 AND lvlBarrel(k, 3) <= LQ_KINDS THEN liq = lvlBarrel(k, 3)
            stk = MaxOf(1, MinOf(BARREL_STACK, lvlBarrel(k, 4)))
        END IF
    NEXT
END SUB

' ...and set (liq -1: no line - as made)
SUB EditBarrelSet(x, y, liq, stk)
    DIM i, j, k ' (its own: the main program shares these names)
    k = 0
    FOR j = 1 TO lvlNumBarrels
        IF lvlBarrel(j, 1) = x AND lvlBarrel(j, 2) = y THEN k = j
    NEXT
    c$ = MID$(lvlRow$(y), x + 1, 1)
    IF liq < 0 OR (stk <= 1 AND ((c$ = "o" AND liq = 0) OR (c$ = ":" AND liq = LQ_POISON))) THEN ' (as made: no line)
        IF k THEN
            FOR i = k TO lvlNumBarrels - 1 : FOR j = 1 TO 4 : lvlBarrel(i, j) = lvlBarrel(i + 1, j) : NEXT : NEXT
            lvlNumBarrels = lvlNumBarrels - 1
        END IF
        EXIT SUB
    END IF
    IF k = 0 THEN
        IF lvlNumBarrels >= MAX_BARRELS THEN EditNote "That's" + STR$(MAX_BARRELS) + " barrels of their own - no more" : EXIT SUB
        lvlNumBarrels = lvlNumBarrels + 1 : k = lvlNumBarrels
    END IF
    lvlBarrel(k, 1) = x : lvlBarrel(k, 2) = y : lvlBarrel(k, 3) = liq : lvlBarrel(k, 4) = stk
END SUB

' The pane's button at (x, y) - its id - or 0
FUNCTION EditPaneAt(x, y)
    DIM k, pnLX ' (its own: the main program shares these names)
    EditPaneAt = 0 : EditPaneBuild
    pnLX = x : IF editView = 1 THEN pnLX = x - edWX ' (FULL WIDE: the pane's at the window's right edge)
    FOR k = 1 TO edPnN
        IF edPnId(k) > 0 AND pnLX >= edPnX(k) AND y >= edPnY(k) AND pnLX < edPnX(k) + edPnW(k) AND y < edPnY(k) + MaxOf(PN_BH, edPnH(k)) THEN EditPaneAt = edPnId(k) : EXIT FUNCTION
    NEXT
END FUNCTION

SUB EditDrawPane(mx, my)
    DIM B, bh, k, w, x, y, pmx ' (its own: the main program shares these names)
    EditPaneBuild : IF edPnTitle$ = "" THEN EXIT SUB
    pmx = mx : IF editView = 1 AND mx <> -1 THEN pmx = mx - edWX ' (FULL WIDE: the pane's at the window's right edge - a copy: mx is the caller's)
    LINE (edPnX0 - 6, edPnY0)-(edPnX0 + PN_W + 6, edPnBot + 6), _RGBA32(6, 2, 18, 215), BF
    LINE (edPnX0 - 6, edPnY0)-(edPnX0 + PN_W + 6, edPnBot + 6), _RGB32(255, 60, 200), B
    TinyText edPnX0, edPnY0 + 4, edPnTitle$, _RGB32(255, 90, 200)
    FOR k = 1 TO edPnN
        x = edPnX(k) : y = edPnY(k) : w = edPnW(k)
        IF edPnId(k) < 0 THEN
            TinyText x, y + 3, edPnLab$(k), _RGB32(210, 220, 255)
        ELSE
            bh = PN_BH : IF edPnH(k) THEN bh = edPnH(k)
            over = (pmx >= x AND my >= y AND pmx < x + w AND my < y + bh)
            IF edPnLit(k) THEN bg~& = _RGBA32(120, 20, 100, 230) ELSE bg~& = _RGBA32(14, 6, 30, 230)
            IF over THEN bg~& = _RGBA32(40, 70, 110, 240)
            LINE (x, y)-STEP(w - 1, bh - 1), bg~&, BF
            IF over THEN bc~& = _RGB32(150, 240, 255) ELSE IF edPnLit(k) THEN bc~& = _RGB32(255, 60, 200) ELSE bc~& = _RGB32(90, 70, 140)
            IF edPnCol(k) THEN LINE (x + 3, y + 3)-STEP(w - 7, bh - 7), edPnCol(k), BF ' (a colour to choose)
            IF edPnImg&(k) < -1 THEN _PUTIMAGE (x + 2, y + 2)-STEP(w - 5, bh - 5), edPnImg&(k) ' (a picture: a preset's)
            LINE (x, y)-STEP(w - 1, bh - 1), bc~&, B
            IF edPnLit(k) AND edPnImg&(k) < -1 THEN LINE (x + 1, y + 1)-STEP(w - 3, bh - 3), bc~&, B ' (the one chosen: thicker)
            TinyText x + (w - TinyW(edPnLab$(k))) \ 2, y + 3, edPnLab$(k), _RGB32(255, 255, 255)
        END IF
    NEXT
    IF edPnLight THEN EditGlow edPnX0 + 170, edPnY0 + 1, 30, _RGB32(lvlLight(edPnLight, 5), lvlLight(edPnLight, 6), lvlLight(edPnLight, 7)), EditFxNow(lvlLight(edPnLight, 8)) ' (the light as it'll go)
END SUB

' The monster starting in (x, y): its sight, hearing, health %, speed %,
' waking, a turret's weapon, turning, coming out (frames) and start - its
' own ([monsters]) or as every one is
SUB EditMonGet(x, y, ms, mh, mhp, msp, mw, mwp, mtr, mej, mst)
    DIM k ' (its own: the main program shares these names)
    ms = MON_SIGHT : mh = 0 : mhp = 100 : msp = 100 : mw = WAKE_SEE : mwp = TW_PLASMA : mtr = 0 : mej = 0 : mst = 0
    FOR k = 1 TO lvlMonN
        IF lvlMon(k, 1) = x AND lvlMon(k, 2) = y THEN ms = lvlMon(k, 3) : mh = lvlMon(k, 4) : mhp = lvlMon(k, 5) : msp = lvlMon(k, 6) : mw = lvlMon(k, 7) : mwp = lvlMon(k, 8) : mtr = lvlMon(k, 9) : mej = lvlMon(k, 10) : mst = lvlMon(k, 11)
    NEXT
END SUB

' ...and set: as every one is again, it's taken out of [monsters]
SUB EditMonPut(x, y, ms, mh, mhp, msp, mw, mwp, mtr, mej, mst)
    DIM c, j, k ' (its own: the main program shares these names)
    k = 0
    FOR j = 1 TO lvlMonN
        IF lvlMon(j, 1) = x AND lvlMon(j, 2) = y THEN k = j
    NEXT
    IF ms = MON_SIGHT AND mh = 0 AND mhp = 100 AND msp = 100 AND mw = WAKE_SEE AND mwp = TW_PLASMA AND mtr = 0 AND mej = 0 AND mst = 0 THEN
        IF k THEN
            FOR j = k TO lvlMonN - 1 : FOR c = 1 TO MON_COLS : lvlMon(j, c) = lvlMon(j + 1, c) : NEXT : NEXT
            lvlMonN = lvlMonN - 1
        END IF
        EXIT SUB
    END IF
    IF k = 0 THEN
        IF lvlMonN >= MAX_MON THEN EXIT SUB
        lvlMonN = lvlMonN + 1 : k = lvlMonN
    END IF
    lvlMon(k, 1) = x : lvlMon(k, 2) = y : lvlMon(k, 3) = ms : lvlMon(k, 4) = mh : lvlMon(k, 5) = mhp : lvlMon(k, 6) = msp : lvlMon(k, 7) = mw : lvlMon(k, 8) = mwp : lvlMon(k, 9) = mtr : lvlMon(k, 10) = mej : lvlMon(k, 11) = mst
END SUB

' A ring on the floor round (cx, cy), r cells, at height z (the monster's
' sight and hearing, in the editor)
SUB EditRing(cx, cy, r, z, col~&)
    DIM a, k, n, nx, ny, px, py ' (its own: the main program shares these names)
    IF r <= 0 THEN EXIT SUB
    n = 48 : px = cx + r : py = cy
    FOR k = 1 TO n
        a = k * 6.2832 / n : nx = cx + r * COS(a) : ny = cy + r * SIN(a)
        EditLine3D px, py, z, nx, ny, z, col~& : px = nx : py = ny
    NEXT
END SUB

' Where the selection's triggers are: the box round it (x0, y0)-(x1, y1) -
' where you'd stand: a wall's face, the cell in front of it - and the cell
' you'd use (ux, uy): the first face's own (a wall, a door: you face it)
SUB EditTrigPlace(x0, y0, x1, y1, ux, uy)
    DIM k, tx, ty ' (its own: the main program shares these names)
    x0 = mapN : y0 = mapN : x1 = 0 : y1 = 0
    FOR k = 1 TO edSelN
        EditFaceCell edSelKind(k), edSelX(k), edSelY(k), edSelSide(k), tx, ty
        IF edSelKind(k) = ED_FLOOR AND NOT EditCellOpen(edSelX(k), edSelY(k)) THEN tx = edSelX(k) : ty = edSelY(k)
        x0 = MinOf(x0, tx) : y0 = MinOf(y0, ty) : x1 = MaxOf(x1, tx) : y1 = MaxOf(y1, ty)
    NEXT
    ux = edSelX(1) : uy = edSelY(1)
END SUB

' Is trigger line l$ about this place: an enter / clear box that takes in
' (x0, y0), a use of (ux, uy) - or a time, which is everywhere?
FUNCTION EditTrigHere(l$, x0, y0, x1, y1, ux, uy)
    DIM c, j, w$ ' (its own: the main program shares these names)
    EditTrigHere = 0
    c = INSTR(l$, ":") : IF c = 0 THEN EXIT FUNCTION
    w$ = LCASE$(LTRIM$(LEFT$(l$, c - 1))) + " "
    DIM n(4) AS SINGLE
    sp = INSTR(w$, " ") : kind$ = LEFT$(w$, sp - 1) : w$ = MID$(w$, sp + 1)
    FOR j = 1 TO 4
        w$ = LTRIM$(w$) : sp = INSTR(w$, " ")
        IF sp > 1 THEN n(j) = VAL(LEFT$(w$, sp - 1)) : w$ = MID$(w$, sp + 1)
    NEXT
    SELECT CASE kind$
        CASE "time" : EditTrigHere = -1
        CASE "use", "shoot", "hack", "alarm" : EditTrigHere = (n(1) = ux AND n(2) = uy) OR (kind$ = "alarm" AND n(1) = 0 AND n(2) = 0)
        CASE "enter", "clear" : EditTrigHere = NOT (MaxOf(n(1), n(3)) < x0 OR MinOf(n(1), n(3)) > x1 OR MaxOf(n(2), n(4)) < y0 OR MinOf(n(2), n(4)) > y1)
    END SELECT
END FUNCTION

' The event room cell (x, y) is in - the first - or 0
FUNCTION EditEventAt(x, y)
    DIM k ' (its own: the main program shares these names)
    EditEventAt = 0
    FOR k = 1 TO lvlNumEvents
        IF x >= lvlEvent(k, 2) AND x <= lvlEvent(k, 4) AND y >= lvlEvent(k, 3) AND y <= lvlEvent(k, 5) THEN EditEventAt = k : EXIT FUNCTION
    NEXT
END FUNCTION

' A picture's name, short: no "wall-" (floor-, ceiling-), no ".png"
FUNCTION EditPicShort$(f$)
    DIM c, t$ ' (its own: the main program shares these names)
    t$ = f$ : IF LCASE$(RIGHT$(t$, 4)) = ".png" THEN t$ = LEFT$(t$, LEN(t$) - 4)
    c = INSTR(t$, "-") : IF c THEN t$ = MID$(t$, c + 1)
    EditPicShort$ = t$
END FUNCTION

' Pad (x, y) out of any pair made by hand
SUB EditUnpair(x, y)
    DIM c, i, j ' (its own: the main program shares these names)
    FOR j = lvlNumPairs TO 1 STEP -1
        IF (lvlPair(j, 1) = x AND lvlPair(j, 2) = y) OR (lvlPair(j, 3) = x AND lvlPair(j, 4) = y) THEN
            FOR i = j TO lvlNumPairs - 1 : FOR c = 1 TO 4 : lvlPair(i, c) = lvlPair(i + 1, c) : NEXT : NEXT
            lvlNumPairs = lvlNumPairs - 1
        END IF
    NEXT
END SUB

' A face's number in [faces]: a wall's or step's side 1-4, a lintel's 5-8,
' the floor 9, the ceiling 10
FUNCTION EditFaceCode(kind, side)
    SELECT CASE kind
        CASE ED_FLOOR : EditFaceCode = 9
        CASE ED_CEIL : EditFaceCode = 10
        CASE ED_LINTEL : EditFaceCode = side + 4
        CASE ED_BOX : EditFaceCode = FACE_BOX + side
        CASE ED_DIAG : EditFaceCode = FACE_DIAG
        CASE ED_DEDGE : EditFaceCode = FACE_DEDGE
        CASE ED_TRACK : EditFaceCode = FACE_TRACK
        CASE ELSE : EditFaceCode = side
    END SELECT
END FUNCTION

' What a cell just placed means, said after it: a teleporter's partner, a
' second start's warning...
FUNCTION EditPlaceInfo$(x, y)
    DIM c$, n ' (its own: the main program shares these names)
    c$ = MID$(lvlRow$(y), x + 1, 1) : EditPlaceInfo$ = ""
    IF c$ = "&" THEN ' (pads pair up in the order they're read: across each row, top to bottom)
        n = 0 : me = 0
        FOR yy = 0 TO mapN - 1 : FOR xx = 0 TO mapN - 1
            IF MID$(lvlRow$(yy), xx + 1, 1) = "&" THEN n = n + 1 : IF xx = x AND yy = y THEN me = n
        NEXT : NEXT
        IF me MOD 2 = 1 THEN other = me + 1 ELSE other = me - 1
        IF other > n THEN EditPlaceInfo$ = " - pad" + STR$(me) + ": put another for it to go to" ELSE EditPlaceInfo$ = " - pad" + STR$(me) + ", paired with pad" + STR$(other)
    END IF
    IF INSTR("<>^v", c$) THEN EditPlaceInfo$ = " - you start here now"
END FUNCTION

' Where a click with PLACE or LIGHT goes for a face: a floor or ceiling's
' own cell; a wall's (a step's, a lintel's) the open cell in front of it
SUB EditFaceCell(kind, x, y, side, tx, ty)
    IF kind = ED_FLOOR OR kind = ED_CEIL OR kind = ED_BOX OR kind = ED_DEDGE OR kind = ED_TRACK THEN tx = x : ty = y ELSE EditFaceFront x, y, side, tx, ty ' (a box's side: the cell it stands in; a door's edge, its track: the doorway)
    IF kind = ED_DIAG THEN ' (a diagonal's: the open cell beside its open half - its solid corner's the other way)
        tx = x - SGN(EditDiagDX(diagCorner(x, y))) : ty = y
        IF NOT EditCellOpen(tx, ty) THEN tx = x : ty = y - SGN(EditDiagDY(diagCorner(x, y)))
    END IF
END SUB

' A face's kind in words: WALL, FLOOR... DIAGONAL
FUNCTION EditKindName$(kind)
    IF kind < 1 OR kind > 9 THEN EXIT FUNCTION
    EditKindName$ = RTRIM$(MID$("WALL     FLOOR    CEILING  STEP     LINTEL   BLOCK    DIAGONAL DOOR EDGETRACK    ", kind * 9 - 8, 9))
END FUNCTION

' A diagonal's solid corner (1 top left, 2 top right, 3 bottom right, 4
' bottom left), as a way from its cell's middle: -1 or 1 along x, along y
FUNCTION EditDiagDX(c)
    IF c = 2 OR c = 3 THEN EditDiagDX = 1 ELSE EditDiagDX = -1
END FUNCTION
FUNCTION EditDiagDY(c)
    IF c >= 3 THEN EditDiagDY = 1 ELSE EditDiagDY = -1
END FUNCTION

' BOXES IN THE EDITOR: lvlBox's line for cell (x, y), or 0
FUNCTION EditBoxIndex(x, y)
    DIM k ' (its own: the main program shares these names)
    FOR k = 1 TO lvlNumBoxes
        IF lvlBox(k, 1) = x AND lvlBox(k, 2) = y THEN EditBoxIndex = k : EXIT FUNCTION
    NEXT
END FUNCTION

' A box in cell (x, y): edges x0, y0, x1, y1 in eighths, looking like wall
' w (1-6). TRUE if there was room for it.
FUNCTION EditAddBox(x, y, x0, y0, x1, y1, w)
    DIM k ' (its own: the main program shares these names)
    IF liftCell(x, y) THEN EditNote "Not on a lift: a block stands floor to ceiling, and a lift's floor moves" : EXIT FUNCTION
    k = EditBoxIndex(x, y)
    IF k = 0 THEN
        IF lvlNumBoxes >= MAX_BOXES THEN EditNote "That's" + STR$(MAX_BOXES) + " blocks - no more" : EXIT FUNCTION
        lvlNumBoxes = lvlNumBoxes + 1 : k = lvlNumBoxes
    END IF
    lvlBox(k, 1) = x : lvlBox(k, 2) = y : lvlBox(k, 3) = x0 : lvlBox(k, 4) = y0 : lvlBox(k, 5) = x1 : lvlBox(k, 6) = y1 : lvlBox(k, 7) = w
    EditAddBox = -1
    IF editMode THEN Achieve "NC_BOXED", -1
END FUNCTION

' Cell (x, y)'s box gone - and its sides' own pictures with it
SUB EditRemoveBox(x, y)
    DIM f, i, j, k ' (its own: the main program shares these names)
    k = EditBoxIndex(x, y) : IF k = 0 THEN EXIT SUB
    FOR i = k TO lvlNumBoxes - 1 : FOR j = 1 TO 7 : lvlBox(i, j) = lvlBox(i + 1, j) : NEXT : NEXT
    lvlNumBoxes = lvlNumBoxes - 1
    FOR f = FACE_BOX + 1 TO FACE_BOX + 4 : EditSetFace x, y, f, 0, "", "" : NEXT
END SUB

' Side (1 east, 2 south, 3 west, 4 north) of (x, y)'s box moved an eighth
' in (by 1) or out (by -1). An eighth thick at least, and inside its cell:
' TRUE if it moved.
FUNCTION EditBoxMove(x, y, side, by)
    DIM j, k, ok ' (its own: the main program shares these names)
    k = EditBoxIndex(x, y) : IF k = 0 THEN EXIT FUNCTION
    SELECT CASE side
        CASE 1 : j = 5 : nv = lvlBox(k, 5) - by : ok = nv >= lvlBox(k, 3) + 1 AND nv <= 8
        CASE 2 : j = 6 : nv = lvlBox(k, 6) - by : ok = nv >= lvlBox(k, 4) + 1 AND nv <= 8
        CASE 3 : j = 3 : nv = lvlBox(k, 3) + by : ok = nv <= lvlBox(k, 5) - 1 AND nv >= 0
        CASE ELSE : j = 4 : nv = lvlBox(k, 4) + by : ok = nv <= lvlBox(k, 6) - 1 AND nv >= 0
    END SELECT
    IF ok THEN lvlBox(k, j) = nv : EditBoxMove = -1
END FUNCTION

' A plain wall made a box filling its cell: floor (and its floor and
' ceiling those of the open cell in front of side), and a box of the
' same wall on it, its sides' pictures the wall's sides' were. TRUE if it
' was a plain wall.
FUNCTION EditWallToBox(x, y, side)
    DIM fx, fy, j, w ' (its own: the main program shares these names)
    IF x < 1 OR y < 1 OR x > mapN - 2 OR y > mapN - 2 THEN EXIT FUNCTION
    w = INSTR("#NCKPG", MID$(lvlRow$(y), x + 1, 1)) : IF w = 0 THEN EXIT FUNCTION
    EditFaceFront x, y, side, fx, fy
    IF NOT EditAddBox(x, y, 0, 0, 8, 8, w) THEN EXIT FUNCTION
    EditPut x, y, "."
    MID$(lvlFloorRow$(y), x + 1, 1) = MID$(lvlFloorRow$(fy), fx + 1, 1) : MID$(lvlCeilRow$(y), x + 1, 1) = MID$(lvlCeilRow$(fy), fx + 1, 1)
    FOR j = 1 TO lvlNumFaces ' (its sides' own pictures: the box's now)
        IF lvlFaceX(j) = x AND lvlFaceY(j) = y AND lvlFaceS(j) >= 1 AND lvlFaceS(j) <= 4 THEN lvlFaceS(j) = lvlFaceS(j) + FACE_BOX
    NEXT
    EditWallToBox = -1
END FUNCTION

' A decoration's nudge off its cell's middle, in eighths ([nudges])
SUB EditNudgeGet(x, y, dx, dy, face)
    DIM k ' (its own: the main program shares these names)
    dx = 0 : dy = 0 : face = 0
    FOR k = 1 TO lvlNumNudges
        IF lvlNudge(k, 1) = x AND lvlNudge(k, 2) = y THEN dx = lvlNudge(k, 3) : dy = lvlNudge(k, 4) : face = lvlNudge(k, 5)
    NEXT
END SUB
SUB EditNudgeSet(x, y, dx, dy, face)
    DIM i, j, k ' (its own: the main program shares these names)
    k = 0
    FOR j = 1 TO lvlNumNudges
        IF lvlNudge(j, 1) = x AND lvlNudge(j, 2) = y THEN k = j
    NEXT
    IF dx = 0 AND dy = 0 AND face = 0 THEN ' (back in the middle, facing you: no line for it)
        IF k THEN
            FOR i = k TO lvlNumNudges - 1 : FOR j = 1 TO 5 : lvlNudge(i, j) = lvlNudge(i + 1, j) : NEXT : NEXT
            lvlNumNudges = lvlNumNudges - 1
        END IF
        EXIT SUB
    END IF
    IF k = 0 THEN
        IF lvlNumNudges >= MAX_NUDGES THEN EditNote "That's" + STR$(MAX_NUDGES) + " decorations moved - no more" : EXIT SUB
        lvlNumNudges = lvlNumNudges + 1 : k = lvlNumNudges
    END IF
    lvlNudge(k, 1) = x : lvlNudge(k, 2) = y : lvlNudge(k, 3) = dx : lvlNudge(k, 4) = dy : lvlNudge(k, 5) = face
END SUB

' Delete: every face selected, gone - a wall opened up (its floor and
' ceiling like the cell in front), a thing on a floor taken away (never
' the start), a step or lintel flattened to the floor or ceiling in front
' of it. Says how many; the selection's cleared.
SUB EditDeleteSel
    DIM c$, fx, fy, k, n, x, y ' (its own: the main program shares these names)
    n = 0
    FOR k = 1 TO edSelN
        x = edSelX(k) : y = edSelY(k) : EditFaceFront x, y, edSelSide(k), fx, fy
        IF x > 0 AND y > 0 AND x < mapN - 1 AND y < mapN - 1 THEN
            c$ = MID$(lvlRow$(y), x + 1, 1)
            SELECT CASE edSelKind(k)
                CASE ED_WALL
                    IF c$ <> "." AND fx >= 0 AND fy >= 0 AND fx < mapN AND fy < mapN THEN
                        EditPut x, y, "." : n = n + 1
                        MID$(lvlFloorRow$(y), x + 1, 1) = MID$(lvlFloorRow$(fy), fx + 1, 1) : MID$(lvlCeilRow$(y), x + 1, 1) = MID$(lvlCeilRow$(fy), fx + 1, 1)
                    END IF
                CASE ED_FLOOR ' (a thing on it - not for a ceiling selected: the floor's thing isn't what you picked)
                    IF c$ <> "." AND INSTR("<>^v", c$) = 0 THEN EditPut x, y, "." : n = n + 1
                CASE ED_STEP
                    MID$(lvlFloorRow$(y), x + 1, 1) = MID$(lvlFloorRow$(fy), fx + 1, 1) : n = n + 1
                CASE ED_LINTEL
                    MID$(lvlCeilRow$(y), x + 1, 1) = MID$(lvlCeilRow$(fy), fx + 1, 1) : n = n + 1
                CASE ED_BOX
                    IF EditBoxIndex(x, y) THEN EditRemoveBox x, y : n = n + 1
            END SELECT
        END IF
    NEXT
    edSelN = 0
    EditNote "Deleted" + STR$(n)
END SUB

' The selection on the map from above: a floor or ceiling as a box inside
' its cell, a side as a thick line along that edge of it
SUB EditDrawSelMap
    DIM B, c~&, k, sx, sy ' (its own: the main program shares these names)
    FOR k = 1 TO edSelN
        sx = edMapX + edSelX(k) * edCell : sy = edMapY + edSelY(k) * edCell : c~& = _RGB32(255, 170, 40)
        SELECT CASE edSelKind(k)
            CASE ED_FLOOR, ED_CEIL
                LINE (sx + 1, sy + 1)-STEP(edCell - 3, edCell - 3), c~&, B
                IF edSelKind(k) = ED_CEIL THEN LINE (sx + 3, sy + 3)-STEP(edCell - 7, edCell - 7), c~&, B ' (a ceiling: a box in a box)
            CASE ED_DEDGE, ED_TRACK ' (a door's edges, its track: along its middle)
                IF DoorAcross(edSelX(k), edSelY(k)) = 0 THEN LINE (sx, sy + edCell \ 2 - 1)-STEP(edCell - 1, 1), c~&, BF ELSE LINE (sx + edCell \ 2 - 1, sy)-STEP(1, edCell - 1), c~&, BF
            CASE ELSE
                SELECT CASE edSelSide(k)
                    CASE 1 : LINE (sx + edCell - 2, sy)-STEP(1, edCell - 1), c~&, BF
                    CASE 2 : LINE (sx, sy + edCell - 2)-STEP(edCell - 1, 1), c~&, BF
                    CASE 3 : LINE (sx, sy)-STEP(1, edCell - 1), c~&, BF
                    CASE 4 : LINE (sx, sy)-STEP(edCell - 1, 1), c~&, BF
                    CASE 0 ' (a diagonal's slanted face: corner to corner)
                        IF diagCorner(edSelX(k), edSelY(k)) = 1 OR diagCorner(edSelX(k), edSelY(k)) = 3 THEN LINE (sx, sy + edCell - 1)-(sx + edCell - 1, sy), c~& ELSE LINE (sx, sy)-(sx + edCell - 1, sy + edCell - 1), c~&
                END SELECT
        END SELECT
    NEXT
END SUB

' The arrows' nudge: every cell the selection is on moves a cell along
' (dx, dy) - what it is (wall, floor, a thing on it), its floor and ceiling
' heights. A cell it leaves takes after the one behind it (so a platform
' slides along, leaving floor like the floor round it). Not into the
' border. The selection moves with it.
SUB EditNudge(dx, dy)
    DIM bx, by, c, e, j, k, x, y ' (its own: the main program shares these names)
    DIM r$(MAP_SIZE - 1), f$(MAP_SIZE - 1), c$(MAP_SIZE - 1), l$(MAP_SIZE - 1), ld$(MAP_SIZE - 1), lo$(MAP_SIZE - 1), wo$(MAP_SIZE - 1), mv(MAP_SIZE, MAP_SIZE) AS INTEGER, dest(MAP_SIZE, MAP_SIZE) AS INTEGER
    FOR y = 0 TO mapN - 1 : r$(y) = lvlRow$(y) : f$(y) = lvlFloorRow$(y) : c$(y) = lvlCeilRow$(y) : l$(y) = lvlLiqRow$(y) : ld$(y) = lvlLiqDRow$(y) : lo$(y) = lvlLiqORow$(y) : wo$(y) = lvlWetRow$(y) : NEXT
    FOR k = 1 TO edSelN
        x = edSelX(k) : y = edSelY(k)
        IF x + dx < 1 OR y + dy < 1 OR x + dx > mapN - 2 OR y + dy > mapN - 2 THEN EditNote "Can't move into the border" : EXIT SUB
        mv(x, y) = -1
    NEXT
    FOR y = 1 TO mapN - 2 : FOR x = 1 TO mapN - 2
        IF mv(x, y) THEN dest(x + dx, y + dy) = -1
    NEXT : NEXT
    FOR y = 1 TO mapN - 2 : FOR x = 1 TO mapN - 2
        IF mv(x, y) AND NOT dest(x, y) THEN ' (left behind: like the cell behind it)
            bx = x - SGN(dx) : by = y - SGN(dy) ' (the cell behind it, the way it went - a cell, however far it went)
            DO WHILE mv(bx, by) AND bx > 0 AND by > 0 AND bx < mapN - 1 AND by < mapN - 1 : bx = bx - SGN(dx) : by = by - SGN(dy) : LOOP
            MID$(lvlRow$(y), x + 1, 1) = MID$(r$(by), bx + 1, 1) : MID$(lvlFloorRow$(y), x + 1, 1) = MID$(f$(by), bx + 1, 1) : MID$(lvlCeilRow$(y), x + 1, 1) = MID$(c$(by), bx + 1, 1)
            MID$(lvlLiqRow$(y), x + 1, 1) = MID$(l$(by), bx + 1, 1) : MID$(lvlLiqDRow$(y), x + 1, 1) = MID$(ld$(by), bx + 1, 1) : MID$(lvlLiqORow$(y), x + 1, 1) = MID$(lo$(by), bx + 1, 1) : MID$(lvlWetRow$(y), x + 1, 1) = MID$(wo$(by), bx + 1, 1)
            IF INSTR("#NCKPG", MID$(lvlRow$(y), x + 1, 1)) = 0 THEN MID$(lvlRow$(y), x + 1, 1) = "." ' (a plain wall behind it, as that; anything else - a start, a monster, a pad, a door - never twice: floor)
        END IF
    NEXT : NEXT
    FOR y = 1 TO mapN - 2 : FOR x = 1 TO mapN - 2
        IF mv(x, y) THEN
            MID$(lvlRow$(y + dy), x + dx + 1, 1) = MID$(r$(y), x + 1, 1) : MID$(lvlFloorRow$(y + dy), x + dx + 1, 1) = MID$(f$(y), x + 1, 1) : MID$(lvlCeilRow$(y + dy), x + dx + 1, 1) = MID$(c$(y), x + 1, 1)
            MID$(lvlLiqRow$(y + dy), x + dx + 1, 1) = MID$(l$(y), x + 1, 1) : MID$(lvlLiqDRow$(y + dy), x + dx + 1, 1) = MID$(ld$(y), x + 1, 1) : MID$(lvlLiqORow$(y + dy), x + dx + 1, 1) = MID$(lo$(y), x + 1, 1) : MID$(lvlWetRow$(y + dy), x + dx + 1, 1) = MID$(wo$(y), x + 1, 1) ' (its pool too, how wet)
        END IF
    NEXT : NEXT
    DIM clb(MAP_SIZE, MAP_SIZE) AS INTEGER, clc(MAP_SIZE, MAP_SIZE) AS _UNSIGNED LONG, clf(MAP_SIZE, MAP_SIZE) AS INTEGER ' (the cell lights too: as the rows - left behind, like the cell behind; moved, with it)
    FOR y = 0 TO mapN - 1 : FOR x = 0 TO mapN - 1 : clb(x, y) = lvlCLBright(x, y) : clc(x, y) = lvlCLCol(x, y) : clf(x, y) = lvlCLFx(x, y) : NEXT : NEXT
    FOR y = 1 TO mapN - 2 : FOR x = 1 TO mapN - 2
        IF mv(x, y) AND NOT dest(x, y) THEN
            bx = x - SGN(dx) : by = y - SGN(dy)
            DO WHILE mv(bx, by) AND bx > 0 AND by > 0 AND bx < mapN - 1 AND by < mapN - 1 : bx = bx - SGN(dx) : by = by - SGN(dy) : LOOP
            lvlCLBright(x, y) = clb(bx, by) : lvlCLCol(x, y) = clc(bx, by) : lvlCLFx(x, y) = clf(bx, by)
        END IF
    NEXT : NEXT
    FOR y = 1 TO mapN - 2 : FOR x = 1 TO mapN - 2
        IF mv(x, y) THEN lvlCLBright(x + dx, y + dy) = clb(x, y) : lvlCLCol(x + dx, y + dy) = clc(x, y) : lvlCLFx(x + dx, y + dy) = clf(x, y)
    NEXT : NEXT
    FOR k = 1 TO edSelN : edSelX(k) = edSelX(k) + dx : edSelY(k) = edSelY(k) + dy : NEXT
    FOR k = 1 TO lvlNumLifts ' (a lift, an event room, a zone - all of it selected: it goes with them)
        IF EditRectMoved(mv(), lvlLift(k, 1), lvlLift(k, 2), lvlLift(k, 3), lvlLift(k, 4)) THEN lvlLift(k, 1) = lvlLift(k, 1) + dx : lvlLift(k, 3) = lvlLift(k, 3) + dx : lvlLift(k, 2) = lvlLift(k, 2) + dy : lvlLift(k, 4) = lvlLift(k, 4) + dy
    NEXT
    FOR k = 1 TO lvlNumEvents
        IF EditRectMoved(mv(), lvlEvent(k, 2), lvlEvent(k, 3), lvlEvent(k, 4), lvlEvent(k, 5)) THEN lvlEvent(k, 2) = lvlEvent(k, 2) + dx : lvlEvent(k, 4) = lvlEvent(k, 4) + dx : lvlEvent(k, 3) = lvlEvent(k, 3) + dy : lvlEvent(k, 5) = lvlEvent(k, 5) + dy
    NEXT
    FOR k = 1 TO lvlNumZones
        IF EditRectMoved(mv(), lvlZone(k, 1), lvlZone(k, 2), lvlZone(k, 3), lvlZone(k, 4)) THEN lvlZone(k, 1) = lvlZone(k, 1) + dx : lvlZone(k, 3) = lvlZone(k, 3) + dx : lvlZone(k, 2) = lvlZone(k, 2) + dy : lvlZone(k, 4) = lvlZone(k, 4) + dy
    NEXT
    ' What belongs to a cell goes with it - a monster's own settings, the
    ' faces' pictures, a pad's link; a cell moved onto loses its own
    FOR k = lvlMonN TO 1 STEP -1
        x = lvlMon(k, 1) : y = lvlMon(k, 2)
        IF x >= 0 AND y >= 0 AND x <= mapN AND y <= mapN THEN
            IF mv(x, y) THEN
                lvlMon(k, 1) = x + dx : lvlMon(k, 2) = y + dy
            ELSEIF dest(x, y) THEN
                FOR j = k TO lvlMonN - 1 : FOR c = 1 TO MON_COLS : lvlMon(j, c) = lvlMon(j + 1, c) : NEXT : NEXT
                lvlMonN = lvlMonN - 1
            END IF
        END IF
    NEXT
    FOR k = 1 TO lvlNumLights ' (a light on a moved cell goes with it)
        x = INT(lvlLight(k, 1)) : y = INT(lvlLight(k, 2))
        IF x >= 0 AND y >= 0 AND x <= mapN AND y <= mapN THEN IF mv(x, y) THEN lvlLight(k, 1) = lvlLight(k, 1) + dx : lvlLight(k, 2) = lvlLight(k, 2) + dy
    NEXT
    FOR k = lvlNumBoxes TO 1 STEP -1 ' (a block, and a decoration's nudge, the same)
        x = lvlBox(k, 1) : y = lvlBox(k, 2)
        IF x >= 0 AND y >= 0 AND x <= mapN AND y <= mapN THEN
            IF mv(x, y) THEN
                lvlBox(k, 1) = x + dx : lvlBox(k, 2) = y + dy
            ELSEIF dest(x, y) THEN
                FOR j = k TO lvlNumBoxes - 1 : FOR c = 1 TO 7 : lvlBox(j, c) = lvlBox(j + 1, c) : NEXT : NEXT
                lvlNumBoxes = lvlNumBoxes - 1
            END IF
        END IF
    NEXT
    FOR k = lvlNumXtra TO 1 STEP -1 ' (a door's kicks and code, a thing's kind, a note, a smear)
        x = VAL(XtraField$(k, 1)) : y = VAL(XtraField$(k, 2))
        IF x >= 0 AND y >= 0 AND x <= mapN AND y <= mapN THEN
            IF mv(x, y) THEN
                lvlXtra$(k) = LTRIM$(STR$(x + dx)) + ", " + LTRIM$(STR$(y + dy)) + ", " + XtraRest$(k, 3)
            ELSEIF dest(x, y) THEN
                FOR j = k TO lvlNumXtra - 1 : lvlXSec$(j) = lvlXSec$(j + 1) : lvlXtra$(j) = lvlXtra$(j + 1) : NEXT
                lvlNumXtra = lvlNumXtra - 1
            END IF
        END IF
    NEXT
    FOR k = lvlNumBarrels TO 1 STEP -1 ' (a barrel's liquid and stack)
        x = lvlBarrel(k, 1) : y = lvlBarrel(k, 2)
        IF x >= 0 AND y >= 0 AND x <= mapN AND y <= mapN THEN
            IF mv(x, y) THEN
                lvlBarrel(k, 1) = x + dx : lvlBarrel(k, 2) = y + dy
            ELSEIF dest(x, y) THEN
                FOR j = k TO lvlNumBarrels - 1 : FOR c = 1 TO 4 : lvlBarrel(j, c) = lvlBarrel(j + 1, c) : NEXT : NEXT
                lvlNumBarrels = lvlNumBarrels - 1
            END IF
        END IF
    NEXT
    FOR k = lvlNumNudges TO 1 STEP -1
        x = lvlNudge(k, 1) : y = lvlNudge(k, 2)
        IF x >= 0 AND y >= 0 AND x <= mapN AND y <= mapN THEN
            IF mv(x, y) THEN
                lvlNudge(k, 1) = x + dx : lvlNudge(k, 2) = y + dy
            ELSEIF dest(x, y) THEN
                FOR j = k TO lvlNumNudges - 1 : FOR c = 1 TO 5 : lvlNudge(j, c) = lvlNudge(j + 1, c) : NEXT : NEXT
                lvlNumNudges = lvlNumNudges - 1
            END IF
        END IF
    NEXT
    FOR k = lvlNumFaces TO 1 STEP -1
        x = lvlFaceX(k) : y = lvlFaceY(k)
        IF x >= 0 AND y >= 0 AND x <= mapN AND y <= mapN THEN
            IF mv(x, y) THEN
                lvlFaceX(k) = x + dx : lvlFaceY(k) = y + dy
            ELSEIF dest(x, y) THEN
                EditSetFace x, y, lvlFaceS(k), 0, "", ""
            END IF
        END IF
    NEXT
    FOR k = 1 TO lvlNumPairs
        FOR e = 0 TO 2 STEP 2
            x = lvlPair(k, 1 + e) : y = lvlPair(k, 2 + e)
            IF x >= 0 AND y >= 0 AND x <= mapN AND y <= mapN THEN IF mv(x, y) THEN lvlPair(k, 1 + e) = x + dx : lvlPair(k, 2 + e) = y + dy
        NEXT
    NEXT
END SUB

' G: the grid over the world on or off; Shift+G: stronger (25, 50, 75, 100%,
' round again)
SUB EditGridKey(shiftOn)
    IF shiftOn THEN
        edGrid = -1 : edGridAlpha = edGridAlpha + 64 : IF edGridAlpha > 255 THEN edGridAlpha = 63
        EditNote "Grid" + STR$(INT(edGridAlpha * 100 / 255 + 0.5)) + "%"
    ELSE
        edGrid = NOT edGrid : IF edGrid THEN EditNote "Grid on (Shift+G: stronger)" ELSE EditNote "Grid off"
    END IF
END SUB

' THE GRID, in the software renderer: a texel on a cell's edge (or where a
' wall's picture starts again, a wall high) mixed towards cyan by how
' strong the grid is - EditGridOn (and gridW, how thick in texels) set
' once a frame, so the drawing only asks one question when it's off
FUNCTION GridMix~&(pix~&)
    DIM a, B, g, r ' (its own: the main program shares these names)
    a = edGridAlpha / 255
    r = (pix~& \ 65536) AND 255 : g = (pix~& \ 256) AND 255 : b = pix~& AND 255
    GridMix~& = &HFF000000~& OR (INT(r + (90 - r) * a) * 65536) OR (INT(g + (230 - g) * a) * 256) OR INT(b + (255 - b) * a)
END FUNCTION

' The open cell a side of cell (x, y) looks into (side 1 east, 2 south,
' 3 west, 4 north)
SUB EditFaceFront(x, y, side, fx, fy)
    fx = x : fy = y
    SELECT CASE side
        CASE 1 : fx = x + 1
        CASE 2 : fy = y + 1
        CASE 3 : fx = x - 1
        CASE ELSE : fy = y - 1
    END SELECT
END SUB

SUB EditHit(kind, x, y, side, hx, hy, hz)
    edHovKind = kind : edHovX = x : edHovY = y : edHovSide = side
    edHovPX = hx : edHovPY = hy : edHovPZ = hz
    edHovPart = EditFacePart(kind, x, y, side, hx, hy, hz)
END SUB

' An upright face's place: the edge it's on, (ax, ay) to (bx, by), and its
' bottom and top, z0 and z1
SUB EditFaceRect(kind, x, y, side, ax, ay, bx, by, z0, z1, ok)
    DIM e, x0, y0, y1 ' (its own: the main program shares these names)
    ok = 0
    IF kind = ED_BOX THEN ' (a box's side: where it stands in its cell, floor to ceiling)
        IF boxOn(x, y) = 0 THEN EXIT SUB
        x0 = x + boxX0(x, y) : x1 = x + boxX1(x, y) : y0 = y + boxY0(x, y) : y1 = y + boxY1(x, y)
        SELECT CASE side
            CASE 1 : ax = x1 : ay = y0 : bx = x1 : by = y1
            CASE 2 : ax = x0 : ay = y1 : bx = x1 : by = y1
            CASE 3 : ax = x0 : ay = y0 : bx = x0 : by = y1
            CASE ELSE : ax = x0 : ay = y0 : bx = x1 : by = y0
        END SELECT
        z0 = floorH(x, y) : z1 = ceilH(x, y) : ok = -1
        EXIT SUB
    END IF
    IF kind = ED_DIAG THEN ' (a diagonal's slanted face, corner to corner: from a, where its picture starts, to b)
        IF diagCorner(x, y) = 0 THEN EXIT SUB
        IF diagCorner(x, y) = 1 OR diagCorner(x, y) = 3 THEN ax = x : ay = y + 1 : bx = x + 1 : by = y ELSE ax = x : ay = y : bx = x + 1 : by = y + 1
        IF diagCorner(x, y) > 2 THEN SWAP ax, bx : SWAP ay, by
        z0 = floorH(x, y) : z1 = ceilH(x, y) : ok = -1
        EXIT SUB
    END IF
    IF kind = ED_DEDGE THEN ' (a door's edge - a sliding door's, a split door's first: square to it, across its thickness; a shutter's underside is flat - EditFaceOutline)
        IF NOT EditDoorIn(x, y) OR doorType(x, y) = DOOR_SHUTTER OR doorType(x, y) = DOOR_EXIT THEN EXIT SUB
        e = DoorShown(x, y) : IF doorType(x, y) = DOOR_SPLIT THEN e = 0.5 - e / 2
        IF DoorAcross(x, y) = 0 THEN
            ax = x + e : bx = ax : ay = y + 0.5 - DOOR_THICK / 2 : by = y + 0.5 + DOOR_THICK / 2
        ELSE
            ay = y + e : by = ay : ax = x + 0.5 - DOOR_THICK / 2 : bx = x + 0.5 + DOOR_THICK / 2
        END IF
        z0 = floorH(x, y) : z1 = ceilH(x, y) : ok = -1
        EXIT SUB
    END IF
    IF kind = ED_WALL AND EditDoorIn(x, y) THEN ' (a door's face: its slab across the doorway's middle, its own floor to ceiling)
        IF DoorAcross(x, y) = 0 THEN
            ax = x : bx = x + 1 : ay = y + 0.5 + DOOR_THICK / 2 : IF side = 4 THEN ay = y + 0.5 - DOOR_THICK / 2
            by = ay
        ELSE
            ay = y : by = y + 1 : ax = x + 0.5 + DOOR_THICK / 2 : IF side = 3 THEN ax = x + 0.5 - DOOR_THICK / 2
            bx = ax
        END IF
        z0 = floorH(x, y) : z1 = ceilH(x, y) : ok = -1
        EXIT SUB
    END IF
    SELECT CASE side ' (the edge, and the open cell on its far side)
        CASE 1 : ax = x + 1 : ay = y : bx = x + 1 : by = y + 1 : ox = x + 1 : oy = y
        CASE 2 : ax = x : ay = y + 1 : bx = x + 1 : by = y + 1 : ox = x : oy = y + 1
        CASE 3 : ax = x : ay = y : bx = x : by = y + 1 : ox = x - 1 : oy = y
        CASE ELSE : ax = x : ay = y : bx = x + 1 : by = y : ox = x : oy = y - 1
    END SELECT
    IF ox < 0 OR oy < 0 OR ox >= mapN OR oy >= mapN THEN EXIT SUB
    SELECT CASE kind
        CASE ED_WALL : z0 = floorH(ox, oy) : z1 = ceilH(ox, oy)
        CASE ED_STEP : z0 = floorH(ox, oy) : z1 = floorH(x, y)
        CASE ELSE : z0 = ceilH(x, y) : z1 = ceilH(ox, oy)
    END SELECT
    ok = -1
END SUB

' Which piece of a divided face the point (hx, hy, hz) on it is in - 1...
' (0: it isn't divided). Across is by the picture's u - it runs against
' the edge on east and north faces, with it on south and west, as the
' renderers draw it - and down from the top; on a floor, west to east and
' north to south.
FUNCTION EditFacePart(kind, x, y, side, hx, hy, hz)
    DIM ax, ay, bx, by, ok, t, u, v, z0, z1 ' (its own: the main program shares these names)
    EditFacePart = 0
    IF kind = ED_DEDGE OR kind = ED_TRACK THEN EXIT FUNCTION ' (a door's edges and track: whole, never in pieces)
    EditTreeGet x, y, EditFaceCode(kind, side) : IF ptN < 2 THEN EXIT FUNCTION
    IF kind = ED_FLOOR OR kind = ED_CEIL THEN
        u = hx - x : v = hy - y
    ELSE
        EditFaceRect kind, x, y, side, ax, ay, bx, by, z0, z1, ok : IF NOT ok THEN EXIT FUNCTION
        IF side = 1 OR side = 3 THEN t = hy - y ELSE t = hx - x
        IF side = 1 OR side = 4 THEN u = 1 - t ELSE u = t
        IF kind = ED_DIAG THEN u = (hx - ax) / (bx - ax) ' (a diagonal's: along x, from a)
        IF kind = ED_BOX THEN u = BoxFaceU(x, y, side, u) ' (a block's side: across its own width)
        IF z1 - z0 > 0.001 THEN v = (z1 - hz) / (z1 - z0) ELSE v = 0
    END IF
    EditFacePart = PcLeafAt(ptShape$, u, v)
END FUNCTION

' Is cell (x, y) open - floor, or a thing on floor - rather than a wall, a
' door, a station? (A box from above selects every cell in it, walls too.)
FUNCTION EditCellOpen(x, y)
    EditCellOpen = INSTR("#NCKPG%?@$;/\DHXRBY!E", MID$(lvlRow$(y), x + 1, 1)) = 0
END FUNCTION

' From above: the picture pic$ on cell (x, y) - a wall's (or a closet's,
' a diagonal's) four sides, else its floor (ceil: its ceiling)
SUB EditPaintCell(x, y, pic$, ceil)
    DIM f ' (its own: the main program shares these names)
    IF INSTR("/\", MID$(lvlRow$(y), x + 1, 1)) THEN ' (a diagonal: its slanted face, and the two straight sides by its solid corner)
        FOR f = 1 TO 4
            IF SideTouchesCorner(VAL(MID$("2413", f, 1)), diagCorner(x, y)) THEN EditPaintFace x, y, f, 0, pic$
        NEXT
        EditPaintFace x, y, FACE_DIAG, 0, pic$
    ELSEIF INSTR("#NCKPG%?@$;", MID$(lvlRow$(y), x + 1, 1)) THEN
        FOR f = 1 TO 4 : EditPaintFace x, y, f, 0, pic$ : NEXT
    ELSEIF ceil THEN
        EditPaintFace x, y, 10, 0, pic$
    ELSE
        EditPaintFace x, y, 9, 0, pic$
    END IF
END SUB

' The picture pic$ on face f of (x, y) - on piece `part` of it, if it's
' divided (part 0: the whole of it, every piece). "" is the usual picture.
SUB EditPaintFace(x, y, f, part, pic$)
    DIM j, j0, j1 ' (its own: the main program shares these names)
    IF f <= 4 OR f = 9 OR f = 10 THEN ' (a wall's side, a floor, a ceiling: blood or oil on it - [smears] - or, any other picture, none)
        IF LCASE$(LEFT$(pic$, 6)) = "smear-" THEN SmearSet x, y, FaceName$(f), MID$(pic$, 7, LEN(pic$) - 10) : EXIT SUB
        SmearSet x, y, FaceName$(f), ""
    END IF
    EditTreeGet x, y, f : EditPcRange part, j0, j1
    FOR j = j0 TO j1 : ptPic$(j) = pic$ : NEXT
    EditTreePut x, y, f
END SUB

' A point in the world on the screen (sx, sy) - or ok = 0 if it's behind
' you. The pointer's sums the right way round: how far right, up and ahead
' of the camera it is, divided by how far ahead.
SUB EditCam(wx, wy, wz, cr, cu, ca)
    DIM c, r ' (its own: the main program shares these names)
    rx = wx - edCamPX : ry = wy - edCamPY : rz = wz - eyeZ
    r = ry * edCamDX - rx * edCamDY : u0 = rz : bk = -(rx * edCamDX + ry * edCamDY)
    c = COS(pitch) : sn = SIN(pitch)
    cr = r : cu = c * u0 + sn * bk : ca = -(-sn * u0 + c * bk)
END SUB

' A thing standing in a cell (a monster, a pickup, a decoration, a pad)
' under the screen point (sx, sy), nearer than the face picked: then it's
' what's picked - its cell's floor - so clicking a monster selects it
SUB EditPickThing(sx, sy)
    DIM a, best, bx, by, c$, ok, px, py, r, x, x0, y, y0, y1, tz ' (its own: the main program shares these names)
    edHovThing = 0
    faceA = 999 : IF edHovKind THEN EditCam edHovPX, edHovPY, edHovPZ, r, u, faceA
    best = 0 : bestA = faceA + 0.3
    x0 = MaxOf(0, INT(edCamPX) - 16) : x1 = MinOf(mapN - 1, INT(edCamPX) + 16)
    y0 = MaxOf(0, INT(edCamPY) - 16) : y1 = MinOf(mapN - 1, INT(edCamPY) + 16)
    FOR y = y0 TO y1 : FOR x = x0 TO x1
        c$ = MID$(lvlRow$(y), x + 1, 1)
        IF INSTR("mghcskwzT15670~_|]rby+*uae234Mqj89)({}`,oiptxlnfSdAFIJLOQUWZV:['&" + CHR$(34), c$) THEN
            tz = floorH(x, y) + 0.35 ' (where it is: a thing on the floor - a turret on the ceiling, or on a wall)
            IF c$ = "~" THEN tz = ceilH(x, y) - 0.3 ELSE IF c$ = "|" THEN tz = floorH(x, y) + 0.57
            EditCam x + 0.5, y + 0.5, tz, r, u, a
            IF a > 0.3 AND a < bestA THEN
                EditPoint x + 0.5, y + 0.5, tz, px, py, ok
                rp = 0.38 * 600 * edCamZoom / a ' (about the size of a sprite, on the screen)
                IF ok AND ABS(sx - px) < rp * 0.75 AND ABS(sy - py) < rp THEN best = -1 : bestA = a : bx = x : by = y
            END IF
        END IF
    NEXT : NEXT
    IF best THEN
        edHovKind = ED_FLOOR : edHovX = bx : edHovY = by : edHovSide = 0 : edHovPart = 0 : edHovThing = -1
        edHovPX = bx + 0.5 : edHovPY = by + 0.5 : edHovPZ = floorH(bx, by)
    END IF
END SUB

' A point in the world on the screen: (sx, sy), ok = 0 if it's behind you
SUB EditPoint(wx, wy, wz, sx, sy, ok)
    DIM a, r ' (its own: the main program shares these names)
    EditCam wx, wy, wz, r, u, a : ok = 0
    IF a < 0.05 THEN EXIT SUB
    ak = 1 ' (FULL WIDE too: our screen is the wide view's 4:3 middle)
    sx = (r / (a * edCamPlane * ak) + 1) * 400 : sy = (1 - u * 2 * edCamZoom / a) * 300 : ok = -1
END SUB

' A line in the world, on the screen: cut where it passes behind you (so
' half of a face behind you still draws its front half)
SUB EditLine3D(x1, y1, z1, x2, y2, z2, col~&)
    DIM f ' (its own: the main program shares these names)
    EditCam x1, y1, z1, r1, u1, a1 : EditCam x2, y2, z2, r2, u2, a2
    nr = 0.05
    IF a1 < nr AND a2 < nr THEN EXIT SUB
    IF a1 < nr THEN f = (nr - a1) / (a2 - a1) : r1 = r1 + (r2 - r1) * f : u1 = u1 + (u2 - u1) * f : a1 = nr
    IF a2 < nr THEN f = (nr - a2) / (a1 - a2) : r2 = r2 + (r1 - r2) * f : u2 = u2 + (u1 - u2) * f : a2 = nr
    ak = 1 ' (FULL WIDE too: our screen is the wide view's 4:3 middle)
    sx1 = (r1 / (a1 * edCamPlane * ak) + 1) * 400 : sy1 = (1 - u1 * 2 * edCamZoom / a1) * 300
    sx2 = (r2 / (a2 * edCamPlane * ak) + 1) * 400 : sy2 = (1 - u2 * 2 * edCamZoom / a2) * 300
    IF ABS(sx1) > 20000 OR ABS(sy1) > 20000 OR ABS(sx2) > 20000 OR ABS(sy2) > 20000 THEN EXIT SUB
    sx1 = sx1 + edWX : sx2 = sx2 + edWX ' (FULL WIDE: drawn on the canvas, our screen in its middle)
    LINE (sx1, sy1)-(sx2, sy2), col~&
    LINE (sx1 + 1, sy1)-(sx2 + 1, sy2), col~& ' (two pixels wide)
END SUB

' A face's outline: a floor or ceiling's square, or a side's rectangle -
' from the open cell's floor to its ceiling, for a wall; the step's height,
' for a step or a lintel (the open cell beside it is on its other side).
' Divided: piece `part` (0: the whole face) in col - col 0: every piece,
' faintly (drawn first, under the outlines)
SUB EditFaceOutline(kind, x, y, side, part, col~&)
    DIM ax, ay, bx, by, j, n, ok, z, z0, z1 ' (its own: the main program shares these names)
    SELECT CASE kind
        CASE ED_FLOOR, ED_CEIL
            IF kind = ED_FLOOR THEN z = floorH(x, y) ELSE z = ceilH(x, y)
        CASE ED_WALL, ED_STEP, ED_LINTEL, ED_BOX, ED_DIAG
            EditFaceRect kind, x, y, side, ax, ay, bx, by, z0, z1, ok : IF NOT ok THEN EXIT SUB
        CASE ED_TRACK, ED_DEDGE ' (a door's track, floor and ceiling; its edges - a shutter's underside)
            IF col~& = 0 THEN EXIT SUB
            IF kind = ED_TRACK THEN
                EditDoorStrip x, y, TRACK_HALF, floorH(x, y) + 0.01, col~& : EditDoorStrip x, y, TRACK_HALF, ceilH(x, y) - 0.01, col~&
            ELSEIF doorType(x, y) = DOOR_SHUTTER THEN
                EditDoorStrip x, y, DOOR_THICK / 2, floorH(x, y) + DoorShown(x, y) * (ceilH(x, y) - floorH(x, y)) - 0.01, col~&
            ELSE
                EditFaceRect kind, x, y, side, ax, ay, bx, by, z0, z1, ok : IF NOT ok THEN EXIT SUB
                EditFaceBox kind, x, y, 2, ax, ay, bx, by, 0, z0, z1, 0, 0, 1, 1, col~&
                IF doorType(x, y) = DOOR_SPLIT THEN ' (and its other edge)
                    IF DoorAcross(x, y) = 0 THEN ax = 2 * x + 1 - ax : bx = ax ELSE ay = 2 * y + 1 - ay : by = ay
                    EditFaceBox kind, x, y, 2, ax, ay, bx, by, 0, z0, z1, 0, 0, 1, 1, col~&
                END IF
            END IF
            EXIT SUB
        CASE ELSE : EXIT SUB
    END SELECT
    EditTreeGet x, y, EditFaceCode(kind, side) : n = PcRects(ptShape$)
    IF col~& = 0 THEN
        IF n > 1 THEN
            FOR j = 1 TO n : EditFaceBox kind, x, y, side, ax, ay, bx, by, z, z0, z1, pcRU0(j), pcRV0(j), pcRU1(j), pcRV1(j), _RGBA32(255, 255, 255, 110) : NEXT
        END IF
    ELSEIF part >= 1 AND part <= n THEN
        EditFaceBox kind, x, y, side, ax, ay, bx, by, z, z0, z1, pcRU0(part), pcRV0(part), pcRU1(part), pcRV1(part), col~&
    ELSE
        EditFaceBox kind, x, y, side, ax, ay, bx, by, z, z0, z1, 0, 0, 1, 1, col~&
    END IF
END SUB

' A rectangle on a face - u0 to u1 across, v0 to v1 down (0 to 1: as
' EditFacePart reads them) - drawn: a floor's or ceiling's at height z, an
' upright one's on its edge (ax, ay)-(bx, by) from z1 at the top to z0
SUB EditFaceBox(kind, x, y, side, ax, ay, bx, by, z, z0, z1, u0, v0, u1, v1, col~&)
    DIM i, u, v ' (its own: the main program shares these names)
    DIM px(4), py(4), pz(4)
    FOR i = 1 TO 4
        IF i = 2 OR i = 3 THEN u = u1 ELSE u = u0
        IF i >= 3 THEN v = v1 ELSE v = v0
        IF kind = ED_FLOOR OR kind = ED_CEIL THEN
            px(i) = x + u : py(i) = y + v : pz(i) = z
        ELSE
            IF side = 1 OR side = 4 THEN ' (u runs from b back to a on east and north faces)
                px(i) = bx + u * (ax - bx) : py(i) = by + u * (ay - by)
            ELSE
                px(i) = ax + u * (bx - ax) : py(i) = ay + u * (by - ay)
            END IF
            pz(i) = z1 - v * (z1 - z0)
        END IF
    NEXT
    EditLine3D px(1), py(1), pz(1), px(2), py(2), pz(2), col~& : EditLine3D px(2), py(2), pz(2), px(3), py(3), pz(3), col~&
    EditLine3D px(3), py(3), pz(3), px(4), py(4), pz(4), col~& : EditLine3D px(4), py(4), pz(4), px(1), py(1), pz(1), col~&
END SUB

' The 3D editor's outlines, over the view: the face under the pointer
' (cyan, pulsing) - and what it is, by the pointer
SUB EditDrawFaces
    DIM cx, cy, c~&, k, ok, sx, sy, tx, ty, lbX, lbOU, lbOV, lbKU, lbKV ' (its own: the main program shares these names)
    IF edTool = ET_PLACE AND edHovKind AND NOT edLooking THEN ' PLACE: where it would go - a box on that cell's floor, and up from it
        EditFaceCell edHovKind, edHovX, edHovY, edHovSide, tx, ty
        IF tx > 0 AND ty > 0 AND tx < mapN - 1 AND ty < mapN - 1 THEN
            z = floorH(tx, ty) : zt = z + 0.6 : IF zt > ceilH(tx, ty) THEN zt = ceilH(tx, ty)
            c~& = _RGBA32(255, 60, 200, 200)
            EditLine3D tx, ty, z, tx + 1, ty, z, c~& : EditLine3D tx + 1, ty, z, tx + 1, ty + 1, z, c~&
            EditLine3D tx + 1, ty + 1, z, tx, ty + 1, z, c~& : EditLine3D tx, ty + 1, z, tx, ty, z, c~&
            FOR cx = 0 TO 1 : FOR cy = 0 TO 1 : EditLine3D tx + cx, ty + cy, z, tx + cx, ty + cy, zt, _RGBA32(255, 60, 200, 110) : NEXT : NEXT
            EditPoint tx + 0.5, ty + 0.5, z + 0.3, sx, sy, ok
            IF ok THEN
                STATIC ghostOf$, ghostImg&
                IF ghostOf$ <> editGlyph$ + STR$(artNow) THEN
                    IF ghostImg& < -1 THEN _FREEIMAGE ghostImg&
                    ghostImg& = EditGlyphThumb&(editGlyph$) : ghostOf$ = editGlyph$ + STR$(artNow)
                    IF ghostImg& < -1 THEN _SETALPHA 150, &H01000000~& TO &HFFFFFFFF~&, ghostImg& ' (see-through: a ghost of it - its clear parts stay clear)
                END IF
                IF ghostImg& < -1 THEN _PUTIMAGE (sx + edWX - 20, sy - 20)-STEP(39, 39), ghostImg&
            END IF
        END IF
    END IF
    FOR k = 1 TO lvlNumLights ' The lights: a little star each, in its colour, halfway up its cell
        lx = lvlLight(k, 1) : ly = lvlLight(k, 2) : cx = INT(lx) : cy = INT(ly)
        IF cx >= 0 AND cy >= 0 AND cx < mapN AND cy < mapN THEN
            lz = (floorH(cx, cy) + ceilH(cx, cy)) / 2 : c~& = _RGB32(lvlLight(k, 5), lvlLight(k, 6), lvlLight(k, 7))
            EditLine3D lx - 0.1, ly, lz, lx + 0.1, ly, lz, c~& : EditLine3D lx, ly - 0.1, lz, lx, ly + 0.1, lz, c~& : EditLine3D lx, ly, lz - 0.1, lx, ly, lz + 0.1, c~&
        END IF
    NEXT
    FOR k = 1 TO numPads - 1 STEP 2 ' Teleporters: each pad joined to the one it goes to
        EditLine3D padX(k) + 0.5, padY(k) + 0.5, floorH(padX(k), padY(k)) + 0.05, padX(k + 1) + 0.5, padY(k + 1) + 0.5, floorH(padX(k + 1), padY(k + 1)) + 0.05, _RGBA32(190, 110, 255, 170)
    NEXT
    FOR k = 1 TO edSelN ' A monster selected: how far it sees (cyan) and hears (yellow), on the floor round it
        IF MonOfChar(MID$(lvlRow$(edSelY(k)), edSelX(k) + 1, 1)) THEN
            EditMonGet edSelX(k), edSelY(k), ms, mh, mhp, msp, mw, mwp, mtr, mej, mst
            z = floorH(edSelX(k), edSelY(k)) + 0.02
            IF mw <> WAKE_HIT AND mw <> WAKE_HUNT THEN EditRing edSelX(k) + 0.5, edSelY(k) + 0.5, ms, z, _RGBA32(90, 230, 255, 190)
            IF mw <> WAKE_HIT AND mw <> WAKE_HUNT THEN EditRing edSelX(k) + 0.5, edSelY(k) + 0.5, mh, z, _RGBA32(255, 220, 60, 190)
        END IF
    NEXT
    FOR k = 1 TO edSelN ' Faces divided: their pieces, faintly - then the selection over them, orange
        EditFaceOutline edSelKind(k), edSelX(k), edSelY(k), edSelSide(k), 0, 0
    NEXT
    IF edHovKind THEN EditFaceOutline edHovKind, edHovX, edHovY, edHovSide, 0, 0
    FOR k = 1 TO edSelN
        EditFaceOutline edSelKind(k), edSelX(k), edSelY(k), edSelSide(k), edSelPart(k), _RGB32(255, 170, 40)
    NEXT
    IF edHovKind THEN
        k = 160 + 95 * SIN(TIMER * 6)
        EditFaceOutline edHovKind, edHovX, edHovY, edHovSide, edHovPart, _RGB32(60, k, 255)
        IF NOT edLooking THEN
            n$ = EditKindName$(edHovKind)
            IF edHovKind = ED_WALL THEN IF EditDoorIn(edHovX, edHovY) THEN n$ = "DOOR"
            IF edHovKind = ED_TRACK THEN n$ = "DOOR TRACK"
            IF edHovThing THEN n$ = GlyphName$(CellGlyph$(edHovX, edHovY)) : IF INSTR(n$, " (") THEN n$ = LEFT$(n$, INSTR(n$, " (") - 1) ' (its name, not the note after it)
            IF edHovThing THEN n$ = UCASE$(LEFT$(n$, 20))
            n$ = RTRIM$(n$) + STR$(edHovX) + "," + LTRIM$(STR$(edHovY))
            IF edHovKind <> ED_FLOOR AND edHovKind <> ED_CEIL AND edHovSide >= 1 THEN n$ = n$ + " " + MID$("ESWN", edHovSide, 1)
            IF NOT edHovThing THEN ' (its piece, and its picture's look: slid, stretched, turned, tinted)
                EditTreeGet edHovX, edHovY, EditFaceCode(edHovKind, edHovSide)
                IF edHovPart >= 1 AND edHovPart <= ptN THEN n$ = n$ + "  piece" + STR$(edHovPart) + " of" + STR$(ptN) : lbX = edHovPart ELSE lbX = 1
                IF LEN(EditLookName$(lbX)) THEN n$ = n$ + "  " + EditLookName$(lbX)
            END IF
            lbX = edCurX + edWX + 14 : IF lbX + TinyW(n$) > scrW - 4 THEN lbX = edCurX + edWX - 14 - TinyW(n$) ' (by the window's right edge: on the pointer's left)
            TinyText lbX, edCurY + 14, n$, _RGB32(150, 230, 255)
        END IF
    END IF
END SUB

SUB EditOverlay(px, py, fx, fy)
    DIM B, my ' (its own: the main program shares these names)
    LINE (8, 34)-(330, 80), _RGBA32(6, 2, 18, 190), BF ' (small print: under the toolbar)
    LINE (8, 34)-(330, 80), _RGB32(255, 60, 200), B
    TinyText 14, 38, "TOOL: " + RTRIM$(MID$("SELECTPLACE PAINT LIGHT HEIGHT", edTool * 6 - 5, 6)), _RGB32(255, 90, 200)
    IF edTool = ET_LIGHT THEN
        TinyText 14, 48, "LIGHT: " + EditFxName$(edLFx) + " reach" + STR$(edLRad) + MID$(" (no lamp)", 1, -10 * (edLNoLamp <> 0)), _RGB32(edLR, edLG, edLB)
    ELSEIF edTool = ET_PAINT THEN
        TinyText 14, 48, LEFT$("PICTURE: " + EditPaintName$, 70), _RGB32(150, 240, 255)
    ELSE
        TinyText 14, 48, LEFT$("BRUSH: " + GlyphName$(editGlyph$), 70), GlyphColor~&(editGlyph$)
    END IF
    IF edSelN THEN TinyText 14, 58, LTRIM$(STR$(edSelN)) + " selected (Ctrl+D: none)", _RGB32(255, 190, 80) ELSE TinyText 14, 58, "Nothing selected", _RGB32(140, 130, 180)
    IF editDirty THEN TinyText 14, 68, "* not saved (Ctrl+S)", _RGB32(255, 90, 90) ELSE TinyText 14, 68, "Saved", _RGB32(140, 130, 180)
    IF TIMER < editMsgUntil! THEN
        my = 470 : IF edPickOpen AND editView = 1 THEN my = PK_Y - 30 ' (above the picker)
        IF edPickOn AND NOT edPickOpen AND editView = 1 THEN my = PK_TUCK - 24
        IF editView = 1 THEN HudAt -1 ' (FULL WIDE: all the way across)
        LINE (0, my + 4)-(scrW - 1, my + 18), _RGBA32(0, 0, 0, 170), BF
        TinyText scrW \ 2 - TinyW(editMsg$) \ 2, my + 7, editMsg$, _RGB32(255, 220, 120)
        IF editView = 1 THEN HudAt 0
    END IF
END SUB

' From (px, py) looking (fx, fy): the first cell that isn't open floor
' (ax, ay) - a wall, a door, glass, or a thing - and the open cell just
' before it (bx, by), where something built would go. -1 if nothing near.
SUB EditAim(px, py, fx, fy, ax, ay, bx, by)
    DIM c$, cx, cy, d ' (its own: the main program shares these names)
    ax = -1 : ay = -1 : bx = -1 : by = -1
    lx = INT(px) : ly = INT(py)
    FOR d = 0.3 TO 12 STEP 0.05
        cx = INT(px + fx * d) : cy = INT(py + fy * d)
        IF cx < 0 OR cy < 0 OR cx >= mapN OR cy >= mapN THEN EXIT SUB
        IF cx <> INT(px) OR cy <> INT(py) THEN
            c$ = MID$(lvlRow$(cy), cx + 1, 1)
            IF c$ <> "." THEN
                ax = cx : ay = cy
                IF lx <> cx OR ly <> cy THEN bx = lx : by = ly
                IF bx = INT(px) AND by = INT(py) THEN bx = -1 : by = -1 ' (not where you stand)
                EXIT SUB
            END IF
        END IF
        lx = cx : ly = cy
    NEXT
END SUB

' The next (or previous: d = -1) picture called prefix*.png in the
' pictures' folder, after now$ (in name order)
FUNCTION EditNextPicture$(prefix$, now$, d)
    DIM a, B, k, n ' (its own: the main program shares these names)
    DIM names$(200)
    n = 0
    dir$ = AssetPath$("x") : dir$ = LEFT$(dir$, LEN(dir$) - 1)
    f$ = _FILES$(dir$ + prefix$ + "*.png")
    DO WHILE LEN(f$) AND n < 200
        b$ = f$ : sl = _INSTRREV(b$, "/") : IF sl THEN b$ = MID$(b$, sl + 1)
        IF b$ <> "wall-jack.png" AND b$ <> "ceiling-lamp.png" THEN n = n + 1 : names$(n) = b$
        f$ = _FILES$
    LOOP
    IF n = 0 THEN EditNextPicture$ = now$ : EXIT FUNCTION
    FOR a = 1 TO n - 1 : FOR b = a + 1 TO n ' (in order)
        IF names$(b) < names$(a) THEN SWAP names$(a), names$(b)
    NEXT : NEXT
    at = 0
    FOR k = 1 TO n
        IF names$(k) = now$ THEN at = k
    NEXT
    at = at + d : IF at < 1 THEN at = n
    IF at > n THEN at = 1
    EditNextPicture$ = names$(at)
END FUNCTION

' Cell (x, y)'s floor (or, with ceil, its ceiling) up by d - in the
' level's [floor] / [ceiling] map
SUB EditRaise(x, y, d, ceil)
    IF x < 1 OR y < 1 OR x > mapN - 2 OR y > mapN - 2 THEN EXIT SUB
    IF ceil THEN
        h = HeightOf(MID$(lvlCeilRow$(y), x + 1, 1), 1) + d
        IF h < HeightOf(MID$(lvlFloorRow$(y), x + 1, 1), 0) + 0.25 THEN EXIT SUB
        MID$(lvlCeilRow$(y), x + 1, 1) = HeightChar$(h, 1)
    ELSE
        h = HeightOf(MID$(lvlFloorRow$(y), x + 1, 1), 0) + d
        IF h > HeightOf(MID$(lvlCeilRow$(y), x + 1, 1), 1) - 0.25 OR h < -8 * H_STEP THEN EXIT SUB
        MID$(lvlFloorRow$(y), x + 1, 1) = HeightChar$(h, 0)
    END IF
END SUB

' A floor/ceiling zone (chapter 22) on the end of the list (the last one
' wins) - one just as big in just that place before it goes: Z again and
' again on a cell is one zone, not a new one each time
SUB EditAddZone(x0, y0, x1, y1, fl, ce)
    DIM c, j, k ' (its own: the main program shares these names)
    FOR k = lvlNumZones TO 1 STEP -1
        IF lvlZone(k, 1) = x0 AND lvlZone(k, 2) = y0 AND lvlZone(k, 3) = x1 AND lvlZone(k, 4) = y1 AND lvlZone(k, 7) = 0 THEN
            IF ce = 0 THEN ce = lvlZone(k, 6) ' (its ceiling stays, unless this one says otherwise)
            IF fl = 0 THEN fl = lvlZone(k, 5)
            FOR j = k TO lvlNumZones - 1 : FOR c = 1 TO 7 : lvlZone(j, c) = lvlZone(j + 1, c) : NEXT : NEXT
            lvlNumZones = lvlNumZones - 1
        END IF
    NEXT
    IF lvlNumZones >= MAX_ZONES THEN EXIT SUB
    lvlNumZones = lvlNumZones + 1
    lvlZone(lvlNumZones, 1) = x0 : lvlZone(lvlNumZones, 2) = y0 : lvlZone(lvlNumZones, 3) = x1 : lvlZone(lvlNumZones, 4) = y1
    lvlZone(lvlNumZones, 5) = fl : lvlZone(lvlNumZones, 6) = ce : lvlZone(lvlNumZones, 7) = 0
END SUB

' The editor's lights: eight ready-made kinds (editLightP)
FUNCTION LightPresetName$(p)
    LightPresetName$ = RTRIM$(MID$("white      cyan       magenta    orange     green      red alarm  flickering firelight  ", p * 11 + 1, 11))
END FUNCTION
' The keys 1-8: a tool (1 SELECT, 2 PLACE, 3 PAINT, 4 LIGHT, 5 HEIGHT) or
' a pane (6 THE SECTOR, 7 VERSIONS) - as its toolbar button - or 8 the
' picker opened and left open (8 again: tucked away)
SUB EditNumKey(n)
    SELECT CASE n
        CASE 1 : tbHit = TB_SELECT
        CASE 2 : tbHit = TB_PLACE
        CASE 3 : tbHit = TB_PAINT
        CASE 4 : tbHit = TB_LIGHT
        CASE 5 : tbHit = TB_HEIGHT
        CASE 6 : tbHit = TB_SECTOR
        CASE 7 : tbHit = TB_VERSIONS
        CASE ELSE
            IF edPickOn = -1 THEN edPickOn = 1 : EditNote "Picker: tucked away (8: open it)" ELSE edPickOn = -1 : EditNote "Picker: open (8 again: tucked away)"
            EXIT SUB
    END SELECT
    EditTBClick
END SUB

' Preset p (0-7) as the light brush - a room's light, five
' cells across
SUB EditLightPreset(p)
    editLightP = p : edLRad = 5 : edLBri = 140 : edLFx = FX_STEADY
    SELECT CASE p
        CASE 0 : edLR = 230 : edLG = 235 : edLB = 255
        CASE 1 : edLR = 60 : edLG = 220 : edLB = 255
        CASE 2 : edLR = 255 : edLG = 60 : edLB = 220
        CASE 3 : edLR = 255 : edLG = 160 : edLB = 60
        CASE 4 : edLR = 90 : edLG = 255 : edLB = 120
        CASE 5 : edLR = 255 : edLG = 40 : edLB = 40 : edLFx = FX_STROBE
        CASE 6 : edLR = 220 : edLG = 230 : edLB = 255 : edLFx = FX_FLICKER
        CASE ELSE : edLR = 255 : edLG = 150 : edLB = 70 : edLFx = FX_FIRE
    END SELECT
END SUB

' A light at (x, y), as the light brush is
SUB EditAddLight(x, y)
    DIM k ' (its own: the main program shares these names)
    IF lvlNumLights >= MAX_LIGHTS THEN EditNote "Too many lights" : EXIT SUB
    lvlNumLights = lvlNumLights + 1 : k = lvlNumLights
    lvlLight(k, 1) = x : lvlLight(k, 2) = y : lvlLight(k, 3) = edLRad : lvlLight(k, 4) = edLBri : lvlLight(k, 8) = edLFx : lvlLight(k, 9) = edLNoLamp
    lvlLight(k, 5) = edLR : lvlLight(k, 6) = edLG : lvlLight(k, 7) = edLB
    EditNote "Light (" + EditFxName$(edLFx) + ") at" + STR$(INT(x)) + STR$(INT(y))
END SUB

' An effect's name (FX_)
FUNCTION EditFxName$(fx)
    EditFxName$ = RTRIM$(MID$("STEADY  FLICKER PULSE   STROBE  FIRE    DYING   ", fx * 8 + 1, 8))
END FUNCTION

' Colour n (1-12) of the picker's lights
FUNCTION EditPaletteRGB~&(n)
    DIM c~& ' (its own: the main program shares these names)
    SELECT CASE n
        CASE 1 : c~& = _RGB32(230, 235, 255) ' white
        CASE 2 : c~& = _RGB32(255, 215, 160) ' warm white
        CASE 3 : c~& = _RGB32(60, 220, 255) ' cyan
        CASE 4 : c~& = _RGB32(60, 110, 255) ' blue
        CASE 5 : c~& = _RGB32(255, 60, 220) ' magenta
        CASE 6 : c~& = _RGB32(170, 80, 255) ' purple
        CASE 7 : c~& = _RGB32(255, 40, 40) ' red
        CASE 8 : c~& = _RGB32(255, 150, 60) ' orange
        CASE 9 : c~& = _RGB32(255, 230, 60) ' yellow
        CASE 10 : c~& = _RGB32(90, 255, 120) ' green
        CASE 11 : c~& = _RGB32(40, 255, 210) ' teal
        CASE ELSE : c~& = _RGB32(255, 120, 170) ' pink
    END SELECT
    EditPaletteRGB~& = c~&
END FUNCTION

' How bright effect fx is now, 0-1 - as the game's lights go (LightCells),
' for the picker's and the pane's moving previews
FUNCTION EditFxNow(fx)
    DIM f ' (its own: the main program shares these names)
    f = 1
    SELECT CASE fx
        CASE FX_FLICKER : IF (INT(TIMER * 9) MOD 11) = 3 OR (INT(TIMER * 13) MOD 17) = 5 THEN f = 0.15
        CASE FX_PULSE : f = 0.55 + 0.45 * SIN(TIMER * 2.4)
        CASE FX_STROBE : IF INT(TIMER * 2) MOD 2 = 0 THEN f = 1 ELSE f = 0.05
        CASE FX_FIRE : f = 0.75 + RND * 0.25
        CASE FX_DYING : f = 0.08 : IF (INT(TIMER * 7) MOD 9) < 2 THEN f = 0.5 + RND * 0.5
    END SELECT
    EditFxNow = f
END FUNCTION

' A glowing light swatch: colour c~& at brightness f, in the box at (x, y), n square
SUB EditGlow(x, y, n, c~&, f)
    DIM a, cx, cy, g, r ' (its own: the main program shares these names)
    cx = x + n \ 2 : cy = y + n \ 2
    r = _RED32(c~&) * f : g = _GREEN32(c~&) * f : bl = _BLUE32(c~&) * f
    FOR rr = n \ 2 - 2 TO 2 STEP -2
        a = 40 + 200 * (1 - rr / (n / 2))
        CIRCLE (cx, cy), rr, _RGBA32(r, g, bl, a)
    NEXT
    FillCircle cx, cy, n \ 8, _RGB32(MinOf(255, r + 60), MinOf(255, g + 60), MinOf(255, bl + 60))
END SUB

' Where a light on a face sits: just in front of the middle of it (a
' floor's or ceiling's: the middle of its cell)
SUB EditFaceAnchor(kind, x, y, side, ax, ay)
    DIM mx, my ' (its own: the main program shares these names)
    ax = x + 0.5 : ay = y + 0.5
    IF kind = ED_FLOOR OR kind = ED_CEIL THEN EXIT SUB
    IF kind = ED_DIAG THEN ax = x + 0.5 - 0.25 * EditDiagDX(diagCorner(x, y)) : ay = y + 0.5 - 0.25 * EditDiagDY(diagCorner(x, y)) : EXIT SUB ' (in its open half)
    IF kind = ED_BOX THEN ' (a box's side: just in front of its middle)
        IF boxOn(x, y) = 0 THEN EXIT SUB
        mx = x + (boxX0(x, y) + boxX1(x, y)) / 2 : my = y + (boxY0(x, y) + boxY1(x, y)) / 2
        SELECT CASE side
            CASE 1 : ax = x + boxX1(x, y) + 0.12 : ay = my
            CASE 2 : ax = mx : ay = y + boxY1(x, y) + 0.12
            CASE 3 : ax = x + boxX0(x, y) - 0.12 : ay = my
            CASE ELSE : ax = mx : ay = y + boxY0(x, y) - 0.12
        END SELECT
        EXIT SUB
    END IF
    SELECT CASE side
        CASE 1 : ax = x + 1.12
        CASE 2 : ay = y + 1.12
        CASE 3 : ax = x - 0.12
        CASE ELSE : ay = y - 0.12
    END SELECT
END SUB

' The light on a face - the one sitting at its anchor - or 0
FUNCTION EditFaceLight(kind, x, y, side)
    DIM ax, ay, d, fx, fy, k ' (its own: the main program shares these names)
    EditFaceAnchor kind, x, y, side, ax, ay : EditFaceLight = 0
    IF kind = ED_FLOOR OR kind = ED_CEIL THEN ' (a room light needn't be in a cell's middle - NEW SECTOR's sits on a corner: the nearest, within 3/4 of a cell)
        bestD = 0.5625
        FOR k = 1 TO lvlNumLights
            d = (lvlLight(k, 1) - ax) ^ 2 + (lvlLight(k, 2) - ay) ^ 2
            fx = ABS(lvlLight(k, 1) - INT(lvlLight(k, 1)) - 0.5) : fy = ABS(lvlLight(k, 2) - INT(lvlLight(k, 2)) - 0.5)
            IF ABS(fx - 0.38) < 0.03 OR ABS(fy - 0.38) < 0.03 THEN d = 99 ' (a wall's light, 0.12 in front of it: the wall's, not the floor's)
            IF d <= bestD THEN bestD = d : EditFaceLight = k
        NEXT
        EXIT FUNCTION
    END IF
    FOR k = 1 TO lvlNumLights
        IF ABS(lvlLight(k, 1) - ax) < 0.2 AND ABS(lvlLight(k, 2) - ay) < 0.2 THEN EditFaceLight = k
    NEXT
END FUNCTION
SUB EditRemoveLight(x, y)
    DIM best, d, j, k ' (its own: the main program shares these names)
    best = 0 : bestD = 2.25
    FOR k = 1 TO lvlNumLights
        d = (lvlLight(k, 1) - x) ^ 2 + (lvlLight(k, 2) - y) ^ 2
        IF d < bestD THEN bestD = d : best = k
    NEXT
    IF best = 0 THEN EditNote "No light near" : EXIT SUB
    FOR k = best TO lvlNumLights - 1 : FOR j = 1 TO 9 : lvlLight(k, j) = lvlLight(k + 1, j) : NEXT : NEXT
    lvlNumLights = lvlNumLights - 1 : EditNote "Light taken away"
END SUB

' --- The selected cells' own light (CELL LIGHT): op 0 back to the sector's,
' 1 brighter by v (darker, less than 0), 2 colour v of the palette, 3 the
' next effect. A cell with none yet starts from the sector's light.
SUB EditCellLight(op, v)
    DIM k, x, y, nfx ' (its own: the main program shares these names)
    nfx = 1 : IF lvlCLBright(edSelX(1), edSelY(1)) >= 0 THEN nfx = (lvlCLFx(edSelX(1), edSelY(1)) + 1) MOD 6 ' (the next effect: the first cell's next, for every one)
    FOR k = 1 TO edSelN
        x = edSelX(k) : y = edSelY(k)
        IF EditCellLightOK(x, y) THEN
            IF op = 0 THEN
                lvlCLBright(x, y) = -1 : lvlCLFx(x, y) = 0
            ELSE
                IF lvlCLBright(x, y) < 0 THEN lvlCLBright(x, y) = lvlAmb(1) : lvlCLCol(x, y) = _RGB32(lvlAmb(2), lvlAmb(3), lvlAmb(4)) : lvlCLFx(x, y) = 0
                SELECT CASE op
                    CASE 1 : lvlCLBright(x, y) = MaxOf(0, MinOf(256, lvlCLBright(x, y) + v))
                    CASE 2 : lvlCLCol(x, y) = EditPaletteRGB~&(v)
                    CASE 3 : lvlCLFx(x, y) = nfx
                END SELECT
            END IF
        END IF
    NEXT
    IF op = 1 THEN EditNote "Cell light" + STR$(lvlCLBright(edSelX(1), edSelY(1)))
END SUB

' Whether a selected face's cell can have a cell light: in the map, open
FUNCTION EditCellLightOK(x, y)
    EditCellLightOK = (x > 0 AND y > 0 AND x < mapN - 1 AND y < mapN - 1)
END FUNCTION

' --- THE SECTOR, AGAIN - and copies of it (the console's resetlevel,
' reloadlevel, savesectorcopy, saveleveltodisk, loadlevelfromdisk): you
' stay where you are, looking the same way - in the editor or out of it.
' Where you are and the way you look, kept through it
SUB EditKeepPlace(keep)
    STATIC kx!, ky!, kz!, kdx!, kdy!, kp!
    IF keep THEN kx! = playerX : ky! = playerY : kz! = playerZ : kdx! = dirX : kdy! = dirY : kp! = pitch : EXIT SUB
    playerX = kx! : playerY = ky! : dirX = kdx! : dirY = kdy! : pitch = kp!
    planeX = -dirY * fovPlane : planeY = dirX * fovPlane
    playerZ = MaxOf(floorH(INT(playerX), INT(playerY)), kz!) : playerVZ = 0 : eyeZ = playerZ + EYE_H
END SUB

' resetlevel: the sector as it starts - its monsters, doors, pickups - but
' as it is now in the editor (anything not saved yet kept), and you where you are
SUB EditResetLevel
    EditKeepPlace -1
    editRebuild = -1 : BuildLevel : editRebuild = 0 : kills = 0
    EditKeepPlace 0
    IF NOT editFresh THEN editDirty = -1
END SUB

' reloadlevel (f$ ""): the sector from its file, as it was last saved - what
' you'd done since, gone - or loadlevelfromdisk: from another file f$ (a
' copy of it, from savesectorcopy...), in its place: not saved yet - Ctrl+S
' or savelevel makes it the sector's own. You stay where you are.
SUB EditReload(f$)
    EditKeepPlace -1
    lvlReadFrom$ = f$ : ReadLevelFile level : lvlReadFrom$ = ""
    IF NOT lvlOK THEN ReadLevelFile level : ConPrint "^1Can't read that as a level - the sector as it was" ' (its own file again)
    editRebuild = -1 : BuildLevel : editRebuild = 0 : kills = 0
    EditKeepPlace 0
    editUndoN = 0 : editRedoN = 0
    IF LEN(f$) AND lvlOK THEN editDirty = -1 : editFresh = 0 ELSE editDirty = 0 : editFresh = -1
END SUB

' savesectorcopy: a copy of the sector as it is now - next to its file, in
' versions/, named for it and when (custom3-2026-10-20-0815.txt): a history
' of it to go back to (loadlevelfromdisk)
FUNCTION EditSaveCopy$
    DIM f$, d$, b$, k, t$ ' (its own: the main program shares these names)
    f$ = LevelFile$(level)
    k = _INSTRREV(f$, "/") : IF _INSTRREV(f$, "\") > k THEN k = _INSTRREV(f$, "\")
    d$ = LEFT$(f$, k) + "versions" : b$ = MID$(f$, k + 1) : b$ = LEFT$(b$, LEN(b$) - 4)
    IF NOT _DIREXISTS(d$) THEN MKDIR d$
    t$ = MID$(DATE$, 7, 4) + "-" + LEFT$(DATE$, 2) + "-" + MID$(DATE$, 4, 2) + "-" + LEFT$(TIME$, 2) + MID$(TIME$, 4, 2) + MID$(TIME$, 7, 2)
    f$ = d$ + "/" + b$ + "-" + t$ + ".txt"
    WriteLevelFile f$
    EditSaveCopy$ = f$
END FUNCTION

' The folder the sector's copies go in (versions/, beside its file)
FUNCTION EditCopyDir$
    DIM f$, k ' (its own: the main program shares these names)
    f$ = LevelFile$(level) : k = _INSTRREV(f$, "/") : IF _INSTRREV(f$, "\") > k THEN k = _INSTRREV(f$, "\")
    EditCopyDir$ = LEFT$(f$, k) + "versions/"
END FUNCTION

' --- The SECTOR pane's loot presets: 0 as made (the game's table), 1 none,
' 2 a little (half the chances), 3 plenty (half again), 4 lots (twice)
FUNCTION LootSetName$(n)
    LootSetName$ = RTRIM$(MID$("AS MADENONE   LITTLE PLENTY LOTS   ", n * 7 + 1, 7))
END FUNCTION

' ...put into the sector's [loot]: every breakable the game's table has
' loot for, its chances scaled (and 0, none at all)
SUB LootPreset(n)
    DIM k, s, l$, p, f! ' (its own: the main program shares these names)
    lvlNumLoot = 0 : LootTable ' (the game's own, to start from)
    IF n = 0 THEN EXIT SUB
    SELECT CASE n
        CASE 1 : f! = 0
        CASE 2 : f! = 0.5
        CASE 3 : f! = 1.5
        CASE ELSE : f! = 2
    END SELECT
    FOR k = 1 TO DECO_KINDS
        IF lootKind(k, 1) OR lootKind(k, 2) OR lootKind(k, 3) OR lootKind(k, 4) THEN
            l$ = DecoName$(k) + " ="
            FOR s = 1 TO LOOT_SLOTS
                IF s > 1 THEN l$ = l$ + ","
                p = INT(lootPct(k, s) * f! + 0.5)
                IF lootKind(k, s) AND p > 0 THEN l$ = l$ + " " + LootName$(lootKind(k, s)) + ":" + LTRIM$(STR$(MinOf(100, p))) ELSE l$ = l$ + " -"
            NEXT
            k2 = SetLevelLoot(l$)
        END IF
    NEXT
END SUB

' --- MAKE THE MAP THIS ROOM: the whole map wall again but for one room,
' w x h, in its middle - you at its west end facing east, the exit in its
' east wall, a light over it; floors and ceilings as usual
SUB EditMakeRoom(w, h)
    DIM x, y, x0, y0, x1, y1 ' (its own: the main program shares these names)
    w = MaxOf(3, MinOf(mapN - 2, w)) : h = MaxOf(3, MinOf(mapN - 2, h)) ' (inside the map's border, whatever was asked)
    x0 = (mapN - w) \ 2 : y0 = (mapN - h) \ 2 : x1 = x0 + w - 1 : y1 = y0 + h - 1
    FOR y = 0 TO mapN - 1
        lvlRow$(y) = STRING$(mapN, "#") : lvlFloorRow$(y) = STRING$(mapN, ".") : lvlCeilRow$(y) = STRING$(mapN, ".")
        IF y >= y0 AND y <= y1 THEN MID$(lvlRow$(y), x0 + 1, w) = STRING$(w, ".")
    NEXT
    MID$(lvlRow$((y0 + y1) \ 2), x0 + 1, 1) = ">" : MID$(lvlRow$((y0 + y1) \ 2), x1 + 2, 1) = "E"
    lvlMonN = 0 : lvlNumZones = 0 : lvlNumLifts = 0 : lvlNumEvents = 0 : lvlNumTrigs = 0 : lvlNumBoxes = 0 : lvlNumNudges = 0 : lvlNumFaces = 0 : lvlNumPairs = 0 : lvlNumBarrels = 0 : lvlNumXtra = 0
    lvlGravity = 100 : lvlWet = -1 ' (a new sector: the usual gravity, its floors as their pictures are)
    lvlNumLights = 1 : lvlLight(1, 1) = mapN / 2 : lvlLight(1, 2) = mapN / 2 : lvlLight(1, 3) = MaxOf(w, h) / 2 + 3 : lvlLight(1, 4) = 150
    lvlLight(1, 5) = 220 : lvlLight(1, 6) = 230 : lvlLight(1, 7) = 255 : lvlLight(1, 8) = 0 : lvlLight(1, 9) = 0
    CellLightsClear
    FOR y = 0 TO mapN - 1 : lvlLiqRow$(y) = STRING$(mapN, ".") : lvlLiqDRow$(y) = STRING$(mapN, ".") : lvlLiqORow$(y) = STRING$(mapN, ".") : lvlWetRow$(y) = STRING$(mapN, ".") : NEXT
END SUB

' --- The map from above, fitted to its part of the screen: a sector the
' game's size (48) as ever, 12 pixels a cell; a bigger one smaller, the
' whole of it in view (Space + drag, + wheel: pan and zoom from there)
SUB EditFitMap
    edCell = MaxOf(2, MinOf(12, (ED_VIEWH - 10) \ mapN)) : IF mapN <= 48 THEN edCell = 12 ' (the game's size: as it always was)
    edMapX = 8 : edMapY = 8 : edPanWas = 0
END SUB

' --- The sector's map made n x n cells: bigger - the new cells wall, and a
' border all round; smaller - what's past it cut off (and its border wall
' again). Undo can't go back past it: its history starts again here.
SUB EditResizeMap(n)
    DIM y, was ' (its own: the main program shares these names)
    n = MaxOf(16, MinOf(MAP_SIZE, n)) : was = mapN : IF n = was THEN EXIT SUB
    FOR y = 0 TO n - 1
        lvlRow$(y) = LEFT$(lvlRow$(y) + STRING$(n, "#"), n) : IF y >= was THEN lvlRow$(y) = STRING$(n, "#")
        lvlFloorRow$(y) = LEFT$(lvlFloorRow$(y) + STRING$(n, "."), n) : lvlCeilRow$(y) = LEFT$(lvlCeilRow$(y) + STRING$(n, "."), n)
        lvlLiqRow$(y) = LEFT$(lvlLiqRow$(y) + STRING$(n, "."), n) : lvlLiqDRow$(y) = LEFT$(lvlLiqDRow$(y) + STRING$(n, "."), n) : lvlLiqORow$(y) = LEFT$(lvlLiqORow$(y) + STRING$(n, "."), n) : lvlWetRow$(y) = LEFT$(lvlWetRow$(y) + STRING$(n, "."), n)
        MID$(lvlRow$(y), 1, 1) = "#" : MID$(lvlRow$(y), n, 1) = "#" ' (its border)
    NEXT
    lvlRow$(0) = STRING$(n, "#") : lvlRow$(n - 1) = STRING$(n, "#")
    FOR y = n TO MAP_SIZE - 1 : lvlRow$(y) = "" : lvlFloorRow$(y) = "" : lvlCeilRow$(y) = "" : lvlLiqRow$(y) = "" : lvlLiqDRow$(y) = "" : lvlLiqORow$(y) = "" : lvlWetRow$(y) = "" : NEXT
    mapN = n : edMapWant = n : editUndoN = 0 : editRedoN = 0
    IF n < was THEN EditDropPast n - 2 ' (cut down: what was past the new edge goes too - else the file keeps it, and the next load piles it on the border)
    IF INSTR(lvlRow$((n - 1) \ 2), ">") + INSTR(lvlRow$((n - 1) \ 2), "<") = 0 THEN ' (no start left - cut off: one, in the middle)
        FOR y = 0 TO n - 1 : IF INSTR(lvlRow$(y), ">") OR INSTR(lvlRow$(y), "<") OR INSTR(lvlRow$(y), "^") OR INSTR(lvlRow$(y), "v") THEN EXIT FOR
        NEXT
        IF y >= n THEN MID$(lvlRow$(n \ 2), n \ 2 + 1, 1) = ">"
    END IF
    EditApply : EditFitMap
    IF playerX >= mapN - 1 OR playerY >= mapN - 1 OR worldMap(INT(playerX), INT(playerY)) > 0 THEN EditYouToStart ' (cut off, or in wall: to the start)
END SUB

' --- Ctrl+click on a wall's side, in the 3D view: that whole side of the
' wall - from it along the wall's plane, both ways (and round its doorways
' and gaps, no further), every wall face the same way that has open floor in
' front of it, so a long wall is one click to style
SUB EditSelWallFlood(x0, y0, side)
    DIM qx(MAP_SIZE * MAP_SIZE) AS INTEGER, qy(MAP_SIZE * MAP_SIZE) AS INTEGER, seen(MAP_SIZE, MAP_SIZE) AS INTEGER
    DIM d, nx, ny, x, y, fx, fy, qn, qi, ax, ay ' (its own: the main program shares these names)
    IF side = 1 OR side = 3 THEN ax = 0 : ay = 1 ELSE ax = 1 : ay = 0 ' (along the wall: up and down it, or across)
    edSelN = 0 : qn = 1 : qx(1) = x0 : qy(1) = y0 : seen(x0, y0) = -1 : qi = 0
    DO WHILE qi < qn AND edSelN < ED_MAXSEL
        qi = qi + 1 : x = qx(qi) : y = qy(qi)
        EditSelAdd ED_WALL, x, y, side, 0
        FOR d = -1 TO 1 STEP 2
            nx = x + ax * d : ny = y + ay * d
            IF nx > 0 AND ny > 0 AND nx < mapN - 1 AND ny < mapN - 1 THEN
                IF NOT seen(nx, ny) AND worldMap(nx, ny) > 0 AND worldMap(nx, ny) <> 2 AND diagCorner(nx, ny) = 0 THEN
                    EditFaceFront nx, ny, side, fx, fy
                    IF worldMap(fx, fy) <= 0 OR worldMap(fx, fy) = 2 THEN seen(nx, ny) = -1 : qn = qn + 1 : qx(qn) = nx : qy(qn) = ny
                END IF
            END IF
        NEXT
    LOOP
END SUB

' --- You, at the sector's start (its < > ^ v) - after the map's been made
' again or cut down round you, so you're not left inside wall
SUB EditYouToStart
    DIM x, y, c$ ' (its own: the main program shares these names)
    FOR y = 0 TO mapN - 1 : FOR x = 0 TO mapN - 1
        c$ = MID$(lvlRow$(y), x + 1, 1)
        IF INSTR("<>^v", c$) THEN
            playerX = x + 0.5 : playerY = y + 0.5 : playerZ = floorH(x, y) : eyeZ = playerZ + EYE_H
            dirX = (c$ = ">") * -1 + (c$ = "<") : dirY = (c$ = "v") * -1 + (c$ = "^") : planeX = -dirY * fovPlane : planeY = dirX * fovPlane
            EXIT SUB
        END IF
    NEXT : NEXT
END SUB

' The map cut down to cells 1..m inside its border: every light, event room,
' lift, zone, pad pair, block, nudge, face and monster line past m gone (a
' room or lift that runs over the edge cut short), and the cell lights there
SUB EditDropPast(m)
    DIM c, j, k, x, y ' (its own: the main program shares these names)
    k = 0
    FOR j = 1 TO lvlNumLights
        IF lvlLight(j, 1) < m + 1 AND lvlLight(j, 2) < m + 1 THEN k = k + 1 : FOR c = 1 TO 9 : lvlLight(k, c) = lvlLight(j, c) : NEXT
    NEXT : lvlNumLights = k
    k = 0
    FOR j = 1 TO lvlNumEvents
        IF lvlEvent(j, 2) <= m AND lvlEvent(j, 3) <= m THEN
            k = k + 1 : FOR c = 1 TO 8 : lvlEvent(k, c) = lvlEvent(j, c) : NEXT
            lvlEvent(k, 4) = MinOf(m, lvlEvent(k, 4)) : lvlEvent(k, 5) = MinOf(m, lvlEvent(k, 5))
        END IF
    NEXT : lvlNumEvents = k
    k = 0
    FOR j = 1 TO lvlNumLifts
        IF lvlLift(j, 1) <= m AND lvlLift(j, 2) <= m THEN
            k = k + 1 : FOR c = 1 TO 8 : lvlLift(k, c) = lvlLift(j, c) : NEXT
            lvlLift(k, 3) = MinOf(m, lvlLift(k, 3)) : lvlLift(k, 4) = MinOf(m, lvlLift(k, 4))
        END IF
    NEXT : lvlNumLifts = k
    k = 0
    FOR j = 1 TO lvlNumZones ' (a triangle's square cut short isn't one: gone)
        IF lvlZone(j, 1) <= m AND lvlZone(j, 2) <= m AND (lvlZone(j, 7) = 0 OR (lvlZone(j, 3) <= m AND lvlZone(j, 4) <= m)) THEN
            k = k + 1 : FOR c = 1 TO 7 : lvlZone(k, c) = lvlZone(j, c) : NEXT
            lvlZone(k, 3) = MinOf(m, lvlZone(k, 3)) : lvlZone(k, 4) = MinOf(m, lvlZone(k, 4))
        END IF
    NEXT : lvlNumZones = k
    k = 0
    FOR j = 1 TO lvlNumPairs
        IF lvlPair(j, 1) <= m AND lvlPair(j, 2) <= m AND lvlPair(j, 3) <= m AND lvlPair(j, 4) <= m THEN k = k + 1 : FOR c = 1 TO 4 : lvlPair(k, c) = lvlPair(j, c) : NEXT
    NEXT : lvlNumPairs = k
    k = 0
    FOR j = 1 TO lvlNumBoxes
        IF lvlBox(j, 1) <= m AND lvlBox(j, 2) <= m THEN k = k + 1 : FOR c = 1 TO 7 : lvlBox(k, c) = lvlBox(j, c) : NEXT
    NEXT : lvlNumBoxes = k
    k = 0
    FOR j = 1 TO lvlNumNudges
        IF lvlNudge(j, 1) <= m AND lvlNudge(j, 2) <= m THEN k = k + 1 : FOR c = 1 TO 5 : lvlNudge(k, c) = lvlNudge(j, c) : NEXT
    NEXT : lvlNumNudges = k
    k = 0
    FOR j = 1 TO lvlNumBarrels
        IF lvlBarrel(j, 1) <= m AND lvlBarrel(j, 2) <= m THEN k = k + 1 : FOR c = 1 TO 4 : lvlBarrel(k, c) = lvlBarrel(j, c) : NEXT
    NEXT : lvlNumBarrels = k
    XtraShift 0, 0, m + 1 ' ([doors], [things], [notes], [smears]: those off it go)
    k = 0
    FOR j = 1 TO lvlMonN
        IF lvlMon(j, 1) <= m AND lvlMon(j, 2) <= m THEN k = k + 1 : FOR c = 1 TO MON_COLS : lvlMon(k, c) = lvlMon(j, c) : NEXT
    NEXT : lvlMonN = k
    k = 0
    FOR j = 1 TO lvlNumFaces
        IF lvlFaceX(j) <= m AND lvlFaceY(j) <= m THEN
            k = k + 1 : lvlFaceX(k) = lvlFaceX(j) : lvlFaceY(k) = lvlFaceY(j) : lvlFaceS(k) = lvlFaceS(j) : lvlFaceD(k) = lvlFaceD(j)
            lvlFaceP1$(k) = lvlFaceP1$(j) : lvlFaceP2$(k) = lvlFaceP2$(j) : lvlFaceO(k) = lvlFaceO(j) : lvlFaceK(k) = lvlFaceK(j)
        END IF
    NEXT : lvlNumFaces = k
    FOR y = 0 TO MAP_SIZE - 1 : FOR x = 0 TO MAP_SIZE - 1 ' (the cell lights past it: none)
        IF x > m OR y > m THEN lvlCLBright(x, y) = -1 : lvlCLCol(x, y) = 0 : lvlCLFx(x, y) = 0
    NEXT : NEXT
END SUB

' Is every cell of the box x0,y0 to x1,y1 one being moved (mv)?
FUNCTION EditRectMoved(mv() AS INTEGER, x0, y0, x1, y1)
    DIM x, y ' (its own: the main program shares these names)
    IF x0 < 0 OR y0 < 0 OR x1 > mapN - 1 OR y1 > mapN - 1 OR x1 < x0 OR y1 < y0 THEN EXIT FUNCTION
    FOR y = y0 TO y1 : FOR x = x0 TO x1
        IF mv(x, y) = 0 THEN EXIT FUNCTION
    NEXT : NEXT
    EditRectMoved = -1
END FUNCTION

' THE EDITOR'S HOLDS (O): a door held open, a lift or crusher held at its
' top or bottom, to see and paint them so - its edges, its track, a lift's
' sides. Only the editor's (edHeld): in play they're as ever.

' Cell (x, y)'s door or lift to hold: 1 a door (not the exit), 2 a lift
' or crusher (k its number), 0 neither
FUNCTION EditHoldThing(x, y, k)
    EditHoldThing = 0 : k = 0
    IF x < 0 OR y < 0 OR x >= mapN OR y >= mapN THEN EXIT FUNCTION
    IF EditDoorIn(x, y) THEN IF doorType(x, y) <> DOOR_EXIT THEN EditHoldThing = 1 : EXIT FUNCTION
    k = liftCell(x, y) : IF k THEN EditHoldThing = 2
END FUNCTION

' Its button's words: what it is now, and what O does to it
FUNCTION EditHoldLabel$(x, y)
    DIM h, k, t ' (its own: the main program shares these names)
    t = EditHoldThing(x, y, k)
    IF t = 1 THEN
        IF edHeld(x, y) = 1 THEN EditHoldLabel$ = "OPEN HERE - SHUT IT (O)" ELSE EditHoldLabel$ = "SHUT - OPEN IT HERE (O)"
    ELSEIF t = 2 THEN
        h = edHeld(liftX0(k), liftY0(k))
        IF h = 1 THEN
            EditHoldLabel$ = "HELD UP - SEND IT DOWN (O)"
        ELSEIF h = -1 THEN
            EditHoldLabel$ = "HELD DOWN - SEND IT UP (O)"
        ELSEIF liftZ(k) > (liftLow(k) + liftHigh(k)) / 2 THEN
            EditHoldLabel$ = "RUNNING - HOLD IT DOWN (O)"
        ELSE
            EditHoldLabel$ = "RUNNING - HOLD IT UP (O)"
        END IF
    END IF
END FUNCTION

' O on (x, y) - or, if that's neither, the cell in front of the face
' there: a door opened (or shut again), a lift sent to its other end and
' held there. release: back as in play (a door shut, a lift running)
SUB EditHoldToggle(x, y, release)
    DIM h, k, t ' (its own: the main program shares these names)
    t = EditHoldThing(x, y, k)
    IF t = 0 THEN EditNote "O holds a door open, or a lift or crusher up or down - point at one" : EXIT SUB
    IF t = 1 THEN
        IF release OR edHeld(x, y) = 1 THEN edHeld(x, y) = 0 ELSE edHeld(x, y) = 1
        IF edHeld(x, y) THEN EditNote "Door open - in the editor only (O shuts it)" ELSE EditNote "Door shut"
        EXIT SUB
    END IF
    h = edHeld(liftX0(k), liftY0(k))
    IF release THEN
        h = 0
    ELSEIF h = 0 THEN
        IF liftZ(k) > (liftLow(k) + liftHigh(k)) / 2 THEN h = -1 ELSE h = 1 ' (to the end it's further from)
    ELSE
        h = -h
    END IF
    edHeld(liftX0(k), liftY0(k)) = h
    SELECT CASE h
        CASE 1 : EditNote "Held at the top - in the editor only (O: down, Shift+O: running)"
        CASE -1 : EditNote "Held at the bottom - in the editor only (O: up, Shift+O: running)"
        CASE ELSE : EditNote "Running, as in play"
    END SELECT
END SUB

' The O key: what's under the pointer (a face's cell, or the cell in front
' of it - a lift's side), else the first selected. Shift+O: that one back
' as in play - pointing at nothing, every one
SUB EditHoldKey(release)
    DIM k, tx, ty, x, y ' (its own: the main program shares these names)
    x = -1
    IF edHovKind THEN
        x = edHovX : y = edHovY
        IF EditHoldThing(x, y, k) = 0 THEN EditFaceCell edHovKind, edHovX, edHovY, edHovSide, tx, ty : IF EditHoldThing(tx, ty, k) THEN x = tx : y = ty
    ELSEIF edSelN THEN
        x = edSelX(1) : y = edSelY(1)
    END IF
    IF x < 0 THEN
        IF release THEN EditHeldClear : EditNote "Every door and lift as in play" ELSE EditNote "O holds a door open, or a lift or crusher up or down - point at one"
        EXIT SUB
    END IF
    EditHoldToggle x, y, release
END SUB

' A door's place across its doorway: how far (hx, hy) is from its middle
' line, square to it
FUNCTION EditDoorN(x, y, hx, hy)
    IF DoorAcross(x, y) = 0 THEN EditDoorN = hy - y - 0.5 ELSE EditDoorN = hx - x - 0.5
END FUNCTION

' A strip along door (x, y)'s middle line, n either side of it, flat at z
' - its track, a shutter's underside - outlined
SUB EditDoorStrip(x, y, n, z, col~&)
    IF DoorAcross(x, y) = 0 THEN
        EditLine3D x, y + 0.5 - n, z, x + 1, y + 0.5 - n, z, col~& : EditLine3D x + 1, y + 0.5 - n, z, x + 1, y + 0.5 + n, z, col~&
        EditLine3D x + 1, y + 0.5 + n, z, x, y + 0.5 + n, z, col~& : EditLine3D x, y + 0.5 + n, z, x, y + 0.5 - n, z, col~&
    ELSE
        EditLine3D x + 0.5 - n, y, z, x + 0.5 - n, y + 1, z, col~& : EditLine3D x + 0.5 - n, y + 1, z, x + 0.5 + n, y + 1, z, col~&
        EditLine3D x + 0.5 + n, y + 1, z, x + 0.5 + n, y, z, col~& : EditLine3D x + 0.5 + n, y, z, x + 0.5 - n, y, z, col~&
    END IF
END SUB

' Chapter 11, in the editor: door (x, y) shut - or held open - moving
' there as it does in play
SUB EditDoorHeld(x, y)
    DIM sp, want ' (its own: the main program shares these names)
    want = 0 : IF edHeld(x, y) = 1 AND doorType(x, y) <> DOOR_EXIT THEN want = 1
    sp = DoorSpeed(doorType(x, y)) : doorMove(x, y) = 0 : doorWait(x, y) = DoorHold(doorType(x, y))
    IF doorOpen(x, y) < want THEN doorOpen(x, y) = MinOf(want, doorOpen(x, y) + sp)
    IF doorOpen(x, y) > want THEN doorOpen(x, y) = MaxOf(want, doorOpen(x, y) - sp)
END SUB

' MoveLifts, in the editor: lift k held up or down? Then it's moved there
' (and stays) - and the answer's yes; not held, it runs as in play
FUNCTION EditLiftHeld(k)
    DIM h, sp, want ' (its own: the main program shares these names)
    EditLiftHeld = 0
    h = edHeld(liftX0(k), liftY0(k)) : IF h = 0 THEN EXIT FUNCTION
    IF h > 0 THEN want = liftHigh(k) ELSE want = liftLow(k)
    sp = liftSpeed(k) : IF sp <= 0 THEN sp = 0.05
    IF liftZ(k) < want THEN liftZ(k) = MinOf(want, liftZ(k) + sp) ELSE IF liftZ(k) > want THEN liftZ(k) = MaxOf(want, liftZ(k) - sp)
    liftDir(k) = 0 : liftWait(k) = 120 : liftWasDir(k) = 0
    EditLiftCells k
    EditLiftHeld = -1
END FUNCTION

' Lift k's cells at its height: their floors - a crusher's, their ceilings
SUB EditLiftCells(k)
    DIM x, y ' (its own: the main program shares these names)
    FOR y = liftY0(k) TO liftY1(k) : FOR x = liftX0(k) TO liftX1(k)
        IF liftCell(x, y) = k THEN
            IF liftMode(k) = LIFT_CRUSHER OR liftMode(k) = LIFT_SMASHER THEN ceilH(x, y) = liftZ(k) ELSE floorH(x, y) = liftZ(k)
        END IF
    NEXT : NEXT
END SUB

' After the editor builds the sector again (BuildLevel): the held doors
' open and lifts up or down at once, as they were - holds on what's no
' longer a door or a lift's corner forgotten
SUB EditHeldSnap
    DIM d&, h, k, ok, x, y ' (its own: the main program shares these names)
    FOR y = 0 TO mapN - 1 : FOR x = 0 TO mapN - 1
        IF edHeld(x, y) THEN
            ok = 0
            IF edHeld(x, y) = 1 AND EditDoorIn(x, y) THEN IF doorType(x, y) <> DOOR_EXIT THEN ok = -1
            FOR k = 1 TO numLifts : IF liftX0(k) = x AND liftY0(k) = y THEN ok = -1
            NEXT
            IF NOT ok THEN edHeld(x, y) = 0
        END IF
    NEXT : NEXT
    FOR d& = 1 TO numDoorCells
        x = doorCellX(d&) : y = doorCellY(d&)
        IF edHeld(x, y) = 1 THEN doorOpen(x, y) = 1 : doorMove(x, y) = 0
    NEXT
    FOR k = 1 TO numLifts
        h = edHeld(liftX0(k), liftY0(k))
        IF h THEN
            IF h > 0 THEN liftZ(k) = liftHigh(k) ELSE liftZ(k) = liftLow(k)
            liftDir(k) = 0 : EditLiftCells k
        END IF
    NEXT
END SUB

' Every hold let go (a sector loaded; Shift+O at nothing)
SUB EditHeldClear
    DIM x, y ' (its own: the main program shares these names)
    FOR y = 0 TO MAP_SIZE : FOR x = 0 TO MAP_SIZE : edHeld(x, y) = 0 : NEXT : NEXT
END SUB
