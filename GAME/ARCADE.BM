''
' NEON-CASTER - GAME/ARCADE.BM
' =============================================================================
' Computers you can use: NEON PONG, and running a QB64PE program.
'

' --- A computer runs a program (the console's program NAME - a level's
' "use" trigger on a computer, say: use 20 14 : program invaders). It's
' neon-caster/programs/NAME.bas, any QB64PE program at all: built by
' qb64pe the first time, and again whenever it changes (as a code
' terminal's is - into saves/programs, kept for next time), then run in the
' game's place (--fullscreen or --window: as the game was showing) - the
' game hidden, waiting, while it does.
' How it ends is the answer (SHELL gives back its SYSTEM code): SYSTEM 1
' and you beat it - the computer pays out, from the trigger's cell (or in
' front of you); anything else, you didn't. No qb64pe to build it with,
' and the computer says so.
SUB RunProgram STATIC
    pgName$ = LCASE$(LTRIM$(RTRIM$(conA$)))
    IF demoPlay THEN ' (a demo: what the program answered, as recorded - it isn't run again; -999: it never ran)
        demoKind$ = "r" : DemoTakeRes : rc = demoRes
        IF rc <> -999 THEN ProgramPaid
        EXIT SUB
    END IF
    rc = -999 : ProgramRun
    IF demoRec THEN demoKind$ = "r" : demoRes = rc : DemoEvent
END SUB

SUB ProgramRun STATIC
    pgSrc$ = AssetPath$("programs/" + pgName$ + ".bas")
    IF pgName$ = "" OR NOT _FILEEXISTS(pgSrc$) THEN ConPrint "program: no neon-caster/programs/" + pgName$ + ".bas" : ShowMsg "SYSTEM ERROR - no program called " + pgName$ : EXIT SUB
    MakeSaveDir : pgDir$ = SaveDir$ + "programs"
    IF NOT _DIREXISTS(pgDir$) THEN MKDIR pgDir$
    pgDir$ = _FULLPATH$(pgDir$) : IF RIGHT$(pgDir$, 1) = "/" OR RIGHT$(pgDir$, 1) = "\" THEN pgDir$ = LEFT$(pgDir$, LEN(pgDir$) - 1)
    win = INSTR(_OS$, "[WINDOWS]") > 0 : q$ = CHR$(34)
    pgExe$ = pgDir$ + "/" + pgName$ : IF win THEN pgExe$ = Slashes$(pgExe$ + ".exe")
    ' Built when it's new - or when its .bas has changed since (the sum of
    ' the source it was built from is kept beside it: NAME.sig)
    pgSig& = NpSig&(pgSrc$) : pgHad& = 0 : pgSigF$ = pgExe$ + ".sig"
    IF _FILEEXISTS(pgSigF$) THEN
        pgFh = FREEFILE : OPEN pgSigF$ FOR INPUT AS #pgFh
        IF NOT EOF(pgFh) THEN INPUT #pgFh, pgHad&
        CLOSE #pgFh
    END IF
    IF NOT _FILEEXISTS(pgExe$) OR pgHad& <> pgSig& THEN
        qb$ = QB64Path$
        IF qb$ = "" THEN qb$ = NeedQB64$(pgName$) ' (none: a box says where to get it, and finds it once it's there)
        IF qb$ = "" THEN EXIT SUB
        CLS , _RGB32(4, 2, 14) : MenuText 400, 280, "LOADING " + UCASE$(pgName$) + "...", 3, _RGB32(80, 240, 255), 1 ' (a frame to look at while it builds)
        IF GLShows THEN GLCapture
        GLScreenLayer GLShows : ShowFrame
        pgSrcF$ = _FULLPATH$(pgSrc$) : IF win THEN pgSrcF$ = Slashes$(pgSrcF$)
        IF _FILEEXISTS(pgExe$) THEN KILL pgExe$ ' (the old build gone: if the new one fails, it says so - not the old one running)
        rc = _SHELLHIDE(q$ + qb$ + q$ + " -w -x " + q$ + pgSrcF$ + q$ + " -o " + q$ + pgExe$ + q$) ' (_SHELLHIDE: no console window, and full screen left as it is - SHELL leaves it and can hang coming back)
        IF NOT _FILEEXISTS(pgExe$) THEN ShowMsg "SYSTEM ERROR - " + pgName$ + " wouldn't build (qb64pe)" : ConPrint "program: qb64pe couldn't build " + pgSrc$ : rc = -999 : EXIT SUB
        pgFh = FREEFILE : OPEN pgSigF$ FOR OUTPUT AS #pgFh : PRINT #pgFh, pgSig& : CLOSE #pgFh
    END IF
    WorldLoopsOff
    ' The program takes the game's place: told how the game shows
    ' (--fullscreen or --window), and the game's window hidden while it
    ' runs - shown again, it has the keyboard back (a program's window
    ' closing left a full screen game with no keys). Out of full screen
    ' first, by the game itself: SHELL would, and then wait with no end to
    ' be back in (a window manager can keep that from happening - the game
    ' hung). Back in after, waiting a moment at most.
    pgFull = fullnow_mode& <> 0
    IF pgFull THEN pgArg$ = " --fullscreen" ELSE pgArg$ = " --window"
    IF pgFull THEN _FULLSCREEN _OFF : ProgramWaitFull 0
    _SCREENHIDE
    IF fullnow_mode& = 0 THEN
        rc = SHELL(q$ + pgExe$ + q$ + pgArg$)
    ELSE ' (still full screen: _SHELLHIDE doesn't touch it - its answer as the system's, the exit code in its second byte but on Windows)
        rc = _SHELLHIDE(q$ + pgExe$ + q$ + pgArg$) : IF NOT win THEN rc = (rc \ 256) AND 255
    END IF
    ProgramShowWindow
    IF pgFull THEN displayModeNow = -1 : ApplyDisplay : ProgramWaitFull DisplayMode(setting(SET_DISPLAY))
    ProgramPaid
END SUB

' The game's window shown again - asked till QB64PE knows it is (three
' seconds at most): it looks once, as it asks, and a window manager that
' hasn't shown it yet left it sure it was hidden, never drawn again
SUB ProgramShowWindow
    DIM t0 AS DOUBLE, n ' (its own)
    t0 = TIMER(.001)
    DO
        _SCREENSHOW : n = n + 1
        IF fullnow_hidden& = 0 OR ABS(TIMER(.001) - t0) > 3 THEN EXIT DO
        _LIMIT 30
    LOOP
    IF n > 1 THEN ConPrint "program: the window shown again after" + STR$(n) + " tries"
END SUB

' Till QB64PE has switched to full screen mode m (at its next frame), two
' seconds at most
SUB ProgramWaitFull(m)
    DIM t0 AS DOUBLE ' (its own)
    t0 = TIMER(.001)
    DO WHILE fullnow_mode& <> m AND ABS(TIMER(.001) - t0) < 2
        _LIMIT 100
    LOOP
END SUB

' --- No qb64pe: a box over the game says what a computer's program needs -
' QB64 Phoenix Edition, the free compiler this game is written for - and
' how to get it: GET QB64PE opens its download page in the browser,
' FIND IT looks again (once it's installed), SET ITS PATH picks it in a
' file window (kept, as SETTINGS > QB64PE COMPILER keeps it). Gives back
' where it is, or "" - NOT NOW, or Esc.
FUNCTION NeedQB64$(what$)
    DIM t, mx, my, p1, b1, k&, hit, i, bx, msg$, msgC AS _UNSIGNED LONG, f$, pat$, os$ ' (its own: the main program shares these names)
    NeedQB64$ = "" : WorldLoopsOff : _KEYCLEAR : WHILE _MOUSEINPUT : WEND
    b1 = _MOUSEBUTTON(1) : msg$ = "" : t = 0
    IF INSTR(_OS$, "[WINDOWS]") THEN
        os$ = "Windows: unzip it anywhere - qb64pe.exe is ready to go."
    ELSEIF INSTR(_OS$, "[MACOSX]") THEN
        os$ = "macOS: unzip it, then run setup_osx.command in its folder once."
    ELSE
        os$ = "Linux: unpack it, then run ./setup_lnx.sh in its folder once."
    END IF
    _MOUSESHOW
    DO
        _LIMIT 60 : t = t + 1 : p1 = 0
        WHILE _MOUSEINPUT
            mx = WideMouseX(_MOUSEX) : my = _MOUSEY
            IF _MOUSEBUTTON(1) AND NOT b1 THEN p1 = -1
            b1 = _MOUSEBUTTON(1)
        WEND
        hit = 0
        k& = _KEYHIT
        IF k& = 27 THEN EXIT DO
        IF k& = 13 OR k& = 103 OR k& = 71 THEN hit = 1 ' (Enter or G: get it)
        IF k& = 102 OR k& = 70 THEN hit = 2 ' (F: find it)
        IF k& = 112 OR k& = 80 THEN hit = 3 ' (P: its path)
        IF p1 AND my >= 420 AND my < 452 THEN
            FOR i = 1 TO 4
                bx = 64 + (i - 1) * 172
                IF mx >= bx AND mx < bx + 160 THEN hit = i
            NEXT
        END IF
        SELECT CASE hit
            CASE 1
                OpenLink "https://github.com/QB64-Phoenix-Edition/QB64pe/releases/latest"
                msg$ = "Its page is opening in your browser. Install it, then FIND IT." : msgC = _RGB32(90, 230, 255)
            CASE 2
                f$ = QB64Path$
                IF LEN(f$) THEN NeedQB64$ = f$ : EXIT DO
                msg$ = "Not found yet. Installed it somewhere else? SET ITS PATH." : msgC = _RGB32(255, 200, 60)
            CASE 3
                IF INSTR(_OS$, "[WINDOWS]") THEN pat$ = "*.exe" ELSE pat$ = ""
                f$ = _OPENFILEDIALOG$("Where is qb64pe?", "", pat$, "qb64pe", 0)
                _KEYCLEAR : WHILE _MOUSEINPUT : WEND : b1 = -1
                IF LEN(f$) THEN
                    IF LEN(QB64At$(f$)) THEN qbChosen$ = QB64At$(f$) : SaveSettings : NeedQB64$ = qbChosen$ : EXIT DO
                    msg$ = "That isn't qb64pe - pick the qb64pe program, or its folder." : msgC = _RGB32(255, 90, 90)
                END IF
            CASE 4 : EXIT DO
        END SELECT
        DrawNeedQB64 what$, os$, msg$, msgC, mx, my
        IF GLShows THEN GLCapture
        GLScreenLayer GLShows : ShowFrame
    LOOP
    _KEYCLEAR : WHILE _MOUSEINPUT : WEND
    escWas = -1 : fireWait = 15 : spaceWas = -1 : mouseSettle = 8
END FUNCTION

' NeedQB64$'s box: what's wanted, the steps, four buttons (the one under
' the pointer lit), and the last thing that happened
SUB DrawNeedQB64(what$, os$, msg$, msgC AS _UNSIGNED LONG, mx, my)
    DIM i, bx, lit, b$, ink AS _UNSIGNED LONG ' (its own: the main program shares these names)
    DrawMenuBackdrop 0 : BackdropDim _RGBA32(0, 0, 0, 170), -1
    LINE (40, 90)-(759, 500), _RGBA32(12, 4, 30, 240), BF : LINE (40, 90)-(759, 500), _RGB32(255, 60, 200), B
    MenuText 400, 112, "THIS COMPUTER NEEDS QB64PE", 2, _RGB32(255, 90, 220), 1
    ink = _RGB32(225, 230, 255)
    MenuText 70, 172, UCASE$(what$) + " is a real QB64 program. The game builds it with qb64pe -", 1, ink, 0
    MenuText 70, 194, "QB64 Phoenix Edition, the free BASIC compiler this game is made in -", 1, ink, 0
    MenuText 70, 216, "and qb64pe isn't on this computer (or the game can't find it).", 1, ink, 0
    MenuText 70, 254, "1. GET QB64PE opens its download page. Install it:", 1, _RGB32(150, 240, 255), 0
    MenuText 94, 276, os$, 1, ink, 0
    MenuText 70, 306, "2. FIND IT: the game looks for it - on the PATH and in the usual places.", 1, _RGB32(150, 240, 255), 0
    MenuText 70, 336, "   Put it somewhere else? SET ITS PATH and point at it.", 1, _RGB32(150, 240, 255), 0
    MenuText 70, 366, "(It's kept: SETTINGS > QB64PE COMPILER. Code terminals use it too.)", 1, _RGB32(140, 135, 175), 0
    FOR i = 1 TO 4
        bx = 64 + (i - 1) * 172 : lit = (mx >= bx AND mx < bx + 160 AND my >= 420 AND my < 452)
        b$ = MID$("GET QB64PE  FIND IT     SET ITS PATHNOT NOW     ", (i - 1) * 12 + 1, 12)
        IF lit THEN LINE (bx, 420)-STEP(159, 31), _RGB32(90, 20, 80), BF
        LINE (bx, 420)-STEP(159, 31), _RGB32(255, 60, 200), B
        MenuText bx + 80, 428, RTRIM$(b$), 1, _RGB32(255, 255, 255), 1
    NEXT
    IF LEN(msg$) THEN MenuText 400, 470, msg$, 1, msgC, 1
    MenuText 400, 574, "G  GET     F  FIND IT     P  SET ITS PATH     ESC  NOT NOW", 1, _RGB32(140, 135, 175), 1
END SUB

SUB ProgramPaid STATIC ' (what its answer brings: the same whether it ran just now or a demo says so)
    _KEYCLEAR : WHILE _MOUSEINPUT : WEND : escWas = -1 : fireWait = 15 : spaceWas = -1
    IF rc = 1 THEN
        IF conFromTrig THEN px = trigX0(trigK) + 0.5 : py = trigY0(trigK) + 0.5 ELSE px = playerX + dirX : py = playerY + dirY
        a = DAtan2(playerY - py, playerX - px)
        TossItem StashLoot(0), px, py, a - 0.4, playerX, playerY : TossItem StashLoot(1), px, py, a + 0.4, playerX, playerY
        PlaySfx sndFanfare&, 0.8 : ShowMsg "HIGH SCORE! The computer pays out" : Achieve "NC_ARCADE", 0
    ELSE
        ShowMsg "GAME OVER - " + UCASE$(pgName$) + " beat you this time"
    END IF
END SUB

' --- NEON PONG, on computer arcDeco (Space on a terminal, a console or a
' bank of screens): you on the left, the machine on the right, first to
' ARC_WIN. Your paddle follows the mouse - or the arrow keys. Its own loop,
' as the code terminals' (chapter 19): the world waits while you play.
' Win, and the computer pays out - something good and something to shoot
' with, flying out of it (TossItem) - and it's done (vendState 3). Lose,
' or Esc, and you can try again. The ball speeds up each time it's hit,
' and comes off a paddle steeper the further from its middle it hits.
SUB ArcadeRun STATIC
    IF demoPlay THEN demoKind$ = "a" : DemoTakeRes : arcWon = (demoRes = 1) : arcDone = (demoRes = 2) : ArcadeEnd : EXIT SUB ' (a demo: the game's result, as recorded)
    WorldLoopsOff : _MOUSESHOW : _KEYCLEAR : WHILE _MOUSEINPUT : WEND
    arcPY = 300 : arcCY = 300 : arcMe = 0 : arcIt = 0 : arcDone = 0 : arcWon = 0 : arcServe = 60 : arcDir = 1
    arcBX = 400 : arcBY = 300 : arcVX = 0 : arcVY = 0 : arcMouseY = _MOUSEY
    DO
        _LIMIT 60
        WHILE _MOUSEINPUT : WEND
        IF _MOUSEY <> arcMouseY THEN arcMouseY = _MOUSEY : arcPY = arcMouseY ' (the mouse moved: the paddle goes where it is)
        IF _KEYDOWN(18432) THEN arcPY = arcPY - 8
        IF _KEYDOWN(20480) THEN arcPY = arcPY + 8
        arcPY = MaxOf(ARC_TOP + ARC_PAD / 2, MinOf(ARC_BOT - ARC_PAD / 2, arcPY))
        k& = _KEYHIT
        DO WHILE k&
            IF k& = 27 THEN arcDone = -1
            k& = _KEYHIT
        LOOP
        IF arcDone THEN EXIT DO
        ' The machine: after the ball, a little slow - and slower than the ball, later on
        t = arcBY : IF arcVX < 0 THEN t = 300 ' (the ball going away: back to the middle)
        arcCY = arcCY + MaxOf(-5.2, MinOf(5.2, (t - arcCY) * 0.14))
        arcCY = MaxOf(ARC_TOP + ARC_PAD / 2, MinOf(ARC_BOT - ARC_PAD / 2, arcCY))
        IF arcServe > 0 THEN ' (a moment between points, then a serve - towards whoever lost the last one)
            arcServe = arcServe - 1 : arcBX = 400 : arcBY = 300
            IF arcServe = 0 THEN arcVX = 5 * arcDir : arcVY = (RND - 0.5) * 6
        ELSE
            arcBX = arcBX + arcVX : arcBY = arcBY + arcVY
            IF arcBY < ARC_TOP + 6 THEN arcBY = ARC_TOP + 6 : arcVY = ABS(arcVY) : PlaySfx sndMenuMove&, 0.4
            IF arcBY > ARC_BOT - 6 THEN arcBY = ARC_BOT - 6 : arcVY = -ABS(arcVY) : PlaySfx sndMenuMove&, 0.4
            IF arcVX < 0 AND arcBX < 70 AND arcBX > 50 AND ABS(arcBY - arcPY) < ARC_PAD / 2 + 6 THEN ' Your paddle
                arcVX = MinOf(14, ABS(arcVX) * 1.07) : arcVY = (arcBY - arcPY) / (ARC_PAD / 2) * 7 : PlaySfx sndMenuSelect&, 0.6
            END IF
            IF arcVX > 0 AND arcBX > 730 AND arcBX < 750 AND ABS(arcBY - arcCY) < ARC_PAD / 2 + 6 THEN ' Its paddle
                arcVX = -MinOf(14, ABS(arcVX) * 1.07) : arcVY = (arcBY - arcCY) / (ARC_PAD / 2) * 7 : PlaySfx sndMenuSelect&, 0.6
            END IF
            IF arcBX < 10 THEN arcIt = arcIt + 1 : arcServe = 60 : arcDir = -1 : PlaySfx sndLocked&, 0.6
            IF arcBX > 790 THEN arcMe = arcMe + 1 : arcServe = 60 : arcDir = 1 : PlaySfx sndPlate&, 0.8
        END IF
        IF arcMe >= ARC_WIN OR arcIt >= ARC_WIN THEN arcWon = (arcMe >= ARC_WIN) : EXIT DO
        DrawArcade arcPY, arcCY, arcBX, arcBY, arcMe, arcIt, (arcServe = 0 OR (arcServe \ 8) MOD 2 = 0), ""
        IF GLShows THEN GLCapture
        GLScreenLayer GLShows : ShowFrame
    LOOP
    IF NOT arcDone THEN ' (the result, a moment)
        IF arcWon THEN PlaySfx sndFanfare&, 0.8 ELSE PlaySfx sndFail&, 0.8
        FOR f = 1 TO 120
            _LIMIT 60 : WHILE _MOUSEINPUT : WEND
            IF arcWon THEN t$ = "YOU WIN!" ELSE t$ = "GAME OVER"
            DrawArcade arcPY, arcCY, 400, 300, arcMe, arcIt, 0, t$
            IF GLShows THEN GLCapture
            GLScreenLayer GLShows : ShowFrame
        NEXT
    END IF
    IF demoRec THEN ' (a demo: the game's result - 1 won, 2 left with Esc, 0 lost)
        demoKind$ = "a" : demoRes = 0
        IF arcWon THEN demoRes = 1 ELSE IF arcDone THEN demoRes = 2
        DemoEvent
    END IF
    ArcadeEnd ' (and on into the next part)
END SUB
SUB ArcadeEnd STATIC
    _KEYCLEAR : _MOUSEHIDE _DISABLE : WHILE _MOUSEINPUT : WEND : mouseSettle = 8
    escWas = -1 : fireWait = 15 : spaceWas = -1
    IF arcWon THEN
        vendState(arcDeco) = 3 : ShowMsg "HIGH SCORE! The machine pays out" : Achieve "NC_ARCADE", 0
        a = DAtan2(playerY - decoY(arcDeco), playerX - decoX(arcDeco))
        TossItem StashLoot(0), decoX(arcDeco), decoY(arcDeco), a - 0.4, playerX, playerY
        TossItem StashLoot(1), decoX(arcDeco), decoY(arcDeco), a + 0.4, playerX, playerY
    ELSEIF NOT arcDone THEN
        ShowMsg "GAME OVER - insert coin (Space) to try again"
    END IF
END SUB

' NEON PONG's screen (ArcadeRun): the court, the paddles (you: py, the
' machine: cy), the ball at (bx, by) if ballOn, the score, and big$ (YOU
' WIN! / GAME OVER) over it all at the end
SUB DrawArcade(py, cy, bx, by, me, it, ballOn, big$)
    DIM g, y ' (its own: the main program shares these names)
    LINE (0, 0)-(799, 599), _RGB32(4, 2, 14), BF
    FOR y = 0 TO 599 STEP 3 : LINE (0, y)-(799, y), _RGB32(0, 0, 0) : NEXT ' (scanlines: it's an old screen)
    LINE (20, ARC_TOP - 4)-(779, ARC_TOP - 1), _RGB32(255, 60, 200), BF : LINE (20, ARC_BOT + 1)-(779, ARC_BOT + 4), _RGB32(255, 60, 200), BF
    FOR y = ARC_TOP + 8 TO ARC_BOT - 16 STEP 24 : LINE (398, y)-(401, y + 12), _RGB32(120, 60, 160), BF : NEXT
    MenuText 320, 40, LTRIM$(STR$(me)), 4, _RGB32(80, 240, 255), 1
    MenuText 480, 40, LTRIM$(STR$(it)), 4, _RGB32(255, 90, 200), 1
    MenuText 400, 18, "NEON PONG  -  FIRST TO" + STR$(ARC_WIN) + "  -  MOUSE OR ARROWS, ESC GIVES UP", 1, _RGB32(160, 150, 200), 1
    FOR g = 6 TO 1 STEP -1 ' (a glow round the paddles: wider and fainter)
        LINE (52 - g, py - ARC_PAD / 2 - g)-(61 + g, py + ARC_PAD / 2 + g), _RGBA32(80, 240, 255, 22), BF
        LINE (738 - g, cy - ARC_PAD / 2 - g)-(747 + g, cy + ARC_PAD / 2 + g), _RGBA32(255, 90, 200, 22), BF
    NEXT
    LINE (52, py - ARC_PAD / 2)-(61, py + ARC_PAD / 2), _RGB32(80, 240, 255), BF
    LINE (738, cy - ARC_PAD / 2)-(747, cy + ARC_PAD / 2), _RGB32(255, 90, 200), BF
    IF ballOn THEN
        FOR g = 8 TO 1 STEP -2 : LINE (bx - 6 - g, by - 6 - g)-(bx + 6 + g, by + 6 + g), _RGBA32(255, 255, 160, 26), BF : NEXT
        LINE (bx - 6, by - 6)-(bx + 6, by + 6), _RGB32(255, 255, 200), BF
    END IF
    IF big$ <> "" THEN MenuText 400, 270, big$, 5, _RGB32(255, 240, 120), 1
END SUB

' --- Vending machine dv, played: a slot machine - one pull. What it comes
' up with is settled first, by the game's dice (GRnd - so a demo comes up
' the same, and plays it back without the screen): three alike, a pair or
' nothing, and of what (SlotRoll). Then the reels spin on their own screen
' and stop one by one (SlotRun - Space or a click stops them sooner), and
' it pays out (SlotPay). Then it's done: SOLD OUT.
SUB SlotUse(dv)
    slotDeco = dv : SlotRoll
    vendState(dv) = 3
    IF NOT demoPlay THEN SlotRun ELSE fireWait = 15 ' (as SlotRun leaves it: played back the same)
    SlotPay
END SUB

' What the reels come up with (slotReel 1-3): three alike - a bomb, monsters,
' a gun, health, ammo, armour (each about 1 in 8), the jackpot (1 in 25) -
' or a pair (1 in 5: slotPair, the kind), or nothing alike
SUB SlotRoll
    DIM r, k ' (its own: the main program shares these names)
    r = GRnd : slotPair = 0
    IF r < 0.04 THEN
        k = SL_SEVEN
    ELSEIF r < 0.76 THEN
        k = 1 + INT((r - 0.04) / 0.12) : IF k > SL_ARMOR THEN k = SL_ARMOR ' (six alike-kinds, 0.12 each)
    ELSEIF r < 0.96 THEN
        k = 0 : slotPair = 1 + INT(GRnd * SL_ARMOR)
    ELSE
        k = -1
    END IF
    IF k > 0 THEN
        slotReel(1) = k : slotReel(2) = k : slotReel(3) = k
    ELSEIF slotPair THEN ' (two alike, the third something else - and which two)
        slotReel(1) = slotPair : slotReel(2) = slotPair : slotReel(3) = 1 + (slotPair + INT(GRnd * (SL_KINDS - 1))) MOD SL_KINDS
        IF GRnd < 0.5 THEN SWAP slotReel(1), slotReel(3)
    ELSE ' (nothing: three all different)
        slotReel(1) = 1 + INT(GRnd * SL_KINDS)
        slotReel(2) = 1 + (slotReel(1) + INT(GRnd * (SL_KINDS - 1))) MOD SL_KINDS
        DO : slotReel(3) = 1 + INT(GRnd * SL_KINDS) : LOOP WHILE slotReel(3) = slotReel(1) OR slotReel(3) = slotReel(2)
    END IF
END SUB

' The slot machine's own loop (the world waits, as NEON PONG's): the three
' reels spinning, stopping one after another on what SlotRoll settled -
' Space, Enter or a click stops the next one now - then what it means, a
' moment
SUB SlotRun STATIC
    WorldLoopsOff : _KEYCLEAR : WHILE _MOUSEINPUT : WEND
    PlaySfx sndPlate&, 0.8
    FOR k = 1 TO 3 : slotPos(k) = RND * SL_KINDS : slotStop(k) = 0 : NEXT
    stopAt = 50 : f = 0 : clickWas = -1
    DO
        _LIMIT 60 : f = f + 1 : hurry = 0
        WHILE _MOUSEINPUT
            IF _MOUSEBUTTON(1) AND NOT clickWas THEN hurry = -1
            clickWas = _MOUSEBUTTON(1)
        WEND
        k& = _KEYHIT
        DO WHILE k&
            IF k& = 32 OR k& = 13 OR k& = 27 THEN hurry = -1
            k& = _KEYHIT
        LOOP
        IF hurry AND f < stopAt THEN stopAt = f
        FOR k = 1 TO 3 ' (each spins till its time, then lands on its symbol)
            IF NOT slotStop(k) THEN
                slotPos(k) = slotPos(k) + 0.35
                IF f >= stopAt + (k - 1) * 22 THEN slotStop(k) = -1 : slotPos(k) = slotReel(k) - 1 : PlaySfx sndLiftStop&, 0.7
            END IF
        NEXT
        DrawSlots ""
        IF GLShows THEN GLCapture
        GLScreenLayer GLShows : ShowFrame
        IF slotStop(3) THEN EXIT DO
    LOOP
    t$ = SlotSays$
    IF slotReel(1) = slotReel(2) AND slotReel(2) = slotReel(3) THEN PlaySfx sndFanfare&, 0.8 ELSE IF slotPair THEN PlaySfx sndMenuSelect&, 0.8 ELSE PlaySfx sndFail&, 0.6
    FOR f = 1 TO 90
        _LIMIT 60 : WHILE _MOUSEINPUT : WEND
        DrawSlots t$
        IF GLShows THEN GLCapture
        GLScreenLayer GLShows : ShowFrame
    NEXT
    _KEYCLEAR : _MOUSEHIDE _DISABLE : WHILE _MOUSEINPUT : WEND : mouseSettle = 8
    escWas = -1 : fireWait = 15 : spaceWas = -1
END SUB

' What the reels say, in a few words
FUNCTION SlotSays$
    IF slotReel(1) = slotReel(2) AND slotReel(2) = slotReel(3) THEN
        SlotSays$ = RTRIM$(MID$("BIG BANG!  MONSTERS!  NEW GUN!   HEALTH!    AMMO!      ARMOUR!    JACKPOT!!! ", slotReel(1) * 11 - 10, 11))
    ELSEIF slotPair THEN
        SlotSays$ = "A PAIR - A LITTLE SOMETHING"
    ELSE
        SlotSays$ = "NO LUCK"
    END IF
END FUNCTION

' The slot machine's screen: its cabinet, the three reels (each symbol
' slotPos through its strip, the one in the window lit) and big$ over it
SUB DrawSlots(big$)
    DIM k, j, s, x, y, cy, a, p ' (its own: the main program shares these names)
    LINE (0, 0)-(799, 599), _RGB32(10, 2, 16), BF
    FOR y = 0 TO 599 STEP 3 : LINE (0, y)-(799, y), _RGB32(4, 0, 8) : NEXT
    MenuText 400, 40, "NEON SLOTS", 4, _RGB32(255, 70, 200), 1
    MenuText 400, 110, "THREE ALIKE PAYS OUT - OR GOES OFF", 1.5, _RGB32(150, 120, 200), 1
    LINE (110, 170)-(689, 430), _RGB32(255, 70, 200), B : LINE (106, 166)-(693, 434), _RGB32(120, 30, 110), B
    FOR k = 1 TO 3
        x = 130 + (k - 1) * 186 : LINE (x, 190)-(x + 166, 410), _RGB32(20, 8, 30), BF : LINE (x, 190)-(x + 166, 410), _RGB32(80, 240, 255), B
        p = slotPos(k)
        FOR j = -1 TO 1 ' (the symbol in the window, and a part of the ones either side)
            s = (INT(p) + j + SL_KINDS * 10) MOD SL_KINDS + 1 : cy = 300 + (j - (p - INT(p))) * 110
            IF cy > 150 AND cy < 450 THEN
                a = 255 : IF j <> 0 OR NOT slotStop(k) THEN a = 140
                DrawSlotSymbol s, x + 83, cy, a
            END IF
        NEXT
        LINE (x, 136)-(x + 166, 189), _RGB32(10, 2, 16), BF : LINE (x, 411)-(x + 166, 462), _RGB32(10, 2, 16), BF ' (the window: what's outside it hidden)
    NEXT
    LINE (110, 298)-(689, 301), _RGBA32(255, 70, 200, 90), BF ' (the pay line)
    MenuText 400, 470, "SPACE OR CLICK STOPS THE REELS", 1.5, _RGB32(150, 120, 200), 1
    IF LEN(big$) THEN LINE (140, 500)-(659, 570), _RGB32(10, 2, 16), BF : LINE (140, 500)-(659, 570), _RGB32(255, 220, 80), B : MenuText 400, 516, big$, 2.5, _RGB32(255, 220, 80), 1
END SUB

' One slot symbol, centred on (x, y): its picture (the game's own, loaded
' once) - or, the lucky 7, a big 7
SUB DrawSlotSymbol(s, x, y, a)
    STATIC pic&(SL_KINDS), got
    DIM k, f$ ' (its own: the main program shares these names)
    IF NOT got THEN
        got = -1
        FOR k = 1 TO SL_ARMOR
            f$ = ArtPath$(ListItem$("barrel.png,stalker.png,pickup-scatter.png,medkit.png,ammo.png,armor.png", k))
            pic&(k) = _LOADIMAGE(f$, 32)
        NEXT
    END IF
    IF s = SL_SEVEN THEN
        MenuText x, y - 40, "7", 6, _RGB32(255, 220, 60), 1
    ELSEIF pic&(s) < -1 THEN
        _PUTIMAGE (x - 48, y - 48)-(x + 47, y + 47), pic&(s)
    END IF
    IF a < 255 THEN LINE (x - 82, MaxOf(191, y - 54))-(x + 82, MinOf(409, y + 54)), _RGBA32(20, 8, 30, 255 - a), BF ' (not in the window, or still spinning: dimmer)
END SUB

' Pay out what the reels came up with, at the machine (slotDeco): three
' bombs, it blows up - and twice more beside it; three monsters, three
' come out of it; three guns, one you haven't got (or ammo); health, ammo,
' armour, plenty; the jackpot, everything; a pair, a little of it
SUB SlotPay
    DIM k, n, a, sx, sy, mt, s, got ' (its own: the main program shares these names)
    sx = decoX(slotDeco) : sy = decoY(slotDeco) : a = DAtan2(playerY - sy, playerX - sx)
    IF slotReel(1) = slotReel(2) AND slotReel(2) = slotReel(3) THEN s = slotReel(1) : n = 3 ELSE s = slotPair : n = 1
    IF s = 0 THEN ShowMsg "NEON SLOTS: no luck" : EXIT SUB
    ShowMsg "NEON SLOTS: " + SlotSays$
    SELECT CASE s
        CASE SL_BOMB
            IF n = 3 THEN ' (the machine, and a chain of two more: a big bang)
                barrel = slotDeco : Explode
                FOR k = 1 TO 2 : blastAtX = sx + DCos(a + 2.1 * k) * 0.9 : blastAtY = sy + DSin(a + 2.1 * k) * 0.9 : BlastAt : NEXT
            ELSE
                newBlastX = sx : newBlastY = sy : newBlastSize = 0.4 : AddBlast : SfxAt sndBarrel&, sx, sy, playerX, playerY : shake = shake + 4 ' (a fizzle and a puff)
            END IF
        CASE SL_MON
            FOR k = 1 TO n
                mt = VAL(MID$("0102040607121313", 1 + INT(GRnd * 8) * 2, 2)) ' (a drone, gunner, crawler, stalker, spitter, trooper or ripper)
                got = SpawnMonster(mt, sx + DCos(a + (k - 2) * 0.9) * 1.1, sy + DSin(a + (k - 2) * 0.9) * 1.1, 0, playerX, playerY)
                IF NOT got THEN got = SpawnMonster(mt, sx, sy, 0, playerX, playerY) ' (no room there: at the machine itself)
            NEXT
            shake = shake + 4 : PlaySfx sndAlarm&, 0.7
        CASE SL_GUN
            IF n = 3 THEN
                k = IT_CELLS : IF NOT hasGun(W_ROCKET) THEN k = IT_LAUNCHER
                IF NOT hasGun(4) THEN k = IT_RAIL
                IF NOT hasGun(3) THEN k = IT_REPEATER
                IF NOT hasGun(2) THEN k = IT_SCATTER
                TossItem k, sx, sy, a, playerX, playerY
            ELSE
                TossItem IT_SHELLS, sx, sy, a, playerX, playerY
            END IF
        CASE SL_MED
            TossItem IT_BIGMED, sx, sy, a - 0.3, playerX, playerY : IF n = 3 THEN TossItem IT_BIGMED, sx, sy, a + 0.3, playerX, playerY : TossItem IT_HEALTH, sx, sy, a, playerX, playerY
        CASE SL_AMMO
            TossItem IT_CELLS, sx, sy, a - 0.3, playerX, playerY : IF n = 3 THEN TossItem IT_SHELLS, sx, sy, a + 0.3, playerX, playerY : TossItem IT_CELLS, sx, sy, a + 0.6, playerX, playerY : TossItem IT_SHELLS, sx, sy, a - 0.6, playerX, playerY
        CASE SL_ARMOR
            TossItem IT_ARMOR, sx, sy, a, playerX, playerY : IF n = 3 THEN TossItem IT_ARMOR, sx, sy, a + 0.4, playerX, playerY
        CASE SL_SEVEN ' The jackpot
            TossItem IT_AMP, sx, sy, a - 0.5, playerX, playerY : TossItem IT_OVERCHARGE, sx, sy, a - 0.15, playerX, playerY
            TossItem IT_ARMOR, sx, sy, a + 0.15, playerX, playerY : TossItem StashLoot(1), sx, sy, a + 0.5, playerX, playerY
            Achieve "NC_ARCADE", 0
    END SELECT
END SUB
