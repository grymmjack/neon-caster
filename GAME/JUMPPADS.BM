''
' NEON-CASTER - GAME/JUMPPADS.BM
' =============================================================================
' Jump pads: their numbers, the launch, and their consoles (GAME/JUMPPADS.BI).
'

' --- The level built: each pad's DIR, ANGLE, POWER from its [things] line
' (x, y, jumppad, DIR, ANGLE, POWER - as made 0, 45, 30)
SUB JumpPadsBuild
    DIM i, k, t$ ' (its own: the main program shares these names)
    padAir = 0 : jpLast = 0
    FOR i = 1 TO MAX_MON : monPadAir(i) = 0 : monPadLast(i) = 0 : NEXT
    FOR i = 1 TO numDecos
        IF decoKind(i) = DK_JUMPPAD THEN
            jpDir(i) = 0 : jpAng(i) = 45 : jpPow(i) = 30
            k = XtraFind("things", INT(decoX(i)), INT(decoY(i)), 0)
            IF k THEN
                t$ = XtraField$(k, 4) : IF LEN(t$) THEN jpDir(i) = VAL(t$)
                t$ = XtraField$(k, 5) : IF LEN(t$) THEN jpAng(i) = VAL(t$)
                t$ = XtraField$(k, 6) : IF LEN(t$) THEN jpPow(i) = VAL(t$)
            END IF
            JumpPadClamp i
        END IF
    NEXT
END SUB

' A pad's numbers kept sensible: DIR 0-359, ANGLE 5-90, POWER 5-100
SUB JumpPadClamp(i)
    jpDir(i) = jpDir(i) - 360 * INT(jpDir(i) / 360)
    jpAng(i) = MaxOf(5, MinOf(90, jpAng(i))) : jpPow(i) = MaxOf(5, MinOf(100, jpPow(i)))
END SUB

' The jump pad in cell x, y (0: none)
FUNCTION JumpPadAt(x, y)
    DIM i ' (its own: the main program shares these names)
    IF x < 0 OR y < 0 OR x >= mapN OR y >= mapN THEN EXIT FUNCTION
    i = decoCell(x, y)
    IF i THEN IF decoKind(i) = DK_JUMPPAD AND decoOn(i) THEN JumpPadAt = i
END FUNCTION

' --- Each frame, before you move: standing on a pad (on the floor, near
' its middle), you're shot off it - and once you've stepped off it, it's
' ready again. In the air from one: no walking (padAir - chapter 9)
SUB JumpPadStep
    DIM i, a!, e!, v! ' (its own: the main program shares these names)
    IF dead OR editMode OR flyMode OR cyberOn THEN padAir = 0 : EXIT SUB
    i = JumpPadAt(INT(playerX), INT(playerY))
    IF i = 0 THEN jpLast = 0 : EXIT SUB
    IF i = jpLast OR padAir OR playerVZ <> 0 THEN EXIT SUB
    IF playerZ > floorH(INT(playerX), INT(playerY)) + 0.05 THEN EXIT SUB
    IF (playerX - decoX(i)) ^ 2 + (playerY - decoY(i)) ^ 2 > 0.16 THEN EXIT SUB ' (onto the plate, not its edge)
    a! = jpDir(i) * 0.0174533 : e! = jpAng(i) * 0.0174533 : v! = jpPow(i) / 100
    playerVZ = -v! * DSin(e!) ' (up: playerVZ, down is +)
    knockX = DCos(a!) * v! * DCos(e!) : knockY = DSin(a!) * v! * DCos(e!) ' (and along: kept all the way - padAir)
    padAir = -1 : jpLast = i : levelFlat = 0 : rocketAir = 0
    SfxAt sndJumpPad&, decoX(i), decoY(i), playerX, playerY : shake = shake + 3
    SpawnSparks decoX(i), decoY(i), 0.1, 18, 255, 200, 80
END SUB

' --- Space on jump-pad console i: its pad's DIR, ANGLE and POWER, on a
' screen of their own (JumpPadRun) - set, the pad's changed. A demo plays
' back what was set (j: DIR x 1000000 + ANGLE x 1000 + POWER; -1 left as it was)
SUB JumpPadConsole(i)
    DIM p, r& ' (its own: the main program shares these names)
    p = JumpPadAt(decoTX(i), decoTY(i))
    IF p = 0 THEN ShowMsg "LAUNCH CONTROL: no pad answers" : PlaySfx sndLocked&, 0.6 : EXIT SUB
    IF demoPlay THEN
        demoKind$ = "j" : DemoTakeRes : r& = demoRes : fireWait = 15
    ELSE
        jpVal(1) = jpDir(p) : jpVal(2) = jpAng(p) : jpVal(3) = jpPow(p)
        JumpPadRun p
        r& = -1 : IF jpOK THEN r& = CLNG(INT(jpVal(1))) * 1000000& + CLNG(INT(jpVal(2))) * 1000& + CLNG(INT(jpVal(3))) ' (whole numbers: a SINGLE would round 90046030 to ...32)
        IF demoRec THEN demoKind$ = "j" : demoRes = r& : DemoEvent
    END IF
    IF r& >= 0 THEN
        jpDir(p) = r& \ 1000000 : jpAng(p) = (r& \ 1000) MOD 1000 : jpPow(p) = r& MOD 1000 : JumpPadClamp p
        PlaySfx sndPadOK&, 0.8 : ShowMsg "LAUNCH CONTROL: set - DIR" + STR$(jpDir(p)) + "  ANGLE" + STR$(jpAng(p)) + "  POWER" + STR$(jpPow(p))
    END IF
END SUB

' The console's own loop (the world waits): DIR, ANGLE, POWER - Up and
' Down pick one, Left and Right turn it (Shift: by ten), or type it;
' Enter sets the pad, Esc leaves it as it was
SUB JumpPadRun(p) STATIC
    DIM k&, f, t$, done, st ' (its own: the main program shares these names)
    DIM clickWas, mx, my, b ' (its own: the main program shares these names)
    WorldLoopsOff : _MOUSESHOW : _KEYCLEAR : WHILE _MOUSEINPUT : WEND
    jpField = 1 : jpOK = 0 : done = 0 : t$ = "" : clickWas = -1
    DO
        _LIMIT 60
        WHILE _MOUSEINPUT : WEND
        mx = WideMouseX(_MOUSEX) : my = _MOUSEY : st = 1 : IF _KEYDOWN(100304) OR _KEYDOWN(100303) THEN st = 10
        IF _MOUSEBUTTON(1) AND NOT clickWas THEN ' (a click: a row picks it; its - and + turn it; SET and LEAVE)
            FOR f = 1 TO 3
                b = 170 + (f - 1) * 90
                IF my >= b - 8 AND my <= b + 52 THEN
                    jpField = f : t$ = ""
                    IF mx >= 130 AND mx < 176 THEN jpVal(f) = jpVal(f) - st : PlaySfx sndPadBeep&, 0.4
                    IF mx > 624 AND mx <= 670 THEN jpVal(f) = jpVal(f) + st : PlaySfx sndPadBeep&, 0.4
                END IF
            NEXT
            IF my >= 400 AND my <= 436 THEN
                IF mx >= 230 AND mx <= 380 THEN jpOK = -1 : done = -1
                IF mx >= 420 AND mx <= 570 THEN done = -1
            END IF
        END IF
        clickWas = _MOUSEBUTTON(1)
        IF jpVal(1) < 0 THEN jpVal(1) = jpVal(1) + 360
        IF jpVal(1) >= 360 THEN jpVal(1) = jpVal(1) - 360
        jpVal(2) = MaxOf(5, MinOf(90, jpVal(2))) : jpVal(3) = MaxOf(5, MinOf(100, jpVal(3)))
        k& = _KEYHIT
        DO WHILE k&
            st = 1 : IF _KEYDOWN(100304) OR _KEYDOWN(100303) THEN st = 10
            SELECT CASE k&
                CASE 18432 : jpField = (jpField + 1) MOD 3 + 1 : t$ = "" ' (Up)
                CASE 20480, 9 : jpField = jpField MOD 3 + 1 : t$ = "" ' (Down, Tab)
                CASE 19200 : jpVal(jpField) = jpVal(jpField) - st : t$ = ""
                CASE 19712 : jpVal(jpField) = jpVal(jpField) + st : t$ = ""
                CASE 48 TO 57 : IF LEN(t$) < 3 THEN t$ = t$ + CHR$(k&) : jpVal(jpField) = VAL(t$)
                CASE 8 : IF LEN(t$) THEN t$ = LEFT$(t$, LEN(t$) - 1) : jpVal(jpField) = VAL(t$)
                CASE 13 : jpOK = -1 : done = -1
                CASE 27 : done = -1
            END SELECT
            IF jpVal(1) < 0 THEN jpVal(1) = jpVal(1) + 360
            IF jpVal(1) >= 360 THEN jpVal(1) = jpVal(1) - 360
            jpVal(2) = MaxOf(5, MinOf(90, jpVal(2))) : jpVal(3) = MaxOf(5, MinOf(100, jpVal(3)))
            k& = _KEYHIT
        LOOP
        DrawJumpPad p, t$
        IF glReady THEN GLSL_filter_capture
        GLScreenLayer glReady : ShowFrame
    LOOP UNTIL done
    _KEYCLEAR : _MOUSEHIDE _DISABLE : WHILE _MOUSEINPUT : WEND : mouseSettle = 8
    escWas = -1 : fireWait = 15 : spaceWas = -1
END SUB

' The launch control's screen: where its pad is, and its three numbers
SUB DrawJumpPad(p, typing$)
    DIM f, y, l$, v$, col AS _UNSIGNED LONG ' (its own: the main program shares these names)
    LINE (0, 0)-(799, 599), _RGB32(4, 6, 14), BF
    FOR y = 0 TO 599 STEP 3 : LINE (0, y)-(799, y), _RGB32(0, 0, 6) : NEXT
    MenuText 400, 40, "LAUNCH CONTROL", 3, _RGB32(255, 190, 70), 1
    MenuText 400, 100, "JUMP PAD AT" + STR$(INT(decoX(p))) + "," + STR$(INT(decoY(p))) + "     YOU:" + STR$(INT(playerX)) + "," + STR$(INT(playerY)), 1.5, _RGB32(200, 210, 230), 1
    FOR f = 1 TO 3
        y = 170 + (f - 1) * 90
        l$ = MID$("DIRECTIONANGLE    POWER    ", (f - 1) * 9 + 1, 9)
        v$ = LTRIM$(STR$(INT(jpVal(f))))
        IF f = jpField AND LEN(typing$) THEN v$ = typing$ + "_"
        IF f = jpField THEN col = _RGB32(255, 230, 120) : LINE (180, y - 8)-(620, y + 52), _RGBA32(255, 160, 40, 60), BF : LINE (180, y - 8)-(620, y + 52), _RGB32(255, 190, 70), B ELSE col = _RGB32(170, 180, 200)
        MenuText 210, y + 6, RTRIM$(l$), 2.5, col, 0
        MenuText 590, y + 6, v$, 2.5, col, 2
        LINE (130, y - 8)-(176, y + 52), _RGB32(40, 44, 60), BF : LINE (130, y - 8)-(176, y + 52), _RGB32(120, 126, 140), B : MenuText 153, y + 6, "-", 2.5, _RGB32(230, 235, 245), 1
        LINE (624, y - 8)-(670, y + 52), _RGB32(40, 44, 60), BF : LINE (624, y - 8)-(670, y + 52), _RGB32(120, 126, 140), B : MenuText 647, y + 6, "+", 2.5, _RGB32(230, 235, 245), 1
    NEXT
    LINE (230, 400)-(380, 436), _RGB32(30, 70, 40), BF : LINE (230, 400)-(380, 436), _RGB32(90, 255, 140), B : MenuText 305, 408, "SET", 2, _RGB32(150, 255, 180), 1
    LINE (420, 400)-(570, 436), _RGB32(60, 30, 30), BF : LINE (420, 400)-(570, 436), _RGB32(255, 110, 90), B : MenuText 495, 408, "LEAVE", 2, _RGB32(255, 170, 150), 1
    MenuText 400, 456, "DIRECTION: DEGREES - 0 EAST, 90 SOUTH, 180 WEST, 270 NORTH (AS THE MAP)", 1, _RGB32(150, 160, 180), 1
    MenuText 400, 476, "ANGLE: DEGREES UP FROM THE FLOOR     POWER: HUNDREDTHS OF A CELL A FRAME", 1, _RGB32(150, 160, 180), 1
    MenuText 400, 496, "HOW FAR, ON THE LEVEL: POWER x POWER x SIN(2 x ANGLE) / (100 x GRAVITY%) CELLS", 1, _RGB32(150, 160, 180), 1
    MenuText 400, 560, "CLICK - AND + (SHIFT x10), OR UP / DOWN AND LEFT / RIGHT, OR TYPE - ENTER SETS IT, ESC LEAVES IT", 1, _RGB32(140, 135, 175), 1
END SUB

' --- Over the view: a launch control (or a jump pad) you're looking at,
' near enough to use - its pad's numbers on a little screen, without a
' Space (and Space adjusts them)
SUB JumpPadReadout
    DIM r!, cx, cy, i, p, t$ ' (its own: the main program shares these names)
    IF dead OR editMode OR cyberOn OR viewOn THEN EXIT SUB
    FOR r! = 0.4 TO 2 STEP 0.1
        cx = INT(playerX + dirX * r!) : cy = INT(playerY + dirY * r!)
        IF cx = INT(playerX) AND cy = INT(playerY) THEN _CONTINUE
        IF cx < 0 OR cy < 0 OR cx >= mapN OR cy >= mapN THEN EXIT SUB
        IF worldMap(cx, cy) > 0 THEN EXIT SUB
        i = decoCell(cx, cy)
        IF i THEN
            IF decoOn(i) AND decoKind(i) = DK_PADPC THEN p = JumpPadAt(decoTX(i), decoTY(i)) : t$ = "LAUNCH CONTROL" : EXIT FOR
            IF decoOn(i) AND decoKind(i) = DK_JUMPPAD AND r! <= 1.4 THEN p = i : t$ = "JUMP PAD" : EXIT FOR
        END IF
    NEXT
    IF LEN(t$) = 0 THEN EXIT SUB
    LINE (255, 372)-(545, 448), _RGBA32(4, 14, 10, 210), BF : LINE (255, 372)-(545, 448), _RGBA32(90, 255, 160, 200), B
    MenuText 400, 378, t$, 1.25, _RGB32(255, 200, 90), 1
    IF p = 0 THEN MenuText 400, 400, "NO PAD ANSWERS", 1.25, _RGB32(255, 110, 90), 1 : EXIT SUB
    MenuText 400, 398, "PAD" + STR$(INT(decoX(p))) + "," + LTRIM$(STR$(INT(decoY(p)))), 1, _RGB32(150, 200, 170), 1
    MenuText 400, 414, "DIR" + STR$(jpDir(p)) + "  ANGLE" + STR$(jpAng(p)) + "  POWER" + STR$(jpPow(p)), 1.25, _RGB32(150, 255, 190), 1
    IF t$ = "LAUNCH CONTROL" THEN MenuText 400, 433, "SPACE: ADJUST", 1, _RGB32(120, 170, 140), 1
END SUB

' --- Each frame, monster i: in the air from a pad, its arc - along (walls
' stop it), up and down by the sector's gravity, its height off the floor
' kept in monFly (so it's drawn there, and shoots from there); landed,
' it's on its feet again. On the ground, a walker that steps onto a pad's
' plate is shot off it, as you are - one chasing you across a gap follows
SUB MonPadStep(i)
    DIM p, a!, e!, v!, fz!, g!, mx!, my! ' (its own: the main program shares these names)
    IF monPadAir(i) THEN
        IF monsterState(i) >= 2 THEN monPadAir(i) = 0 : monFly(i) = 0 : EXIT SUB ' (killed in the air: down it comes)
        walkZ = monPadZ(i) : MoveBody monsterX(i), monsterY(i), monPadVX(i), monPadVY(i) : walkZ = -999
        IF lvlGravity = 100 THEN g! = FALL_G ELSE g! = FALL_G * lvlGravity / 100
        monPadVZ(i) = monPadVZ(i) + g! : monPadZ(i) = monPadZ(i) - monPadVZ(i)
        fz! = FloorAt(monsterX(i), monsterY(i))
        IF monPadVZ(i) < 0 AND monPadZ(i) > ceilH(INT(monsterX(i)), INT(monsterY(i))) - mtypeScale(monsterType(i)) - 0.02 THEN monPadZ(i) = ceilH(INT(monsterX(i)), INT(monsterY(i))) - mtypeScale(monsterType(i)) - 0.02 : monPadVZ(i) = 0
        IF monPadZ(i) <= fz! THEN monPadAir(i) = 0 : monFly(i) = 0 : monPadLast(i) = JumpPadAt(INT(monsterX(i)), INT(monsterY(i))) ELSE monFly(i) = monPadZ(i) - fz!
        EXIT SUB
    END IF
    IF monsterState(i) >= 2 OR mtypeLift(monsterType(i)) > 0 OR mtypeSpeed(monsterType(i)) <= 0 OR monsterType(i) = MT_TURRET THEN EXIT SUB
    p = JumpPadAt(INT(monsterX(i)), INT(monsterY(i)))
    IF p = 0 THEN monPadLast(i) = 0 : EXIT SUB
    IF p = monPadLast(i) THEN EXIT SUB
    IF (monsterX(i) - decoX(p)) ^ 2 + (monsterY(i) - decoY(p)) ^ 2 > 0.16 THEN EXIT SUB
    a! = jpDir(p) * 0.0174533 : e! = jpAng(p) * 0.0174533 : v! = jpPow(p) / 100
    monPadAir(i) = -1 : monPadLast(i) = p : monPadZ(i) = FloorAt(monsterX(i), monsterY(i))
    monPadVZ(i) = -v! * DSin(e!) : monPadVX(i) = DCos(a!) * v! * DCos(e!) : monPadVY(i) = DSin(a!) * v! * DCos(e!)
    SfxAt sndJumpPad&, decoX(p), decoY(p), playerX, playerY
END SUB
