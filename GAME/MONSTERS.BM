''
' NEON-CASTER - GAME/MONSTERS.BM
' =============================================================================
' Monsters: getting hit (HitMonster), weak spots, spawning, the thief,
' bolts, and the monster table (SetMonType, monsters.txt).
'

' === GUNS, MONSTERS AND PICKUPS ===============================================

' --- A shot hits monster number target - in its weak spot, if head is on
' (it reached it at height headZ): then WEAK_MULT times hitDamage, a cry
' of pain, a crunch, and a burst of sparks there
SUB HitMonsterAimed STATIC
    IF head THEN
        hitWas = hitDamage : hitDamage = hitDamage * WEAK_MULT : HitMonster : hitDamage = hitWas
        IF achHeadAt <> achFrame AND NOT cyberOn THEN AchAdd "Headshots", 1 : achHeadAt = achFrame ' (once a shot: the scatter's seven pellets are one headshot)
        IF monsterState(target) < 2 THEN SfxAt mtypePainSnd&(monsterType(target)), monsterX(target), monsterY(target), playerX, playerY
        IF sndHeadshot& THEN PlaySfx sndHeadshot&, 0.8
        SpawnSparks monsterX(target), monsterY(target), MaxOf(0.05, headZ - FloorAt(monsterX(target), monsterY(target))), 18, 255, 230, 120
    ELSE
        HitMonster
    END IF
    head = 0
END SUB

' --- A shot (or blast) hits monster number target, for hitDamage
SUB HitMonster STATIC
    IF monsterType(target) = MT_TURRET THEN ' (a turret still hidden, or coming out: nothing to hit yet - but a shot at its hatch wakes it: out it comes)
        IF monDeploy(target) < TURRET_UP THEN
            IF monDeploy(target) >= 0 AND monsterState(target) = 0 THEN monsterState(target) = 1 : monsterTimer(target) = 10
            EXIT SUB
        END IF
    END IF
    monsterHP(target) = monsterHP(target) - hitDamage : monsterHurt(target) = 8
    IF monsterType(target) = MT_THIEF AND thiefState(target) = 2 AND monsterHP(target) > 0 AND NOT cyberOn THEN ThiefSpill target ' (a thief with your things: each hit knocks some loose)
    IF monsterState(target) = 0 THEN monsterState(target) = 1 : monsterTimer(target) = 30 ' Shot awake (chapter 13)
    IF monsterHP(target) <= 0 AND monsterState(target) < 2 THEN
        monsterState(target) = 2 : monsterTimer(target) = MON_DYING : kills = kills + 1
        mt = monsterType(target) ' (its drop - monsters.txt)
        IF NOT cyberOn THEN ' (achievements: the network's ICE doesn't count)
            AchAdd "Kills", 1 : IF mt >= 1 AND mt <= MON_TYPES AND mt <> MT_ICE AND mt <> MT_EYEBOT THEN AchBit "KillKinds", mt + (mt > MT_ICE) - 1 ' (bits 0-14: every kind but ICE)
            IF mt = 8 THEN Achieve "NC_OVERSEER", 0
            IF mt = MT_THIEF THEN Achieve "NC_THIEF", 0
            IF ampTimer > 0 THEN achAmpKills = achAmpKills + 1 : IF achAmpKills >= 5 THEN Achieve "NC_AMPED", 0
            IF achInBlast THEN achBlastKills = achBlastKills + 1 : IF achBlastKills >= 3 THEN Achieve "NC_CHAIN", 0
        END IF
        IF mtypeDrop(mt) > 0 AND NOT cyberOn THEN IF GRnd < mtypeDropChance(mt) THEN DropItemAt mtypeDrop(mt), monsterX(target), monsterY(target)
        IF monsterType(target) = MT_THIEF THEN DropThiefLoot target
        IF (mt = MT_WARDEN OR mt = MT_COLOSSUS) AND NOT cyberOn THEN BossLoot target
        IF mt = MT_TURRET THEN monBlown(target) = 1 ' (it blows up - in the monsters' next turn: TurretBlown)
        IF mt = MT_EYEBOT AND monRush(target) = 1 THEN monRush(target) = 3 ' (shot down mid-rush: it blows up where it is - in the monsters' next turn: EyebotBoom)
        IF mt = MT_TURRET AND monFrom(target) = 0 THEN SpawnSparks monsterX(target), monsterY(target), ceilH(INT(monsterX(target)), INT(monsterY(target))) - FloorAt(monsterX(target), monsterY(target)) - 0.05, 26, 255, 210, 120 ' (a turret from the ceiling: sparks out of its mount, and it falls - chapter 16)
        IF monsterType(target) = 8 THEN Say "bossdie", 0
        SfxAt mtypeDieSnd&(monsterType(target)), monsterX(target), monsterY(target), playerX, playerY
        IF kills = numMonsters THEN ShowMsg "SECTOR CLEAR - every monster destroyed!"
    ELSE
        SfxAt mtypeHitSnd&(monsterType(target)), monsterX(target), monsterY(target), playerX, playerY
    END IF
END SUB

' --- A thief bot's turn (monster i, hunting): run at you and grab what it
' can - half your ammo, and a gun (the one in your hands, unless that's the
' blaster) - then run home: down the thieves' way (thiefDist, each step to
' a cell nearer the hoard) to its door, where it cowers. Hurt before it's
' got anything, it runs home empty-handed. A level with no hoard: it just
' runs away from you.
SUB ThiefStep STATIC
    IF thiefState(i) = 0 AND monsterHurt(i) > 0 THEN thiefState(i) = 1
    IF thiefState(i) = 0 THEN
        goX = toPlayerX / distance : goY = toPlayerY / distance
        IF distance < mtypeReach(mtype) AND NOT GlassBetween(monsterX(i), monsterY(i), playerX, playerY) AND ABS(MonFoot(i) - playerZ) <= 0.7 THEN ' Got you: grab (not up or down a ledge)
            thiefCells(i) = ammoCount(AM_CELLS) \ 2 : thiefShells(i) = ammoCount(AM_SHELLS) \ 2
            ammoCount(AM_CELLS) = ammoCount(AM_CELLS) - thiefCells(i) : ammoCount(AM_SHELLS) = ammoCount(AM_SHELLS) - thiefShells(i)
            g = 0
            IF currentGun <> W_BLASTER THEN
                g = currentGun
            ELSE
                FOR gg = NUM_GUNS TO 2 STEP -1
                    IF hasGun(gg) AND g = 0 THEN g = gg
                NEXT
            END IF
            IF g THEN hasGun(g) = 0 : IF currentGun = g THEN currentGun = W_BLASTER
            IF g THEN IF nextGun = g THEN nextGun = W_BLASTER ' (the one you were swapping to: gone too)
            thiefGun(i) = g : thiefState(i) = 2
            PlaySfx sndSteal&, 1 : monsterAtk(i) = ATTACK_FRAMES
            t$ = "A THIEF BOT grabbed"
            IF g THEN t$ = t$ + " your " + gunName$(g) + " and"
            ShowMsg t$ + " half your cells and shells! Get them back!"
            IF RND < 0.5 THEN Say "thief", 0
        END IF
    ELSE
        cx = INT(monsterX(i)) : cy = INT(monsterY(i))
        IF thiefDist(cx, cy) >= 30000 THEN ' (no way home: just away from you)
            goX = -toPlayerX / distance : goY = -toPlayerY / distance
        ELSEIF thiefDist(cx, cy) = 0 AND thiefState(i) = 2 THEN ' Home with your things: in through its door - and the hoard locks for good
            ThiefEscape
        ELSEIF thiefDist(cx, cy) > 0 THEN ' One cell nearer home
            bx = cx : by = cy : bd = thiefDist(cx, cy)
            FOR k = 1 TO 4
                nx = cx + (k = 1) - (k = 2) : ny = cy + (k = 3) - (k = 4)
                IF thiefDist(nx, ny) < bd THEN bd = thiefDist(nx, ny) : bx = nx : by = ny
            NEXT
            tx = bx + 0.5 - monsterX(i) : ty = by + 0.5 - monsterY(i) : tl = SQR(tx * tx + ty * ty)
            IF tl > 0.01 THEN goX = tx / tl : goY = ty / tl
        END IF ' (home: it cowers - goX, goY stay 0)
    END IF
END SUB

' --- Thief i is home with what it stole (at its hoard's door): it slips
' inside and locks it behind it - gone, your things with it, and that
' hoard shut for good (evState 3: no killing the rest opens it). Kill a
' thief before it gets there, and it can't.
SUB ThiefEscape STATIC
    FOR evH = 1 TO numEvents
        IF evType(evH) = EV_HOARD AND evState(evH) = 0 THEN
            IF cx >= evX0(evH) - 2 AND cx <= evX1(evH) + 2 AND cy >= evY0(evH) - 2 AND cy <= evY1(evH) + 2 THEN
                evState(evH) = 3 : monsterState(i) = 4 ' (4: gone - not dead, not drawn, not counted alive)
                SpawnSparks monsterX(i), monsterY(i), 0.4, 14, 255, 200, 80
                SfxAt sndDoor&, monsterX(i), monsterY(i), playerX, playerY : SfxAt sndLocked&, monsterX(i), monsterY(i), playerX, playerY
                ShowMsg "The thief got home with your things - its hoard is LOCKED FOR GOOD!"
                EXIT FOR
            END IF
        END IF
    NEXT
END SUB

' One more monster, of type t, at (x, y) - if there's floor there, nothing
' else standing on it, and room in the list - hunting you at once, sent by
' event ev. It arrives in a flash of sparks, heard from where you are (px, py).
FUNCTION SpawnMonster(t, x, y, ev, px, py)
    DIM i, j, ok ' (its own: the main program shares these names)
    IF numMonsters >= MAX_MON THEN EXIT FUNCTION
    walkFromHaz = 10 : ok = Walkable%(x, y) : walkFromHaz = 0 ' (as a monster would: not in fire, not over a pit)
    IF NOT ok THEN EXIT FUNCTION
    FOR j = 1 TO numMonsters
        IF monsterState(j) < 2 THEN IF (monsterX(j) - x) ^ 2 + (monsterY(j) - y) ^ 2 < 0.6 THEN EXIT FUNCTION
    NEXT
    numMonsters = numMonsters + 1 : i = numMonsters
    monsterX(i) = x : monsterY(i) = y : monsterType(i) = t : monsterHP(i) = mtypeHP(t)
    monsterState(i) = 1 : monsterTimer(i) = 40 : monsterHurt(i) = 0 : monsterAtk(i) = 0 : monsterAnim(i) = 0 : monsterEv(i) = ev
    monSight(i) = MON_SIGHT : monHear(i) = 0 : monSpd(i) = 1 : monWake(i) = WAKE_SEE
    ThiefReset i : MonFresh i
    IF t = MT_TURRET THEN monDeploy(i) = TURRET_UP ' (a turret summoned: out already)
    SpawnSparks x, y, 0.5, 16, 200, 120, 255
    SfxAt sndSpawn&, x, y, px, py
    SpawnMonster = -1
END FUNCTION

'' A thief bot's pockets, empty
' Monster i, starting in cell (x, y): as every monster of its kind is - or
' as the level's [monsters] says this one is
SUB MonOwn(i, x, y)
    DIM k ' (its own: the main program shares these names)
    monSight(i) = MON_SIGHT : monHear(i) = 0 : monSpd(i) = 1 : monWake(i) = WAKE_SEE : IF monsterType(i) = MT_MIMIC THEN monWake(i) = WAKE_HIT ' (a mimic: only a shot - or you, right by it: MimicWake)
    monWeap(i) = TW_PLASMA : monTrack(i) = TURRET_TRACK : monEject(i) = TURRET_UP / TURRET_EJECT : monTMode(i) = TURRET_AUTO ' (a turret: as made - unless its line says)
    monsterHP(i) = mtypeHP(monsterType(i)) : IF monsterType(i) = MT_TURRET AND monDeploy(i) > 0 THEN monDeploy(i) = 0 ' (folded away till it wakes: the editor can change a live one's line)
    FOR k = 1 TO lvlMonN
        IF lvlMon(k, 1) = x AND lvlMon(k, 2) = y THEN
            monSight(i) = lvlMon(k, 3) : monHear(i) = lvlMon(k, 4) : monSpd(i) = lvlMon(k, 6) / 100 : monWake(i) = lvlMon(k, 7)
            monWeap(i) = MaxOf(0, MinOf(TURRET_WEAPONS, lvlMon(k, 8))) ' (a turret's weapon: TW_)
            IF lvlMon(k, 9) > 0 THEN monTrack(i) = MaxOf(10, MinOf(360, lvlMon(k, 9))) ' (and how fast it turns)
            IF lvlMon(k, 10) > 0 THEN monEject(i) = TURRET_UP / MaxOf(4, MinOf(600, lvlMon(k, 10))) ' (how many frames it takes to come out)
            monTMode(i) = MaxOf(0, MinOf(TURRET_OUT, lvlMon(k, 11))) : IF monTMode(i) = TURRET_OUT AND monsterType(i) = MT_TURRET THEN monDeploy(i) = TURRET_UP ' (and how it starts)
            monsterHP(i) = MaxOf(1, INT(mtypeHP(monsterType(i)) * lvlMon(k, 5) / 100))
            IF monWake(i) = WAKE_HUNT THEN monsterState(i) = 1 : monsterTimer(i) = 60
        END IF
    NEXT
END SUB

SUB ThiefReset(i)
    thiefCells(i) = 0 : thiefShells(i) = 0 : thiefGun(i) = 0 : thiefState(i) = 0
END SUB

' Thief i, hit (not destroyed) with your things on it: some of them fly
' out - a pack of cells or shells, whichever it has more of (a coin toss
' between them), or now and then the gun it took
SUB ThiefSpill(i)
    DIM a, k, x, y ' (its own: the main program shares these names)
    x = monsterX(i) : y = monsterY(i) : a = GRnd * 6.2832
    IF thiefGun(i) AND GRnd < 0.25 THEN
        SELECT CASE thiefGun(i)
            CASE W_SCATTER : k = IT_SCATTER
            CASE W_REPEATER : k = IT_REPEATER
            CASE W_ROCKET : k = IT_LAUNCHER
            CASE ELSE : k = IT_RAIL
        END SELECT
        TossItem k, x, y, a, playerX, playerY : thiefGun(i) = 0
        ShowMsg "The thief dropped your gun!"
    ELSEIF thiefCells(i) >= 15 AND (thiefShells(i) < 8 OR GRnd < 0.5) THEN
        lootExact = -1 : TossItem IT_CELLS, x, y, a, playerX, playerY : lootExact = 0 : thiefCells(i) = thiefCells(i) - 15 ' (your own cells, back)
    ELSEIF thiefShells(i) >= 8 THEN
        TossItem IT_SHELLS, x, y, a, playerX, playerY : thiefShells(i) = thiefShells(i) - 8
    END IF
END SUB

' A thief bot (monster i) is destroyed: what it stole spills out round it
SUB DropThiefLoot(i)
    DIM c, k, n, x, y ' (its own: the main program shares these names)
    x = monsterX(i) : y = monsterY(i) : n = 0
    IF thiefGun(i) THEN
        SELECT CASE thiefGun(i)
            CASE W_SCATTER : k = IT_SCATTER
            CASE W_REPEATER : k = IT_REPEATER
            CASE W_ROCKET : k = IT_LAUNCHER
            CASE ELSE : k = IT_RAIL
        END SELECT
        DropItemAt k, x, y : n = n + 1
    END IF
    lootExact = -1 : FOR c = 1 TO (thiefCells(i) + 14) \ 15 : DropItemAt IT_CELLS, x + DCos(n * 2.1) * 0.35, y + DSin(n * 2.1) * 0.35 : n = n + 1 : NEXT : lootExact = 0 ' (your own cells, back)
    FOR c = 1 TO (thiefShells(i) + 7) \ 8 : DropItemAt IT_SHELLS, x + DCos(n * 2.1) * 0.35, y + DSin(n * 2.1) * 0.35 : n = n + 1 : NEXT
    IF n THEN ShowMsg "The thief dropped your things!"
    ThiefReset i
END SUB

' One monster type's weak spot (chapter 6): a box on its picture
SUB SetWeakSpot(t, u0, u1, v0, v1)
    mtypeWS(t, 1) = u0 : mtypeWS(t, 2) = u1 : mtypeWS(t, 3) = v0 : mtypeWS(t, 4) = v1
END SUB

' How high monster i's feet are: on the floor (or hovering over it, by its
' lift) - but a turret out of the ceiling hangs from it, its feet a turret's
' height below it
FUNCTION MonFoot(i)
    DIM t ' (its own: the main program shares these names)
    t = monsterType(i)
    IF t = MT_TURRET AND monFrom(i) = TURRET_CEIL THEN MonFoot = ceilH(INT(monsterX(i)), INT(monsterY(i))) - mtypeScale(t) : EXIT FUNCTION
    IF t = MT_TURRET AND monFrom(i) = TURRET_WALL THEN MonFoot = FloorAt(monsterX(i), monsterY(i)) + 0.3 : EXIT FUNCTION ' (on a wall: chest high)
    MonFoot = FloorAt(monsterX(i), monsterY(i)) + mtypeLift(t) + monFly(i) ' (a flyer: up where it's flown)
END FUNCTION

' Does a shot at height z go over or under monster i? Only when you aim
' up and down yourself (OpenGL's LOOK UP / DOWN): with the view level
' (the software renderer, or LOOK off) a shot finds a monster at any
' height in its column, as DOOM's aim does. Plenty of leeway either way.
FUNCTION ShotPasses(i, z)
    DIM t ' (its own: the main program shares these names)
    IF monsterType(i) = MT_TURRET THEN ' (a turret not out yet: a shot hits its hatch - waking it, HitMonster - when it's asleep; else they go by)
        IF monDeploy(i) < TURRET_UP AND NOT (monDeploy(i) = 0 AND monsterState(i) = 0 AND monTMode(i) <> TURRET_HELD) THEN ShotPasses = -1 : EXIT FUNCTION ' (folded away, or on its way: nothing to hit - asleep in its housing, its hatch is: HitMonster wakes it. No waking here: QB64's AND runs this for every monster, every shot)
    END IF
    IF NOT lookAim THEN EXIT FUNCTION ' (level aim: whatever's in the middle column is hit, high or low)
    t = monsterType(i)
    foot = MonFoot(i)
    ShotPasses = (z < foot - 0.3 OR z > foot + mtypeScale(t) + 0.5) ' (generous: level aim still finds a crawler down a step - aim at the ceiling or the floor, and it goes by)
END FUNCTION

' Did a shot land in monster i's weak spot? u: where across its picture
' (0 left .. 1 right), z: how high the shot was as it reached it (in walls,
' like the floor) - turned into how far down its picture (0 top .. 1 foot),
' from where it stands and how tall it is, as chapter 16 draws it
FUNCTION WeakSpotHit(i, u, z)
    DIM t, v ' (its own: the main program shares these names)
    t = monsterType(i) : IF mtypeWS(t, 2) <= mtypeWS(t, 1) THEN EXIT FUNCTION
    foot = MonFoot(i) + mtypeBob(t) * DSin(lvFrame / 24 + i * 1.7) ' (by the frame clock, not TIMER: a headshot depends on it - a demo must get the same)
    v = (foot + mtypeScale(t) - z) / mtypeScale(t)
    WeakSpotHit = u >= mtypeWS(t, 1) AND u <= mtypeWS(t, 2) AND v >= mtypeWS(t, 3) AND v <= mtypeWS(t, 4)
END FUNCTION

' --- Monster definitions (monsters.txt, chapter 21's monster editor) ---
' One [name] section a monster, "key = value" lines - the numbers of its
' SetMonType line (chapter 3), whether it shoots, and what it may drop
SUB ReadMonsters
    DIM c, k, l$, t, v ' (its own: the main program shares these names)
    f$ = AssetPath$("monsters.txt")
    IF NOT _FILEEXISTS(f$) THEN EXIT SUB
    fh = FREEFILE : OPEN f$ FOR INPUT AS #fh : t = 0
    DO UNTIL EOF(fh)
        LINE INPUT #fh, l$
        l$ = LTRIM$(RTRIM$(l$)) : IF RIGHT$(l$, 1) = CHR$(13) THEN l$ = LEFT$(l$, LEN(l$) - 1)
        IF LEFT$(l$, 1) = "[" AND RIGHT$(l$, 1) = "]" THEN
            n$ = LCASE$(MID$(l$, 2, LEN(l$) - 2)) : t = 0
            FOR k = 1 TO MON_TYPES
                IF mtypeName$(k) = n$ THEN t = k
            NEXT
        ELSEIF t > 0 AND INSTR(l$, "=") AND LEFT$(l$, 1) <> "'" THEN
            eq = INSTR(l$, "=") : k$ = LCASE$(RTRIM$(LEFT$(l$, eq - 1))) : v$ = LTRIM$(MID$(l$, eq + 1))
            v = VAL(v$)
            SELECT CASE k$
                CASE "hp" : mtypeHP(t) = v
                CASE "speed" : mtypeSpeed(t) = v
                CASE "height" : mtypeScale(t) = v
                CASE "lift" : mtypeLift(t) = v
                CASE "bob" : mtypeBob(t) = v
                CASE "reach" : mtypeReach(t) = v
                CASE "damage" : mtypeDamage(t) = v
                CASE "damage_extra" : mtypeDamageRnd(t) = v
                CASE "cooldown" : mtypeCooldown(t) = v
                CASE "shoots" : mtypeRanged(t) = (LCASE$(v$) = "yes")
                CASE "drops" ' an item's map letter (chapter 22), then the chance
                    mtypeDrop(t) = 0 : IF LEN(v$) THEN mtypeDrop(t) = ItemOfChar(LEFT$(v$, 1))
                    c = INSTR(v$, " ") : IF c THEN mtypeDropChance(t) = VAL(MID$(v$, c + 1)) ELSE mtypeDropChance(t) = 1
            END SELECT
        END IF
    LOOP
    CLOSE #fh
END SUB

SUB WriteMonsters
    DIM t ' (its own: the main program shares these names)
    nl$ = CHR$(10)
    o$ = "' NEON-CASTER monsters - every kind's numbers (chapter 3's SetMonType" + nl$
    o$ = o$ + "' lines), changed here without changing the program. The monster editor" + nl$
    o$ = o$ + "' (M in the level editor, or monsters in the console) writes this file." + nl$
    o$ = o$ + "'   hp: hits to kill   speed: cells a frame (you walk 0.06, run 0.12)" + nl$
    o$ = o$ + "'   height: in walls   lift, bob: hovering   reach: how close it must be to hit" + nl$
    o$ = o$ + "'   damage + up to damage_extra - 1 more   cooldown: frames between attacks" + nl$
    o$ = o$ + "'   shoots: yes or no   drops: a pickup's map letter and the chance (0 to 1)" + nl$
    FOR t = 1 TO MON_TYPES
        o$ = o$ + nl$ + "[" + mtypeName$(t) + "]" + nl$
        o$ = o$ + "hp           = " + LTRIM$(STR$(mtypeHP(t))) + nl$
        o$ = o$ + "speed        = " + LTRIM$(STR$(mtypeSpeed(t))) + nl$
        o$ = o$ + "height       = " + LTRIM$(STR$(mtypeScale(t))) + nl$
        o$ = o$ + "lift         = " + LTRIM$(STR$(mtypeLift(t))) + nl$
        o$ = o$ + "bob          = " + LTRIM$(STR$(mtypeBob(t))) + nl$
        o$ = o$ + "reach        = " + LTRIM$(STR$(mtypeReach(t))) + nl$
        o$ = o$ + "damage       = " + LTRIM$(STR$(mtypeDamage(t))) + nl$
        o$ = o$ + "damage_extra = " + LTRIM$(STR$(mtypeDamageRnd(t))) + nl$
        o$ = o$ + "cooldown     = " + LTRIM$(STR$(mtypeCooldown(t))) + nl$
        IF mtypeRanged(t) THEN o$ = o$ + "shoots       = yes" + nl$ ELSE o$ = o$ + "shoots       = no" + nl$
        IF mtypeDrop(t) THEN o$ = o$ + "drops        = " + ItemChar$(mtypeDrop(t)) + " " + LTRIM$(STR$(mtypeDropChance(t))) + nl$ ELSE o$ = o$ + "drops        =" + nl$
    NEXT
    f$ = AssetPath$("monsters.txt")
    IF _FILEEXISTS(f$) THEN KILL f$
    fh = FREEFILE : OPEN f$ FOR BINARY AS #fh : PUT #fh, , o$ : CLOSE #fh
END SUB

' A monster's bolt at (x, y), z high: the decoration it's flown into, if
' any (not a body: they lie flat) - its middle a little more than a bolt's
' width away, and the bolt no higher than its top
FUNCTION BoltDeco(x, y, z)
    DIM cx, cy, d ' (its own: the main program shares these names)
    cx = INT(x) : cy = INT(y)
    IF cx < 0 OR cy < 0 OR cx >= mapN OR cy >= mapN OR cyberOn THEN EXIT FUNCTION
    d = decoCell(cx, cy) : IF d = 0 THEN EXIT FUNCTION
    IF NOT decoOn(d) OR DecoFlat(decoKind(d)) THEN EXIT FUNCTION
    IF (x - decoX(d)) ^ 2 + (y - decoY(d)) ^ 2 > 0.32 * 0.32 THEN EXIT FUNCTION
    IF z > FloorAt(decoX(d), decoY(d)) + DecoScale(decoKind(d)) THEN ' (over it - unless barrels stand on it: the one there)
        d = DecoStackAt(cx, cy, z - FloorAt(decoX(d), decoY(d))) : IF d = 0 THEN EXIT FUNCTION
    END IF
    BoltDeco = d
END FUNCTION

' The thieves' way home: from the cells outside every hoard's doors, how
' many steps to each open cell (a flood fill, as the moving lights' -
' chapter 24), through doors that need no keycard. 30000: no way.
SUB BuildThiefWay
    DIM ev, head, k, nx, ny, ok, v, x, y ' (its own: the main program shares these names)
    FOR y = 0 TO mapN : FOR x = 0 TO mapN : thiefDist(x, y) = 30000 : NEXT : NEXT
    head = 0 : tail = 0
    FOR ev = 1 TO numEvents
        IF evType(ev) = EV_HOARD THEN
            FOR y = evY0(ev) - 1 TO evY1(ev) + 1 : FOR x = evX0(ev) - 1 TO evX1(ev) + 1
                IF x > 0 AND y > 0 AND x < mapN - 1 AND y < mapN - 1 THEN
                    IF worldMap(x, y) = 2 THEN ' A door into the hoard: the cells outside it are home
                        FOR k = 1 TO 4
                            nx = x + (k = 1) - (k = 2) : ny = y + (k = 3) - (k = 4)
                            IF NOT InRoom(ev, nx + 0.5, ny + 0.5) AND worldMap(nx, ny) <= 0 AND thiefDist(nx, ny) > 0 THEN
                                thiefDist(nx, ny) = 0 : fillX(tail) = nx : fillY(tail) = ny : tail = tail + 1
                            END IF
                        NEXT
                    END IF
                END IF
            NEXT : NEXT
        END IF
    NEXT
    DO WHILE head < tail
        x = fillX(head) : y = fillY(head) : head = head + 1
        FOR k = 1 TO 4
            nx = x + (k = 1) - (k = 2) : ny = y + (k = 3) - (k = 4)
            IF nx > 0 AND ny > 0 AND nx < mapN - 1 AND ny < mapN - 1 THEN
                v = worldMap(nx, ny) : ok = (v <= 0 AND diagCorner(nx, ny) = 0 AND boxOn(nx, ny) = 0 AND glassHP(nx, ny) <= 0) ' (a block's cell, or a pane of glass, is no way through for a fleeing thief)
                IF decoCell(nx, ny) THEN IF NOT DecoFlat(decoKind(decoCell(nx, ny))) THEN ok = 0 ' (nor a decoration standing in the way - it would stick behind it, steps from home)
                IF v = 2 THEN ok = (doorKey(nx, ny) = 0 AND doorType(nx, ny) <> DOOR_EXIT)
                IF ok AND thiefDist(nx, ny) > thiefDist(x, y) + 1 THEN
                    thiefDist(nx, ny) = thiefDist(x, y) + 1 : fillX(tail) = nx : fillY(tail) = ny : tail = tail + 1
                END IF
            END IF
        NEXT
    LOOP
END SUB

' One row of the monster types table (chapter 6)
SUB SetMonType(mtype, title$, hitPoints, speed, scale, lift, bob, reach, damage, damageRnd, cooldown, sprite)
    mtypeName$(mtype) = title$ : mtypeHP(mtype) = hitPoints : mtypeSpeed(mtype) = speed : mtypeScale(mtype) = scale
    mtypeLift(mtype) = lift : mtypeBob(mtype) = bob : mtypeReach(mtype) = reach
    mtypeDamage(mtype) = damage : mtypeDamageRnd(mtype) = damageRnd : mtypeCooldown(mtype) = cooldown : mtypeSprite(mtype) = sprite
END SUB

' A bolt from (x, y), flying along (dirX, dirY), into the first free slot
SUB FireBolt(x, y, dirX, dirY, damage)
    DIM d, i ' (its own: the main program shares these names)
    FOR i = 1 TO MAX_BOLTS
        IF boltOn(i) = 0 THEN
            boltOn(i) = -1 : boltX(i) = x + dirX * 0.4 : boltY(i) = y + dirY * 0.4 : boltKind(i) = BK_PLASMA : boltLife(i) = 0 : boltOwner(i) = boltFromMon
            ' (a shooter pressed up against glass would start it on the far
            ' side: then it starts from the shooter, and bursts on the pane)
            IF GlassBetween(x, y, boltX(i), boltY(i)) OR InGlass(boltX(i), boltY(i)) THEN boltX(i) = x : boltY(i) = y
            boltDX(i) = dirX : boltDY(i) = dirY : boltDamage(i) = damage
            ' (its height: from the shooter's middle, towards yours)
            boltZ(i) = floorH(INT(x), INT(y)) + 0.49 : IF boltFromZ > 0 THEN boltZ(i) = boltFromZ
            IF boltFromMon AND boltFromZ = 0 THEN IF monFly(boltFromMon) > 0 THEN boltZ(i) = MonFoot(boltFromMon) + mtypeScale(monsterType(boltFromMon)) * 0.5 ' (a flyer: from up where it is)
            d = SQR((playerX - x) ^ 2 + (playerY - y) ^ 2) : boltDZ(i) = 0
            IF d > 0.5 THEN boltDZ(i) = (playerZ + 0.49 - boltZ(i)) / d
            IF boltFromMon AND monVs THEN ' (at the monster it's turned on: its middle)
                d = SQR((monTX - x) ^ 2 + (monTY - y) ^ 2) : boltDZ(i) = 0
                IF d > 0.5 THEN boltDZ(i) = (monTZ + mtypeScale(monsterType(monVs)) * 0.5 - boltZ(i)) / d
            END IF
            EXIT SUB
        END IF
    NEXT
END SUB

' The monsters' map characters, in type order (chapter 3): m drone, g
' gunner, h heavy, c crawler, s sentry, k stalker, w spitter, z the
' overseer, T thief, (ICE: only in the network - no character), 1 sniper,
' 5 trooper, 6 ripper, 7 the warden, 0 the colossus, ~ a turret (from the
' ceiling; _ is one from the floor)
FUNCTION MonChars$
    MonChars$ = "mghcskwzT" + CHR$(1) + "15670~]" + CHR$(1) + CHR$(1) ' (] the mimic: the chest's [ the other way round; the robot dog: a thing, ")
END FUNCTION

' The monster type of map character c$ - 0 if it's no monster's
FUNCTION MonOfChar(c$)
    IF c$ = "_" OR c$ = "|" THEN MonOfChar = MT_TURRET : EXIT FUNCTION ' (turrets out of the floor, and a wall)
    IF LEN(c$) = 1 AND c$ <> CHR$(1) THEN MonOfChar = INSTR(MonChars$, c$)
END FUNCTION

' A beam, for t frames (BEAM_AIM a laser aiming, BEAM_SHOT firing)
SUB AddBeam(kind, x0, y0, z0, x1, y1, z1, t)
    DIM k ' (its own: the main program shares these names)
    FOR k = 1 TO MAX_BEAMS
        IF beamT(k) <= 0 THEN
            beamKind(k) = kind : beamX0(k) = x0 : beamY0(k) = y0 : beamZ0(k) = z0 : beamX1(k) = x1 : beamY1(k) = y1 : beamZ1(k) = z1 : beamT(k) = t
            EXIT SUB
        END IF
    NEXT
END SUB

' One frame of monster i's laser, aiming (monAim frames to go): its end
' follows you, a little behind - lag of the way to you a frame - drawn
' as a faint red line; then it fires, white-hot, on to the first wall past
' where it was aimed. You're hit (dmg) if you're still near its line.
SUB MonLaser(i, dmg, lag)
    DIM mx, my, z0, ex, ey, ux, uy, d, s, dd, best, bestD, k ' (its own: the main program shares these names)
    mx = monsterX(i) : my = monsterY(i)
    monAimX(i) = monAimX(i) + (monTX - monAimX(i)) * lag : monAimY(i) = monAimY(i) + (monTY - monAimY(i)) * lag ' (lagging behind who it's after)
    monAim(i) = monAim(i) - 1
    z0 = MonFoot(i) + mtypeScale(monsterType(i)) * 0.62 ' (a turret's: from where it's mounted)
    IF monsterType(i) = MT_TURRET THEN TurretMuzzle i, 1, mx, my, z0 ' (out of its barrel)
    IF monAim(i) > 0 THEN AddBeam BEAM_AIM, mx, my, z0, monAimX(i), monAimY(i), monTZ + 0.42, 1 : EXIT SUB
    ' Fire: out along the aim to the first wall (24 cells at most)
    ux = monAimX(i) - mx : uy = monAimY(i) - my : d = SQR(ux * ux + uy * uy) : IF d < 0.01 THEN EXIT SUB
    ux = ux / d : uy = uy / d : s = 0.3
    DO WHILE s < 24
        ex = mx + ux * s : ey = my + uy * s
        IF ex < 0 OR ey < 0 OR ex >= mapN OR ey >= mapN THEN EXIT DO
        IF worldMap(INT(ex), INT(ey)) > 0 THEN EXIT DO
        s = s + 0.08
    LOOP
    ' What's on the beam first: you, or a monster (any but its own) - by
    ' how far along it, and near enough it
    best = 0 : bestD = s
    dd = (playerX - mx) * ux + (playerY - my) * uy
    IF dd > 0 AND dd < bestD AND NOT dead THEN IF ABS((playerX - mx) * uy - (playerY - my) * ux) < LASER_HIT THEN best = -1 : bestD = dd
    FOR k = 1 TO numMonsters
        IF k <> i AND monsterState(k) < 2 AND NOT (monsterType(k) = MT_TURRET AND monDeploy(k) < TURRET_UP) THEN
            dd = (monsterX(k) - mx) * ux + (monsterY(k) - my) * uy
            IF dd > 0.3 AND dd < bestD THEN IF ABS((monsterX(k) - mx) * uy - (monsterY(k) - my) * ux) < 0.35 THEN best = k : bestD = dd
        END IF
    NEXT
    IF best > 0 THEN s = bestD ' (it stops at the monster it burns)
    AddBeam BEAM_SHOT, mx, my, z0, mx + ux * s, my + uy * s, z0 + (monTZ + 0.42 - z0) * s / MaxOf(d, 0.5), 9
    SfxAt mtypeAttackSnd&(monsterType(i)), mx, my, playerX, playerY
    monsterAtk(i) = ATTACK_FRAMES
    IF best = -1 THEN damage = dmg : hurtFromX = mx : hurtFromY = my : hurtR = 255 : hurtG = 40 : hurtB = 40 : HurtPlayer
    IF best > 0 THEN SpawnSparks monsterX(best), monsterY(best), 0.5, 10, 255, 80, 60 : MonHurtBy best, i, dmg
END SUB

' A laser starting to aim: at where you are, give or take a cell
SUB MonLaserStart(i, frames)
    monAim(i) = frames : monAimX(i) = monTX + (GRnd - 0.5) * 2 : monAimY(i) = monTY + (GRnd - 0.5) * 2
END SUB

' One bolt from monster i at you, turned by a (radians), for dmg
SUB MonBoltAt(i, a, dmg)
    DIM ux, uy, bx, by, mx!, my!, mz! ' (its own: the main program shares these names)
    ux = toPlayerX / distance : uy = toPlayerY / distance
    bx = ux * DCos(a) - uy * DSin(a) : by = ux * DSin(a) + uy * DCos(a)
    IF monsterType(i) = MT_TURRET THEN ' (a turret: out of a barrel's end, one then the other)
        monTurn(i) = monTurn(i) + 1 : TurretMuzzle i, 1 + monTurn(i) MOD 2, mx!, my!, mz!
        boltFromZ = mz! : FireBolt mx! - bx * 0.4, my! - by * 0.4, bx, by, dmg
    ELSE
        FireBolt monsterX(i), monsterY(i), bx, by, dmg
    END IF
    boltFromZ = 0
END SUB

' The newer kinds' turn, hunting you (chapter 13 calls it, with distance,
' toPlayerX and toPlayerY worked out): how each one fights (mtypeStyle),
' and where it walks - goX, goY, as chapter 13 has them.
SUB MonStyleTurn(i)
    DIM mt, sn, k, a ' (its own: the main program shares these names)
    mt = monsterType(i) : sn = CanSee(monsterX(i), monsterY(i), monTX, monTY) ' (who it's after: you, or the monster it's turned on)
    goX = 0 : goY = 0
    SELECT CASE mtypeStyle(mt)
        CASE STYLE_LASER ' The sniper: well back, still while it aims
            IF monAim(i) > 0 THEN
                IF sn THEN MonLaser i, mtypeDamage(mt) + INT(GRnd * mtypeDamageRnd(mt)), 0.06 ELSE monAim(i) = 0 : monsterTimer(i) = 30 ' (lost you: it lowers its rifle)
                IF monAim(i) = 0 THEN monsterTimer(i) = mtypeCooldown(mt) + INT(GRnd * 40)
                EXIT SUB
            END IF
            IF distance > 12 OR NOT sn THEN goX = toPlayerX / distance : goY = toPlayerY / distance
            IF distance < 6 THEN goX = -toPlayerX / distance : goY = -toPlayerY / distance
            IF sn AND monsterTimer(i) = 0 AND distance < 18 THEN MonLaserStart i, LASER_AIM : SfxAt mtypeAlertSnd&(mt), monsterX(i), monsterY(i), playerX, playerY
        CASE STYLE_BURST, STYLE_TURRET ' The trooper, a turret: bursts of bolts
            IF mtypeStyle(mt) = STYLE_TURRET THEN
                IF monDeploy(i) < 0 THEN EXIT SUB ' (switched off: hacked)
                IF monTWant(i) = -1 THEN ' Told to go in: back into its housing, and folded away there till it's told to come out
                    monLock(i) = 0 : monBurst(i) = 0 : monAim(i) = 0
                    IF monDeploy(i) >= TURRET_UP THEN SfxAt sndLiftStart&, monsterX(i), monsterY(i), playerX, playerY
                    monDeploy(i) = MaxOf(0, monDeploy(i) - monEject(i))
                    IF monDeploy(i) = 0 THEN monTWant(i) = 0 : monTMode(i) = TURRET_HELD
                    EXIT SUB
                END IF
                IF monTMode(i) = TURRET_HELD AND monTWant(i) <> 1 THEN EXIT SUB ' (folded away: it waits to be told)
                IF monDeploy(i) < TURRET_UP THEN
                    IF monDeploy(i) = 0 THEN SfxAt sndLiftStart&, monsterX(i), monsterY(i), playerX, playerY ' (coming out)
                    monDeploy(i) = MinOf(TURRET_UP, monDeploy(i) + monEject(i)) : EXIT SUB
                END IF
                IF monTWant(i) = 1 THEN monTWant(i) = 0 : monTMode(i) = TURRET_AUTO ' (out, as told: a turret like any other now)
                IF monTOff(i) THEN monLock(i) = 0 : EXIT SUB ' (switched off by a command: out, but still)
                TurretTrack i, sn ' (turning to you: it fires once it's on you - GAME/TURRETS.BM)
                IF sn AND NOT (monWeap(i) = TW_LASER AND monAim(i) > 0) THEN TurretSight i
                IF monWeap(i) <> TW_PLASMA THEN TurretFire i : EXIT SUB ' (laser, lightning, sprays, missiles: GAME/TURRETS.BM)
            ELSE
                IF distance > GUNNER_FAR OR NOT sn THEN goX = toPlayerX / distance : goY = toPlayerY / distance
                IF distance < GUNNER_NEAR THEN goX = -toPlayerX / distance : goY = -toPlayerY / distance
            END IF
            IF monBurst(i) > 0 THEN
                monGap(i) = monGap(i) - 1
                IF monGap(i) <= 0 AND sn THEN
                    a = (GRnd - 0.5) * 0.12 : IF mtypeStyle(mt) = STYLE_TURRET THEN a = a + monAimA(i) - DAtan2(toPlayerY, toPlayerX) ' (a turret: along its aim)
                    MonBoltAt i, a, mtypeDamage(mt) + INT(GRnd * mtypeDamageRnd(mt))
                    SfxAt mtypeAttackSnd&(mt), monsterX(i), monsterY(i), playerX, playerY
                    monsterAtk(i) = ATTACK_FRAMES : monBurst(i) = monBurst(i) - 1 : monGap(i) = 7
                END IF
                IF NOT sn THEN monBurst(i) = 0
            ELSEIF sn AND monsterTimer(i) = 0 AND distance < 13 AND (mtypeStyle(mt) <> STYLE_TURRET OR TurretReady(i)) THEN
                monBurst(i) = 3 : IF mtypeStyle(mt) = STYLE_TURRET THEN monBurst(i) = 5
                monGap(i) = 0 : monsterTimer(i) = mtypeCooldown(mt) + INT(GRnd * 30)
            END IF
        CASE STYLE_WARDEN ' The warden: a laser, then a ring of bolts and a fan at you - turn about
            IF monAim(i) > 0 THEN
                IF sn THEN MonLaser i, 24, 0.09 ELSE monAim(i) = 0
                IF monAim(i) = 0 THEN monsterTimer(i) = mtypeCooldown(mt)
                EXIT SUB
            END IF
            IF distance > 10 OR NOT sn THEN goX = toPlayerX / distance : goY = toPlayerY / distance
            IF distance < 5 THEN goX = -toPlayerX / distance : goY = -toPlayerY / distance
            IF sn AND monsterTimer(i) = 0 AND distance < 15 THEN
                monTurn(i) = monTurn(i) + 1
                IF monTurn(i) MOD 2 = 1 THEN
                    MonLaserStart i, LASER_AIM - 14 : SfxAt mtypeAlertSnd&(mt), monsterX(i), monsterY(i), playerX, playerY
                ELSE
                    FOR k = 0 TO 9 : MonBoltAt i, k * 0.6283, mtypeDamage(mt) \ 2 : NEXT ' (a ring of ten)
                    FOR a = -0.2 TO 0.21 STEP 0.2 : MonBoltAt i, a, mtypeDamage(mt) : NEXT ' (and three at you)
                    SfxAt mtypeAttackSnd&(mt), monsterX(i), monsterY(i), playerX, playerY : monsterAtk(i) = ATTACK_FRAMES
                    monsterTimer(i) = mtypeCooldown(mt) + 40
                END IF
            END IF
        CASE STYLE_EYEBOT ' The eyebot: zaps you from five to eight cells, circling; after a couple of zaps (or you near) it rushes you - and blows up
            IF monRush(i) = 1 THEN
                monBurst(i) = monBurst(i) + 1
                goX = toPlayerX / distance * EYE_DASH : goY = toPlayerY / distance * EYE_DASH
                IF mtypeLift(mt) > 0 THEN MonFlyTurn i : MonFlyTurn i ' (up or down to you, twice as quick)
                IF monBurst(i) MOD MaxOf(4, INT(distance * 3)) = 0 THEN SfxAt sndEyeBeep&, monsterX(i), monsterY(i), playerX, playerY ' (beeping, faster as it nears)
                a = SQR(distance * distance + (MonFoot(i) + mtypeScale(mt) / 2 - monTZ - 0.35) ^ 2)
                IF a < 0.8 OR monBurst(i) > EYE_FUSE THEN EyebotBoom i
                EXIT SUB
            END IF
            IF monAim(i) > 0 THEN
                IF sn THEN MonLaser i, mtypeDamage(mt) + INT(GRnd * mtypeDamageRnd(mt)), 0.12 ELSE monAim(i) = 0
                IF monAim(i) = 0 THEN monsterTimer(i) = mtypeCooldown(mt) + INT(GRnd * 30) : monTurn(i) = monTurn(i) + 1
                EXIT SUB
            END IF
            IF sn AND (distance < EYE_RUSH OR (monTurn(i) >= EYE_ZAPS AND distance < 10)) THEN
                monRush(i) = 1 : monBurst(i) = 0 : SfxAt sndEyeRush&, monsterX(i), monsterY(i), playerX, playerY : EXIT SUB
            END IF
            IF distance > 8 OR NOT sn THEN goX = toPlayerX / distance : goY = toPlayerY / distance
            IF distance < 5 THEN ' (near: round you, not at you)
                goX = -toPlayerY / distance * 0.8 : goY = toPlayerX / distance * 0.8 : IF i MOD 2 THEN goX = -goX : goY = -goY
            END IF
            IF sn AND monsterTimer(i) = 0 AND distance < 14 THEN MonLaserStart i, 22 : SfxAt mtypeAlertSnd&(mt), monsterX(i), monsterY(i), playerX, playerY
        CASE STYLE_RIPPER ' The ripper: hit and run - in fast (a lunge, the last two cells), a slash, and a leap back
            IF monBurst(i) > 0 THEN ' (leaping back, a little to one side)
                monBurst(i) = monBurst(i) - 1
                goX = (-toPlayerX - toPlayerY * 0.5) / distance : goY = (-toPlayerY + toPlayerX * 0.5) / distance
                IF i MOD 2 THEN goX = (-toPlayerX + toPlayerY * 0.5) / distance : goY = (-toPlayerY - toPlayerX * 0.5) / distance
                EXIT SUB
            END IF
            IF distance > mtypeReach(mt) OR GlassBetween(monsterX(i), monsterY(i), monTX, monTY) OR ABS(MonFoot(i) - monTZ) > 0.7 THEN
                goX = toPlayerX / distance : goY = toPlayerY / distance
                IF distance < 2.2 AND sn AND monsterTimer(i) = 0 THEN goX = goX * 1.6 : goY = goY * 1.6 ' (the lunge)
            ELSEIF monsterTimer(i) = 0 THEN ' Within reach: the slash
                MonStrike i, mtypeDamage(mt) + INT(GRnd * mtypeDamageRnd(mt))
                SfxAt mtypeAttackSnd&(mt), monsterX(i), monsterY(i), playerX, playerY : monsterAtk(i) = ATTACK_FRAMES : monsterTimer(i) = mtypeCooldown(mt)
                monBurst(i) = RIPPER_BACK
                IF NOT godMode AND monVs = 0 THEN clawFx = CLAW_FX : clawX = 260 + RND * 280 : clawY = 200 + RND * 160 : clawA = 0.5 + RND * 0.5 : IF RND < 0.5 THEN clawA = -clawA
            END IF
        CASE STYLE_COLOSSUS ' The colossus: comes on and on - close, a slam that shakes the floor; far, heavy bolts
            goX = toPlayerX / distance : goY = toPlayerY / distance
            IF monsterTimer(i) = 0 THEN
                IF distance < mtypeReach(mt) AND ABS(MonFoot(i) - monTZ) < 0.7 THEN
                    MonStrike i, mtypeDamage(mt) + INT(GRnd * mtypeDamageRnd(mt))
                    IF (monsterX(i) - playerX) ^ 2 + (monsterY(i) - playerY) ^ 2 < 36 THEN shake = shake + 14
                     SpawnSparks monsterX(i), monsterY(i), 0.05, 24, 255, 150, 60
                    PlaySfx mtypeAttackSnd&(mt), 1 : monsterAtk(i) = ATTACK_FRAMES : monsterTimer(i) = mtypeCooldown(mt)
                ELSEIF distance >= 3 AND sn AND distance < 12 THEN
                    FOR a = -0.25 TO 0.26 STEP 0.25 : MonBoltAt i, a, 12 : NEXT
                    SfxAt mtypeAlertSnd&(mt), monsterX(i), monsterY(i), playerX, playerY : monsterAtk(i) = ATTACK_FRAMES
                    monsterTimer(i) = mtypeCooldown(mt) + 30
                END IF
            END IF
    END SELECT
END SUB

' Monster i's own fighting state, fresh: not aiming, no burst, a turret hidden
SUB MonFresh(i)
    monSeen(i) = 0 : monRush(i) = 0 : iceKind(i) = 0 : monAim(i) = 0 : monBurst(i) = 0 : monGap(i) = 0 : monTurn(i) = 0 : monDeploy(i) = 0 : monEject(i) = TURRET_UP / TURRET_EJECT : monTMode(i) = TURRET_AUTO : monTWant(i) = 0 : monTOff(i) = 0 : monFrom(i) = TURRET_CEIL : monWeap(i) = TW_PLASMA : monBlown(i) = 0 : monAimA(i) = 0 : monTrack(i) = TURRET_TRACK : monLock(i) = 0 : monFly(i) = 0 : monFoe(i) = 0
END SUB

' A field boss's haul as it falls (monster i), thrown out towards you: the
' warden, an overcharge, armour and a gun you haven't got (else a big
' medkit); the colossus, a damage amp, a big medkit, cells and shells
SUB BossLoot(i)
    DIM a, k, g ' (its own: the main program shares these names)
    a = DAtan2(playerY - monsterY(i), playerX - monsterX(i))
    IF monsterType(i) = MT_WARDEN THEN
        g = IT_BIGMED : IF NOT hasGun(W_ROCKET) THEN g = IT_LAUNCHER
        IF NOT hasGun(4) THEN g = IT_RAIL
        IF NOT hasGun(3) THEN g = IT_REPEATER
        IF NOT hasGun(2) THEN g = IT_SCATTER
        TossItem IT_OVERCHARGE, monsterX(i), monsterY(i), a - 0.5, playerX, playerY
        TossItem IT_ARMOR, monsterX(i), monsterY(i), a, playerX, playerY
        TossItem g, monsterX(i), monsterY(i), a + 0.5, playerX, playerY
    ELSE
        TossItem IT_AMP, monsterX(i), monsterY(i), a - 0.6, playerX, playerY
        TossItem IT_BIGMED, monsterX(i), monsterY(i), a - 0.2, playerX, playerY
        TossItem IT_CELLS, monsterX(i), monsterY(i), a + 0.2, playerX, playerY
        TossItem IT_SHELLS, monsterX(i), monsterY(i), a + 0.6, playerX, playerY
    END IF
    ShowMsg UCASE$(mtypeName$(monsterType(i))) + " DOWN - it drops its haul"
END SUB

' --- Eyebot i blows itself up: a rocket's blast, smaller (EYE_BOOM_R),
' hard on you; it goes with it, in pieces
SUB EyebotBoom(i)
    IF monRush(i) = 2 THEN EXIT SUB
    monRush(i) = 2
    bsX = monsterX(i) : bsY = monsterY(i) : bsZ = MonFoot(i) + mtypeScale(MT_EYEBOT) * 0.5 : bsR = EYE_BOOM_R : bsMon = EYE_BOOM_MON : bsYou = EYE_BOOM_YOU
    bsSurf = -1 : bsOwner = i : bsYours = 0
    BlastSized
    IF monsterState(i) < 2 THEN target = i : hitDamage = 999 : HitMonster
    RocketKill i
    monFly(i) = 0
END SUB

' --- INFIGHTING. Monster j, hurt dmg by monster k (0: by none - you, or
' nothing): the hit - and, a third of the time, it turns on k (monFoe)
SUB MonHurtBy(j, k, dmg)
    target = j : hitDamage = dmg : hitKick = 0 : HitMonster
    IF k > 0 AND k <> j AND monsterState(j) < 2 AND NOT cyberOn THEN
        IF monsterState(k) < 2 AND GRnd < 0.33 THEN monFoe(j) = k : IF monsterState(j) = 0 THEN monsterState(j) = 1
    END IF
END SUB

' --- Monster i's blow lands on who it's after: you (HurtPlayer, from where it
' is) or the monster it's turned on
SUB MonStrike(i, dmg)
    IF monVs THEN
        MonHurtBy monVs, i, dmg
    ELSE
        damage = dmg : hurtFromX = monsterX(i) : hurtFromY = monsterY(i) : HurtPlayer
    END IF
END SUB

' --- Which monster (not the bolt's own shooter, not a hidden turret) a bolt
' at (x, y), height z, is in - 0 for none
FUNCTION BoltMon(x!, y!, z!, owner)
    DIM j, f! ' (its own: the main program shares these names)
    FOR j = 1 TO numMonsters
        IF j <> owner AND monsterState(j) < 2 AND (cyberOn = 0 OR monsterType(j) = MT_ICE) THEN
            IF (monsterX(j) - x!) ^ 2 + (monsterY(j) - y!) ^ 2 < 0.33 * 0.33 THEN
                IF NOT (monsterType(j) = MT_TURRET AND monDeploy(j) < TURRET_UP) THEN
                    f! = MonFoot(j)
                    IF z! > f! - 0.1 AND z! < f! + mtypeScale(monsterType(j)) + 0.1 THEN BoltMon = j : EXIT FUNCTION
                END IF
            END IF
        END IF
    NEXT
END FUNCTION

' --- One frame of flyer i (hunting): up or down towards who it's after -
' its middle at their chest - a little at a time, never into the floor
' (it hovers mtypeLift over it) or through the ceiling
SUB MonFlyTurn(i)
    DIM t, f!, want!, top! ' (its own: the main program shares these names)
    t = monsterType(i) : f! = FloorAt(monsterX(i), monsterY(i))
    want! = monTZ + 0.45 - mtypeScale(t) * 0.5 - f! - mtypeLift(t)
    top! = CeilAt(monsterX(i), monsterY(i)) - f! - mtypeLift(t) - mtypeScale(t) - 0.04
    IF want! > top! THEN want! = top!
    IF want! < 0 THEN want! = 0
    monFly(i) = monFly(i) + MaxOf(-0.03, MinOf(0.03, want! - monFly(i)))
    IF monFly(i) > top! THEN monFly(i) = MaxOf(0, top!) ' (a ceiling coming down: under it)
END SUB

' --- Mimic i wakes: not a chest after all - the lid snaps open on teeth,
' and it comes for you (Space on it, standing right by it; a shot wakes it
' as it wakes anything - HitMonster)
SUB MimicWake(i)
    IF monsterState(i) <> 0 THEN EXIT SUB
    monsterState(i) = 1 : monsterTimer(i) = 0
    SfxAt mtypeAlertSnd&(MT_MIMIC), monsterX(i), monsterY(i), playerX, playerY : shake = shake + 5
    ShowMsg "It's a MIMIC!"
END SUB
