''
' NEON-CASTER - GAME/MONSTERS.BM
' =============================================================================
' Monsters: getting hit (HitMonster), weak spots, spawning, the thief,
' bolts, and the monster table (SetMonType, monsters.txt).
'

' === GUNS, MONSTERS AND PICKUPS ===============================================

' --- A shot hits monster number target - in its weak spot, if head is on
' (it reached it at height headZ): then WEAK_MULT times hitDamage, a cry
' of pain, a crunch, and a burst of sparks there
SUB HitMonsterAimed STATIC
    IF head THEN
        hitWas = hitDamage : hitDamage = hitDamage * WEAK_MULT : HitMonster : hitDamage = hitWas
        IF achHeadAt <> achFrame AND NOT cyberOn THEN AchAdd "Headshots", 1 : achHeadAt = achFrame ' (once a shot: the scatter's seven pellets are one headshot)
        IF monsterState(target) < 2 THEN SfxAt mtypePainSnd&(monsterType(target)), monsterX(target), monsterY(target), playerX, playerY
        IF sndHeadshot& THEN PlaySfx sndHeadshot&, 0.8
        SpawnSparks monsterX(target), monsterY(target), MaxOf(0.05, headZ - FloorAt(monsterX(target), monsterY(target))), 18, 255, 230, 120
    ELSE
        HitMonster
    END IF
    head = 0
END SUB

' --- A shot (or blast) hits monster number target, for hitDamage
SUB HitMonster STATIC
    monsterHP(target) = monsterHP(target) - hitDamage : monsterHurt(target) = 8
    IF monsterType(target) = MT_THIEF AND thiefState(target) = 2 AND monsterHP(target) > 0 AND NOT cyberOn THEN ThiefSpill target ' (a thief with your things: each hit knocks some loose)
    IF monsterState(target) = 0 THEN monsterState(target) = 1 : monsterTimer(target) = 30 ' Shot awake (chapter 13)
    IF monsterHP(target) <= 0 AND monsterState(target) < 2 THEN
        monsterState(target) = 2 : monsterTimer(target) = MON_DYING : kills = kills + 1
        mt = monsterType(target) ' (its drop - monsters.txt)
        IF NOT cyberOn THEN ' (achievements: the network's ICE doesn't count)
            AchAdd "Kills", 1 : IF mt >= 1 AND mt <= 9 THEN AchBit "KillKinds", mt - 1
            IF mt = 8 THEN Achieve "NC_OVERSEER", 0
            IF mt = MT_THIEF THEN Achieve "NC_THIEF", 0
            IF ampTimer > 0 THEN achAmpKills = achAmpKills + 1 : IF achAmpKills >= 5 THEN Achieve "NC_AMPED", 0
            IF achInBlast THEN achBlastKills = achBlastKills + 1 : IF achBlastKills >= 3 THEN Achieve "NC_CHAIN", 0
        END IF
        IF mtypeDrop(mt) > 0 AND NOT cyberOn THEN IF GRnd < mtypeDropChance(mt) THEN DropItemAt mtypeDrop(mt), monsterX(target), monsterY(target)
        IF monsterType(target) = MT_THIEF THEN DropThiefLoot target
        IF monsterType(target) = 8 THEN Say "bossdie", 0
        SfxAt mtypeDieSnd&(monsterType(target)), monsterX(target), monsterY(target), playerX, playerY
        IF kills = numMonsters THEN ShowMsg "SECTOR CLEAR - every monster destroyed!"
    ELSE
        SfxAt mtypeHitSnd&(monsterType(target)), monsterX(target), monsterY(target), playerX, playerY
    END IF
END SUB

' --- A thief bot's turn (monster i, hunting): run at you and grab what it
' can - half your ammo, and a gun (the one in your hands, unless that's the
' blaster) - then run home: down the thieves' way (thiefDist, each step to
' a cell nearer the hoard) to its door, where it cowers. Hurt before it's
' got anything, it runs home empty-handed. A level with no hoard: it just
' runs away from you.
SUB ThiefStep STATIC
    IF thiefState(i) = 0 AND monsterHurt(i) > 0 THEN thiefState(i) = 1
    IF thiefState(i) = 0 THEN
        goX = toPlayerX / distance : goY = toPlayerY / distance
        IF distance < mtypeReach(mtype) AND NOT GlassBetween(monsterX(i), monsterY(i), playerX, playerY) AND ABS(FloorAt(monsterX(i), monsterY(i)) - playerZ) <= 0.7 THEN ' Got you: grab (not up or down a ledge)
            thiefCells(i) = ammoCount(AM_CELLS) \ 2 : thiefShells(i) = ammoCount(AM_SHELLS) \ 2
            ammoCount(AM_CELLS) = ammoCount(AM_CELLS) - thiefCells(i) : ammoCount(AM_SHELLS) = ammoCount(AM_SHELLS) - thiefShells(i)
            g = 0
            IF currentGun <> W_BLASTER THEN
                g = currentGun
            ELSE
                FOR gg = NUM_GUNS TO 2 STEP -1
                    IF hasGun(gg) AND g = 0 THEN g = gg
                NEXT
            END IF
            IF g THEN hasGun(g) = 0 : IF currentGun = g THEN currentGun = W_BLASTER
            IF g THEN IF nextGun = g THEN nextGun = W_BLASTER ' (the one you were swapping to: gone too)
            thiefGun(i) = g : thiefState(i) = 2
            PlaySfx sndSteal&, 1 : monsterAtk(i) = ATTACK_FRAMES
            t$ = "A THIEF BOT grabbed"
            IF g THEN t$ = t$ + " your " + gunName$(g) + " and"
            ShowMsg t$ + " half your ammo! Get it back!"
            IF RND < 0.5 THEN Say "thief", 0
        END IF
    ELSE
        cx = INT(monsterX(i)) : cy = INT(monsterY(i))
        IF thiefDist(cx, cy) >= 30000 THEN ' (no way home: just away from you)
            goX = -toPlayerX / distance : goY = -toPlayerY / distance
        ELSEIF thiefDist(cx, cy) = 0 AND thiefState(i) = 2 THEN ' Home with your things: in through its door - and the hoard locks for good
            ThiefEscape
        ELSEIF thiefDist(cx, cy) > 0 THEN ' One cell nearer home
            bx = cx : by = cy : bd = thiefDist(cx, cy)
            FOR k = 1 TO 4
                nx = cx + (k = 1) - (k = 2) : ny = cy + (k = 3) - (k = 4)
                IF thiefDist(nx, ny) < bd THEN bd = thiefDist(nx, ny) : bx = nx : by = ny
            NEXT
            tx = bx + 0.5 - monsterX(i) : ty = by + 0.5 - monsterY(i) : tl = SQR(tx * tx + ty * ty)
            IF tl > 0.01 THEN goX = tx / tl : goY = ty / tl
        END IF ' (home: it cowers - goX, goY stay 0)
    END IF
END SUB

' --- Thief i is home with what it stole (at its hoard's door): it slips
' inside and locks it behind it - gone, your things with it, and that
' hoard shut for good (evState 3: no killing the rest opens it). Kill a
' thief before it gets there, and it can't.
SUB ThiefEscape STATIC
    FOR evH = 1 TO numEvents
        IF evType(evH) = EV_HOARD AND evState(evH) = 0 THEN
            IF cx >= evX0(evH) - 2 AND cx <= evX1(evH) + 2 AND cy >= evY0(evH) - 2 AND cy <= evY1(evH) + 2 THEN
                evState(evH) = 3 : monsterState(i) = 4 ' (4: gone - not dead, not drawn, not counted alive)
                SpawnSparks monsterX(i), monsterY(i), 0.4, 14, 255, 200, 80
                SfxAt sndDoor&, monsterX(i), monsterY(i), playerX, playerY : SfxAt sndLocked&, monsterX(i), monsterY(i), playerX, playerY
                ShowMsg "The thief got home with your things - its hoard is LOCKED FOR GOOD!"
                EXIT FOR
            END IF
        END IF
    NEXT
END SUB

' One more monster, of type t, at (x, y) - if there's floor there, nothing
' else standing on it, and room in the list - hunting you at once, sent by
' event ev. It arrives in a flash of sparks, heard from where you are (px, py).
FUNCTION SpawnMonster(t, x, y, ev, px, py)
    DIM i, j, ok ' (its own: the main program shares these names)
    IF numMonsters >= MAX_MON THEN EXIT FUNCTION
    walkFromHaz = 10 : ok = Walkable%(x, y) : walkFromHaz = 0 ' (as a monster would: not in fire, not over a pit)
    IF NOT ok THEN EXIT FUNCTION
    FOR j = 1 TO numMonsters
        IF monsterState(j) < 2 THEN IF (monsterX(j) - x) ^ 2 + (monsterY(j) - y) ^ 2 < 0.6 THEN EXIT FUNCTION
    NEXT
    numMonsters = numMonsters + 1 : i = numMonsters
    monsterX(i) = x : monsterY(i) = y : monsterType(i) = t : monsterHP(i) = mtypeHP(t)
    monsterState(i) = 1 : monsterTimer(i) = 40 : monsterHurt(i) = 0 : monsterAtk(i) = 0 : monsterAnim(i) = 0 : monsterEv(i) = ev
    monSight(i) = MON_SIGHT : monHear(i) = 0 : monSpd(i) = 1 : monWake(i) = WAKE_SEE
    ThiefReset i
    SpawnSparks x, y, 0.5, 16, 200, 120, 255
    SfxAt sndSpawn&, x, y, px, py
    SpawnMonster = -1
END FUNCTION

'' A thief bot's pockets, empty
' Monster i, starting in cell (x, y): as every monster of its kind is - or
' as the level's [monsters] says this one is
SUB MonOwn(i, x, y)
    DIM k ' (its own: the main program shares these names)
    monSight(i) = MON_SIGHT : monHear(i) = 0 : monSpd(i) = 1 : monWake(i) = WAKE_SEE
    FOR k = 1 TO lvlMonN
        IF lvlMon(k, 1) = x AND lvlMon(k, 2) = y THEN
            monSight(i) = lvlMon(k, 3) : monHear(i) = lvlMon(k, 4) : monSpd(i) = lvlMon(k, 6) / 100 : monWake(i) = lvlMon(k, 7)
            monsterHP(i) = MaxOf(1, INT(mtypeHP(monsterType(i)) * lvlMon(k, 5) / 100))
            IF monWake(i) = WAKE_HUNT THEN monsterState(i) = 1 : monsterTimer(i) = 60
        END IF
    NEXT
END SUB

SUB ThiefReset(i)
    thiefCells(i) = 0 : thiefShells(i) = 0 : thiefGun(i) = 0 : thiefState(i) = 0
END SUB

' Thief i, hit (not destroyed) with your things on it: some of them fly
' out - a pack of cells or shells, whichever it has more of (a coin toss
' between them), or now and then the gun it took
SUB ThiefSpill(i)
    DIM a, k, x, y ' (its own: the main program shares these names)
    x = monsterX(i) : y = monsterY(i) : a = GRnd * 6.2832
    IF thiefGun(i) AND GRnd < 0.25 THEN
        SELECT CASE thiefGun(i)
            CASE W_SCATTER : k = IT_SCATTER
            CASE W_REPEATER : k = IT_REPEATER
            CASE ELSE : k = IT_RAIL
        END SELECT
        TossItem k, x, y, a, playerX, playerY : thiefGun(i) = 0
        ShowMsg "The thief dropped your gun!"
    ELSEIF thiefCells(i) >= 15 AND (thiefShells(i) < 8 OR GRnd < 0.5) THEN
        TossItem IT_CELLS, x, y, a, playerX, playerY : thiefCells(i) = thiefCells(i) - 15
    ELSEIF thiefShells(i) >= 8 THEN
        TossItem IT_SHELLS, x, y, a, playerX, playerY : thiefShells(i) = thiefShells(i) - 8
    END IF
END SUB

' A thief bot (monster i) is destroyed: what it stole spills out round it
SUB DropThiefLoot(i)
    DIM c, k, n, x, y ' (its own: the main program shares these names)
    x = monsterX(i) : y = monsterY(i) : n = 0
    IF thiefGun(i) THEN
        SELECT CASE thiefGun(i)
            CASE W_SCATTER : k = IT_SCATTER
            CASE W_REPEATER : k = IT_REPEATER
            CASE ELSE : k = IT_RAIL
        END SELECT
        DropItemAt k, x, y : n = n + 1
    END IF
    FOR c = 1 TO (thiefCells(i) + 14) \ 15 : DropItemAt IT_CELLS, x + DCos(n * 2.1) * 0.35, y + DSin(n * 2.1) * 0.35 : n = n + 1 : NEXT
    FOR c = 1 TO (thiefShells(i) + 7) \ 8 : DropItemAt IT_SHELLS, x + DCos(n * 2.1) * 0.35, y + DSin(n * 2.1) * 0.35 : n = n + 1 : NEXT
    IF n THEN ShowMsg "The thief dropped your things!"
    ThiefReset i
END SUB

' One monster type's weak spot (chapter 6): a box on its picture
SUB SetWeakSpot(t, u0, u1, v0, v1)
    mtypeWS(t, 1) = u0 : mtypeWS(t, 2) = u1 : mtypeWS(t, 3) = v0 : mtypeWS(t, 4) = v1
END SUB

' Does a shot at height z go over or under monster i? Only when you aim
' up and down yourself (OpenGL's LOOK UP / DOWN): with the view level
' (the software renderer, or LOOK off) a shot finds a monster at any
' height in its column, as DOOM's aim does. Plenty of leeway either way.
FUNCTION ShotPasses(i, z)
    DIM t ' (its own: the main program shares these names)
    IF NOT lookAim THEN EXIT FUNCTION ' (level aim: whatever's in the middle column is hit, high or low)
    t = monsterType(i)
    foot = FloorAt(monsterX(i), monsterY(i)) + mtypeLift(t)
    ShotPasses = (z < foot - 0.3 OR z > foot + mtypeScale(t) + 0.5) ' (generous: level aim still finds a crawler down a step - aim at the ceiling or the floor, and it goes by)
END FUNCTION

' Did a shot land in monster i's weak spot? u: where across its picture
' (0 left .. 1 right), z: how high the shot was as it reached it (in walls,
' like the floor) - turned into how far down its picture (0 top .. 1 foot),
' from where it stands and how tall it is, as chapter 16 draws it
FUNCTION WeakSpotHit(i, u, z)
    DIM t, v ' (its own: the main program shares these names)
    t = monsterType(i) : IF mtypeWS(t, 2) <= mtypeWS(t, 1) THEN EXIT FUNCTION
    foot = FloorAt(monsterX(i), monsterY(i)) + mtypeLift(t) + mtypeBob(t) * DSin(lvFrame / 24 + i * 1.7) ' (by the frame clock, not TIMER: a headshot depends on it - a demo must get the same)
    v = (foot + mtypeScale(t) - z) / mtypeScale(t)
    WeakSpotHit = u >= mtypeWS(t, 1) AND u <= mtypeWS(t, 2) AND v >= mtypeWS(t, 3) AND v <= mtypeWS(t, 4)
END FUNCTION

' --- Monster definitions (monsters.txt, chapter 21's monster editor) ---
' One [name] section a monster, "key = value" lines - the numbers of its
' SetMonType line (chapter 3), whether it shoots, and what it may drop
SUB ReadMonsters
    DIM c, k, l$, t, v ' (its own: the main program shares these names)
    f$ = AssetPath$("monsters.txt")
    IF NOT _FILEEXISTS(f$) THEN EXIT SUB
    fh = FREEFILE : OPEN f$ FOR INPUT AS #fh : t = 0
    DO UNTIL EOF(fh)
        LINE INPUT #fh, l$
        l$ = LTRIM$(RTRIM$(l$)) : IF RIGHT$(l$, 1) = CHR$(13) THEN l$ = LEFT$(l$, LEN(l$) - 1)
        IF LEFT$(l$, 1) = "[" AND RIGHT$(l$, 1) = "]" THEN
            n$ = LCASE$(MID$(l$, 2, LEN(l$) - 2)) : t = 0
            FOR k = 1 TO MON_TYPES
                IF mtypeName$(k) = n$ THEN t = k
            NEXT
        ELSEIF t > 0 AND INSTR(l$, "=") AND LEFT$(l$, 1) <> "'" THEN
            eq = INSTR(l$, "=") : k$ = LCASE$(RTRIM$(LEFT$(l$, eq - 1))) : v$ = LTRIM$(MID$(l$, eq + 1))
            v = VAL(v$)
            SELECT CASE k$
                CASE "hp" : mtypeHP(t) = v
                CASE "speed" : mtypeSpeed(t) = v
                CASE "height" : mtypeScale(t) = v
                CASE "lift" : mtypeLift(t) = v
                CASE "bob" : mtypeBob(t) = v
                CASE "reach" : mtypeReach(t) = v
                CASE "damage" : mtypeDamage(t) = v
                CASE "damage_extra" : mtypeDamageRnd(t) = v
                CASE "cooldown" : mtypeCooldown(t) = v
                CASE "shoots" : mtypeRanged(t) = (LCASE$(v$) = "yes")
                CASE "drops" ' an item's map letter (chapter 22), then the chance
                    mtypeDrop(t) = 0 : IF LEN(v$) THEN mtypeDrop(t) = INSTR("rby+ae23u*4Mqj", LEFT$(v$, 1))
                    c = INSTR(v$, " ") : IF c THEN mtypeDropChance(t) = VAL(MID$(v$, c + 1)) ELSE mtypeDropChance(t) = 1
            END SELECT
        END IF
    LOOP
    CLOSE #fh
END SUB

SUB WriteMonsters
    DIM t ' (its own: the main program shares these names)
    nl$ = CHR$(10)
    o$ = "' NEON-CASTER monsters - every kind's numbers (chapter 3's SetMonType" + nl$
    o$ = o$ + "' lines), changed here without changing the program. The monster editor" + nl$
    o$ = o$ + "' (M in the level editor, or monsters in the console) writes this file." + nl$
    o$ = o$ + "'   hp: hits to kill   speed: cells a frame (you walk 0.06, run 0.12)" + nl$
    o$ = o$ + "'   height: in walls   lift, bob: hovering   reach: how close it must be to hit" + nl$
    o$ = o$ + "'   damage + up to damage_extra - 1 more   cooldown: frames between attacks" + nl$
    o$ = o$ + "'   shoots: yes or no   drops: a pickup's map letter and the chance (0 to 1)" + nl$
    FOR t = 1 TO MON_TYPES
        o$ = o$ + nl$ + "[" + mtypeName$(t) + "]" + nl$
        o$ = o$ + "hp           = " + LTRIM$(STR$(mtypeHP(t))) + nl$
        o$ = o$ + "speed        = " + LTRIM$(STR$(mtypeSpeed(t))) + nl$
        o$ = o$ + "height       = " + LTRIM$(STR$(mtypeScale(t))) + nl$
        o$ = o$ + "lift         = " + LTRIM$(STR$(mtypeLift(t))) + nl$
        o$ = o$ + "bob          = " + LTRIM$(STR$(mtypeBob(t))) + nl$
        o$ = o$ + "reach        = " + LTRIM$(STR$(mtypeReach(t))) + nl$
        o$ = o$ + "damage       = " + LTRIM$(STR$(mtypeDamage(t))) + nl$
        o$ = o$ + "damage_extra = " + LTRIM$(STR$(mtypeDamageRnd(t))) + nl$
        o$ = o$ + "cooldown     = " + LTRIM$(STR$(mtypeCooldown(t))) + nl$
        IF mtypeRanged(t) THEN o$ = o$ + "shoots       = yes" + nl$ ELSE o$ = o$ + "shoots       = no" + nl$
        IF mtypeDrop(t) THEN o$ = o$ + "drops        = " + MID$("rby+ae23u*4Mqj", mtypeDrop(t), 1) + " " + LTRIM$(STR$(mtypeDropChance(t))) + nl$ ELSE o$ = o$ + "drops        =" + nl$
    NEXT
    f$ = AssetPath$("monsters.txt")
    IF _FILEEXISTS(f$) THEN KILL f$
    fh = FREEFILE : OPEN f$ FOR BINARY AS #fh : PUT #fh, , o$ : CLOSE #fh
END SUB

' A monster's bolt at (x, y), z high: the decoration it's flown into, if
' any (not a body: they lie flat) - its middle a little more than a bolt's
' width away, and the bolt no higher than its top
FUNCTION BoltDeco(x, y, z)
    DIM cx, cy, d ' (its own: the main program shares these names)
    cx = INT(x) : cy = INT(y)
    IF cx < 0 OR cy < 0 OR cx >= MAP_SIZE OR cy >= MAP_SIZE OR cyberOn THEN EXIT FUNCTION
    d = decoCell(cx, cy) : IF d = 0 THEN EXIT FUNCTION
    IF NOT decoOn(d) OR decoKind(d) = DK_BODY THEN EXIT FUNCTION
    IF (x - decoX(d)) ^ 2 + (y - decoY(d)) ^ 2 > 0.32 * 0.32 THEN EXIT FUNCTION
    IF z > FloorAt(decoX(d), decoY(d)) + DecoScale(decoKind(d)) THEN EXIT FUNCTION
    BoltDeco = d
END FUNCTION

' The thieves' way home: from the cells outside every hoard's doors, how
' many steps to each open cell (a flood fill, as the moving lights' -
' chapter 24), through doors that need no keycard. 30000: no way.
SUB BuildThiefWay
    DIM ev, head, k, nx, ny, ok, v, x, y ' (its own: the main program shares these names)
    FOR y = 0 TO MAP_SIZE : FOR x = 0 TO MAP_SIZE : thiefDist(x, y) = 30000 : NEXT : NEXT
    head = 0 : tail = 0
    FOR ev = 1 TO numEvents
        IF evType(ev) = EV_HOARD THEN
            FOR y = evY0(ev) - 1 TO evY1(ev) + 1 : FOR x = evX0(ev) - 1 TO evX1(ev) + 1
                IF x > 0 AND y > 0 AND x < MAP_SIZE - 1 AND y < MAP_SIZE - 1 THEN
                    IF worldMap(x, y) = 2 THEN ' A door into the hoard: the cells outside it are home
                        FOR k = 1 TO 4
                            nx = x + (k = 1) - (k = 2) : ny = y + (k = 3) - (k = 4)
                            IF NOT InRoom(ev, nx + 0.5, ny + 0.5) AND worldMap(nx, ny) <= 0 AND thiefDist(nx, ny) > 0 THEN
                                thiefDist(nx, ny) = 0 : fillX(tail) = nx : fillY(tail) = ny : tail = tail + 1
                            END IF
                        NEXT
                    END IF
                END IF
            NEXT : NEXT
        END IF
    NEXT
    DO WHILE head < tail
        x = fillX(head) : y = fillY(head) : head = head + 1
        FOR k = 1 TO 4
            nx = x + (k = 1) - (k = 2) : ny = y + (k = 3) - (k = 4)
            IF nx > 0 AND ny > 0 AND nx < MAP_SIZE - 1 AND ny < MAP_SIZE - 1 THEN
                v = worldMap(nx, ny) : ok = (v <= 0 AND diagCorner(nx, ny) = 0 AND boxOn(nx, ny) = 0 AND glassHP(nx, ny) <= 0) ' (a block's cell, or a pane of glass, is no way through for a fleeing thief)
                IF decoCell(nx, ny) THEN IF decoKind(decoCell(nx, ny)) <> DK_BODY THEN ok = 0 ' (nor a decoration standing in the way - it would stick behind it, steps from home)
                IF v = 2 THEN ok = (doorKey(nx, ny) = 0 AND doorType(nx, ny) <> DOOR_EXIT)
                IF ok AND thiefDist(nx, ny) > thiefDist(x, y) + 1 THEN
                    thiefDist(nx, ny) = thiefDist(x, y) + 1 : fillX(tail) = nx : fillY(tail) = ny : tail = tail + 1
                END IF
            END IF
        NEXT
    LOOP
END SUB

' One row of the monster types table (chapter 6)
SUB SetMonType(mtype, title$, hitPoints, speed, scale, lift, bob, reach, damage, damageRnd, cooldown, sprite)
    mtypeName$(mtype) = title$ : mtypeHP(mtype) = hitPoints : mtypeSpeed(mtype) = speed : mtypeScale(mtype) = scale
    mtypeLift(mtype) = lift : mtypeBob(mtype) = bob : mtypeReach(mtype) = reach
    mtypeDamage(mtype) = damage : mtypeDamageRnd(mtype) = damageRnd : mtypeCooldown(mtype) = cooldown : mtypeSprite(mtype) = sprite
END SUB

' A bolt from (x, y), flying along (dirX, dirY), into the first free slot
SUB FireBolt(x, y, dirX, dirY, damage)
    DIM d, i ' (its own: the main program shares these names)
    FOR i = 1 TO MAX_BOLTS
        IF boltOn(i) = 0 THEN
            boltOn(i) = -1 : boltX(i) = x + dirX * 0.4 : boltY(i) = y + dirY * 0.4
            ' (a shooter pressed up against glass would start it on the far
            ' side: then it starts from the shooter, and bursts on the pane)
            IF GlassBetween(x, y, boltX(i), boltY(i)) OR InGlass(boltX(i), boltY(i)) THEN boltX(i) = x : boltY(i) = y
            boltDX(i) = dirX : boltDY(i) = dirY : boltDamage(i) = damage
            ' (its height: from the shooter's middle, towards yours)
            boltZ(i) = floorH(INT(x), INT(y)) + 0.49 : d = SQR((playerX - x) ^ 2 + (playerY - y) ^ 2) : boltDZ(i) = 0
            IF d > 0.5 THEN boltDZ(i) = (playerZ + 0.49 - boltZ(i)) / d
            EXIT SUB
        END IF
    NEXT
END SUB
