''
' NEON-CASTER - GAME/NETWORK.BM
' =============================================================================
' The network: jacking in and out, and its wireframe pictures.
'

' --- Into the network through data station st (chapter 19): the real
' pictures put away and the grid put up, the real things left behind,
' data cores laid out round the station (on the floor you can walk to from
' it, without going through a door), and ICE let loose, far off
SUB JackIn STATIC
    DIM head ' (its own: the main program shares this name)
    CyberLookSet 0 ' (F4's look first put away: the real pictures are the ones to keep)
    WorldLoopsOff
    cyberOn = -1 : cyberStation = st
    cyberSlot = 0
    cyberTime = CYBER_SECONDS * 60 : cyberGot = 0 : cyberNeed = 3 + (((level - 1) MOD 10) + 1) \ 3 : IF cyberNeed > 6 THEN cyberNeed = 6
    cyberBackX = playerX : cyberBackY = playerY : cyberBackDX = dirX : cyberBackDY = dirY ' (where you jacked in: you come back there)
    cyberMonStart = numMonsters : cyberItemStart = numItems
    FOR i = 1 TO MAX_BOLTS : boltOn(i) = 0 : NEXT
    CyberTextures -1
    ' The floor round the station: steps from it (fillX/fillY, as the
    ' thieves' way does), through floor only - not doors
    FOR y = 0 TO mapN : FOR x = 0 TO mapN : thiefDist(x, y) = 30000 : NEXT : NEXT
    head = 0 : tail = 0
    FOR k = 1 TO 4
        nx = stationX(st) + (k = 1) - (k = 2) : ny = stationY(st) + (k = 3) - (k = 4)
        IF worldMap(nx, ny) = 0 AND glassHP(nx, ny) = 0 AND diagCorner(nx, ny) = 0 THEN thiefDist(nx, ny) = 0 : fillX(tail) = nx : fillY(tail) = ny : tail = tail + 1
    NEXT
    DO WHILE head < tail
        x = fillX(head) : y = fillY(head) : head = head + 1
        FOR k = 1 TO 4
            nx = x + (k = 1) - (k = 2) : ny = y + (k = 3) - (k = 4)
            IF nx > 0 AND ny > 0 AND nx < mapN - 1 AND ny < mapN - 1 THEN
                IF worldMap(nx, ny) = 0 AND glassHP(nx, ny) = 0 AND diagCorner(nx, ny) = 0 AND boxOn(nx, ny) = 0 AND thiefDist(nx, ny) > thiefDist(x, y) + 1 AND thiefDist(x, y) < 18 AND ABS(floorH(nx, ny) - floorH(x, y)) <= STEP_UP AND liqKind(nx, ny) = 0 AND liftCell(nx, ny) = 0 AND floorH(nx, ny) > PIT_DEPTH THEN ' (only where you can walk in time: no ledges, pools, lifts or pits)
                    thiefDist(nx, ny) = thiefDist(x, y) + 1 : fillX(tail) = nx : fillY(tail) = ny : tail = tail + 1
                END IF
            END IF
        NEXT
    LOOP
    ' Cores: on cells 5 or more steps out, as spread out as can be (each one
    ' the farthest from all those placed so far, of a few tried at random)
    placed = 0
    FOR c = 1 TO cyberNeed
        bestCell = -1 : bestScore = -1
        FOR try = 1 TO 40
            e = INT(GRnd * tail) : x = fillX(e) : y = fillY(e)
            IF thiefDist(x, y) >= 5 THEN
                score = 99
                FOR i = cyberItemStart + 1 TO numItems
                    d = ABS(itemX(i) - x - 0.5) + ABS(itemY(i) - y - 0.5) : IF d < score THEN score = d
                NEXT
                IF score > bestScore THEN bestScore = score : bestCell = e
            END IF
        NEXT
        IF bestCell >= 0 AND numItems < MAX_ITEMS THEN
            numItems = numItems + 1 : itemX(numItems) = fillX(bestCell) + 0.5 : itemY(numItems) = fillY(bestCell) + 0.5
            itemKind(numItems) = IT_CORE : itemOn(numItems) = -1 : placed = placed + 1
        END IF
    NEXT
    IF placed < cyberNeed THEN cyberNeed = placed
    IF cyberNeed = 0 THEN ' (none placed: one just ahead of you - in a new slot, or, the list full, one whose pickup's been taken)
        cs = 0 : IF numItems < MAX_ITEMS THEN numItems = numItems + 1 : cs = numItems
        IF cs = 0 THEN
            FOR j = numItems TO 1 STEP -1
                IF itemOn(j) = 0 AND itemToss(j) = 0 THEN cs = j : EXIT FOR
            NEXT
            IF cs THEN cyberSlot = cs : cyberSlotKind = itemKind(cs) : cyberSlotX = itemX(cs) : cyberSlotY = itemY(cs) ' (a taken pickup's slot, borrowed: JackOut gives it back)
        END IF
        IF cs THEN cyberNeed = 1 : itemX(cs) = playerX - dirX : itemY(cs) = playerY - dirY : itemKind(cs) = IT_CORE : itemOn(cs) = -1 ' (ahead once you've turned round - not in the station)
    END IF
    ' ICE: on the farthest cells
    nIce = 2 + (((level - 1) MOD 10) + 1) \ 3 ' (by its place in a set of ten: a showcase's number isn't how hard it is)
    FOR c = 1 TO nIce
        e = tail - 1 - INT(GRnd * (tail \ 3 + 1)) : IF e < 0 THEN e = 0
        IF tail > 0 THEN IF SpawnMonster(MT_ICE, fillX(e) + 0.5, fillY(e) + 0.5, 0, playerX, playerY) THEN monsterTimer(numMonsters) = 90
    NEXT
    NetSetup tail ' (the network's other modules: more kinds of ICE, firewalls - by their own dice)
    BuildThiefWay ' (the thieves' way home, which the steps above borrowed)
    dirX = -dirX : dirY = -dirY : planeX = -planeX : planeY = -planeY ' (you turn round: into the network, your back to the station)
    PlaySfx sndJackIn&, 1 : pickFlash = 30 : shake = shake + 6
    IF cyberMusic& > 0 THEN PlayMusic cyberMusic&
    ShowMsg "JACKED IN - grab " + LTRIM$(STR$(cyberNeed)) + " data cores before the time runs out!"
    Say "cyber1", 0
END SUB

' --- Out of the network: won (cyberWon) or thrown out. The real pictures
' back, the network's things gone (they were the last monsters and pickups
' added), you back at the station - and if you won, its doors unsealed
' (each sealed door belongs to the station nearest it)
SUB JackOut STATIC
    cyberOn = 0 : CyberTextures 0 ' (out first: the real pictures go to OpenGL smoothed again)
    numFences = 0 : traceAmt = 0
    FOR i = cyberMonStart + 1 TO numMonsters ' (ICE you derezzed doesn't count in the sector's kills)
        IF monsterState(i) = 2 OR monsterState(i) = 3 THEN kills = kills - 1
    NEXT
    numMonsters = cyberMonStart : numItems = cyberItemStart
    IF cyberSlot THEN itemKind(cyberSlot) = cyberSlotKind : itemX(cyberSlot) = cyberSlotX : itemY(cyberSlot) = cyberSlotY : itemOn(cyberSlot) = 0 : cyberSlot = 0
    FOR i = 1 TO MAX_BOLTS : boltOn(i) = 0 : NEXT
    playerX = cyberBackX : playerY = cyberBackY : dirX = cyberBackDX : dirY = cyberBackDY ' (back at the station, as you jacked in - not wherever you'd got to)
    planeX = -dirY * fovPlane : planeY = dirX * fovPlane
    IF NOT levelFlat THEN playerZ = floorH(INT(playerX), INT(playerY)) : playerVZ = 0 : eyeZ = playerZ + EYE_H
    PlaySfx sndJackOut&, 1 : pickFlash = 20
    PlayMusic SectorMusic&(level)
    IF cyberWon THEN
        stationDone(cyberStation) = -1 : Achieve "NC_JACKED", 0 : WallDone stationX(cyberStation), stationY(cyberStation), T_JACKOK
        FOR y = 0 TO mapN - 1 : FOR x = 0 TO mapN - 1
            IF worldMap(x, y) = 2 AND doorLock(x, y) = 2 THEN
                IF StationNear(x, y) = cyberStation THEN doorLock(x, y) = 0 : doorOpen(x, y) = 0.01 : doorMove(x, y) = 1 : SfxAt DoorSnd&(doorType(x, y)), x + 0.5, y + 0.5, playerX, playerY
            END IF
        NEXT : NEXT
        PlaySfx sndFanfare&, 0.8
        ShowMsg "ACCESS GRANTED - the sealed doors are open"
        Say "cyber2", 0
    ELSE
        PlaySfx sndFail&, 0.8
        damage = 10 : hurtFromX = -1 : hurtFromY = -1 : hurtElectric = -1 : HurtPlayer
        ShowMsg "EJECTED - the network threw you out. Try again"
        Say "cyber3", 0
    END IF
END SUB

' Which data station is at cell (x, y) (0: none)
FUNCTION StationAt(x, y)
    DIM k ' (its own: the main program shares these names)
    FOR k = 1 TO numStations
        IF stationX(k) = x AND stationY(k) = y THEN StationAt = k : EXIT FUNCTION
    NEXT
END FUNCTION

' The data station nearest cell (x, y) - the one a sealed door belongs to
FUNCTION StationNear(x, y)
    DIM best, d, e, k ' (its own: the main program shares these names)
    best = 0 : bestD = 1E+9
    FOR k = 1 TO numStations
        d = (stationX(k) - x) ^ 2 + (stationY(k) - y) ^ 2
        IF d < bestD THEN bestD = d : best = k
    NEXT
    StationNear = best
END FUNCTION

' F4: MATRIX VIEW - the network's look on the sector, just to see it: its
' grids for every picture and its even light (UpdateLight), the game going
' on as it was - looks only, so a demo doesn't mind. Not in the network
' itself (that's the real thing) or the editor; a sector built, the
' network jacked into or the editor opened puts it away first
SUB CyberLookSet(want)
    IF want AND NOT cyberLook AND NOT cyberOn THEN
        cyberLook = -1 : CyberTextures -1 : ShowMsg "MATRIX VIEW   (F4: back)"
    ELSEIF NOT want AND cyberLook THEN
        cyberLook = 0 : CyberTextures 0 ' (off first: the real pictures go to OpenGL smoothed again)
    END IF
END SUB

' Into the network (goIn): every wall, door, floor and ceiling picture is
' kept in texBak and replaced by a neon grid; out: put back. OpenGL
' is sent just those pictures again (glDirtyVersion) - not the sprites or
' models, and not its world, which hasn't moved. Set cyberOn first: going
' out, the real pictures are sent smoothed again (GLSendSlot)
SUB CyberTextures(goIn)
    DIM slot, n, k, sz&, mT AS _MEM, mB AS _MEM, cyK$(15), cyKAt(15), cyKN, cyKey$ ' (its own: the main program shares these names)
    ' (Only the slots a sector shows: of the T_CUSTOMN face slots, just the
    ' ones it uses - the rest were 200 more 512 x 512 pictures to copy and
    ' paint. Each slot's picture is a block of memory - texture(x, y, slot),
    ' the slot last - so it's copied whole, and each kind of grid is drawn
    ' once and copied to the slots that share it. OpenGL gets only those
    ' slots: GLSendDirty.)
    IF goIn THEN
        n = 0
        FOR slot = 1 TO T_SLOTS
            cyberBakAt(slot) = 0
            k = -1 : IF slot > T_CUSTOM AND slot <= T_CUSTOM + T_CUSTOMN THEN IF NOT texUsed(slot - T_CUSTOM) OR texFile$(slot) = "" THEN k = 0
            IF k THEN n = n + 1 : cyberBakAt(slot) = n
        NEXT
        REDIM texBak(texSize - 1, texSize - 1, MaxOf(1, n)) AS _UNSIGNED LONG ' (the real pictures' keeping place: only while you're in)
    END IF
    sz& = texSize * texSize * 4
    mT = _MEM(texture()) : mB = _MEM(texBak())
    FOR slot = 1 TO T_SLOTS
        IF cyberBakAt(slot) THEN
            IF goIn THEN
                _MEMCOPY mT, mT.OFFSET + slot * sz&, sz& TO mB, mB.OFFSET + cyberBakAt(slot) * sz&
                SELECT CASE slot ' (the grid's colour and spacing: a key)
                    CASE 1, 3, 5 : cyKey$ = "255,40,210,32" ' Walls: magenta...
                    CASE 2, 4, 6 : cyKey$ = "40,230,255,32" ' ...and cyan
                    CASE T_DOOR TO T_SPLIT : cyKey$ = "255,200,40,16" ' Doors: gold, a finer grid
                    CASE T_EXIT : cyKey$ = "60,255,120,16"
                    CASE T_FLOOR + 1 TO T_FLOOR + 4 : cyKey$ = "40,200,255,32" ' The floor: a cyan grid
                    CASE T_CEIL + 1 TO T_CEIL + 2 : cyKey$ = "110,40,200,64" ' The ceiling: dim violet
                    CASE T_JACK : cyKey$ = "255,255,255,16"
                    CASE ELSE : cyKey$ = "200,200,255,64"
                END SELECT
                FOR k = 1 TO cyKN : IF cyK$(k) = cyKey$ THEN EXIT FOR
                NEXT
                IF k <= cyKN THEN
                    _MEMCOPY mT, mT.OFFSET + cyKAt(k) * sz&, sz& TO mT, mT.OFFSET + slot * sz& ' (drawn already: copied)
                ELSE
                    MakeCyberTex slot, VAL(cyKey$), VAL(MID$(cyKey$, INSTR(cyKey$, ",") + 1)), VAL(MID$(cyKey$, INSTR(INSTR(cyKey$, ",") + 1, cyKey$, ",") + 1)), VAL(MID$(cyKey$, _INSTRREV(cyKey$, ",") + 1))
                    IF cyKN < 15 THEN cyKN = cyKN + 1 : cyK$(cyKN) = cyKey$ : cyKAt(cyKN) = slot
                END IF
            ELSE
                _MEMCOPY mB, mB.OFFSET + cyberBakAt(slot) * sz&, sz& TO mT, mT.OFFSET + slot * sz&
            END IF
            texDirty(slot) = -1
        END IF
    NEXT
    _MEMFREE mT : _MEMFREE mB
    IF NOT goIn THEN REDIM texBak(0, 0, 0) AS _UNSIGNED LONG ' (put back: let the memory go)
    glDirtyVersion = glDirtyVersion + 1 ' (OpenGL: just those slots)
END SUB

' A grid picture for the network, into texture slot slot: near-black, with
' bright lines (colour r, g, b) every cell'th texel and round the edge,
' fainter ones in between, and a dot of light where lines cross
SUB MakeCyberTex(slot, r, g, b, cell)
    ' The design is 128 pixels across: worked out once, then scaled up to
    ' the picture's size (each pixel at 512 was 10 us - 23 s a jack-in).
    DIM k AS SINGLE, x AS LONG, y AS LONG, ex AS LONG, ey AS LONG, c4 AS LONG ' (its own: the main program shares these names)
    DIM sk AS LONG, xx AS LONG, yy AS LONG, cr AS SINGLE, cg AS SINGLE, cb AS SINGLE, cyPat(127, 127) AS _UNSIGNED LONG
    c4 = cell \ 4
    FOR y = 0 TO 127 : FOR x = 0 TO 127
        ex = x MOD cell : ey = y MOD cell
        k = 0
        IF ex < 2 OR ey < 2 THEN k = 1 ' (the grid's lines)
        IF (x \ 4) MOD c4 = 0 OR (y \ 4) MOD c4 = 0 THEN IF k = 0 AND ((x + y) MOD 4 = 0) THEN k = 0.18 ' (faint dots between)
        IF x < 3 OR y < 3 OR x > 124 OR y > 124 THEN k = 1 ' (the edge)
        IF ex < 2 AND ey < 2 THEN k = 1.6 ' (crossings glow)
        cr = 6 + r * k : cg = 2 + g * k : cb = 14 + b * k
        IF cr > 255 THEN cr = 255
        IF cg > 255 THEN cg = 255
        IF cb > 255 THEN cb = 255
        cyPat(x, y) = _RGB32(cr, cg, cb)
    NEXT : NEXT
    sk = texSize \ 128 ' (texSize is 128 times a power of two)
    IF sk < 1 THEN sk = 1
    FOR yy = 0 TO texSize - 1 : y = yy \ sk
        FOR xx = 0 TO texSize - 1
            texture(xx, yy, slot) = cyPat(xx \ sk, y)
    NEXT : NEXT
END SUB

' --- The network's own dice (NetSetup's, the TRACE's hunters): its
' places come out the same each time for a station - and the game's
' dice (GRnd) roll just as they did before the network had more in it
FUNCTION NRnd!
    netSeed = netSeed * 16807# - INT(netSeed * 16807# / 2147483647#) * 2147483647#
    NRnd! = netSeed / 2147483647#
END FUNCTION

' --- JackIn's last step: the cells it can reach (fillX, fillY - n of
' them, thiefDist steps from the station) get the network's other
' modules: sentinels, tracers and black ICE on far cells, firewalls
' across the narrow ways, and a list of far cells for the TRACE
SUB NetSetup(n)
    DIM d, k, e, c, x, y, x0, x1, y0, y1, w, h, ok, tries, kind, nk(3) ' (its own: the main program shares these names)
    netSeed = 7919# * cyberStation + 104729# * level + 31# : traceAmt = 0 : numFences = 0 : numNetFar = 0
    FOR k = cyberMonStart + 1 TO numMonsters : iceKind(k) = ICE_HUNTER : NEXT
    IF n < 4 THEN EXIT SUB
    d = ((level - 1) MOD 10) + 1
    FOR k = 0 TO n - 1 ' (far cells, for the TRACE's hunters)
        IF numNetFar < MAX_NETFAR AND thiefDist(fillX(k), fillY(k)) >= 9 THEN IF NRnd! < 0.25 THEN numNetFar = numNetFar + 1 : netFarX(numNetFar) = fillX(k) : netFarY(numNetFar) = fillY(k)
    NEXT
    nk(ICE_SENTRY) = d \ 3 : nk(ICE_TRACER) = 1 - (d >= 6) : nk(ICE_BLACK) = -(d >= 4) - (d >= 8)
    FOR kind = ICE_SENTRY TO ICE_BLACK
        FOR c = 1 TO nk(kind)
            FOR tries = 1 TO 30
                e = INT(NRnd! * n) : x = fillX(e) : y = fillY(e)
                IF thiefDist(x, y) >= 6 THEN EXIT FOR
            NEXT
            IF thiefDist(x, y) >= 6 THEN
                IF SpawnMonster(MT_ICE, x + 0.5, y + 0.5, 0, playerX, playerY) THEN
                    iceKind(numMonsters) = kind : monsterTimer(numMonsters) = 90
                    SELECT CASE kind
                        CASE ICE_SENTRY : monsterHP(numMonsters) = 6
                        CASE ICE_TRACER : monsterHP(numMonsters) = 2
                        CASE ICE_BLACK : monsterHP(numMonsters) = 12
                    END SELECT
                END IF
            END IF
        NEXT
    NEXT
    ' Firewalls: across a way no more than 7 cells wide, 4 to 17 steps out,
    ' each at least 5 from the others
    FOR tries = 1 TO 400
        IF numFences >= MinOf(MAX_FENCES, 2 + d \ 3) THEN EXIT FOR
        e = INT(NRnd! * n) : x = fillX(e) : y = fillY(e)
        IF thiefDist(x, y) < 4 OR thiefDist(x, y) > 17 THEN _CONTINUE
        x0 = x : DO WHILE x0 > 1 AND worldMap(x0 - 1, y) = 0 AND x - x0 < 6 : x0 = x0 - 1 : LOOP
        x1 = x : DO WHILE x1 < mapN - 2 AND worldMap(x1 + 1, y) = 0 AND x1 - x < 6 : x1 = x1 + 1 : LOOP
        y0 = y : DO WHILE y0 > 1 AND worldMap(x, y0 - 1) = 0 AND y - y0 < 6 : y0 = y0 - 1 : LOOP
        y1 = y : DO WHILE y1 < mapN - 2 AND worldMap(x, y1 + 1) = 0 AND y1 - y < 6 : y1 = y1 + 1 : LOOP
        w = x1 - x0 + 1 : h = y1 - y0 + 1
        IF w <= h AND w <= 7 AND ((worldMap(x0 - 1, y) > 0 AND worldMap(x1 + 1, y) > 0) OR tries > 150) THEN ' (across the way: east to west, at row y - wall to wall, or, none found, free standing)
            y0 = y : y1 = y : x0 = MaxOf(x0, x - 3) : x1 = MinOf(x1, x + 3)
        ELSEIF h < w AND h <= 7 AND ((worldMap(x, y0 - 1) > 0 AND worldMap(x, y1 + 1) > 0) OR tries > 150) THEN ' (north to south, at column x)
            x0 = x : x1 = x : y0 = MaxOf(y0, y - 3) : y1 = MinOf(y1, y + 3)
        ELSE
            _CONTINUE
        END IF
        ok = -1
        FOR k = 1 TO numFences
            IF ABS(fenceX0(k) + fenceX1(k) - x0 - x1) \ 2 + ABS(fenceY0(k) + fenceY1(k) - y0 - y1) \ 2 < 5 THEN ok = 0
        NEXT
        IF ok THEN numFences = numFences + 1 : fenceX0(numFences) = x0 : fenceY0(numFences) = y0 : fenceX1(numFences) = x1 : fenceY1(numFences) = y1 : fencePh(numFences) = INT(NRnd! * FENCE_CYCLE)
    NEXT
END SUB

' --- Each frame in the network: the firewalls (on, flickering, off - lit,
' they burn you and take time) and the TRACE (ICE that sees you raises
' it; full, more hunters come)
SUB NetFrame
    DIM f, c, z!, lit, k, sees, e, x!, y! ' (its own: the main program shares these names)
    FOR f = 1 TO numFences
        c = (lvFrame + fencePh(f)) MOD FENCE_CYCLE : lit = (c < FENCE_ON)
        IF lit OR (c >= FENCE_CYCLE - FENCE_WARN AND (lvFrame \ 3) MOD 2 = 0) THEN ' (lit - or about to be: flickering)
            FOR z! = 0.12 TO 0.8 STEP 0.22
                IF fenceY0(f) = fenceY1(f) THEN
                    AddBeam BEAM_SIGHT + TW_LASER, fenceX0(f), fenceY0(f) + 0.5, z!, fenceX1(f) + 1, fenceY0(f) + 0.5, z!, 2 ' (2: chapter 13 counts it down before it's drawn)
                ELSE
                    AddBeam BEAM_SIGHT + TW_LASER, fenceX0(f) + 0.5, fenceY0(f), z!, fenceX0(f) + 0.5, fenceY1(f) + 1, z!, 2
                END IF
            NEXT
        END IF
        IF lit AND NOT dead AND (lvFrame MOD 10) = 0 THEN ' (you in it: burnt, and the clock runs)
            IF fenceY0(f) = fenceY1(f) THEN
                IF playerX >= fenceX0(f) AND playerX < fenceX1(f) + 1 AND ABS(playerY - fenceY0(f) - 0.5) < 0.35 THEN k = -1 ELSE k = 0
            ELSE
                IF playerY >= fenceY0(f) AND playerY < fenceY1(f) + 1 AND ABS(playerX - fenceX0(f) - 0.5) < 0.35 THEN k = -1 ELSE k = 0
            END IF
            IF k THEN
                damage = 5 : hurtFromX = -1 : hurtFromY = -1 : hurtElectric = -1 : HurtPlayer
                cyberTime = MaxOf(1, cyberTime - 45) : SpawnSparks playerX, playerY, 0.4, 8, 255, 60, 60
                IF (lvFrame MOD 60) = 0 THEN ShowMsg "FIREWALL - it burns, and the clock runs"
            END IF
        END IF
    NEXT
    ' The TRACE
    sees = 0
    FOR k = cyberMonStart + 1 TO numMonsters
        IF monsterType(k) = MT_ICE AND monsterState(k) = 1 THEN
            IF (monsterX(k) - playerX) ^ 2 + (monsterY(k) - playerY) ^ 2 < 144 THEN
                IF CanSee(monsterX(k), monsterY(k), playerX, playerY) THEN
                    IF iceKind(k) = ICE_TRACER THEN traceAmt = traceAmt + 0.45 ELSE traceAmt = traceAmt + 0.06
                    sees = -1
                END IF
            END IF
        END IF
    NEXT
    IF NOT sees THEN traceAmt = MaxOf(0, traceAmt - 0.05)
    IF traceAmt >= 100 AND NOT dead THEN ' Traced: NEXUS sends hunters, from far off
        traceAmt = 35 : ShowMsg "TRACE COMPLETE - NEXUS is sending more ICE" : Say "cybertrace", 0 : shake = shake + 4
        FOR c = 1 TO 2
            IF numNetFar > 0 THEN
                e = INT(NRnd! * numNetFar) + 1
                IF SpawnMonster(MT_ICE, netFarX(e) + 0.5, netFarY(e) + 0.5, 0, playerX, playerY) THEN iceKind(numMonsters) = ICE_HUNTER : monsterTimer(numMonsters) = 60
            END IF
        NEXT
    END IF
END SUB

' --- ICE i (not a hunter) hunting you: how its kind fights - goX, goY for
' its step, and its attack (it's at distance, toPlayerX/Y away)
SUB IceTurn(i)
    DIM sn ' (its own: the main program shares these names)
    goX = 0 : goY = 0
    SELECT CASE iceKind(i)
        CASE ICE_SENTRY ' Still: it fires data bolts
            sn = CanSee(monsterX(i), monsterY(i), monTX, monTY)
            IF sn AND monsterTimer(i) = 0 AND distance < 12 THEN
                FireBolt monsterX(i), monsterY(i), toPlayerX / distance, toPlayerY / distance, 6
                monsterTimer(i) = 70 : monsterAtk(i) = ATTACK_FRAMES : SfxAt mtypeAttackSnd&(MT_ICE), monsterX(i), monsterY(i), playerX, playerY
            END IF
        CASE ICE_TRACER ' Quick, and keeps its distance - three or four cells off, round you: watching
            IF distance > 4 THEN
                goX = toPlayerX / distance * 1.7 : goY = toPlayerY / distance * 1.7
            ELSE
                goX = -toPlayerY / distance * 1.2 : goY = toPlayerX / distance * 1.2 : IF i MOD 2 THEN goX = -goX : goY = -goY
                IF distance < 2.5 THEN goX = goX - toPlayerX / distance : goY = goY - toPlayerY / distance
            END IF
        CASE ICE_BLACK ' Slow, and it hits hard
            IF distance > 0.85 THEN
                goX = toPlayerX / distance * 0.6 : goY = toPlayerY / distance * 0.6
            ELSEIF monsterTimer(i) = 0 THEN
                MonStrike i, 14 : monsterTimer(i) = 70 : monsterAtk(i) = ATTACK_FRAMES : shake = shake + 4
                SfxAt mtypeAttackSnd&(MT_ICE), monsterX(i), monsterY(i), playerX, playerY
            END IF
    END SELECT
END SUB
