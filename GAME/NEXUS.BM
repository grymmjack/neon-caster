DATA "cyber10", "Delete."
DATA "", ""

' --- Once a frame: NEXUS taunts you now and then (every 60-120 seconds of
' play, with TAUNTS on - not over another line)
SUB SpeechFrame STATIC
    DIM k, n ' (its own: the main program shares these names)
    IF setting(SET_TAUNTS) AND NOT dead AND speechUntil! < TIMER THEN
        tauntWait = tauntWait - 1
        IF tauntWait <= 0 THEN ' (any of them - however many there are - but not the last one again)
            n = LineCount("taunt")
            IF n > 0 THEN
                DO : k = INT(RND * n) + 1 : LOOP WHILE k = lastTaunt AND n > 1
                lastTaunt = k : Say "taunt" + LTRIM$(STR$(k)), 0
            END IF
            tauntWait = 3600 + INT(RND * 3600)
        END IF
    END IF
END SUB

' --- A TRANSMISSION: NEXUS's face, its words typing out, its voice - as you
' arrive in a sector (with CUTSCENES on; not when the command line is
' driving). Space, Enter or a click skips it.
SUB ShowTransmission STATIC
    IF setting(SET_CUTSCENES) = 0 OR cliMode THEN EXIT SUB
    tk$ = "intro" + LTRIM$(STR$(level)) : li = LineOf(tk$) : IF li = 0 THEN EXIT SUB
    IF lineSnd&(li) > 0 THEN _SNDVOL lineSnd&(li), setting(SET_SPEECH) / 100 : _SNDPLAY lineSnd&(li)
    tStart! = TIMER : tLen! = 4 : IF lineSnd&(li) > 0 THEN tLen! = _SNDLEN(lineSnd&(li))
    _KEYCLEAR : pressWas = -1
    DO
        _LIMIT 60
        tNow! = TIMER - tStart! : IF tNow! < 0 THEN tNow! = tNow! + 86400
        click = 0
        WHILE _MOUSEINPUT
            IF _MOUSEBUTTON(1) THEN click = -1
        WEND
        press = click OR _KEYDOWN(32) OR _KEYDOWN(13) OR _KEYDOWN(27)
        IF press AND NOT pressWas AND tNow! > 0.4 THEN EXIT DO
        pressWas = press
        IF tNow! > tLen! + 1.5 THEN EXIT DO
        DrawMenuBackdrop INT(tNow! * 60)
        LINE (0, 0)-(799, 599), _RGBA32(10, 0, 4, 190), BF
        ' Scan lines, and the portrait flickering in
        FOR y = 0 TO 599 STEP 3 : LINE (0, y)-(799, y), _RGBA32(0, 0, 0, 60) : NEXT
        MenuText 400, 70, "INCOMING TRANSMISSION", 3, _RGB32(255, 70, 90), 1
        IF nexusImg& < -1 AND (tNow! > 0.3 OR INT(tNow! * 20) MOD 2) THEN
            jit = 0 : IF RND < 0.06 THEN jit = INT(RND * 9) - 4
            _PUTIMAGE (80 + jit, 170)-(80 + jit + 255, 170 + 255), nexusImg&
            ' Its eye sweeps along the visor slit, side to side, and glows
            eyeX = 80 + jit + 2 * (63.5 + 25 * SIN(tNow! * 2.4)) : eyeY = 170 + 115
            FOR r = 9 TO 1 STEP -1
                LINE (eyeX - r * 3, eyeY - r \ 2)-(eyeX + r * 3, eyeY + r \ 2), _RGBA32(255, 30, 40, 26), BF
            NEXT
            LINE (eyeX - 6, eyeY - 4)-(eyeX + 6, eyeY + 4), _RGB32(255, 40, 50), BF
            LINE (eyeX - 3, eyeY - 2)-(eyeX + 3, eyeY + 2), _RGB32(255, 200, 190), BF
            LINE (78, 168)-(337, 427), _RGB32(255, 60, 90), B
        END IF
        MenuText 600, 160, "NEXUS", 2, _RGB32(255, 90, 110), 1
        ' The words, typed out as it speaks them, wrapped to fit
        shown = INT(LEN(lineText$(li)) * MinOf(1, tNow! / (tLen! * 0.85 + 0.01)))
        WrapText 380, 210, 50, LEFT$(lineText$(li), shown), _RGB32(255, 220, 230)
        MenuText 400, 560, "SPACE TO SKIP", 1, _RGB32(150, 130, 160), 1
        IF glReady THEN GLSL_filter_capture
        GLScreenLayer glReady
        ShowFrame
    LOOP
    IF lineSnd&(li) > 0 THEN _SNDSTOP lineSnd&(li)
    _KEYCLEAR
    WHILE _MOUSEINPUT : WEND
    escWas = -1 ' (an Esc that skipped it isn't the pause menu's too)
END SUB

' NEXUS says line key$: its voice, over the station's speakers - everywhere
' at once - and its words on screen. One line at a time: a new one cuts
' off the last. (fromMinion: a minion's line, no words on screen - SayAt
' says one from where the minion is.)
SUB Say(key$, fromMinion)
    STATIC lastLi
    li = LineOf(key$) : IF li = 0 THEN EXIT SUB
    IF fromMinion THEN
        IF lineSnd&(li) > 0 THEN _SNDPLAYCOPY lineSnd&(li), setting(SET_SPEECH) / 100
        EXIT SUB
    END IF
    IF lastLi > 0 THEN IF lineSnd&(lastLi) > 0 THEN IF _SNDPLAYING(lineSnd&(lastLi)) THEN _SNDSTOP lineSnd&(lastLi)
    IF lineSnd&(li) > 0 THEN _SNDVOL lineSnd&(li), setting(SET_SPEECH) / 100 : _SNDPLAY lineSnd&(li)
    lastLi = li
    speechText$ = "NEXUS: " + lineText$(li)
    IF lineSnd&(li) > 0 THEN speechUntil! = TIMER + _SNDLEN(lineSnd&(li)) + 0.6 ELSE speechUntil! = TIMER + 3
    IF speechUntil! >= 86400 THEN speechUntil! = speechUntil! - 86400 ' (past midnight: TIMER starts again from 0)
END SUB

' A minion's line (a guard reporting in), from where it is (x, y): as loud
' as it is near, from its side - and one every couple of seconds, never
' over NEXUS, so a room of guards spotting you isn't a shouting match
SUB SayAt(key$, x, y)
    DIM d ' (its own: the main program shares these names)
    STATIC quietTill!
    IF speechUntil! > TIMER THEN EXIT SUB
    IF TIMER < quietTill! AND quietTill! - TIMER < 10 THEN EXIT SUB
    li = LineOf(key$) : IF li = 0 THEN EXIT SUB
    IF lineSnd&(li) <= 0 THEN EXIT SUB
    vol! = SfxVolAt!(x, y, playerX, playerY, SFX_RANGE) : IF vol! <= 0.02 THEN EXIT SUB
    dx = x - playerX : dy = y - playerY : d = SQR(dx * dx + dy * dy) : pan! = 0
    IF setting(SET_SPATIAL) AND d > 0.5 THEN pan! = (dy * earDX - dx * earDY) / d * 0.85 * MinOf(1, d / 2)
    v! = vol! * setting(SET_SPEECH) / 100
    IF pan! = 0 THEN _SNDPLAYCOPY lineSnd&(li), v! ELSE _SNDPLAYCOPY lineSnd&(li), v!, pan!
    quietTill! = TIMER + 2.5
END SUB

' How many lines key$1, key$2... there are (taunt: NEXUS's taunts)
FUNCTION LineCount(key$)
    DIM n ' (its own: the main program shares these names)
    DO WHILE LineOf(key$ + LTRIM$(STR$(n + 1))) : n = n + 1 : LOOP
    LineCount = n
END FUNCTION

' Which voice a monster type speaks with when it spots you or hunts you
' (its lines: KEY1, KEY2...) - "" none: it isn't one to talk
FUNCTION MonVoice$(mtype)
    SELECT CASE mtype
        CASE 2, 11, 12, MT_GUARD : MonVoice$ = "soldier" ' (gunner, sniper, trooper, guard)
        CASE 3, 14, 15 : MonVoice$ = "heavy" ' (heavy, warden, colossus)
        CASE 6, 13 : MonVoice$ = "cyber" ' (stalker, ripper)
        CASE 7 : MonVoice$ = "bark" ' (the spitter: NEXUS's minion barks)
    END SELECT
END FUNCTION

' Monster i says one of its lines, from where it is (a chance in 1/chance!)
SUB MonSpeak(i, chance!)
    DIM g$, n ' (its own: the main program shares these names)
    g$ = MonVoice$(monsterType(i)) : IF LEN(g$) = 0 OR RND >= chance! THEN EXIT SUB
    n = LineCount(g$) : IF n THEN SayAt g$ + LTRIM$(STR$(INT(RND * n) + 1)), monsterX(i), monsterY(i)
END SUB

' Which line has key key$ (0: none)
FUNCTION LineOf(key$)
    DIM k ' (its own: the main program shares these names)
    FOR k = 1 TO numLines
        IF lineKey$(k) = key$ THEN LineOf = k : EXIT FUNCTION
    NEXT
END FUNCTION
