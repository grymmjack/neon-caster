''
' NEON-CASTER - GAME/ROCKETS.BM
' =============================================================================
' Rockets, missiles and the turrets' sprays (GAME/ROCKETS.BI): firing one,
' its flight, its blast, and what a spray does to you.
'

' --- One bolt of kind k from (x, y, z) - z its height, as the floor's are
' - along (dx, dy), climbing dz a cell, at speed sp, for life frames (0:
' till it hits), doing dmg. Into the first free slot.
SUB FireKind(k, x, y, z, dx, dy, dz, sp, life, dmg)
    DIM i ' (its own: the main program shares these names)
    FOR i = 1 TO MAX_BOLTS
        IF boltOn(i) = 0 THEN
            boltOn(i) = -1 : boltKind(i) = k : boltX(i) = x : boltY(i) = y : boltZ(i) = z : boltOwner(i) = boltFromMon
            boltDX(i) = dx : boltDY(i) = dy : boltDZ(i) = dz : boltSpd(i) = sp : boltLife(i) = life : boltDamage(i) = dmg : boltTgt(i) = 0 : IF boltFromMon THEN boltTgt(i) = monVs
            EXIT SUB
        END IF
    NEXT
END SUB

' --- Your rocket (gun 5): out of the launcher, from just below your eye,
' the way you face - and up or down as you look, with LOOK UP / DOWN
SUB FireRocket
    DIM dz ' (its own: the main program shares these names)
    dz = 0 : IF lookAim THEN dz = DTan(pitch)
    FireKind BK_ROCKET, playerX + dirX * 0.25, playerY + dirY * 0.25, eyeZ - 0.1, dirX, dirY, dz, ROCKET_SPEED, 240, ROCKET_HIT
END SUB

' --- One frame of bolt i's flight - any kind but plasma (chapter 13 flies
' those). A fast one is moved in steps a tenth of a cell or less, so it
' can't pass through a thin wall or a monster between frames.
SUB BoltFly(i)
    DIM k, n, s, st!, a!, tx!, ty!, d!, hit, j, f!, x!, y! ' (its own: the main program shares these names)
    k = boltKind(i)
    IF boltLife(i) > 0 THEN ' Its time up: a rocket bursts where it is, a spray's puff is gone
        boltLife(i) = boltLife(i) - 1
        IF boltLife(i) = 0 THEN
            IF k = BK_ROCKET OR k = BK_MISSILE THEN BoltBurst i ELSE boltOn(i) = 0
            IF k = BK_POISON THEN GasAdd boltX(i), boltY(i), 0.35 ' (its poison hangs where it ends)
            EXIT SUB
        END IF
    END IF
    IF boltTgt(i) THEN IF monsterState(boltTgt(i)) >= 2 THEN boltTgt(i) = 0
    IF k = BK_MISSILE AND (NOT dead OR boltTgt(i)) THEN ' A missile turns a little after you - or the monster its turret's after (it can't turn sharply: step aside)
        IF boltTgt(i) THEN x! = monsterX(boltTgt(i)) : y! = monsterY(boltTgt(i)) : f! = MonFoot(boltTgt(i)) + 0.3 ELSE x! = playerX : y! = playerY : f! = playerZ + 0.45
        a! = DAtan2(boltDY(i), boltDX(i)) : tx! = DAtan2(y! - boltY(i), x! - boltX(i)) - a!
        DO WHILE tx! > 3.14159265 : tx! = tx! - 6.2831853 : LOOP
        DO WHILE tx! < -3.14159265 : tx! = tx! + 6.2831853 : LOOP
        IF tx! > 0.03 THEN tx! = 0.03
        IF tx! < -0.03 THEN tx! = -0.03
        a! = a! + tx! : boltDX(i) = DCos(a!) : boltDY(i) = DSin(a!)
        d! = SQR((x! - boltX(i)) ^ 2 + (y! - boltY(i)) ^ 2) : IF d! > 0.3 THEN boltDZ(i) = boltDZ(i) + ((f! - boltZ(i)) / d! - boltDZ(i)) * 0.1
    END IF
    n = INT(boltSpd(i) / 0.1) + 1 : st! = boltSpd(i) / n
    FOR s = 1 TO n
        boltX(i) = boltX(i) + boltDX(i) * st! : boltY(i) = boltY(i) + boltDY(i) * st! : boltZ(i) = boltZ(i) + boltDZ(i) * st!
        x! = boltX(i) : y! = boltY(i)
        IF x! < 1 OR y! < 1 OR x! >= mapN - 1 OR y! >= mapN - 1 THEN boltOn(i) = 0 : EXIT SUB
        hit = 0 : bsSurf = -1
        IF boltZ(i) < floorH(INT(x!), INT(y!)) + 0.02 THEN hit = 1 : bsSurf = 2 ' (the floor)
        IF boltZ(i) > ceilH(INT(x!), INT(y!)) - 0.02 THEN hit = 1 : bsSurf = 1 ' (the ceiling)
        IF hit = 0 THEN
            IF InGlass(x!, y!) THEN ' Glass: your rocket smashes through it and flies on; a missile bursts on it; a puff only stops
                IF k = BK_ROCKET THEN
                    glassHitX = INT(x!) : glassHitY = INT(y!) : glassAtX = x! : glassAtY = y! : glassDmg = 99 : HitGlass
                ELSE
                    hit = 1
                    IF k = BK_MISSILE THEN glassHitX = INT(x!) : glassHitY = INT(y!) : glassAtX = x! : glassAtY = y! : glassDmg = 99 : HitGlass
                END IF
            ELSEIF BoltDeco(x!, y!, boltZ(i)) THEN
                hit = 1
            ELSEIF NOT Walkable(x!, y!) THEN
                hit = 1 : bsSurf = 0 ' (a wall)
            END IF
        END IF
        IF hit THEN ' Into something: back out of it a little - a rocket bursts there, a puff is gone
            boltX(i) = x! - boltDX(i) * 0.12 : boltY(i) = y! - boltDY(i) * 0.12 : boltZ(i) = boltZ(i) - boltDZ(i) * 0.12
            IF k = BK_ROCKET OR k = BK_MISSILE THEN BoltBurst i ELSE boltOn(i) = 0
            IF k = BK_POISON THEN GasAdd boltX(i), boltY(i), 0.35
            IF k = BK_ACID AND bsSurf >= 0 THEN ' (acid: it eats into the wall, ceiling or floor it hits - on it, not where the puff got to past it)
                f! = boltZ(i) : IF bsSurf = 2 THEN f! = floorH(INT(x!), INT(y!)) + 0.01 ELSE IF bsSurf = 1 THEN f! = ceilH(INT(x!), INT(y!)) - 0.01
                AcidMark x!, y!, f!, boltDX(i), boltDY(i), bsSurf
            END IF
            EXIT SUB
        END IF
        IF k = BK_ROCKET THEN ' Yours: into a monster, it bursts - and the one it hit takes the rocket's own hit too
            FOR j = 1 TO numMonsters
                IF monsterState(j) < 2 AND (cyberOn = 0 OR monsterType(j) = MT_ICE) AND (cyberOn <> 0 OR monsterType(j) <> MT_ICE) THEN
                    IF (monsterX(j) - x!) ^ 2 + (monsterY(j) - y!) ^ 2 < 0.42 * 0.42 THEN
                        f! = MonFoot(j)
                        IF boltZ(i) > f! - 0.1 AND boltZ(i) < f! + mtypeScale(monsterType(j)) + 0.15 THEN
                            target = j : hitDamage = boltDamage(i) : IF ampTimer > 0 THEN hitDamage = hitDamage * 2
                            hitKick = 0 : bsSurf = -1 : HitMonster : IF monsterState(j) >= 2 THEN RocketKill j
                            BoltBurst i : EXIT SUB
                        END IF
                    END IF
                END IF
            NEXT
        ELSEIF BoltMon(x!, y!, boltZ(i), boltOwner(i)) THEN ' A monster's: into another monster (INFIGHTING)
            j = BoltMon(x!, y!, boltZ(i), boltOwner(i))
            IF k = BK_MISSILE THEN BoltBurst i ELSE MonHurtBy j, boltOwner(i), boltDamage(i) : boltOn(i) = 0
            EXIT SUB
        ELSEIF NOT dead AND (x! - playerX) ^ 2 + (y! - playerY) ^ 2 < 0.35 * 0.35 AND ABS(boltZ(i) - playerZ - 0.45) < 0.5 THEN ' A monster's: into you
            IF k = BK_MISSILE THEN
                BoltBurst i
            ELSE
                hurtFromX = x! - boltDX(i) * 2 : hurtFromY = y! - boltDY(i) * 2 : PuffHurt k, boltDamage(i) : boltOn(i) = 0
            END IF
            EXIT SUB
        END IF
    NEXT
    ' Its trail (OpenGL draws them): a rocket's smoke and fire, a spray's wisps
    SELECT CASE k
        CASE BK_ROCKET, BK_MISSILE
            SpawnPart PART_SMOKE, boltX(i) - boltDX(i) * 0.15, boltY(i) - boltDY(i) * 0.15, boltZ(i), (RND - 0.5) * 0.01, (RND - 0.5) * 0.01, 0.004, 34 + INT(RND * 16), 0.16, 0.15, 0.14, 0.06 ' (dim, as all smoke is: its glow is added to what's behind)
            SpawnPart PART_FLAME, boltX(i) - boltDX(i) * 0.1, boltY(i) - boltDY(i) * 0.1, boltZ(i), 0, 0, 0, 6, 1, 0.6, 0.2, 0.06
        CASE BK_FLAME
            IF RND < 0.7 THEN SpawnPart PART_FLAME, boltX(i) + (RND - 0.5) * 0.15, boltY(i) + (RND - 0.5) * 0.15, boltZ(i) + (RND - 0.5) * 0.1, boltDX(i) * 0.03, boltDY(i) * 0.03, 0.01, 14, 1, 0.5 + RND * 0.3, 0.1, 0.09
        CASE BK_POISON, BK_ACID
            IF k = BK_POISON THEN GasAdd boltX(i), boltY(i), 0.012 ' (and some all along its way)
            IF RND < 0.5 THEN SpawnPart PART_SMOKE, boltX(i) + (RND - 0.5) * 0.2, boltY(i) + (RND - 0.5) * 0.2, boltZ(i), boltDX(i) * 0.02, boltDY(i) * 0.02, 0.002, 30, bkR(k) / 1200, bkG(k) / 1200, bkB(k) / 1200, 0.08
    END SELECT
END SUB

' --- Rocket (or missile) i bursts where it is
SUB BoltBurst(i)
    boltOn(i) = 0 : bsX = boltX(i) : bsY = boltY(i) : bsZ = boltZ(i) : bsDX = boltDX(i) : bsDY = boltDY(i) : bsOwner = boltOwner(i)
    bsYours = (boltKind(i) = BK_ROCKET AND boltOwner(i) = 0) ' (your own rocket: a rocket jump - a turret's missile only throws you)
    IF boltKind(i) = BK_ROCKET THEN
        bsR = ROCKET_RADIUS : bsMon = ROCKET_MON : bsYou = ROCKET_YOU : IF ampTimer > 0 THEN bsMon = bsMon * 2
    ELSE
        bsR = MISSILE_RADIUS : bsMon = MISSILE_MON : bsYou = MISSILE_YOU
    END IF
    BlastSized
END SUB

' --- A rocket's blast at (bsX, bsY, bsZ), bsR cells across: as a barrel's
' (BlastAt), but its own size - the most it does to a monster (bsMon) and
' to you (bsYou), less the further off - and where it is: in the air, on
' a wall or the ceiling, it goes off there, and scorches what it hit (bsSurf).
' Glass near it shatters, barrels go off, ceiling lights break; lamps,
' crates, desks and chairs further out still take a knock; what it destroys
' blows apart (RocketKill, DecoBlown), and anything that burns catches fire.
' Everything near is thrown back from it - you too: a rocket at your feet
' throws you up (a rocket jump).
SUB BlastSized
    DIM j, d!, big, cx, cy, l, kr!, dr!, ox!, oy!, p!, hp ' (its own: the main program shares these names)
    big = bsR >= ROCKET_RADIUS
    SfxAt sndRocketBoom&, bsX, bsY, playerX, playerY
    FOR j = 1 TO numGlass
        glassHitX = glassListX(j) : glassHitY = glassListY(j)
        IF glassHP(glassHitX, glassHitY) > 0 THEN
            IF (glassHitX + 0.5 - bsX) ^ 2 + (glassHitY + 0.5 - bsY) ^ 2 < bsR * bsR * 0.6 THEN glassAtX = glassHitX + 0.5 : glassAtY = glassHitY + 0.5 : glassDmg = 99 : HitGlass
        END IF
    NEXT
    newBlastX = bsX : newBlastY = bsY : newBlastSize = 0.75 : IF big THEN newBlastSize = 1.25
    IF bsZ - FloorAt(bsX, bsY) > 0.3 THEN newBlastZ = bsZ ' (in the air: there)
    newBlastNoMark = (bsSurf >= 0) ' (the rocket marks what it hit, below)
    AddBlast
    IF bsSurf >= 0 THEN ShotMark bsX + bsDX * 0.12, bsY + bsDY * 0.12, bsZ, bsDX, bsDY, bsSurf, 0.55 + 0.6 * -big ' (a big scorch, where it hit: a wall, the ceiling, the floor)
    FOR j = 1 TO 14 + 10 * -big : SpawnPart PART_EMBER, bsX, bsY, bsZ, (RND - 0.5) * 0.16, (RND - 0.5) * 0.16, (RND - 0.3) * 0.09, 20 + INT(RND * 24), 1, 0.5 + RND * 0.4, 0.15, 0.05 : NEXT
    FOR j = 1 TO 6 : SpawnPart PART_SMOKE, bsX + (RND - 0.5) * 0.4, bsY + (RND - 0.5) * 0.4, bsZ, (RND - 0.5) * 0.01, (RND - 0.5) * 0.01, 0.005, 90, 0.13, 0.12, 0.11, 0.14 : NEXT
    d! = SQR((playerX - bsX) ^ 2 + (playerY - bsY) ^ 2)
    IF d! < bsR * 4 THEN shake = shake + (10 - 6 * big) * (1 - d! / (bsR * 4))
    ' Ceiling lights within its reach: blown out
    FOR cy = INT(bsY - bsR) TO INT(bsY + bsR) : FOR cx = INT(bsX - bsR) TO INT(bsX + bsR)
        IF cx >= 0 AND cy >= 0 AND cx < mapN AND cy < mapN THEN
            l = shaftCell(cx, cy)
            IF l THEN IF NOT lightBroken(l) AND (lightX(l) - bsX) ^ 2 + (lightY(l) - bsY) ^ 2 < bsR * bsR THEN IF CanSee(bsX, bsY, lightX(l), lightY(l)) THEN BreakLight l, -1
        END IF
    NEXT : NEXT
    kr! = bsR * 1.3 ' (how far it throws things)
    FOR j = 1 TO numMonsters
        IF monsterState(j) < 2 THEN
            d! = SQR((monsterX(j) - bsX) ^ 2 + (monsterY(j) - bsY) ^ 2 + (MonFoot(j) + mtypeScale(monsterType(j)) / 2 - bsZ) ^ 2) ' (its middle, as high as it is: a ceiling turret's blast spares the floor below, a rocket on the floor the drone up high)
            IF d! < bsR THEN
                IF CanSee(bsX, bsY, monsterX(j), monsterY(j)) THEN
                    IF j <> bsOwner THEN MonHurtBy j, bsOwner, INT(bsMon * (1 - d! / bsR)) + 1 ' (its own missile's blast spares the turret that fired it)
                    IF monsterState(j) >= 2 AND big THEN RocketKill j
                END IF
            END IF
            IF d! < kr! AND d! > 0.05 THEN IF NOT CanSee(bsX, bsY, monsterX(j), monsterY(j)) THEN d! = kr! ' (a wall between: no push)
            IF d! < kr! AND d! > 0.05 AND monsterType(j) <> MT_TURRET AND monsterType(j) <> 5 AND mtypeSpeed(monsterType(j)) > 0 THEN ' (thrown back - not what's bolted down)
                p! = (1 - d! / kr!) * (0.5 + 0.4 * -big) / MaxOf(1, mtypeHP(monsterType(j)) / 12) ' (the big ones hardly move)
                ox! = (monsterX(j) - bsX) / d! * p! : oy! = (monsterY(j) - bsY) / d! * p!
                walkZ = FloorAt(monsterX(j), monsterY(j))
                FOR l = 1 TO 4 : MoveBody monsterX(j), monsterY(j), ox! / 4, oy! / 4 : NEXT
                walkZ = -999
            END IF
        END IF
    NEXT
    d! = SQR((playerX - bsX) ^ 2 + (playerY - bsY) ^ 2 + (playerZ + 0.3 - bsZ) ^ 2)
    IF d! < bsR AND NOT dead THEN
        IF CanSee(bsX, bsY, playerX, playerY) THEN
            damage = INT(bsYou * (1 - d! / bsR)) + 2
            hurtFromX = bsX : hurtFromY = bsY : hurtR = 255 : hurtG = 140 : hurtB = 40 : HurtPlayer ' (fiery edges)
        END IF
    END IF
    IF d! < kr! AND NOT dead AND NOT editMode THEN IF NOT CanSee(bsX, bsY, playerX, playerY) THEN d! = kr! ' (a wall between: no push through it)
    IF d! < kr! AND NOT dead AND NOT editMode THEN ' Thrown: away from it - and up, if it went off below your middle
        p! = 1 - d! / kr!
        dr! = SQR((playerX - bsX) ^ 2 + (playerY - bsY) ^ 2)
        IF dr! > 0.02 THEN knockX = knockX + (playerX - bsX) / dr! * p! * 0.28 : knockY = knockY + (playerY - bsY) / dr! * p! * 0.28
        IF bsZ < playerZ + 0.35 AND NOT levelFlat THEN playerVZ = MinOf(playerVZ, -0.26 * p!) : playerZ = playerZ + 0.02 : IF bsYours THEN rocketAir = -1 ' (a rocket jump - yours: lighter till you land, and no hurt landing; another's blast just throws you)
    END IF
    dr! = bsR * 1.5 ' (props: further - the chair at the desk you hit goes too)
    FOR j = 1 TO numDecos
        IF decoOn(j) OR decoBurn(j) = 0 THEN
            d! = SQR((decoX(j) - bsX) ^ 2 + (decoY(j) - bsY) ^ 2)
            IF d! < dr! THEN
                IF NOT decoOn(j) THEN
                    IF Flammable(decoKind(j)) AND d! < bsR THEN decoBurn(j) = BURN_FRAMES ' (its wreck catches)
                ELSEIF Explosive(decoKind(j)) THEN
                    IF decoFuse(j) = 0 THEN decoFuse(j) = 8
                ELSEIF CanSee(bsX, bsY, decoX(j), decoY(j)) THEN
                    targetDeco = j : hitDamage = INT(7 * (1 - d! / dr!)) + 2 : hp = decoOn(j) : HitDeco
                    IF Flammable(decoKind(j)) AND d! < bsR THEN decoBurn(j) = BURN_FRAMES
                    IF hp AND NOT decoOn(j) AND big THEN DecoBlown j
                END IF
            END IF
        END IF
    NEXT
    FOR j = 1 TO numDroids
        IF droidHP(j) > 0 THEN
            d! = SQR((droidX(j) - bsX) ^ 2 + (droidY(j) - bsY) ^ 2)
            IF d! < bsR THEN IF CanSee(bsX, bsY, droidX(j), droidY(j)) THEN HitDroid j, INT(4 * (1 - d! / bsR)) + 1, playerX, playerY
        END IF
    NEXT
    bsSurf = -1 : bsOwner = 0 : bsYours = 0
END SUB

' --- Does a decoration kind burn? (a crate, a plant, a desk, lockers, a
' bench, a chair, a body)
FUNCTION Flammable(kind)
    Flammable = INSTR("|3|5|10|18|19|20|21|", "|" + LTRIM$(STR$(kind)) + "|") > 0
END FUNCTION

' --- Monster j, killed by a rocket: blown apart - pieces of it everywhere -
' and what's left burns
SUB RocketKill(j)
    IF monsterType(j) = MT_TURRET THEN EXIT SUB ' (a turret blows up its own way)
    monBurn(j) = BURN_FRAMES
    Gibs monsterX(j), monsterY(j), MonFoot(j) + mtypeScale(monsterType(j)) * 0.5, S_GIB + monsterType(j), 10 + INT(mtypeScale(monsterType(j)) * 8)
END SUB

' --- Decoration j, destroyed by a rocket: in pieces
SUB DecoBlown(j)
    Gibs decoX(j), decoY(j), FloorAt(decoX(j), decoY(j)) + DecoScale(decoKind(j)) * 0.5, S_GIB + MON_TYPES + decoKind(j), 8
END SUB

' --- n pieces of picture slot sl, flying out from (x, y, z) every way and up
SUB Gibs(x!, y!, z!, sl, n)
    DIM k, a!, sp! ' (its own: the main program shares these names)
    FOR k = 1 TO n
        gibNext = gibNext MOD MAX_GIBS + 1
        a! = RND * 6.2831853 : sp! = 0.07 + RND * 0.17
        gibX(gibNext) = x! : gibY(gibNext) = y! : gibZ(gibNext) = z!
        gibVX(gibNext) = COS(a!) * sp! : gibVY(gibNext) = SIN(a!) * sp! : gibVZ(gibNext) = 0.04 + RND * 0.09
        gibLife(gibNext) = GIB_LIFE + INT(RND * 120) : gibSlot(gibNext) = sl : gibSize(gibNext) = 0.06 + RND * 0.08
    NEXT
END SUB

' --- One frame of the pieces (flying, bouncing, lying) and the fires
SUB GibsAndFires
    DIM k, nx!, ny!, fz!, x!, y!, z! ' (its own: the main program shares these names)
    GasFrame ' (and the poison fog)
    AcidSmoke ' (and acid stains smoking)
    FOR k = 1 TO MAX_GIBS
        IF gibLife(k) > 0 THEN
            gibLife(k) = gibLife(k) - 1
            IF gibVX(k) <> 0 OR gibVY(k) <> 0 OR gibVZ(k) <> 0 THEN
                nx! = gibX(k) + gibVX(k) : ny! = gibY(k) + gibVY(k)
                IF NOT Walkable(nx!, gibY(k)) THEN gibVX(k) = -gibVX(k) * 0.4 : nx! = gibX(k) ' (off a wall)
                IF NOT Walkable(gibX(k), ny!) THEN gibVY(k) = -gibVY(k) * 0.4 : ny! = gibY(k)
                gibX(k) = nx! : gibY(k) = ny!
                gibVZ(k) = gibVZ(k) - 0.006 : gibZ(k) = gibZ(k) + gibVZ(k)
                IF gibZ(k) > CeilAt(gibX(k), gibY(k)) - 0.05 THEN gibZ(k) = CeilAt(gibX(k), gibY(k)) - 0.05 : gibVZ(k) = -ABS(gibVZ(k)) * 0.3
                fz! = FloorAt(gibX(k), gibY(k))
                IF gibZ(k) <= fz! THEN ' (landed: a bounce, slower each time, then it lies there)
                    gibZ(k) = fz! : gibVZ(k) = -gibVZ(k) * 0.35 : gibVX(k) = gibVX(k) * 0.55 : gibVY(k) = gibVY(k) * 0.55
                    IF gibVZ(k) < 0.012 THEN gibVX(k) = 0 : gibVY(k) = 0 : gibVZ(k) = 0
                END IF
            END IF
        END IF
    NEXT
    FOR k = 1 TO numMonsters ' (a body burning)
        IF monBurn(k) > 0 THEN
            monBurn(k) = monBurn(k) - 1 : x! = monsterX(k) : y! = monsterY(k) : z! = FloorAt(x!, y!) + 0.05
            IF RND < 0.6 * (monBurn(k) / BURN_FRAMES) + 0.1 THEN SpawnPart PART_FLAME, x! + (RND - 0.5) * 0.4, y! + (RND - 0.5) * 0.4, z! + RND * 0.15, 0, 0, 0.006 + RND * 0.01, 22 + INT(RND * 14), 1, 0.45 + RND * 0.3, 0.1, 0.07 + RND * 0.05
            IF RND < 0.15 THEN SpawnPart PART_SMOKE, x! + (RND - 0.5) * 0.3, y! + (RND - 0.5) * 0.3, z! + 0.3, 0, 0, 0.007, 80, 0.12, 0.11, 0.1, 0.1
        END IF
    NEXT
    FOR k = 1 TO numDecos ' (a prop burning - or what's left of it)
        IF decoBurn(k) > 0 THEN
            decoBurn(k) = decoBurn(k) - 1 : x! = decoX(k) : y! = decoY(k) : z! = FloorAt(x!, y!) + 0.05
            IF RND < 0.6 * (decoBurn(k) / BURN_FRAMES) + 0.1 THEN SpawnPart PART_FLAME, x! + (RND - 0.5) * 0.35, y! + (RND - 0.5) * 0.35, z! + RND * 0.3, 0, 0, 0.006 + RND * 0.01, 22 + INT(RND * 14), 1, 0.45 + RND * 0.3, 0.1, 0.07 + RND * 0.05
            IF RND < 0.15 THEN SpawnPart PART_SMOKE, x! + (RND - 0.5) * 0.3, y! + (RND - 0.5) * 0.3, z! + 0.4, 0, 0, 0.007, 80, 0.12, 0.11, 0.1, 0.1
        END IF
    NEXT
END SUB

' --- A piece of picture slot src, for its pieces (dst): a jagged chunk from
' the middle of what's drawn there - its own colours
SUB MakeGib(src, dst)
    DIM sz, x, y, x0, y0, x1, y1, cxp, cyp, w, r!, a! ' (its own: the main program shares these names)
    sz = spriteSize(src) : x0 = sz : y0 = sz : x1 = -1 : y1 = -1
    FOR y = 0 TO sz - 1 : FOR x = 0 TO sz - 1
        IF _ALPHA32(spriteTex(x, y, src)) > 128 THEN
            IF x < x0 THEN x0 = x
            IF x > x1 THEN x1 = x
            IF y < y0 THEN y0 = y
            IF y > y1 THEN y1 = y
        END IF
    NEXT : NEXT
    IF x1 < 0 THEN spriteSize(dst) = 1 : spriteTex(0, 0, dst) = 0 : EXIT SUB
    w = MaxOf(4, (x1 - x0 + 1) \ 3) : cxp = (x0 + x1) \ 2 - w \ 2 : cyp = (y0 + y1) \ 2 - w \ 2
    spriteSize(dst) = w
    FOR y = 0 TO w - 1 : FOR x = 0 TO w - 1
        a! = _ATAN2(y - w / 2 + 0.5, x - w / 2 + 0.5) : r! = SQR((x - w / 2 + 0.5) ^ 2 + (y - w / 2 + 0.5) ^ 2) / (w / 2)
        IF r! < 0.62 + 0.3 * ABS(SIN(a! * 2.5 + dst)) THEN spriteTex(x, y, dst) = spriteTex(cxp + x, cyp + y, src) ELSE spriteTex(x, y, dst) = 0 ' (a ragged edge)
    NEXT : NEXT
END SUB

' --- A spray turret's puff of kind k, hitting you for dmg: flame burns;
' poison and acid the hazmat suit keeps out (and wears) - without it,
' poison turns everything green, and acid eats your armour first (twice as
' fast as it would you). The caller sets hurtFromX, hurtFromY.
SUB PuffHurt(k, dmg)
    SELECT CASE k
        CASE BK_FLAME
            damage = dmg : hurtR = 255 : hurtG = 110 : hurtB = 20 : HurtPlayer
            IF RND < 0.3 THEN PlaySfx sndSizzle&, 0.5
        CASE BK_POISON, BK_ACID
            IF suitLeft > 0 THEN
                suitLeft = MaxOf(0, suitLeft - dmg * SUIT_WEAR) : IF RND < 0.3 THEN PlaySfx sndSizzle&, 0.3
                IF suitLeft = 0 THEN PlaySfx sndPowerDown&, 0.8 : ShowMsg "Hazmat suit: worn through"
                hurtFromX = -1
            ELSEIF NOT godMode THEN
                IF k = BK_POISON THEN poisonTint = 40 : Poisoned dmg
                IF k = BK_ACID AND armor > 0 THEN
                    armor = MaxOf(0, armor - dmg * 2) : hurtFlash = 6 : PlaySfx sndSizzle&, 0.6
                    painR = bkR(k) : painG = bkG(k) : painB = bkB(k) : painVig = MaxOf(painVig, 0.5) : hurtFromX = -1
                ELSE
                    damage = dmg : hurtR = bkR(k) : hurtG = bkG(k) : hurtB = bkB(k) : HurtPlayer
                END IF
            ELSE
                hurtFromX = -1
            END IF
    END SELECT
END SUB

' --- A glowing picture for bolt kind k (S_PUFF + k): a rocket's and a
' missile's, a hot core in its colour; a spray's, a rough-edged cloud
SUB MakePuff(k)
    DIM r!, x, y, slot, n! ' (its own: the main program shares these names)
    slot = S_PUFF + k : spriteSize(slot) = 16
    FOR y = 0 TO 15 : FOR x = 0 TO 15
        r! = SQR((x - 7.5) ^ 2 + (y - 7.5) ^ 2) / 7.5
        n! = 0.82 + 0.18 * SIN(x * 1.7 + y * 2.3) * COS(x * 0.9 - y * 1.3) ' (a cloud's ragged edge: no dice, so it's the same every time)
        spriteTex(x, y, slot) = 0
        IF k = BK_ROCKET OR k = BK_MISSILE THEN
            IF r! < 0.35 THEN
                spriteTex(x, y, slot) = _RGB32(255, 255, 230)
            ELSEIF r! < 0.65 THEN
                spriteTex(x, y, slot) = _RGB32(255, (bkG(k) + 255) \ 2, (bkB(k) + 120) \ 2)
            ELSEIF r! < 0.95 THEN
                spriteTex(x, y, slot) = _RGB32(bkR(k), bkG(k), bkB(k))
            END IF
        ELSE
            IF r! < 0.4 * n! THEN
                spriteTex(x, y, slot) = _RGB32((bkR(k) + 255) \ 2, (bkG(k) + 255) \ 2, (bkB(k) + 200) \ 2)
            ELSEIF r! < n! THEN
                spriteTex(x, y, slot) = _RGB32(bkR(k), bkG(k), bkB(k))
            END IF
        END IF
    NEXT : NEXT
END SUB

' --- Poison into the fog at (x, y): amt more in its cell (an open one)
SUB GasAdd(x!, y!, amt!)
    DIM cx, cy ' (its own: the main program shares these names)
    cx = INT(x!) : cy = INT(y!)
    IF cx < 1 OR cy < 1 OR cx >= mapN - 1 OR cy >= mapN - 1 THEN EXIT SUB
    IF worldMap(cx, cy) > 0 AND worldMap(cx, cy) <> 2 THEN EXIT SUB
    gasAmt(cx, cy) = MinOf(1.5, gasAmt(cx, cy) + amt!) : gasAny = -1
END SUB

' --- One frame of the poison fog: thinning, spreading to the open cells
' beside (every 8th frame), green haze drifting in it near you - and you in
' it, poisoned, as by a poison pool (the hazmat suit wears instead)
SUB GasFrame
    DIM x, y, k, nx, ny, a!, sh!, any2 ' (its own: the main program shares these names)
    IF NOT gasAny THEN EXIT SUB
    gasWait = gasWait + 1 : any2 = 0
    FOR y = 1 TO mapN - 2 : FOR x = 1 TO mapN - 2
        a! = gasAmt(x, y)
        IF a! > 0 THEN
            any2 = -1
            a! = a! * 0.996 : IF a! < 0.02 THEN a! = 0
            IF gasWait MOD 8 = 0 AND a! > 0.08 THEN ' (spreading: a little into each open cell beside it with less)
                FOR k = 0 TO 3
                    nx = x - (k = 0) + (k = 1) : ny = y - (k = 2) + (k = 3)
                    IF worldMap(nx, ny) = 0 OR (worldMap(nx, ny) = 2 AND doorOpen(nx, ny) >= 0.5) THEN
                        IF gasAmt(nx, ny) < a! THEN sh! = (a! - gasAmt(nx, ny)) * 0.06 : gasAmt(nx, ny) = gasAmt(nx, ny) + sh! : a! = a! - sh!
                    END IF
                NEXT
            END IF
            gasAmt(x, y) = a!
            IF a! > 0.04 THEN ' (its haze, near you)
                IF ABS(x - playerX) < 14 AND ABS(y - playerY) < 14 THEN
                    IF RND < a! * 0.12 THEN SpawnPart PART_SMOKE, x + RND, y + RND, FloorAt(x + 0.5, y + 0.5) + 0.1 + RND * 0.6, (RND - 0.5) * 0.003, (RND - 0.5) * 0.003, 0.0008, 120 + INT(RND * 60), 0.05, 0.16, 0.04, 0.16 + RND * 0.1
                END IF
            END IF
        END IF
    NEXT : NEXT
    gasAny = any2
    a! = gasAmt(INT(playerX), INT(playerY))
    IF a! > 0.12 AND NOT dead AND playerZ - floorH(INT(playerX), INT(playerY)) < 1 AND gasWait MOD 40 = 0 THEN
        hurtFromX = -1 : hurtFromY = -1 : PuffHurt BK_POISON, INT(a! * 4) + 1
    END IF
END SUB

' --- Poison's got to you, amt of it: it builds up (poisonBuild) - past
' POISON_BUILD you're poisoned, for POISON_TIME frames more
SUB Poisoned(amt)
    IF godMode OR editMode OR dead THEN EXIT SUB
    poisonBuild = poisonBuild + amt
    IF poisonBuild < POISON_BUILD AND poisonLeft = 0 THEN EXIT SUB
    IF poisonLeft = 0 THEN ShowMsg "POISONED - a health pack or medkit cures it"
    poisonLeft = POISON_TIME
END SUB

' --- One frame of being poisoned: once a second, POISON DAMAGE (as made, 3)
' - a demo always 3, as it was played
SUB PoisonFrame
    DIM dps ' (its own: the main program shares these names)
    IF poisonBuild > 0 THEN poisonBuild = MaxOf(0, poisonBuild - 0.02) ' (wearing off: about 10 seconds from the edge)
    IF poisonLeft <= 0 THEN EXIT SUB
    IF dead THEN poisonLeft = 0 : EXIT SUB
    poisonLeft = poisonLeft - 1
    IF poisonLeft MOD 60 = 0 THEN
        dps = setting(SET_POISON) : IF demoRec OR demoPlay THEN dps = 3
        IF dps > 0 THEN damage = dps : hurtFromX = -1 : hurtFromY = -1 : hurtR = 80 : hurtG = 230 : hurtB = 60 : HurtPlayer : poisonTint = MaxOf(poisonTint, 25)
    END IF
END SUB

' --- A health pack or medkit: the poison gone
SUB PoisonCure
    poisonBuild = 0 : IF poisonLeft > 0 THEN poisonLeft = 0 : ShowMsg "Poison cured" : poisonTint = 0
END SUB

' --- Acid splashed on a wall, the ceiling or the floor (surface) at (x, y,
' z), coming along (dx, dy): a stain - or, one near there already, that one
' freshened and spread a little (so they never pile up). It smokes a while.
SUB AcidMark(x!, y!, z!, dx!, dy!, surface)
    DIM k ' (its own: the main program shares these names)
    FOR k = 1 TO MAX_DECALS
        IF decalOn(k) AND decalKind(k) = 1 THEN
            IF (decalX(k) - x!) ^ 2 + (decalY(k) - y!) ^ 2 + (decalZ(k) - z!) ^ 2 < 0.09 THEN decalSmoke(k) = 420 : decalSize(k) = MinOf(0.75, decalSize(k) + 0.015) : EXIT SUB
        END IF
    NEXT
    newDecalKind = 1 : ShotMark x!, y!, z!, dx!, dy!, surface, 0.32 + RND * 0.12 : newDecalKind = 0
END SUB

' --- One frame of the acid stains smoking (fewer wisps as it dies down)
SUB AcidSmoke
    DIM k, f! ' (its own: the main program shares these names)
    FOR k = 1 TO MAX_DECALS
        IF decalOn(k) AND decalSmoke(k) > 0 THEN
            decalSmoke(k) = decalSmoke(k) - 1 : f! = decalSmoke(k) / 420
            IF RND < 0.18 * f! THEN SpawnPart PART_SMOKE, decalX(k) + decalNX(k) * 0.05 + (RND - 0.5) * decalSize(k) * 0.6, decalY(k) + decalNY(k) * 0.05 + (RND - 0.5) * decalSize(k) * 0.6, decalZ(k) + decalNZ(k) * 0.05 + (RND - 0.5) * decalSize(k) * 0.4 * (1 - ABS(decalNZ(k))), decalNX(k) * 0.003, decalNY(k) * 0.003, 0.004, 60 + INT(RND * 40), 0.14, 0.17, 0.04, 0.05 + RND * 0.04
        END IF
    NEXT
END SUB
