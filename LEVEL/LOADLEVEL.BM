''
' NEON-CASTER - LEVEL/LOADLEVEL.BM
' =============================================================================
' Loading a level (chapter 20): from its file to the world.
'

' --- Start (or restart) the level: read its map, and reset everything in it
SUB LoadLevel STATIC
    pzTerm = 0 ' (no terminal's puzzle half done in a new level)
    editFresh = -1 ' (the level as its file has it: nothing in it to save)
    nq = conQHead ' (a trigger's commands still waiting - after a "wait" - belonged to the level being left: gone)
    FOR q = conQHead + 1 TO conQTail
        IF LEFT$(conQ$(q), 1) <> CHR$(2) THEN nq = nq + 1 : conQ$(nq) = conQ$(q)
    NEXT
    conQTail = nq
    IF conQHead >= conQTail THEN conWait = 0 ' (and a trigger's "wait" with them - unless typed commands still queue behind it)
    achSectN = 0
    achLevelHurt = 0 : achOtherGun = 0 : achInLava = 0 ' (for the sector's end: hurt? any gun but the blaster?)
    ReadLevelFile level ' (its file: neon-caster/levels/levelN.txt - chapter 22)
    IF NOT lvlOK THEN PRINT "Can't read the level file "; LevelFile$(level) : SLEEP : SYSTEM
    BuildLevel ' (and on into the next part)
END SUB
' The editor comes in here (editRebuild on): the level built again from
' lvlRow$() and the rest, as it's been changed - not from its file
SUB BuildLevel STATIC
    IF cyberOn THEN CyberTextures 0 : cyberOn = 0 ' (died in the network: the real pictures back)
    FOR k = 1 TO MAX_EVENTS ' (each event room's own looping sound - a trap's buzz or roar - closed: the next level's room k may be another kind)
        IF evHum&(k) > 0 THEN _SNDSTOP evHum&(k) : _SNDCLOSE evHum&(k)
        evHum&(k) = 0
    NEXT
    numStations = 0 : numPads = 0 : numTerms = 0 : numTCtrl = 0 : FOR k = 0 TO MAX_PADS : padFlown(k) = 0 : NEXT
    IF NOT editRebuild THEN glReady = 0 ' (OpenGL: nothing to draw until the level's first frame - chapter 24)
    FOR i = 1 TO MAX_PART : partLife(i) = 0 : NEXT : pitch = 0 : ampTimer = 0
    FOR y = 0 TO MAP_SIZE : FOR x = 0 TO MAP_SIZE ' (all of it, as far as any sector can go: a smaller one's past its edge is nothing)
        worldMap(x, y) = 0 : doorOpen(x, y) = 0 : doorMove(x, y) = 0 : doorWait(x, y) = 0 : doorLock(x, y) = 0 : doorLockEv(x, y) = 0 : doorKey(x, y) = 0 : closetCell(x, y) = 0 : secretCell(x, y) = 0 : closetIn(x, y) = 0 : secretArea(x, y) = 0 : doorType(x, y) = 0 : diagCorner(x, y) = 0 : glassHP(x, y) = 0 : glassDir(x, y) = 0 : floorH(x, y) = 0 : ceilH(x, y) = 1
        floorTex(x, y) = T_FLOOR + 1 : ceilTex(x, y) = T_CEIL + 1 : floorSplit(x, y) = 0 : ceilSplit(x, y) = 0 : decoCell(x, y) = 0
        FOR f = 1 TO FACE_MAX : faceTex(x, y, f) = 0 : faceTex2(x, y, f) = 0 : faceDiv(x, y, f) = 0 : NEXT
        boxOn(x, y) = 0
        cellSeen(x, y) = 0
    NEXT : NEXT
    numItems = 0 : numMonsters = 0 : numDecos = 0 : hasMap = 0 : mapOpen = 0
    ERASE decoCharge, decoBurst
    FOR i = 1 TO MAX_ITEMS : itemToss(i) = 0 : NEXT
    LootTable ' (what breakables leave: the game's table, and the level's [loot])
    FOR k = 1 TO 3 : hasCard(k) = 0 : NEXT
    FOR i = 1 TO MAX_BOLTS : boltOn(i) = 0 : NEXT
    FOR i = 1 TO MAX_BEAMS : beamT(i) = 0 : NEXT
    FOR i = 1 TO MAX_BLASTS : blastTime(i) = 0 : NEXT
    FOR i = 1 TO MAX_GIBS : gibLife(i) = 0 : NEXT : FOR i = 1 TO MAX_MON : monBurn(i) = 0 : NEXT : FOR i = 1 TO MAX_DECO : decoBurn(i) = 0 : NEXT : knockX = 0 : knockY = 0 : rocketAir = 0 : gasAny = 0 : poisonLeft = 0 : poisonBuild = 0 : FOR i = 0 TO mapN : FOR j = 0 TO mapN : gasAmt(i, j) = 0 : NEXT : NEXT ' (rockets' pieces, fires and knocks, poison fog: gone)
    levelName$ = lvlName$
    ' Its pictures - only those that aren't already in their slots (texFile$)
    texNew = 0
    FOR k = 1 TO 6 ' Walls # N C K P G
        IF texFile$(k) <> lvlWall$(k) THEN LoadTex lvlWall$(k), k : texFile$(k) = lvlWall$(k) : texNew = -1
    NEXT
    FOR k = 1 TO 4
        IF texFile$(T_FLOOR + k) <> lvlFloor$(k) THEN LoadTex lvlFloor$(k), T_FLOOR + k : texFile$(T_FLOOR + k) = lvlFloor$(k) : texNew = -1
    NEXT
    FOR k = 1 TO 2
        IF texFile$(T_CEIL + k) <> lvlCeil$(k) THEN LoadTex lvlCeil$(k), T_CEIL + k : texFile$(T_CEIL + k) = lvlCeil$(k) : texNew = -1
    NEXT
    IF texNew OR NOT editRebuild THEN MakeLiftTex ' (the lifts' pictures, from these)
    IF NOT editRebuild THEN glTexVersion = glTexVersion + 1 ' (a new level: OpenGL needs it all again - chapter 24)
    ambientLevel = lvlAmb(1) : ambientTintR = lvlAmb(2) : ambientTintG = lvlAmb(3) : ambientTintB = lvlAmb(4) ' The level's ambient light: brightness, then colour
    ambientR = ambientLevel * ambientTintR / 255 : ambientG = ambientLevel * ambientTintG / 255 : ambientB = ambientLevel * ambientTintB / 255
    FOR y = 0 TO mapN - 1 : FOR x = 0 TO mapN - 1 ' Each cell's own: a cell light, or the sector's
        IF lvlCLBright(x, y) >= 0 THEN
            c~& = lvlCLCol(x, y) : cellAmbFx(x, y) = lvlCLFx(x, y)
            cellAmbR(x, y) = lvlCLBright(x, y) * _RED32(c~&) / 255 : cellAmbG(x, y) = lvlCLBright(x, y) * _GREEN32(c~&) / 255 : cellAmbB(x, y) = lvlCLBright(x, y) * _BLUE32(c~&) / 255
        ELSE
            cellAmbR(x, y) = ambientR : cellAmbG(x, y) = ambientG : cellAmbB(x, y) = ambientB : cellAmbFx(x, y) = 0
        END IF
    NEXT : NEXT
    FOR k = 1 TO 7
        IF k <> 2 THEN wallMapColor(k) = MinimapColor~&(wallTexSlot(k))
    NEXT
    wallMapColor(8) = _RGB32(60, 240, 255) : wallMapColor(9) = _RGB32(90, 255, 120) : wallMapColor(10) = _RGB32(255, 120, 40) ' (data stations, code terminals, turret controls: bright on the map)
    ' Floor and ceiling zones (chapter 22): each paints a rectangle - or the
    ' triangle on one side of its diagonal - with a floor and/or ceiling texture
    FOR k = 1 TO lvlNumZones
        zoneX0 = lvlZone(k, 1) : zoneY0 = lvlZone(k, 2) : zoneX1 = lvlZone(k, 3) : zoneY1 = lvlZone(k, 4)
        zoneFloor = lvlZone(k, 5) : zoneCeil = lvlZone(k, 6) : zoneShape = lvlZone(k, 7)
        zoneSize = zoneX1 - zoneX0
        FOR y = zoneY0 TO zoneY1 : FOR x = zoneX0 TO zoneX1
            ' Is the cell in the zone (1), outside it (0), or cut by its diagonal
            ' (2: the half on the zoneShape corner's side is in)? i and j are the
            ' cell's place in the zone; for a triangle, i + j or i - j says which
            ' side of the diagonal it's on, like the diagonal walls' maths.
            i = x - zoneX0 : j = y - zoneY0 : zonePart = 1
            SELECT CASE zoneShape
                CASE 1 : IF i + j > zoneSize THEN zonePart = 0 ELSE IF i + j = zoneSize THEN zonePart = 2
                CASE 2 : IF j > i THEN zonePart = 0 ELSE IF j = i THEN zonePart = 2
                CASE 3 : IF i + j < zoneSize THEN zonePart = 0 ELSE IF i + j = zoneSize THEN zonePart = 2
                CASE 4 : IF i > j THEN zonePart = 0 ELSE IF i = j THEN zonePart = 2
            END SELECT
            IF zonePart = 1 THEN
                IF zoneFloor THEN floorTex(x, y) = T_FLOOR + zoneFloor : floorSplit(x, y) = 0
                IF zoneCeil THEN ceilTex(x, y) = T_CEIL + zoneCeil : ceilSplit(x, y) = 0
            ELSEIF zonePart = 2 THEN
                IF zoneFloor THEN floorTex2(x, y) = T_FLOOR + zoneFloor : floorSplit(x, y) = zoneShape
                IF zoneCeil THEN ceilTex2(x, y) = T_CEIL + zoneCeil : ceilSplit(x, y) = zoneShape
            END IF
        NEXT : NEXT
    NEXT
    ' Single faces' own pictures ([faces]): each picture a slot of its own
    ' (T_CUSTOM + 1...), loaded only if it isn't there already
    customN = 0 : faceAny = (lvlNumFaces > 0) : facesFull = 0
    FOR k = 1 TO lvlNumFaces
        x = lvlFaceX(k) : y = lvlFaceY(k) : f = lvlFaceS(k)
        IF x >= 0 AND y >= 0 AND x < mapN AND y < mapN THEN
            FOR half = 1 TO 2
                IF half = 1 THEN pic$ = lvlFaceP1$(k) ELSE pic$ = lvlFaceP2$(k)
                slot = 0
                IF pic$ <> "" THEN
                    FOR j = T_CUSTOM + 1 TO T_CUSTOM + customN
                        IF texFile$(j) = pic$ THEN slot = j
                    NEXT
                    IF slot = 0 AND customN >= T_CUSTOMN THEN facesFull = -1
                    IF slot = 0 AND customN < T_CUSTOMN AND _FILEEXISTS(ArtPath$(pic$)) THEN
                        customN = customN + 1 : slot = T_CUSTOM + customN
                        IF texFile$(slot) <> pic$ THEN LoadTex pic$, slot : texFile$(slot) = pic$ : texNew = -1
                    END IF
                END IF
                IF half = 1 THEN slot1 = slot ELSE slot2 = slot
            NEXT
            d = lvlFaceD(k) ' (divided: a half with no picture of its own keeps the usual)
            SELECT CASE f
                CASE 9
                    IF d THEN
                        IF slot2 THEN floorTex2(x, y) = slot2 ELSE floorTex2(x, y) = floorTex(x, y)
                        IF slot1 THEN floorTex(x, y) = slot1
                        floorSplit(x, y) = 4 + d
                    ELSEIF slot1 THEN
                        floorTex(x, y) = slot1 : floorSplit(x, y) = 0
                    END IF
                CASE 10
                    IF d THEN
                        IF slot2 THEN ceilTex2(x, y) = slot2 ELSE ceilTex2(x, y) = ceilTex(x, y)
                        IF slot1 THEN ceilTex(x, y) = slot1
                        ceilSplit(x, y) = 4 + d
                    ELSEIF slot1 THEN
                        ceilTex(x, y) = slot1 : ceilSplit(x, y) = 0
                    END IF
                CASE 1 TO 8, FACE_BOX + 1 TO FACE_MAX : faceTex(x, y, f) = slot1 : faceTex2(x, y, f) = slot2 : faceDiv(x, y, f) = d
            END SELECT
        END IF
    NEXT
    ' A light on a wall's face (the editor's LIGHT puts it just in front of the
    ' face's middle) tints that face its colour: a copy of the face's picture,
    ' coloured (MakeGlowTex), in a slot of its own - OpenGL lights it itself
    ' and makes it pulse or flicker as the light does. So a red light shows
    ' red on its wall even in a room already as bright as it gets.
    FOR k = 1 TO lvlNumLights
        lx = lvlLight(k, 1) : ly = lvlLight(k, 2) : fx = lx - INT(lx) : fy = ly - INT(ly) : gx = -1
        bxW = 0 ' (in front of a block's side - its middle, 0.12 out: that side's tinted - looked for first, as its spot can look like a wall's)
        IF lvlNumBoxes THEN
            FOR bk = 1 TO lvlNumBoxes
                bx0 = lvlBox(bk, 1) + lvlBox(bk, 3) / 8 : bx1 = lvlBox(bk, 1) + lvlBox(bk, 5) / 8 : by0 = lvlBox(bk, 2) + lvlBox(bk, 4) / 8 : by1 = lvlBox(bk, 2) + lvlBox(bk, 6) / 8
                FOR sd = 1 TO 4
                    SELECT CASE sd
                        CASE 1 : ax = bx1 + 0.12 : ay = (by0 + by1) / 2
                        CASE 2 : ax = (bx0 + bx1) / 2 : ay = by1 + 0.12
                        CASE 3 : ax = bx0 - 0.12 : ay = (by0 + by1) / 2
                        CASE 4 : ax = (bx0 + bx1) / 2 : ay = by0 - 0.12
                    END SELECT
                    IF ABS(lx - ax) < 0.03 AND ABS(ly - ay) < 0.03 THEN gx = lvlBox(bk, 1) : gy = lvlBox(bk, 2) : gs = FACE_BOX + sd : bxW = lvlBox(bk, 7) : IF bxW < 1 OR bxW > 6 THEN bxW = 1
                NEXT
            NEXT
        END IF
        IF gx < 0 THEN ' (else in front of a wall's side)
            IF ABS(fy - 0.5) < 0.03 AND ABS(fx - 0.12) < 0.03 THEN gx = INT(lx) - 1 : gy = INT(ly) : gs = 1
            IF ABS(fy - 0.5) < 0.03 AND ABS(fx - 0.88) < 0.03 THEN gx = INT(lx) + 1 : gy = INT(ly) : gs = 3
            IF ABS(fx - 0.5) < 0.03 AND ABS(fy - 0.12) < 0.03 THEN gx = INT(lx) : gy = INT(ly) - 1 : gs = 2
            IF ABS(fx - 0.5) < 0.03 AND ABS(fy - 0.88) < 0.03 THEN gx = INT(lx) : gy = INT(ly) + 1 : gs = 4
        END IF
        IF gx >= 0 AND gy >= 0 AND gx < mapN AND gy < mapN THEN
            gc$ = MID$(lvlRow$(gy), gx + 1, 1) : lc = INT(lx) : lr = INT(ly) ' (the map isn't built yet: its characters, and its height rows, say what's there)
            IF INSTR("DHXRBY!E%?/\", gc$) = 0 THEN ' (not a door - nor a secret wall, which a tint would give away, nor a diagonal, which takes its neighbours' look)
                gWall = INSTR("#NCKPG@$%?/\", gc$) > 0
                amt = 0.35 + 0.55 * lvlLight(k, 4) / 255
                key$ = ":" + LTRIM$(STR$(lvlLight(k, 5))) + "," + LTRIM$(STR$(lvlLight(k, 6))) + "," + LTRIM$(STR$(lvlLight(k, 7))) + ":" + LTRIM$(STR$(INT(amt * 100))) + ":" + LTRIM$(STR$(lvlLight(k, 8)))
                gEnd = gs + 4 : IF bxW THEN gEnd = gs ' (a block's side: just that)
                FOR g = gs TO gEnd STEP 4 ' (its side - a wall's, or a step's - and a lintel's, the same side higher up)
                    there = 0
                    IF bxW THEN
                        there = -1
                    ELSEIF gWall THEN
                        there = (g = gs)
                    ELSEIF g = gs THEN
                        there = HeightOf(MID$(lvlFloorRow$(gy), gx + 1, 1), 0) > HeightOf(MID$(lvlFloorRow$(lr), lc + 1, 1), 0) ' (a step up from the light's cell)
                    ELSE
                        there = HeightOf(MID$(lvlCeilRow$(gy), gx + 1, 1), 1) < HeightOf(MID$(lvlCeilRow$(lr), lc + 1, 1), 1) ' (a lintel down)
                    END IF
                    IF there THEN
                        SELECT CASE gc$
                            CASE "#", "N", "C", "K", "P", "G" : dflt = INSTR("#NCKPG", gc$)
                            CASE "@" : dflt = T_JACK
                            CASE "$" : dflt = T_CODE
                            CASE ELSE : IF bxW THEN dflt = bxW ELSE dflt = wallTexSlot(1) ' (a block's: its wall's)
                        END SELECT
                        hMax = 1 : IF faceDiv(gx, gy, g) THEN hMax = 2 ' (divided: each half its own copy)
                        FOR half = 1 TO hMax
                            IF half = 1 THEN glBaseSl = faceTex(gx, gy, g) ELSE glBaseSl = faceTex2(gx, gy, g)
                            IF glBaseSl = 0 THEN glBaseSl = dflt
                            want$ = "glow:" + LTRIM$(STR$(glBaseSl)) + key$ + ":" + texFile$(glBaseSl) : slot = 0 ' (the picture it's made from, named too: a new picture there, a new copy)
                            FOR j = T_CUSTOM + 1 TO T_CUSTOM + customN
                                IF texFile$(j) = want$ THEN slot = j
                            NEXT
                            IF slot = 0 AND customN >= T_CUSTOMN THEN facesFull = -1
                            IF slot = 0 AND customN < T_CUSTOMN THEN
                                customN = customN + 1 : slot = T_CUSTOM + customN
                                IF texFile$(slot) <> want$ THEN texFile$(slot) = want$ : MakeGlowTex slot : texNew = -1
                            END IF
                            IF slot THEN
                                faceAny = -1
                                IF half = 1 THEN faceTex(gx, gy, g) = slot ELSE faceTex2(gx, gy, g) = slot
                            END IF
                        NEXT
                    END IF
                NEXT
            END IF
        END IF
    NEXT
    IF facesFull AND editMode THEN EditNote "More than" + STR$(T_CUSTOMN) + " pictures on faces (lights' tints too) - the rest show as usual"
    ' The level's lights: x, y, radius, brightness, red, green, blue, effect
    numLights = 0
    FOR l = 1 TO MAX_LIGHTS : lightBroken(l) = 0 : NEXT
    FOR d = 1 TO MAX_DECALS : decalOn(d) = 0 : NEXT ' (no marks on a new level)
    FOR k = 1 TO lvlNumLights
        lx = lvlLight(k, 1) : ly = lvlLight(k, 2) : lRadius = lvlLight(k, 3) : lBright = lvlLight(k, 4)
        lRed = lvlLight(k, 5) : lGreen = lvlLight(k, 6) : lBlue = lvlLight(k, 7) : lEffect = lvlLight(k, 8)
        AddLight lx, ly, lRadius, lBright * lRed / 255, lBright * lGreen / 255, lBright * lBlue / 255, lEffect, 0
    NEXT
    ' The level's event rooms: kind, x0, y0, x1, y1, a, b, reward
    numEvents = lvlNumEvents
    FOR k = 1 TO numEvents
        evType(k) = lvlEvent(k, 1) : evX0(k) = lvlEvent(k, 2) : evY0(k) = lvlEvent(k, 3) : evX1(k) = lvlEvent(k, 4)
        evY1(k) = lvlEvent(k, 5) : evA(k) = lvlEvent(k, 6) : evB(k) = lvlEvent(k, 7) : evReward(k) = lvlEvent(k, 8)
        evState(k) = 0 : evTimer(k) = 0 : evCount(k) = 0 : evNext(k) = 0 : evGlow(k) = 0 : evAway(k) = 0 : evPaused(k) = 0
        IF evType(k) = EV_TRAP OR evType(k) = EV_FIRETRAP THEN ' (its floor: its own picture, so you can see where it is)
            FOR y = evY0(k) TO evY1(k) : FOR x = evX0(k) TO evX1(k)
                IF x > 0 AND y > 0 AND x < mapN - 1 AND y < mapN - 1 THEN floorSplit(x, y) = 0 : IF evType(k) = EV_FIRETRAP THEN floorTex(x, y) = T_FIRE ELSE floorTex(x, y) = T_TRAP
            NEXT : NEXT
        END IF
    NEXT
    FOR y = 0 TO mapN - 1
        row$ = lvlRow$(y)
        FOR x = 0 TO mapN - 1
            cell$ = MID$(row$, x + 1, 1)
            SELECT CASE cell$
                CASE "#" : worldMap(x, y) = 1
                CASE "%" : worldMap(x, y) = 1 : closetCell(x, y) = -1 ' A closet's secret wall (its look: the walls beside it - AssignClosets)
                CASE "?" : worldMap(x, y) = 1 : secretCell(x, y) = -1 ' A secret wall (its look: the walls beside it - AssignSecrets)
                CASE "N" : worldMap(x, y) = 3
                CASE "C" : worldMap(x, y) = 4
                CASE "K" : worldMap(x, y) = 5
                CASE "P" : worldMap(x, y) = 6
                CASE "G" : worldMap(x, y) = 7
                CASE "D" : worldMap(x, y) = 2
                CASE "H" : worldMap(x, y) = 2 : doorType(x, y) = DOOR_SHUTTER
                CASE "X" : worldMap(x, y) = 2 : doorType(x, y) = DOOR_SPLIT
                CASE "/" : diagCorner(x, y) = -1 ' Diagonal wall (which half is solid: below)
                CASE "\" : diagCorner(x, y) = -2
                CASE "E" : worldMap(x, y) = 2 : doorType(x, y) = DOOR_EXIT
                CASE "R", "B", "Y" ' Key door: needs that keycard
                    worldMap(x, y) = 2 : doorKey(x, y) = INSTR("RBY", cell$)
                CASE "r", "b", "y", "+", "a", "e", "2", "3", "u", "*", "4", "M", "q", "j", "8", "9", ")", "(" ' Something to pick up (ItemChars$)
                    IF numItems < MAX_ITEMS THEN
                        numItems = numItems + 1
                        itemX(numItems) = x + 0.5 : itemY(numItems) = y + 0.5 : itemOn(numItems) = -1
                        itemKind(numItems) = ItemOfChar(cell$)
                    END IF
                CASE "@" ' A data station: a wall with a socket
                    worldMap(x, y) = 8
                    IF numStations < MAX_STATIONS THEN numStations = numStations + 1 : stationX(numStations) = x : stationY(numStations) = y : stationDone(numStations) = 0
                CASE "!" : worldMap(x, y) = 2 : doorLock(x, y) = 2 ' A door sealed until its data station is hacked (the nearest)
                CASE "$" ' A code terminal: a wall with a screen
                    worldMap(x, y) = 9
                    IF numTerms < MAX_TERMS THEN numTerms = numTerms + 1 : termX(numTerms) = x : termY(numTerms) = y : termDone(numTerms) = 0
                CASE ";" ' A turret control panel: a wall with a screen (HackUse)
                    worldMap(x, y) = 10
                    IF numTCtrl < MAX_TCTRL THEN numTCtrl = numTCtrl + 1 : tcX(numTCtrl) = x : tcY(numTCtrl) = y : tcState(numTCtrl) = 0
                CASE "&" ' A teleporter's pad
                    IF numPads < MAX_PADS THEN numPads = numPads + 1 : padX(numPads) = x : padY(numPads) = y
                CASE "=" : glassHP(x, y) = GLASS_HP ' Glass: floor, with a pane across it (AssignGlass)
                CASE "o", "i", "p", "t", "x", "l", "n", "f", "S", "d", "A", "F", "I", "J", "L", "O", "Q", "U", "W", "Z", "V" ' A decoration
                    IF numDecos < MAX_DECO THEN
                        numDecos = numDecos + 1 : decoCell(x, y) = numDecos
                        decoX(numDecos) = x + 0.5 : decoY(numDecos) = y + 0.5 : decoKind(numDecos) = INSTR("oiptxlnfSdAFIJLOQUWZV", cell$) : decoOn(numDecos) = -1 : decoFuse(numDecos) = 0 : vendState(numDecos) = 0 : decoFace(numDecos) = 0
                        decoHP(numDecos) = DecoMaxHP(decoKind(numDecos)) : decoTimer(numDecos) = 0 : decoLootA(numDecos) = NO_AIM
                    END IF
                CASE "m", "g", "h", "c", "s", "k", "w", "z", "T", "1", "5", "6", "7", "0", "~", "_", "|" ' A monster (MonChars$)
                    IF numMonsters < MAX_MON THEN
                        numMonsters = numMonsters + 1
                        monsterX(numMonsters) = x + 0.5 : monsterY(numMonsters) = y + 0.5 : monsterType(numMonsters) = MonOfChar(cell$)
                        MonFresh numMonsters ' (a turret: ~ drops from the ceiling, _ rises from the floor, | slides out of a wall - TurretMount, once the walls are all in)
                        IF cell$ = "_" THEN monFrom(numMonsters) = TURRET_FLOOR ELSE IF cell$ = "|" THEN monFrom(numMonsters) = TURRET_WALL
                        monsterHP(numMonsters) = mtypeHP(monsterType(numMonsters)) : monsterState(numMonsters) = 0 : monsterTimer(numMonsters) = 0 : monsterHurt(numMonsters) = 0
                        monsterEv(numMonsters) = 0 : ThiefReset numMonsters
                        MonOwn numMonsters, x, y ' (its own sight, hearing, health, speed, waking - [monsters])
                    END IF
                CASE "<", ">", "^", "v" ' Player start, facing the arrow's way
                    playerX = x + 0.5 : playerY = y + 0.5
                    dirX = (cell$ = "<") - (cell$ = ">") : dirY = (cell$ = "^") - (cell$ = "v")
            END SELECT
        NEXT
    NEXT
    ' Diagonal walls: the map only says "/" or "\", so which half is solid?
    ' Score each half by the walls beside it (a whole wall counts 2, another
    ' diagonal 1) and the better side wins. A "/" can only be solid top-left (1)
    ' or bottom-right (3), a "\" top-right (2) or bottom-left (4). It takes the
    ' look of the wall beside its solid half (N if there's none).
    FOR y = 1 TO mapN - 2 : FOR x = 1 TO mapN - 2
        IF diagCorner(x, y) < 0 THEN
            bestScore = -1
            FOR k = -diagCorner(x, y) TO 4 STEP 2 ' "/" (-1) tries corners 1 and 3, "\" (-2) 2 and 4
                IF k <= 2 THEN nbY = y - 1 ELSE nbY = y + 1
                IF k = 2 OR k = 3 THEN nbX = x + 1 ELSE nbX = x - 1
                score = 0
                IF diagCorner(x, nbY) THEN score = score + 1 ELSE IF IsWall(x, nbY) THEN score = score + 2
                IF diagCorner(nbX, y) THEN score = score + 1 ELSE IF IsWall(nbX, y) THEN score = score + 2
                IF score > bestScore THEN bestScore = score : bestCorner = k : bestNbX = nbX : bestNbY = nbY
            NEXT
            diagCorner(x, y) = bestCorner : worldMap(x, y) = 3
            IF IsWall(x, bestNbY) THEN worldMap(x, y) = worldMap(x, bestNbY) ELSE IF IsWall(bestNbX, y) THEN worldMap(x, y) = worldMap(bestNbX, y)
        END IF
    NEXT : NEXT
    ' Boxes ([boxes]): only in an open cell - not a wall, a door, a diagonal or
    ' glass - and at least an eighth each way
    boxAny = 0
    FOR k = 1 TO lvlNumBoxes
        x = lvlBox(k, 1) : y = lvlBox(k, 2)
        IF x > 0 AND y > 0 AND x < mapN - 1 AND y < mapN - 1 THEN
            IF worldMap(x, y) <= 0 AND diagCorner(x, y) = 0 AND glassHP(x, y) = 0 THEN
                w = lvlBox(k, 7) : IF w < 1 OR w > 6 THEN w = 1
                boxOn(x, y) = VAL(MID$("134567", w, 1)) : boxAny = -1
                boxX0(x, y) = MinOf(lvlBox(k, 3), 7) / 8 : boxY0(x, y) = MinOf(lvlBox(k, 4), 7) / 8
                boxX1(x, y) = MaxOf(lvlBox(k, 5) / 8, boxX0(x, y) + BOX_MIN) : boxY1(x, y) = MaxOf(lvlBox(k, 6) / 8, boxY0(x, y) + BOX_MIN)
                IF boxX1(x, y) > 1 THEN boxX1(x, y) = 1
                IF boxY1(x, y) > 1 THEN boxY1(x, y) = 1
            END IF
        END IF
    NEXT
    ' Decorations moved off their cell's middle ([nudges])
    FOR k = 1 TO lvlNumNudges
        x = lvlNudge(k, 1) : y = lvlNudge(k, 2)
        IF x >= 0 AND y >= 0 AND x < mapN AND y < mapN THEN
            i = decoCell(x, y)
            IF i THEN decoX(i) = x + 0.5 + MaxOf(-3, MinOf(3, lvlNudge(k, 3))) / 8 : decoY(i) = y + 0.5 + MaxOf(-3, MinOf(3, lvlNudge(k, 4))) / 8 ' (up to 3 eighths: still in its cell)
            IF i THEN IF lvlNudge(k, 5) >= 1 AND lvlNudge(k, 5) <= 4 THEN decoFace(i) = lvlNudge(k, 5) ' (and standing flat, facing one way)
            IF i THEN IF lvlNudge(k, 5) = 5 THEN decoFace(i) = -1 ' (or turning to face you, wherever it stands - kept from the next part, then 0)
        END IF
    NEXT
    ' Furniture stands flat, its back to its wall: a terminal, a console, a
    ' rack, a locker... with no way of its own set ([nudges]) faces away from
    ' the wall behind it, into the room, as it would be built - it doesn't turn to follow you
    ' round the room. Round things (barrels, lamps, plants, tanks) still do,
    ' and so does anything standing in the open, with no wall to have its back to.
    ' (Unless its [nudges] say otherwise: a way of its own, 1-4, or 5 - turning to face you.)
    ' Chairs aren't on the list: they're 3D (ModelFacing turns one to its desk).
    FOR i = 1 TO numDecos
        IF decoFace(i) = -1 THEN decoFace(i) = 0 : _CONTINUE
        IF decoFace(i) = 0 AND INSTR("|4|6|7|10|11|12|14|15|16|18|19|", "|" + LTRIM$(STR$(decoKind(i))) + "|") THEN
            x = INT(decoX(i)) : y = INT(decoY(i))
            IF DecoWall(x - 1, y) AND NOT DecoWall(x + 1, y) THEN ' (a wall behind it, and open floor in front)
                decoFace(i) = 1
            ELSEIF DecoWall(x, y - 1) AND NOT DecoWall(x, y + 1) THEN
                decoFace(i) = 2
            ELSEIF DecoWall(x + 1, y) AND NOT DecoWall(x - 1, y) THEN
                decoFace(i) = 3
            ELSEIF DecoWall(x, y + 1) AND NOT DecoWall(x, y - 1) THEN
                decoFace(i) = 4
            END IF
        END IF
    NEXT
    FOR i = 1 TO numMonsters ' (turrets: a wall one set against its wall, pointing out of it; the rest pointing one of 8 ways, the same each time)
        IF monsterType(i) = MT_TURRET THEN
            turPrefX = 0 : turPrefY = 0 : IF monFrom(i) = TURRET_WALL THEN TurretMount i
            IF monFrom(i) <> TURRET_WALL THEN monAimA(i) = ((INT(monsterX(i)) * 7 + INT(monsterY(i)) * 13) MOD 8) * 0.78539816#
        END IF
    NEXT
    PlaceDroids level ' (and the droids: a few, about their business)
    ' Things that glow by themselves get a light of their own: lamps (cyan;
    ' every fourth one flickers), terminals (a faint green pulse), and the exit
    ' (green). A lamp or terminal's light belongs to it, so it goes out when
    ' it's broken.
    FOR i = 1 TO numDecos
        IF decoKind(i) = 2 THEN AddLight decoX(i), decoY(i), 4, 110, 190, 220, (i MOD 4 = 0) * -FX_FLICKER, i
        IF decoKind(i) = 4 THEN AddLight decoX(i), decoY(i), 2.5, 40, 90, 70, FX_PULSE, i
        IF decoKind(i) = 6 THEN AddLight decoX(i), decoY(i), 2.5, 30, 70, 160, FX_FLICKER, i ' Server racks: blinking cyan
        IF decoKind(i) = 7 THEN AddLight decoX(i), decoY(i), 3, 150, 50, 120, FX_STEADY, i ' Vending machines: pink neon
        IF decoKind(i) = 9 THEN AddLight decoX(i), decoY(i), 4, 130, 50, 180, FX_PULSE, i ' Spawners: a purple throb
        SELECT CASE decoKind(i) ' The set pieces that light up
            CASE 11 : AddLight decoX(i), decoY(i), 2.5, 50, 100, 90, FX_FLICKER, i ' Console: green-cyan
            CASE 12 : AddLight decoX(i), decoY(i), 3, 50, 80, 140, FX_FLICKER, i ' Monitors: blue
            CASE 13 : AddLight decoX(i), decoY(i), 3, 40, 140, 60, FX_PULSE, i ' Specimen: green
            CASE 15 : AddLight decoX(i), decoY(i), 3, 140, 100, 40, FX_FIRE, i ' Generator: orange
            CASE 16 : AddLight decoX(i), decoY(i), 2.5, 50, 110, 150, FX_STEADY, i ' Cryo pod: icy
            CASE 17 : AddLight decoX(i), decoY(i), 3.5, 40, 110, 170, FX_PULSE, i ' Hologram: blue
        END SELECT
    NEXT
    FOR y = 0 TO mapN - 1 : FOR x = 0 TO mapN - 1
        IF worldMap(x, y) = 2 AND doorType(x, y) = DOOR_EXIT THEN AddLight x + 0.5, y + 0.5, 3.5, 50, 160, 70, FX_PULSE, 0
    NEXT : NEXT
    ' Glowing liquids light the room round them: lava a firelight, slime and
    ' acid a faint sickly glow - one light for each 3 x 3 patch of it
    FOR gy = 0 TO mapN - 1 STEP 3 : FOR gx = 0 TO mapN - 1 STEP 3
        FOR k = LQ_SLIME TO LQ_ACID
            n = 0 : sx = 0 : sy = 0
            FOR y = gy TO MinOf(gy + 2, mapN - 1) : FOR x = gx TO MinOf(gx + 2, mapN - 1)
                IF INSTR(LQ_CHARS$, MID$(lvlLiqRow$(y), x + 1, 1)) = k THEN n = n + 1 : sx = sx + x + 0.5 : sy = sy + y + 0.5
            NEXT : NEXT
            IF n THEN
                n0 = numLights
                IF k = LQ_LAVA THEN AddLight sx / n, sy / n, 3.5, 150, 70, 20, FX_FIRE, 0 ELSE AddLight sx / n, sy / n, 2.5, lqR(k) \ 5, lqG(k) \ 5, lqB(k) \ 5, FX_PULSE, 0
                IF numLights > n0 THEN lightLow(numLights) = -1 ' (from below: no lamp, no beam)
            END IF
        NEXT
    NEXT : NEXT
    BuildLights ' Which cells each light reaches (now the walls are all in place)
    BuildShafts ' ...and which have a beam of light (chapter 24)
    AssignClosets ' (each secret wall: its closet, and its look)
    AssignGlass ' (which way each pane of glass runs)
    ' Every cell's floor and ceiling height ([floor] and [ceiling]); and you
    ' standing on your floor
    levelFlat = -1
    FOR y = 0 TO mapN - 1 : FOR x = 0 TO mapN - 1
        floorH(x, y) = HeightOf(MID$(lvlFloorRow$(y), x + 1, 1), 0) : ceilH(x, y) = HeightOf(MID$(lvlCeilRow$(y), x + 1, 1), 1)
        IF ceilH(x, y) < floorH(x, y) + 0.25 THEN ceilH(x, y) = floorH(x, y) + 0.25 ' (never through the floor)
        IF floorH(x, y) <> 0 OR ceilH(x, y) <> 1 THEN levelFlat = 0
    NEXT : NEXT
    ' The lifts: their cells start at their low height
    numLifts = 0
    FOR y = 0 TO MAP_SIZE : FOR x = 0 TO MAP_SIZE : liftCell(x, y) = 0 : NEXT : NEXT
    WorldLoopsOff ' (the last level's lifts' motors)
    FOR k = 1 TO lvlNumLifts
        numLifts = numLifts + 1
        liftX0(k) = MinOf(lvlLift(k, 1), lvlLift(k, 3)) : liftY0(k) = MinOf(lvlLift(k, 2), lvlLift(k, 4))
        liftX1(k) = MaxOf(lvlLift(k, 1), lvlLift(k, 3)) : liftY1(k) = MaxOf(lvlLift(k, 2), lvlLift(k, 4))
        liftLow(k) = lvlLift(k, 5) * H_STEP : liftHigh(k) = lvlLift(k, 6) * H_STEP : liftMode(k) = lvlLift(k, 7)
        liftSpeed(k) = lvlLift(k, 8) * H_STEP / 60 : IF liftSpeed(k) <= 0 THEN liftSpeed(k) = 0.01
        liftZ(k) = liftLow(k) : liftDir(k) = 0 : liftWait(k) = 60 : liftWasDir(k) = 0 : liftArm(k) = -1 : liftHit(k) = 0
        IF liftMode(k) = LIFT_CRUSHER OR liftMode(k) = LIFT_SMASHER THEN ' A crusher or smasher: its ceiling moves, from the top
            liftZ(k) = liftHigh(k)
            FOR y = liftY0(k) TO liftY1(k) : FOR x = liftX0(k) TO liftX1(k)
                IF x > 0 AND y > 0 AND x < mapN - 1 AND y < mapN - 1 THEN liftCell(x, y) = k : ceilH(x, y) = liftZ(k) : levelFlat = 0 : boxOn(x, y) = 0
            NEXT : NEXT
            _CONTINUE
        END IF
        lc = 99 ' (no higher than leaves you room under the lowest ceiling over it: else you'd ride up into it, and stick)
        FOR y = liftY0(k) TO liftY1(k) : FOR x = liftX0(k) TO liftX1(k)
            IF x > 0 AND y > 0 AND x < mapN - 1 AND y < mapN - 1 THEN lc = MinOf(lc, ceilH(x, y))
        NEXT : NEXT
        IF liftHigh(k) > lc - BODY_H THEN liftHigh(k) = MaxOf(liftLow(k), lc - BODY_H)
        FOR y = liftY0(k) TO liftY1(k) : FOR x = liftX0(k) TO liftX1(k)
            IF x > 0 AND y > 0 AND x < mapN - 1 AND y < mapN - 1 THEN liftCell(x, y) = k : floorH(x, y) = liftZ(k) : levelFlat = 0 : floorTex(x, y) = T_LIFT : floorSplit(x, y) = 0 : boxOn(x, y) = 0 ' (a lift's top: its own plate - MakeLiftTex; no block on it: it stands floor to ceiling, and the floor moves)
        NEXT : NEXT
    NEXT
    ' The liquids ([liquid], [liquid depth]): a pool on each open cell the map
    ' gives one (not a door, not a lift), its surface its depth above the floor.
    ' A level with any is drawn the heights way (levelFlat off: HeightColumn)
    liqAny = 0 : liqWas = 0 : poisonTint = 0
    FOR k = 1 TO LQ_KINDS : lqUsed(k) = 0 : NEXT
    FOR y = 0 TO MAP_SIZE : FOR x = 0 TO MAP_SIZE
        liqKind(x, y) = 0 : liqZ(x, y) = 0
        IF x < mapN AND y < mapN THEN
            k = INSTR(LQ_CHARS$, MID$(lvlLiqRow$(y), x + 1, 1))
            IF k AND worldMap(x, y) <= 0 AND liftCell(x, y) = 0 THEN
                d = VAL(MID$(lvlLiqDRow$(y), x + 1, 1)) : IF d < 1 OR d > 8 THEN d = LQ_DEPTH
                liqKind(x, y) = k : liqZ(x, y) = floorH(x, y) + d * H_STEP : liqAny = -1 : levelFlat = 0 : lqUsed(k) = -1
            END IF
        END IF
    NEXT : NEXT
    ' The triggers, taken apart; the teleporters' pads, glowing
    numTrigs = 0
    FOR k = 1 TO lvlNumTrigs : TakeTrigger lvlTrig$(k) : NEXT
    IF lvlNumPairs THEN ' Pads paired by hand ([pads]) first, in their pairs; the rest after, in reading order
        REDIM pOX(MAX_PADS) AS INTEGER, pOY(MAX_PADS) AS INTEGER, pUsed(MAX_PADS) AS INTEGER
        FOR k = 1 TO numPads : pOX(k) = padX(k) : pOY(k) = padY(k) : pUsed(k) = 0 : NEXT
        n = 0
        FOR j = 1 TO lvlNumPairs
            a = 0 : b = 0
            FOR k = 1 TO numPads
                IF NOT pUsed(k) AND pOX(k) = lvlPair(j, 1) AND pOY(k) = lvlPair(j, 2) THEN a = k
                IF NOT pUsed(k) AND pOX(k) = lvlPair(j, 3) AND pOY(k) = lvlPair(j, 4) THEN b = k
            NEXT
            IF a > 0 AND b > 0 AND a <> b THEN pUsed(a) = -1 : pUsed(b) = -1 : n = n + 1 : padX(n) = pOX(a) : padY(n) = pOY(a) : n = n + 1 : padX(n) = pOX(b) : padY(n) = pOY(b)
        NEXT
        FOR k = 1 TO numPads
            IF NOT pUsed(k) THEN n = n + 1 : padX(n) = pOX(k) : padY(n) = pOY(k)
        NEXT
    END IF
    FOR k = 1 TO numPads : AddLight padX(k) + 0.5, padY(k) + 0.5, 2.5, 120, 60, 220, FX_PULSE, 0 : NEXT
    numLightsBase = numLights ' (the level's own lights, pads' included: what a save lists - LiquidGlows' come after)
    padReady = 0
    IF NOT editRebuild THEN playerZ = floorH(INT(playerX), INT(playerY)) : playerVZ = 0 : eyeZ = playerZ + EYE_H
    walkZ = -999
    BuildThiefWay ' (the thieves' way home)
    AssignSecrets ' (the secret walls, the closets' stashes, and what the map pickup leaves out)
    blackoutTimer = 0
    monStartN = numMonsters ' (the level's monsters as they start, for the console's respawn)
    FOR i = 1 TO numMonsters : monStartX(i) = monsterX(i) : monStartY(i) = monsterY(i) : monStartType(i) = monsterType(i) : NEXT
    ' The camera plane (chapter 8): your direction turned 90 degrees, fovPlane long
    planeX = -dirY * fovPlane : planeY = dirX * fovPlane
    aimAmount = 0 : zoom = 1 : viewH = RENDER_H
    kills = 0 : dead = 0 : swapTimer = 0
    hurtFlash = 0 : pickFlash = 0 : muzzleFlash = 0 : recoil = 0 : railBeam = 0
    fireWait = 20 ' (so the click that started the level doesn't fire)
    bobPhase = 2.2 ' The first footstep sounds soon after you start walking (a foot lands at pi)
    levelStart! = TIMER : frameAt! = TIMER : shake = 0 : hurtFromX = -1 : lvFrame = 0
    FOR i = 1 TO MAX_HURTDIRS : hurtDirTime(i) = 0 : NEXT
    IF NOT editRebuild THEN PlayMusic SectorMusic&(level) : ShowMsg levelName$ + "  -  find the EXIT"
    ListDoors
    ' (built again in the editor: OpenGL's turn now - new pictures if any,
    ' and the world again. Only now: SUB _GL runs alongside this, and asked
    ' halfway through it would build half a level)
    IF editRebuild THEN
        IF texNew THEN glRetexVersion = glRetexVersion + 1
        glMeshVersion = glMeshVersion + 1
    END IF

END SUB
