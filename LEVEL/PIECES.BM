''
' NEON-CASTER - LEVEL/PIECES.BM
' =============================================================================
' Pieces (LEVEL/PIECES.BI): a face's tree of pieces read, written, divided,
' joined - and built for the renderers.
'

' The rectangles of tree shape$'s pieces, in order, into pcRU0.. (u
' across, v down, 0 to 1): how many - or -1 if it isn't a tree (pieces
' left over or missing, a letter it doesn't know, finer than PC_DEPTH)
FUNCTION PcRects(shape$)
    DIM c$, i, m, n, sp, u0, u1, v0, v1 ' (its own: the main program shares these names)
    DIM su0(24), sv0(24), su1(24), sv1(24)
    n = 0 : sp = 1 : su0(1) = 0 : sv0(1) = 0 : su1(1) = 1 : sv1(1) = 1
    FOR i = 1 TO LEN(shape$)
        IF sp = 0 THEN PcRects = -1 : EXIT FUNCTION ' (more after the tree's done)
        u0 = su0(sp) : v0 = sv0(sp) : u1 = su1(sp) : v1 = sv1(sp) : sp = sp - 1
        c$ = MID$(shape$, i, 1)
        SELECT CASE c$
            CASE "H", "V"
                IF (u1 - u0) * (v1 - v0) < 2 / 2 ^ PC_DEPTH - 0.0001 OR sp > 20 THEN PcRects = -1 : EXIT FUNCTION
                IF c$ = "H" THEN ' (the second half pushed first: the first comes off next)
                    m = (u0 + u1) / 2
                    sp = sp + 1 : su0(sp) = m : sv0(sp) = v0 : su1(sp) = u1 : sv1(sp) = v1
                    sp = sp + 1 : su0(sp) = u0 : sv0(sp) = v0 : su1(sp) = m : sv1(sp) = v1
                ELSE
                    m = (v0 + v1) / 2
                    sp = sp + 1 : su0(sp) = u0 : sv0(sp) = m : su1(sp) = u1 : sv1(sp) = v1
                    sp = sp + 1 : su0(sp) = u0 : sv0(sp) = v0 : su1(sp) = u1 : sv1(sp) = m
                END IF
            CASE "."
                n = n + 1 : IF n > PC_LEAF THEN PcRects = -1 : EXIT FUNCTION
                pcRU0(n) = u0 : pcRV0(n) = v0 : pcRU1(n) = u1 : pcRV1(n) = v1
            CASE ELSE
                PcRects = -1 : EXIT FUNCTION
        END SELECT
    NEXT
    IF sp <> 0 OR n = 0 THEN PcRects = -1 ELSE PcRects = n
END FUNCTION

' The piece of tree shape$ at (u, v) on its face (u across, v down, 0 to
' 1): 1... (0: not a tree)
FUNCTION PcLeafAt(shape$, u, v)
    DIM j, n, uu, vv ' (its own: the main program shares these names)
    n = PcRects(shape$) : IF n < 1 THEN EXIT FUNCTION
    uu = MaxOf(0, MinOf(0.99999, u)) : vv = MaxOf(0, MinOf(0.99999, v))
    FOR j = 1 TO n
        IF uu >= pcRU0(j) AND uu < pcRU1(j) AND vv >= pcRV0(j) AND vv < pcRV1(j) THEN PcLeafAt = j : EXIT FUNCTION
    NEXT
    PcLeafAt = 1
END FUNCTION

' Where in shape$ its piece j is (the j-th .): 0 none
FUNCTION PcDotPos(shape$, j)
    DIM i, n ' (its own: the main program shares these names)
    FOR i = 1 TO LEN(shape$)
        IF MID$(shape$, i, 1) = "." THEN n = n + 1 : IF n = j THEN PcDotPos = i : EXIT FUNCTION
    NEXT
END FUNCTION

' Piece a's look onto piece b (the tree being worked on)
SUB PcCopyLeaf(a, b)
    ptPic$(b) = ptPic$(a) : ptRot(b) = ptRot(a) : ptO(b) = ptO(a) : ptK(b) = ptK(a)
    ptTM(b) = ptTM(a) : ptTA(b) = ptTA(a) : ptTC(b) = ptTC(a) : ptA(b) = ptA(a) : ptFx$(b) = ptFx$(a)
END SUB
SUB PcClearLeaf(j)
    ptPic$(j) = "" : ptRot(j) = 0 : ptO(j) = 0 : ptK(j) = 0 : ptTM(j) = 0 : ptTA(j) = 50 : ptTC(j) = &HFFFFFF : ptA(j) = 0 : ptFx$(j) = ""
END SUB

' Piece j as text: picture*turn*slide*stretch*tint*amount*colour*start -
' left off from the end as far as it's as made
FUNCTION PcLeafText$(j)
    DIM i, last, t$ ' (its own: the main program shares these names)
    DIM f$(9)
    f$(1) = ptPic$(j) : f$(2) = LTRIM$(STR$(ptRot(j))) : f$(3) = LTRIM$(STR$(ptO(j))) : f$(4) = LTRIM$(STR$(ptK(j)))
    f$(5) = LTRIM$(STR$(ptTM(j))) : f$(6) = LTRIM$(STR$(ptTA(j))) : f$(7) = RIGHT$("00000" + HEX$(ptTC(j) AND &HFFFFFF), 6) : f$(8) = LTRIM$(STR$(ptA(j))) : f$(9) = ptFx$(j)
    last = 1
    IF ptRot(j) THEN last = 2
    IF ptO(j) THEN last = 3
    IF ptK(j) THEN last = 4
    IF ptTM(j) THEN last = 7
    IF ptA(j) THEN last = 8
    IF LEN(ptFx$(j)) THEN last = 9
    t$ = f$(1)
    FOR i = 2 TO last : t$ = t$ + "*" + f$(i) : NEXT
    PcLeafText$ = t$
END FUNCTION

' ...and back, into piece j
SUB PcLeafRead(s$, j)
    DIM c, i, f$, t$ ' (its own: the main program shares these names)
    PcClearLeaf j
    t$ = s$ + "*" : i = 0
    DO
        c = INSTR(t$, "*") : IF c = 0 THEN EXIT DO
        f$ = LEFT$(t$, c - 1) : t$ = MID$(t$, c + 1) : i = i + 1
        SELECT CASE i
            CASE 1 : ptPic$(j) = LTRIM$(RTRIM$(f$))
            CASE 2 : ptRot(j) = VAL(f$) AND 7 ' (4 and up: flipped left for right first)
            CASE 3 : ptO(j) = VAL(f$) AND 4095
            CASE 4 : ptK(j) = VAL(f$) : IF ptK(j) < 0 THEN ptK(j) = 0
            CASE 5 : ptTM(j) = MaxOf(0, MinOf(3, VAL(f$)))
            CASE 6 : ptTA(j) = MaxOf(0, MinOf(100, VAL(f$)))
            CASE 7 : IF LEN(f$) THEN ptTC(j) = PcHex~&(f$)
            CASE 8 : ptA(j) = MaxOf(0, MinOf(2, VAL(f$)))
            CASE 9 : ptFx$(j) = PcFxClean$(f$)
        END SELECT
    LOOP
END SUB

' A colour as RRGGBB (hex digits; anything else counts 0)
FUNCTION PcHex~&(h$)
    DIM c, i, v AS _UNSIGNED LONG ' (its own: the main program shares these names)
    v = 0
    FOR i = 1 TO MinOf(6, LEN(h$))
        c = INSTR("0123456789ABCDEF", UCASE$(MID$(h$, i, 1))) - 1 : IF c < 0 THEN c = 0
        v = v * 16 + c
    NEXT
    PcHex~& = v
END FUNCTION

' A face's tree from its [faces] line (division d, pictures p1$ and p2$,
' slide o and stretch k&) into ptShape$, ptN and the pieces: whole, halved
' (both halves slid and stretched as the face) or, 3, its own tree
SUB PcTreeRead(d, p1$, p2$, o, k&)
    DIM c, j, t$ ' (its own: the main program shares these names)
    SELECT CASE d
        CASE 1 : ptShape$ = "H.." : ptN = 2
        CASE 2 : ptShape$ = "V.." : ptN = 2
        CASE 3
            ptShape$ = p1$ : ptN = PcRects(p1$)
            IF ptN < 1 THEN ptShape$ = "." : ptN = 1 ' (not a tree: whole)
        CASE ELSE : ptShape$ = "." : ptN = 1
    END SELECT
    FOR j = 1 TO ptN
        PcClearLeaf j
        IF d <> 3 THEN ptO(j) = o : ptK(j) = k&
    NEXT
    IF d = 3 THEN
        t$ = p2$ + "|"
        FOR j = 1 TO ptN
            c = INSTR(t$, "|") : IF c = 0 THEN EXIT FOR
            PcLeafRead LEFT$(t$, c - 1), j : t$ = MID$(t$, c + 1)
        NEXT
    ELSE
        ptPic$(1) = p1$ : IF ptN = 2 THEN ptPic$(2) = p2$
    END IF
END SUB

' ...and the tree back as a [faces] line's numbers: the old line where it
' can be (whole or halved, nothing turned or tinted, every piece slid and
' stretched alike), else division 3
SUB PcTreeForm(d, p1$, p2$, o, k&)
    DIM j, simple, t$ ' (its own: the main program shares these names)
    simple = (ptShape$ = "." OR ptShape$ = "H.." OR ptShape$ = "V..")
    FOR j = 1 TO ptN
        IF ptRot(j) OR ptTM(j) OR ptA(j) OR LEN(ptFx$(j)) THEN simple = 0
        IF ptO(j) <> ptO(1) OR ptK(j) <> ptK(1) THEN simple = 0
    NEXT
    IF simple THEN
        o = ptO(1) : k& = ptK(1) : p1$ = ptPic$(1) : p2$ = "" : d = 0
        IF ptShape$ = "H.." THEN d = 1 ELSE IF ptShape$ = "V.." THEN d = 2
        IF d THEN p2$ = ptPic$(2)
    ELSE
        d = 3 : o = 0 : k& = 0 : p1$ = ptShape$ : t$ = ""
        FOR j = 1 TO ptN
            IF j > 1 THEN t$ = t$ + "|"
            t$ = t$ + PcLeafText$(j)
        NEXT
        p2$ = t$
    END IF
END SUB

' Piece j divided (dir$ "H" left | right, "V" top | bottom), both halves
' with its look: TRUE if it could be (not past PC_DEPTH, PC_LEAF pieces)
FUNCTION PcSplit(j, dir$)
    DIM i, n, p ' (its own: the main program shares these names)
    n = PcRects(ptShape$) : IF j < 1 OR j > n OR n >= PC_LEAF THEN EXIT FUNCTION
    IF (pcRU1(j) - pcRU0(j)) * (pcRV1(j) - pcRV0(j)) < 2 / 2 ^ PC_DEPTH - 0.0001 THEN EXIT FUNCTION
    p = PcDotPos(ptShape$, j) : IF p = 0 THEN EXIT FUNCTION
    ptShape$ = LEFT$(ptShape$, p - 1) + dir$ + ".." + MID$(ptShape$, p + 1)
    FOR i = ptN TO j + 1 STEP -1 : PcCopyLeaf i, i + 1 : NEXT
    PcCopyLeaf j, j + 1 : ptN = ptN + 1
    PcSplit = -1
END FUNCTION

' Piece j and the rest of what was divided with it made one piece again,
' with piece j's look: its number now (0: the face is whole already)
FUNCTION PcJoin(j)
    DIM c$, i, l1, l2, n, p, q, sp ' (its own: the main program shares these names)
    DIM par(40), en(40), stP(24), stR(24)
    p = PcDotPos(ptShape$, j) : IF p = 0 THEN EXIT FUNCTION
    sp = 0
    FOR i = 1 TO LEN(ptShape$) ' (each node's parent, and where its part of the tree ends)
        IF sp THEN par(i) = stP(sp) ELSE par(i) = 0
        c$ = MID$(ptShape$, i, 1)
        IF c$ = "." THEN
            en(i) = i
            DO WHILE sp > 0
                stR(sp) = stR(sp) - 1
                IF stR(sp) = 0 THEN en(stP(sp)) = i : sp = sp - 1 ELSE EXIT DO
            LOOP
        ELSE
            sp = sp + 1 : stP(sp) = i : stR(sp) = 2
        END IF
    NEXT
    q = par(p) : IF q = 0 THEN EXIT FUNCTION
    l1 = 1 : l2 = 0
    FOR i = 1 TO en(q)
        IF MID$(ptShape$, i, 1) = "." THEN
            l2 = l2 + 1 : IF i < q THEN l1 = l1 + 1
        END IF
    NEXT
    PcCopyLeaf j, l1
    n = l2 - l1
    FOR i = l1 + 1 TO ptN - n : PcCopyLeaf i + n, i : NEXT
    ptN = ptN - n
    ptShape$ = LEFT$(ptShape$, q - 1) + "." + MID$(ptShape$, en(q) + 1)
    PcJoin = l1
END FUNCTION

' How deep piece j is (0: the face whole) - for "as fine as it goes"
FUNCTION PcDepth(j)
    DIM a ' (its own: the main program shares these names)
    IF PcRects(ptShape$) < j THEN EXIT FUNCTION
    a = (pcRU1(j) - pcRU0(j)) * (pcRV1(j) - pcRV0(j))
    PcDepth = CINT(LOG(1 / a) / LOG(2))
END FUNCTION

' The piece at (u, v) of face p's grid (u across, v down, 0 to 1)
FUNCTION PcAt(p, u, v)
    DIM gu, gv ' (its own: the main program shares these names)
    gu = INT(u * 16) : IF gu < 0 THEN gu = 0 ELSE IF gu > 15 THEN gu = 15
    gv = INT(v * 16) : IF gv < 0 THEN gv = 0 ELSE IF gv > 15 THEN gv = 15
    PcAt = pcGrid(p, gu + 16 * gv)
END FUNCTION

' A floor's or ceiling's texel at map point (fx, fy) of cell (cx, cy), when
' it's in pieces (p): its piece's picture (deflt, the usual, if it has
' none of its own), slid and stretched as that piece is - from the map's
' grid, or (pcAn) from the piece's own corner
FUNCTION PcFlatTexel~&(p, fx, fy, cx, cy, deflt)
    DIM lf AS INTEGER, sl AS INTEGER, su, sv, gu AS LONG, gv AS LONG, au, av ' (its own: the main program shares these names)
    gu = INT((fx - cx) * 16) : IF gu < 0 THEN gu = 0 ELSE IF gu > 15 THEN gu = 15
    gv = INT((fy - cy) * 16) : IF gv < 0 THEN gv = 0 ELSE IF gv > 15 THEN gv = 15
    lf = pcGrid(p, gu + 16 * gv) : sl = pcSl(p, lf) : IF sl = 0 THEN sl = deflt
    su = texSize : sv = texSize
    IF pcKU(p, lf) THEN su = texSize * 100 / pcKU(p, lf)
    IF pcKV(p, lf) THEN sv = texSize * 100 / pcKV(p, lf)
    au = 0 : av = 0
    IF pcAn(p, lf) THEN
        au = cx + pcGU0(p, lf) / 16 : av = cy + pcGV0(p, lf) / 16
        IF pcAn(p, lf) = 2 THEN su = su * 16 / MaxOf(1, pcGU1(p, lf) - pcGU0(p, lf)) : sv = sv * 16 / MaxOf(1, pcGV1(p, lf) - pcGV0(p, lf))
    END IF
    PcFlatTexel~& = texture((INT((fx - au) * su) + pcOU(p, lf) * texSize \ 64) AND (texSize - 1), (INT((fy - av) * sv) + pcOV(p, lf) * texSize \ 64) AND (texSize - 1), sl)
END FUNCTION

' Where along face f of cell (x, y) its picture's u is, at s across it (0
' to 1, as the pieces' grid): a block's side is only as wide as the block
' - its picture's place there is the cell's (as BoxFaceU, turned round)
FUNCTION PcPicU(x, y, f, s)
    DIM lo, hi ' (its own: the main program shares these names)
    PcPicU = s
    IF f <= FACE_BOX OR f > FACE_BOX + 4 THEN EXIT FUNCTION
    IF x < 0 OR y < 0 OR x >= mapN OR y >= mapN THEN EXIT FUNCTION
    SELECT CASE f - FACE_BOX
        CASE 1 : lo = 1 - boxY1(x, y) : hi = 1 - boxY0(x, y)
        CASE 2 : lo = boxX0(x, y) : hi = boxX1(x, y)
        CASE 3 : lo = boxY0(x, y) : hi = boxY1(x, y)
        CASE ELSE : lo = 1 - boxX1(x, y) : hi = 1 - boxX0(x, y)
    END SELECT
    PcPicU = lo + s * (hi - lo)
END FUNCTION

' The picture face f of cell (x, y) has when it has none of its own - its
' slot (for a turned or tinted copy of it). Read from the level's own
' characters: BuildLevel calls it before the map's built.
FUNCTION PcUsual(x, y, f)
    DIM c$, k ' (its own: the main program shares these names)
    PcUsual = 1
    SELECT CASE f
        CASE 1 TO 4
            c$ = MID$(lvlRow$(y), x + 1, 1)
            IF INSTR("#NCKPG", c$) THEN PcUsual = INSTR("#NCKPG", c$)
            IF c$ = "@" THEN PcUsual = T_JACK
            IF c$ = "$" THEN PcUsual = T_CODE
            IF c$ = "E" THEN PcUsual = T_EXIT
            IF INSTR("DRBYHX!", c$) THEN PcUsual = PcDoorUsual(x, y, c$) ' (a door's own)
            IF INSTR("#NCKPG@$EDRBYHX!%?;/\", c$) = 0 THEN IF PcLiftAt(x, y) THEN PcUsual = T_LIFTSIDE ' (an open cell's side, a step's: a lift's side)
            IF c$ = "/" OR c$ = "\" THEN PcUsual = PcDiagUsual(x, y) ' (a diagonal's straight sides)
        CASE 9 : PcUsual = floorTex(x, y)
        CASE 10 : PcUsual = ceilTex(x, y)
        CASE FACE_DIAG : PcUsual = PcDiagUsual(x, y)
        CASE FACE_DEDGE ' (a door's edges: its own picture)
            c$ = MID$(lvlRow$(y), x + 1, 1)
            IF INSTR("DRBYHX!", c$) THEN PcUsual = PcDoorUsual(x, y, c$)
        CASE FACE_TRACK : PcUsual = T_SHUTTER ' (a door's track)
        CASE FACE_BOX + 1 TO FACE_BOX + 4
            FOR k = 1 TO lvlNumBoxes
                IF lvlBox(k, 1) = x AND lvlBox(k, 2) = y THEN IF lvlBox(k, 7) >= 1 AND lvlBox(k, 7) <= 6 THEN PcUsual = lvlBox(k, 7)
            NEXT
    END SELECT
END FUNCTION

' A diagonal wall's picture: a wall's beside it (as BuildLevel gives it the
' look of the wall by its solid half - read here from the map's
' characters, before that's worked out), else the second wall's
FUNCTION PcDiagUsual(x, y)
    DIM c$, k, nx, ny ' (its own: the main program shares these names)
    PcDiagUsual = 2
    FOR k = 1 TO 4
        nx = x : ny = y
        SELECT CASE k
            CASE 1 : ny = y - 1
            CASE 2 : ny = y + 1
            CASE 3 : nx = x - 1
            CASE ELSE : nx = x + 1
        END SELECT
        IF nx >= 0 AND ny >= 0 AND nx < mapN AND ny < mapN THEN
            c$ = MID$(lvlRow$(ny), nx + 1, 1)
            IF INSTR("#NCKPG", c$) THEN PcDiagUsual = INSTR("#NCKPG", c$) : EXIT FUNCTION
        END IF
    NEXT
END FUNCTION

' Is cell (x, y) on a lift that rises (not a crusher)? From the level's
' [lifts] - BuildLevel asks before the lifts are built
FUNCTION PcLiftAt(x, y)
    DIM k ' (its own: the main program shares these names)
    PcLiftAt = 0
    FOR k = 1 TO lvlNumLifts
        IF lvlLift(k, 7) <> LIFT_CRUSHER AND lvlLift(k, 7) <> LIFT_SMASHER THEN
            IF x >= MinOf(lvlLift(k, 1), lvlLift(k, 3)) AND x <= MaxOf(lvlLift(k, 1), lvlLift(k, 3)) AND y >= MinOf(lvlLift(k, 2), lvlLift(k, 4)) AND y <= MaxOf(lvlLift(k, 2), lvlLift(k, 4)) THEN PcLiftAt = -1 : EXIT FUNCTION
        END IF
    NEXT
END FUNCTION

' A door's picture (as DoorSlot has it, once it's built) from its map
' character and its [doors] line: a stronghold's, a keypad's, a keycard's,
' a shutter's, a split door's - or the plain door's. (A keypad's code of ?
' is made up later: only whether it has one is read here.)
FUNCTION PcDoorUsual(x, y, c$)
    DIM k, c2$ ' (its own: the main program shares these names)
    SELECT CASE c$
        CASE "H" : PcDoorUsual = T_SHUTTER
        CASE "X" : PcDoorUsual = T_SPLIT
        CASE ELSE
            PcDoorUsual = T_DOOR : IF INSTR("RBY", c$) THEN PcDoorUsual = T_DOORK + INSTR("RBY", c$)
            k = XtraFind("doors", x, y, 0)
            IF k THEN
                c2$ = LTRIM$(RTRIM$(XtraField$(k, 4)))
                IF VAL(XtraField$(k, 3)) > 0 THEN
                    PcDoorUsual = T_STRONG
                ELSEIF c2$ = "?" OR (LEN(c2$) <= PAD_DIGITS AND VAL(c2$) <> 0) THEN ' (CodeOf&'s rule)
                    PcDoorUsual = T_KEYPAD
                END IF
            END IF
    END SELECT
END FUNCTION

' A face picture's slot, want$ by name: kind 0 a picture file (loaded),
' 1 a turned or tinted copy (MakePieceTex), 2 a light's tinted copy
' (MakeGlowTex) - 0: none free, or no such file. A picture already in a
' face slot stays there: the editor's rebuilds (every change) find it
' where it was, so only a picture new to the sector is loaded or made -
' and only that slot is sent to OpenGL again (texDirty, GLSendDirty).
' texUsed: the slots this sector uses (BuildLevel clears it first);
' customN: the highest of them.
FUNCTION PcSlotFor(want$, kind, customN, facesFull, texNew)
    DIM j, slot ' (its own: the main program shares these names)
    slot = 0
    FOR j = T_CUSTOM + 1 TO T_CUSTOM + T_CUSTOMN
        IF texFile$(j) = want$ THEN slot = j : EXIT FOR
    NEXT
    IF slot = 0 THEN
        IF kind = 0 THEN IF NOT GenPic(want$) AND NOT _FILEEXISTS(ArtPath$(want$)) THEN PcSlotFor = 0 : EXIT FUNCTION
        slot = PcFreeSlot
        IF slot = 0 THEN facesFull = -1 : PcSlotFor = 0 : EXIT FUNCTION
        PcForget slot
        texFile$(slot) = want$ : texNew = -1 : texDirty(slot) = -1
        SELECT CASE kind
            CASE 1 : MakePieceTex slot
            CASE 2 : MakeGlowTex slot
            CASE ELSE : LoadTex want$, slot
        END SELECT
    END IF
    texUsed(slot - T_CUSTOM) = -1 : IF slot - T_CUSTOM > customN THEN customN = slot - T_CUSTOM
    PcSlotFor = slot
END FUNCTION

' A face slot for a picture new to the sector: an empty one, else one
' holding a picture it no longer uses (0: every one in use)
FUNCTION PcFreeSlot
    DIM j ' (its own)
    PcFreeSlot = 0
    FOR j = 1 TO T_CUSTOMN
        IF NOT texUsed(j) AND texFile$(T_CUSTOM + j) = "" THEN PcFreeSlot = T_CUSTOM + j : EXIT FUNCTION
    NEXT
    FOR j = 1 TO T_CUSTOMN
        IF NOT texUsed(j) THEN PcFreeSlot = T_CUSTOM + j : EXIT FUNCTION
    NEXT
END FUNCTION

' Face slot sl about to take another picture: the unused copies made from
' what it held (pc:sl:... glow:sl:...) go too - they'd be made from the
' wrong picture if ART or a reload remade them
SUB PcForget(sl)
    DIM j, a$, b$ ' (its own)
    IF texFile$(sl) = "" THEN EXIT SUB
    a$ = "pc:" + LTRIM$(STR$(sl)) + ":" : b$ = "glow:" + LTRIM$(STR$(sl)) + ":"
    FOR j = 1 TO T_CUSTOMN
        IF NOT texUsed(j) THEN
            IF LEFT$(texFile$(T_CUSTOM + j), LEN(a$)) = a$ OR LEFT$(texFile$(T_CUSTOM + j), LEN(b$)) = b$ THEN texFile$(T_CUSTOM + j) = ""
        END IF
    NEXT
END SUB

' Face f of cell (x, y) in pieces ([faces] line k, division 3), built:
' one of pcN - its grid, and each piece's slot, slide and stretch. The
' renderers find it by faceDiv 3 (faceTex its number) - a floor or
' ceiling by its split 7 (floorTex2 / ceilTex2 its number).
SUB PcBuild(x, y, f, k, customN, facesFull, texNew)
    DIM dflt, gu, gv, j, n, p, sl, ku, kv ' (its own: the main program shares these names)
    PcTreeRead 3, lvlFaceP1$(k), lvlFaceP2$(k), 0, 0
    IF pcN >= PC_MAX THEN facesFull = -1 : EXIT SUB
    n = PcRects(ptShape$) : IF n < 1 THEN EXIT SUB
    pcN = pcN + 1 : p = pcN : dflt = PcUsual(x, y, f) : pcNL(p) = n
    FOR j = 1 TO n
        sl = 0
        IF ptPic$(j) <> "" THEN sl = PcSlotFor(ptPic$(j), 0, customN, facesFull, texNew)
        IF ptRot(j) OR ptTM(j) OR LEN(ptFx$(j)) THEN ' (turned, tinted or filtered: a copy of its own)
            IF sl = 0 THEN sl = dflt
            sl = PcSlotFor("pc:" + LTRIM$(STR$(sl)) + ":" + LTRIM$(STR$(ptRot(j))) + ":" + LTRIM$(STR$(ptTM(j))) + ":" + LTRIM$(STR$(ptTA(j))) + ":" + HEX$(ptTC(j)) + ":" + ptFx$(j) + ":" + texFile$(sl), 1, customN, facesFull, texNew)
        END IF
        pcSl(p, j) = sl
        pcOU(p, j) = ptO(j) AND 63 : pcOV(p, j) = (ptO(j) \ 64) AND 63
        ku = ptK(j) AND 2047 : kv = ptK(j) \ 2048
        IF ku = 100 THEN ku = 0
        IF kv = 100 THEN kv = 0
        pcKU(p, j) = ku : pcKV(p, j) = kv : pcAn(p, j) = ptA(j)
        pcGU0(p, j) = INT(pcRU0(j) * 16 + 0.001) : pcGV0(p, j) = INT(pcRV0(j) * 16 + 0.001) : pcGU1(p, j) = INT(pcRU1(j) * 16 + 0.001) : pcGV1(p, j) = INT(pcRV1(j) * 16 + 0.001)
        FOR gv = INT(pcRV0(j) * 16 + 0.001) TO INT(pcRV1(j) * 16 + 0.001) - 1
            FOR gu = INT(pcRU0(j) * 16 + 0.001) TO INT(pcRU1(j) * 16 + 0.001) - 1
                pcGrid(p, gu + 16 * gv) = j
            NEXT
        NEXT
    NEXT
    SELECT CASE f
        CASE 9 : floorTex2(x, y) = p : floorSplit(x, y) = 7
        CASE 10 : ceilTex2(x, y) = p : ceilSplit(x, y) = 7
        CASE 1 TO 8, FACE_BOX + 1 TO FACE_MAX
            faceTex(x, y, f) = p : faceTex2(x, y, f) = 0 : faceDiv(x, y, f) = 3 : faceAny = -1
            faceOU(x, y, f) = 0 : faceOV(x, y, f) = 0 : faceKU(x, y, f) = 0 : faceKV(x, y, f) = 0
    END SELECT
END SUB

' --- FILTERS: a piece's picture changed as a whole, before it's turned and
' tinted (MakePieceTex; the presets' thumbnails too). fx$ is letters each
' with its number (LEVEL/PIECES.BI); PC_FX$ is their order.

' Filter l$'s number in fx$ (0: not there)
FUNCTION PcFxGet(fx$, l$)
    DIM c, e ' (its own: the main program shares these names)
    PcFxGet = 0
    c = INSTR(UCASE$(fx$), UCASE$(l$)) : IF c = 0 THEN EXIT FUNCTION
    e = c + 1
    DO WHILE e <= LEN(fx$)
        IF INSTR("-0123456789", MID$(fx$, e, 1)) = 0 THEN EXIT DO
        e = e + 1
    LOOP
    IF e = c + 1 THEN PcFxGet = 1 ELSE PcFxGet = VAL(MID$(fx$, c + 1, e - c - 1)) ' (a letter alone: 1)
END FUNCTION

' Filter l$'s number kept within its range
FUNCTION PcFxClamp(l$, v)
    DIM w ' (its own: the main program shares these names)
    w = INT(v)
    SELECT CASE UCASE$(l$)
        CASE "X" : IF w <> 0 THEN w = MaxOf(2, MinOf(64, w))
        CASE "L", "R", "E" : w = MaxOf(0, MinOf(4, w))
        CASE "B", "C", "S" : w = MaxOf(-100, MinOf(100, w))
        CASE "H" : w = ((w MOD 360) + 540) MOD 360 - 180 : IF w = -180 THEN w = 180
        CASE "P" : IF w <> 0 THEN w = MaxOf(2, MinOf(32, w))
        CASE "I", "F", "M", "N" : w = -(w <> 0)
    END SELECT
    PcFxClamp = w
END FUNCTION

' fx$ with filter l$ set to v (0 takes it off) - always in PC_FX$'s order,
' so the same filters are the same text (one picture slot between them)
FUNCTION PcFxSet$(fx$, l$, v)
    DIM i, n, t$, c$ ' (its own: the main program shares these names)
    FOR i = 1 TO LEN(PC_FX$)
        c$ = MID$(PC_FX$, i, 1)
        IF c$ = UCASE$(l$) THEN n = v ELSE n = PcFxGet(fx$, c$)
        n = PcFxClamp(c$, n)
        IF n <> 0 THEN
            IF INSTR("IFMN", c$) THEN t$ = t$ + c$ ELSE t$ = t$ + c$ + LTRIM$(STR$(n))
        END IF
    NEXT
    PcFxSet$ = t$
END FUNCTION

' fx$ as read from a file: in order, in range, nothing else
FUNCTION PcFxClean$(fx$)
    PcFxClean$ = PcFxSet$(fx$, "?", 0)
END FUNCTION

' The filters in words: "BLUR 2, BRIGHT +20, INVERTED"
FUNCTION PcFxName$(fx$)
    DIM i, n, t$, c$, w$ ' (its own: the main program shares these names)
    FOR i = 1 TO LEN(PC_FX$)
        c$ = MID$(PC_FX$, i, 1) : n = PcFxGet(fx$, c$)
        IF n THEN
            w$ = PcFxWord$(c$)
            SELECT CASE c$
                CASE "I" : w$ = "INVERTED"
                CASE "F" : w$ = "NO BUMPS"
                CASE "M" : w$ = "NO SHINE"
                CASE "N" : w$ = "NO NEON"
                CASE "B", "C", "S", "H" : IF n > 0 THEN w$ = w$ + " +" + LTRIM$(STR$(n)) ELSE w$ = w$ + STR$(n)
                CASE ELSE : w$ = w$ + STR$(n)
            END SELECT
            IF LEN(t$) THEN t$ = t$ + ", "
            t$ = t$ + w$
        END IF
    NEXT
    PcFxName$ = t$
END FUNCTION

' A filter's name
FUNCTION PcFxWord$(l$)
    DIM i ' (its own: the main program shares these names)
    i = INSTR(PC_FX$, UCASE$(l$)) : IF i = 0 THEN EXIT FUNCTION
    PcFxWord$ = RTRIM$(MID$("PIXELATE  BLUR      SHARPEN   EMBOSS    BRIGHT    CONTRAST  SATURATE  HUE       POSTERIZE INVERT    NO BUMPS  NO SHINE  NO NEON   ", i * 10 - 9, 10))
END FUNCTION

' The filters fx$ on picture b() - n x n, row by row (y * n + x), opaque
' colours - in place. Sizes are as parts of the picture, so CLASSIC's 128
' and MODERN's 512 look alike: a blur of 1 is a 128th across.
SUB PcFxApply(b() AS _UNSIGNED LONG, n AS LONG, fx$)
    DIM i AS LONG, x AS LONG, y AS LONG, xx AS LONG, yy AS LONG, k AS LONG, s AS LONG, d AS LONG, m AS LONG, bs AS LONG, cnt AS LONG
    DIM v, c$, f!, l!, r!, g!, bl!, a!, ca!, sa!, lv
    DIM tr!, tg!, tb!
    IF LEN(fx$) = 0 OR n < 2 THEN EXIT SUB
    m = n * n
    DIM cr!(m - 1), cg!(m - 1), cb!(m - 1), wr!(m - 1), wg!(m - 1), wb!(m - 1)
    FOR i = 0 TO m - 1
        cr!(i) = (b(i) \ 65536) AND 255 : cg!(i) = (b(i) \ 256) AND 255 : cb!(i) = b(i) AND 255
    NEXT
    s = n \ 128 : IF s < 1 THEN s = 1 ' (a 128th of the picture: a step)
    FOR k = 1 TO LEN(PC_FX$)
        c$ = MID$(PC_FX$, k, 1) : v = PcFxGet(fx$, c$) : IF v = 0 THEN _CONTINUE
        SELECT CASE c$
            CASE "X" ' Pixelate: v blocks across, each its average
                bs = n \ v : IF bs < 1 THEN bs = 1
                FOR y = 0 TO n - 1 STEP bs : FOR x = 0 TO n - 1 STEP bs
                    r! = 0 : g! = 0 : bl! = 0 : cnt = 0
                    FOR yy = y TO MinOf(n - 1, y + bs - 1) : FOR xx = x TO MinOf(n - 1, x + bs - 1)
                        i = yy * n + xx : r! = r! + cr!(i) : g! = g! + cg!(i) : bl! = bl! + cb!(i) : cnt = cnt + 1
                    NEXT : NEXT
                    r! = r! / cnt : g! = g! / cnt : bl! = bl! / cnt
                    FOR yy = y TO MinOf(n - 1, y + bs - 1) : FOR xx = x TO MinOf(n - 1, x + bs - 1)
                        i = yy * n + xx : cr!(i) = r! : cg!(i) = g! : cb!(i) = bl!
                    NEXT : NEXT
                NEXT : NEXT
            CASE "L", "R" ' Blur (a box, across then down - round the edges, as it tiles); sharpen: away from the blur
                d = v * s : IF c$ = "R" THEN d = s
                PcFxBox cr!(), cg!(), cb!(), wr!(), wg!(), wb!(), n, d
                IF c$ = "L" THEN
                    FOR i = 0 TO m - 1 : cr!(i) = wr!(i) : cg!(i) = wg!(i) : cb!(i) = wb!(i) : NEXT
                ELSE
                    a! = v * 0.6
                    FOR i = 0 TO m - 1
                        cr!(i) = cr!(i) + (cr!(i) - wr!(i)) * a! : cg!(i) = cg!(i) + (cg!(i) - wg!(i)) * a! : cb!(i) = cb!(i) + (cb!(i) - wb!(i)) * a!
                    NEXT
                END IF
            CASE "E" ' Emboss: lit from the top left - each pixel by how much brighter it is up-left than down-right
                d = s
                FOR i = 0 TO m - 1 : wr!(i) = cr!(i) * 0.3 + cg!(i) * 0.59 + cb!(i) * 0.11 : NEXT
                a! = v * 0.9
                FOR y = 0 TO n - 1 : FOR x = 0 TO n - 1
                    l! = (wr!(((y - d + n) MOD n) * n + (x - d + n) MOD n) - wr!(((y + d) MOD n) * n + (x + d) MOD n)) * a!
                    i = y * n + x : cr!(i) = cr!(i) + l! : cg!(i) = cg!(i) + l! : cb!(i) = cb!(i) + l!
                NEXT : NEXT
            CASE "B" ' Brightness: v% of white added (or taken away)
                f! = v * 2.55
                FOR i = 0 TO m - 1 : cr!(i) = cr!(i) + f! : cg!(i) = cg!(i) + f! : cb!(i) = cb!(i) + f! : NEXT
            CASE "C" ' Contrast: away from the middle grey (to 3 times), or towards it
                IF v > 0 THEN f! = 1 + v / 50 ELSE f! = 1 + v / 100
                FOR i = 0 TO m - 1 : cr!(i) = (cr!(i) - 128) * f! + 128 : cg!(i) = (cg!(i) - 128) * f! + 128 : cb!(i) = (cb!(i) - 128) * f! + 128 : NEXT
            CASE "S" ' Saturation: from its grey (-100 grey, 100 twice the colour)
                f! = 1 + v / 100
                FOR i = 0 TO m - 1
                    l! = cr!(i) * 0.3 + cg!(i) * 0.59 + cb!(i) * 0.11
                    cr!(i) = l! + (cr!(i) - l!) * f! : cg!(i) = l! + (cg!(i) - l!) * f! : cb!(i) = l! + (cb!(i) - l!) * f!
                NEXT
            CASE "H" ' Hue: the colours turned v degrees round the colour wheel (its brightness kept)
                ca! = COS(v * 3.14159265 / 180) : sa! = SIN(v * 3.14159265 / 180)
                FOR i = 0 TO m - 1
                    r! = cr!(i) : g! = cg!(i) : bl! = cb!(i)
                    tr! = r! * (0.213 + ca! * 0.787 - sa! * 0.213) + g! * (0.715 - ca! * 0.715 - sa! * 0.715) + bl! * (0.072 - ca! * 0.072 + sa! * 0.928)
                    tg! = r! * (0.213 - ca! * 0.213 + sa! * 0.143) + g! * (0.715 + ca! * 0.285 + sa! * 0.14) + bl! * (0.072 - ca! * 0.072 - sa! * 0.283)
                    tb! = r! * (0.213 - ca! * 0.213 - sa! * 0.787) + g! * (0.715 - ca! * 0.715 + sa! * 0.715) + bl! * (0.072 + ca! * 0.928 + sa! * 0.072)
                    cr!(i) = tr! : cg!(i) = tg! : cb!(i) = tb!
                NEXT
            CASE "P" ' Posterize: v levels of each colour
                lv = v - 1
                FOR i = 0 TO m - 1
                    cr!(i) = INT(PcFx255!(cr!(i)) / 255 * lv + 0.5) * 255 / lv
                    cg!(i) = INT(PcFx255!(cg!(i)) / 255 * lv + 0.5) * 255 / lv
                    cb!(i) = INT(PcFx255!(cb!(i)) / 255 * lv + 0.5) * 255 / lv
                NEXT
            CASE "I" ' Invert
                FOR i = 0 TO m - 1 : cr!(i) = 255 - PcFx255!(cr!(i)) : cg!(i) = 255 - PcFx255!(cg!(i)) : cb!(i) = 255 - PcFx255!(cb!(i)) : NEXT
        END SELECT
    NEXT
    FOR i = 0 TO m - 1
        b(i) = &HFF000000~& OR (INT(PcFx255!(cr!(i))) * 65536) OR (INT(PcFx255!(cg!(i))) * 256) OR INT(PcFx255!(cb!(i)))
    NEXT
END SUB

' A colour's part kept 0 to 255
FUNCTION PcFx255!(v!)
    IF v! < 0 THEN PcFx255! = 0 ELSE IF v! > 255 THEN PcFx255! = 255 ELSE PcFx255! = v!
END FUNCTION

' A box blur, d each way, of picture (r, g, b) into (wr, wg, wb): across,
' then down - wrapping round the edges (pictures tile)
SUB PcFxBox(r!(), g!(), b!(), wr!(), wg!(), wb!(), n AS LONG, d AS LONG)
    DIM x AS LONG, y AS LONG, i AS LONG, j AS LONG, w AS LONG, sr!, sg!, sb!
    DIM tr!(n * n - 1), tg!(n * n - 1), tb!(n * n - 1)
    w = 2 * d + 1
    FOR y = 0 TO n - 1 ' (across: a running sum)
        sr! = 0 : sg! = 0 : sb! = 0
        FOR j = -d TO d : i = y * n + ((j + n * 4) MOD n) : sr! = sr! + r!(i) : sg! = sg! + g!(i) : sb! = sb! + b!(i) : NEXT
        FOR x = 0 TO n - 1
            i = y * n + x : tr!(i) = sr! / w : tg!(i) = sg! / w : tb!(i) = sb! / w
            j = y * n + ((x + d + 1) MOD n) : sr! = sr! + r!(j) : sg! = sg! + g!(j) : sb! = sb! + b!(j)
            j = y * n + ((x - d + n * 4) MOD n) : sr! = sr! - r!(j) : sg! = sg! - g!(j) : sb! = sb! - b!(j)
        NEXT
    NEXT
    FOR x = 0 TO n - 1 ' (then down)
        sr! = 0 : sg! = 0 : sb! = 0
        FOR j = -d TO d : i = ((j + n * 4) MOD n) * n + x : sr! = sr! + tr!(i) : sg! = sg! + tg!(i) : sb! = sb! + tb!(i) : NEXT
        FOR y = 0 TO n - 1
            i = y * n + x : wr!(i) = sr! / w : wg!(i) = sg! / w : wb!(i) = sb! / w
            j = ((y + d + 1) MOD n) * n + x : sr! = sr! + tr!(j) : sg! = sg! + tg!(j) : sb! = sb! + tb!(j)
            j = ((y - d + n * 4) MOD n) * n + x : sr! = sr! - tr!(j) : sg! = sg! - tg!(j) : sb! = sb! - tb!(j)
        NEXT
    NEXT
END SUB
