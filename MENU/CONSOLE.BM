''
' NEON-CASTER - MENU/CONSOLE.BM
' =============================================================================
' The console: every command (ConExec), and its helpers.
'

' --- THE CONSOLE: the game waits while it's open (like the menu), the
' frame you left showing behind it. Type a command and Enter; Up and Down
' bring back earlier ones; Tab finishes a command's name; Ctrl+V (or
' Shift+Insert, or a right-click) pastes; PgUp, PgDn and the mouse wheel
' scroll back through what it printed (Home the top, End back down); F11
' has it fill the screen, and back; ` or Esc closes it. A command that changes the level closes it too, so you see it.
' What's on the clipboard, as console typing: its lines joined by ; (so a
' list of commands pasted runs them all), anything else that isn't
' something you could type taken out
FUNCTION ConClip$
    DIM c$, j, o$, t$ ' (its own: the main program shares these names)
    t$ = _CLIPBOARD$
    FOR j = 1 TO LEN(t$)
        c$ = MID$(t$, j, 1)
        IF c$ = CHR$(10) THEN
            IF LEN(o$) THEN IF RIGHT$(o$, 1) <> ";" THEN o$ = o$ + ";"
        ELSEIF c$ = CHR$(9) THEN
            o$ = o$ + " "
        ELSEIF ASC(c$) >= 32 AND ASC(c$) <= 125 AND c$ <> "`" THEN
            o$ = o$ + c$
        END IF
    NEXT
    IF RIGHT$(o$, 1) = ";" THEN o$ = LEFT$(o$, LEN(o$) - 1)
    ConClip$ = o$
END FUNCTION

SUB RunConsole STATIC
    WorldLoopsOff ' (the world stops while you type: so do its hums)
    _KEYCLEAR
    conLine$ = "" : conDone = 0 : conBrowse = conHistN + 1 : conBack = 0
    conBackdrop& = _COPYIMAGE(0)
    IF conLogN = 0 THEN ConPrint "NEON-CASTER console - type help for the commands"
    ' A demo: recording, the console's opening and every key into it, each at
    ' its tick (60 a second, as you typed) - so a demo shows the typing as well
    ' as what it did. Playing one back (conReplay), those keys again, at the
    ' same ticks: the same lines typed, the same commands run, and their answers.
    conSession = -1 : conTick = 0 : conCtrl = 0 : conShift = 0
    WHILE _MOUSEINPUT : WEND : conRightWas = _MOUSEBUTTON(2) ' (a right button already down when it opens isn't a click)
    IF demoRec AND NOT conReplay THEN DemoFlush : DemoPut "o"
    IF conReplay THEN ConReplayNext
    DO
        _LIMIT 60
        conTick = conTick + 1
        IF conReplay THEN ConReplayKey ELSE k& = _KEYHIT
        DO WHILE k& <> 0 AND NOT conDone
            conPaste = 0 ' (Ctrl+V or Shift+Insert: the clipboard's text, typed in)
            IF ABS(k&) = 100305 OR ABS(k&) = 100306 THEN conCtrl = k& > 0 ' (Ctrl and Shift, followed as they go down and up: by the time a quick Ctrl+V is read, Ctrl may be up again)
            IF ABS(k&) = 100303 OR ABS(k&) = 100304 THEN conShift = k& > 0
            IF NOT conReplay AND (conCtrl OR _KEYDOWN(100305) OR _KEYDOWN(100306)) AND (k& = 118 OR k& = 86 OR k& = 22) THEN conPaste = -1
            IF NOT conReplay AND (conShift OR _KEYDOWN(100303) OR _KEYDOWN(100304)) AND k& = 20992 THEN conPaste = -1
            IF demoRec AND NOT conReplay AND k& > 0 AND k& <> 18432 AND k& <> 20480 AND k& <> 9 AND NOT conPaste THEN DemoPut "t" + STR$(conTick) + STR$(k&) ' (Up, Down, Tab and a paste: the line they give, below)
            IF conPaste THEN conLine$ = LEFT$(conLine$ + ConClip$, 250) : k& = -1 ' (-1: no key of its own)
            SELECT CASE k&
                CASE 96, 126, 27 ' ` ~ Esc: close
                    conDone = -1
                CASE 13 ' Enter: run it
                    conBack = 0 ' (back down to the newest, to see what it says)
                    IF LEN(conLine$) THEN
                        ConPrint "] " + conLine$
                        IF conHistN = CON_HIST THEN
                            FOR h = 1 TO CON_HIST - 1 : conHist$(h) = conHist$(h + 1) : NEXT
                        ELSE
                            conHistN = conHistN + 1
                        END IF
                        conHist$(conHistN) = conLine$ : conBrowse = conHistN + 1
                        conAll$ = conLine$ : conLine$ = ""
                        ' (several commands on one line, split by ;)
                        DO
                            semi = ConSemi(conAll$) ' (a ; inside quotes - an alias's - doesn't count)
                            IF semi THEN conCmd$ = LEFT$(conAll$, semi - 1) : conAll$ = MID$(conAll$, semi + 1) ELSE conCmd$ = conAll$ : conAll$ = ""
                            conLevelChanged = 0 : ConExec
                            IF conLevelChanged THEN conDone = -1 : IF LEN(conAll$) THEN ConQueue conAll$ ' (the rest: in the sector it went to, from the next frame)
                        LOOP WHILE LEN(conAll$) AND NOT conDone
                    END IF
                CASE 8 ' Backspace
                    IF LEN(conLine$) THEN conLine$ = LEFT$(conLine$, LEN(conLine$) - 1)
                CASE 18432 ' Up: an earlier line
                    IF conBrowse > 1 THEN conBrowse = conBrowse - 1 : conLine$ = conHist$(conBrowse)
                CASE 20480 ' Down: a later one
                    IF conBrowse < conHistN THEN conBrowse = conBrowse + 1 : conLine$ = conHist$(conBrowse) ELSE conBrowse = conHistN + 1 : conLine$ = ""
                CASE 18688 ' PgUp: back a page of what it printed
                    conBack = conBack + ConRows - 2
                CASE 20736 ' PgDn: forward a page
                    conBack = conBack - (ConRows - 2)
                CASE 18176 ' Home: the oldest line kept
                    conBack = conLogN
                CASE 20224 ' End: the newest
                    conBack = 0
                CASE 34048 ' F11: fill the screen, or the top of it again - kept in the settings
                    conTall = NOT conTall : SaveSettings
                CASE 9 ' Tab: finish the command's name
                    conLine$ = ConComplete$(conLine$)
                CASE 32 TO 125
                    IF LEN(conLine$) < 250 THEN conLine$ = conLine$ + CHR$(k&)
            END SELECT
            IF demoRec AND NOT conReplay AND (k& = 18432 OR k& = 20480 OR k& = 9 OR conPaste) THEN DemoPut "l" + STR$(conTick) + " " + conLine$ ' (a line from your history - which someone watching hasn't got - or finished by Tab: the line itself)
            IF conReplay THEN k& = 0 ELSE k& = _KEYHIT
        LOOP
        conRight = 0 ' A right-click pastes too (looked for in each mouse event: a quick click is up again by the last)
        WHILE _MOUSEINPUT
            conBack = conBack - 3 * _MOUSEWHEEL ' (the wheel scrolls, three lines a click)
            IF _MOUSEBUTTON(2) AND NOT conRightWas THEN conRight = -1
            conRightWas = _MOUSEBUTTON(2)
        WEND
        IF conRight AND NOT conReplay AND NOT conDone THEN
            conLine$ = LEFT$(conLine$ + ConClip$, 250)
            IF demoRec THEN DemoPut "l" + STR$(conTick) + " " + conLine$
        END IF
        IF conDone THEN EXIT DO
        CLS , _RGBA32(0, 0, 0, 0)
        _PUTIMAGE , conBackdrop&, 0
        DrawConsole conLine$
        IF glReady THEN GLSL_filter_capture
        GLScreenLayer glReady
        ShowFrame
    LOOP
    _FREEIMAGE conBackdrop&
    IF demoRec AND NOT conReplay THEN DemoPut "q" + STR$(conTick)
    conSession = 0
    _KEYCLEAR
    WHILE _MOUSEINPUT : WEND
    escWas = -1 : conKeyWas = -1 : fireWait = 10 ' (so the key that closed it does nothing else)
END SUB

' --- Run one console command, conCmd$ (from the console, the command line or
' an exec). Words: conVerb$, then conA$, conB$, conC$; conRest$ is
' everything after the verb.
SUB ConExec STATIC
    conCmd$ = LTRIM$(RTRIM$(conCmd$))
    IF conCmd$ = "" OR LEFT$(conCmd$, 2) = "//" THEN EXIT SUB
    conVerb$ = ConWord$(conCmd$, 1) : conA$ = ConWord$(conCmd$, 2) : conB$ = ConWord$(conCmd$, 3) : conC$ = ConWord$(conCmd$, 4)
    sp = INSTR(conCmd$, " ") : IF sp THEN conRest$ = LTRIM$(MID$(conCmd$, sp + 1)) ELSE conRest$ = ""
    IF numAlias THEN IF AliasOf(conVerb$) THEN AliasRun AliasOf(conVerb$), conRest$ : EXIT SUB ' (an alias: its commands instead)
    IF (demoRec OR demoPlay) AND NOT conFromTrig AND NOT demoInject THEN ' A demo going: a command that changes the world goes into it (recording), or waits (playing one)
        SELECT CASE DemoVerb%(conVerb$)
            CASE 1
                IF demoPlay THEN ConPrint "(a demo is playing - stopdemo first)" : EXIT SUB
                IF NOT conSession THEN DemoFlush : DemoPut "c " + conCmd$ ' (typed in the console: its keys are in the demo already, and run it again)
            CASE 2 ' (one that starts something else - a saved game, the editor: the demo ends here)
                DemoStop
        END SELECT
    END IF
    IF conFromTrig THEN ' (a sector's own trigger - a file anyone may have made: nothing that writes your files, your settings or your achievements)
        SELECT CASE conVerb$
            CASE "saveleveltodisk", "loadlevelfromdisk", "savelevel", "logfile", "qb64pe", "resetachievements", "achieve", "bind", "set", _
                 "save", "quicksave", "load", "quickload", "exec", "alias", "unalias", "edit", "editor", "newsector", "screenshot", "shot", "quit", "exit", "record", "playdemo", "demo"
                ConPrint "^9(a sector's trigger can't " + conVerb$ + ")" : EXIT SUB
            CASE "god", "noclip", "iddqd", "buddha", "fly", "notarget", "sectorset", "campaign", "set10" ' (ones that last past the sector: a cheat, whoever turned them on)
                IF conA$ <> "" OR conVerb$ <> "sectorset" THEN achCheat = -1
        END SELECT
    END IF
    IF NOT conFromTrig THEN ' (you typed a cheat: achievements wait for a new game)
        SELECT CASE conVerb$
            CASE "god", "noclip", "iddqd", "buddha", "fly", "notarget", "give", "kill", "killall", "spawn", "summon", "item", "finish", "exitlevel", "nextlevel", "tp", "teleport", "goto", "door", "secret", "wall", "put", "box", "block", "liquid", "flood", "raise", "lift", "liftgo", "achieve", _
                 "map", "level", "sector", "jackin", "jackout", "respawn", "lamp", "trigger", "monsters", "turret", "turrets", _
                 "drop", "liquids", "blocks", "resetlevel", "reloadlevel", "loadlevelfromdisk", "mapsize"
                IF NOT achCheat AND NOT achTest THEN ConPrint "^9(cheats on: achievements wait for a new game)"
                achCheat = -1
            CASE "sectorset", "campaign", "set10", "loot" ' (these only look, with nothing after them)
                IF conA$ <> "" THEN
                    IF NOT achCheat AND NOT achTest THEN ConPrint "^9(cheats on: achievements wait for a new game)"
                    achCheat = -1
                END IF
        END SELECT
    END IF
    SELECT CASE conVerb$
        CASE "help", "?", "commands"
            ConHelp conA$
        CASE "version"
            ConPrint "NEON-CASTER " + GAME_VERSION$
        CASE "qb64pe" ' The code terminals' compiler: qb64pe PATH (or a folder), qb64pe auto, or qb64pe to see it
            IF conA$ = "auto" THEN
                qbChosen$ = "" : SaveSettings
            ELSEIF LEN(conRest$) THEN
                IF LEN(QB64At$(conRest$)) THEN qbChosen$ = QB64At$(conRest$) : SaveSettings ELSE ConPrint "qb64pe: there's no qb64pe at " + conRest$
            END IF
            qbNow$ = QB64Path$
            IF qbNow$ = "" THEN
                ConPrint "qb64pe: not found - code terminals check the lines against the answer (qb64pe PATH to point to it)"
            ELSEIF qbNow$ = QB64At$(qbChosen$) THEN
                ConPrint "qb64pe: " + qbNow$ + "   (yours - qb64pe auto to look for it instead)"
            ELSE
                ConPrint "qb64pe: " + qbNow$ + "   (found - qb64pe PATH for another)"
            END IF
        CASE "map", "level", "sector" ' Go to a sector, keeping what you carry
            n = VAL(conA$)
            IF n < 1 THEN ' (or by name: the first whose name has it)
                FOR k = 1 TO NUM_LEVELS + MAX_CUSTOM
                    IF conA$ <> "" AND LEN(sectorName$(k)) THEN IF INSTR(LCASE$(sectorName$(k)), LCASE$(conRest$)) THEN n = k : EXIT FOR
                NEXT
            END IF
            IF SectorExists(n) THEN
                level = n : EnterLevel : conLevelChanged = -1 : ConPrint "-> " + sectorName$(n)
            ELSE
                ConPrint "map: 1 to" + STR$(NUM_LEVELS) + " (or one of yours, from" + STR$(NUM_LEVELS + 1) + "), or part of a name (maps lists them)"
            END IF
        CASE "sectorset", "campaign", "set10" ' Which set of ten sectors map 1-10 (and the next sector) go to
            IF conA$ <> "" THEN
                ns = -1
                SELECT CASE LCASE$(conA$)
                    CASE "0", "original", "old", "game" : ns = 0
                    CASE "1", "new" : ns = 1
                    CASE "2", "remix", "oldnew", "remaster" : ns = 2
                    CASE "3", "huge", "big" : ns = 3
                END SELECT
                IF editMode AND ns >= 0 THEN
                    ConPrint "sectorset: not in the editor - its sector's file is the set's it came from (leave it, F2 or Esc, first)"
                ELSEIF ns < 0 THEN
                    ConPrint "sectorset 0|1|2|3 (original, new, remix, huge)"
                ELSEIF ns > 0 AND LEN(SetSectorName$(ns, 1)) = 0 THEN
                    ConPrint "sectorset: " + SetName$(ns) + " isn't there (levels/" + SetDir$(ns) + ")"
                ELSE
                    sectorSet = ns : ReadSectorNames
                END IF
            END IF
            ConPrint "sector set" + STR$(sectorSet) + ": " + SetName$(sectorSet) + " (map 1-" + LTRIM$(STR$(NUM_LEVELS)) + " go there)"
        CASE "achievements", "ach" ' Every achievement: got it or not, and how far a counted one's got
            n = 0
            FOR i = 1 TO achN
                IF STEAM_is_unlocked%(achApi$(i)) THEN st$ = "^2[X]^0 " : n = n + 1 ELSE st$ = "^8[ ]^0 "
                pr$ = "" : IF achGoal(i) > 1 THEN pr$ = "  (" + LTRIM$(STR$(AchProgress&(i))) + "/" + LTRIM$(STR$(achGoal(i))) + ")"
                ConPrint st$ + achApi$(i) + "  " + achTitle$(i) + " - " + achDesc$(i) + pr$
            NEXT
            ConPrint LTRIM$(STR$(n)) + " of" + STR$(achN) + " unlocked - " + STEAM_backend_name$ + " (" + STEAM_status$ + ")" : IF achCheat THEN ConPrint "(cheats are on this game: no more till a new one)"
        CASE "achieve" ' achieve NAME: unlock one by its API name (testing - it counts as a cheat, so only it)
            IF conA$ = "" THEN ConPrint "achieve NAME (achievements lists them)" ELSE Achieve UCASE$(conA$), -1
        CASE "resetachievements" ' Every achievement and stat back to nothing
            IF achReady THEN ok = STEAM_reset_all%(-1) : ok = STEAM_store% : ConPrint "Achievements and stats reset"
        CASE "maps", "levels", "sectors"
            ConPrint "-- " + SetName$(sectorSet) + " (sectorset changes it) --"
            FOR k = 1 TO NUM_LEVELS + MAX_CUSTOM
                IF k = NUM_LEVELS + 1 THEN ConPrint "-- yours (newsector makes one) --"
                IF LEN(sectorName$(k)) THEN ConPrint LTRIM$(STR$(k)) + "  " + sectorName$(k)
            NEXT
        CASE "newsector" ' A blank sector of your own, in the editor
            NewSector : conLevelChanged = -1
        CASE "sectorname" ' Rename the sector you're in (savelevel or Ctrl+S keeps it)
            IF conRest$ = "" THEN
                ConPrint "sectorname: " + lvlName$
            ELSE
                lvlName$ = UCASE$(conRest$) : levelName$ = lvlName$ : sectorName$(level) = lvlName$ : editDirty = -1
                ConPrint "sectorname: " + lvlName$ + "   (savelevel or Ctrl+S in the editor to keep it)"
            END IF
        CASE "restart", "reset" ' This sector again, from the start
            RestartLevel : conLevelChanged = -1 : ConPrint "Level reset"
        CASE "mapsize" ' mapsize N: the sector's map N x N cells (16 to MAP_SIZE, 256) - grown with wall, or cut down; savelevel keeps it
            IF VAL(conA$) >= 16 THEN EditPushUndo : EditResizeMap VAL(conA$) : editDirty = -1
            ConPrint "map:" + STR$(mapN) + " x" + STR$(mapN) + "  (16 to" + STR$(MAP_SIZE) + ")"
        CASE "resetlevel" ' The sector as it starts - as it is now in the editor - and you where you are
            EditResetLevel : ConPrint "The sector as it starts - you where you are"
        CASE "reloadlevel" ' The sector from its file, as it was last saved - and you where you are
            EditReload "" : ConPrint "The sector from its file: " + LevelFile$(level)
        CASE "savesectorcopy", "sectorcopy" ' A copy of it as it is now, in versions/ beside its file
            ConPrint "Saved a copy: " + EditSaveCopy$
        CASE "saveleveltodisk" ' Save the sector as it is now to a file you choose (or FILE)
            f$ = conRest$ : IF f$ = "" THEN f$ = _SAVEFILEDIALOG$("Save the sector as", EditCopyDir$ + "sector.txt", "*.txt", "NEON-CASTER level files")
            IF LEN(f$) THEN WriteLevelFile f$ : ConPrint "Saved to " + f$ ELSE ConPrint "Not saved"
            _KEYCLEAR
        CASE "loadlevelfromdisk" ' A level file you choose (or FILE) into this sector, in place of its own - not saved till savelevel / Ctrl+S
            f$ = conRest$ : IF f$ = "" THEN f$ = _OPENFILEDIALOG$("Load a level into this sector", EditCopyDir$, "*.txt", "NEON-CASTER level files", 0)
            IF LEN(f$) THEN
                IF _FILEEXISTS(f$) THEN EditReload f$ : ConPrint "Loaded " + f$ + " - savelevel (Ctrl+S) to keep it as this sector's" ELSE ConPrint "No such file: " + f$
            ELSE
                ConPrint "Nothing loaded"
            END IF
            _KEYCLEAR
        CASE "newgame"
            NewGame : conLevelChanged = -1
        CASE "finish", "exitlevel", "nextlevel" ' As if you'd reached the exit
            conLevelChanged = -1 : LevelDone
        CASE "item", "drop" ' item KIND X Y: a pickup appears in cell X Y (KIND: a map character - r b y + * u a e 2 3 4 M q j 8 - or health, armor, cells, shells, medkit, map, goggles...)
            ik = ItemOf(conA$)
            IF ik = 0 OR conC$ = "" THEN
                ConPrint "item KIND X Y - KIND: health medkit armor cells shells rounds slugs rockets scatter repeater rail launcher map overcharge amp goggles suit red blue yellow (or its map character)"
            ELSE
                ix = ConCell(VAL(conB$)) + 0.5 : iy = ConCell(VAL(conC$)) + 0.5 ' (on the map, whatever was typed)
                lootExact = -1 : DropItemAt ik, ix, iy : lootExact = 0 : SfxAt sndTeleport&, ix, iy, playerX, playerY
            END IF
        CASE "loot" ' What breakables leave in this sector: loot (the table), loot BREAKABLE DROP... (PICKUP:CHANCE or -), loot BREAKABLE none, loot default
            IF conA$ = "" THEN
                FOR k = 1 TO DECO_KINDS
                    IF lootKind(k, 1) OR lootKind(k, 2) OR lootKind(k, 3) OR lootKind(k, 4) THEN ConPrint LootLine$(k)
                NEXT
                ConPrint "(the rest leave nothing - help loot to change it)"
            ELSEIF conA$ = "default" THEN
                lvlNumLoot = 0 : LootTable : editDirty = -1
                ConPrint "loot: the game's own table again   (savelevel or Ctrl+S in the editor to keep it)"
            ELSE
                r$ = conRest$ ' (commas or spaces between the drops)
                FOR c = 1 TO LEN(r$) : IF MID$(r$, c, 1) = "," THEN MID$(r$, c, 1) = " "
                NEXT
                l$ = ConWord$(r$, 1) + " ="
                FOR c = 2 TO LOOT_SLOTS + 1
                    w$ = ConWord$(r$, c) : IF w$ = "" OR w$ = "none" THEN EXIT FOR
                    IF c > 2 THEN l$ = l$ + ","
                    l$ = l$ + " " + w$
                NEXT
                k = SetLevelLoot(l$)
                IF k THEN
                    editDirty = -1 : ConPrint LootLine$(k) + "   (savelevel or Ctrl+S in the editor to keep it)"
                ELSE
                    ConPrint "loot: no breakable called " + conA$ + " - barrel console crate desk locker labbench vending plant..."
                END IF
            END IF
        CASE "liquid", "liquids", "flood" ' liquid KIND X0 Y0 X1 Y1 [DEPTH]: a pool (KIND water poison slime lava acid, or none to drain it)
            lk = LiquidOf(conA$) : cw$ = ConWord$(conCmd$, 6)
            IF (lk = 0 AND conA$ <> "none") OR cw$ = "" THEN
                ConPrint "liquid KIND X0 Y0 X1 Y1 [DEPTH]: KIND water poison slime lava acid (or none), DEPTH 1-8 eighths (" + LTRIM$(STR$(LQ_DEPTH)) + ")"
            ELSE
                lx0 = ConCell(VAL(conB$)) : ly0 = ConCell(VAL(conC$)) : lx1 = ConCell(VAL(ConWord$(conCmd$, 5))) : ly1 = ConCell(VAL(cw$))
                ld = VAL(ConWord$(conCmd$, 7)) : IF ld < 1 OR ld > 8 THEN ld = LQ_DEPTH
                IF editMode THEN ' (in the editor: into the level, to keep)
                    EditPushUndo
                    FOR y = MinOf(ly0, ly1) TO MaxOf(ly0, ly1) : FOR x = MinOf(lx0, lx1) TO MaxOf(lx0, lx1)
                        EditSetLiquid x, y, lk, ld
                    NEXT : NEXT
                    EditApply : ConPrint "liquid: " + conRest$ + "   (savelevel or Ctrl+S in the editor to keep it)"
                ELSE ' (in play - a trigger's flood: the pools change where they are, the level isn't built again, so nothing comes back to life)
                    FOR y = MaxOf(1, MinOf(ly0, ly1)) TO MinOf(mapN - 2, MaxOf(ly0, ly1)) : FOR x = MaxOf(1, MinOf(lx0, lx1)) TO MinOf(mapN - 2, MaxOf(lx0, lx1))
                        IF lk = 0 THEN
                            liqKind(x, y) = 0 : liqZ(x, y) = 0
                        ELSEIF worldMap(x, y) <= 0 AND liftCell(x, y) = 0 THEN
                            liqKind(x, y) = lk : liqZ(x, y) = floorH(x, y) + ld * H_STEP : liqAny = -1 : levelFlat = 0 : lqUsed(lk) = -1
                        END IF
                    NEXT : NEXT
                    LiquidGlows MinOf(lx0, lx1), MinOf(ly0, ly1), MaxOf(lx0, lx1), MaxOf(ly0, ly1) ' (lava poured in lights the room, as the level's own does)
                    ConPrint "liquid: " + conRest$
                END IF
            END IF
        CASE "block", "blocks" ' block X Y X0 Y0 X1 Y1 [WALL]: a block in cell X Y, its edges in eighths (block X Y none: gone)
            cw$ = ConWord$(conCmd$, 7)
            IF LCASE$(conC$) = "none" AND conB$ <> "" THEN
                IF editMode THEN
                    EditPushUndo : EditRemoveBox VAL(conA$), VAL(conB$) : EditApply
                ELSEIF VAL(conA$) > 0 AND VAL(conB$) > 0 AND VAL(conA$) < mapN - 1 AND VAL(conB$) < mapN - 1 THEN ' (in play: it sinks away where it is)
                    boxOn(VAL(conA$), VAL(conB$)) = 0 : ClearDecalsOn VAL(conA$), VAL(conB$) : BuildLights : BuildThiefWay : glMeshVersion = glMeshVersion + 1
                END IF
                ConPrint "block: gone from" + STR$(VAL(conA$)) + STR$(VAL(conB$))
            ELSEIF cw$ = "" THEN
                ConPrint "block X Y X0 Y0 X1 Y1 [WALL]: a block in an open cell, edges 0-8 eighths, WALL 1-6 (# N C K P G); block X Y none: take it away"
            ELSE
                bx = VAL(conA$) : by = VAL(conB$) : bw = VAL(ConWord$(conCmd$, 8)) : IF bw < 1 OR bw > 6 THEN bw = 1
                b0 = MaxOf(0, MinOf(7, VAL(conC$))) : b1 = MaxOf(0, MinOf(7, VAL(ConWord$(conCmd$, 5))))
                b2 = MaxOf(b0 + 1, MinOf(8, VAL(ConWord$(conCmd$, 6)))) : b3 = MaxOf(b1 + 1, MinOf(8, VAL(cw$)))
                IF bx < 1 OR by < 1 OR bx > mapN - 2 OR by > mapN - 2 THEN
                    ConPrint "block: not in the border"
                ELSEIF MID$(lvlRow$(by), bx + 1, 1) <> "." THEN
                    ConPrint "block: only on bare floor - not a wall, a door, glass, nor a thing standing there"
                ELSEIF liftCell(bx, by) THEN
                    ConPrint "block: not on a lift"
                ELSEIF editMode THEN ' (in the editor: into the level, to keep)
                    EditPushUndo
                    IF EditAddBox(bx, by, b0, b1, b2, b3, bw) THEN ConPrint "block:" + STR$(bx) + STR$(by) + " -" + STR$(b0) + STR$(b1) + STR$(b2) + STR$(b3) + "   (savelevel or Ctrl+S in the editor to keep it)"
                    EditApply
                ELSE ' (in play - a trigger's: it rises where it is, the level isn't built again, so nothing comes back to life)
                    boxOn(bx, by) = VAL(MID$("134567", bw, 1)) : boxAny = -1
                    boxX0(bx, by) = b0 / 8 : boxY0(bx, by) = b1 / 8 : boxX1(bx, by) = b2 / 8 : boxY1(bx, by) = b3 / 8
                    IF InBox(playerX, playerY) OR NOT BoxFree(playerX, playerY) THEN
                        boxOn(bx, by) = 0 : ConPrint "block: not on top of you"
                    ELSE
                        BlockShoveMonsters bx, by ' (a machine standing there steps out of its way)
                        BuildLights : BuildThiefWay : glMeshVersion = glMeshVersion + 1 : ConPrint "block:" + STR$(bx) + STR$(by)
                    END IF
                END IF
            END IF
        CASE "give"
            ConGive
        CASE "take"
            ConTake
        CASE "die", "suicide" ' You die, here and now (a trigger's death trap; not in god mode or the editor)
            IF NOT dead AND NOT godMode AND NOT editMode THEN health = 0 : dead = -1 : deadAt! = TIMER : hurtFlash = 14 : PlaySfx sndDie&, 1 : IF LEN(conRest$) THEN ShowMsg conRest$
        CASE "god", "noclip", "iddqd" ' (and fly and notarget with it: each also on its own, below)
            IF conA$ = "" THEN godMode = NOT godMode ELSE godMode = ConOn(conA$)
            flyMode = godMode : noTarget = godMode
            IF godMode THEN ConPrint "God mode ON (no damage, no clipping, flying - E up, C down - and notarget)" ELSE ConPrint "God mode OFF"
        CASE "buddha" ' Buddha: you're hurt as ever, but never below 1 health (a pit or a death trap still kills)
            IF conA$ = "" THEN buddhaMode = NOT buddhaMode ELSE buddhaMode = ConOn(conA$)
            IF buddhaMode THEN ConPrint "Buddha ON (hurt, but never below 1 health)" ELSE ConPrint "Buddha OFF"
        CASE "fly" ' Fly: E up, C down (Shift faster) - no falling
            IF conA$ = "" THEN flyMode = NOT flyMode ELSE flyMode = ConOn(conA$)
            IF flyMode THEN ConPrint "Fly ON (E up, C down)" ELSE ConPrint "Fly OFF"
        CASE "notarget" ' The monsters don't notice you - and the hunting ones forget you
            IF conA$ = "" THEN noTarget = NOT noTarget ELSE noTarget = ConOn(conA$)
            IF noTarget THEN ConPrint "Notarget ON (monsters ignore you)" ELSE ConPrint "Notarget OFF"
        CASE "turret", "turrets" ' turret [WHO WHAT [N]]: the turrets, told what to do - eject, retract, off, on, weapon, track, ejectspeed (GAME/TURRETS.BM's states)
            TurretCommand
        CASE "kill", "killall" ' Every monster standing falls
            n = 0
            FOR i = 1 TO numMonsters
                IF monsterState(i) < 2 THEN monsterState(i) = 2 : monsterTimer(i) = MON_DYING : kills = kills + 1 : n = n + 1
            NEXT
            ConPrint "Killed" + STR$(n)
        CASE "respawn" ' The level's monsters, back where they started (and the event rooms' gone)
            numMonsters = monStartN
            FOR i = 1 TO numMonsters
                monsterX(i) = monStartX(i) : monsterY(i) = monStartY(i) : monsterType(i) = monStartType(i)
                monsterHP(i) = mtypeHP(monsterType(i)) : monsterState(i) = 0 : monsterTimer(i) = 0
                monsterHurt(i) = 0 : monsterAtk(i) = 0 : monsterAnim(i) = 0 : monsterEv(i) = 0
                mf = monFrom(i) : MonFresh i : monFrom(i) = mf : monFly(i) = 0 ' (a turret: folded away again, on its own mount)
                MonOwn i, INT(monStartX(i)), INT(monStartY(i))
            NEXT
            kills = 0 : ConPrint "Respawned" + STR$(numMonsters) + " monsters"
        CASE "summon", "spawn" ' A monster (by number or name) in front of you - or, given a cell (spawn TYPE X Y [N]), there: teleported in, hunting (a trigger's ambush)
            t = MonTypeOf(conA$) : cnt = VAL(conB$) : IF cnt < 1 THEN cnt = 1
            ' (a turret hangs from the ceiling, as ~ in a level: floorturret, or _, has it come up out of the floor)
            sumFloor = TURRET_CEIL : IF LCASE$(conA$) = "floorturret" OR conA$ = "_" THEN t = MT_TURRET : sumFloor = TURRET_FLOOR
            IF LCASE$(conA$) = "ceilingturret" THEN t = MT_TURRET
            IF LCASE$(conA$) = "wallturret" OR conA$ = "|" THEN t = MT_TURRET : sumFloor = TURRET_WALL
            sumEject = 0 : sumMode = -1 ' (how fast it comes out - ejectslow, ejectmedium, ejectfast, ejectN frames - and hidden or held: in its housing, coming out when it wakes, or when it's told)
            sumWeap = -1 : sumTrack = 0 ' (a turret's weapon, by name, anywhere after its type: summon turret flame - and how fast it turns: slow, fast, trackN)
            FOR k = 3 TO 7
                tw$ = LCASE$(ConWord$(conCmd$, k))
                IF TurretWeaponOf(tw$) >= 0 THEN sumWeap = TurretWeaponOf(tw$)
                IF tw$ = "slow" THEN sumTrack = 30
                IF tw$ = "medium" THEN sumTrack = 90
                IF tw$ = "fast" THEN sumTrack = 240
                IF tw$ = "ejectslow" THEN sumEject = 90
                IF tw$ = "ejectmedium" THEN sumEject = TURRET_EJECT
                IF tw$ = "ejectfast" THEN sumEject = 12
                IF LEFT$(tw$, 5) = "eject" AND VAL(MID$(tw$, 6)) > 0 THEN sumEject = MaxOf(4, MinOf(600, VAL(MID$(tw$, 6))))
                IF tw$ = "hidden" THEN sumMode = TURRET_AUTO
                IF tw$ = "held" THEN sumMode = TURRET_HELD
                IF LEFT$(tw$, 5) = "track" AND VAL(MID$(tw$, 6)) > 0 THEN sumTrack = MaxOf(10, MinOf(360, VAL(MID$(tw$, 6)))) ' (track45: 45 degrees a second - "track" on its own is nothing)
            NEXT
            IF t > 0 AND LEN(conC$) > 0 AND VAL(conC$) > 0 THEN
                sx0 = VAL(conB$) + 0.5 : sy0 = VAL(conC$) + 0.5 : cnt = VAL(ConWord$(conCmd$, 5)) : IF cnt < 1 THEN cnt = 1
                cnt = MinOf(cnt, MAX_MON - numMonsters) : n = 0 ' (no more than there's room for)
                IF sx0 < 1 OR sy0 < 1 OR sx0 > mapN - 1 OR sy0 > mapN - 1 THEN cnt = 0 : ConPrint "spawn: X and Y on the map - 1 to" + STR$(mapN - 2)
                FOR k = 1 TO cnt ' (the cell itself, then round it)
                    FOR try = 0 TO 8
                        sx = sx0 + (try MOD 3 - 1) * (try > 0) * -0.9 : sy = sy0 + ((try \ 3) - 1) * (try > 0) * -0.9
                        IF SpawnMonster(t, sx, sy, 0, playerX, playerY) THEN n = n + 1 : SumTurret t, sumFloor, sumWeap, sumTrack, sumEject, sumMode : SpawnSparks sx, sy, 0.4, 24, 150, 90, 255 : EXIT FOR
                    NEXT
                NEXT
                IF n THEN SfxAt sndTeleport&, sx0, sy0, playerX, playerY
                ConPrint "Spawned" + STR$(n) + " " + mtypeName$(t) + " at" + STR$(INT(sx0)) + STR$(INT(sy0))
            ELSEIF t = 0 THEN
                ConPrint "summon: a monster type (help summon lists them)"
            ELSE
                n = 0
                IF sumFloor = TURRET_WALL THEN ' (a wall turret: in the wall you face - the last open cell before it)
                    d = 0.3
                    DO WHILE d < 16
                        IF NOT Walkable(playerX + dirX * (d + 0.5), playerY + dirY * (d + 0.5)) THEN EXIT DO
                        d = d + 0.25
                    LOOP
                    IF SpawnMonster(t, INT(playerX + dirX * d) + 0.5, INT(playerY + dirY * d) + 0.5, 0, playerX, playerY) THEN n = 1 : SumTurret t, sumFloor, sumWeap, sumTrack, sumEject, sumMode
                    cnt = 0
                END IF
                cnt = MinOf(cnt, MAX_MON - numMonsters) ' (no more than there's room for)
                FOR k = 1 TO cnt
                    FOR try = 0 TO 8
                        d = 2 + try * 0.5 : sx = playerX + dirX * d + dirY * (k - 1 - (cnt - 1) / 2) : sy = playerY + dirY * d - dirX * (k - 1 - (cnt - 1) / 2)
                        IF SpawnMonster(t, sx, sy, 0, playerX, playerY) THEN n = n + 1 : SumTurret t, sumFloor, sumWeap, sumTrack, sumEject, sumMode : EXIT FOR
                    NEXT
                NEXT
                IF t = MT_TURRET AND n > 0 THEN ConPrint "Summoned" + STR$(n) + " turret - " + TurretWeaponName$(monWeap(numMonsters)) ELSE ConPrint "Summoned" + STR$(n) + " " + mtypeName$(t)
            END IF
        CASE "pitch" ' Look up or down: pitch DEGREES (+ up, - down; OpenGL's LOOK UP / DOWN - about 34 either way)
            IF conA$ = "" THEN
                ConPrint "pitch" + STR$(INT(pitch * 180 / 3.14159265)) + " degrees"
            ELSE
                pitch = MaxOf(-0.6, MinOf(0.6, VAL(conA$) * 3.14159265 / 180)) : ConPrint "pitch" + STR$(INT(pitch * 180 / 3.14159265))
            END IF
        CASE "tp", "teleport", "goto" ' tp x y [angle]
            IF conB$ = "" THEN
                ConPrint "tp x y [angle in degrees]"
            ELSE
                playerX = MaxOf(1.01, MinOf(mapN - 1.01, VAL(conA$))) : playerY = MaxOf(1.01, MinOf(mapN - 1.01, VAL(conB$))) ' (on the map)
                IF conC$ <> "" THEN ang = VAL(conC$) * 3.14159265 / 180 : dirX = DCos(ang) : dirY = DSin(ang) : planeX = -dirY * fovPlane : planeY = dirX * fovPlane
                ConPrint "At" + STR$(playerX) + STR$(playerY)
            END IF
        CASE "droids" ' Where the droids are, and what they're up to - or droids N: this sector has N (savelevel or Ctrl+S keeps it)
            IF conA$ <> "" THEN
                lvlDroids = MaxOf(0, MinOf(MAX_DROIDS, VAL(conA$))) : editDirty = -1 : PlaceDroids level
                ConPrint "droids: this sector has" + STR$(lvlDroids) + "   (savelevel or Ctrl+S in the editor to keep it)"
            END IF
            IF numDroids = 0 THEN ConPrint "No droids here"
            FOR k = 1 TO numDroids
                st = MinOf(3, droidState(k)) : IF droidHP(k) <= 0 THEN st = 4
                ConPrint "droid" + STR$(k) + ": x" + STR$(INT(droidX(k) * 10) / 10) + "  y" + STR$(INT(droidY(k) * 10) / 10) + "  " + RTRIM$(MID$("deciding  rolling   working   scuttling broken    ", st * 10 + 1, 10))
            NEXT
        CASE "info", "f3" ' The F3 panel: info on|off, or info to switch it
            SELECT CASE LCASE$(conA$)
                CASE "on", "1" : infoOn = -1
                CASE "off", "0" : infoOn = 0
                CASE ELSE : infoOn = NOT infoOn
            END SELECT
            IF infoOn THEN ConPrint "info ON - where you are, top left (F3 switches it too)" ELSE ConPrint "info OFF"
        CASE "pos", "where"
            ConPrint sectorName$(level) + ": x" + STR$(INT(playerX * 100) / 100) + "  y" + STR$(INT(playerY * 100) / 100) + "  facing" + STR$(INT(_ATAN2(dirY, dirX) * 180 / 3.14159265)) + " degrees  feet" + STR$(INT(playerZ * 100) / 100) + "  eye" + STR$(INT(eyeZ * 100) / 100) + "  light" + STR$(litR(INT(playerX), INT(playerY))) + STR$(litG(INT(playerX), INT(playerY))) + STR$(litB(INT(playerX), INT(playerY)))
        CASE "save", "savegame"
            saveSlot = SlotOf(conA$) : IF saveSlot < 0 THEN ConPrint "save 1-" + LTRIM$(STR$(NUM_SLOTS)) + " or quick" ELSE SaveGame
        CASE "load", "loadgame"
            saveSlot = SlotOf(conA$)
            IF saveSlot < 0 THEN ConPrint "load 1-" + LTRIM$(STR$(NUM_SLOTS)) + " or quick" ELSE LoadGame : IF loadOK THEN conLevelChanged = -1
        CASE "quicksave"
            saveSlot = 0 : SaveGame
        CASE "quickload"
            saveSlot = 0 : LoadGame : IF loadOK THEN conLevelChanged = -1
        CASE "set"
            ConSet conA$, conB$
        CASE "get"
            ConSet conA$, ""
        CASE "settings", "cvars", "cvarlist"
            FOR k = 1 TO NUM_SETTINGS : ConPrint setKey$(k) + " = " + LTRIM$(STR$(setting(k))) + "   (" + LTRIM$(STR$(setMin(k))) + "-" + LTRIM$(STR$(setMax(k))) + ")  " + setLabel$(k) : NEXT
        CASE "bind"
            ConBind conA$, conB$
        CASE "binds", "bindlist"
            FOR k = 1 TO NUM_BINDS : ConPrint bindKey$(k) + " = " + KeyName$(keyBind&(k)) + "  (" + LTRIM$(STR$(keyBind&(k))) + ")" : NEXT
        CASE "mons", "monlist" ' Every monster: where, how it is, and its own settings (the editor's monster pane)
            IF numMonsters = 0 THEN ConPrint "No monsters in this sector"
            FOR k = 1 TO numMonsters
                ConPrint LTRIM$(STR$(k)) + "  " + mtypeName$(monsterType(k)) + " at" + STR$(INT(monsterX(k))) + STR$(INT(monsterY(k))) + " up" + STR$(INT(MonFoot(k) * 100) / 100) + "  " + RTRIM$(MID$("asleep  hunting dying   dead    ", monsterState(k) * 8 + 1, 8)) + "  hp" + STR$(monsterHP(k)) + "  sight" + STR$(monSight(k)) + "  hearing" + STR$(monHear(k)) + "  speed" + STR$(INT(monSpd(k) * 100)) + "%  wakes " + RTRIM$(MID$("seeing  near    hit     hunting ", monWake(k) * 8 + 1, 8))
            NEXT
        CASE "events"
            IF numEvents = 0 THEN ConPrint "No event rooms in this sector"
            FOR k = 1 TO numEvents
                ConPrint LTRIM$(STR$(k)) + "  " + MID$("ambush  survive trap    gallery nest    closet  hoard   plate   laser   cutter  blackoutfiretrapdeathpit", evType(k) * 8 - 7, 8) + " room" + STR$(evX0(k)) + STR$(evY0(k)) + " -" + STR$(evX1(k)) + STR$(evY1(k)) + "   " + MID$("waiting going   won     lost    ", evState(k) * 8 + 1, 8)
            NEXT
        CASE "screenshot", "shot"
            IF conA$ = "" THEN MakeSaveDir : shotFile$ = SaveDir$ + "shot-" + DATE$ + "-" + LTRIM$(STR$(INT(TIMER))) + ".png" ELSE shotFile$ = conRest$
            IF glMode THEN glShotReq = 1 ' (SUB _GL reads it back, then SaveGLShot saves it)
        CASE "wait"
            conWait = VAL(conA$) : IF conWait < 1 THEN conWait = 1
        CASE "echo"
            ConPrint conRest$
        CASE "alias" ' alias NAME "commands; ...": a name for them ($1-$9: the words after it) - alias NAME: what it is; alias: every one
            IF conA$ = "" THEN
                IF numAlias = 0 THEN ConPrint "No aliases (alias NAME " + CHR$(34) + "commands; ..." + CHR$(34) + ")"
                FOR k = 1 TO numAlias : ConPrint "^7" + aliasName$(k) + "^0  " + aliasCmd$(k) : NEXT
            ELSE
                t$ = LTRIM$(MID$(conRest$, LEN(conA$) + 1)) : IF LEFT$(t$, 1) = CHR$(34) THEN t$ = MID$(t$, 2) : IF RIGHT$(t$, 1) = CHR$(34) THEN t$ = LEFT$(t$, LEN(t$) - 1)
                k = AliasOf(conA$)
                IF t$ = "" THEN
                    IF k THEN ConPrint "^7" + aliasName$(k) + "^0  " + aliasCmd$(k) ELSE ConPrint "alias: no " + conA$
                ELSEIF INSTR(" " + ConNames$ + " ", " " + conA$ + " ") OR DemoVerb%(LCASE$(conA$)) OR ConIsSetting(LCASE$(conA$)) THEN ' (a command's name, one of its other names, or a setting's)
                    ConPrint "alias: " + conA$ + " is a command already"
                ELSE
                    IF k = 0 THEN IF numAlias < MAX_ALIAS THEN numAlias = numAlias + 1 : k = numAlias ELSE ConPrint "alias: too many (" + LTRIM$(STR$(MAX_ALIAS)) + ")"
                    IF k THEN aliasName$(k) = conA$ : aliasCmd$(k) = t$ : IF NOT conFromTrig THEN ConPrint "alias " + conA$ + " = " + t$
                END IF
            END IF
        CASE "unalias" ' unalias NAME: that alias, gone
            k = AliasOf(conA$)
            IF k THEN
                FOR j = k TO numAlias - 1 : aliasName$(j) = aliasName$(j + 1) : aliasCmd$(j) = aliasCmd$(j + 1) : NEXT
                numAlias = numAlias - 1 : ConPrint "unalias " + conA$
            ELSE
                ConPrint "unalias: no " + conA$
            END IF
        CASE "exec" ' Run a file of commands, one a line
            IF NOT _FILEEXISTS(conRest$) AND _FILEEXISTS(SaveDir$ + conRest$) THEN conRest$ = SaveDir$ + conRest$ ' (or one in the saves folder)
            IF _FILEEXISTS(conRest$) THEN
                f = FREEFILE : OPEN conRest$ FOR INPUT AS #f
                xd = 0 : DO UNTIL EOF(f) : LINE INPUT #f, l$ : IF conQTail >= CON_QUEUE AND LEN(LTRIM$(l$)) THEN xd = xd + 1 ELSE ConQueue l$
                LOOP
                CLOSE #f : ConPrint "exec " + conRest$ : IF xd THEN ConPrint "^9exec: the queue was full -" + STR$(xd) + " line(s) left out (" + LTRIM$(STR$(CON_QUEUE)) + " at a time)
            ELSE
                ConPrint "exec: no file " + conRest$
            END IF
        CASE "logfile" ' Everything printed also goes to a file (logfile off to stop)
            IF conA$ = "off" OR conA$ = "" THEN
                conLogFile$ = ""
            ELSE
                lf$ = conRest$ : lp = _INSTRREV(lf$, "/") : IF _INSTRREV(lf$, "\") > lp THEN lp = _INSTRREV(lf$, "\")
                IF lp > 1 THEN IF NOT _DIREXISTS(LEFT$(lf$, lp - 1)) THEN ConPrint "logfile: no folder " + LEFT$(lf$, lp - 1) + " - not logging" : lf$ = ""
                IF LEN(lf$) THEN conLogFile$ = lf$ : ConPrint "logging to " + lf$
            END IF
        CASE "cutscene" ' Play a sector's transmission (cutscene 3), even from the CLI
            cutWas = level : cutCli = cliMode : cliMode = 0
            IF VAL(conA$) >= 1 AND VAL(conA$) <= NUM_LEVELS THEN level = VAL(conA$)
            ShowTransmission
            level = cutWas : cliMode = cutCli
        CASE "say" ' Speak a line by its key (say taunt3), as NEXUS
            IF LineOf(conA$) THEN Say conA$, 0 ELSE ConPrint "say: no line " + conA$
        CASE "jackin" ' Into the nearest data station's network (for testing)
            IF numStations = 0 THEN
                ConPrint "jackin: no data station in this sector"
            ELSEIF NOT cyberOn THEN
                best = 1
                FOR k = 2 TO numStations
                    IF (stationX(k) - playerX) ^ 2 + (stationY(k) - playerY) ^ 2 < (stationX(best) - playerX) ^ 2 + (stationY(best) - playerY) ^ 2 THEN best = k
                NEXT
                st = best : stationDone(st) = 0 : JackIn : conLevelChanged = -1
            END IF
        CASE "jackout" ' Out of the network: jackout win, or jackout (thrown out)
            IF cyberOn THEN cyberWon = (conA$ = "win") : JackOut
        CASE "cores" ' Where the network's data cores are (in the network)
            FOR i = 1 TO numItems
                IF itemOn(i) AND itemKind(i) = IT_CORE THEN ConPrint "core at" + STR$(itemX(i)) + STR$(itemY(i))
            NEXT
        CASE "stations"
            IF numStations = 0 THEN ConPrint "No data stations in this sector"
            FOR k = 1 TO numStations : ConPrint LTRIM$(STR$(k)) + "  station at" + STR$(stationX(k)) + STR$(stationY(k)) + "   " + MID$("waiting hacked ", -(stationDone(k) <> 0) * 8 + 1, 8) : NEXT
        CASE "edit", "editor" ' The level editor (F2): edit (the map from above), edit walk (inside it), edit off
            IF conA$ = "off" THEN
                IF editMode THEN EditLeave
            ELSE
                IF NOT editMode THEN EditEnter
                IF conA$ = "walk" OR conA$ = "fp" THEN editView = 1 ELSE editView = 0
            END IF
            conLevelChanged = -1
        CASE "put" ' put X Y CHAR: a map character into the level (chapter 22), built at once
            IF LEN(conC$) = 1 THEN
                pc$ = MID$(conRest$, LEN(conRest$), 1) ' (as typed: map characters care about case)
                EditPushUndo : EditPut VAL(conA$), VAL(conB$), pc$ : EditApply : ConPrint "put " + pc$ + " at" + STR$(VAL(conA$)) + STR$(VAL(conB$))
            ELSE
                ConPrint "put X Y CHAR"
            END IF
        CASE "box" ' box X0 Y0 X1 Y1 CHAR: fill a rectangle
            bw$ = ConWord$(conCmd$, 6) : pc$ = MID$(conRest$, LEN(conRest$), 1)
            IF LEN(bw$) = 1 THEN
                EditPushUndo
                bx0 = ConCell(VAL(conA$)) : by0 = ConCell(VAL(conB$)) : bx1 = ConCell(VAL(conC$)) : by1 = ConCell(VAL(ConWord$(conCmd$, 5)))
                FOR y = MinOf(by0, by1) TO MaxOf(by0, by1) : FOR x = MinOf(bx0, bx1) TO MaxOf(bx0, bx1) : EditPut x, y, pc$ : NEXT : NEXT
                EditApply : ConPrint "box of " + pc$
            ELSE
                ConPrint "box X0 Y0 X1 Y1 CHAR"
            END IF
        CASE "lamp" ' lamp X Y [1-8]: a light over cell X Y - white, cyan, magenta, orange, green, red alarm, flickering, firelight
            EditPushUndo
            p = VAL(conC$) - 1 : IF p < 0 OR p > 7 THEN p = 0
            EditLightPreset p : EditAddLight ConCell(VAL(conA$)) + 0.5, ConCell(VAL(conB$)) + 0.5 : EditApply : ConPrint editMsg$
        CASE "raise" ' raise X Y EIGHTHS [ceil], or raise X0 Y0 X1 Y1 EIGHTHS [ceil]: floors (or ceilings) up or down, in eighths of a wall
            EditPushUndo
            w5$ = ConWord$(conCmd$, 5) : w6$ = ConWord$(conCmd$, 6)
            IF w5$ <> "" AND w5$ <> "ceil" THEN ' (a rectangle)
                FOR y = ConCell(MinOf(VAL(conB$), VAL(w5$))) TO ConCell(MaxOf(VAL(conB$), VAL(w5$))) : FOR x = ConCell(MinOf(VAL(conA$), VAL(conC$))) TO ConCell(MaxOf(VAL(conA$), VAL(conC$)))
                    EditRaise x, y, VAL(w6$ + " ") * 0 + VAL(ConWord$(conCmd$, 6)) * H_STEP, (ConWord$(conCmd$, 7) = "ceil")
                NEXT : NEXT
            ELSEIF conC$ <> "" THEN
                EditRaise ConCell(VAL(conA$)), ConCell(VAL(conB$)), VAL(conC$) * H_STEP, (w5$ = "ceil")
            END IF
            EditApply : ConPrint "floor" + STR$(floorH(ConCell(VAL(conA$)), ConCell(VAL(conB$)))) + "  ceiling" + STR$(ceilH(ConCell(VAL(conA$)), ConCell(VAL(conB$))))
        CASE "lift" ' lift X0 Y0 X1 Y1 LOW HIGH [MODE] [SPEED]: a lift (heights and speed in eighths)
            IF lvlNumLifts < MAX_LIFTS AND conC$ <> "" THEN
                EditPushUndo
                lvlNumLifts = lvlNumLifts + 1 : k = lvlNumLifts
                FOR j = 1 TO 8 : lvlLift(k, j) = VAL(ConWord$(conCmd$, j + 1)) : NEXT
                IF lvlLift(k, 7) = 0 THEN lvlLift(k, 7) = 2
                IF lvlLift(k, 8) = 0 THEN lvlLift(k, 8) = 8
                FOR j = 1 TO 4 : lvlLift(k, j) = ConCell(lvlLift(k, j)) : NEXT ' (on the map)
                lvlLift(k, 5) = MaxOf(-8, MinOf(H_MAX, lvlLift(k, 5))) : lvlLift(k, 6) = MaxOf(-8, MinOf(H_MAX, lvlLift(k, 6))) : lvlLift(k, 8) = MaxOf(1, MinOf(64, lvlLift(k, 8)))
                EditApply : ConPrint "lift" + STR$(lvlNumLifts)
            END IF
        CASE "program" ' program NAME: a computer runs neon-caster/programs/NAME.bas (RunProgram) - for a "use" trigger on a computer
            RunProgram
        CASE "thieves" ' Each thief bot: where, what it's doing, what it carries, how far from home
            FOR j = 1 TO numMonsters
                IF monsterType(j) = MT_THIEF THEN
                    t$ = MID$("idle   huntingdying  dead   gone   ", monsterState(j) * 7 + 1, 7)
                    ConPrint STR$(j) + "  at" + STR$(INT(monsterX(j) * 10) / 10) + STR$(INT(monsterY(j) * 10) / 10) + "  " + RTRIM$(t$) + "  carrying" + STR$(thiefCells(j)) + " cells" + STR$(thiefShells(j)) + " shells, gun" + STR$(thiefGun(j)) + "  home in" + STR$(thiefDist(INT(monsterX(j)), INT(monsterY(j))))
                END IF
            NEXT
        CASE "secret" ' secret X Y: the secret wall at X Y opens - found (for triggers: a switch you shoot...); secret: how many found
            IF conA$ = "" THEN
                ConPrint "Secrets found:" + STR$(secretsFound) + " of" + STR$(numSecrets)
                FOR k = 1 TO numSecrets ' (each: its first cell, and what opens it)
                    fx = -1
                    FOR y = 1 TO mapN - 2 : FOR x = 1 TO mapN - 2
                        IF secretCell(x, y) = k AND fx < 0 THEN fx = x : fy = y
                    NEXT : NEXT
                    t$ = "Space" : IF secretShot(k) THEN t$ = "a trigger" ELSE IF secretNeedEv(k) THEN t$ = "Space, once closet" + STR$(secretNeedEv(k)) + " is clear"
                    IF secretFound(k) THEN t$ = "found"
                    ConPrint STR$(k) + "  at" + STR$(fx) + STR$(fy) + "   " + t$
                NEXT
            ELSE
                x = VAL(conA$) : y = VAL(conB$)
                IF x >= 0 AND y >= 0 AND x < mapN AND y < mapN THEN
                    IF secretCell(x, y) > 0 THEN OpenSecret secretCell(x, y), -1 ELSE ConPrint "secret: no secret wall at" + STR$(x) + STR$(y)
                END IF
            END IF
        CASE "door" ' door X Y open|close|lock|unlock|toggle (for triggers)
            x = VAL(conA$) : y = VAL(conB$)
            IF x >= 0 AND y >= 0 AND x < mapN AND y < mapN THEN
                IF worldMap(x, y) = 2 AND doorType(x, y) <> DOOR_EXIT THEN
                    SELECT CASE conC$
                        CASE "open" : doorLock(x, y) = 0 : IF doorOpen(x, y) < 1 THEN doorMove(x, y) = 1 : IF doorOpen(x, y) = 0 THEN doorOpen(x, y) = 0.01
                        CASE "close" : doorMove(x, y) = -1
                        CASE "lock" : doorLock(x, y) = 4 : doorMove(x, y) = -1 ' (4: locked by a trigger - no event room lets it go)
                        CASE "unlock" : doorLock(x, y) = 0
                        CASE ELSE : IF doorOpen(x, y) > 0.5 THEN doorMove(x, y) = -1 ELSE doorMove(x, y) = 1 : IF doorOpen(x, y) = 0 THEN doorOpen(x, y) = 0.01
                    END SELECT
                    SfxAt DoorSnd&(doorType(x, y)), x + 0.5, y + 0.5, playerX, playerY
                ELSE
                    ConPrint "door: no door at" + STR$(x) + STR$(y)
                END IF
            END IF
        CASE "message", "msg" ' message TEXT: on screen, like a pickup's
            ShowMsg conRest$
        CASE "sound", "sfx" ' sound NAME: a sound effect (sfx/NAME.wav)
            snd& = ConSound&(conA$) : IF snd& > 0 THEN PlaySfx snd&, 0.9 ELSE ConPrint "sound: no sfx/" + conA$ + ".wav"
        CASE "wall" ' wall X Y CHAR: a cell changed in the running level - a wall (# N C K P G) or floor (.) - as a closet's
            x = VAL(conA$) : y = VAL(conB$) : pc$ = MID$(conRest$, LEN(conRest$), 1)
            IF x > 0 AND y > 0 AND x < mapN - 1 AND y < mapN - 1 THEN
                k = INSTR("#.NCKPG", pc$)
                IF k = 1 THEN worldMap(x, y) = 1
                IF k = 2 THEN worldMap(x, y) = 0 : ClearDecalsOn x, y
                IF k > 2 THEN worldMap(x, y) = k
                BuildLights : glMeshVersion = glMeshVersion + 1
                IF k = 2 THEN SpawnSparks x + 0.5, y + 0.5, 0.3, 14, 160, 150, 140 : SfxAt sndCloset&, x + 0.5, y + 0.5, playerX, playerY
            END IF
        CASE "light" ' light N on|off: one of the level's lights ([lights], from 1)
            l = VAL(conA$)
            IF l >= 1 AND l <= numLights THEN
                IF conB$ = "off" THEN lightBroken(l) = -1 ELSE lightBroken(l) = 0
                cx = INT(lightX(l)) : cy = INT(lightY(l))
                IF shaftCell(cx, cy) = l THEN ' (its lamp on the ceiling: lit, or dark - and OpenGL's world built again to show it)
                    IF conB$ = "off" THEN ceilTex(cx, cy) = T_LAMPOFF ELSE ceilTex(cx, cy) = T_LAMP
                    glMeshVersion = glMeshVersion + 1
                END IF
            END IF
        CASE "liftgo" ' liftgo N up|down: a lift on its way
            l = VAL(conA$)
            IF l >= 1 AND l <= numLifts THEN
                IF conB$ = "down" THEN liftDir(l) = -1 ELSE liftDir(l) = 1 ' (its sound: LiftSound, next frame)
            END IF
        CASE "triggers" ' The level's triggers
            IF numTrigs = 0 THEN ConPrint "No triggers in this sector"
            FOR k = 1 TO numTrigs : ConPrint LTRIM$(STR$(k)) + "  " + lvlTrig$(k) + MID$("   (done)", 1, -9 * (trigDone(k) <> 0)) : NEXT
        CASE "trigger" ' trigger WHEN ... : COMMANDS - a new one for this level (saved with it); trigger del N
            IF conA$ = "del" THEN
                n = VAL(conB$)
                IF n >= 1 AND n <= lvlNumTrigs THEN
                    EditPushUndo
                    FOR k = n TO lvlNumTrigs - 1 : lvlTrig$(k) = lvlTrig$(k + 1) : NEXT
                    lvlNumTrigs = lvlNumTrigs - 1 : EditApply : ConPrint "trigger" + STR$(n) + " gone"
                END IF
            ELSEIF INSTR(conRest$, ":") AND lvlNumTrigs < MAX_TRIGS THEN
                t$ = conRest$ ' (typed, its commands are split by | - the console takes ; itself)
                DO WHILE INSTR(t$, "|") : MID$(t$, INSTR(t$, "|"), 1) = ";" : LOOP
                EditPushUndo : lvlNumTrigs = lvlNumTrigs + 1 : lvlTrig$(lvlNumTrigs) = t$ : EditApply : ConPrint "trigger" + STR$(lvlNumTrigs) + ": " + t$
            ELSE
                ConPrint "trigger enter|use|clear|time ... [repeat] : COMMAND | COMMAND   (or trigger del N)"
            END IF
        CASE "locks" ' The doors near you that are locked (for tests): x y kind
            FOR y = INT(playerY) - 8 TO INT(playerY) + 8 : FOR x = INT(playerX) - 8 TO INT(playerX) + 8
                IF x >= 0 AND y >= 0 AND x < mapN AND y < mapN THEN IF worldMap(x, y) = 2 AND doorLock(x, y) THEN ConPrint "locked door at" + STR$(x) + STR$(y) + "  (" + LTRIM$(STR$(doorLock(x, y))) + ")"
            NEXT : NEXT
        CASE "hud" ' The HUD layout editor (hud off: leave it; hud save: write hud.txt as it is; hud reset)
            SELECT CASE conA$
                CASE "off" : IF hudEdit THEN HudEditLeave
                CASE "save" : WriteHud : ConPrint "wrote " + AssetPath$("hud.txt")
                CASE "reset" : HudDefaults
                CASE ELSE : IF NOT hudEdit THEN HudEditEnter
            END SELECT
            conLevelChanged = -1
        CASE "monsters" ' The monster editor - or monsters save: write monsters.txt as they are
            IF conA$ = "save" THEN WriteMonsters : ConPrint "wrote " + AssetPath$("monsters.txt") ELSE RunMonsterEditor : conLevelChanged = -1
        CASE "puzzle" ' puzzle NAME: try a code puzzle (from neon-caster/puzzles) - no doors at stake
            pzTerm = 0 : pzResume = 0 ' (a fresh one - and a terminal left half done starts afresh too)
            IF LoadPuzzle(conA$) THEN
                RunPuzzle : conLevelChanged = -1
                IF pzSolved THEN ConPrint "puzzle " + conA$ + ": SOLVED - " + pzOut$ ELSE ConPrint "puzzle " + conA$ + ": left unsolved (" + LTRIM$(STR$(pzFails)) + " tries)"
            ELSE
                ConPrint "puzzle: no neon-caster/puzzles/" + conA$ + ".txt"
            END IF
        CASE "undo" ' The editor's last change, undone
            EditUndoStep
        CASE "savelevel" ' Save the level as it is now to its file
            EditSave level : ConPrint editMsg$
        CASE "use" ' Press Space (open a door, jack in...), once
            conUse = -1
        CASE "fire" ' Hold the trigger for a number of frames (fire 30)
            conFire = VAL(conA$) : IF conFire < 1 THEN conFire = 1
        CASE "kick" ' (as if you'd pressed F)
            IF kickTimer = 0 THEN kickTimer = KICK_FRAMES : PlaySfx sndKickSwing&, 0.7
        CASE "record" ' record NAME [SEED]: a demo of this sector, from its start - your keys, frame by frame - till the exit (or stopdemo). SEED: the dice start there (tests)
            dn$ = DemoFileName$(DemoWord$(conRest$, 1)) : dSeedWant# = VAL(DemoWord$(conRest$, 2))
            demoRecQuit = (LCASE$(DemoWord$(conRest$, 2)) = "quit" OR LCASE$(DemoWord$(conRest$, 3)) = "quit") ' (quit: the game ends once it's saved at the exit - for scripts)
            IF dn$ = "" THEN
                ConPrint "record NAME: this sector again from its start, recorded as a demo (the exit, or stopdemo, ends it)"
            ELSEIF editMode THEN
                ConPrint "record: F2 out of the editor first"
            ELSEIF NOT SectorExists(level) THEN
                ConPrint "record: no sector to record"
            ELSE
                IF demoRec OR demoPlay THEN DemoStop
                demoName$ = dn$ : DemoRecordStart : conLevelChanged = -1
            END IF
        CASE "playdemo", "demo" ' playdemo NAME [quit]: a demo played back (quit: the game ends with it - for tests)
            dn$ = DemoFileName$(DemoWord$(conRest$, 1)) : dFile$ = ""
            IF LEN(dn$) THEN
                IF _FILEEXISTS(SaveDir$ + "demos/" + dn$ + ".ncd") THEN
                    dFile$ = SaveDir$ + "demos/" + dn$ + ".ncd"
                ELSEIF _FILEEXISTS(AssetPath$("demos/" + dn$ + ".ncd")) THEN
                    dFile$ = AssetPath$("demos/" + dn$ + ".ncd")
                END IF
            END IF
            IF dFile$ = "" THEN
                ConPrint "playdemo NAME [quit]: one of the demos (demos lists them)"
            ELSEIF editMode THEN
                ConPrint "playdemo: F2 out of the editor first"
            ELSE
                IF demoRec OR demoPlay THEN DemoStop
                demoQuit = (LCASE$(DemoWord$(conRest$, 2)) = "quit") : demoName$ = dn$ : DemoPlayStart : conLevelChanged = -1
            END IF
        CASE "bot", "autopilot" ' bot [on|off]: the autopilot plays (BotThink) - record a demo while it does. bot human 0-100: how human it plays. bot safe on|off: buddha with it
            IF conA$ = "human" THEN
                IF conB$ <> "" THEN botHuman = MaxOf(0, MinOf(100, VAL(conB$)))
                ConPrint "bot human" + STR$(botHuman) + " (0: a machine - 100: slow to turn, slow to react, misses some)"
                EXIT SUB
            ELSEIF conA$ = "safe" THEN
                IF conB$ <> "" THEN botSafe = ConOn(conB$) ELSE botSafe = NOT botSafe
                IF botSafe THEN ConPrint "bot safe ON: with the autopilot on, buddha - it's hurt, but never below 1 health" ELSE ConPrint "bot safe OFF: it can die (three times, and it turns god mode on)"
                EXIT SUB
            END IF
            IF conA$ = "" THEN botOn = NOT botOn ELSE botOn = ConOn(conA$)
            IF botOn AND botSafe AND NOT buddhaMode THEN ' (safe: buddha on - and into a demo being made, for all to see)
                buddhaMode = -1 : ConPrint "Buddha ON (hurt, but never below 1 health)"
                IF demoRec THEN DemoFlush : DemoPut "c buddha on"
            END IF
            IF botOn THEN
                achCheat = -1 : botDeaths = 0 : botWasDead = 0 : botNX = 0 : botStuck = 0 : botCheckAt = 0 : botStallAt = 0 : botStallN = 0 : botAmmoAt = 0
                FOR bi = 1 TO MAX_MON : botIgnore(bi) = 0 : NEXT
                FOR by = 0 TO mapN - 1 : FOR bx = 0 TO mapN - 1 : botSeen(bx, by) = 0 : botBlock(bx, by) = 0 : NEXT : NEXT
                ConPrint "Autopilot ON: it plays - the exit, keycards, monsters in sight (bot off to stop)"
            ELSE
                ConPrint "Autopilot OFF"
            END IF
        CASE "stopdemo"
            IF demoRec OR demoPlay THEN DemoStop ELSE ConPrint "stopdemo: no demo going"
        CASE "demos" ' The demos there are: yours (saves/demos), then the game's own
            n = 0
            FOR dd = 1 TO 2
                IF dd = 1 THEN dDir$ = SaveDir$ + "demos/" ELSE dDir$ = AssetPath$("demos/")
                IF _DIREXISTS(dDir$) THEN
                    f$ = _FILES$(dDir$ + "*.ncd")
                    DO WHILE LEN(f$)
                        ConPrint "  " + LEFT$(f$, LEN(f$) - 4) : n = n + 1
                        f$ = _FILES$
                    LOOP
                END IF
            NEXT
            IF n = 0 THEN ConPrint "No demos yet - record NAME makes one"
        CASE "status"
            ConPrint sectorName$(level) + "  health" + STR$(health) + "  armour" + STR$(armor) + "  cells" + STR$(ammoCount(AM_CELLS)) + "  shells" + STR$(ammoCount(AM_SHELLS)) + "  rounds" + STR$(ammoCount(AM_ROUNDS)) + "  slugs" + STR$(ammoCount(AM_SLUGS)) + "  rockets" + STR$(ammoCount(AM_ROCKETS)) + "  kills" + STR$(kills) + " /" + STR$(numMonsters)
        CASE "clear", "cls"
            conLogN = 0
        CASE "menu"
            menuInGame = -1 : RunMenu : conLevelChanged = -1
        CASE "quit", "exit"
            QuitGame
        CASE ELSE ' A setting's name on its own: show it, or set it (fov 90)
            found = 0
            FOR k = 1 TO NUM_SETTINGS
                IF conVerb$ = setKey$(k) THEN found = -1
            NEXT
            IF found THEN ConSet conVerb$, conA$ ELSE ConPrint "^1Unknown command: " + conVerb$ + "^0  (help lists them)"
    END SELECT
END SUB

' --- give: what conA$ (and conB$) say
SUB ConGive STATIC
    SELECT CASE conA$
        CASE "all", "everything"
            FOR k = 1 TO 3 : hasCard(k) = -1 : NEXT
            FOR g = 1 TO NUM_GUNS : hasGun(g) = -1 : NEXT
            FOR k = 1 TO NUM_AMMO : ammoCount(k) = ammoMax(k) : NEXT
            health = MAX_HP : armor = MAX_ARMOR : hasMap = -1 : ConPrint "Everything"
        CASE "keys", "keycards", "cards"
            FOR k = 1 TO 3 : hasCard(k) = -1 : NEXT : ConPrint "All keycards"
        CASE "key", "card", "keycard"
            k = INSTR("rby", LEFT$(conB$, 1)) : IF k THEN hasCard(k) = -1 : ConPrint "The " + CardName$(k) + " keycard" ELSE ConPrint "give key red / blue / yellow"
        CASE "weapons", "guns"
            FOR g = 1 TO NUM_GUNS : hasGun(g) = -1 : NEXT : ConPrint "All guns"
        CASE "weapon", "gun"
            g = VAL(conB$) : IF g >= 1 AND g <= NUM_GUNS THEN hasGun(g) = -1 : currentGun = g : ConPrint gunName$(g) ELSE ConPrint "give gun 1-" + LTRIM$(STR$(NUM_GUNS))
        CASE "ammo" ' give ammo: full; give ammo cells|shells|rounds|slugs|rockets [N]: that kind - full, or N more
            am = AmmoKind(conB$) : n = VAL(conC$)
            IF am = 0 THEN
                FOR k = 1 TO NUM_AMMO : ammoCount(k) = ammoMax(k) : NEXT : ConPrint "Full ammo"
            ELSE
                IF n <= 0 THEN n = ammoMax(am)
                ammoCount(am) = MinOf(ammoMax(am), ammoCount(am) + n) : PlaySfx sndAmmo&, 0.7
                ConPrint "+" + LTRIM$(STR$(n)) + " " + AmmoName$(am) + "  (" + LTRIM$(STR$(ammoCount(am))) + ")"
            END IF
        CASE "health" ' give health: full; give health N: N more, up to the most
            n = VAL(conB$)
            IF n <= 0 THEN health = MaxOf(health, MAX_HP) : ConPrint "Full health" ELSE health = MinOf(MaxOf(health, MAX_HP), health + n) : PlaySfx sndHealth&, 0.8 : pickFlash = 10 : ConPrint "+" + LTRIM$(STR$(n)) + " health"
        CASE "armor", "armour"
            n = VAL(conB$)
            IF n <= 0 THEN armor = MAX_ARMOR : ConPrint "Full armour" ELSE armor = MinOf(MAX_ARMOR, armor + n) : PlaySfx sndArmor&, 0.8 : ConPrint "+" + LTRIM$(STR$(n)) + " armour"
        CASE "overcharge"
            health = MAX_OVER : ConPrint "Overcharged"
        CASE "amp", "damage"
            ampTimer = AMP_FRAMES : ConPrint "Damage amp"
        CASE "map"
            hasMap = -1 : ConPrint "The map"
        CASE "goggles", "nightvision", "headset"
            nvHave = 1 : ConPrint "Night vision (N)"
        CASE "suit", "hazmat", "hvac"
            suitLeft = SUIT_MAX : ConPrint "A new hazmat suit"
        CASE ELSE
            ConPrint "give all / keys / key r|b|y / weapons / gun N / ammo [cells|shells|rounds|slugs|rockets N] / health [N] / armor [N] / overcharge / amp / map / goggles / suit"
    END SELECT
END SUB

' take - give's opposite (for triggers: a toll, a trap, a thief room). take
' health N hurts you N (armour doesn't help; it can kill), take all leaves
' you the blaster and nothing else.
SUB ConTake STATIC
    SELECT CASE conA$
        CASE "all", "everything"
            FOR k = 1 TO 3 : hasCard(k) = 0 : NEXT
            FOR g = 2 TO NUM_GUNS : hasGun(g) = 0 : NEXT
            currentGun = W_BLASTER : nextGun = W_BLASTER : FOR k = 1 TO NUM_AMMO : ammoCount(k) = 0 : NEXT : armor = 0 : hasMap = 0 : ampTimer = 0 ' (nextGun: not on with a swap to one that's gone)
            PlaySfx sndSteal&, 1 : ConPrint "Everything taken"
        CASE "keys", "keycards", "cards"
            FOR k = 1 TO 3 : hasCard(k) = 0 : NEXT : ConPrint "Keycards taken"
        CASE "key", "card", "keycard"
            k = INSTR("rby", LEFT$(conB$, 1)) : IF k THEN hasCard(k) = 0 : ConPrint "The " + CardName$(k) + " keycard taken" ELSE ConPrint "take key red / blue / yellow"
        CASE "weapons", "guns"
            FOR g = 2 TO NUM_GUNS : hasGun(g) = 0 : NEXT : currentGun = W_BLASTER : nextGun = W_BLASTER : ConPrint "Guns taken (the blaster stays)"
        CASE "weapon", "gun"
            g = VAL(conB$) : IF g >= 2 AND g <= NUM_GUNS THEN hasGun(g) = 0 : IF currentGun = g THEN currentGun = W_BLASTER
            IF g >= 2 AND g <= NUM_GUNS THEN IF nextGun = g THEN nextGun = W_BLASTER
        CASE "ammo" ' take ammo: all of it; take ammo cells|shells|rounds|slugs|rockets [N]
            am = AmmoKind(conB$) : n = VAL(conC$)
            IF am = 0 THEN
                FOR k = 1 TO NUM_AMMO : ammoCount(k) = 0 : NEXT : ConPrint "Ammo taken"
            ELSE
                IF n <= 0 THEN n = ammoCount(am)
                ammoCount(am) = MaxOf(0, ammoCount(am) - n) : ConPrint "-" + LTRIM$(STR$(n)) + " " + AmmoName$(am) + "  (" + LTRIM$(STR$(ammoCount(am))) + ")"
            END IF
        CASE "health" ' take health N: N off (god mode and the editor are spared)
            n = VAL(conB$) : IF n <= 0 THEN n = 10
            IF NOT godMode AND NOT editMode AND NOT dead THEN
                health = health - n : hurtFlash = 14 : shake = shake + n / 4
                IF health <= 0 THEN
                    health = 0 : dead = -1 : deadAt! = TIMER : PlaySfx sndDie&, 1
                ELSE
                    PlaySfx sndHurt&, 0.8
                END IF
            END IF
            ConPrint "-" + LTRIM$(STR$(n)) + " health"
        CASE "armor", "armour"
            n = VAL(conB$) : IF n <= 0 THEN armor = 0 ELSE armor = MaxOf(0, armor - n)
        CASE "map"
            hasMap = 0 : mapOpen = 0
        CASE ELSE
            ConPrint "take all / keys / key r|b|y / weapons / gun N / ammo [cells|shells|rounds|slugs|rockets N] / health N / armor [N] / map"
    END SELECT
END SUB

' A pickup kind by its map character or a name (as the map has them: 1-3
' keycards, 4 health... IT_), 0 for none
FUNCTION ItemOf(v$)
    ItemOf = 0
    IF LEN(v$) = 1 THEN ItemOf = ItemOfChar(v$)
    IF LEN(v$) = 1 THEN EXIT FUNCTION
    SELECT CASE LCASE$(v$)
        CASE "red" : ItemOf = 1
        CASE "blue" : ItemOf = 2
        CASE "yellow" : ItemOf = 3
        CASE "health" : ItemOf = IT_HEALTH
        CASE "cells", "ammo" : ItemOf = IT_CELLS
        CASE "shells" : ItemOf = IT_SHELLS
        CASE "scatter" : ItemOf = IT_SCATTER
        CASE "repeater" : ItemOf = IT_REPEATER
        CASE "armor", "armour" : ItemOf = IT_ARMOR
        CASE "medkit", "bigmed" : ItemOf = IT_BIGMED
        CASE "rail", "railgun" : ItemOf = IT_RAIL
        CASE "map" : ItemOf = IT_MAP
        CASE "overcharge" : ItemOf = IT_OVERCHARGE
        CASE "amp" : ItemOf = IT_AMP
        CASE "goggles", "nightvision", "headset" : ItemOf = IT_GOGGLES
        CASE "suit", "hazmat", "hvac" : ItemOf = IT_SUIT
        CASE "launcher", "rocketlauncher", "rocket" : ItemOf = IT_LAUNCHER
        CASE "rockets" : ItemOf = IT_ROCKETS
        CASE "rounds" : ItemOf = IT_ROUNDS
        CASE "slugs" : ItemOf = IT_SLUGS
    END SELECT
END FUNCTION

' One more line in the console's log (long ones split), and the log file
' A line may change colour part way: ^ and a digit (as Quake's console) -
' ^1 red, ^2 green, ^3 yellow, ^4 blue, ^5 cyan, ^6 magenta, ^7 white, ^8
' grey, ^9 orange, ^0 the line's own colour again (ConColour~&). The codes
' take no room: a line is cut at 96 characters you see, and the part
' carried on to the next line keeps the colour it had. The log file gets
' the words without them.
SUB ConPrint(text$)
    DIM d, f, i, l$, t$, vis, cur$, ch$, lf$, sp, spVis, spCur$ ' (its own: the main program shares these names)
    t$ = text$ : l$ = "" : vis = 0 : cur$ = "" : i = 1 : sp = 0
    DO WHILE i <= LEN(t$)
        ch$ = MID$(t$, i, 1)
        IF ch$ = "^" AND i < LEN(t$) THEN
            IF INSTR("0123456789", MID$(t$, i + 1, 1)) THEN cur$ = MID$(t$, i, 2) : l$ = l$ + cur$ : i = i + 2 : _CONTINUE
        END IF
        IF vis = 96 THEN ' (a long line: on to the next at its last space - not in the middle of a word)
            IF sp > 0 AND spVis > 48 THEN
                ConAddLine LEFT$(l$, sp - 1) : l$ = spCur$ + MID$(l$, sp + 1) : vis = vis - spVis - 1
            ELSE
                ConAddLine l$ : l$ = cur$ : vis = 0
            END IF
            sp = 0
        END IF
        IF ch$ = " " THEN sp = LEN(l$) + 1 : spVis = vis : spCur$ = cur$
        l$ = l$ + ch$ : vis = vis + 1 : i = i + 1
    LOOP
    ConAddLine l$
    IF conLogFile$ <> "" THEN
        l$ = ConPlain$(text$) ' (QB64PE's degree sign, CHR$(248), isn't one in a text file)
        DO WHILE INSTR(l$, CHR$(248)) : d = INSTR(l$, CHR$(248)) : l$ = LEFT$(l$, d - 1) + " degrees" + MID$(l$, d + 1) : LOOP
        lf$ = conLogFile$ : conLogFile$ = "" ' (off while it's written: a file that won't open can't send its own error back here)
        f = FREEFILE : OPEN lf$ FOR APPEND AS #f : PRINT #f, l$ : CLOSE #f
        conLogFile$ = lf$
    END IF
END SUB

' A command to run later (in order, one a frame - see the game loop)
SUB ConQueue(cmd$)
    DIM c$, semi ' (its own: the main program shares these names)
    c$ = LTRIM$(RTRIM$(cmd$))
    IF c$ = "" OR conQTail >= CON_QUEUE THEN EXIT SUB
    DO ' (several on one line, split by ;)
        semi = ConSemi(c$)
        IF semi THEN one$ = LEFT$(c$, semi - 1) : c$ = MID$(c$, semi + 1) ELSE one$ = c$ : c$ = ""
        IF LEFT$(LTRIM$(one$), 1) = CHR$(2) AND NOT conFromTrig THEN one$ = MID$(LTRIM$(one$), 2) ' (that mark is the level's own: never one typed or read from a file)
        IF LEN(LTRIM$(one$)) AND conQTail < CON_QUEUE THEN conQTail = conQTail + 1 : conQ$(conQTail) = LTRIM$(one$) : IF conFromTrig THEN conQ$(conQTail) = CHR$(2) + conQ$(conQTail) ' (CHR$(2): a trigger's)
    LOOP WHILE LEN(c$)
END SUB

' Commands to run next - ahead of the rest of the queue (an alias with a
' wait in it: its commands, then what came after it)
SUB ConQueueNext(cmd$)
    DIM c$, k, n, one$, semi, part$(CON_QUEUE) ' (its own: the main program shares these names)
    c$ = LTRIM$(RTRIM$(cmd$))
    DO WHILE LEN(c$) AND n < CON_QUEUE
        semi = ConSemi(c$)
        IF semi THEN one$ = LEFT$(c$, semi - 1) : c$ = MID$(c$, semi + 1) ELSE one$ = c$ : c$ = ""
        IF LEFT$(LTRIM$(one$), 1) = CHR$(2) AND NOT conFromTrig THEN one$ = MID$(LTRIM$(one$), 2)
        IF LEN(LTRIM$(one$)) THEN n = n + 1 : part$(n) = LTRIM$(one$) : IF conFromTrig THEN part$(n) = CHR$(2) + part$(n)
    LOOP
    IF conQTail + n > CON_QUEUE THEN n = CON_QUEUE - conQTail ' (no room for all of them: as many as fit)
    IF n <= 0 THEN EXIT SUB
    FOR k = conQTail TO conQHead + 1 STEP -1 : conQ$(k + n) = conQ$(k) : NEXT
    FOR k = 1 TO n : conQ$(conQHead + k) = part$(k) : NEXT
    conQTail = conQTail + n
END SUB

' Where the next ; is that splits commands - not one inside "quotes" (an
' alias's commands): 0 if there's none
FUNCTION ConSemi(c$)
    DIM k, q ' (its own: the main program shares these names)
    FOR k = 1 TO LEN(c$)
        SELECT CASE MID$(c$, k, 1)
            CASE CHR$(34) : q = NOT q
            CASE ";" : IF NOT q THEN ConSemi = k : EXIT FUNCTION
        END SELECT
    NEXT
END FUNCTION

' An alias's number, by its name (0: not one)
FUNCTION AliasOf(n$)
    DIM k ' (its own: the main program shares these names)
    FOR k = 1 TO numAlias
        IF aliasName$(k) = LCASE$(n$) THEN AliasOf = k : EXIT FUNCTION
    NEXT
END FUNCTION

' An alias run: its commands, with $1-$9 the words after its name and $*
' all of them - now, one after another (or, with a wait among them, onto
' the queue a frame at a time, as a trigger's)
SUB AliasRun(a, words$)
    DIM c$, k, one$, semi, w$, p, o$, ch$, t$ ' (its own: the main program shares these names)
    IF aliasDepth = 0 THEN aliasStop = 0 : aliasRuns = 0
    IF aliasStop THEN EXIT SUB ' (one stopped already: the rest of it with it)
    aliasRuns = aliasRuns + 1
    IF aliasDepth >= ALIAS_DEPTH OR aliasRuns > 1000 THEN ConPrint "alias " + aliasName$(a) + ": runs itself - stopped" : aliasStop = -1 : EXIT SUB
    c$ = aliasCmd$(a) : o$ = "" : p = 1
    DO WHILE p <= LEN(c$) ' ($* and $1-$9 put in, left to right: what goes in is never looked at again - a $1 among the words stays a $1)
        ch$ = MID$(c$, p, 1)
        IF ch$ = "$" AND p < LEN(c$) THEN
            t$ = MID$(c$, p + 1, 1)
            IF t$ = "*" THEN o$ = o$ + words$ : p = p + 2 : _CONTINUE
            IF t$ >= "1" AND t$ <= "9" THEN o$ = o$ + ConWord$(words$, VAL(t$)) : p = p + 2 : _CONTINUE
        END IF
        o$ = o$ + ch$ : p = p + 1
    LOOP
    c$ = o$
    IF ConHasWait(c$) THEN ConQueueNext c$ : EXIT SUB ' (next in the queue: before what was waiting already)
    aliasDepth = aliasDepth + 1
    DO WHILE LEN(c$) AND NOT aliasStop
        semi = ConSemi(c$)
        IF semi THEN one$ = LEFT$(c$, semi - 1) : c$ = MID$(c$, semi + 1) ELSE one$ = c$ : c$ = ""
        conCmd$ = one$ : ConExec
    LOOP
    aliasDepth = aliasDepth - 1
END SUB

' Is one of the commands in c$ a wait (wait FRAMES)? Then they go a frame
' at a time, on the queue
FUNCTION ConHasWait(c0$)
    DIM c$, one$, semi ' (its own: the main program shares these names)
    c$ = c0$
    DO WHILE LEN(c$)
        semi = ConSemi(c$)
        IF semi THEN one$ = LEFT$(c$, semi - 1) : c$ = MID$(c$, semi + 1) ELSE one$ = c$ : c$ = ""
        IF LCASE$(ConWord$(LTRIM$(one$), 1)) = "wait" THEN ConHasWait = -1 : EXIT FUNCTION
    LOOP
END FUNCTION

' At start-up: the saves folder's autoexec.cfg, if there is one - each line
' run at once (aliases, binds, settings: what you want every time)
SUB ConAutoexec
    DIM f, f$, l$, one$, semi ' (its own: the main program shares these names)
    f$ = SaveDir$ + "autoexec.cfg" : IF NOT _FILEEXISTS(f$) THEN EXIT SUB
    f = FREEFILE : OPEN f$ FOR INPUT AS #f
    DO UNTIL EOF(f)
        LINE INPUT #f, l$ : l$ = LTRIM$(RTRIM$(l$))
        DO WHILE LEN(l$)
            semi = ConSemi(l$)
            IF semi THEN one$ = LEFT$(l$, semi - 1) : l$ = MID$(l$, semi + 1) ELSE one$ = l$ : l$ = ""
            conCmd$ = one$ : ConExec
        LOOP
    LOOP
    CLOSE #f
    ConPrint "autoexec.cfg run"
END SUB

' A sound effect by name, for the sound command (a trigger's): opened the
' first time it's asked for, then kept - so a trigger that plays it again
' and again doesn't open it again and again - and played like any other,
' at the SFX volume
FUNCTION ConSound&(n$)
    DIM k ' (its own: the main program shares these names)
    STATIC names$(32), snds&(32), count
    FOR k = 1 TO count
        IF names$(k) = LCASE$(n$) THEN ConSound& = snds&(k) : EXIT FUNCTION
    NEXT
    s& = LoadSnd&(n$ + ".wav")
    IF s& > 0 AND count >= 32 THEN _SNDCLOSE snds&(32) : count = 31 ' (full: the last one's place is taken, not leaked)
    IF s& > 0 AND count < 32 THEN count = count + 1 : names$(count) = LCASE$(n$) : snds&(count) = s&
    ConSound& = s&
END FUNCTION

' Word n of a command, lower case (the first word is the command)
FUNCTION ConWord$(c$, n)
    DIM t$, w ' (its own: the main program shares these names)
    t$ = LTRIM$(RTRIM$(c$)) : w = 0
    DO WHILE LEN(t$)
        sp = INSTR(t$, " ") : IF sp = 0 THEN sp = LEN(t$) + 1
        w = w + 1
        IF w = n THEN ConWord$ = LCASE$(LEFT$(t$, sp - 1)) : EXIT FUNCTION
        t$ = LTRIM$(MID$(t$, sp + 1))
    LOOP
END FUNCTION

' on / off / 1 / 0 / yes / no as -1 or 0
FUNCTION ConOn(v$)
    ConOn = (v$ = "1" OR v$ = "on" OR v$ = "yes" OR v$ = "true")
END FUNCTION

' A save slot from a word: 1-NUM_SLOTS, quick (0), or -1 if it isn't one
FUNCTION SlotOf(v$)
    DIM n ' (its own: the main program shares these names)
    SlotOf = -1
    IF v$ = "quick" OR v$ = "q" OR v$ = "0" THEN SlotOf = 0 : EXIT FUNCTION
    n = VAL(v$) : IF n >= 1 AND n <= NUM_SLOTS THEN SlotOf = n
END FUNCTION

' A monster type from a word: its number or its name (or 0)
FUNCTION MonTypeOf(v$)
    DIM n, t ' (its own: the main program shares these names)
    n = VAL(v$) : IF n >= 1 AND n <= MON_TYPES THEN MonTypeOf = n : EXIT FUNCTION
    FOR t = 1 TO MON_TYPES
        IF v$ <> "" AND LEFT$(mtypeName$(t), LEN(v$)) = v$ THEN MonTypeOf = t : EXIT FUNCTION
    NEXT
END FUNCTION

' set NAME VALUE (or just NAME: show it) - any setting, by its settings
' file name (fov, renderer, display, bloom...). On/off settings take on and
' off too. It's put into effect at once, as the menu does.
SUB ConSet(nm$, v$)
    DIM k, n ' (its own: the main program shares these names)
    FOR k = 1 TO NUM_SETTINGS
        IF nm$ = setKey$(k) THEN
            IF v$ = "" THEN
                ConPrint nm$ + " = " + LTRIM$(STR$(setting(k))) + "   (" + LTRIM$(STR$(setMin(k))) + "-" + LTRIM$(STR$(setMax(k))) + ")  " + setLabel$(k) + ": " + SettingText$(k)
            ELSE
                IF v$ = "on" OR v$ = "yes" THEN n = setMax(k) ELSE IF v$ = "off" OR v$ = "no" THEN n = setMin(k) ELSE n = VAL(v$)
                IF n < setMin(k) THEN n = setMin(k)
                IF n > setMax(k) THEN n = setMax(k)
                setting(k) = n : ApplySettings : SaveSettings
                ConPrint setLabel$(k) + " = " + SettingText$(k)
            END IF
            EXIT SUB
        END IF
    NEXT
    ConPrint "No setting called " + nm$ + "  (settings lists them)"
END SUB

' bind ACTION KEY: a key binding (key_fire or fire...) to a key - a letter,
' a key code, or space / tab / enter / shift / ctrl
SUB ConBind(act$, k$)
    DIM B ' (its own: the main program shares these names)
    FOR b = 1 TO NUM_BINDS
        IF act$ = bindKey$(b) OR "key_" + act$ = bindKey$(b) THEN
            SELECT CASE k$
                CASE "" : ConPrint bindKey$(b) + " = " + KeyName$(keyBind&(b)) : EXIT SUB
                CASE "space" : c& = 32
                CASE "tab" : c& = 9
                CASE "enter" : c& = 13
                CASE "shift" : c& = 100304
                CASE "ctrl" : c& = 100306
                CASE ELSE
                    IF LEN(k$) = 1 THEN c& = ASC(LCASE$(k$)) ELSE c& = VAL(k$)
            END SELECT
            IF c& <= 0 THEN ConPrint "bind: a letter, a key code, or space / tab / enter / shift / ctrl" : EXIT SUB
            keyBind&(b) = c& : SaveSettings : ConPrint bindKey$(b) + " = " + KeyName$(c&)
            EXIT SUB
        END IF
    NEXT
    ConPrint "No action called " + act$ + "  (binds lists them)"
END SUB

' Tab: the command's name finished, if only one command starts that way
FUNCTION ConComplete$(l$)
    DIM k, n, t$, w$ ' (its own: the main program shares these names)
    ConComplete$ = l$
    IF INSTR(l$, " ") OR l$ = "" THEN EXIT FUNCTION
    all$ = ConNames$
    FOR k = 1 TO NUM_SETTINGS : all$ = all$ + setKey$(k) + " " : NEXT
    found$ = "" : n = 0 : t$ = all$
    DO WHILE LEN(t$)
        sp = INSTR(t$, " ") : w$ = LEFT$(t$, sp - 1) : t$ = MID$(t$, sp + 1)
        IF LEFT$(w$, LEN(l$)) = LCASE$(l$) THEN n = n + 1 : found$ = found$ + w$ + "  " : one$ = w$
    LOOP
    IF n = 1 THEN ConComplete$ = one$ + " " ELSE IF n > 1 THEN ConPrint found$
END FUNCTION

' Every command's name (for Tab and help)
FUNCTION ConNames$
    ConNames$ = "alias unalias turret help version map maps sectorset restart mapsize resetlevel reloadlevel savesectorcopy saveleveltodisk loadlevelfromdisk newgame finish newsector sectorname god buddha fly notarget give take kill respawn summon spawn item die tp pitch pos info status mons events triggers stations cores droids thieves secret locks loot save load quicksave quickload set get settings bind binds qb64pe edit put box block liquid raise lift lamp wall door light liftgo trigger undo savelevel hud monsters use fire kick jackin jackout program puzzle wait echo exec logfile screenshot message sound say cutscene record playdemo stopdemo demos bot achievements achieve resetachievements clear menu quit "
END FUNCTION

' help: what the commands are (or one of them, in more detail). Every
' command is here - a new one wants its line here, and its name in ConNames$
SUB ConHelp(c$)
    DIM k, t$ ' (its own: the main program shares these names)
    SELECT CASE LCASE$(c$)
        CASE ""
            ConPrint "^3^5Commands^0 - ^7help NAME^0 for more (and how each one goes); ^7;^0 separates several on a line^0:"
            ConPrint "  ^6sectors   ^7map^8 N|NAME  ^7maps  ^7sectorset^8 0-3  ^7restart  ^7newgame  ^7finish  ^7newsector"
            ConPrint "            ^7sectorname^8 NAME  ^7mapsize^8 N  ^7resetlevel  ^7reloadlevel  ^7savesectorcopy"
            ConPrint "            ^7saveleveltodisk^8 [FILE]  ^7loadlevelfromdisk^8 [FILE]"
            ConPrint "  ^6cheats    ^7god  ^7buddha  ^7fly  ^7notarget  ^7give^8 WHAT  ^7take^8 WHAT  ^7kill  ^7respawn  ^7die  ^7tp^8 X Y [ANGLE]"
            ConPrint "            ^7pitch^8 [DEG]  ^7summon^8 TYPE [N]  ^7spawn^8 TYPE X Y [N]  ^7item^8 KIND X Y"
            ConPrint "  ^6looking   ^7pos  ^7info  ^7status  ^7mons  ^7events  ^7triggers  ^7stations  ^7cores  ^7droids  ^7thieves  ^7secret"
            ConPrint "            ^7locks  ^7loot"
            ConPrint "  ^6saves     ^7save^8 N|quick  ^7load^8 N|quick  ^7quicksave  ^7quickload"
            ConPrint "  ^6settings  ^7set^8 NAME VALUE  ^7get^8 NAME  ^7settings  ^7NAME^8 [VALUE]  ^7bind^8 ACTION KEY  ^7binds"
            ConPrint "            ^7qb64pe^8 [PATH|auto]"
            ConPrint "  ^6the level ^7edit^8 [walk|off]  ^7put  ^7box  ^7block  ^7liquid  ^7raise  ^7lift  ^7lamp  ^7wall  ^7door  ^7light"
            ConPrint "            ^7liftgo  ^7trigger  ^7turret^8 WHO WHAT  ^7secret^8 X Y  ^7loot^8 BREAKABLE ...  ^7undo  ^7savelevel"
            ConPrint "  ^6playing   ^7use  ^7fire^8 [FRAMES]  ^7kick  ^7jackin  ^7jackout^8 [win]  ^7program^8 NAME  ^7puzzle^8 NAME"
            ConPrint "  ^6scripts   ^7alias^8 NAME " + CHR$(34) + "..." + CHR$(34) + "  ^7unalias^8 NAME  ^7wait^8 FRAMES  ^7echo^8 TEXT  ^7exec^8 FILE"
            ConPrint "            ^7logfile^8 FILE|off  ^7screenshot^8 [FILE]  ^7message^8 TEXT  ^7sound^8 NAME  ^7say^8 LINE"
            ConPrint "            ^7cutscene^8 [SECTOR]  (and the saves folder's ^7autoexec.cfg^0, run at start-up)"
            ConPrint "  ^6demos     ^7record^8 NAME [SEED] [quit]  ^7playdemo^8 NAME [quit]  ^7stopdemo  ^7demos"
            ConPrint "            ^7bot^8 [on|off|human N|safe]"
            ConPrint "  ^6editors   ^7hud  ^7monsters  ^7achievements  ^7achieve^8 NAME  ^7resetachievements"
            ConPrint "  ^6the rest  ^7version  ^7clear  ^7menu  ^7quit"
            ConPrint "^3^5Keys^0: ^7Up Down^8 earlier lines  ^7Tab^8 finish a name  ^7Ctrl+V^8 paste  ^7PgUp PgDn wheel^8 scroll back"
            ConPrint "  ^7Home End^8 oldest, newest  ^7F11^8 fill the screen  ^7` Esc^8 close"
            ConPrint "^3^5From the command line^0, each command starts with ^7+^0 ^0:"
            ConPrint "  ^8neon-caster.run ^7+map 5 +give all +wait 60 +screenshot five.png +quit"
        ' --- sectors
        CASE "map", "level", "sector" : ConPrint "^3map N (1-" + LTRIM$(STR$(NUM_LEVELS)) + ", yours from" + STR$(NUM_LEVELS + 1) + ") or map NAME (part of one)^0: go to that sector, keeping what you carry"
        CASE "maps", "levels", "sectors" : ConPrint "^3maps^0: every sector there is - this set's ten (sectorset changes them), then yours"
        CASE "sectorset", "campaign", "set10" : ConPrint "^3sectorset 0|1|2|3 (original, new, remix, huge)^0: which ten sectors map 1-10 and the next sector mean - THE ORIGINAL TEN, NEW SECTORS, OLD SECTORS NEW or HUGE SECTORS. sectorset on its own: which it is"
        CASE "restart", "reset" : ConPrint "^3restart^0: this sector again from its start - with what you started the game with"
        CASE "mapsize" : ConPrint "^3mapsize [N]^0: the sector's map N x N cells (16 to" + STR$(MAP_SIZE) + "; the game's are 48) - grown with wall all round, or cut down. savelevel keeps it"
        CASE "resetlevel" : ConPrint "^3resetlevel^0: the sector as it starts - monsters, doors, pickups back - as it is now in the editor, and you where you are"
        CASE "reloadlevel" : ConPrint "^3reloadlevel^0: the sector from its file, as last saved (what you'd changed since: gone) - you where you are"
        CASE "savesectorcopy", "sectorcopy" : ConPrint "^3savesectorcopy^0: a copy of the sector as it is now, in versions/ beside its file, named for when - a history to go back to"
        CASE "saveleveltodisk" : ConPrint "^3saveleveltodisk [FILE]^0: save the sector as it is now to a file - a dialog to choose it, or FILE"
        CASE "loadlevelfromdisk" : ConPrint "^3loadlevelfromdisk [FILE]^0: a level file (a dialog, or FILE) into this sector, in place of its own - savelevel or Ctrl+S keeps it"
        CASE "newgame" : ConPrint "^3newgame^0: a new game from sector 1"
        CASE "finish", "exitlevel", "nextlevel" : ConPrint "^3finish^0: as if you'd reached the exit - the tally, then the next sector"
        CASE "newsector" : ConPrint "^3newsector^0: a blank sector of your own (levels/custom/), opened in the editor - carve rooms out with . (floor), Ctrl+S saves"
        CASE "sectorname" : ConPrint "^3sectorname NAME^0: rename the sector you're in - then savelevel (or Ctrl+S in the editor) to keep it. sectorname on its own: its name"
        ' --- cheats
        CASE "god", "noclip", "iddqd" : ConPrint "^3god [on|off]^0: no damage, through walls, flying (E up, C down) and notarget - for looking round a sector (G does the same)"
        CASE "buddha" : ConPrint "^3buddha [on|off]^0: you're hurt as ever, but never below 1 health (a pit or a death trap still kills)"
        CASE "fly" : ConPrint "^3fly [on|off]^0: fly - E up, C down, Shift faster - the floor still holds you up"
        CASE "notarget" : ConPrint "^3notarget [on|off]^0: the monsters don't notice you, and hunting ones forget you"
        CASE "give" : ConPrint "give all | keys | key red|blue|yellow | weapons | gun 1-5 | ammo [cells|shells|rounds|slugs|rockets N] | health [N] | armor [N] | overcharge | amp | map | goggles | suit"
        CASE "take" : ConPrint "take all | keys | key red|blue|yellow | weapons | gun 2-5 | ammo [cells|shells|rounds|slugs|rockets N] | health N | armor [N] | map"
        CASE "turret", "turrets"
            ConPrint "^3turret [WHO WHAT [N]]^0: turrets told what to do (an ambush, from a trigger); alone: lists them"
            ConPrint "  WHO: a number (as ^7turret^0 lists them), ^7all^0, or ^7at^8 X Y [R]^0 - within R cells (2 if not said)"
            ConPrint "  WHAT: ^7eject^0 out of its housing (a held one too) - ^7retract^0 back in, and held there"
            ConPrint "  ^7off^0 still, where it is - ^7on^0 again - ^7weapon^8 NAME^0 - ^7track^8 N|slow|medium|fast^0 (degrees a second)"
            ConPrint "  ^7ejectspeed^8 N|slow|medium|fast^0 (frames to come out).  ^3turret at 20 14 4 eject^0: an ambush"
        CASE "kill", "killall" : ConPrint "^3kill^0: every monster standing falls (no loot - shoot them for that)"
        CASE "respawn" : ConPrint "^3respawn^0: every one of the level's monsters back where it started, alive"
        CASE "die", "suicide" : ConPrint "^3die [MESSAGE]^0: you die (a trigger's death trap); never in god mode or the editor"
        CASE "pitch" : ConPrint "^3pitch [DEGREES]^0: look up (+) or down (-), as far as about 34 degrees - with LOOK UP / DOWN in OpenGL; on its own, which way you're looking"
        CASE "tp", "teleport", "goto" : ConPrint "^3tp X Y [ANGLE]^0: you, to map point X Y (cells: 20.5 is the middle of cell 20), facing ANGLE degrees (0 east, 90 south)"
        CASE "summon", "spawn"
            t$ = ""
            FOR k = 1 TO MON_TYPES : t$ = t$ + "^8" + LTRIM$(STR$(k)) + " ^7" + mtypeName$(k) + "  " : NEXT
            ConPrint "^3summon TYPE [COUNT]^0: COUNT monsters (1 if not said) in front of you, hunting. spawn TYPE X Y [COUNT]: teleported into cell X Y (a trigger's ambush)"
            ConPrint "  TYPE, by name (or the start of one) or number: " + RTRIM$(t$)
            ConPrint "  ^7turret^0 (or ^7ceilingturret^0) hangs from the ceiling, ^7floorturret^0 (or ^7_^0) stands on the floor,"
            ConPrint "  ^7wallturret^0 (or ^7|^0) is in the wall you face - summoned, it's out already. Then a weapon:"
            ConPrint "  ^7plasma laser lightning flame poison acid missiles^0 - and how fast it turns:"
            ConPrint "  ^7slow medium fast track^8N^0 (degrees a second, 90 as made): ^3summon wallturret missiles slow^0"
            ConPrint "  how fast it comes out: ^7ejectslow ejectmedium ejectfast eject^8N^0 (frames, 36 as made). Summoned"
            ConPrint "  ^7hidden^0, it waits in its housing till it wakes; ^7held^0, till ^3turret^0 says (^7help turret^0)"
            ConPrint "  A turret starts facing away from you, and fires once it's turned onto you"
            ConPrint "  (ICE only hunts in the network)"
        CASE "item", "drop" : ConPrint "^3item KIND X Y^0: a pickup in cell X Y - health medkit armor cells shells rounds slugs rockets scatter repeater rail launcher map overcharge amp goggles suit red blue yellow (or its map character)"
        ' --- looking
        CASE "pos", "where" : ConPrint "^3pos^0: where you are - the sector, x y, the way you face (degrees), your feet's and eye's height (^7info^0 or F3 shows it all the time)"
        CASE "info", "f3" : ConPrint "^3info [on|off]^0: the F3 panel, top left - x y and cell, the way you face, heights, the wall you look at (its cell and map character), a tp line that brings you back, and the frame rate"
        CASE "status" : ConPrint "^3status^0: the sector, your health, armour, every gun's ammo (cells, shells, rounds, slugs, rockets), and kills of the monsters there"
        CASE "mons", "monlist" : ConPrint "^3mons^0: every monster - its number, kind, where (and how high), asleep or hunting, health, and its own sight, hearing, speed and what wakes it"
        CASE "events" : ConPrint "^3events^0: the sector's event rooms - kind, box, and waiting, going, won or lost"
        CASE "triggers" : ConPrint "^3triggers^0: the sector's triggers, numbered (trigger del N takes one away), and which have gone off"
        CASE "stations" : ConPrint "^3stations^0: the sector's data stations, and which are hacked"
        CASE "cores" : ConPrint "^3cores^0: where the network's data cores are (jacked in)"
        CASE "droids" : ConPrint "^3droids^0: where this sector's droids are and what they're doing. droids N (0-" + LTRIM$(STR$(MAX_DROIDS)) + "): this sector has N - then savelevel (or Ctrl+S) to keep it"
        CASE "thieves" : ConPrint "^3thieves^0: each thief bot - where, what it's doing, what it carries, how far from its hoard"
        CASE "secret" : ConPrint "^3secret^0: the secrets found, each one's wall and what opens it. secret X Y: open the secret wall at X Y - found (a trigger: a switch you shoot)"
        CASE "locks" : ConPrint "^3locks^0: the locked doors within 8 cells of you, and how each is locked"
        CASE "loot"
            ConPrint "^3loot^0: what each breakable may leave in this sector. Breaking one rolls 1-100 once: drop A has"
            ConPrint "  the first A%, B the next B%... (each chance as written; anything at all: them added up)"
            ConPrint "^3loot BREAKABLE DROP [DROP DROP DROP]^0: set one - each PICKUP:CHANCE (ammo shells medkit health"
            ConPrint "  armor overcharge amp...) or - for none: loot crate ammo:20 shells:20 - armor:10"
            ConPrint "^3loot BREAKABLE none^0: it leaves nothing   loot default: the game's own table again"
        ' --- saves and settings
        CASE "save", "savegame" : ConPrint "^3save 1-" + LTRIM$(STR$(NUM_SLOTS)) + " | quick^0: save the game to that slot"
        CASE "load", "loadgame" : ConPrint "^3load 1-" + LTRIM$(STR$(NUM_SLOTS)) + " | quick^0: load the game in that slot"
        CASE "quicksave" : ConPrint "^3quicksave^0: save to the quick slot (as F5)"
        CASE "quickload" : ConPrint "^3quickload^0: load the quick slot (as F9)"
        CASE "set" : ConPrint "^3set NAME VALUE^0: any setting (settings lists them); NAME on its own shows it. on/off work for switches"
        CASE "get" : ConPrint "^3get NAME^0: one setting's value"
        CASE "settings", "cvars", "cvarlist" : ConPrint "^3settings^0: every setting - its name, value, range and what it is in the menu (set NAME VALUE changes one; NAME VALUE does too)"
        CASE "bind" : ConPrint "^3bind ACTION KEY^0: a key for an action (binds lists them; KEY a letter, a number, space, or a key code). bind ACTION: its key"
        CASE "binds", "bindlist" : ConPrint "^3binds^0: every action and its key"
        CASE "qb64pe" : ConPrint "^3qb64pe PATH^0: the qb64pe the code terminals compile with (a folder with it in will do); qb64pe auto: look for it; qb64pe: which"
        ' --- the level (the editor's commands, built at once; savelevel keeps them)
        CASE "edit", "editor" : ConPrint "^3edit [walk|off]^0: the level editor (F2) - the map from above, or walk: inside it, or off: back to the game"
        CASE "put" : ConPrint "^3put X Y CHAR^0: a map character (the editor's picker and LEVEL-EDITOR-GUIDE.md have them all) into cell X Y, built at once"
        CASE "box" : ConPrint "^3box X0 Y0 X1 Y1 CHAR^0: fill that rectangle of cells with a map character"
        CASE "block", "blocks"
            ConPrint "^3block X Y X0 Y0 X1 Y1 [WALL]^0: a solid block standing in open cell X Y - a pillar, a thin wall, the back"
            ConPrint "  of an alcove. Its edges are eighths of the cell (0-8 across, then down); WALL 1-6 is the look of #, N, C, K,"
            ConPrint "  P or G. block X Y none takes it away. savelevel (or Ctrl+S in the editor) keeps it"
        CASE "liquid", "liquids", "flood"
            ConPrint "^3liquid KIND X0 Y0 X1 Y1 [DEPTH]^0: a pool over that rectangle's floor - water (slows you), slime (slows, hurts a"
            ConPrint "  little), poison (hurts), acid (eats armor first), lava (burns) - DEPTH 1-8 eighths; none drains it."
            ConPrint "  savelevel (or Ctrl+S in the editor) keeps it; a trigger can flood a room with it"
        CASE "raise" : ConPrint "^3raise X Y EIGHTHS [ceil] (or raise X0 Y0 X1 Y1 EIGHTHS [ceil])^0: a floor - or, with ceil, a ceiling - up (or down, less than 0) in eighths of a wall"
        CASE "lift" : ConPrint "^3lift X0 Y0 X1 Y1 LOW HIGH [MODE] [SPEED]^0: a lift over that box - heights in eighths; MODE 1 up and down, 2 an elevator (as made), 3 on a trigger's liftgo, 4 a crusher, 5 a smasher (LOW and HIGH then its ceiling's); SPEED eighths a second (8)"
        CASE "lamp" : ConPrint "^3lamp X Y [1-8]^0: a light over cell X Y - 1 white, 2 cyan, 3 magenta, 4 orange, 5 green, 6 red alarm, 7 flickering, 8 firelight"
        CASE "wall" : ConPrint "^3wall X Y CHAR^0: a cell changed in the running level - a wall (# N C K P G) or floor (.) - as a monster closet opens (not saved)"
        CASE "door" : ConPrint "^3door X Y open|close|lock|unlock|toggle^0: a door, as a trigger works it (toggle if nothing's said)"
        CASE "light" : ConPrint "^3light N on|off^0: one of the level's lights ([lights], from 1) - its lamp goes dark with it"
        CASE "liftgo" : ConPrint "^3liftgo N up|down^0: lift N on its way (a mode 3 lift waits for this)"
        CASE "trigger"
            ConPrint "^3trigger WHEN ... [repeat] : COMMAND | COMMAND^0 - a new trigger for this level (| for ; when typed). WHEN:"
            ConPrint "  enter X0 Y0 X1 Y1 (you walk in) - use X Y (Space on it) - shoot X Y - clear X0 Y0 X1 Y1 (no monster left) - time S"
            ConPrint "  trigger del N: take trigger N away (triggers lists them). savelevel (or Ctrl+S) keeps them"
        CASE "undo" : ConPrint "^3undo^0: the editor's last change, undone (Ctrl+Z)"
        CASE "savelevel" : ConPrint "^3savelevel^0: save the level as it is now to its file (Ctrl+S in the editor)"
        ' --- playing, scripts
        CASE "use" : ConPrint "^3use^0: press Space once - open a door, use a terminal, a vending machine, a turret control (for scripts)"
        CASE "fire" : ConPrint "^3fire [FRAMES]^0: hold the trigger that many frames (60 a second)"
        CASE "kick" : ConPrint "^3kick^0: kick (F) - a crate, a barrel, a monster"
        CASE "jackin" : ConPrint "^3jackin^0: into the nearest data station's network (testing)"
        CASE "jackout" : ConPrint "^3jackout [win]^0: out of the network - win: as if you'd hacked it; else thrown out"
        CASE "program" : ConPrint "^3program NAME^0: the computer runs neon-caster/programs/NAME.bas (built by qb64pe) - for a use trigger on a computer"
        CASE "puzzle" : ConPrint "^3puzzle NAME^0: try a code terminal's puzzle (neon-caster/puzzles/NAME.txt) - no doors at stake"
        CASE "wait" : ConPrint "^3wait FRAMES^0: hold back the commands after it (60 frames = 1 second) - for scripts and the command line"
        CASE "echo" : ConPrint "^3echo TEXT^0: print TEXT here (and to the log file)"
        CASE "exec" : ConPrint "^3exec FILE^0: run every line of a file as a command (// starts a comment) - here, or in the saves folder"
        CASE "alias"
            ConPrint "^3alias NAME " + CHR$(34) + "COMMANDS; ..." + CHR$(34) + "^0: NAME runs them - ^7$1^0 to ^7$9^0 the words after it, ^7$*^0 all of them"
            ConPrint "  ^3alias boom " + CHR$(34) + "give weapon 5; give ammo rockets" + CHR$(34) + "^0  ^3alias at " + CHR$(34) + "tp $1 $2" + CHR$(34) + "^0 - then ^7at 20.5 14.5^0"
            ConPrint "  ^7alias NAME^0 says what it is, ^7alias^0 on its own lists them. With a ^7wait^0, a frame at a time"
            ConPrint "  Put them in the saves folder's ^7autoexec.cfg^0: run every time the game starts (^7help autoexec^0)"
        CASE "unalias" : ConPrint "^3unalias NAME^0: that alias, gone"
        CASE "autoexec" : ConPrint "^3autoexec.cfg^0, in the saves folder: each line a command, run at start-up - aliases, binds, settings"
        CASE "logfile" : ConPrint "^3logfile FILE^0: everything printed here goes to FILE too; logfile off: stop"
        CASE "screenshot", "shot" : ConPrint "^3screenshot [FILE.png]^0: the next frame, to FILE (or to the saves folder) - wait a frame before quit"
        CASE "message", "msg" : ConPrint "^3message TEXT^0: TEXT on screen, as a pickup's message"
        CASE "sound", "sfx" : ConPrint "^3sound NAME^0: play a sound effect (neon-caster/sfx/NAME.wav)"
        CASE "say" : ConPrint "^3say LINE^0: NEXUS speaks a line by its key (say taunt3) - the lines are in speech.txt"
        CASE "cutscene" : ConPrint "^3cutscene [SECTOR]^0: play a sector's transmission (this one's, or SECTOR's)"
        ' --- demos
        CASE "record" : ConPrint "^3record NAME [SEED] [quit]^0: this sector again from its start, recorded as a demo - every key, frame by frame - till the exit (or stopdemo). quit: the game ends when it's saved"
        CASE "playdemo", "demo" : ConPrint "^3playdemo NAME [quit]^0: a demo played back, exactly as it was played (quit: the game ends with it, for tests)"
        CASE "stopdemo" : ConPrint "^3stopdemo^0: stop recording (it's saved) or playing a demo"
        CASE "demos" : ConPrint "^3demos^0: the demos there are (saves/demos, then the game's own)"
        CASE "bot", "autopilot" : ConPrint "^3bot [on|off]^0: the autopilot plays the sector - the exit, keycards, monsters in sight (record a demo of it). bot human 0-100: how human it plays. bot safe on|off: buddha with it"
        ' --- editors, achievements, the rest
        CASE "hud" : ConPrint "^3hud^0: the HUD layout editor. hud off: leave it; hud save: write hud.txt as it is; hud reset: the layout as it was made"
        CASE "monsters" : ConPrint "^3monsters^0: the monster editor (every kind's numbers). monsters save: write monsters.txt as they are"
        CASE "achievements", "ach" : ConPrint "^3achievements^0: every one - got it or not, and how far a counted one's got"
        CASE "achieve" : ConPrint "^3achieve NAME^0: unlock one by its name (achievements lists them) - testing, a cheat"
        CASE "resetachievements" : ConPrint "^3resetachievements^0: every achievement and stat back to nothing"
        CASE "version" : ConPrint "^3version^0: which NEON-CASTER this is"
        CASE "clear", "cls" : ConPrint "^3clear^0: empty the console"
        CASE "menu" : ConPrint "^3menu^0: the menu (Esc)"
        CASE "quit", "exit" : ConPrint "^3quit^0: leave the game"
        CASE "help", "?", "commands" : ConPrint "^3help [NAME]^0: the commands, or one of them in more detail"
        CASE ELSE
            FOR k = 1 TO NUM_SETTINGS
                IF LCASE$(c$) = setKey$(k) THEN ConPrint "^3" + c$ + " [VALUE]^0: a setting - " + setLabel$(k) + " (" + LTRIM$(STR$(setMin(k))) + "-" + LTRIM$(STR$(setMax(k))) + "), now" + STR$(setting(k)) : EXIT SUB
            NEXT
            ConPrint "^3help^0: no command " + c$ + " (help lists them)"
    END SELECT
END SUB

' The console, drawn over the top of the screen: its log, and the line
' being typed with a blinking cursor
SUB DrawConsole(l$)
    DIM i, y, v$, rows, h, first, last ' (its own: the main program shares these names)
    rows = ConRows : h = rows * 16 + 28
    IF conBack > conLogN - rows THEN conBack = conLogN - rows ' (no further back than the oldest line kept)
    IF conBack < 0 THEN conBack = 0
    LINE (0, 0)-(799, h), _RGBA32(6, 2, 18, 225), BF
    LINE (0, h)-(799, h + 1), _RGB32(255, 60, 200), BF
    last = conLogN - conBack : first = last - rows + 1 : IF first < 1 THEN first = 1
    y = 4
    FOR i = first TO last
        IF LEFT$(conLog$(i), 1) = "]" THEN col~& = _RGB32(255, 220, 120) ELSE col~& = _RGB32(170, 230, 255)
        ConDrawLine 6, y, conLog$(i), col~& : y = y + 16
    NEXT
    IF conBack THEN ' Scrolled back: how far, and the way down again
        v$ = " ^^^ " + LTRIM$(STR$(conBack)) + " lines back - PgDn or End for the newest ^^^ "
        LINE (0, h - 42)-(799, h - 26), _RGBA32(60, 10, 70, 235), BF
        COLOR _RGB32(255, 120, 230) : _PRINTSTRING ((800 - 8 * LEN(v$)) \ 2, h - 41), v$
    END IF
    cur$ = "" : IF INT(TIMER * 3) MOD 2 THEN cur$ = "_"
    v$ = l$ : IF LEN(v$) > 70 THEN v$ = "..." + RIGHT$(v$, 67) ' (a long line - a paste: its end, where you're typing)
    COLOR _RGB32(255, 255, 255) : _PRINTSTRING (6, h - 20), "] " + v$ + cur$
    COLOR _RGB32(120, 110, 160) : _PRINTSTRING (800 - 8 * 23, h - 20), "CONSOLE  PGUP F11 ` ESC"
END SUB

' How many of the log's lines the console shows: 19 across the top of the
' screen, or 35 when F11 has it fill it
FUNCTION ConRows
    IF conTall THEN ConRows = 35 ELSE ConRows = 19
END FUNCTION

' A screenshot SUB _GL read back (glShotMem, upside down - OpenGL counts
' rows from the bottom): turned the right way up into an image, saved
SUB SaveGLShot
    img& = _NEWIMAGE(glShotW, glShotH, 32)
    DIM dst AS _MEM : dst = _MEMIMAGE(img&)
    rowB& = glShotW * 4
    FOR y& = 0 TO glShotH - 1
        _MEMCOPY glShotMem, glShotMem.OFFSET + (glShotH - 1 - y&) * rowB&, rowB& TO dst, dst.OFFSET + y& * rowB&
    NEXT
    _MEMFREE dst
    SetOpaque img& ' (the window's pixels have no meaningful alpha: make them solid)
    _SAVEIMAGE shotFile$, img& : _FREEIMAGE img&
    _MEMFREE glShotMem : glShotReq = 0
    ConPrint "saved " + shotFile$ : shotFile$ = ""
END SUB

' One more line in the console's log (the oldest gone, when it's full)
SUB ConAddLine(l$)
    DIM i ' (its own: the main program shares these names)
    IF conLogN = CON_LOG THEN
        FOR i = 1 TO CON_LOG - 1 : conLog$(i) = conLog$(i + 1) : NEXT
    ELSE
        conLogN = conLogN + 1
    END IF
    conLog$(conLogN) = l$
    IF conBack THEN conBack = conBack + 1 ' (scrolled back: the same lines stay in view)
END SUB

' A console line at (x, y), in colour c~& - and the colours its ^ codes say
SUB ConDrawLine(x, y, l$, c~&)
    DIM i, cx, seg$, now~&, ch$ ' (its own: the main program shares these names)
    cx = x : now~& = c~& : seg$ = "" : i = 1
    DO WHILE i <= LEN(l$)
        ch$ = MID$(l$, i, 1)
        IF ch$ = "^" AND i < LEN(l$) THEN
            IF INSTR("0123456789", MID$(l$, i + 1, 1)) THEN
                IF LEN(seg$) THEN COLOR now~& : _PRINTSTRING (cx, y), seg$ : cx = cx + 8 * LEN(seg$) : seg$ = ""
                now~& = ConColour~&(VAL(MID$(l$, i + 1, 1)), c~&) : i = i + 2 : _CONTINUE
            END IF
        END IF
        seg$ = seg$ + ch$ : i = i + 1
    LOOP
    IF LEN(seg$) THEN COLOR now~& : _PRINTSTRING (cx, y), seg$
END SUB

' Colour code k (^0-^9): 0 the line's own (c~&)
FUNCTION ConColour~&(k, c~&)
    SELECT CASE k
        CASE 1 : ConColour~& = _RGB32(255, 90, 110) ' red
        CASE 2 : ConColour~& = _RGB32(110, 255, 150) ' green
        CASE 3 : ConColour~& = _RGB32(255, 220, 110) ' yellow
        CASE 4 : ConColour~& = _RGB32(120, 160, 255) ' blue
        CASE 5 : ConColour~& = _RGB32(110, 235, 255) ' cyan
        CASE 6 : ConColour~& = _RGB32(255, 100, 220) ' magenta
        CASE 7 : ConColour~& = _RGB32(255, 255, 255) ' white
        CASE 8 : ConColour~& = _RGB32(135, 130, 170) ' grey
        CASE 9 : ConColour~& = _RGB32(255, 160, 70) ' orange
        CASE ELSE : ConColour~& = c~&
    END SELECT
END FUNCTION

' A console line without its colour codes (for the log file)
FUNCTION ConPlain$(t$)
    DIM i, o$ ' (its own: the main program shares these names)
    i = 1
    DO WHILE i <= LEN(t$)
        IF MID$(t$, i, 1) = "^" AND i < LEN(t$) THEN
            IF INSTR("0123456789", MID$(t$, i + 1, 1)) THEN i = i + 2 : _CONTINUE
        END IF
        o$ = o$ + MID$(t$, i, 1) : i = i + 1
    LOOP
    ConPlain$ = o$
END FUNCTION

' A monster just summoned or spawned (the last): a turret's mount (TURRET_),
' weapon (TW_ - or -1, as every one is: plasma) and how fast it turns
' (degrees a second, 0 as made)
SUB SumTurret(t, mount, weap, track, ej, mode)
    IF t <> MT_TURRET THEN EXIT SUB
    monFrom(numMonsters) = mount : IF weap >= 0 THEN monWeap(numMonsters) = weap
    IF track > 0 THEN monTrack(numMonsters) = track
    IF ej > 0 THEN monEject(numMonsters) = TURRET_UP / ej
    IF mode >= 0 THEN monTMode(numMonsters) = mode : monDeploy(numMonsters) = 0 ' (hidden or held: in its housing to start with)
    IF mode = TURRET_AUTO THEN monsterState(numMonsters) = 0 : monsterTimer(numMonsters) = 0 ' (hidden: asleep till it sees you - SpawnMonster had it hunting)
    monAimA(numMonsters) = DAtan2(dirY, dirX) ' (pointing the way you face: away from you - it has to turn round first)
    IF mount = TURRET_WALL THEN ' (in the wall you face)
        turPrefX = 0 : turPrefY = 0
        IF ABS(dirX) > ABS(dirY) THEN turPrefX = -SGN(dirX) ELSE turPrefY = -SGN(dirY)
        TurretMount numMonsters : turPrefX = 0 : turPrefY = 0
    END IF
END SUB

' A cell a command names, kept on the map (inside its wall all round):
' tp 9999 9999 and the like land at the edge, not off it
FUNCTION ConCell(v)
    ConCell = MaxOf(1, MinOf(mapN - 2, INT(v)))
END FUNCTION

' Is n$ a setting's name (fov, sfx...)? - typed on its own, it's that setting
FUNCTION ConIsSetting(n$)
    DIM k ' (its own: the main program shares these names)
    FOR k = 1 TO NUM_SETTINGS
        IF n$ = setKey$(k) THEN ConIsSetting = -1 : EXIT FUNCTION
    NEXT
END FUNCTION
