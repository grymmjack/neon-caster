''
' NEON-CASTER - MENU/SOUNDTEST.BM
' =============================================================================
' SOUND TEST: loading its list, playing a sound, flagging one.
'

' --- The list, once: soundtest.txt's [CATEGORY] lines and path|name lines,
' and the flags saved last time
SUB StLoad STATIC
    DIM f, l$, b, b2, i, p$, r$ ' (its own)
    IF stLoaded THEN EXIT SUB
    stLoaded = -1 : stCats = 0 : stN = 0
    p$ = AssetPath$("sfx/soundtest.txt") : IF NOT _FILEEXISTS(p$) THEN EXIT SUB
    f = FREEFILE : OPEN p$ FOR INPUT AS #f
    DO UNTIL EOF(f)
        LINE INPUT #f, l$ : l$ = _TRIM$(l$)
        IF LEFT$(l$, 1) = "[" THEN
            IF stCats < ST_CATS THEN stCats = stCats + 1 : stCat$(stCats) = MID$(l$, 2, LEN(l$) - 2)
        ELSEIF LEN(l$) AND stCats > 0 AND stN < ST_MAX THEN
            b = INSTR(l$, "|") : IF b = 0 THEN b = LEN(l$) + 1
            stN = stN + 1 : stFile$(stN) = LEFT$(l$, b - 1) : stName$(stN) = MID$(l$, b + 1) : stOf(stN) = stCats : stFlagged(stN) = 0 : stReview(stN) = 0 : stNote$(stN) = ""
        END IF
    LOOP
    CLOSE #f
    p$ = SaveDir$ + "soundflags.txt"
    IF _FILEEXISTS(p$) THEN
        f = FREEFILE : OPEN p$ FOR INPUT AS #f
        DO UNTIL EOF(f)
            LINE INPUT #f, l$ : b = INSTR(l$, "|") : IF b THEN l$ = LEFT$(l$, b - 1)
            FOR i = 1 TO stN
                IF stFile$(i) = l$ THEN stFlagged(i) = -1
            NEXT
        LOOP
        CLOSE #f
    END IF
    p$ = SaveDir$ + "soundreview.txt" ' (path|OK or NOTE|the note|name)
    IF _FILEEXISTS(p$) THEN
        f = FREEFILE : OPEN p$ FOR INPUT AS #f
        DO UNTIL EOF(f)
            LINE INPUT #f, l$
            IF LEFT$(l$, 1) <> "#" THEN
                b = INSTR(l$, "|")
                IF b THEN
                    FOR i = 1 TO stN
                        IF stFile$(i) = LEFT$(l$, b - 1) THEN
                            r$ = MID$(l$, b + 1) : b2 = INSTR(r$, "|") : IF b2 = 0 THEN b2 = LEN(r$) + 1
                            IF LEFT$(r$, b2 - 1) = "OK" THEN stReview(i) = 1
                            IF LEFT$(r$, b2 - 1) = "NOTE" THEN
                                r$ = MID$(r$, b2 + 1) : b2 = INSTR(r$, "|") : IF b2 = 0 THEN b2 = LEN(r$) + 1
                                stReview(i) = 2 : stNote$(i) = LEFT$(r$, b2 - 1)
                            END IF
                        END IF
                    NEXT
                END IF
            END IF
        LOOP
        CLOSE #f
    END IF
END SUB

' How many sounds category c has - all (what 0), flagged (-1), marked OK (1) or with a note (2)
FUNCTION StCount(c, what)
    DIM i, n ' (its own)
    FOR i = 1 TO stN
        IF stOf(i) = c THEN
            SELECT CASE what
                CASE 0 : n = n + 1
                CASE -1 : IF stFlagged(i) THEN n = n + 1
                CASE ELSE : IF stReview(i) = what THEN n = n + 1
            END SELECT
        END IF
    NEXT
    StCount = n
END FUNCTION

' --- Your review: O marks sound n OK (again: unmarks it); N starts a note (StTypeKey types it)
SUB StMarkOK(n) STATIC
    IF stReview(n) = 1 THEN stReview(n) = 0 ELSE stReview(n) = 1 : stNote$(n) = ""
    StSaveReview
END SUB

' A key while a note's being typed: Enter keeps it (empty: no note), Esc drops it, Backspace
' rubs out, anything printable is typed
SUB StTypeKey STATIC
    SELECT CASE keyCode&
        CASE 13
            stNote$(stTyping) = _TRIM$(stTyped$)
            IF LEN(stNote$(stTyping)) THEN stReview(stTyping) = 2 ELSE IF stReview(stTyping) = 2 THEN stReview(stTyping) = 0
            stTyping = 0 : StSaveReview : PlaySfx sndMenuSelect&, 0.6
        CASE 27
            stTyping = 0 : PlaySfx sndMenuBack&, 0.6
        CASE 8
            IF LEN(stTyped$) THEN stTyped$ = LEFT$(stTyped$, LEN(stTyped$) - 1)
        CASE 32 TO 126
            IF LEN(stTyped$) < 80 AND keyCode& <> 124 THEN stTyped$ = stTyped$ + CHR$(keyCode&) ' (not |: it splits the file's fields)
    END SELECT
    IF menuSel > 0 THEN miInfo$(menuSel) = StInfo$(miRef(menuSel))
END SUB

' Save every review: one path|OK or NOTE|the note|name a line
SUB StSaveReview STATIC
    DIM f, i ' (its own)
    f = FREEFILE : OPEN SaveDir$ + "soundreview.txt" FOR OUTPUT AS #f
    PRINT #f, "# SOUND TEST review: path|OK or NOTE|the note|name"
    FOR i = 1 TO stN
        IF stReview(i) = 1 THEN PRINT #f, stFile$(i) + "|OK||" + stName$(i)
        IF stReview(i) = 2 THEN PRINT #f, stFile$(i) + "|NOTE|" + stNote$(i) + "|" + stName$(i)
    NEXT
    CLOSE #f
END SUB

' The menu line beside sound n: its name - and OK, or its note (or the note being typed), and
' * if it's flagged. 50 small letters fit.
FUNCTION StInfo$(n)
    DIM i$, c$ ' (its own)
    i$ = stName$(n)
    IF stTyping = n THEN
        c$ = " " : IF (menuT \ 15) MOD 2 = 0 THEN c$ = "_"
        i$ = "NOTE> " + RIGHT$(stTyped$, 43) + c$
    ELSEIF stReview(n) = 1 THEN
        i$ = "OK  " + i$
    ELSEIF stReview(n) = 2 THEN
        i$ = "NOTE  " + LEFT$(i$, 16) + ": " + stNote$(n)
    END IF
    IF stFlagged(n) AND stTyping <> n THEN i$ = "* " + i$
    IF LEN(i$) > 50 THEN i$ = LEFT$(i$, 49) + "~"
    StInfo$ = i$
END FUNCTION

' --- Play sound n (the one before stops): a track loops at MUSIC VOLUME in
' place of the menu's music, a voice at SPEECH VOLUME, a sound at SFX VOLUME
SUB StPlay(n) STATIC
    DIM p$ ' (its own)
    StStop
    p$ = AssetPath$(stFile$(n)) : IF NOT _FILEEXISTS(p$) THEN EXIT SUB
    IF LEFT$(stFile$(n), 6) = "music/" THEN
        IF nowPlaying& > 0 THEN stMusicWas& = nowPlaying& : _SNDSTOP nowPlaying& : nowPlaying& = 0
        stSnd& = _SNDOPEN(p$, "stream, noasync")
        IF stSnd& > 0 THEN _SNDVOL stSnd&, setting(SET_MUSIC) / 100 : _SNDLOOP stSnd&
    ELSE
        stSnd& = _SNDOPEN(p$, "noasync") : SoftenSound stSnd&, softenNow ' (as the game plays it)
        IF stSnd& > 0 THEN
            IF LEFT$(stFile$(n), 7) = "speech/" THEN _SNDVOL stSnd&, setting(SET_SPEECH) / 100 ELSE _SNDVOL stSnd&, setting(SET_SFX) / 100
            _SNDPLAY stSnd&
        END IF
    END IF
    stNow = n
END SUB

' Stop the sound playing (a track: the music it stopped comes back)
SUB StStop STATIC
    DIM m& ' (its own)
    IF stSnd& > 0 THEN _SNDSTOP stSnd& : _SNDCLOSE stSnd& : stSnd& = 0
    IF stMusicWas& > 0 THEN m& = stMusicWas& : stMusicWas& = 0 : PlayMusic m&
    stNow = 0
END SUB

' --- Flag sound n (or unflag it), and save the flags: one path|name a line
SUB StFlag(n) STATIC
    DIM f, i ' (its own)
    stFlagged(n) = NOT stFlagged(n)
    f = FREEFILE : OPEN SaveDir$ + "soundflags.txt" FOR OUTPUT AS #f
    FOR i = 1 TO stN
        IF stFlagged(i) THEN PRINT #f, stFile$(i) + "|" + stName$(i)
    NEXT
    CLOSE #f
END SUB
