''
' NEON-CASTER - MENU/SOUNDTEST.BM
' =============================================================================
' SOUND TEST: loading its list, playing a sound, flagging one.
'

' --- The list, once: soundtest.txt's [CATEGORY] lines and path|name lines,
' and the flags saved last time
SUB StLoad STATIC
    DIM f, l$, b, b2, i, p$, r$ ' (its own)
    IF stLoaded THEN EXIT SUB
    stLoaded = -1 : stCats = 0 : stN = 0
    p$ = AssetPath$("sfx/soundtest.txt") : IF NOT _FILEEXISTS(p$) THEN EXIT SUB
    f = FREEFILE : OPEN p$ FOR INPUT AS #f
    DO UNTIL EOF(f)
        LINE INPUT #f, l$ : l$ = _TRIM$(l$)
        IF LEFT$(l$, 1) = "[" THEN
            IF stCats < ST_CATS THEN stCats = stCats + 1 : stCat$(stCats) = MID$(l$, 2, LEN(l$) - 2)
        ELSEIF LEN(l$) AND stCats > 0 AND stN < ST_MAX THEN
            b = INSTR(l$, "|") : IF b = 0 THEN b = LEN(l$) + 1
            stN = stN + 1 : stFile$(stN) = LEFT$(l$, b - 1) : stName$(stN) = MID$(l$, b + 1) : stOf(stN) = stCats : stFlagged(stN) = 0 : stReview(stN) = 0 : stNote$(stN) = ""
        END IF
    LOOP
    CLOSE #f
    p$ = SaveDir$ + "soundflags.txt"
    IF _FILEEXISTS(p$) THEN
        f = FREEFILE : OPEN p$ FOR INPUT AS #f
        DO UNTIL EOF(f)
            LINE INPUT #f, l$ : b = INSTR(l$, "|") : IF b THEN l$ = LEFT$(l$, b - 1)
            FOR i = 1 TO stN
                IF stFile$(i) = l$ THEN stFlagged(i) = -1
            NEXT
        LOOP
        CLOSE #f
    END IF
    p$ = SaveDir$ + "soundreview.txt" ' (path|OK or NOTE|the note|name)
    IF _FILEEXISTS(p$) THEN
        f = FREEFILE : OPEN p$ FOR INPUT AS #f
        DO UNTIL EOF(f)
            LINE INPUT #f, l$
            IF LEFT$(l$, 1) <> "#" THEN
                b = INSTR(l$, "|")
                IF b THEN
                    FOR i = 1 TO stN
                        IF stFile$(i) = LEFT$(l$, b - 1) THEN
                            r$ = MID$(l$, b + 1) : b2 = INSTR(r$, "|") : IF b2 = 0 THEN b2 = LEN(r$) + 1
                            IF LEFT$(r$, b2 - 1) = "OK" THEN stReview(i) = 1
                            IF LEFT$(r$, b2 - 1) = "NOTE" THEN
                                r$ = MID$(r$, b2 + 1) : b2 = INSTR(r$, "|") : IF b2 = 0 THEN b2 = LEN(r$) + 1
                                stReview(i) = 2 : stNote$(i) = LEFT$(r$, b2 - 1)
                            END IF
                        END IF
                    NEXT
                END IF
            END IF
        LOOP
        CLOSE #f
    END IF
END SUB

' How many sounds category c has - all (what 0), flagged (-1), marked OK (1) or with a note (2)
FUNCTION StCount(c, what)
    DIM i, n ' (its own)
    FOR i = 1 TO stN
        IF stOf(i) = c THEN
            SELECT CASE what
                CASE 0 : n = n + 1
                CASE -1 : IF stFlagged(i) THEN n = n + 1
                CASE ELSE : IF stReview(i) = what THEN n = n + 1
            END SELECT
        END IF
    NEXT
    StCount = n
END FUNCTION

' --- Your review: O marks sound n OK (again: unmarks it); N starts a note (StTypeKey types it)
SUB StMarkOK(n) STATIC
    IF stReview(n) = 1 THEN stReview(n) = 0 ELSE stReview(n) = 1 : stNote$(n) = ""
    StSaveReview
END SUB

' A key while a note's being typed: Enter keeps it (empty: no note), Esc drops it, Backspace
' rubs out, anything printable is typed
SUB StTypeKey STATIC
    SELECT CASE keyCode&
        CASE 13
            stNote$(stTyping) = _TRIM$(stTyped$)
            IF LEN(stNote$(stTyping)) THEN stReview(stTyping) = 2 ELSE IF stReview(stTyping) = 2 THEN stReview(stTyping) = 0
            stTyping = 0 : StSaveReview : PlaySfx sndMenuSelect&, 0.6
        CASE 27
            stTyping = 0 : PlaySfx sndMenuBack&, 0.6
        CASE 8
            IF LEN(stTyped$) THEN stTyped$ = LEFT$(stTyped$, LEN(stTyped$) - 1)
        CASE 32 TO 126
            IF LEN(stTyped$) < 80 AND keyCode& <> 124 THEN stTyped$ = stTyped$ + CHR$(keyCode&) ' (not |: it splits the file's fields)
    END SELECT
    IF menuSel > 0 THEN miInfo$(menuSel) = StInfo$(miRef(menuSel))
END SUB

' Save every review: one path|OK or NOTE|the note|name a line
SUB StSaveReview STATIC
    DIM f, i ' (its own)
    f = FREEFILE : OPEN SaveDir$ + "soundreview.txt" FOR OUTPUT AS #f
    PRINT #f, "# SOUND TEST review: path|OK or NOTE|the note|name"
    FOR i = 1 TO stN
        IF stReview(i) = 1 THEN PRINT #f, stFile$(i) + "|OK||" + stName$(i)
        IF stReview(i) = 2 THEN PRINT #f, stFile$(i) + "|NOTE|" + stNote$(i) + "|" + stName$(i)
    NEXT
    CLOSE #f
END SUB

' The menu line beside sound n: its name - and OK, or its note (or the note being typed), and
' * if it's flagged. 50 small letters fit.
FUNCTION StInfo$(n)
    DIM i$, c$ ' (its own)
    i$ = stName$(n)
    IF stTyping = n THEN
        c$ = " " : IF (menuT \ 15) MOD 2 = 0 THEN c$ = "_"
        i$ = "NOTE> " + RIGHT$(stTyped$, 43) + c$
    ELSEIF stReview(n) = 1 THEN
        i$ = "OK  " + i$
    ELSEIF stReview(n) = 2 THEN
        i$ = "NOTE  " + LEFT$(i$, 16) + ": " + stNote$(n)
    END IF
    IF stFlagged(n) AND stTyping <> n THEN i$ = "* " + i$
    IF LEN(i$) > 50 THEN i$ = LEFT$(i$, 49) + "~"
    StInfo$ = i$
END FUNCTION

' --- Play sound n (the one before stops): a track loops at MUSIC VOLUME in
' place of the menu's music, a voice at SPEECH VOLUME, a sound at SFX VOLUME.
' A track is opened whole (not streamed, as the game's music is - they're
' under a minute) so the player can read its samples too.
SUB StPlay(n) STATIC
    DIM p$, m& ' (its own)
    m& = stMusicWas& : stMusicWas& = 0 : StStop : stMusicWas& = m& ' (the one before stops - but the music it stopped stays stopped)
    IF nowPlaying& > 0 THEN stMusicWas& = nowPlaying& : _SNDSTOP nowPlaying& : nowPlaying& = 0 ' (every sound, not just a track: heard on its own, the menu's music waits till you leave)
    p$ = AssetPath$(stFile$(n)) : IF NOT _FILEEXISTS(p$) THEN EXIT SUB
    stLoops = LEFT$(stFile$(n), 6) = "music/"
    IF stLoops THEN
        stSnd& = _SNDOPEN(StFileBytes$(p$), "memory, noasync") ' (from its bytes: the file itself is the game's stream already, and opening it again hands back that - with no samples to read)
        IF stSnd& > 0 THEN _SNDVOL stSnd&, setting(SET_MUSIC) / 100
    ELSE
        stSnd& = _SNDOPEN(p$, "noasync") ' (the game's own copy of it - softened if SOFTEN HIGHS is on)
        IF stSnd& > 0 THEN
            IF LEFT$(stFile$(n), 7) = "speech/" THEN _SNDVOL stSnd&, setting(SET_SPEECH) / 100 ELSE _SNDVOL stSnd&, setting(SET_SFX) / 100
        END IF
    END IF
    IF stSnd& <= 0 THEN stSnd& = 0 : EXIT SUB
    StReadWave
    IF stFrames = 0 THEN StReadViz p$ ' (no samples to read: the ones music/viz.py worked out)
    StGainSet
    IF stLoops THEN _SNDLOOP stSnd& ELSE _SNDPLAY stSnd&
    stNow = n : stAutoWait = 0 : stLastPos = 0
    stArr = 0
    IF stLoops THEN ' (its arrangement, if the .ogg is the one the .arr makes)
        ArLoad StTrackName$(n), 0
        IF arLoaded AND arSeqN > 0 THEN stArr = ABS(ArSeqBars& * 240 / arBpm - stLen) < 1.5
    END IF
END SUB

' A track's name: music/level1.ogg is level1
FUNCTION StTrackName$(n)
    DIM f$, b ' (its own)
    f$ = MID$(stFile$(n), _INSTRREV(stFile$(n), "/") + 1) : b = _INSTRREV(f$, ".") : IF b THEN f$ = LEFT$(f$, b - 1)
    StTrackName$ = f$
END FUNCTION

' Where s# seconds into an arranged track is: its block k, and the take's bar b
SUB StArrAt(s#, k, b)
    DIM n&, i, w, before& ' (its own)
    k = 0 : b = 0 : IF NOT stArr THEN EXIT SUB
    n& = INT(s# * arBpm / 240)
    FOR i = 1 TO arSeqN
        IF n& < before& + ArBlockBars(i) THEN
            w = arClipB(arSeqClip(i)) - arClipA(arSeqClip(i)) + 1
            k = i : b = arClipA(arSeqClip(i)) + (n& - before&) MOD w : EXIT SUB
        END IF
        before& = before& + ArBlockBars(i)
    NEXT
END SUB

' A file's bytes, whole
FUNCTION StFileBytes$(p$)
    DIM f, b$ ' (its own)
    f = FREEFILE : OPEN p$ FOR BINARY ACCESS READ AS #f
    b$ = SPACE$(LOF(f)) : GET #f, , b$
    CLOSE #f
    StFileBytes$ = b$
END FUNCTION

' Stop the sound playing (and the music it stopped comes back)
SUB StStop STATIC
    DIM m& ' (its own)
    IF stSnd& > 0 THEN _SNDSTOP stSnd& : _SNDCLOSE stSnd& : stSnd& = 0
    IF stMusicWas& > 0 THEN m& = stMusicWas& : stMusicWas& = 0 : PlayMusic m&
    stNow = 0 : stFrames = 0 : stLen = 0 : stSeekDrag = 0 : stArr = 0 : REDIM stWave(0) AS SINGLE : stVizOn = 0 : stVizSp$ = "" : stVizSc$ = "" : stVizPts = 0
END SUB

' The playing sound's samples, mixed to one channel, into stWave() - and the
' seek bar's waveform from them. (Copied out of the sound engine's memory into
' an array first, as SoftenSound does: much quicker than a sample at a time.)
SUB StReadWave
    DIM m AS _MEM, mb AS _MEM, bps, ch, c, total AS LONG, i AS LONG, f AS LONG, col, v!, lo!, hi! ' (its own)
    stFrames = 0 : stLen = _SNDLEN(stSnd&) : stRate = _SNDRATE
    m = _MEMSOUND(stSnd&)
    IF m.SIZE = 0 THEN EXIT SUB
    SELECT CASE m.TYPE
        CASE 260 : bps = 4 ' (32-bit floating point)
        CASE 130 : bps = 2 ' (16-bit)
        CASE ELSE : _MEMFREE m : EXIT SUB
    END SELECT
    ch = m.ELEMENTSIZE \ bps : IF ch < 1 THEN _MEMFREE m : EXIT SUB
    stFrames = m.SIZE \ m.ELEMENTSIZE : total = stFrames * ch
    IF stFrames < 1 THEN _MEMFREE m : EXIT SUB
    IF stLen > 0 THEN stRate = stFrames / stLen ELSE stLen = stFrames / stRate ' (the samples' own rate, whatever the engine unpacked it to)
    REDIM stWave(stFrames - 1) AS SINGLE
    IF bps = 4 THEN
        DIM bufS(total - 1) AS SINGLE
        mb = _MEM(bufS()) : _MEMCOPY m, m.OFFSET, m.SIZE TO mb, mb.OFFSET
        FOR f = 0 TO stFrames - 1
            v! = 0
            FOR c = 0 TO ch - 1 : v! = v! + bufS(f * ch + c) : NEXT
            stWave(f) = v! / ch
        NEXT
    ELSE
        DIM bufI(total - 1) AS INTEGER
        mb = _MEM(bufI()) : _MEMCOPY m, m.OFFSET, m.SIZE TO mb, mb.OFFSET
        FOR f = 0 TO stFrames - 1
            v! = 0
            FOR c = 0 TO ch - 1 : v! = v! + bufI(f * ch + c) : NEXT
            stWave(f) = v! / ch / 32768
        NEXT
    END IF
    _MEMFREE mb : _MEMFREE m
    FOR col = 0 TO ST_OVW - 1 ' The seek bar's waveform: each column the lowest and highest of its stretch
        lo! = 0 : hi! = 0
        FOR i = CLNG(col) * stFrames \ ST_OVW TO MaxOfL(CLNG(col) * stFrames \ ST_OVW, (CLNG(col) + 1) * stFrames \ ST_OVW - 1)
            IF i < stFrames THEN
                IF stWave(i) < lo! THEN lo! = stWave(i)
                IF stWave(i) > hi! THEN hi! = stWave(i)
            END IF
        NEXT
        stOvMin(col) = lo! : stOvMax(col) = hi!
    NEXT
END SUB

' A track's NAME.viz (music/viz.py's - its format is there): the seek bar's waveform into
' stOvMin / stOvMax, and the spectrum's bytes into stVizSp$
SUB StReadViz(p$)
    DIM v$, d$, h$, e, col, b1, b2 ' (its own)
    stVizOn = 0 : stVizSp$ = "" : stVizSc$ = "" : stVizPts = 0
    v$ = LEFT$(p$, _INSTRREV(p$, ".")) + "viz" : IF NOT _FILEEXISTS(v$) THEN EXIT SUB
    d$ = _INFLATE$(StFileBytes$(v$))
    e = INSTR(d$, CHR$(10)) : IF e = 0 OR LEFT$(d$, 6) <> "NCVIZ " THEN EXIT SUB
    h$ = MID$(d$, 7, e - 7) + " " ' ("FPS BANDS FRAMES" - each read up to its space: VAL skips spaces, and would read all three as one)
    stVizFPS = VAL(LEFT$(h$, INSTR(h$, " "))) : h$ = MID$(h$, INSTR(h$, " ") + 1)
    IF VAL(LEFT$(h$, INSTR(h$, " "))) <> ST_BANDS OR stVizFPS < 1 THEN EXIT SUB
    h$ = MID$(h$, INSTR(h$, " ") + 1) : stVizFrames = VAL(LEFT$(h$, INSTR(h$, " ")))
    h$ = MID$(h$, INSTR(h$, " ") + 1) : stVizPts = VAL(LEFT$(h$, INSTR(h$, " "))) ' (the scope's points a frame: 0 in an older .viz, with none)
    IF LEN(d$) < e + ST_OVW * 2 + stVizFrames * (ST_BANDS + stVizPts) THEN EXIT SUB
    FOR col = 0 TO ST_OVW - 1
        b1 = ASC(d$, e + 1 + col * 2) : b2 = ASC(d$, e + 2 + col * 2) ' (signed bytes)
        IF b1 > 127 THEN b1 = b1 - 256
        IF b2 > 127 THEN b2 = b2 - 256
        stOvMin(col) = b1 / 127 : stOvMax(col) = b2 / 127
    NEXT
    stVizSp$ = MID$(d$, e + 1 + ST_OVW * 2, stVizFrames * ST_BANDS) : stVizOn = -1
    IF stVizPts > 1 THEN stVizSc$ = MID$(d$, e + 1 + ST_OVW * 2 + stVizFrames * ST_BANDS, stVizFrames * stVizPts) ELSE stVizPts = 0
END SUB

' The scope's height: its loudest (from the seek bar's waveform) at 40 pixels - no more than
' eight times full scale's, so near silence stays a flat line
SUB StGainSet
    DIM k, pk! ' (its own)
    pk! = 0
    FOR k = 0 TO ST_OVW - 1
        IF -stOvMin(k) > pk! THEN pk! = -stOvMin(k)
        IF stOvMax(k) > pk! THEN pk! = stOvMax(k)
    NEXT
    IF pk! < 0.125 THEN pk! = 0.125
    stGain = 40 / pk! ' (the loudest moments run off the top and bottom: a little clipping, and a livelier line the rest of the time)
END SUB

FUNCTION MaxOfL& (a AS LONG, b AS LONG)
    IF a > b THEN MaxOfL& = a ELSE MaxOfL& = b
END FUNCTION

' Is a SOUND TEST category's screen showing?
FUNCTION StScreen
    StScreen = menuScreen >= SCR_ST1 AND menuScreen < SCR_ST1 + ST_CATS
END FUNCTION

' Where the playing sound is, in seconds (one that has played out: at its end)
FUNCTION StPos#
    IF stSnd& <= 0 THEN EXIT FUNCTION
    IF _SNDPLAYING(stSnd&) OR _SNDPAUSED(stSnd&) THEN StPos# = _SNDGETPOS(stSnd&) ELSE StPos# = stLen
END FUNCTION

' Play from s seconds in (one that had played out starts again)
SUB StSeek(s#)
    IF stSnd& <= 0 OR stLen <= 0 THEN EXIT SUB
    IF s# < 0 THEN s# = 0
    IF s# > stLen - 0.01 THEN s# = stLen - 0.01
    IF NOT _SNDPLAYING(stSnd&) AND NOT _SNDPAUSED(stSnd&) THEN
        IF stLoops THEN _SNDLOOP stSnd& ELSE _SNDPLAY stSnd&
    END IF
    _SNDSETPOS stSnd&, s# : stLastPos = s# ' (so AUTO doesn't take a seek back for a track coming round)
END SUB

' --- AUTO, once a frame: the sound playing has ended (a track: come round to its start), so
' after a moment the next in its category plays - its page turned to, and its line picked
SUB StFrame
    DIM p#, n, k, pg, tt ' (its own)
    IF NOT stAuto OR stNow = 0 OR stSnd& <= 0 OR stTyping THEN EXIT SUB
    IF _SNDPAUSED(stSnd&) THEN EXIT SUB
    IF _SNDPLAYING(stSnd&) THEN
        p# = _SNDGETPOS(stSnd&)
        IF NOT (stLoops AND p# < stLastPos - 1) THEN stLastPos = p# : EXIT SUB
    ELSE
        stAutoWait = stAutoWait + 1 : IF stAutoWait < 24 THEN EXIT SUB ' (0.4 seconds between)
    END IF
    k = 0 : pg = 0
    FOR n = 1 TO stN ' The next in its category (k: its place in it)
        IF stOf(n) = stOf(stNow) THEN
            k = k + 1
            IF n > stNow THEN pg = n : EXIT FOR
        END IF
    NEXT
    IF pg = 0 THEN ' (the last: it stays ended - a track goes on round)
        IF NOT stLoops THEN stAuto = 0
        EXIT SUB
    END IF
    n = pg : StPlay n
    pg = (k - 1) \ ST_PAGE
    IF pg <> stPage THEN stPage = pg : tt = menuT : EnterMenuScreen : menuT = tt ' (no slide-in: it's turned for you)
    FOR k = 1 TO numMI
        IF miAct(k) = MA_STPLAY AND miKind(k) = MI_ACTION AND miRef(k) = n THEN menuSel = k
    NEXT
END SUB

' P: pause, or carry on (one that had played out: again from the start)
SUB StPause
    IF stSnd& <= 0 THEN EXIT SUB
    IF _SNDPAUSED(stSnd&) OR NOT _SNDPLAYING(stSnd&) THEN
        IF stLoops THEN _SNDLOOP stSnd& ELSE _SNDPLAY stSnd&
    ELSE
        _SNDPAUSE stSnd&
    END IF
END SUB

' The mouse on the seek bar: press or drag along it to play from there
SUB StMouse(mx, my, down, wasDown)
    DIM f# ' (its own)
    IF stSnd& <= 0 OR stLen <= 0 THEN stSeekDrag = 0 : EXIT SUB
    IF down AND NOT wasDown AND mx >= ST_SEEK_X0 - 4 AND mx <= ST_SEEK_X0 + ST_OVW + 4 AND my >= ST_SEEK_Y0 - 4 AND my <= ST_SEEK_Y1 + 4 THEN stSeekDrag = -1 : stSeekX = -1
    IF NOT down THEN stSeekDrag = 0
    IF stSeekDrag AND mx <> stSeekX THEN ' (only when it moves: seeking every frame stutters)
        stSeekX = mx : f# = (mx - ST_SEEK_X0) / ST_OVW
        IF f# < 0 THEN f# = 0
        IF f# > 1 THEN f# = 1
        StSeek f# * stLen
    END IF
END SUB

' --- The spectrum, once a frame: ST_FFT samples round the play position,
' windowed, through the FFT, and into ST_BANDS bars spaced as we hear (each
' twice as wide in hertz every few bars, 50 Hz to 16 kHz), in decibels -
' 72 dB below full scale is an empty bar. Bars jump up and sink slowly; the
' caps over them hang a moment, then fall.
SUB StAnalyse(at AS LONG)
    DIM k AS LONG, b, i0 AS LONG, i1 AS LONG, j AS LONG, mx!, mg!, lv!, f0!, f1!, fHi!, sm AS LONG, sz AS LONG, hf AS LONG, tw AS LONG, st AS LONG, a AS LONG, bb AS LONG, tr!, ti!, ur!, ui! ' (its own)
    IF NOT stFFTReady THEN ' The tables, once: the window, the bit-reversed order, the turns
        FOR k = 0 TO ST_FFT - 1
            stHann(k) = 0.5 - 0.5 * COS(2 * _PI * k / (ST_FFT - 1))
            sm = 0 : j = k : sz = ST_FFT \ 2
            DO WHILE sz > 0 : IF j AND 1 THEN sm = sm + sz
                j = j \ 2 : sz = sz \ 2
            LOOP
            stRev(k) = sm
        NEXT
        FOR k = 0 TO ST_FFT \ 2 - 1 : stCs(k) = COS(2 * _PI * k / ST_FFT) : stSn(k) = SIN(2 * _PI * k / ST_FFT) : NEXT
        stFFTReady = -1
    END IF
    FOR k = 0 TO ST_FFT - 1
        j = at - ST_FFT \ 2 + k
        IF j >= 0 AND j < stFrames THEN stRe(stRev(k)) = stWave(j) * stHann(k) ELSE stRe(stRev(k)) = 0
        stIm(stRev(k)) = 0
    NEXT
    sz = 2 ' The FFT: pairs, then fours, then eights... each a "butterfly"
    DO WHILE sz <= ST_FFT
        hf = sz \ 2 : tw = ST_FFT \ sz
        FOR st = 0 TO ST_FFT - 1 STEP sz
            FOR j = 0 TO hf - 1
                a = st + j : bb = a + hf
                ur! = stCs(j * tw) : ui! = -stSn(j * tw)
                tr! = stRe(bb) * ur! - stIm(bb) * ui! : ti! = stRe(bb) * ui! + stIm(bb) * ur!
                stRe(bb) = stRe(a) - tr! : stIm(bb) = stIm(a) - ti!
                stRe(a) = stRe(a) + tr! : stIm(a) = stIm(a) + ti!
            NEXT
        NEXT
        sz = sz * 2
    LOOP
    fHi! = 16000 : IF fHi! > stRate * 0.48 THEN fHi! = stRate * 0.48
    FOR b = 0 TO ST_BANDS - 1
        f0! = 50 * (fHi! / 50) ^ (b / ST_BANDS) : f1! = 50 * (fHi! / 50) ^ ((b + 1) / ST_BANDS)
        i0 = INT(f0! * ST_FFT / stRate) : i1 = INT(f1! * ST_FFT / stRate)
        IF i1 < i0 THEN i1 = i0
        mx! = 0
        FOR k = i0 TO i1
            IF k >= 1 AND k < ST_FFT \ 2 THEN
                mg! = stRe(k) * stRe(k) + stIm(k) * stIm(k)
                IF mg! > mx! THEN mx! = mg!
            END IF
        NEXT
        mx! = SQR(mx!) * 4 / ST_FFT ' (a full-scale sine reads 1: the window halves it, the FFT's two sides halve it again)
        IF mx! > 0.0000001 THEN lv! = (20 * LOG(mx!) / LOG(10) + 72) / 72 ELSE lv! = 0
        StBandSet b, lv!
    NEXT
END SUB

' Bar b to level lv! (0 to 1): up at once, down slowly; its cap hangs, then falls
SUB StBandSet(b, lv!)
    IF lv! < 0 THEN lv! = 0
    IF lv! > 1 THEN lv! = 1
    IF lv! > stBand(b) THEN stBand(b) = lv! ELSE stBand(b) = stBand(b) - 0.025 : IF stBand(b) < lv! THEN stBand(b) = lv!
    IF stBand(b) >= stPeak(b) THEN
        stPeak(b) = stBand(b) : stPeakHold(b) = 24
    ELSEIF stPeakHold(b) > 0 THEN
        stPeakHold(b) = stPeakHold(b) - 1
    ELSE
        stPeak(b) = stPeak(b) - 0.012 : IF stPeak(b) < 0 THEN stPeak(b) = 0
    END IF
END SUB

' Seconds as the player shows them: a short sound to the hundredth
' (1.37), a longer one in minutes and seconds (0:42)
FUNCTION StTime$(s#)
    DIM w AS LONG ' (its own)
    IF s# < 0 THEN s# = 0
    IF stLen < 10 THEN
        StTime$ = LTRIM$(STR$(INT(s#))) + "." + RIGHT$("0" + LTRIM$(STR$(INT((s# - INT(s#)) * 100))), 2)
    ELSE
        w = INT(s#) : StTime$ = LTRIM$(STR$(w \ 60)) + ":" + RIGHT$("0" + LTRIM$(STR$(w MOD 60)), 2)
    END IF
END FUNCTION

' --- Draw the player, t frames after the screen opened: the box with what's
' playing and its spectrum and scope, then the seek bar under it
SUB StDrawPlayer(t)
    DIM b, k AS LONG, x, y, h, yy, s#, at AS LONG, playing, f!, col~&, sx AS LONG, x2, y2, px, py, ln$, rt$, v!, ak, ab ' (its own)
    playing = 0 : s# = 0
    IF stSnd& > 0 THEN
        playing = _SNDPLAYING(stSnd&) AND NOT _SNDPAUSED(stSnd&)
        s# = StPos#
    END IF
    IF playing AND stFrames > 0 THEN
        at = s# * stRate : IF at >= stFrames THEN at = stFrames - 1
        StAnalyse at
    ELSEIF playing AND stVizOn THEN ' (a track worked out beforehand: its bars at this moment)
        at = INT(s# * stVizFPS) : IF at >= stVizFrames THEN at = stVizFrames - 1
        IF at < 0 THEN at = 0
        FOR b = 0 TO ST_BANDS - 1 : StBandSet b, ASC(stVizSp$, at * ST_BANDS + b + 1) / 255 : NEXT
    ELSEIF stSnd& = 0 OR NOT _SNDPAUSED(stSnd&) THEN ' (stopped or played out: the bars sink; paused, they hold)
        FOR b = 0 TO ST_BANDS - 1 : StBandSet b, 0 : NEXT
    END IF
    LINE (12, ST_BOX_Y0)-(788, ST_BOX_Y1), _RGBA32(6, 0, 18, 200), BF
    LINE (12, ST_BOX_Y0)-(788, ST_BOX_Y1), _RGBA32(90, 230, 255, 90), B
    FOR b = 0 TO ST_BANDS - 1 ' The spectrum: low notes on the left, LED blocks from magenta up to cyan
        x = 16 + b * 16 : h = stBand(b) * ST_BAR_H
        FOR yy = 0 TO h - 1 STEP 3
            f! = yy / ST_BAR_H
            LINE (x + 1, ST_BAR_Y1 - yy - 2)-(x + 13, ST_BAR_Y1 - yy), _RGBA32(255 - 165 * f!, 40 + 190 * f!, 200 + 55 * f!, 210), BF
        NEXT
        IF stPeak(b) > 0.02 THEN y = ST_BAR_Y1 - stPeak(b) * ST_BAR_H - 2 : LINE (x + 1, y - 1)-(x + 13, y), _RGBA32(255, 255, 255, 200), BF
        FOR yy = 0 TO MinOf(h \ 3, ST_BOX_Y1 - ST_BAR_Y1 - 4) STEP 3 ' Its reflection, on a dark glass floor: a third as tall, fading
            f! = yy / ST_BAR_H
            LINE (x + 1, ST_BAR_Y1 + 3 + yy)-(x + 13, ST_BAR_Y1 + 4 + yy), _RGBA32(255 - 165 * f!, 40 + 190 * f!, 200 + 55 * f!, 120 - 8 * yy), BF
        NEXT
    NEXT
    LINE (14, ST_BAR_Y1 + 1)-(786, ST_BAR_Y1 + 1), _RGBA32(255, 100, 215, 110) ' (the floor line)
    y = (ST_BAR_Y1 + 26) \ 2 : px = -1
    IF playing AND stFrames > 0 THEN ' The scope: the wave itself, round the play position, over the bars
        FOR k = 0 TO 767 STEP 2
            sx = at - 512 + (k * 4) \ 3 ' (768 across: 1024 samples)
            v! = 0 : IF sx >= 0 AND sx < stFrames THEN v! = stWave(sx)
            y2 = y - v! * stGain : IF y2 < 26 THEN y2 = 26
            IF y2 > ST_BAR_Y1 THEN y2 = ST_BAR_Y1
            x2 = 16 + k
            IF px >= 0 THEN LINE (px, py)-(x2, y2), _RGBA32(150, 255, 255, 230)
            px = x2 : py = y2
        NEXT
    ELSEIF playing AND stVizOn AND stVizPts > 1 THEN ' (a track worked out beforehand: its scope's points at this moment)
        FOR k = 0 TO stVizPts - 1
            v! = ASC(stVizSc$, at * stVizPts + k + 1) : IF v! > 127 THEN v! = v! - 256
            y2 = y - v! / 127 * stGain : IF y2 < 26 THEN y2 = 26
            IF y2 > ST_BAR_Y1 THEN y2 = ST_BAR_Y1
            x2 = 16 + k * 768 \ (stVizPts - 1)
            IF px >= 0 THEN LINE (px, py)-(x2, y2), _RGBA32(150, 255, 255, 230)
            px = x2 : py = y2
        NEXT
    END IF
    IF stNow > 0 THEN ' What's playing: its number and name, and its file, how long, and whether it loops
        ln$ = "NOW PLAYING  " + stName$(stNow)
        rt$ = stFile$(stNow)
        IF stSnd& > 0 THEN
            IF _SNDPAUSED(stSnd&) THEN
                rt$ = rt$ + "  PAUSED"
            ELSEIF NOT playing THEN
                rt$ = rt$ + "  ENDED"
            ELSEIF stLoops AND NOT stAuto THEN
                rt$ = rt$ + "  LOOPING"
            END IF
        END IF
        IF stAuto THEN rt$ = rt$ + "  AUTO"
        IF stArr AND stSnd& > 0 THEN ' (an arranged track: the bar of the take playing, and its clip)
            StArrAt s#, ak, ab
            IF ak > 0 THEN rt$ = "BAR" + STR$(ab) + " " + arClipName$(arSeqClip(ak)) + "  " + ArFix$(arBpm, 1) + " BPM  " + rt$
        END IF
        IF LEN(ln$) > 93 - LEN(rt$) THEN ln$ = LEFT$(ln$, 92 - LEN(rt$)) + "~" ' (two spaces at least before the file)
        MenuText 18, ST_BOX_Y0 + 3, ln$, 1, _RGB32(90, 230, 255), 0
        MenuText 782, ST_BOX_Y0 + 3, rt$, 1, _RGBA32(200, 160, 255, 220), 2
    ELSE
        ln$ = "SOUND TEST - ENTER PLAYS ONE" : IF stAuto THEN ln$ = ln$ + " - AUTO: THEN THE NEXT, AND THE NEXT"
        MenuText 400, ST_BOX_Y0 + 3, ln$, 1, _RGBA32(200, 160, 255, 150 + 80 * SIN(t * 0.06)), 1
    END IF
    ' The seek bar: the whole sound's waveform, cyan where it has played; a white line where it is
    LINE (ST_SEEK_X0 - 2, ST_SEEK_Y0)-(ST_SEEK_X0 + ST_OVW + 1, ST_SEEK_Y1), _RGBA32(6, 0, 18, 200), BF
    LINE (ST_SEEK_X0 - 2, ST_SEEK_Y0)-(ST_SEEK_X0 + ST_OVW + 1, ST_SEEK_Y1), _RGBA32(90, 230, 255, 90), B
    px = -1 : IF stLen > 0 THEN px = ST_SEEK_X0 + ST_OVW * s# / stLen
    y = (ST_SEEK_Y0 + ST_SEEK_Y1) \ 2
    IF stFrames > 0 OR stVizOn THEN
        FOR k = 0 TO ST_OVW - 1
            x = ST_SEEK_X0 + k
            IF x <= px THEN col~& = _RGBA32(90, 230, 255, 230) ELSE col~& = _RGBA32(150, 90, 200, 170)
            LINE (x, y - stOvMax(k) * 9)-(x, y - stOvMin(k) * 9), col~&
        NEXT
    ELSE
        LINE (ST_SEEK_X0, y)-(ST_SEEK_X0 + ST_OVW - 1, y), _RGBA32(150, 90, 200, 120)
    END IF
    IF stArr AND stLen > 0 THEN ' An arranged track's blocks, along the seek bar's foot (each clip its colour)
        ab = 0
        FOR ak = 1 TO arSeqN
            x = ST_SEEK_X0 + ST_OVW * (ab * 240 / arBpm) / stLen : ab = ab + ArBlockBars(ak)
            x2 = ST_SEEK_X0 + ST_OVW * (ab * 240 / arBpm) / stLen - 1 : IF x2 > ST_SEEK_X0 + ST_OVW - 1 THEN x2 = ST_SEEK_X0 + ST_OVW - 1
            IF x2 >= x THEN LINE (x, ST_SEEK_Y1 - 4)-(x2, ST_SEEK_Y1 - 2), ArCol~&(arSeqClip(ak), 200), BF
        NEXT
    END IF
    IF px >= 0 THEN LINE (px, ST_SEEK_Y0 + 1)-(px + 1, ST_SEEK_Y1 - 1), _RGB32(255, 255, 255), BF
    IF stLen > 0 THEN MenuText 784, ST_SEEK_Y0 + 3, StTime$(s#) + " / " + StTime$(stLen), 1, _RGB32(255, 255, 255), 2
END SUB

' The row of the sound playing: three little bars, moving with it
SUB StRowIcon(x, y)
    DIM b, h ' (its own)
    FOR b = 0 TO 2
        h = 3 + stBand(b * 12 + 4) * 16
        LINE (x + b * 6, y + 24 - h)-(x + b * 6 + 3, y + 24), _RGBA32(90, 230, 255, 230), BF
    NEXT
END SUB

' --- Flag sound n (or unflag it), and save the flags: one path|name a line
SUB StFlag(n) STATIC
    DIM f, i ' (its own)
    stFlagged(n) = NOT stFlagged(n)
    f = FREEFILE : OPEN SaveDir$ + "soundflags.txt" FOR OUTPUT AS #f
    FOR i = 1 TO stN
        IF stFlagged(i) THEN PRINT #f, stFile$(i) + "|" + stName$(i)
    NEXT
    CLOSE #f
END SUB
