''
' NEON-CASTER - RENDER/HUD.BM
' =============================================================================
' The HUD: its layout (HudDefaults, hud.txt), the crosshair, vignettes,
' damage indicators and the map.
'

' A texture's average colour, a little brighter (each wall kind's minimap
' colour)
FUNCTION MinimapColor~&(slot)
    DIM x, y ' (its own: the main program shares these names)
    FOR y = 0 TO texSize - 1 STEP 2 : FOR x = 0 TO texSize - 1 STEP 2
        col~& = texture(x, y, slot) : red& = red& + _RED32(col~&) : green& = green& + _GREEN32(col~&) : blue& = blue& + _BLUE32(col~&) : count& = count& + 1
    NEXT : NEXT
    MinimapColor~& = _RGB32(red& / count& * 1.4, green& / count& * 1.4, blue& / count& * 1.4)
END FUNCTION


' A VIGNETTE: the screen's edges washed with colour (r, g, b), strongest
' at the very edge and fading to nothing a fifth of the way in - amt 0 to 1
' how strong. Drawn as rings, the outermost first: each a frame of four
' strips, a little less see-through the nearer the edge (the square of
' how near). Over the view - in OpenGL, on the HUD's layer over it.
SUB DrawVignette(r, g, b, amt)
    DIM a, c~&, i, n, x0, y0, y1 ' (its own: the main program shares these names)
    IF amt <= 0 THEN EXIT SUB
    a = MinOf(1, amt) : n = 24 : dx = 170 / n : dy = 130 / n
    HudAt -1 ' (FULL WIDE: the window's own edges)
    FOR i = 0 TO n - 1
        al = INT(200 * a * (1 - i / n) ^ 2) : IF al < 1 THEN EXIT FOR
        c~& = _RGBA32(r, g, b, al)
        x0 = INT(i * dx) : y0 = INT(i * dy) : x1 = INT((i + 1) * dx) - 1 : y1 = INT((i + 1) * dy) - 1
        LINE (x0, y0)-(scrW - 1 - x0, y1), c~&, BF ' (top)
        LINE (x0, 599 - y1)-(scrW - 1 - x0, 599 - y0), c~&, BF ' (bottom)
        LINE (x0, y1 + 1)-(x1, 599 - y1 - 1), c~&, BF ' (left)
        LINE (scrW - 1 - x1, y1 + 1)-(scrW - 1 - x0, 599 - y1 - 1), c~&, BF ' (right)
    NEXT
    HudAt 1
END SUB

' --- FULL WIDE in play (OpenGL): the HUD on a canvas as wide as the window
' (hudCanvas&, scrW across), so its parts can hug the window's edges -
' chapter 18 draws there, GLCapture hands it to the card. Not in the
' editors (their pointer works on our 4:3 screen) or the software renderer.
SUB HudWideBegin
    DIM w ' (its own: the main program shares these names)
    hudWideNow = 0 : hudVX = 0 : hudViewX = 0 : scrW = 800
    IF glMode = 0 OR editMode OR hudEdit THEN EXIT SUB
    w = INT(800 * WideView + 0.5) : IF w < 804 THEN EXIT SUB
    IF hudCanvas& < -1 THEN IF _WIDTH(hudCanvas&) <> w THEN _FREEIMAGE hudCanvas& : hudCanvas& = 0
    IF hudCanvas& >= -1 THEN hudCanvas& = _NEWIMAGE(w, 600, 32)
    _DEST hudCanvas& : VIEW : CLS , _RGBA32(0, 0, 0, 0) : _PRINTMODE _KEEPBACKGROUND ' (as our screen prints: CORE/WINDOW.BI)
    scrW = w : hudVX = (w - 800) \ 2 : hudWideNow = -1
    HudAt 1
END SUB

' Where the HUD draws now, on FULL WIDE's canvas: an 800 x 600 VIEW at its
' left edge (side 0), in its middle (1) or at its right edge (2), so the
' code drawing a part needs no changes - or (-1) none, the whole canvas,
' scrW across (washes and frames). Without the canvas it does nothing.
SUB HudAt(side)
    IF NOT hudWideNow THEN EXIT SUB
    IF side < 0 THEN
        VIEW : hudViewX = 0
    ELSE
        hudViewX = side * hudVX : VIEW (hudViewX, 0)-(hudViewX + 799, 599)
    END IF
END SUB

' ...the side for HUD part e: by which third of our screen it's in
SUB HudAtE(e)
    IF NOT hudWideNow THEN EXIT SUB
    IF hudX(e) < 267 THEN HudAt 0 ELSE IF hudX(e) > 533 THEN HudAt 2 ELSE HudAt 1
END SUB

' --- The HUD's layout (chapter 18's data; hud.txt; the HUD editor) --------
SUB HudDefaults
    DIM e ' (its own: the main program shares these names)
    FOR e = 1 TO HUD_ELEMS : hudShow(e) = -1 : hudCol(e) = 0 : hudW(e) = 0 : hudH(e) = 0 : hudLabel$(e) = "" : NEXT
    hudName$(HE_HEALTH) = "health" : hudX(HE_HEALTH) = 16 : hudY(HE_HEALTH) = 552 : hudW(HE_HEALTH) = 200 : hudH(HE_HEALTH) = 12 : hudLabel$(HE_HEALTH) = "HEALTH"
    hudName$(HE_ARMOR) = "armor" : hudX(HE_ARMOR) = 16 : hudY(HE_ARMOR) = 516 : hudW(HE_ARMOR) = 200 : hudH(HE_ARMOR) = 8 : hudLabel$(HE_ARMOR) = "ARMOR"
    hudName$(HE_AMMO) = "ammo" : hudX(HE_AMMO) = 784 : hudY(HE_AMMO) = 552 : hudW(HE_AMMO) = 200 : hudH(HE_AMMO) = 12
    hudName$(HE_GUNS) = "guns" : hudX(HE_GUNS) = 582 : hudY(HE_GUNS) = 534
    hudName$(HE_KILLS) = "kills" : hudX(HE_KILLS) = MINIMAP_X : hudY(HE_KILLS) = MINIMAP_Y : hudLabel$(HE_KILLS) = "KILLS"
    hudName$(HE_MINIMAP) = "minimap" : hudX(HE_MINIMAP) = MINIMAP_X : hudY(HE_MINIMAP) = MINIMAP_Y : hudW(HE_MINIMAP) = MINIMAP_CELL
    hudName$(HE_CARDS) = "keycards" : hudX(HE_CARDS) = 784 : hudY(HE_CARDS) = 8 : hudW(HE_CARDS) = 64
    hudName$(HE_MESSAGE) = "message" : hudX(HE_MESSAGE) = 400 : hudY(HE_MESSAGE) = 510
    hudName$(HE_SUBTITLE) = "subtitle" : hudX(HE_SUBTITLE) = 400 : hudY(HE_SUBTITLE) = 44
    hudName$(HE_AMP) = "amp" : hudX(HE_AMP) = 232 : hudY(HE_AMP) = 532 : hudLabel$(HE_AMP) = "DAMAGE AMP" ' (right of the armour bar, not on it - night vision's battery 136 further on)
    hudName$(HE_GOD) = "godmode" : hudX(HE_GOD) = 16 : hudY(HE_GOD) = 498 : hudLabel$(HE_GOD) = "GOD MODE"
    hudName$(HE_EVENT) = "event" : hudX(HE_EVENT) = 400 : hudY(HE_EVENT) = 28
    hudName$(HE_NETWORK) = "network" : hudX(HE_NETWORK) = 400 : hudY(HE_NETWORK) = 74
    hudName$(HE_FPS) = "fps" : hudX(HE_FPS) = 400 : hudY(HE_FPS) = 8
    hudName$(HE_TIMER) = "timer" : hudX(HE_TIMER) = 784 : hudY(HE_TIMER) = 80
END SUB

' A part's colour: its own from hud.txt - or, if it has none, the game's
FUNCTION HudColor~&(e, dflt~&)
    IF hudCol(e) THEN HudColor~& = hudCol(e) ELSE HudColor~& = dflt~&
END FUNCTION

' hud.txt: one [name] section a part - show, x, y, bar (width, height),
' color (auto, or red, green, blue), label
SUB ReadHud
    DIM e, k, l$ ' (its own: the main program shares these names)
    f$ = AssetPath$("hud.txt")
    IF NOT _FILEEXISTS(f$) THEN EXIT SUB
    fh = FREEFILE : OPEN f$ FOR INPUT AS #fh : e = 0
    DO UNTIL EOF(fh)
        LINE INPUT #fh, l$
        l$ = LTRIM$(RTRIM$(l$)) : IF RIGHT$(l$, 1) = CHR$(13) THEN l$ = LEFT$(l$, LEN(l$) - 1)
        IF LEFT$(l$, 1) = "[" AND RIGHT$(l$, 1) = "]" THEN
            n$ = LCASE$(MID$(l$, 2, LEN(l$) - 2)) : e = 0
            FOR k = 1 TO HUD_ELEMS
                IF hudName$(k) = n$ THEN e = k
            NEXT
        ELSEIF e > 0 AND INSTR(l$, "=") AND LEFT$(l$, 1) <> "'" THEN
            eq = INSTR(l$, "=") : k$ = LCASE$(RTRIM$(LEFT$(l$, eq - 1))) : v$ = LTRIM$(MID$(l$, eq + 1))
            SELECT CASE k$
                CASE "show" : hudShow(e) = (LCASE$(v$) <> "no")
                CASE "x" : hudX(e) = VAL(v$)
                CASE "y" : hudY(e) = VAL(v$)
                CASE "bar" : hudW(e) = VAL(ListItem$(v$, 1)) : hudH(e) = VAL(ListItem$(v$, 2))
                CASE "size" : hudW(e) = VAL(v$)
                CASE "color", "colour" : IF LCASE$(v$) = "auto" THEN hudCol(e) = 0 ELSE hudCol(e) = _RGB32(VAL(ListItem$(v$, 1)), VAL(ListItem$(v$, 2)), VAL(ListItem$(v$, 3)))
                CASE "label" : hudLabel$(e) = v$
            END SELECT
        END IF
    LOOP
    CLOSE #fh
END SUB

' The crosshair at (cx, cy), in the style, colour, size and opacity the
' settings say - and as big as crossScale and as white as crossFlash say
SUB DrawCrosshair(cx, cy)
    col~& = CrossColor~&(setting(SET_XCOLOR))
    IF crossFlash > 0 THEN col~& = _RGB32(255, 255, 255) ' A hit!
    col~& = _RGBA32(_RED32(col~&), _GREEN32(col~&), _BLUE32(col~&), setting(SET_XALPHA) * 255 / 100)
    armLen = (2 + setting(SET_XSIZE) * 2) * crossScale
    SELECT CASE setting(SET_XSTYLE)
        CASE 1 ' Cross
            LINE (cx - armLen, cy)-(cx + armLen, cy), col~& : LINE (cx, cy - armLen)-(cx, cy + armLen), col~&
        CASE 2 ' Dot
            LINE (cx - armLen \ 4, cy - armLen \ 4)-(cx + armLen \ 4, cy + armLen \ 4), col~&, BF
        CASE 3 ' Circle
            CIRCLE (cx, cy), armLen, col~&
        CASE 4 ' A cross with a gap in the middle, and a dot
            gap = armLen \ 2 + 1
            LINE (cx - armLen - 2, cy)-(cx - gap, cy), col~& : LINE (cx + gap, cy)-(cx + armLen + 2, cy), col~&
            LINE (cx, cy - armLen - 2)-(cx, cy - gap), col~& : LINE (cx, cy + gap)-(cx, cy + armLen + 2), col~&
            PSET (cx, cy), col~&
        CASE 5 ' Chevron
            LINE (cx - armLen, cy + armLen)-(cx, cy), col~& : LINE (cx, cy)-(cx + armLen, cy + armLen), col~&
    END SELECT ' (6: none)
END SUB

FUNCTION CrossColor~&(n)
    SELECT CASE n
        CASE 1 : CrossColor~& = _RGB32(255, 40, 40)
        CASE 2 : CrossColor~& = _RGB32(60, 255, 90)
        CASE 3 : CrossColor~& = _RGB32(60, 230, 255)
        CASE 4 : CrossColor~& = _RGB32(255, 230, 40)
        CASE 5 : CrossColor~& = _RGB32(255, 255, 255)
        CASE ELSE : CrossColor~& = _RGB32(255, 60, 220)
    END SELECT
END FUNCTION

' The map, cellSize pixels a cell, its top-left at (mapLeft, mapTop): all of
' it (showAll), or only the cells you've seen. Walls are their texture's
' colour; doors orange (key doors their card's colour, with a dark centre)
' when shut, white while opening, green when open; the exit blinks green;
' on the big map the floor you've seen is a dim blue. Then keycards, and
' you - an arrow pointing the way you face.
SUB DrawMap(mapLeft, mapTop, cellSize, showAll, px, py, facingX, facingY)
    DIM ax, ay, i, k, sx, sy, n, x0, y0, ml, mt, vl, cA! ' (its own: the main program shares these names)
    ' (a sector bigger than the game's 48: the minimap is the 48 cells round
    ' you; the full map all of it, smaller - its caller picks the size)
    n = mapN : x0 = 0 : y0 = 0
    IF NOT mmFull AND mapN > 48 THEN n = 48 : x0 = MaxOf(0, MinOf(mapN - 48, INT(px) - 24)) : y0 = MaxOf(0, MinOf(mapN - 48, INT(py) - 24))
    LINE (mapLeft - 2, mapTop - 2)-(mapLeft + n * cellSize + 1, mapTop + n * cellSize + 1), _RGBA32(0, 0, 0, 160), BF
    IF mmFull AND cellSize >= 3 THEN FullMapFloors showAll : _PUTIMAGE (mapLeft, mapTop), fmImg& ' (the floors, textured: below the rest)
    vl = mapLeft + hudViewX ' (FULL WIDE: VIEW SCREEN is the canvas's own place, not the side's VIEW HudAt set - so the side's offset, added by hand)
    VIEW SCREEN (vl - 2, mapTop - 2)-(vl + n * cellSize + 1, mapTop + n * cellSize + 1)
    ml = vl - x0 * cellSize : mt = mapTop - y0 * cellSize
    FOR cellY = y0 TO y0 + n - 1 : FOR cellX = x0 TO x0 + n - 1
        IF showAll OR cellSeen(cellX, cellY) THEN
            mmColor~& = 0 : hideIt = 0
            IF secretArea(cellX, cellY) > 0 AND NOT cellSeen(cellX, cellY) THEN hideIt = -1 : mmColor~& = wallMapColor(secretArea(cellX, cellY)) ' (behind a secret, not seen yet: the map pickup shows rock)
            IF NOT hideIt THEN
            SELECT CASE worldMap(cellX, cellY)
                CASE 0
                    IF mmFull THEN ' (the full map: the floor - and what's on it that matters, once you've seen it: the map pickup shows the layout, not what's in it)
                        mmColor~& = _RGBA32(26, 32, 62, 150) ' (floor the map pickup showed you, not been to: dim)
                        IF cellSize >= 3 THEN mmColor~& = 0 ' (textured instead: FullMapFloors)
                        IF cellSeen(cellX, cellY) THEN
                            mmColor~& = _RGBA32(58, 74, 140, 170) ' (where you've been: brighter)
                            IF cellSize >= 3 THEN mmColor~& = 0
                            IF liqKind(cellX, cellY) THEN k = liqKind(cellX, cellY) : mmColor~& = _RGBA32(lqR(k) * 0.7, lqG(k) * 0.7, lqB(k) * 0.7, 210) ' (a pool, its colour: lava orange, acid green...)
                            IF floorH(cellX, cellY) <= PIT_DEPTH THEN mmColor~& = _RGBA32(10, 0, 20, 230) ' (a pit with no bottom: black)
                            IF liftCell(cellX, cellY) THEN mmColor~& = _RGBA32(70, 150, 90, 190) ' (a lift)
                        END IF
                    END IF
                    IF glassHP(cellX, cellY) >= BARS_HP THEN mmColor~& = _RGB32(150, 140, 130) ELSE IF glassHP(cellX, cellY) > 0 THEN mmColor~& = _RGB32(130, 220, 255) ' (glass - and bars)
                CASE 1, 3 TO 9
                    mmColor~& = wallMapColor(worldMap(cellX, cellY))
                    IF mmFull AND cellSize >= 3 AND diagCorner(cellX, cellY) = 0 THEN ' (the full map, textured: a wall's a line along the floor it faces - as Duke3D's)
                        sx = ml + cellX * cellSize : sy = mt + cellY * cellSize
                        IF MapFloorShown(cellX + 1, cellY, showAll) THEN LINE (sx + cellSize - 2, sy)-STEP(1, cellSize - 1), mmColor~&, BF
                        IF MapFloorShown(cellX - 1, cellY, showAll) THEN LINE (sx, sy)-STEP(1, cellSize - 1), mmColor~&, BF
                        IF MapFloorShown(cellX, cellY + 1, showAll) THEN LINE (sx, sy + cellSize - 2)-STEP(cellSize - 1, 1), mmColor~&, BF
                        IF MapFloorShown(cellX, cellY - 1, showAll) THEN LINE (sx, sy)-STEP(cellSize - 1, 1), mmColor~&, BF
                        mmColor~& = 0
                    END IF
                CASE 2
                    IF doorType(cellX, cellY) = DOOR_EXIT THEN
                        IF (TIMER * 4 AND 1) = 0 THEN mmColor~& = _RGB32(80, 255, 120) ELSE mmColor~& = _RGB32(20, 120, 50)
                    ELSEIF doorOpen(cellX, cellY) = 0 THEN
                        IF doorKey(cellX, cellY) THEN mmColor~& = CardRGB~&(doorKey(cellX, cellY)) ELSE mmColor~& = _RGB32(255, 140, 20)
                    ELSEIF doorOpen(cellX, cellY) < 1 THEN
                        mmColor~& = _RGB32(230, 230, 230)
                    ELSE
                        mmColor~& = _RGB32(40, 200, 80)
                    END IF
            END SELECT
            END IF
            sx = ml + cellX * cellSize : sy = mt + cellY * cellSize
            IF mmColor~& <> 0 AND diagCorner(cellX, cellY) <> 0 AND NOT hideIt THEN ' Diagonal: just its solid half
                FOR pixY = 0 TO cellSize - 1 : FOR pixX = 0 TO cellSize - 1
                    IF InDiagonalWall(diagCorner(cellX, cellY), (pixX + 0.5) / cellSize, (pixY + 0.5) / cellSize) THEN PSET (sx + pixX, sy + pixY), mmColor~&
                NEXT : NEXT
            ELSEIF mmColor~& THEN
                LINE (sx, sy)-STEP(cellSize - 1, cellSize - 1), mmColor~&, BF
                IF doorKey(cellX, cellY) AND doorOpen(cellX, cellY) = 0 AND NOT hideIt THEN LINE (sx + cellSize \ 3, sy + cellSize \ 3)-STEP(cellSize \ 3, cellSize \ 3), _RGB32(0, 0, 0), BF
            END IF
            IF boxOn(cellX, cellY) AND cellSeen(cellX, cellY) THEN ' A box: just where it stands (at least a pixel) - once seen
                LINE (sx + INT(boxX0(cellX, cellY) * cellSize), sy + INT(boxY0(cellX, cellY) * cellSize))-(sx + MaxOf(INT(boxX0(cellX, cellY) * cellSize), INT(boxX1(cellX, cellY) * cellSize + 0.5) - 1), sy + MaxOf(INT(boxY0(cellX, cellY) * cellSize), INT(boxY1(cellX, cellY) * cellSize + 0.5) - 1)), wallMapColor(boxOn(cellX, cellY)), BF
            END IF
        END IF
    NEXT : NEXT
    IF mmFull THEN ' Teleporter pads: a violet ring each
        FOR k = 1 TO numPads
            IF cellSeen(padX(k), padY(k)) THEN CIRCLE (ml + (padX(k) + 0.5) * cellSize, mt + (padY(k) + 0.5) * cellSize), cellSize * 0.4, _RGB32(190, 110, 255)
        NEXT
    END IF
    ' Security cameras: a red eye and the way it looks (a fan of two lines)
    ' - every one with the map pickup, otherwise once you've seen where
    FOR i = 1 TO numDecos
        IF decoKind(i) = DK_CAMERA AND decoOn(i) THEN
            IF showAll OR cellSeen(INT(decoX(i)), INT(decoY(i))) THEN
                ax = ml + decoX(i) * cellSize : ay = mt + decoY(i) * cellSize
                SELECT CASE decoFace(i)
                    CASE 1 : cA! = 0
                    CASE 2 : cA! = 1.5708
                    CASE 3 : cA! = 3.14159
                    CASE 4 : cA! = -1.5708
                    CASE ELSE : cA! = 99
                END SELECT
                IF cA! < 9 THEN
                    LINE (ax, ay)-STEP(COS(cA! - 0.5) * cellSize * 2.2, SIN(cA! - 0.5) * cellSize * 2.2), _RGBA32(255, 70, 70, 150)
                    LINE (ax, ay)-STEP(COS(cA! + 0.5) * cellSize * 2.2, SIN(cA! + 0.5) * cellSize * 2.2), _RGBA32(255, 70, 70, 150)
                END IF
                LINE (ax - cellSize \ 3 - 1, ay - cellSize \ 3 - 1)-STEP(cellSize \ 1.5 + 1, cellSize \ 1.5 + 1), _RGB32(255, 60, 60), BF
            END IF
        END IF
    NEXT
    IF (TIMER * 4 AND 1) = 0 THEN ' Keycards blink
        FOR i = 1 TO numItems
            IF itemOn(i) AND itemKind(i) <= 3 AND cellSeen(INT(itemX(i)), INT(itemY(i))) THEN ' (a keycard: once you've seen where it is)
                LINE (ml + itemX(i) * cellSize - cellSize \ 3 - 1, mt + itemY(i) * cellSize - cellSize \ 3 - 1)-STEP(cellSize \ 1.5 + 1, cellSize \ 1.5 + 1), CardRGB~&(itemKind(i)), BF
            END IF
        NEXT
    END IF
    ' You: an arrow - its tip ahead of you, its tail corners behind you
    ax = ml + px * cellSize : ay = mt + py * cellSize : arrow = cellSize * 1.2 + 2
    tipX = ax + facingX * arrow : tipY = ay + facingY * arrow
    leftX = ax - facingX * arrow * 0.5 + facingY * arrow * 0.5 : leftY = ay - facingY * arrow * 0.5 - facingX * arrow * 0.5
    rightX = ax - facingX * arrow * 0.5 - facingY * arrow * 0.5 : rightY = ay - facingY * arrow * 0.5 + facingX * arrow * 0.5
    LINE (tipX, tipY)-(leftX, leftY), _RGB32(255, 255, 0) : LINE (leftX, leftY)-(rightX, rightY), _RGB32(255, 255, 0)
    LINE (rightX, rightY)-(tipX, tipY), _RGB32(255, 255, 0)
    VIEW
END SUB

' Is cell (x, y) an open floor the full map shows (seen, or the map pickup's)?
FUNCTION MapFloorShown(x, y, showAll)
    IF x < 0 OR y < 0 OR x >= mapN OR y >= mapN THEN EXIT FUNCTION
    IF worldMap(x, y) > 0 AND worldMap(x, y) <> 2 AND diagCorner(x, y) = 0 THEN EXIT FUNCTION
    MapFloorShown = cellSeen(x, y) OR (showAll AND secretArea(x, y) = 0)
END FUNCTION

' The full map's floor pictures into fmImg&: each open cell you know, its
' floor's own picture from above (as Duke3D's map), shaded - full where
' you've been, dim where only the map pickup showed it. Only cells whose
' state changed are drawn again (fmState)
SUB FullMapFloors(showAll)
    DIM c, cs, k, n, px, py, sl, st, tx, ty, x, y, sh!, dst& ' (its own: the main program shares these names)
    n = mapN : cs = MinOf(10, 480 \ mapN)
    IF fmImg& = 0 OR fmImgN <> n OR fmImgC <> cs OR fmImgL <> trigLoadN THEN ' (another sector, or size: all of it again)
        IF fmImg& < -1 THEN _FREEIMAGE fmImg&
        fmImg& = _NEWIMAGE(n * cs, n * cs, 32) : fmImgN = n : fmImgC = cs : fmImgL = trigLoadN
        FOR y = 0 TO MAP_SIZE : FOR x = 0 TO MAP_SIZE : fmState(x, y) = 0 : NEXT : NEXT
        dst& = _DEST : _DEST fmImg& : CLS , _RGBA32(0, 0, 0, 0) : _DEST dst&
    END IF
    dst& = _DEST : _DEST fmImg&
    FOR y = 0 TO n - 1 : FOR x = 0 TO n - 1
        st = 0
        IF worldMap(x, y) = 0 AND diagCorner(x, y) = 0 THEN
            IF cellSeen(x, y) THEN st = 2 ELSE IF showAll AND secretArea(x, y) = 0 THEN st = 1
        END IF
        IF st <> fmState(x, y) THEN
            fmState(x, y) = st
            IF st = 0 THEN
                LINE (x * cs, y * cs)-STEP(cs - 1, cs - 1), _RGBA32(0, 0, 0, 0), BF
            ELSE
                sl = floorTex(x, y) : IF sl < 1 OR sl > T_SLOTS THEN sl = T_FLOOR + 1
                IF st = 2 THEN sh! = 0.85 ELSE sh! = 0.38
                FOR py = 0 TO cs - 1 : FOR px = 0 TO cs - 1
                    tx = (px * texSize) \ cs : ty = (py * texSize) \ cs
                    c = texture(tx, ty, sl)
                    PSET (x * cs + px, y * cs + py), _RGBA32(_RED32(c) * sh! * 0.9, _GREEN32(c) * sh! * 0.95, MinOf(255, _BLUE32(c) * sh! + 18 * sh!), 235)
                NEXT : NEXT
            END IF
        END IF
    NEXT : NEXT
    _DEST dst&
END SUB

' A damage indicator for a hit that came from (x, y): into a free slot, or
' over the one that's nearly faded
SUB AddHurtDir(x, y)
    DIM i, slot ' (its own: the main program shares these names)
    slot = 1
    FOR i = 1 TO MAX_HURTDIRS
        IF hurtDirTime(i) < hurtDirTime(slot) THEN slot = i
    NEXT
    hurtDirX(slot) = x : hurtDirY(slot) = y : hurtDirTime(slot) = HURTDIR_FRAMES
END SUB

' The damage indicators, for you at (px, py) facing (facingX, facingY): a
' red arc round the crosshair for each recent hit, at the angle it came
' from - straight up is in front of you, right is to your right - fading
' as it gets older.
SUB DrawHurtDirs(px, py, facingX, facingY)
    DIM i, k ' (its own: the main program shares these names)
    FOR i = 1 TO MAX_HURTDIRS
        IF hurtDirTime(i) > 0 THEN
            hurtDirTime(i) = hurtDirTime(i) - 1
            relX = hurtDirX(i) - px : relY = hurtDirY(i) - py
            ahead = relX * facingX + relY * facingY ' How far in front of you...
            across = relY * facingX - relX * facingY ' ...and to your right (along the camera plane: (-facingY, facingX))
            angle = _ATAN2(across, ahead) ' 0 = straight ahead
            fade = hurtDirTime(i) / HURTDIR_FRAMES
            FOR radius = 92 TO 104 STEP 2 ' A thick arc, 40 degrees wide
                FOR k = -10 TO 9
                    a1 = angle + k * 0.035 : a2 = a1 + 0.035
                    LINE (400 + SIN(a1) * radius, 300 - COS(a1) * radius)-(400 + SIN(a2) * radius, 300 - COS(a2) * radius), _RGBA32(255, 30, 30, 230 * fade * (1 - ABS(k + 0.5) / 11))
                NEXT
            NEXT
            ' ...and a small arrowhead at its outer edge, pointing that way
            tipX = 400 + SIN(angle) * 118 : tipY = 300 - COS(angle) * 118
            LINE (tipX, tipY)-(400 + SIN(angle - 0.09) * 106, 300 - COS(angle - 0.09) * 106), _RGBA32(255, 80, 60, 255 * fade)
            LINE (tipX, tipY)-(400 + SIN(angle + 0.09) * 106, 300 - COS(angle + 0.09) * 106), _RGBA32(255, 80, 60, 255 * fade)
        END IF
    NEXT
END SUB

' --- F3: WHERE YOU ARE, IN NUMBERS. A panel under the kills: the sector,
' your x y (and the cell: 20.5 is the middle of cell 20), the way you face
' in degrees as tp takes them (0 east, 90 south), your feet's and eye's
' height and the cell's floor and ceiling, the wall or door you're looking
' at (its cell and map character, for put and box) - and a tp line that
' brings you back here, to type into the console.
SUB DrawInfo(top)
    DIM ang, cx, cy, d!, hx, hy, i, l$(8), n, w, y, c$ ' (its own: the main program shares these names)
    ang = INT(_ATAN2(dirY, dirX) * 180 / 3.14159265 + 0.5) : IF ang < 0 THEN ang = ang + 360
    IF ang >= 360 THEN ang = ang - 360
    cx = INT(playerX) : cy = INT(playerY)
    ' What you're looking at: along the way you face, a twentieth of a cell
    ' at a time, to the first wall or door (as far as 24 cells)
    hx = -1
    FOR d! = 0 TO 24 STEP 0.05
        i = INT(playerX + dirX * d!) : n = INT(playerY + dirY * d!)
        IF i < 0 OR n < 0 OR i >= mapN OR n >= mapN THEN EXIT FOR
        IF worldMap(i, n) <> 0 THEN hx = i : hy = n : EXIT FOR
    NEXT
    l$(1) = sectorName$(level)
    l$(2) = "X " + InfoNum$(playerX) + "  Y " + InfoNum$(playerY) + "   CELL" + STR$(cx) + STR$(cy) + "  " + InfoCell$(cx, cy)
    l$(3) = "FACING" + STR$(ang) + " DEG  " + MID$("EAST     SOUTHEASTSOUTH    SOUTHWESTWEST     NORTHWESTNORTH    NORTHEAST", ((ang + 22) \ 45 MOD 8) * 9 + 1, 9)
    l$(4) = "FEET " + InfoNum$(playerZ) + "  EYE " + InfoNum$(eyeZ) + "   FLOOR " + InfoNum$(floorH(cx, cy)) + "  CEILING " + InfoNum$(ceilH(cx, cy))
    IF hx >= 0 THEN
        d! = SQR((hx + 0.5 - playerX) ^ 2 + (hy + 0.5 - playerY) ^ 2)
        l$(5) = "LOOKING AT CELL" + STR$(hx) + STR$(hy) + "  " + InfoCell$(hx, hy) + "  " + InfoNum$(d!) + " AWAY"
    ELSE
        l$(5) = "LOOKING AT NOTHING NEAR"
    END IF
    l$(6) = "tp " + InfoNum$(playerX) + " " + InfoNum$(playerY) + " " + LTRIM$(STR$(ang))
    l$(7) = infoFps$
    l$(8) = "F3 HIDES THIS"
    w = 0 : FOR i = 1 TO 8 : IF LEN(l$(i)) > w THEN w = LEN(l$(i))
    NEXT
    LINE (4, top - 3)-(14 + w * 8, top + 8 * 16 + 1), _RGBA32(4, 2, 16, 170), BF
    FOR i = 1 TO 8
        y = top + (i - 1) * 16
        SELECT CASE i
            CASE 1 : c$ = "M" ' (the sector: magenta)
            CASE 6 : c$ = "Y" ' (the tp line: yellow, to type)
            CASE 7 : c$ = "F" ' (the frame rate: green)
            CASE 8 : c$ = "G"
            CASE ELSE : c$ = "C"
        END SELECT
        SELECT CASE c$
            CASE "M" : HudText 9, y, l$(i), _RGB32(255, 110, 220)
            CASE "Y" : HudText 9, y, l$(i), _RGB32(255, 230, 110)
            CASE "G" : HudText 9, y, l$(i), _RGB32(120, 110, 160)
            CASE "F" : HudText 9, y, l$(i), _RGB32(130, 255, 150)
            CASE ELSE : HudText 9, y, l$(i), _RGB32(170, 230, 255)
        END SELECT
    NEXT
END SUB

' A number for the F3 panel: two places after the point, always
FUNCTION InfoNum$(v!)
    DIM n&, s$ ' (its own: the main program shares these names)
    n& = INT(ABS(v!) * 100 + 0.5) : s$ = LTRIM$(STR$(n& \ 100)) + "." + RIGHT$("0" + LTRIM$(STR$(n& MOD 100)), 2)
    IF v! < 0 AND n& > 0 THEN s$ = "-" + s$
    InfoNum$ = s$
END FUNCTION

' A cell's map character in the level file, quoted (as put and box take it)
FUNCTION InfoCell$(x, y)
    IF x < 0 OR y < 0 OR x >= mapN OR y >= mapN THEN InfoCell$ = "" : EXIT FUNCTION
    InfoCell$ = "'" + MID$(lvlRow$(y) + " ", x + 1, 1) + "'"
END FUNCTION
