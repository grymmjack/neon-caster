''
' NEON-CASTER - RENDER/LIGHT.BM
' =============================================================================
' Light: building the level's lights, each frame's light, and glows.
'

' === LIGHT AND THE MAP (chapters 14 and 18) ====================================

' The light at map point (x, y): the four nearest cells' light (litR...),
' blended by how near each one's middle is, skipping walls - so it doesn't
' jump as you step from one cell to the next. 256 = full.
SUB LightAt(x, y, r, g, b)
    DIM cx, cy, fx, fy, i, j, tx, ty, w ' (its own: the main program shares these names)
    fx = x - 0.5 : fy = y - 0.5 : ix = INT(fx) : iy = INT(fy) : tx = fx - ix : ty = fy - iy
    r = 0 : g = 0 : b = 0 : sw = 0
    FOR j = 0 TO 1 : FOR i = 0 TO 1
        cx = ix + i : cy = iy + j
        IF cx >= 0 AND cy >= 0 AND cx < mapN AND cy < mapN THEN
            IF NOT IsWall(cx, cy) OR diagCorner(cx, cy) <> 0 THEN
                w = (i * tx + (1 - i) * (1 - tx)) * (j * ty + (1 - j) * (1 - ty))
                r = r + litR(cx, cy) * w : g = g + litG(cx, cy) * w : b = b + litB(cx, cy) * w : sw = sw + w
            END IF
        END IF
    NEXT : NEXT
    IF sw > 0.0001 THEN r = r / sw : g = g / sw : b = b / sw ELSE r = ambientR : g = ambientG : b = ambientB
END SUB

' One more light for this level: where, how far it reaches, its light for
' red, green and blue (brightness times colour), its effect (FX_), and the
' decoration it belongs to (0 for none)
' A pool poured in during play (a trigger's flood, or a save that kept
' one): a light for each 3 x 3 patch of it that glows - lava, slime, acid -
' as BuildLevel gives the level's own. Cells the level had that kind in
' already have theirs, so they're skipped.
SUB LiquidGlows(x0, y0, x1, y1)
    DIM gx, gy, k, l, n, n0, sx, sy, x, y ' (its own: the main program shares these names)
    added = 0
    FOR gy = MaxOf(0, y0) TO MinOf(y1, mapN - 1) STEP 3 : FOR gx = MaxOf(0, x0) TO MinOf(x1, mapN - 1) STEP 3
        FOR k = LQ_SLIME TO LQ_ACID
            n = 0 : sx = 0 : sy = 0
            FOR y = gy TO MinOf(gy + 2, MinOf(y1, mapN - 1)) : FOR x = gx TO MinOf(gx + 2, MinOf(x1, mapN - 1))
                IF liqKind(x, y) = k AND INSTR(LQ_CHARS$, MID$(lvlLiqRow$(y), x + 1, 1)) <> k THEN n = n + 1 : sx = sx + x + 0.5 : sy = sy + y + 0.5
            NEXT : NEXT
            IF n THEN ' (unless this patch glows already - the same trigger flooding it again)
                FOR l = numLightsBase + 1 TO numLights
                    IF lightLow(l) AND ABS(lightX(l) - sx / n) < 1.5 AND ABS(lightY(l) - sy / n) < 1.5 THEN n = 0
                NEXT
            END IF
            IF n THEN
                n0 = numLights
                IF k = LQ_LAVA THEN AddLight sx / n, sy / n, 3.5, 150, 70, 20, FX_FIRE, 0 ELSE AddLight sx / n, sy / n, 2.5, lqR(k) \ 5, lqG(k) \ 5, lqB(k) \ 5, FX_PULSE, 0
                IF numLights > n0 THEN lightLow(numLights) = -1 : added = -1
            END IF
        NEXT
    NEXT : NEXT
    IF added THEN BuildLights : glMeshVersion = glMeshVersion + 1
END SUB

SUB AddLight(x, y, radius, r, g, b, effect, deco)
    IF numLights >= MAX_LIGHTS THEN EXIT SUB
    numLights = numLights + 1
    lightX(numLights) = x : lightY(numLights) = y : lightRadius(numLights) = radius
    lightR(numLights) = r : lightG(numLights) = g : lightB(numLights) = b
    lightEffect(numLights) = effect : lightDeco(numLights) = deco : lightLow(numLights) = 0 : lightNoLamp(numLights) = 0
    lightBri(numLights) = MaxOf(r, MaxOf(g, b)) : lightHue(numLights) = _RGB32(255, 255, 255) ' (its brightness and colour, to change in play: the level's own get theirs exactly - BuildLevel)
    IF lightBri(numLights) > 0 THEN lightHue(numLights) = _RGB32(r * 255 / lightBri(numLights), g * 255 / lightBri(numLights), b * 255 / lightBri(numLights))
    lightPhase(numLights) = RND * 6.28 : lightTimer(numLights) = 0 ' (so no two flicker in step)
END SUB

' Work out, once per level, which cells each light reaches and how
' strongly: every cell within its radius that it can see (LightReaches),
' brightest at the light and fading to nothing at the radius. Walls don't
' move, so this never changes - each frame only has to add the lists up.
SUB BuildLights
    DIM d, l ' (its own: the main program shares these names)
    numLit = 0
    FOR l = 1 TO numLights
        lightFirst(l) = numLit + 1 : lightCount(l) = 0 : rad = lightRadius(l)
        FOR cellY = INT(lightY(l) - rad) TO INT(lightY(l) + rad)
            FOR cellX = INT(lightX(l) - rad) TO INT(lightX(l) + rad)
                IF cellX >= 0 AND cellX < mapN AND cellY >= 0 AND cellY < mapN THEN
                    ' Aim at the middle of the cell - or, for a diagonal wall's
                    ' cell, the middle of its open half
                    aimX = cellX + 0.5 : aimY = cellY + 0.5
                    SELECT CASE diagCorner(cellX, cellY)
                        CASE 1 : aimX = cellX + 0.75 : aimY = cellY + 0.75
                        CASE 2 : aimX = cellX + 0.25 : aimY = cellY + 0.75
                        CASE 3 : aimX = cellX + 0.25 : aimY = cellY + 0.25
                        CASE 4 : aimX = cellX + 0.75 : aimY = cellY + 0.25
                    END SELECT
                    d = SQR((aimX - lightX(l)) ^ 2 + (aimY - lightY(l)) ^ 2)
                    IF d < rad AND numLit < MAX_LIT AND (NOT IsWall(cellX, cellY) OR diagCorner(cellX, cellY) <> 0) THEN
                        IF LightReaches(lightX(l), lightY(l), aimX, aimY) THEN
                            numLit = numLit + 1 : lightCount(l) = lightCount(l) + 1
                            litCellX(numLit) = cellX : litCellY(numLit) = cellY : litWeight(numLit) = (1 - d / rad) ^ 2
                        END IF
                    END IF
                END IF
            NEXT
        NEXT
    NEXT
END SUB

' Can light get from (x1, y1) to (x2, y2)? Step along the line a quarter of
' a cell at a time; a wall on the way stops it (doors and decorations don't).
FUNCTION LightReaches(x1, y1, x2, y2)
    DIM i, px, py ' (its own: the main program shares these names)
    dist = SQR((x2 - x1) ^ 2 + (y2 - y1) ^ 2)
    stp = 0.25 : IF boxAny THEN stp = 0.1 ' (blocks can be an eighth thick: finer steps, so light can't skip through one)
    steps = INT(dist / stp) + 1
    cx2 = INT(x2) : cy2 = INT(y2)
    FOR i = 1 TO steps - 1
        px = x1 + (x2 - x1) * i / steps : py = y1 + (y2 - y1) * i / steps
        IF INT(px) = cx2 AND INT(py) = cy2 AND boxOn(cx2, cy2) THEN EXIT FOR ' (into the cell it's lighting: a block there is lit, not in the way)
        IF SolidAt(px, py) THEN EXIT FUNCTION
    NEXT
    LightReaches = -1
END FUNCTION

' This frame's light: every cell starts at the level's ambient light, then
' each light adds its share - times its effect right now: a flickering
' tube drops out for a few frames now and then, a pulse rises and falls,
' a strobe blinks twice a second, firelight jitters, and a dying tube is
' mostly dark but sputters on. A broken lamp's light is out for good.
' The lamps' effects this frame (UpdateLight's): each cell kind's (ambFxNow)
' and each light's (lightNow) - flickering, pulsing, strobing... PHOTO MODE
' skips it, so they hold as they were
SUB UpdateLightFx
    DIM f, l ' (its own: the main program shares these names)
    ' The cell lights' effects, this frame - as a light's below, one for all
    ' the cells of a kind (a room flickers as one)
    ambFxNow(FX_STEADY) = 1 : ambFxNow(FX_PULSE) = 0.55 + 0.45 * SIN(TIMER * 2.4) : ambFxNow(FX_FIRE) = 0.75 + RND * 0.25
    IF INT(TIMER * 2) MOD 2 = 0 THEN ambFxNow(FX_STROBE) = 1 ELSE ambFxNow(FX_STROBE) = 0.05
    ambFxNow(FX_FLICKER) = 1
    IF ambFxTimer(FX_FLICKER) > 0 THEN ambFxTimer(FX_FLICKER) = ambFxTimer(FX_FLICKER) - 1 : ambFxNow(FX_FLICKER) = 0.15 ELSE IF RND < 0.025 THEN ambFxTimer(FX_FLICKER) = 2 + INT(RND * 6)
    ambFxNow(FX_DYING) = 0.08
    IF ambFxTimer(FX_DYING) > 0 THEN ambFxTimer(FX_DYING) = ambFxTimer(FX_DYING) - 1 : ambFxNow(FX_DYING) = 0.5 + RND * 0.5 ELSE IF RND < 0.03 THEN ambFxTimer(FX_DYING) = 3 + INT(RND * 10)
    FOR l = 1 TO numLights
        f = 1
        SELECT CASE lightEffect(l)
            CASE FX_FLICKER
                IF lightTimer(l) > 0 THEN
                    lightTimer(l) = lightTimer(l) - 1 : f = 0.15
                ELSEIF RND < 0.025 THEN
                    lightTimer(l) = 2 + INT(RND * 6)
                END IF
            CASE FX_PULSE
                f = 0.55 + 0.45 * SIN(TIMER * 2.4 + lightPhase(l))
            CASE FX_STROBE
                IF INT(TIMER * 2 + lightPhase(l)) MOD 2 = 0 THEN f = 1 ELSE f = 0.05
            CASE FX_FIRE
                f = 0.75 + RND * 0.25
            CASE FX_DYING
                f = 0.08
                IF lightTimer(l) > 0 THEN
                    lightTimer(l) = lightTimer(l) - 1 : f = 0.5 + RND * 0.5
                ELSEIF RND < 0.03 THEN
                    lightTimer(l) = 3 + INT(RND * 10)
                END IF
        END SELECT
        IF lightDeco(l) THEN
            IF NOT decoOn(lightDeco(l)) THEN f = 0
        END IF
        IF lightBroken(l) THEN f = 0 ' (shot out)
        IF blackoutTimer > 0 AND lightEffect(l) <> FX_STROBE THEN f = f * 0.05 ' (no power: only the alarms)
        f = f * ambDim ' (a sector light below 0 turns every lamp down - its glow too)
        lightNow(l) = f
    NEXT
END SUB

SUB UpdateLight
    DIM B, e, f, g, l, r, w ' (its own: the main program shares these names)
    ' (only the cells near you - LIGHT_NEAR - but all of a sector at first)
    litX0 = 0 : litY0 = 0 : litX1 = mapN - 1 : litY1 = mapN - 1
    IF (cyberOn OR cyberLook) <> litCyberWas THEN litCyberWas = (cyberOn OR cyberLook) : litAll = 3 ' (into the network or out: all of it again, for a few frames - both of OpenGL's halves)
    IF litAll > 0 THEN litAll = litAll - 1
    IF lvFrame > 2 AND litAll = 0 THEN
        litX0 = MaxOf(0, INT(playerX) - LIGHT_NEAR) : litX1 = MinOf(mapN - 1, INT(playerX) + LIGHT_NEAR)
        litY0 = MaxOf(0, INT(playerY) - LIGHT_NEAR) : litY1 = MinOf(mapN - 1, INT(playerY) + LIGHT_NEAR)
    END IF
    IF cyberOn OR cyberLook OR (editMode AND edFullBright) THEN ' The network: no lamps, no shadows - everything lit the same (near you, once it's all been lit). The editor's FULL BRIGHT (Alt+L) the same, at the pictures' own colours
        FOR cellY = litY0 TO litY1 : FOR cellX = litX0 TO litX1
            IF cyberOn OR cyberLook THEN litR(cellX, cellY) = 200 : litG(cellX, cellY) = 200 : litB(cellX, cellY) = 230 ELSE litR(cellX, cellY) = 256 : litG(cellX, cellY) = 256 : litB(cellX, cellY) = 256
            litSumX(cellX, cellY) = 0 : litSumY(cellX, cellY) = 0 : litSumW(cellX, cellY) = 0
        NEXT : NEXT
        FOR l = 1 TO numLights : lightNow(l) = 0 : NEXT
        EXIT SUB
    END IF
    IF NOT photoOn THEN UpdateLightFx ' (the lamps' effects - PHOTO MODE: held as they were, GAME/PHOTO.BM)
    FOR cellY = litY0 TO litY1 : FOR cellX = litX0 TO litX1
        f = ambFxNow(cellAmbFx(cellX, cellY)) * ambDim ' (its own ambient light - a cell light, or the sector's - turned down by a sector light below 0)
        litR(cellX, cellY) = cellAmbR(cellX, cellY) * f : litG(cellX, cellY) = cellAmbG(cellX, cellY) * f : litB(cellX, cellY) = cellAmbB(cellX, cellY) * f
        IF blackoutTimer > 0 THEN litR(cellX, cellY) = litR(cellX, cellY) \ 4 : litG(cellX, cellY) = litG(cellX, cellY) \ 5 : litB(cellX, cellY) = litB(cellX, cellY) \ 4 ' (a power failure: darker)
        litSumX(cellX, cellY) = 0 : litSumY(cellX, cellY) = 0 : litSumW(cellX, cellY) = 0
    NEXT : NEXT
    FOR l = 1 TO numLights
        f = lightNow(l)
        IF f > 0 AND lightX(l) + lightRadius(l) >= litX0 AND lightX(l) - lightRadius(l) <= litX1 + 1 AND lightY(l) + lightRadius(l) >= litY0 AND lightY(l) - lightRadius(l) <= litY1 + 1 THEN ' (one that reaches the cells near you)
            r = lightR(l) * f : g = lightG(l) * f : b = lightB(l) * f
            FOR e = lightFirst(l) TO lightFirst(l) + lightCount(l) - 1
                cellX = litCellX(e) : cellY = litCellY(e) : w = litWeight(e)
                IF cellX < litX0 OR cellX > litX1 OR cellY < litY0 OR cellY > litY1 THEN _CONTINUE
                litR(cellX, cellY) = litR(cellX, cellY) + r * w
                litG(cellX, cellY) = litG(cellX, cellY) + g * w
                litB(cellX, cellY) = litB(cellX, cellY) + b * w
                strength = (r + g + b) * w ' (and where it comes from: chapter 24's bumps)
                litSumX(cellX, cellY) = litSumX(cellX, cellY) + lightX(l) * strength
                litSumY(cellX, cellY) = litSumY(cellX, cellY) + lightY(l) * strength
                litSumW(cellX, cellY) = litSumW(cellX, cellY) + strength
            NEXT
        END IF
    NEXT
END SUB

' A quick glow at (x, y) for this frame only - a muzzle flash, a blast, a
' bolt: brightest in the middle, gone at radius. It doesn't check for walls
' (it's only for a moment, and that's much cheaper).
SUB AddGlow(x, y, radius, r, g, b)
    DIM d, w ' (its own: the main program shares these names)
    FOR cellY = INT(y - radius) TO INT(y + radius)
        FOR cellX = INT(x - radius) TO INT(x + radius)
            IF cellX >= 0 AND cellX < mapN AND cellY >= 0 AND cellY < mapN THEN
                d = SQR((cellX + 0.5 - x) ^ 2 + (cellY + 0.5 - y) ^ 2)
                IF d < radius THEN
                    w = (1 - d / radius) ^ 2
                    litR(cellX, cellY) = litR(cellX, cellY) + r * w
                    litG(cellX, cellY) = litG(cellX, cellY) + g * w
                    litB(cellX, cellY) = litB(cellX, cellY) + b * w
                    strength = (r + g + b) * w ' (where it comes from, for bumps)
                    litSumX(cellX, cellY) = litSumX(cellX, cellY) + x * strength
                    litSumY(cellX, cellY) = litSumY(cellX, cellY) + y * strength
                    litSumW(cellX, cellY) = litSumW(cellX, cellY) + strength
                END IF
            END IF
        NEXT
    NEXT
END SUB

' Light a colour: its red, green and blue each times their light / 256
' (more than 256 brightens, up to full). Each channel is masked out of
' &HAARRGGBB on its own, multiplied, and put back.
FUNCTION ShadeRGB~&(col AS _UNSIGNED LONG, lr AS LONG, lg AS LONG, lb AS LONG)
    red& = ((col AND &HFF0000) \ 65536) * lr \ 256 : IF red& > 255 THEN red& = 255
    green& = ((col AND &HFF00&) \ 256) * lg \ 256 : IF green& > 255 THEN green& = 255
    blue& = (col AND 255) * lb \ 256 : IF blue& > 255 THEN blue& = 255
    ShadeRGB~& = &HFF000000~& OR (red& * 65536) OR (green& * 256) OR blue&
END FUNCTION

' Ceiling lamp l, shot out: its light goes off for good (UpdateLight), its
' beam with it; its picture goes dark and cracked (T_LAMPOFF - the software
' renderer's ceiling, and OpenGL's world built again with it - a dark
' mark over it too) - and if loud, glass and sparks rain down, with a
' crash. (Not loud: loading a game where it was already broken.)
SUB BreakLight(l, loud)
    DIM cx, cy ' (its own: the main program shares these names)
    lightBroken(l) = -1
    cx = INT(lightX(l)) : cy = INT(lightY(l))
    IF cx >= 0 AND cy >= 0 AND cx < mapN AND cy < mapN THEN IF ceilTex(cx, cy) = T_LAMP THEN ceilTex(cx, cy) = T_LAMPOFF : IF mapN <= 64 OR NOT loud THEN glMeshVersion = glMeshVersion + 1 ' (a big sector: no rebuilding all of it for one lamp - a hitch - its dark mark shows it. OpenGL's world built again with it dark: a scorch decal alone gets recycled, and the lit lamp showed again)
    AddDecal lightX(l), lightY(l), CeilAt(lightX(l), lightY(l)) - 0.001, 0, 0, -1, 0.75 : decalHeat(decalNext) = 0
    IF loud THEN
        lh = CeilAt(lightX(l), lightY(l)) - FloorAt(lightX(l), lightY(l)) - 0.05 ' (just under its own ceiling, however high)
        SpawnSparks lightX(l), lightY(l), lh, 24, 255, 240, 200
        SpawnSparks lightX(l), lightY(l), lh, 16, 160, 200, 255 ' (glass)
        PlaySfx decoBreakSnd&(2), 0.9
    END IF
END SUB

' ---------------------------------------------------------------------------
' LIGHTS THAT CHANGE AS A SECTOR PLAYS - console commands, so a trigger's
' too (a light switch: use X Y repeat : light 3 toggle; an alarm that
' turns a room red: alarm : celllight 10 4 18 9 150 FF2020 pulse; calm,
' when it stops, puts it back: calm : celllight 10 4 18 9 off).
'   light N on|off|toggle         one of the level's lights ([lights], from 1)
'   light N colour RRGGBB         its colour      light N bright 0-400
'   light N fx steady|flicker|pulse|strobe|fire|dying
'   ambient BRIGHT [RRGGBB] [FX]  the sector's own light: every cell with
'                                 no light of its own
'   celllight X0 Y0 X1 Y1 BRIGHT RRGGBB [FX]  those cells a light of their
'                                 own (0 is dark) - or "off": the sector's again
' Light only (the game plays the same: demos don't mind). What changed is
' kept in lightLog$ - on/off isn't: shot-out and switched-off lamps are
' saved as they are - and a saved game makes it all again (LightReplay).
' Returns "" when done, else what to say (a mistake, or what was asked).
FUNCTION LightCmd$(c$)
    DIM v$, w$, l, x, y, x0, y0, x1, y1, bri, fx, hue AS _UNSIGNED LONG ' (its own: the main program shares these names)
    v$ = ConWord$(c$, 1)
    SELECT CASE v$
        CASE "light"
            l = VAL(ConWord$(c$, 2)) : w$ = ConWord$(c$, 3)
            IF l < 1 OR l > numLights THEN LightCmd$ = "light: no light" + STR$(l) + " - this sector's are 1 to" + STR$(numLightsBase) : EXIT FUNCTION
            SELECT CASE w$
                CASE "" : LightCmd$ = "light" + STR$(l) + ": at" + STR$(INT(lightX(l))) + STR$(INT(lightY(l))) + ", bright" + STR$(INT(lightBri(l))) + ", colour " + HueHex$(lightHue(l)) + ", " + FxName$(lightEffect(l)) + MID$(", off", 1, -5 * (lightBroken(l) <> 0)) : EXIT FUNCTION
                CASE "on" : LightSwitch l, 0 : EXIT FUNCTION
                CASE "off" : LightSwitch l, -1 : EXIT FUNCTION
                CASE "toggle" : LightSwitch l, NOT lightBroken(l) : EXIT FUNCTION
                CASE "colour", "color"
                    IF NOT HueOK(ConWord$(c$, 4)) THEN LightCmd$ = "light N colour RRGGBB - six hex digits (FF2020 red)" : EXIT FUNCTION
                    lightHue(l) = HueOf~&(ConWord$(c$, 4)) : LightTone l
                CASE "bright"
                    lightBri(l) = MaxOf(0, MinOf(400, VAL(ConWord$(c$, 4)))) : LightTone l
                CASE "fx", "effect"
                    fx = FxOf(ConWord$(c$, 4)) : IF fx < 0 THEN LightCmd$ = "light N fx steady|flicker|pulse|strobe|fire|dying" : EXIT FUNCTION
                    lightEffect(l) = fx
                CASE ELSE : LightCmd$ = "light N on|off|toggle, colour RRGGBB, bright 0-400, fx NAME" : EXIT FUNCTION
            END SELECT
        CASE "ambient"
            w$ = ConWord$(c$, 2)
            IF w$ = "" THEN LightCmd$ = "ambient: bright" + STR$(ambBri) + ", colour " + HueHex$(ambHue) + ", " + FxName$(ambFx) : EXIT FUNCTION
            bri = MaxOf(-255, MinOf(400, VAL(w$))) : hue = ambHue : fx = ambFx ' (below 0: none of its own, and every light turned down - -255 dark)
            IF ConWord$(c$, 3) <> "" THEN
                IF HueOK(ConWord$(c$, 3)) THEN hue = HueOf~&(ConWord$(c$, 3)) ELSE fx = FxOf(ConWord$(c$, 3))
            END IF
            IF ConWord$(c$, 4) <> "" THEN fx = FxOf(ConWord$(c$, 4))
            IF fx < 0 THEN LightCmd$ = "ambient BRIGHT [RRGGBB] [steady|flicker|pulse|strobe|fire|dying]" : EXIT FUNCTION
            ambBri = bri : ambHue = hue : ambFx = fx : ambDim = AmbDimOf(bri) : bri = MaxOf(0, bri)
            ambientR = bri * _RED32(hue) / 255 : ambientG = bri * _GREEN32(hue) / 255 : ambientB = bri * _BLUE32(hue) / 255
            FOR y = 0 TO mapN - 1 : FOR x = 0 TO mapN - 1
                IF NOT cellAmbOwn(x, y) THEN cellAmbR(x, y) = ambientR : cellAmbG(x, y) = ambientG : cellAmbB(x, y) = ambientB : cellAmbFx(x, y) = fx
            NEXT : NEXT
        CASE "celllight"
            x0 = VAL(ConWord$(c$, 2)) : y0 = VAL(ConWord$(c$, 3)) : x1 = VAL(ConWord$(c$, 4)) : y1 = VAL(ConWord$(c$, 5)) : w$ = ConWord$(c$, 6)
            IF w$ = "" THEN LightCmd$ = "celllight X0 Y0 X1 Y1 BRIGHT RRGGBB [FX] - or off (the sector's light again)" : EXIT FUNCTION
            IF x1 < x0 THEN SWAP x0, x1
            IF y1 < y0 THEN SWAP y0, y1
            x0 = MaxOf(0, x0) : y0 = MaxOf(0, y0) : x1 = MinOf(mapN - 1, x1) : y1 = MinOf(mapN - 1, y1)
            IF w$ = "off" OR w$ = "sector" THEN
                FOR y = y0 TO y1 : FOR x = x0 TO x1
                    cellAmbOwn(x, y) = 0 : cellAmbR(x, y) = ambientR : cellAmbG(x, y) = ambientG : cellAmbB(x, y) = ambientB : cellAmbFx(x, y) = ambFx
                NEXT : NEXT
            ELSE
                IF NOT HueOK(ConWord$(c$, 7)) THEN LightCmd$ = "celllight X0 Y0 X1 Y1 BRIGHT RRGGBB [FX] - the colour six hex digits (FF2020 red)" : EXIT FUNCTION
                bri = MaxOf(0, MinOf(400, VAL(w$))) : hue = HueOf~&(ConWord$(c$, 7)) : fx = 0
                IF ConWord$(c$, 8) <> "" THEN fx = FxOf(ConWord$(c$, 8))
                IF fx < 0 THEN LightCmd$ = "celllight ... FX: steady|flicker|pulse|strobe|fire|dying" : EXIT FUNCTION
                FOR y = y0 TO y1 : FOR x = x0 TO x1
                    cellAmbOwn(x, y) = -1 : cellAmbR(x, y) = bri * _RED32(hue) / 255 : cellAmbG(x, y) = bri * _GREEN32(hue) / 255 : cellAmbB(x, y) = bri * _BLUE32(hue) / 255 : cellAmbFx(x, y) = fx
                NEXT : NEXT
            END IF
        CASE ELSE : EXIT FUNCTION
    END SELECT
    lightLog$ = lightLog$ + c$ + CHR$(10) : litAll = 3 ' (kept for a save; the whole sector lit afresh - OpenGL's two halves too)
END FUNCTION

' Light l on or off (a light switch) - its lamp on the ceiling lit or dark with it
SUB LightSwitch(l, dark)
    DIM cx, cy ' (its own: the main program shares these names)
    lightBroken(l) = dark
    cx = INT(lightX(l)) : cy = INT(lightY(l))
    IF cx < 0 OR cy < 0 OR cx >= mapN OR cy >= mapN THEN EXIT SUB
    IF shaftCell(cx, cy) = l THEN ' (its lamp: lit, or dark - and OpenGL's world built again to show it)
        IF dark THEN ceilTex(cx, cy) = T_LAMPOFF ELSE ceilTex(cx, cy) = T_LAMP
        glMeshVersion = glMeshVersion + 1
    END IF
END SUB

' Light l's red, green and blue from its brightness and colour
' A sector light below 0 (to -255): how much of every light in it is left -
' 1 at 0 and above, none at -255
FUNCTION AmbDimOf!(bri)
    AmbDimOf! = 1 + MaxOf(-255, MinOf(0, bri)) / 255
END FUNCTION

SUB LightTone(l)
    lightR(l) = lightBri(l) * _RED32(lightHue(l)) / 255 : lightG(l) = lightBri(l) * _GREEN32(lightHue(l)) / 255 : lightB(l) = lightBri(l) * _BLUE32(lightHue(l)) / 255
END SUB

' A saved game's light changes (lightLog$), made again on the sector as it loads
SUB LightReplay
    DIM all$, ln$, nl, e$ ' (its own)
    all$ = lightLog$ : lightLog$ = ""
    DO WHILE LEN(all$)
        nl = INSTR(all$, CHR$(10)) : IF nl = 0 THEN nl = LEN(all$) + 1
        ln$ = LEFT$(all$, nl - 1) : all$ = MID$(all$, nl + 1)
        IF LEN(ln$) THEN e$ = LightCmd$(ln$)
    LOOP
END SUB

' RRGGBB: is it six hex digits? Its colour?
FUNCTION HueOK(h$)
    DIM i ' (its own)
    HueOK = 0 : IF LEN(h$) <> 6 THEN EXIT FUNCTION
    FOR i = 1 TO 6 : IF INSTR("0123456789abcdefABCDEF", MID$(h$, i, 1)) = 0 THEN EXIT FUNCTION
    NEXT
    HueOK = -1
END FUNCTION

FUNCTION HueOf~&(h$)
    HueOf~& = _RGB32(VAL("&H" + MID$(h$, 1, 2)), VAL("&H" + MID$(h$, 3, 2)), VAL("&H" + MID$(h$, 5, 2)))
END FUNCTION

FUNCTION HueHex$(c AS _UNSIGNED LONG)
    HueHex$ = RIGHT$("00000" + HEX$(c AND &HFFFFFF), 6)
END FUNCTION

' A light effect's FX_ number from its name (or 0-5) - -1 if it's neither
FUNCTION FxOf(n$)
    SELECT CASE LCASE$(n$)
        CASE "", "steady", "0" : FxOf = FX_STEADY
        CASE "flicker", "1" : FxOf = FX_FLICKER
        CASE "pulse", "2" : FxOf = FX_PULSE
        CASE "strobe", "3" : FxOf = FX_STROBE
        CASE "fire", "4" : FxOf = FX_FIRE
        CASE "dying", "5" : FxOf = FX_DYING
        CASE ELSE : FxOf = -1
    END SELECT
END FUNCTION

' ...and its name
FUNCTION FxName$(fx)
    FxName$ = RTRIM$(MID$("steady  flicker pulse   strobe  fire    dying   ", MaxOf(0, MinOf(5, fx)) * 8 + 1, 8))
END FUNCTION
