''
' NEON-CASTER - RENDER/MODELS.BM
' =============================================================================
' 3D props: loading the models (LoadModels), the picture of one the
' software renderer shows (ModelPic), and which way a decoration faces
' (ModelFacing). OpenGL draws the models themselves: GLDrawModel, chapter 24.
'

'-----------------------------------------------------------------------------
' 3D PROPS
'-----------------------------------------------------------------------------
' A sprite is one picture that turns to face you. A 3D prop is a model:
' triangles, in neon-caster/models/NAME.obj, the plainest file a 3D program
' saves - a line "v x y z" for each corner, "vt u v" for each spot on the
' texture, and "f a/ta b/tb c/tc" for each triangle, numbering those (from
' 1). OpenGL already draws the walls as triangles in 3D, so a model is
' just more of them: turned the way the prop faces, moved to where it
' stands, and lit as a sprite is (GLDrawModel).
'
' The software renderer draws a column at a time and can't do triangles.
' It does what DOOM and Duke Nukem 3D did: the prop is drawn from 8 ways
' round it, 45 degrees apart (models.py does that, from the same model),
' and you see the picture from nearest the way you're looking at it - walk
' round a chair and it turns. NAME_0.png is from in front, NAME_2 from its
' right, NAME_4 from behind, NAME_6 from its left.
'
' Any decoration or pickup with a model in neon-caster/models/ is drawn as
' one; without, it's the sprite it always was. The models were made from
' the MODERN paintings by pixelmon (models.py says how).

' Every prop's model (its triangles and 8 pictures, once), and their
' textures (again whenever ART changes: LoadPictures)
SUB LoadModels
    STATIC done
    DIM k, m ' (its own: the main program shares these names)
    IF NOT done THEN
        done = -1
        FOR k = 1 TO DECO_KINDS : decoMdl(k) = NewModel(DecoPicName$(k), 0) : wreckMdl(k) = NewModel(DecoWreckName$(k), 0) : NEXT
        mimicNapMdl = NewModel("mimic-asleep", 0)
        FOR k = 1 TO MON_TYPES : mtypeMdl(k) = NewModel(mtypeName$(k), 0) : NEXT
        rocketMdl = NewModel("rocket", 0) ' (rockets and missiles, flying)
        plateMdl = NewModel("plate", 0) ' (the PLATE trap's pressure plates)
        turPlateMdl = NewModel("turret-mount", 0) : turHoleMdl = NewModel("turret-mount-broken", 0) ' (the plate it's bolted on)
        turBaseMdl = NewModel("turret-base", 0) : turHeadMdl = NewModel("turret-head", 0) ' (a turret's two parts, for aiming its head: TurretDrawAt)
        IF turBaseMdl THEN ' (its head turns on the top of its base)
            FOR k = mdlFirst(turBaseMdl) * 3 TO (mdlFirst(turBaseMdl) + mdlCount(turBaseMdl)) * 3 - 1 : IF mdlPZ(k) > turPivot THEN turPivot = mdlPZ(k)
            NEXT
        END IF
        IF turHeadMdl THEN ' (its barrels' ends: the middles of its muzzles - the triangles from the texture's white corner - its left one and its right)
            DIM mn(2)
            FOR m = mdlFirst(turHeadMdl) TO mdlFirst(turHeadMdl) + mdlCount(turHeadMdl) - 1
                IF mdlU(m * 3) > 0.95 AND mdlV(m * 3) > 0.95 THEN
                    k = 1 : IF mdlPY(m * 3) + mdlPY(m * 3 + 1) + mdlPY(m * 3 + 2) > 0 THEN k = 2
                    turMuzX(k) = turMuzX(k) + mdlPX(m * 3) : turMuzY(k) = turMuzY(k) + mdlPY(m * 3) : turMuzZ(k) = turMuzZ(k) + mdlPZ(m * 3) : mn(k) = mn(k) + 1
                END IF
            NEXT
            FOR k = 1 TO 2 : IF mn(k) THEN turMuzX(k) = turMuzX(k) / mn(k) : turMuzY(k) = turMuzY(k) / mn(k) : turMuzZ(k) = turMuzZ(k) / mn(k)
            NEXT
        END IF ' (a monster with a model of its name: the turret)
        FOR k = 1 TO ITEM_KINDS
            IF k <= 3 THEN itemMdl(k) = NewModel("keycard", CardRGB~&(k)) ELSE itemMdl(k) = NewModel(ItemPicName$(k), 0) ' (the keycard: one model, three colours - as LoadCards tints its picture)
        NEXT
    END IF
    mdlMatTop = 0 ' (their materials too: hd/models/ has its own, at the painting's size)
    FOR m = 1 TO numModels
        IF mdlProp(m) THEN IF NOT PropReady(mdlName$(m)) THEN _CONTINUE ' (a prop's files gone meanwhile: what it had stays)
        LoadSprite "models/" + mdlName$(m) + "_tex.png", S_MODEL + m - 1
        IF mdlTint(m) THEN TintSlot S_MODEL + m - 1, mdlTint(m)
        LoadModelMat m
    NEXT
END SUB

' Model m's material picture, models/NAME_mat.png (or hd/'s - ArtPath$), if
' it has one: into mdlMatPix, square (nearest pixel: each is eight values,
' never blended), and each triangle's SEE from the pixel under its middle.
' No file: none, and every triangle solid (mdlSee 0). The file's optional -
' a missing one is no error, as a missing _tex.png is.
SUB LoadModelMat(m)
    DIM c AS _UNSIGNED LONG, f$, img AS LONG, mm AS _MEM, n AS LONG, sz AS LONG, t AS LONG, w AS LONG, h AS LONG, x AS LONG, y AS LONG, u!, v! ' (its own: the main program shares these names)
    mdlMatSize(m) = 0 : mdlMatUp(m) = 0
    FOR t = mdlFirst(m) TO mdlFirst(m) + mdlCount(m) - 1 : mdlSee(t) = 0 : NEXT
    f$ = ArtPath$("models/" + mdlName$(m) + "_mat.png")
    IF NOT _FILEEXISTS(f$) THEN EXIT SUB
    img = _LOADIMAGE(f$, 32) : IF img >= -1 THEN EXIT SUB
    w = _WIDTH(img) : h = _HEIGHT(img)
    sz = w : IF h > sz THEN sz = h
    IF sz > MDL_MAT_MAX THEN sz = MDL_MAT_MAX
    n = mdlMatTop + sz * sz
    IF n > UBOUND(mdlMatPix) + 1 THEN REDIM _PRESERVE mdlMatPix(n + MDL_MAT_MAX * MDL_MAT_MAX) AS _UNSIGNED LONG
    mdlMatAt(m) = mdlMatTop : mdlMatTop = n
    mm = _MEMIMAGE(img)
    FOR y = 0 TO sz - 1 : FOR x = 0 TO sz - 1 ' (a picture not square, or too big, stretched to one - its spots run 0 to 1 either way)
        mdlMatPix(mdlMatAt(m) + y * sz + x) = _MEMGET(mm, mm.OFFSET + ((y * h \ sz) * w + x * w \ sz) * 4, _UNSIGNED LONG)
    NEXT : NEXT
    _MEMFREE mm : _FREEIMAGE img
    mdlMatSize(m) = sz
    ' Each triangle's SEE: at its middle on the picture (mdlU, mdlV run from
    ' its top left, as OpenGL reads it) - the red's high 4 bits, 0-15
    FOR t = mdlFirst(m) TO mdlFirst(m) + mdlCount(m) - 1
        u! = (mdlU(t * 3) + mdlU(t * 3 + 1) + mdlU(t * 3 + 2)) / 3 : v! = (mdlV(t * 3) + mdlV(t * 3 + 1) + mdlV(t * 3 + 2)) / 3
        x = INT(u! * sz) : y = INT(v! * sz)
        IF x < 0 THEN x = 0
        IF x > sz - 1 THEN x = sz - 1
        IF y < 0 THEN y = 0
        IF y > sz - 1 THEN y = sz - 1
        c = mdlMatPix(mdlMatAt(m) + y * sz + x)
        mdlSee(t) = (_SHR(c, 20) AND 15) / 15
    NEXT
END SUB

' A decoration's picture file, without its ".png" - its model's name too
FUNCTION DecoPicName$(kind)
    DIM f$ ' (its own: the main program shares these names)
    IF kind <= 9 THEN
        DecoPicName$ = RTRIM$(MID$("barrel  lamp    plant   terminalcrate   rack    vending tank    spawner ", (kind - 1) * 8 + 1, 8))
    ELSE
        f$ = DecoFile$(kind) : DecoPicName$ = LEFT$(f$, LEN(f$) - 4)
    END IF
END FUNCTION

' A decoration's wreck's picture (and model) name: NAME-wreck - the chest's
' open one, chest-open (the game draws its own if there's no file - MakeWreck)
FUNCTION DecoWreckName$(kind)
    IF kind = DK_CHEST THEN DecoWreckName$ = "chest-open" ELSE IF kind = DK_SAFE THEN DecoWreckName$ = "safe-open" ELSE IF kind = DK_ALARM THEN DecoWreckName$ = "alarm-off" ELSE DecoWreckName$ = DecoPicName$(kind) + "-wreck"
END FUNCTION

' A pickup's picture file, without its ".png" (4 on: the keycards are 1-3)
FUNCTION ItemPicName$(kind)
    ItemPicName$ = RTRIM$(MID$("medkit         ammo           shells         pickup-scatter pickup-repeaterarmor          bigmed         pickup-rail    map            overcharge     amp            core           goggles        suit           pickup-rocket  rockets        rounds         slugs          jetpack        jetfuel        repairkit      invuln         ", (kind - 4) * 15 + 1, 15))
END FUNCTION

' Load model NAME (tinted tintCol: 0, as it is) as the next one - its number,
' or 0 if it has no model (it stays a sprite)
FUNCTION NewModel(name$, tintCol AS _UNSIGNED LONG)
    DIM a, m, f$ ' (its own: the main program shares these names)
    f$ = AssetPath$("models/" + name$ + ".obj")
    IF NOT _FILEEXISTS(f$) OR numModels >= MAX_MODELS THEN EXIT FUNCTION
    m = numModels + 1
    LoadObj m, f$
    IF mdlCount(m) = 0 THEN EXIT FUNCTION
    numModels = m : mdlName$(m) = name$ : mdlTint(m) = tintCol
    FOR a = 0 TO MDL_ANGLES - 1 : LoadModelPic (m - 1) * MDL_ANGLES + a + 1, AssetPath$("models/" + name$ + "_" + LTRIM$(STR$(a)) + ".png"), tintCol : NEXT
    NewModel = m
END FUNCTION

' Picture file f$ into mdlPic(.., .., n), MDL_PIC square - tinted, if tintCol
SUB LoadModelPic(n, f$, tintCol AS _UNSIGNED LONG)
    DIM c AS _UNSIGNED LONG, img AS LONG, src AS LONG, x, y ' (its own: the main program shares these names)
    IF NOT _FILEEXISTS(f$) THEN EXIT SUB
    img = _LOADIMAGE(f$, 32) : IF img >= -1 THEN EXIT SUB
    src = _SOURCE : _SOURCE img
    FOR y = 0 TO MDL_PIC - 1 : FOR x = 0 TO MDL_PIC - 1
        c = POINT(x * _WIDTH(img) \ MDL_PIC, y * _HEIGHT(img) \ MDL_PIC)
        IF tintCol THEN c = Tint~&(c, tintCol, 1)
        mdlPic(x, y, n) = c
    NEXT : NEXT
    _SOURCE src : _FREEIMAGE img
END SUB

' Sprite slot's picture, tinted (a keycard's model's texture)
SUB TintSlot(slot, tintCol AS _UNSIGNED LONG)
    DIM x, y ' (its own: the main program shares these names)
    FOR y = 0 TO spriteSize(slot) - 1 : FOR x = 0 TO spriteSize(slot) - 1
        spriteTex(x, y, slot) = Tint~&(spriteTex(x, y, slot), tintCol, 1)
    NEXT : NEXT
END SUB

' Model m's triangles, from OBJ file f$ (and its "# frame" line: how many
' cells across its 8 pictures are)
SUB LoadObj(m, f$)
    DIM c, j, k, n, nv, nt, t, fh, l$, w$ ' (its own: the main program shares these names)
    DIM vx(MAX_MDL_TRIS * 3) AS SINGLE, vy(MAX_MDL_TRIS * 3) AS SINGLE, vz(MAX_MDL_TRIS * 3) AS SINGLE
    DIM tu(MAX_MDL_TRIS * 3) AS SINGLE, tv(MAX_MDL_TRIS * 3) AS SINGLE, cv(2) AS LONG, ct(2) AS LONG
    mdlFirst(m) = mdlTris : mdlFrame(m) = 0.5
    fh = FREEFILE : OPEN f$ FOR INPUT AS #fh
    DO WHILE NOT EOF(fh)
        LINE INPUT #fh, l$
        l$ = LTRIM$(RTRIM$(l$))
        IF LEFT$(l$, 8) = "# frame " THEN mdlFrame(m) = VAL(MID$(l$, 9))
        SELECT CASE LEFT$(l$, 2)
            CASE "v " ' A corner. The file's axes are OBJ's - y up, its front towards -z -
                ' and ours x the way it faces, y its right, z up: our x is its -z, y its x, z its y
                IF nv < MAX_MDL_TRIS * 3 THEN nv = nv + 1 : vx(nv) = -VAL(ObjWord$(l$, 4)) : vy(nv) = VAL(ObjWord$(l$, 2)) : vz(nv) = VAL(ObjWord$(l$, 3))
            CASE "vt" ' A spot on the texture (its v runs up from the bottom)
                IF nt < MAX_MDL_TRIS * 3 THEN nt = nt + 1 : tu(nt) = VAL(ObjWord$(l$, 2)) : tv(nt) = 1 - VAL(ObjWord$(l$, 3))
            CASE "f " ' A face: its first corner and each next two make a triangle (a fan)
                n = 0
                DO
                    w$ = ObjWord$(l$, n + 2) : IF w$ = "" THEN EXIT DO
                    j = INSTR(w$, "/") : k = 0
                    IF j THEN k = VAL(MID$(w$, j + 1)) ' ("a/ta" or "a/ta/na": the texture's is second)
                    IF n < 2 THEN
                        cv(n) = VAL(w$) : ct(n) = k
                    ELSE
                        cv(2) = VAL(w$) : ct(2) = k
                        IF mdlTris < MAX_MDL_TRIS THEN
                            t = mdlTris
                            FOR c = 0 TO 2 ' (that turn is a mirror image: its corners taken the other way round)
                                j = MaxOf(1, MinOf(nv, cv((3 - c) MOD 3))) : k = MaxOf(0, MinOf(nt, ct((3 - c) MOD 3)))
                                mdlPX(t * 3 + c) = vx(j) : mdlPY(t * 3 + c) = vy(j) : mdlPZ(t * 3 + c) = vz(j)
                                mdlU(t * 3 + c) = tu(k) : mdlV(t * 3 + c) = tv(k)
                            NEXT
                            ModelNormal t
                            mdlTris = mdlTris + 1
                        END IF
                        cv(1) = cv(2) : ct(1) = ct(2)
                    END IF
                    n = n + 1
                LOOP
        END SELECT
    LOOP
    CLOSE #fh
    mdlCount(m) = mdlTris - mdlFirst(m)
END SUB

' Word n of line l$ (from 1), words being split by spaces
FUNCTION ObjWord$(l$, n)
    DIM j, k, p ' (its own: the main program shares these names)
    p = 1
    FOR k = 1 TO n
        DO WHILE MID$(l$, p, 1) = " " : p = p + 1 : LOOP
        j = INSTR(p, l$, " ") : IF j = 0 THEN j = LEN(l$) + 1
        IF k = n THEN ObjWord$ = MID$(l$, p, j - p) : EXIT FUNCTION
        p = j
        IF p > LEN(l$) THEN EXIT FUNCTION
    NEXT
END FUNCTION

' Triangle t's normal: the cross product of two of its sides, which points
' straight out of it (the way its corners go round says which side is out)
SUB ModelNormal(t)
    DIM ax, ay, az, bx, by, bz, l, nx, ny, nz ' (its own: the main program shares these names)
    ax = mdlPX(t * 3 + 1) - mdlPX(t * 3) : ay = mdlPY(t * 3 + 1) - mdlPY(t * 3) : az = mdlPZ(t * 3 + 1) - mdlPZ(t * 3)
    bx = mdlPX(t * 3 + 2) - mdlPX(t * 3) : by = mdlPY(t * 3 + 2) - mdlPY(t * 3) : bz = mdlPZ(t * 3 + 2) - mdlPZ(t * 3)
    nx = ay * bz - az * by : ny = az * bx - ax * bz : nz = ax * by - ay * bx
    l = SQR(nx * nx + ny * ny + nz * nz) : IF l < 0.000001 THEN l = 1
    mdlNX(t) = nx / l : mdlNY(t) = ny / l : mdlNZ(t) = nz / l
END SUB

' Which of model m's pictures the software renderer shows, it facing ang
' and standing at x, y: of its 8, the one drawn from nearest where you
' are. Seen from straight ahead, picture 0; walk round to its right, 1, 2...
FUNCTION ModelPic(m, ang, x, y)
    DIM k ' (its own: the main program shares these names)
    k = INT((_ATAN2(playerY - y, playerX - x) - ang) / (_PI / 4) + 0.5) ' (the nearest: INT rounds down, even below 0)
    k = ((k MOD MDL_ANGLES) + MDL_ANGLES) MOD MDL_ANGLES
    ModelPic = (m - 1) * MDL_ANGLES + k + 1
END FUNCTION

' Which way decoration i faces, as a 3D prop (0 east, a quarter turn
' south, and on round - the map's way): as the level says ([nudges] facing
' 1-4, the editor's facing button) or as it's built (its back to its wall:
' LoadLevel); a chair, else at the desk, console, terminal, screens or lab
' bench beside it; else its own way, one of 8, from where it stands
' (always the same). Only how it looks: nothing in the game asks.
FUNCTION ModelFacing(i)
    DIM best, d, j, k, tx, ty ' (its own: the main program shares these names)
    IF decoFace(i) >= 1 AND decoFace(i) <= 4 THEN ModelFacing = (decoFace(i) - 1) * _PI / 2 : EXIT FUNCTION
    IF decoKind(i) = DK_CHAIR THEN
        best = 1.3
        FOR j = 1 TO numDecos
            SELECT CASE decoKind(j)
                CASE 4, 10, 11, 12, 14 ' Terminal, desk, console, screens, lab bench
                    d = SQR((decoX(j) - decoX(i)) ^ 2 + (decoY(j) - decoY(i)) ^ 2)
                    IF d < best AND j <> i THEN best = d : tx = decoX(j) : ty = decoY(j) : k = -1
            END SELECT
        NEXT
        IF k THEN ModelFacing = _ATAN2(ty - decoY(i), tx - decoX(i)) : EXIT FUNCTION
    END IF
    k = (INT(decoX(i) * 4) * 31 + INT(decoY(i) * 4) * 17) MOD 8
    ModelFacing = k * _PI / 4
END FUNCTION

' A decoration's model: a prop's own (decoMdlOf), else its kind's - 0 none
FUNCTION DecoModel(i)
    IF decoMdlOf(i) THEN DecoModel = decoMdlOf(i) ELSE DecoModel = decoMdl(decoKind(i))
END FUNCTION

' A prop's model by its name, models/NAME.obj: the one loaded already (the
' game's own too - prop vending is the vending machine's), else loaded now
' and watched (PropWatch). 0 if there's none: no NAME.obj, or no
' NAME_tex.png, or no room. A name is letters, digits, - and _ only.
FUNCTION PropModel(n$)
    DIM m, t$ ' (its own: the main program shares these names)
    t$ = LTRIM$(RTRIM$(n$))
    IF NOT PropNameOk(t$) THEN EXIT FUNCTION
    FOR m = 1 TO numModels
        IF LCASE$(mdlName$(m)) = LCASE$(t$) AND mdlTint(m) = 0 THEN
            IF NOT mdlProp(m) THEN mdlProp(m) = -1 : mdlSum(m) = PropSum~&(mdlName$(m)) : mdlSumNew(m) = mdlSum(m)
            PropModel = m : EXIT FUNCTION
        END IF
    NEXT
    IF NOT PropReady(t$) THEN EXIT FUNCTION
    m = NewModel(t$, 0) : IF m = 0 THEN EXIT FUNCTION
    LoadSprite "models/" + t$ + "_tex.png", S_MODEL + m - 1
    LoadModelMat m
    mdlProp(m) = -1 : mdlSum(m) = PropSum~&(t$) : mdlSumNew(m) = mdlSum(m)
    glRetexVersion = glRetexVersion + 1 ' (OpenGL: its pictures to the card)
    PropModel = m
END FUNCTION

' A model already loaded, by its name (0: none) - PropModel loads one
FUNCTION PropFind(n$)
    DIM m ' (its own: the main program shares these names)
    FOR m = 1 TO numModels
        IF LCASE$(mdlName$(m)) = LCASE$(LTRIM$(RTRIM$(n$))) AND mdlTint(m) = 0 THEN PropFind = m : EXIT FUNCTION
    NEXT
END FUNCTION

' Is n$ a name a prop can have? (Letters, digits, - and _: never a folder)
FUNCTION PropNameOk(n$)
    DIM i ' (its own: the main program shares these names)
    IF LEN(n$) = 0 OR LEN(n$) > 48 THEN EXIT FUNCTION
    FOR i = 1 TO LEN(n$)
        IF INSTR("abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789-_", MID$(n$, i, 1)) = 0 THEN EXIT FUNCTION
    NEXT
    PropNameOk = -1
END FUNCTION

' Can model n$ be loaded? Its .obj there, and its _tex.png a picture
' (LoadSprite stops the game on one that isn't)
FUNCTION PropReady(n$)
    DIM img AS LONG ' (its own: the main program shares these names)
    IF NOT _FILEEXISTS(AssetPath$("models/" + n$ + ".obj")) THEN EXIT FUNCTION
    IF NOT _FILEEXISTS(ArtPath$("models/" + n$ + "_tex.png")) THEN EXIT FUNCTION
    img = _LOADIMAGE(ArtPath$("models/" + n$ + "_tex.png"), 32) : IF img >= -1 THEN EXIT FUNCTION
    _FREEIMAGE img
    PropReady = -1
END FUNCTION

' Model n$'s files, as one checksum: its .obj, texture, material and first
' picture (bu1ld0r's export writes them all)
FUNCTION PropSum~&(n$)
    DIM f$, k, s$ ' (its own: the main program shares these names)
    FOR k = 1 TO 4
        SELECT CASE k
            CASE 1 : f$ = AssetPath$("models/" + n$ + ".obj")
            CASE 2 : f$ = ArtPath$("models/" + n$ + "_tex.png")
            CASE 3 : f$ = ArtPath$("models/" + n$ + "_mat.png")
            CASE 4 : f$ = AssetPath$("models/" + n$ + "_0.png")
        END SELECT
        IF _FILEEXISTS(f$) THEN s$ = s$ + _READFILE$(f$) + CHR$(k) ELSE s$ = s$ + CHR$(k + 8)
    NEXT
    PropSum~& = _CRC32(s$)
END FUNCTION

' Every PROP_WATCH frames: a prop whose files changed (bu1ld0r exported it
' again) is loaded again - once they read the same twice running, so a file
' half written isn't
SUB PropWatch
    DIM m, s AS _UNSIGNED LONG ' (its own: the main program shares these names)
    propWatchT = propWatchT + 1 : IF propWatchT < PROP_WATCH THEN EXIT SUB
    propWatchT = 0
    FOR m = 1 TO numModels
        IF mdlProp(m) THEN
            s = PropSum~&(mdlName$(m))
            IF s <> mdlSum(m) THEN
                IF s = mdlSumNew(m) THEN PropReload m ELSE mdlSumNew(m) = s
            END IF
        END IF
    NEXT
END SUB

' Model m read again from its files: its triangles (after the rest - or
' where they were, if it's the last), texture, 8 pictures, material.
' OpenGL waits while it's done (glEdHold, as the editor's rebuild)
SUB PropReload(m)
    DIM a, holdT!, n$ ' (its own: the main program shares these names)
    n$ = mdlName$(m)
    IF NOT PropReady(n$) THEN EXIT SUB
    IF glReady AND NOT artHold THEN
        glEdAck = 0 : glEdHold = -1 : holdT! = TIMER
        DO WHILE glEdAck = 0 AND ABS(TIMER - holdT!) < 0.25 : _LIMIT 1000 : LOOP
    END IF
    IF mdlFirst(m) + mdlCount(m) = mdlTris THEN mdlTris = mdlFirst(m) ' (the last loaded: its room used again)
    LoadObj m, AssetPath$("models/" + n$ + ".obj")
    FOR a = 0 TO MDL_ANGLES - 1 : LoadModelPic (m - 1) * MDL_ANGLES + a + 1, AssetPath$("models/" + n$ + "_" + LTRIM$(STR$(a)) + ".png"), mdlTint(m) : NEXT
    LoadSprite "models/" + n$ + "_tex.png", S_MODEL + m - 1
    IF mdlTint(m) THEN TintSlot S_MODEL + m - 1, mdlTint(m)
    LoadModelMat m
    glEdHold = 0
    mdlSum(m) = PropSum~&(n$) : mdlSumNew(m) = mdlSum(m)
    glRetexVersion = glRetexVersion + 1
    ConPrint "model " + n$ + " loaded again (" + LTRIM$(STR$(mdlCount(m))) + " triangles)"
END SUB

' Every model in models/ (its name, without .obj), sorted, commas between -
' read once (the editor's MODEL < >)
FUNCTION PropNames$
    DIM d$, i, j, k, n, f$, t$ ' (its own: the main program shares these names)
    IF propListed THEN PropNames$ = propNamesC$ : EXIT FUNCTION
    propListed = -1 : propNamesC$ = ""
    d$ = AssetPath$("models") + "/"
    IF NOT _DIREXISTS(AssetPath$("models")) THEN EXIT FUNCTION
    DIM nm$(400)
    f$ = _FILES$(d$ + "*.obj")
    DO WHILE LEN(f$) AND n < 400
        IF LCASE$(RIGHT$(f$, 4)) = ".obj" THEN t$ = LEFT$(f$, LEN(f$) - 4) : IF PropNameOk(t$) THEN n = n + 1 : nm$(n) = t$
        f$ = _FILES$
    LOOP
    FOR i = 2 TO n ' (sorted: a few hundred at most)
        t$ = nm$(i) : j = i - 1
        DO WHILE j >= 1
            IF LCASE$(nm$(j)) <= LCASE$(t$) THEN EXIT DO
            nm$(j + 1) = nm$(j) : j = j - 1
        LOOP
        nm$(j + 1) = t$
    NEXT
    FOR k = 1 TO n : propNamesC$ = propNamesC$ + MID$(",", 1, -(k > 1)) + nm$(k) : NEXT
    PropNames$ = propNamesC$
END FUNCTION
