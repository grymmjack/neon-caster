''
' NEON-CASTER - WORLD/GLASS.BM
' =============================================================================
' Glass: where each pane is, rays through it, and shooting it.
'

' --- Glass at cell (glassHitX, glassHitY) is hit for glassDmg, at
' (glassAtX, glassAtY): it chips and cracks, and at 0 it shatters - a
' shower of shards, and the way is open
SUB HitGlass STATIC
    IF glassHP(glassHitX, glassHitY) <= 0 THEN EXIT SUB
    IF glassHP(glassHitX, glassHitY) >= BARS_HP THEN SpawnSparks glassAtX, glassAtY, 0.5, 4, 255, 210, 150 : SfxAt sndDecoHit&, glassAtX, glassAtY, playerX, playerY : EXIT SUB ' (bars: a ping off the iron)
    glassHP(glassHitX, glassHitY) = glassHP(glassHitX, glassHitY) - glassDmg
    IF glassHP(glassHitX, glassHitY) > 0 THEN
        SpawnSparks glassAtX, glassAtY, 0.5, 5, 200, 240, 255
        SfxAt sndGlassHit&, glassAtX, glassAtY, playerX, playerY
    ELSE
        glassHP(glassHitX, glassHitY) = 0 : AchAdd "Glass", 1
        FOR gk = 0 TO 4 ' (shards all along the pane, falling)
            IF glassDir(glassHitX, glassHitY) = 1 THEN gsx = glassHitX + 0.1 + gk * 0.2 : gsy = glassHitY + 0.5 ELSE gsx = glassHitX + 0.5 : gsy = glassHitY + 0.1 + gk * 0.2
            SpawnSparks gsx, gsy, 0.15 + RND * 0.7, 9, 190, 235, 255
        NEXT
        SfxAt sndGlassBreak&, glassAtX, glassAtY, playerX, playerY
        IF (glassAtX - playerX) ^ 2 + (glassAtY - playerY) ^ 2 < 25 THEN shake = shake + 3
        FOR gj = 1 TO numMonsters ' (that wakes anything near)
            IF monsterState(gj) = 0 AND (cyberOn = 0 OR monsterType(gj) = MT_ICE) THEN IF (monsterX(gj) - glassAtX) ^ 2 + (monsterY(gj) - glassAtY) ^ 2 < 36 THEN monsterState(gj) = 1 : monsterTimer(gj) = 20
        NEXT
    END IF
END SUB

' Each pane of glass: which way it runs - along x if there's wall (or more
' glass) to its left and right, else along y - and the list of them all
SUB AssignGlass
    DIM l, r, x, y ' (its own: the main program shares these names)
    numGlass = 0 : glassFull = MaxOf(1, TuneNow!(tuGlass))
    FOR y = 1 TO mapN - 2 : FOR x = 1 TO mapN - 2
        IF glassHP(x, y) > 0 THEN
            l = IsWall(x - 1, y) OR glassHP(x - 1, y) > 0 : r = IsWall(x + 1, y) OR glassHP(x + 1, y) > 0
            IF l AND r THEN glassDir(x, y) = 1 ELSE glassDir(x, y) = 2
            IF numGlass < MAX_GLASS THEN numGlass = numGlass + 1 : glassListX(numGlass) = x : glassListY(numGlass) = y
        END IF
    NEXT : NEXT
END SUB

' How much each pane reflects (glassRefK): its [glass] line's amount, else
' the sector's - bars never
SUB GlassRefBuild
    DIM k, x, y ' (its own: the main program shares these names)
    glassRefAny = 0 : glassFxAny = 0
    FOR y = 0 TO MinOf(MAP_SIZE, bldN) : FOR x = 0 TO MinOf(MAP_SIZE, bldN) : glassFrostC(x, y) = 0 : NEXT : NEXT
    FOR k = 1 TO numGlass
        x = glassListX(k) : y = glassListY(k)
        glassRefK(k) = GlassRefOf(x, y) : glassBlurK(k) = GlassFxOf(x, y, 4) : glassFrostK(k) = GlassFxOf(x, y, 5) : glassRipK(k) = GlassFxOf(x, y, 6)
        IF glassHP(x, y) >= BARS_HP THEN glassRefK(k) = 0 : glassFrostK(k) = 0 : glassRipK(k) = 0
        IF glassRefK(k) > 0 THEN glassRefAny = -1
        IF glassFrostK(k) > 0 OR glassRipK(k) > 0 THEN glassFxAny = -1
        glassFrostC(x, y) = glassFrostK(k)
    NEXT
END SUB

' The pane at x, y's amount: its own [glass] line's, else (none, or .) the sector's
FUNCTION GlassRefOf(x, y)
    DIM k ' (its own: the main program shares these names)
    k = XtraFind("glass", x, y, 0)
    IF k THEN IF LEFT$(XtraField$(k, 3), 1) <> "." AND LEN(XtraField$(k, 3)) > 0 THEN GlassRefOf = MaxOf(0, MinOf(9, VAL(XtraField$(k, 3)))) : EXIT FUNCTION
    GlassRefOf = GlassRefSector
END FUNCTION

' The pane at x, y's BLUR (n 4), FROST (5) or RIPPLE (6): 0-9, none 0
FUNCTION GlassFxOf(x, y, n)
    DIM k ' (its own: the main program shares these names)
    k = XtraFind("glass", x, y, 0)
    IF k THEN GlassFxOf = MaxOf(0, MinOf(9, VAL(XtraField$(k, n))))
END FUNCTION

' Change the pane at x, y: what (1 reflects, 2 blur, 3 frost, 4 ripple) by
' d - its [glass] line written short (none at all when it's as made)
SUB GlassFxSet(x, y, what, d)
    DIM k, r, v(4) ' (its own: the main program shares these names)
    r = GlassRefOf(x, y) : k = XtraFind("glass", x, y, 0)
    v(1) = -1 : IF k THEN IF LEFT$(XtraField$(k, 3), 1) <> "." AND LEN(XtraField$(k, 3)) > 0 THEN v(1) = r
    FOR k = 2 TO 4 : v(k) = GlassFxOf(x, y, k + 2) : NEXT
    IF what = 1 THEN v(1) = MaxOf(0, MinOf(9, r + d)) : IF v(1) = GlassRefSector THEN v(1) = -1
    IF what > 1 THEN v(what) = MaxOf(0, MinOf(9, v(what) + d))
    GlassFxPut x, y, v(1), v(2), v(3), v(4)
END SUB

' The pane at x, y's [glass] line: reflects r (-1 the sector's), blur, frost, ripple
SUB GlassFxPut(x, y, r, bl, fr, rp)
    DIM t$ ' (its own: the main program shares these names)
    IF r < 0 THEN t$ = "." ELSE t$ = LTRIM$(STR$(r))
    IF bl OR fr OR rp THEN
        t$ = t$ + ", " + LTRIM$(STR$(bl)) + ", " + LTRIM$(STR$(fr)) + ", " + LTRIM$(STR$(rp))
    ELSEIF r < 0 THEN
        t$ = ""
    END IF
    XtraSet "glass", x, y, t$
END SUB

' The sector's amount (glass_reflect =; left out, GLASS_REF_USUAL)
FUNCTION GlassRefSector
    IF lvlGlassRef < 0 THEN GlassRefSector = GLASS_REF_USUAL ELSE GlassRefSector = lvlGlassRef
END FUNCTION

' Which picture the glass at (cx, cy) shows: whole, hit (chipped, cracked,
' falling apart - by the hits it has left), bars. Hit panes take one of
' GLASS_LOOKS patterns by their cell, so neighbours differ (along a row
' each is one on from the last; down a column two)
FUNCTION GlassSlot(cx, cy)
    DIM hp, st
    hp = glassHP(cx, cy)
    IF hp >= BARS_HP THEN GlassSlot = S_BARS : EXIT FUNCTION
    IF hp >= glassFull THEN GlassSlot = S_GLASS : EXIT FUNCTION
    IF hp * 2 > glassFull THEN st = 0 ELSE IF hp * 4 > glassFull THEN st = 1 ELSE st = 2
    GlassSlot = S_CRACK + st * GLASS_LOOKS + (cx + 2 * cy + cx \ 4) MOD GLASS_LOOKS
END FUNCTION

' Is map point (x, y) inside a pane of glass (its thickness, GLASS_HALF
' either side of the middle of its cell)?
FUNCTION InGlass(x, y)
    DIM cx, cy ' (its own: the main program shares these names)
    cx = INT(x) : cy = INT(y)
    IF cx < 0 OR cy < 0 OR cx >= mapN OR cy >= mapN THEN EXIT FUNCTION
    IF glassHP(cx, cy) <= 0 THEN EXIT FUNCTION
    IF glassDir(cx, cy) = 1 THEN InGlass = ABS(y - cy - 0.5) < GLASS_HALF ELSE InGlass = ABS(x - cx - 0.5) < GLASS_HALF
END FUNCTION

' Is there glass - or a block - on the straight line from (x1, y1) to (x2,
' y2)? Checked every 0.08 of a cell, thinner than either, so neither can be
' missed. (A claw, a kick, a thief's grab can't reach through one.)
FUNCTION GlassBetween(x1, y1, x2, y2)
    DIM i, px, py ' (its own: the main program shares these names)
    IF numGlass = 0 AND NOT boxAny THEN EXIT FUNCTION
    steps = INT(SQR((x2 - x1) ^ 2 + (y2 - y1) ^ 2) / 0.08) + 1
    FOR i = 1 TO steps - 1
        px = x1 + (x2 - x1) * i / steps : py = y1 + (y2 - y1) * i / steps
        IF InGlass(px, py) THEN GlassBetween = -1 : EXIT FUNCTION
        IF boxAny THEN IF InBox(px, py) THEN GlassBetween = -1 : EXIT FUNCTION
    NEXT
END FUNCTION

' Where does a ray from (px, py), going (rdx, rdy), meet the pane of glass
' in cell (cx, cy)? Its distance t (in the raycaster's units: perpWallDist's)
' and u, where along the pane (0 to 1) - if it does, inside this cell
FUNCTION GlassRay(cx, cy, px, py, rdx, rdy, t, u)
    IF glassDir(cx, cy) = 1 THEN
        IF ABS(rdy) < 0.00001 THEN EXIT FUNCTION
        t = (cy + 0.5 - py) / rdy : u = px + t * rdx - cx
    ELSE
        IF ABS(rdx) < 0.00001 THEN EXIT FUNCTION
        t = (cx + 0.5 - px) / rdx : u = py + t * rdy - cy
    END IF
    GlassRay = t > 0.001 AND u >= 0 AND u < 1
END FUNCTION
