''
' NEON-CASTER - WORLD/LIFTS.BM
' =============================================================================
' Lifts: moving them, and their sound.
'

' One side of wall cell (cx, cy) - if it looks onto a cell that isn't
' solid wall, and you're in front of it. Its ends are (ax, ay) and
' (bx, by), in the direction x or y grows. It's lit by the cell it looks
' onto, and north and south sides are darker (chapter 15's y-sides).
'
' Which way round the texture goes copies chapter 15 exactly. A wall reads
' left to right from in front, so on east and north sides (where "left"
' is the far end) it runs backwards, from 1 to 0. Doors don't turn round,
' so they look mirrored from the other side, as in the software renderer.
' The lifts, one frame on: each one's height (liftZ) towards where it's
' going, a wait at each end; its cells' floors set to it. (px, py) is you.
' An elevator (mode 2) takes you to its other end when you step on it -
' up from the bottom, down from the top - and stays there till you've got
' off. Waiting at the bottom, it comes up to meet you when you're by it up
' top (so you're never left to jump down its shaft); with nobody about up
' there, it goes back down.
SUB MoveLifts(px, py)
    DIM k, x, y ' (its own: the main program shares these names)
    me = liftCell(INT(px), INT(py))
    FOR k = 1 TO numLifts
        IF editMode THEN IF EditLiftHeld(k) THEN _CONTINUE ' (held up or down in the editor - O)
        IF liftMode(k) = LIFT_CRUSHER OR liftMode(k) = LIFT_SMASHER THEN MoveCrusher k, px, py : _CONTINUE
        IF liftMode(k) = 2 AND me <> k THEN liftArm(k) = -1
        IF liftDir(k) = 0 THEN ' Waiting at one end
            IF liftWait(k) > 0 THEN liftWait(k) = liftWait(k) - 1
            IF liftMode(k) = 2 THEN
                atLow = (liftZ(k) <= liftLow(k) + 0.001)
                nearUp = (px > liftX0(k) - 2 AND px < liftX1(k) + 3 AND py > liftY0(k) - 2 AND py < liftY1(k) + 3 AND playerZ >= liftHigh(k) - 0.2)
                IF me = k AND liftArm(k) THEN ' (just stepped on - walked on, not fallen in: off to the other end)
                    liftArm(k) = 0
                    IF playerZ - liftZ(k) <= STEP_UP AND playerZ - liftZ(k) > -0.05 THEN ' (walked or stepped down onto it - not dropped in from high up)
                        IF atLow THEN liftDir(k) = 1 ELSE liftDir(k) = -1
                    END IF
                ELSEIF me <> k AND liftWait(k) = 0 THEN
                    IF atLow AND nearUp THEN liftDir(k) = 1 ' (up to meet you)
                    IF NOT atLow AND NOT nearUp THEN liftDir(k) = -1 ' (back down)
                END IF
            ELSEIF liftMode(k) = 1 AND liftWait(k) = 0 THEN ' (mode 3: only when told - liftgo, from a trigger)
                IF liftZ(k) <= liftLow(k) + 0.001 THEN liftDir(k) = 1 ELSE liftDir(k) = -1
            END IF
        ELSE
            liftZ(k) = liftZ(k) + liftDir(k) * liftSpeed(k)
            IF liftZ(k) >= liftHigh(k) THEN liftZ(k) = liftHigh(k) : liftDir(k) = 0 : liftWait(k) = 120
            IF liftZ(k) <= liftLow(k) THEN liftZ(k) = liftLow(k) : liftDir(k) = 0 : liftWait(k) = 120
        END IF
        FOR y = liftY0(k) TO liftY1(k) : FOR x = liftX0(k) TO liftX1(k)
            IF liftCell(x, y) = k THEN floorH(x, y) = liftZ(k)
        NEXT : NEXT
        IF editMode OR cyberOn THEN liftWasDir(k) = liftDir(k) ELSE LiftSound k, px, py ' (quiet in the editor and the network)
    NEXT
END SUB

' A lift's sound, as DOOM's: the motor starting as it sets off, running
' while it moves - its own looping copy of lift-move.wav (liftHum&), as
' loud as where it is says - and a clunk when it stops at either end.
' Done by what changed since last frame, so it's the same however it was
' set going (riding it, by itself, or a trigger's liftgo).
SUB LiftSound(k, px, py)
    DIM cx, cy ' (its own: the main program shares these names)
    cx = (liftX0(k) + liftX1(k) + 1) / 2 : cy = (liftY0(k) + liftY1(k) + 1) / 2
    IF liftDir(k) <> 0 AND liftWasDir(k) = 0 THEN SfxAt sndLiftStart&, cx, cy, px, py
    IF liftDir(k) = 0 AND liftWasDir(k) <> 0 THEN SfxAt sndLiftStop&, cx, cy, px, py
    liftWasDir(k) = liftDir(k)
    IF sndLiftMove& <= 0 THEN EXIT SUB
    IF liftDir(k) <> 0 THEN
        IF liftHum&(k) = 0 THEN liftHum&(k) = _SNDCOPY(sndLiftMove&)
        IF liftHum&(k) > 0 THEN
            _SNDVOL liftHum&(k), SfxVolAt!(cx, cy, px, py, SFX_RANGE) * 0.7 * setting(SET_SFX) / 100 : HumPan liftHum&(k), cx, cy
            IF NOT _SNDPLAYING(liftHum&(k)) THEN _SNDLOOP liftHum&(k)
        END IF
    ELSEIF liftHum&(k) > 0 THEN
        _SNDSTOP liftHum&(k)
    END IF
END SUB

' A crusher or smasher (lift k, mode 4 or 5), one frame on: its ceiling
' (liftZ) down to low and up to high, its cells' ceilH set to it - and
' what's under it hurt. A crusher goes down at its speed and back up, a
' moment's wait at each end; a smasher waits up top a second and a half,
' slams down six times as fast (a bang and a shake), and grinds back up.
' Under it, you're crushed while it's lower than you are tall (BODY_H): a
' crusher's every CRUSH_EVERY frames, a smasher's once a slam (and it
' goes on down - DOOM's crushers don't stop for you either).
SUB MoveCrusher(k, px, py)
    DIM x, y, i, sp, cz ' (its own: the main program shares these names)
    sp = liftSpeed(k)
    IF liftDir(k) = 0 THEN
        IF liftWait(k) > 0 THEN liftWait(k) = liftWait(k) - 1
        IF liftWait(k) = 0 THEN
            IF liftZ(k) >= liftHigh(k) - 0.001 THEN liftDir(k) = -1 : liftHit(k) = 0 ELSE liftDir(k) = 1
        END IF
    ELSE
        IF liftDir(k) < 0 AND liftMode(k) = LIFT_SMASHER THEN sp = sp * 6
        liftZ(k) = liftZ(k) + liftDir(k) * sp
        IF liftZ(k) >= liftHigh(k) THEN
            liftZ(k) = liftHigh(k) : liftDir(k) = 0 : liftWait(k) = 20 : IF liftMode(k) = LIFT_SMASHER THEN liftWait(k) = 90
        END IF
        IF liftZ(k) <= liftLow(k) THEN
            liftZ(k) = liftLow(k) : liftDir(k) = 0 : liftWait(k) = 20
            IF liftMode(k) = LIFT_SMASHER AND NOT editMode AND NOT cyberOn THEN ' (the slam)
                SfxAt sndCrushSlam&, (liftX0(k) + liftX1(k) + 1) / 2, (liftY0(k) + liftY1(k) + 1) / 2, px, py
                IF ABS(px - (liftX0(k) + liftX1(k) + 1) / 2) < 6 AND ABS(py - (liftY0(k) + liftY1(k) + 1) / 2) < 6 THEN shake = shake + 6
            END IF
        END IF
    END IF
    FOR y = liftY0(k) TO liftY1(k) : FOR x = liftX0(k) TO liftX1(k)
        IF liftCell(x, y) = k THEN ceilH(x, y) = liftZ(k)
    NEXT : NEXT
    IF editMode OR cyberOn THEN liftWasDir(k) = liftDir(k) : EXIT SUB ' (still in the editor, and quiet - and nothing's hurt)
    LiftSound k, px, py
    ' Under it: you
    IF liftCell(INT(px), INT(py)) = k AND NOT dead THEN
        IF liftZ(k) - playerZ < BODY_H THEN
            IF liftMode(k) = LIFT_SMASHER THEN
                IF NOT liftHit(k) THEN liftHit(k) = -1 : damage = SMASH_HURT : hurtFromX = -1 : hurtFromY = -1 : hurtR = 200 : hurtG = 40 : hurtB = 30 : HurtPlayer : shake = shake + 10
            ELSEIF lvFrame MOD CRUSH_EVERY = 0 THEN
                damage = CRUSH_HURT : hurtFromX = -1 : hurtFromY = -1 : hurtR = 200 : hurtG = 40 : hurtB = 30 : HurtPlayer : shake = shake + 3
            END IF
        END IF
    END IF
    ' ...and the monsters under it (a crusher the same, a smasher's slam once each)
    FOR i = 1 TO numMonsters
        IF monsterState(i) < 2 THEN
            IF liftCell(INT(monsterX(i)), INT(monsterY(i))) = k THEN
                cz = liftZ(k) - floorH(INT(monsterX(i)), INT(monsterY(i)))
                IF cz < BODY_H THEN
                    IF liftMode(k) = LIFT_SMASHER THEN
                        IF liftDir(k) < 0 AND cz + sp >= BODY_H THEN target = i : hitDamage = SMASH_HURT * 3 : HitMonster ' (the frame the slam reaches it)
                    ELSEIF lvFrame MOD CRUSH_EVERY = 0 THEN
                        target = i : hitDamage = CRUSH_HURT * 2 : HitMonster
                    END IF
                END IF
            END IF
        END IF
    NEXT
END SUB
