# bigmed - its texture and materials, for 3D programs (Pm Pr Pc Ps: the PBR
# words Blender's importer reads). NEON-CASTER reads bigmed_mat.png instead

newmtl bigmed_custom_001d0508
Kd 1 1 1
map_Kd ../hd/models/bigmed_tex.png
Ks 0.07 0.07 0.07
Ns 26.731
Pm 0
Pr 0.87
Ps 0.53
map_Bump -bm 0.33 ../hd/models/bigmed_tex.png

newmtl bigmed_custom_00d27150
Kd 1 1 1
map_Kd ../hd/models/bigmed_tex.png
Ks 0.87 0.87 0.87
Ns 759.331
Pm 0.47
Pr 0.13
Pc 0.33
Pcr 0.03
map_Bump -bm 0.07 ../hd/models/bigmed_tex.png

newmtl bigmed_custom_002dc200
Kd 1 1 1
map_Kd ../hd/models/bigmed_tex.png
